<?xml version="1.0" encoding="UTF-8"?>
<Form name="PET-FORM" title="Pet" width="560" height="600" background="#292A35FF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" title-visible="false" corner-radius="24" resizable="false" index-base="1" start-position="Center" responsive="true">
  <working-storage><![CDATA[       01 WS-TEXT   PIC X(300) GLOBAL.
       01 WS-PHOTO  PIC X(300) GLOBAL.
]]></working-storage>
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
           CLASS RUST-I64 IS "Rust.i64"
           CLASS RUST-I128 IS "Rust.i128"
           CLASS RUST-ISIZE IS "Rust.isize"
           CLASS RUST-U8 IS "Rust.u8"
           CLASS RUST-U16 IS "Rust.u16"
           CLASS RUST-U32 IS "Rust.u32"
           CLASS RUST-U64 IS "Rust.u64"
           CLASS RUST-U128 IS "Rust.u128"
           CLASS RUST-USIZE IS "Rust.usize"
           CLASS RUST-F32 IS "Rust.f32"
           CLASS RUST-F64 IS "Rust.f64"
           CLASS RUST-STR IS "Rust.str"
           CLASS RUST-UNIT IS "Rust.unit"
           CLASS RUST-STRING IS "Rust.String"
           CLASS RUST-OSSTRING IS "Rust.OsString"
           CLASS RUST-OSSTR IS "Rust.OsStr"
           CLASS RUST-CSTRING IS "Rust.CString"
           CLASS RUST-CSTR IS "Rust.CStr"
           CLASS RUST-PATH IS "Rust.Path"
           CLASS RUST-PATHBUF IS "Rust.PathBuf"
           CLASS RUST-VEC IS "Rust.Vec"
           CLASS RUST-VECDEQUE IS "Rust.VecDeque"
           CLASS RUST-LINKEDLIST IS "Rust.LinkedList"
           CLASS RUST-HASHMAP IS "Rust.HashMap"
           CLASS RUST-BTREEMAP IS "Rust.BTreeMap"
           CLASS RUST-HASHSET IS "Rust.HashSet"
           CLASS RUST-BTREESET IS "Rust.BTreeSet"
           CLASS RUST-BINARYHEAP IS "Rust.BinaryHeap"
           CLASS RUST-OPTION IS "Rust.Option"
           CLASS RUST-RESULT IS "Rust.Result"
           CLASS RUST-BOX IS "Rust.Box"
           CLASS RUST-RC IS "Rust.Rc"
           CLASS RUST-ARC IS "Rust.Arc"
           CLASS RUST-WEAK IS "Rust.Weak"
           CLASS RUST-CELL IS "Rust.Cell"
           CLASS RUST-REFCELL IS "Rust.RefCell"
           CLASS RUST-MUTEX IS "Rust.Mutex"
           CLASS RUST-RWLOCK IS "Rust.RwLock"
           CLASS RUST-COW IS "Rust.Cow"
           CLASS RUST-DURATION IS "Rust.Duration"
           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"]]></repository>
  <form-events>
    <Event name="onLoad" paragraph="PET-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> The pet to edit arrives as properties of the form that opened this one.

           INVOKE    super::GetProperty( "PetName" ) RETURNING WS-TEXT
           SET     TXT-NAME::Text                TO    WS-TEXT::Trim()
           INVOKE    super::GetProperty( "PetRace" ) RETURNING WS-TEXT
           SET     TXT-RACE::Text                TO    WS-TEXT::Trim()
           INVOKE    super::GetProperty( "PetAge" ) RETURNING WS-TEXT
           IF WS-TEXT NOT = SPACES
               SET     NUD-AGE::Value                TO    FUNCTION NUMVAL( WS-TEXT )
           END-IF
           INVOKE    super::GetProperty( "PetThumb" ) RETURNING WS-TEXT
           IF WS-TEXT NOT = SPACES
               SET     PIC-PREVIEW::ImagePath        TO    WS-TEXT::Trim()
           END-IF
           SET     WS-PHOTO                      TO    SPACES
]]></Event>
    <Event name="onClose" paragraph="PET-FORM--ONCLOSE">
    </Event>
  </form-events>
  <Control id="Lbl-Title" type="Label" x="32" y="24" w="400" h="32" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Pet</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
