    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left,Bottom,Right</Property>
    <Event name="onCellEdited" paragraph="DG-EC2--ONCELLEDITED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> Only the On / off column (7) is meant to change; any other edit is taken back.

           IF DG-EC2::EditedColumn NOT = 7
               DG-EC2::SetCellValue( DG-EC2::EditedRow DG-EC2::EditedColumn DG-EC2::PreviousValue )
               GOBACK
           END-IF
           SET     WS-EC2-ID                     TO    DG-EC2::GetCellValue( DG-EC2::EditedRow 1 )
           IF DG-EC2::EditedValue = "1"
               SET     WS-TARGET                     TO    "running"
               SET     WS-OUT                        TO    AWS-EC2::Start( WS-EC2-ID::Trim() )
           ELSE
               SET     WS-TARGET                     TO    "stopped"
               SET     WS-OUT                        TO    AWS-EC2::Stop( WS-EC2-ID::Trim() )
           END-IF
           IF AWS-EC2::LastError NOT = SPACES
               SET     LBL-EC2STATE::Caption         TO    "AWS refused: " & AWS-EC2::LastError::Trim()

               *> PC-EC2-LOAD: lists the servers again, which puts the switch back where the server
               *> really is.
               *> Uses:   AWS-EC2::Connection = the region of the list.
               *> Result: DG-EC2 shows the real state of every server.

               CALL    "PC-EC2-LOAD"
               GOBACK
           END-IF

           *> The Working window is a separate window that stays on top while the server changes
           *> state; the
           *> list is disabled meanwhile and the timer asks AWS every two seconds.

           INVOKE    ME::SetProperty( "WorkingText", "Waiting for " & WS-EC2-ID::Trim() & " to be " & WS-TARGET::Trim() & "…" )
           INVOKE    ME::OpenFormAsync( "WORKING-FORM" ) RETURNING WS-WORK
           SET     DG-EC2::Enabled               TO    FALSE
           SET     TMR-EC2::Enabled              TO    TRUE
]]></Event>
  </Control>
  <Control id="Tmr-Ec2" type="Timer" x="672" y="4" w="24" h="24" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="Interval">2000</Property>
    <Property name="Enabled">false</Property>
    <Event name="onTick" paragraph="TMR-EC2--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           SET     WS-OUT                        TO    AWS-EC2::Describe( WS-EC2-ID::Trim() )
           IF AWS-EC2::GetField( 1 "State" ) = WS-TARGET::Trim()
               SET     TMR-EC2::Enabled              TO    FALSE
               INVOKE    WS-WORK::Close()
               SET     DG-EC2::Enabled               TO    TRUE

               *> PC-EC2-LOAD: lists the servers again with the state AWS reports now.
               *> Uses:   AWS-EC2::Connection = the region of the list.
               *> Result: DG-EC2 shows the new state; LBL-EC2STATE says how many servers.

               CALL    "PC-EC2-LOAD"
           END-IF
]]></Event>
  </Control>
