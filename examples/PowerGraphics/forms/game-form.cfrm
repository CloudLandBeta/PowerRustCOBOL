    <Property name="Caption">Pitfall (Canvas2D)</Property>
    <Event name="onClick" paragraph="BTN-PITFALL--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           INVOKE    ME::OpenFormSync("PITFALL-FORM")
]]></Event>
  </Control>
