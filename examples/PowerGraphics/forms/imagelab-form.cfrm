<?xml version="1.0" encoding="UTF-8"?>
<Form name="IMAGELAB-FORM" title="PowerGraphics - Image lab" width="640" height="400" background="#1B1F27FF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" definition="The image lab of the PowerGraphics example: a picture held in memory is changed by filters (grey, invert, blur, sharpen, edges) and drawn on a canvas after each one." index-base="1">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
           CLASS RUST-I64 IS "Rust.i64"
           CLASS RUST-I128 IS "Rust.i128"
           CLASS RUST-ISIZE IS "Rust.isize"
           CLASS RUST-U8 IS "Rust.u8"
           CLASS RUST-U16 IS "Rust.u16"
           CLASS RUST-U32 IS "Rust.u32"
           CLASS RUST-U64 IS "Rust.u64"
           CLASS RUST-U128 IS "Rust.u128"
           CLASS RUST-USIZE IS "Rust.usize"
           CLASS RUST-F32 IS "Rust.f32"
           CLASS RUST-F64 IS "Rust.f64"
           CLASS RUST-STR IS "Rust.str"
           CLASS RUST-UNIT IS "Rust.unit"
           CLASS RUST-STRING IS "Rust.String"
           CLASS RUST-OSSTRING IS "Rust.OsString"
           CLASS RUST-OSSTR IS "Rust.OsStr"
           CLASS RUST-CSTRING IS "Rust.CString"
           CLASS RUST-CSTR IS "Rust.CStr"
           CLASS RUST-PATH IS "Rust.Path"
           CLASS RUST-PATHBUF IS "Rust.PathBuf"
           CLASS RUST-VEC IS "Rust.Vec"
           CLASS RUST-VECDEQUE IS "Rust.VecDeque"
           CLASS RUST-LINKEDLIST IS "Rust.LinkedList"
           CLASS RUST-HASHMAP IS "Rust.HashMap"
           CLASS RUST-BTREEMAP IS "Rust.BTreeMap"
           CLASS RUST-HASHSET IS "Rust.HashSet"
           CLASS RUST-BTREESET IS "Rust.BTreeSet"
           CLASS RUST-BINARYHEAP IS "Rust.BinaryHeap"
           CLASS RUST-OPTION IS "Rust.Option"
           CLASS RUST-RESULT IS "Rust.Result"
           CLASS RUST-BOX IS "Rust.Box"
           CLASS RUST-RC IS "Rust.Rc"
           CLASS RUST-ARC IS "Rust.Arc"
           CLASS RUST-WEAK IS "Rust.Weak"
           CLASS RUST-CELL IS "Rust.Cell"
           CLASS RUST-REFCELL IS "Rust.RefCell"
           CLASS RUST-MUTEX IS "Rust.Mutex"
           CLASS RUST-RWLOCK IS "Rust.RwLock"
           CLASS RUST-COW IS "Rust.Cow"
           CLASS RUST-DURATION IS "Rust.Duration"
           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"]]></repository>
  <form-events>
    <Event name="onLoad" paragraph="IMAGELAB-FORM--ONLOAD"><![CDATA[       PROCEDURE DIVISION.
           *> The chibi picture (Assets/chibi.png, 536 x 565) is loaded and shrunk to 228 x 240, then laid over a blue 320 x 240 picture.
           IMG-A::Create( 320 240 "#3366AA" )
           IMG-B::LoadAsset( "chibi.png" )
           IMG-B::Resize( 228 240 )
           IMG-A::Composite( IMG-B::GetHandle() 46 0 )
           IMG-A::DrawOnto( CNV-LAB::GetHandle() 0 0 )
           CNV-LAB::Present()
]]></Event>
    <Event name="onClose" paragraph="IMAGELAB-FORM--ONCLOSE">
    </Event>
  </form-events>
  <Control id="CNV-LAB" type="Canvas2D" x="10" y="10" w="320" h="240" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Definition">The drawing surface that shows the picture after each filter.</Property>
    <Property name="AccessibleLabel">The picture being filtered</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">0</Property>
    <Property name="BorderStyle">Single</Property>
  </Control>
  <Control id="IMG-A" type="ImageBuffer" x="340" y="330" w="60" h="24" tab-order="1" z-order="0" visible="true" enabled="true">
    <Property name="Definition">The picture the filters change: the chibi on a blue background, 320 by 240 pixels, held in memory.</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
  </Control>
  <Control id="IMG-B" type="ImageBuffer" x="410" y="330" w="60" h="24" tab-order="2" z-order="0" visible="true" enabled="true">
    <Property name="Definition">The chibi picture, loaded from Assets/chibi.png and laid over the blue background when the form opens.</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
  </Control>
  <Control id="BTN-GRAY" type="Button" x="500" y="10" w="130" h="32" tab-order="3" z-order="0" visible="true" enabled="true">
    <Property name="Definition">Turns the picture to shades of grey.</Property>
    <Property name="Caption">Grayscale</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Event name="onClick" paragraph="BTN-GRAY--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           IMG-A::Grayscale()
           IMG-A::DrawOnto( CNV-LAB::GetHandle() 0 0 )
           CNV-LAB::Present()
           SET     LBL-INFO::Caption             TO    "Grayscale"
]]></Event>
  </Control>
  <Control id="BTN-INV" type="Button" x="500" y="52" w="130" h="32" tab-order="4" z-order="0" visible="true" enabled="true">
    <Property name="Definition">Swaps every colour of the picture for its opposite.</Property>
    <Property name="Caption">Invert</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Event name="onClick" paragraph="BTN-INV--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           IMG-A::Invert()
           IMG-A::DrawOnto( CNV-LAB::GetHandle() 0 0 )
           CNV-LAB::Present()
           SET     LBL-INFO::Caption             TO    "Invert"
]]></Event>
  </Control>
  <Control id="BTN-BLUR" type="Button" x="500" y="94" w="130" h="32" tab-order="5" z-order="0" visible="true" enabled="true">
    <Property name="Definition">Softens the picture with a Gaussian blur of radius three.</Property>
    <Property name="Caption">Blur</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Event name="onClick" paragraph="BTN-BLUR--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           IMG-A::BlurGaussian( 3 )
           IMG-A::DrawOnto( CNV-LAB::GetHandle() 0 0 )
           CNV-LAB::Present()
           SET     LBL-INFO::Caption             TO    "Gaussian blur"
]]></Event>
  </Control>
  <Control id="BTN-SHARP" type="Button" x="500" y="136" w="130" h="32" tab-order="6" z-order="0" visible="true" enabled="true">
    <Property name="Definition">Makes the edges of the picture crisper.</Property>
    <Property name="Caption">Sharpen</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Event name="onClick" paragraph="BTN-SHARP--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           IMG-A::Sharpen( 1 )
           IMG-A::DrawOnto( CNV-LAB::GetHandle() 0 0 )
           CNV-LAB::Present()
           SET     LBL-INFO::Caption             TO    "Sharpen"
]]></Event>
  </Control>
  <Control id="BTN-EDGE" type="Button" x="500" y="178" w="130" h="32" tab-order="7" z-order="0" visible="true" enabled="true">
    <Property name="Definition">Replaces the picture by its outlines.</Property>
    <Property name="Caption">Edges</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Event name="onClick" paragraph="BTN-EDGE--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           IMG-A::EdgeDetect()
           IMG-A::DrawOnto( CNV-LAB::GetHandle() 0 0 )
           CNV-LAB::Present()
           SET     LBL-INFO::Caption             TO    "Edge detection"
]]></Event>
  </Control>
  <Control id="BTN-BACK" type="Button" x="500" y="220" w="130" h="32" tab-order="8" z-order="0" visible="true" enabled="true">
    <Property name="Definition">Closes the image lab and returns to the game window.</Property>
    <Property name="Caption">Close</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Event name="onClick" paragraph="BTN-BACK--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           INVOKE    ME::Close()
]]></Event>
  </Control>
  <Control id="LBL-INFO" type="Label" x="10" y="330" w="320" h="24" tab-order="9" z-order="0" visible="true" enabled="true">
    <Property name="Definition">The name of the filter that was applied last.</Property>
    <Property name="Caption">Press a filter.</Property>
    <Property name="ForegroundColor">#C8D0DC</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">0</Property>
    <Property name="BorderStyle">None</Property>
  </Control>
</Form>