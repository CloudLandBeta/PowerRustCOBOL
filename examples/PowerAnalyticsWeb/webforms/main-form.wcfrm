  <user-procedures>
    <Event name="FMT-SHORT" paragraph="FMT-SHORT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-FD                                  PIC    9(4)V99.
       01 WS-ED                                  PIC    ZZZ9.99.
       01 WS-EX                                  PIC    X(9).
       01 WS-SUF                                 PIC    X(4).

       PROCEDURE DIVISION.
           SET     WS-SUF                        TO    SPACES
           *> Scale to the largest unit WS-FV reaches (mil, mi, bi, tri), which keeps
           *> the mantissa small enough for WS-FD; below 1000 it is shown as is.

           IF    WS-FV >= 1000000000000
               COMPUTE    WS-FD ROUNDED = WS-FV / 1000000000000
               SET     WS-SUF                    TO    "tri"
           ELSE
               IF    WS-FV >= 1000000000
                   COMPUTE    WS-FD ROUNDED = WS-FV / 1000000000
                   SET     WS-SUF                TO    "bi"
               ELSE
                   IF    WS-FV >= 1000000
                       COMPUTE    WS-FD ROUNDED = WS-FV / 1000000
                       SET     WS-SUF            TO    "mi"
                   ELSE
                       IF    WS-FV >= 1000
                           COMPUTE    WS-FD ROUNDED = WS-FV / 1000
                           SET     WS-SUF        TO    "mil"
                       ELSE
                           SET     WS-FD         TO    WS-FV
                       END-IF
                   END-IF
               END-IF
           END-IF

           SET     WS-ED                         TO    WS-FD
           SET     WS-EX                         TO    WS-ED

           *> The edited picture prints a decimal point; pt-BR writes a comma.

           INSPECT    WS-EX CONVERTING "." TO ","
           SET     WS-FT                         TO    SPACES
           STRING    FUNCTION TRIM(WS-EX) " " FUNCTION TRIM(WS-SUF) INTO WS-FT
]]></Event>
    <Event name="FMT-SHORTN" paragraph="FMT-SHORTN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-FV < 1000
               SET     WS-FC                     TO    WS-FV

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = the whole part of WS-FV, set just above (WS-FC is 9(12), WS-FV is
               *>         9(15)V99, so any decimals are dropped). Caller's test (not read by
               *>         FMT-COUNT): WS-FV < 1000.
               *> Result: WS-FT = the digits of WS-FC with a point between groups of three, no
               *>         leading blanks.

               CALL    "FMT-COUNT"
           ELSE

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV, as the caller of FMT-SHORTN left it. Caller's test (not read by
               *>         FMT-SHORT): WS-FV is 1000 or more.
               *> Result: WS-FT = WS-FV scaled to mil (10^3), mi (10^6), bi (10^9) or tri (10^12),
               *>         two decimals with a comma, a blank and the suffix.

               CALL    "FMT-SHORT"
           END-IF
]]></Event>
    <Event name="FMT-COUNT" paragraph="FMT-COUNT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ED                                  PIC    ZZZ,ZZZ,ZZZ,ZZ9.
       01 WS-EX                                  PIC    X(20).

       PROCEDURE DIVISION.
           SET     WS-ED                         TO    WS-FC
           SET     WS-EX                         TO    WS-ED

           *> The picture groups thousands with commas; pt-BR groups with a point.

           INSPECT    WS-EX CONVERTING "," TO "."
           SET     WS-FT                         TO    FUNCTION TRIM(WS-EX)
]]></Event>
    <Event name="FMT-PCT" paragraph="FMT-PCT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ED                                  PIC    ZZ9.9.
       01 WS-EX                                  PIC    X(8).

       PROCEDURE DIVISION.
           SET     WS-ED                         TO    WS-FP
           SET     WS-EX                         TO    WS-ED

           *> The edited picture prints a decimal point; pt-BR writes a comma.

           INSPECT    WS-EX CONVERTING "." TO ","
           SET     WS-FT                         TO    SPACES
           STRING    FUNCTION TRIM(WS-EX) "%" INTO WS-FT
]]></Event>
    <Event name="INIT-DB" paragraph="INIT-DB"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> The database lives behind the Backend. FUND-INIT builds data/fundos.db from
           *> data/fundos.sql the first time any program is called, then answers what INIT-DB
           *> and LOAD-DIMS of the desktop read with DB-1: the universe, the reference date, the
           *> ten category slots and the level 2 / level 3 names (INI-RES). LOAD-DIMS paints them.
           *> The picker state (the desktop's tables pick, vis and chk) is PK-TAB / VS-TAB.

           SET     WS-LOADED                     TO    0
           SET     BE-PROG                       TO    "FUND-INIT"

           *> INI-RES, NAM-RES and GRD-RES hold OCCURS DEPENDING ON tables: an INITIALIZE of
           *> them stops the browser module (run-time error 1100) while a count is 0, so their
           *> status and counts are reset one by one before each call.

           SET     INI-STATUS                    TO    SPACES
           SET     INI-UNIV                      TO    0
           SET     INI-REFDATE                   TO    SPACES
           SET     INI-CAT-N                     TO    0
           SET     INI-N2-N                      TO    0
           SET     INI-N3-N                      TO    0
           CALL    "FUND-INIT" WITH WEBSOCKET LINKAGE
               RETURNING INI-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   SET     INI-STATUS            TO    "CALL"
           END-CALL

           EVALUATE    INI-STATUS
               WHEN "OK"
               WHEN "TRUNC"
                   SET     WS-LOADED             TO    1
               WHEN "NOFILE"
                   SET     WS-STATUS-TXT         TO    "Base de dados não encontrada (data/fundos.sql)"
                   SET     LBL-STATUS::Caption   TO    WS-STATUS-TXT
               WHEN "CALL"

                   *> BACKEND-FAIL: shows in the header line that a Backend call failed.
                   *> Uses:   BE-PROG = "FUND-INIT"; BE-STATUS = the class of the failed call and
                   *>         BE-MSG its message, both from COBOL::"WS-LAST-ERROR" above.
                   *> Result: LBL-STATUS::Caption = "Backend FUND-INIT: <class> <message>";
                   *>         WS-LOADED stays 0, so APPLY-FILTERS exits at once.

                   CALL    "BACKEND-FAIL"
               WHEN OTHER
                   SET     BE-STATUS             TO    INI-STATUS
                   SET     BE-MSG                TO    INI-MESSAGE

                   *> BACKEND-FAIL: shows in the header line that a Backend call failed.
                   *> Uses:   BE-PROG = "FUND-INIT"; BE-STATUS / BE-MSG = the status word and the
                   *>         message FUND-INIT answered (SQLERR: the database's own words).
                   *> Result: LBL-STATUS::Caption = "Backend FUND-INIT: <status> <message>";
                   *>         WS-LOADED stays 0, so APPLY-FILTERS exits at once.

                   CALL    "BACKEND-FAIL"
           END-EVALUATE
]]></Event>
    <Event name="LOAD-DIMS" paragraph="LOAD-DIMS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(60).
       01 WS-I                                   PIC    99.
       01 WS-TXT                                 PIC    X(120).

       PROCEDURE DIVISION.
           *> The answers come from FUND-INIT (INI-RES, asked by INIT-DB): the same five
           *> statements the desktop runs here. Without data/fundos.sql (NOFILE) the desktop
           *> still runs them on its empty database: 0 funds, no date, no names, and this line
           *> replaces INIT-DB's message; FUND-INIT answers the same zeros and blanks. Only a
           *> call that failed (Backend down) has no desktop counterpart: then the header keeps
           *> the error BACKEND-FAIL wrote, and APPLY-FILTERS asks FUND-INIT again.

           IF    WS-LOADED = 0 AND INI-STATUS NOT = "NOFILE"
               EXIT PARAGRAPH
           END-IF
           SET     WS-UNIV                       TO    INI-UNIV
           SET     WS-ROW                        TO    INI-REFDATE
           SET     WS-FC                         TO    WS-UNIV

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-UNIV, set just above: the number of rows of the fundos table
           *>         (COUNT(*)).
           *> Result: WS-FT = that count with points between thousands; the next lines place it in
           *>         the text for LBL-STATUS::Caption.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           STRING    "Base ANBIMA  |  referência " WS-ROW::Trim() "  |  " WS-FT::Trim() " fundo(s)"
               INTO WS-TXT
           SET     LBL-STATUS::Caption           TO    WS-TXT
           SET     WS-STATUS-TXT                 TO    WS-TXT
           SET     WS-BE-SHOWN                   TO    0

           LST-N2::Clear()
           LST-N3::Clear()

           *> The 10 most populated level-1 categories, most funds first, fill the
           *> fixed table WS-CAT-TAB. Q-CATS later matches its counts to these slots
           *> by name, so a category keeps its slot under any filter.

           SET     WS-CATCNT                     TO    0

           *> INI-CAT-NAME holds the level-1 categories most funds first (FUND-INIT runs the
           *> desktop's GROUP BY nivel1 ORDER BY COUNT(*) DESC); the first ten fill the slots.

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > INI-CAT-N
               IF    WS-CATCNT < 10
                   ADD    1 TO WS-CATCNT
                   SET     WS-CAT-NAME(WS-CATCNT)
                                                 TO    INI-CAT-NAME(WS-I)
               END-IF
           END-PERFORM

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > INI-N2-N
               LST-N2::AddItem(INI-N2-NAME(WS-I)::Trim())
           END-PERFORM

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > INI-N3-N
               LST-N3::AddItem(INI-N3-NAME(WS-I)::Trim())
           END-PERFORM
]]></Event>
    <Event name="MAKE-IN-LIST" paragraph="MAKE-IN-LIST"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ITEM                                PIC    X(60).
       01 WS-UP                                  PIC    9(5).
       01 WS-LEN                                 PIC    9(5).
       01 WS-IP                                  PIC    9(5).

       PROCEDURE DIVISION.
           SET     WS-IN                         TO    SPACES
           SET     WS-IP                         TO    1

           IF    WS-CHK = SPACES
               EXIT PARAGRAPH
           END-IF

           *> CheckedItems is one string of names joined by LF; UNSTRING WITH POINTER
           *> takes one name per pass until WS-UP passes the end. Names are quoted
           *> but not escaped: no level 2/3 name holds an apostrophe, unlike fund
           *> names (see SQ-ESC).

           SET     WS-LEN                        TO    FUNCTION LENGTH(WS-CHK::Trim())
           SET     WS-UP                         TO    1

           PERFORM    UNTIL WS-UP > WS-LEN
               SET     WS-ITEM                   TO    SPACES
               UNSTRING    WS-CHK DELIMITED BY X"0A" INTO WS-ITEM WITH POINTER WS-UP
               IF    WS-ITEM NOT = SPACES
                   IF    WS-IP > 1
                       STRING    "," INTO WS-IN WITH POINTER WS-IP
                   END-IF
                   STRING    "'" FUNCTION TRIM(WS-ITEM) "'" INTO WS-IN WITH POINTER WS-IP
               END-IF
           END-PERFORM
]]></Event>
    <Event name="NORM-TERM" paragraph="NORM-TERM"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Fold the text like the nome_key column (no accents, upper case) so
           *> 'itaú' finds 'ITAU'. An apostrophe becomes _, the LIKE wildcard for one
           *> character, so it can never end the quoted pattern early.

           INSPECT    WS-TERM CONVERTING "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑ'" TO "aaaaaeeeeiiiiooooouuuucnAAAAAEEEEIIIIOOOOOUUUUCN_"
           SET     WS-TERM                       TO    FUNCTION UPPER-CASE(WS-TERM)
           IF    WS-TERM = SPACES
               SET     WS-PAT                    TO    "%"
           ELSE
               SET     WS-PAT                    TO    SPACES
               STRING    "%" WS-TERM::Trim() "%" INTO WS-PAT
           END-IF
]]></Event>
    <Event name="SQ-ESC" paragraph="SQ-ESC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-EI                                  PIC    9(5).
       01 WS-EL                                  PIC    9(5).
       01 WS-PART                                PIC    X(200).
       01 WS-DL                                  PIC    X(2).
       01 WS-CNT                                 PIC    9(5).

       PROCEDURE DIVISION.
           SET     WS-ESC                        TO    SPACES
           SET     WS-BPTR                       TO    1
           SET     WS-EL                         TO    FUNCTION LENGTH(WS-ONE::Trim())
           SET     WS-EI                         TO    1

           *> Doubles every apostrophe, the escape inside an SQL string literal. Each
           *> UNSTRING pass gives the text before the next ' (COUNT IN = its length)
           *> and the delimiter found, blank for the last piece. WS-CNT > 0 avoids a
           *> zero-length reference modification.

           PERFORM    UNTIL WS-EI > WS-EL
               SET     WS-PART                   TO    SPACES
               SET     WS-DL                     TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-ONE DELIMITED BY "'" INTO WS-PART DELIMITER IN WS-DL COUNT IN WS-CNT WITH POINTER WS-EI
               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-ESC WITH POINTER WS-BPTR
               END-IF
               IF    WS-DL = "'"
                   STRING    "''" INTO WS-ESC WITH POINTER WS-BPTR
               END-IF
           END-PERFORM
]]></Event>
    <Event name="SM-TYPED" paragraph="SM-TYPED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Skip when the term is the same as the last one handled for this box.
           *> CLEAR-FILTERS and the x buttons reset WS-LAST-N / WS-LAST-C, so the
           *> same term can be searched again after a clear.

           IF    WS-SMX = "N"
               SET     WS-TERM                   TO    TXT-NOME::Text
               IF    WS-TERM = WS-LAST-N
                   EXIT PARAGRAPH
               END-IF
               SET     WS-LAST-N                 TO    WS-TERM
           ELSE
               SET     WS-TERM                   TO    TXT-CAT::Text
               IF    WS-TERM = WS-LAST-C
                   EXIT PARAGRAPH
               END-IF
               SET     WS-LAST-C                 TO    WS-TERM
           END-IF
           IF    WS-SM NOT = WS-SMX

               *> SM-OPEN: opens the search dropdown (layer POPUP-SEARCH) for the filter box named
               *> in WS-SMX.
               *> Uses:   WS-SMX = "N" or "C" (set by the TXT-NOME or TXT-CAT handler: the box being
               *>         typed in). Caller's test (not read by SM-OPEN): WS-SM differs from WS-SMX,
               *>         so no dropdown, or the other box's, is open.
               *> Result: WS-SM = WS-SMX; the Levels popup is closed if it was open (CLOSE-LEVELS);
               *>         LBL-SM-T::Caption = the title of that dropdown; the layout is recomputed
               *>         (SET-FILT-HEIGHT places the search card); SM-REFRESH fills LST-SM for the
               *>         typed text (at most 150 names for "N"), sets WS-SMN (all the matches) and
               *>         WS-SMK, sets LST-SM::CheckedItems (SM-TICKS) and LBL-SM-INFO::Caption
               *>         (SM-INFO); POPUP-SEARCH::Visible = TRUE.

               CALL    "SM-OPEN"
           ELSE

               *> SM-REFRESH: rebuilds the list LST-SM of the open dropdown from the text typed in
               *> its filter box.
               *> Uses:   WS-SM = WS-SMX: the dropdown of this box is already open. The new text is
               *>         read again from TXT-NOME::Text ("N") or TXT-CAT::Text ("C").
               *> Result: VS-TAB (the names of WS-SM) = the matches of the text (at most 150 names for
               *>         "N"; for "C" the categories that contain it); LST-SM = "Todos" + those
               *>         names, its CheckedItems set by SM-TICKS; WS-SMN = all the matches found
               *>         (for "N" it can exceed the 150 listed); WS-SMK = names listed;
               *>         LBL-SM-INFO::Caption updated (SM-INFO); WS-TERM = the folded text and
               *>         WS-PAT its LIKE pattern (NORM-TERM).

               CALL    "SM-REFRESH"
           END-IF
]]></Event>
    <Event name="SM-OPEN" paragraph="SM-OPEN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> CLOSE-LEVELS: closes the Levels 2 and 3 popup when it is open.
           *> Uses:   WS-LEVELS-OPEN (1 = the Levels popup is open); only one dropdown may show at a
           *>         time.
           *> Result: Only when WS-LEVELS-OPEN = 1: WS-LEVELS-OPEN = 0, POPUP-LEVELS::Visible =
           *>         FALSE and BTN-LEVELS::Caption = "Níveis 2 e 3". Otherwise nothing changes.

           CALL    "CLOSE-LEVELS"
           SET     WS-SM                         TO    WS-SMX
           IF    WS-SM = "N"
               SET     LBL-SM-T::Caption         TO    "Nome comercial  ·  marque os fundos que quer ver"
           ELSE
               SET     LBL-SM-T::Caption         TO    "Categoria  ·  marque as categorias que quer ver"
           END-IF

           *> SET-FILT-HEIGHT: lays the window out for its current size: filter bar height, popup
           *> cards, KPI strip, Dados page and grid.
           *> Uses:   me::Breakpoint, me::Width and me::Height; no data item is read (WS-LEVELS-OPEN
           *>         in particular is not: the Levels card is always placed). Popup layers are not
           *>         laid out by the form, so the search card has to be placed here before it is
           *>         shown.
           *> Result: everything is repositioned: FILT::Height (76 to 332 px by breakpoint and
           *>         width); position and size of the Levels card (LV-DROP, GRP-N2, LBL-F-N2,
           *>         LST-N2, GRP-N3, LBL-F-N3, LST-N3, SCRIM-LV) and of the search card (SM-DROP,
           *>         LBL-SM-T, LST-SM, LBL-SM-INFO, BTN-SM-CLR, BTN-SM-OK, SCRIM-SM), each only in
           *>         the properties it needs (SM-DROP and LST-SM keep their designed Height);
           *>         PG-DASH::VScroll (0 in Expanded, else 1); STRIP hidden in Compact, else shown
           *>         with the cards K1-C to K5-C, their labels and the dots DOT-K1 to DOT-K5;
           *>         PG-DATA, C-GRID, LBL-GRID-T, LBL-GRID-S, CMB-ORDER, GRD-FUNDOS, BTN-PREV,
           *>         LBL-PAGE and BTN-NEXT. Work items overwritten: WS-BP (holds me::Breakpoint).

           CALL    "SET-FILT-HEIGHT"

           *> SM-REFRESH: rebuilds the list LST-SM of the open dropdown from the text typed in its
           *> filter box.
           *> Uses:   WS-SM = WS-SMX ("N" or "C"), set above, selects the box; its text is read from
           *>         TXT-NOME::Text or TXT-CAT::Text (empty text matches every name or category).
           *> Result: VS-TAB (the names of WS-SM) = the matches (at most 150 names for "N"; for "C"
           *>         the categories that contain it); LST-SM = "Todos" + those names, its
           *>         CheckedItems set by SM-TICKS; WS-SMN = all the matches found (for "N" it can
           *>         exceed the 150 listed); WS-SMK = names listed; LBL-SM-INFO::Caption updated
           *>         (SM-INFO); WS-TERM = the folded text and WS-PAT its LIKE pattern (NORM-TERM).

           CALL    "SM-REFRESH"

           SET     POPUP-SEARCH::Visible         TO    TRUE
]]></Event>
    <Event name="SM-CLOSE" paragraph="SM-CLOSE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM NOT = SPACE
               SET     WS-SM                     TO    SPACE
               SET     POPUP-SEARCH::Visible     TO    FALSE
           END-IF
]]></Event>
    <Event name="SM-REFRESH" paragraph="SM-REFRESH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-SK2                                 PIC    9(3).

       PROCEDURE DIVISION.

           *> NAME-CLAUSE: puts the commercial-name part of the filter into FLT-REQ.
           *> Uses:   TXT-NOME::Text, WS-ALL-N (Todos mode) and the names kept in PK-N-NAME.
           *> Result: FLT-NAME-TERM = the typed text; FLT-NAME-N / FLT-NAME-PICK = the kept
           *>         names (none in Todos mode). FUND-NAMES reads them for the box "N" (the
           *>         typed text to search, the kept names to tick). Work items overwritten:
           *>         WS-TERM, WS-PAT (NORM-TERM).

           CALL    "NAME-CLAUSE"

           *> CAT-CLAUSE: puts the category part of the filter into FLT-REQ.
           *> Uses:   TXT-CAT::Text, WS-ALL-C (Todos mode) and the categories kept in PK-C-NAME.
           *> Result: FLT-CAT-TERM = the typed text; FLT-CAT-N / FLT-CAT-PICK = the kept
           *>         categories (none in Todos mode). FUND-NAMES reads them for the box "C".
           *>         Work items overwritten: WS-TERM, WS-PAT (NORM-TERM).

           CALL    "CAT-CLAUSE"

           IF    WS-SM = "N"
               SET     WS-TERM                   TO    TXT-NOME::Text
           ELSE
               SET     WS-TERM                   TO    TXT-CAT::Text
           END-IF

           *> NORM-TERM: folds a search text like the nome_key column (no accents, upper case,
           *> apostrophe turned into _) and builds the LIKE pattern.
           *> Uses:   WS-TERM = the text of TXT-NOME (WS-SM = "N") or of TXT-CAT, set just above
           *>         (WS-TERM is X(80): only the first 80 characters are kept).
           *> Result: WS-TERM = the folded text (itaú becomes ITAU); WS-PAT = "%" when WS-TERM is
           *>         blank, otherwise "%" + WS-TERM + "%". The search itself is folded again by
           *>         FUND-NAMES, from FLT-REQ: the browser never builds the pattern it runs.

           CALL    "NORM-TERM"

           *> The list shows at most 150 unique names (LIMIT), while NAM-MATCHES counts every
           *> match for the footer, so the total can exceed what is listed. For "C" the ten
           *> categories are folded and tested with instr() by the Backend, as the desktop did.

           *> BE-FLOW-BEGIN: a flow of Backend calls starts (FUND-NAMES).
           *> Uses:   WS-BE-DEPTH (0: no flow running) and WS-BE-FAILS.
           *> Result: WS-BE-DEPTH + 1; WS-BE-MARK = WS-BE-FAILS.

           CALL    "BE-FLOW-BEGIN"

           *> A FUND-INIT that FAILED (the page opened while the Backend was not reachable) was
           *> asked again by ENSURE-INIT, which every user act runs before it gets here.

           SET     NAM-BOX                       TO    WS-SM
           SET     BE-PROG                       TO    "FUND-NAMES"
           SET     NAM-STATUS                    TO    SPACES
           SET     NAM-MATCHES                   TO    0
           SET     NAM-LISTED                    TO    0
           CALL    "FUND-NAMES" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ NAM-REQ
               RETURNING NAM-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   SET     NAM-STATUS            TO    SPACES
                   SET     NAM-MATCHES           TO    0
                   SET     NAM-LISTED            TO    0
           END-CALL
           IF    NAM-STATUS NOT = "OK" AND NAM-STATUS NOT = "TRUNC"
               IF    NAM-STATUS NOT = SPACES
                   SET     BE-STATUS             TO    NAM-STATUS
                   SET     BE-MSG                TO    NAM-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-NAMES"; BE-STATUS / BE-MSG = the class and message of
               *>         the failed call, or the status word and message FUND-NAMES answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-NAMES: <status> <message>"; the
               *>         list below is rebuilt empty ("Todos" only).

               CALL    "BACKEND-FAIL"
           END-IF

           *> BE-FLOW-END: the flow of Backend calls ends.
           *> Uses:   WS-BE-DEPTH, WS-BE-FAILS against WS-BE-MARK, WS-BE-SHOWN, WS-STATUS-TXT.
           *> Result: WS-BE-DEPTH - 1; when FUND-NAMES answered and a Backend error was showing,
           *>         LBL-STATUS::Caption = WS-STATUS-TXT again and WS-BE-SHOWN = 0.

           CALL    "BE-FLOW-END"

           SET     WS-SMN                        TO    NAM-MATCHES
           SET     WS-SMK                        TO    0
           IF    WS-SM = "N"
               SET     VS-N-N                    TO    0
           ELSE
               SET     VS-C-N                    TO    0
           END-IF

           LST-SM::Clear()
           LST-SM::AddItem("Todos")

           PERFORM    VARYING WS-SK2 FROM 1 BY 1 UNTIL WS-SK2 > NAM-LISTED
               ADD    1 TO WS-SMK
               IF    WS-SM = "N"
                   ADD    1 TO VS-N-N
                   SET     VS-N-NAME(VS-N-N)     TO    NAM-NAME(WS-SK2)
                   SET     VS-N-ID(VS-N-N)       TO    NAM-ID(WS-SK2)
               ELSE
                   IF    VS-C-N < 10
                       ADD    1 TO VS-C-N
                       SET     VS-C-NAME(VS-C-N) TO    NAM-NAME(WS-SK2)
                   END-IF
               END-IF
               LST-SM::AddItem(NAM-NAME(WS-SK2)::Trim())
           END-PERFORM

           *> SM-TICKS: ticks the rows of LST-SM that belong to the filter (all of them in Todos
           *> mode, otherwise the kept picks).
           *> Uses:   WS-SM, the Todos flags WS-ALL-N / WS-ALL-C, VS-TAB (the names just listed
           *>         in LST-SM) and PK-TAB (the names kept).
           *> Result: LST-SM::CheckedItems = "Todos" + every listed name in Todos mode, otherwise
           *>         only the listed names that are kept (joined by LF); SPACES when nothing is
           *>         to be ticked. Work items overwritten: WS-BIG, WS-BPTR.

           CALL    "SM-TICKS"

           *> SM-INFO: writes the status line under the dropdown list: matches found, rows listed,
           *> names ticked.
           *> Uses:   WS-SMN (matches found) and WS-SMK (names listed) from the lines above, the
           *>         number of names kept for WS-SM and the Todos flags.
           *> Result: LBL-SM-INFO::Caption = the message ("Todos: ...", "... marcado(s): só eles
           *>         entram no filtro" or "... nenhum marcado: vale o texto digitado").

           CALL    "SM-INFO"
]]></Event>
    <Event name="SM-TICKS" paragraph="SM-TICKS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    9(3).
       01 WS-J                                   PIC    9(3).
       01 WS-TODOS                               PIC    9.
       01 WS-HIT                                 PIC    9.

       PROCEDURE DIVISION.
           SET     WS-BIG                        TO    SPACES
           SET     WS-BPTR                       TO    1
           SET     WS-TODOS                      TO    0

           *> In Todos mode the list ticks 'Todos' and every name; otherwise only the
           *> listed names already kept (PK-TAB: a company name by the byte of its id). Names
           *> are joined with LF, the separator CheckedItems uses, in the order of the list
           *> (VS-TAB).

           IF    (WS-SM = "N" AND WS-ALL-N = 1) OR (WS-SM = "C" AND WS-ALL-C = 1)
               SET     WS-TODOS                  TO    1
               STRING    "Todos" INTO WS-BIG WITH POINTER WS-BPTR
           END-IF

           IF    WS-SM = "N"
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > VS-N-N
                   SET     WS-HIT                TO    WS-TODOS
                   IF    WS-HIT = 0 AND VS-N-ID(WS-I) > 0 AND VS-N-ID(WS-I) <= 50000
                       IF    PK-N-FLAGS(VS-N-ID(WS-I):1) = "1"
                           SET     WS-HIT        TO    1
                       END-IF
                   END-IF
                   IF    WS-HIT = 1
                       IF    WS-BPTR > 1
                           STRING    X"0A" INTO WS-BIG WITH POINTER WS-BPTR
                       END-IF
                       STRING    VS-N-NAME(WS-I)::Trim() INTO WS-BIG WITH POINTER WS-BPTR
                   END-IF
               END-PERFORM
           ELSE
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > VS-C-N
                   SET     WS-HIT                TO    WS-TODOS
                   PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PK-C-N OR WS-HIT = 1
                       IF    PK-C-NAME(WS-J) = VS-C-NAME(WS-I)
                           SET     WS-HIT        TO    1
                       END-IF
                   END-PERFORM
                   IF    WS-HIT = 1
                       IF    WS-BPTR > 1
                           STRING    X"0A" INTO WS-BIG WITH POINTER WS-BPTR
                       END-IF
                       STRING    VS-C-NAME(WS-I)::Trim() INTO WS-BIG WITH POINTER WS-BPTR
                   END-IF
               END-PERFORM
           END-IF
           IF    WS-BPTR = 1
               SET     LST-SM::CheckedItems      TO    SPACES
           ELSE
               SET     LST-SM::CheckedItems      TO    WS-BIG::Trim()
           END-IF
]]></Event>
    <Event name="SM-INFO" paragraph="SM-INFO"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-SMP                                 PIC    9(9).
       01 WS-E1                                  PIC    Z(8)9.
       01 WS-E2                                  PIC    Z(8)9.
       01 WS-E3                                  PIC    Z(8)9.
       01 WS-MSG                                 PIC    X(160).

       PROCEDURE DIVISION.
           *> The names kept for the open box (the desktop counts its rows of pick).

           IF    WS-SM = "N"
               SET     WS-SMP                    TO    PK-N-N
           ELSE
               SET     WS-SMP                    TO    PK-C-N
           END-IF
           SET     WS-FC                         TO    WS-SMN

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-SMN, set just above: how many names (or categories) match the
           *>         search text.
           *> Result: WS-FT = that number with points between thousands; the message for LBL-SM-INFO
           *>         is built from it next.

           CALL    "FMT-COUNT"
           SET     WS-MSG                        TO    SPACES
           *> Same rule as NAME-CLAUSE / CAT-CLAUSE: Todos = every search hit, any
           *> ticks = only those, no ticks = the typed text.

           IF    (WS-SM = "N" AND WS-ALL-N = 1) OR (WS-SM = "C" AND WS-ALL-C = 1)
               STRING    "Todos: os " WS-FT::Trim() " resultado(s) da busca entram no filtro."
                   INTO WS-MSG
           ELSE
               SET     WS-E2                     TO    WS-SMK
               SET     WS-E3                     TO    WS-SMP

               IF    WS-SMP > 0
                   STRING    WS-FT::Trim() " encontrado(s)  ·  exibindo " FUNCTION TRIM(WS-E2)
                       "  ·  " FUNCTION TRIM(WS-E3) " marcado(s): só eles entram no filtro"
                       INTO WS-MSG
               ELSE
                   STRING    WS-FT::Trim() " encontrado(s)  ·  exibindo " FUNCTION TRIM(WS-E2)
                       "  ·  nenhum marcado: vale o texto digitado"
                       INTO WS-MSG
               END-IF
           END-IF
           SET     LBL-SM-INFO::Caption          TO    WS-MSG
]]></Event>
    <Event name="SM-CAPTIONS" paragraph="SM-CAPTIONS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-KN                                  PIC    9(9).
       01 WS-KC                                  PIC    9(9).
       01 WS-EN                                  PIC    Z(8)9.
       01 WS-CAPT                                PIC    X(60).

       PROCEDURE DIVISION.
           *> The names kept in each box (the desktop counts its rows of pick per fld).

           SET     WS-KN                         TO    PK-N-N
           SET     WS-KC                         TO    PK-C-N
           SET     WS-CAPT                       TO    SPACES
           IF    WS-ALL-N = 1
               SET     WS-CAPT                   TO    "Nome comercial  ·  Todos"
           ELSE
               IF    WS-KN > 0
                   SET     WS-EN                 TO    WS-KN
                   STRING    "Nome comercial  ·  " FUNCTION TRIM(WS-EN) " marcado(s)" INTO WS-CAPT
               ELSE
                   SET     WS-CAPT               TO    "Nome comercial"
               END-IF
           END-IF

           SET     LBL-F-NOME::Caption           TO    WS-CAPT
           SET     WS-CAPT                       TO    SPACES

           IF    WS-ALL-C = 1
               SET     WS-CAPT                   TO    "Categoria  ·  Todos"
           ELSE
               IF    WS-KC > 0
                   SET     WS-EN                 TO    WS-KC
                   STRING    "Categoria  ·  " FUNCTION TRIM(WS-EN) " marcado(s)" INTO WS-CAPT
               ELSE
                   SET     WS-CAPT               TO    "Categoria"
               END-IF
           END-IF
           SET     LBL-F-CAT::Caption            TO    WS-CAPT
]]></Event>
    <Event name="SM-CHECKED" paragraph="SM-CHECKED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-UP2                                 PIC    9(5).
       01 WS-LN                                  PIC    9(5).
       01 WS-TODOS                               PIC    9.
       01 WS-ALLC                                PIC    9.
       01 WS-I                                   PIC    9(3).
       01 WS-J                                   PIC    9(3).
       01 WS-K                                   PIC    9(3).
       01 WS-IN-VIS                              PIC    9.
       01 WS-IN-CHK                              PIC    9.
       01 WS-HAVE                                PIC    9.
      *> chk of the desktop: the names ticked in the list right now ("Todos" apart).
       01 WS-CK-N                                PIC    9(3).
       01 WS-CK-TAB.
           05 WS-CK-NAME                         PIC    X(200)    OCCURS 151.

       PROCEDURE DIVISION.
           SET     WS-BIG                        TO    LST-SM::CheckedItems
           SET     WS-CK-N                       TO    0
           SET     WS-TODOS                      TO    0

           IF    WS-BIG NOT = SPACES
               SET     WS-LN                     TO    FUNCTION LENGTH(WS-BIG::Trim())
               SET     WS-UP2                    TO    1

               PERFORM    UNTIL WS-UP2 > WS-LN
                   SET     WS-ONE                TO    SPACES
                   UNSTRING    WS-BIG DELIMITED BY X"0A" INTO WS-ONE WITH POINTER WS-UP2
                   IF    WS-ONE = "Todos"
                       SET     WS-TODOS          TO    1
                   ELSE
                       IF    WS-ONE NOT = SPACES AND WS-CK-N < 151
                           ADD    1 TO WS-CK-N
                           SET     WS-CK-NAME(WS-CK-N)
                                                 TO    WS-ONE
                       END-IF
                   END-IF
               END-PERFORM
           END-IF
           IF    WS-SM = "N"
               SET     WS-ALLC                   TO    WS-ALL-N
           ELSE
               SET     WS-ALLC                   TO    WS-ALL-C
           END-IF
           *> Old mode (WS-ALLC) against the ticks now: Todos just ticked = all hits,
           *> picks dropped; Todos just unticked = nothing picked; else an item
           *> changed: leave Todos mode and sync the kept names only for the names
           *> listed (VS-TAB), so picks made under an earlier search survive.

           EVALUATE    TRUE
               WHEN WS-ALLC = 0 AND WS-TODOS = 1

                   *> SM-SET-ALL: turns Todos mode on for the open dropdown (every search hit will
                   *> enter the filter).
                   *> Uses:   WS-SM = "N" or "C" (the open dropdown). Caller's test (not read by
                   *>         SM-SET-ALL): Todos was off before (WS-ALLC = 0) and is ticked now
                   *>         (WS-TODOS = 1).
                   *> Result: WS-ALL-N = 1 when WS-SM = "N", otherwise WS-ALL-C = 1. The names
                   *>         kept for WS-SM are dropped right after.

                   CALL    "SM-SET-ALL"
                   IF    WS-SM = "N"
                       SET     PK-N-N            TO    0
                       SET     PK-N-FLAGS        TO    SPACES
                   ELSE
                       SET     PK-C-N            TO    0
                   END-IF
               WHEN WS-ALLC = 1 AND WS-TODOS = 0

                   *> SM-CLR-ALL: turns Todos mode off for the open dropdown.
                   *> Uses:   WS-SM = "N" or "C". Caller's test (not read by SM-CLR-ALL): Todos was
                   *>         on before (WS-ALLC = 1) and is unticked now (WS-TODOS = 0).
                   *> Result: WS-ALL-N = 0 when WS-SM = "N", otherwise WS-ALL-C = 0. The names
                   *>         kept for WS-SM are dropped right after, so nothing stays picked.

                   CALL    "SM-CLR-ALL"
                   IF    WS-SM = "N"
                       SET     PK-N-N            TO    0
                       SET     PK-N-FLAGS        TO    SPACES
                   ELSE
                       SET     PK-C-N            TO    0
                   END-IF
               WHEN OTHER

                   *> SM-CLR-ALL: turns Todos mode off for the open dropdown.
                   *> Uses:   WS-SM = "N" or "C". Caller's test (not read by SM-CLR-ALL): neither
                   *>         case above, so Todos did not change and an ordinary name was ticked or
                   *>         unticked.
                   *> Result: WS-ALL-N = 0 when WS-SM = "N", otherwise WS-ALL-C = 0 (Todos mode off,
                   *>         even if it was already). The kept names are synced with the ticks
                   *>         right after.

                   CALL    "SM-CLR-ALL"
                   IF    WS-SM = "N"
                   *> DELETE FROM pick (a kept name that is listed and no longer ticked goes) and
                   *> INSERT OR IGNORE INTO pick (a ticked name that is listed comes in), one listed
                   *> row at a time: the row's id byte follows its tick. A kept name the list does
                   *> not show is left as it is. A ticked line is read into X(200) (WS-ONE, as on
                   *> the desktop), so a name longer than 200 bytes never equals its list row and
                   *> is never kept, exactly as the desktop's chk/vis comparison goes.
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > VS-N-N
                       SET     WS-IN-CHK                 TO    0
                       PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-CK-N OR WS-IN-CHK = 1
                           IF    WS-CK-NAME(WS-J) = VS-N-NAME(WS-I)
                               SET     WS-IN-CHK         TO    1
                           END-IF
                       END-PERFORM
                       IF    VS-N-ID(WS-I) > 0 AND VS-N-ID(WS-I) <= 50000
                           IF    WS-IN-CHK = 1
                               IF    PK-N-FLAGS(VS-N-ID(WS-I):1) NOT = "1"
                                   SET     PK-N-FLAGS(VS-N-ID(WS-I):1) TO "1"
                                   ADD    1 TO PK-N-N
                               END-IF
                           ELSE
                               IF    PK-N-FLAGS(VS-N-ID(WS-I):1) = "1"
                                   SET     PK-N-FLAGS(VS-N-ID(WS-I):1) TO SPACE
                                   SUBTRACT    1 FROM PK-N-N
                               END-IF
                           END-IF
                       END-IF
                   END-PERFORM
                   ELSE
                   SET     WS-K                          TO    0
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PK-C-N
                       SET     WS-IN-VIS                 TO    0
                       PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > VS-C-N OR WS-IN-VIS = 1
                           IF    VS-C-NAME(WS-J) = PK-C-NAME(WS-I)
                               SET     WS-IN-VIS         TO    1
                           END-IF
                       END-PERFORM
                       SET     WS-IN-CHK                 TO    0
                       PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-CK-N OR WS-IN-CHK = 1
                           IF    WS-CK-NAME(WS-J) = PK-C-NAME(WS-I)
                               SET     WS-IN-CHK         TO    1
                           END-IF
                       END-PERFORM
                       IF    WS-IN-VIS = 0 OR WS-IN-CHK = 1
                           ADD    1 TO WS-K
                           SET     PK-C-NAME(WS-K)       TO    PK-C-NAME(WS-I)
                       END-IF
                   END-PERFORM
                   SET     PK-C-N                        TO    WS-K
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CK-N
                       SET     WS-IN-VIS                 TO    0
                       PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > VS-C-N OR WS-IN-VIS = 1
                           IF    VS-C-NAME(WS-J) = WS-CK-NAME(WS-I)
                               SET     WS-IN-VIS         TO    1
                           END-IF
                       END-PERFORM
                       SET     WS-HAVE                   TO    0
                       PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PK-C-N OR WS-HAVE = 1
                           IF    PK-C-NAME(WS-J) = WS-CK-NAME(WS-I)
                               SET     WS-HAVE           TO    1
                           END-IF
                       END-PERFORM
                       IF    WS-IN-VIS = 1 AND WS-HAVE = 0 AND PK-C-N < 10
                           ADD    1 TO PK-C-N
                           SET     PK-C-NAME(PK-C-N)     TO    WS-CK-NAME(WS-I)
                       END-IF
                   END-PERFORM
                   END-IF
           END-EVALUATE

           *> SM-TICKS: ticks the rows of LST-SM that belong to the filter (all of them in Todos
           *> mode, otherwise the kept picks).
           *> Uses:   WS-SM, the Todos flags just updated and PK-TAB just synced with the ticks.
           *> Result: LST-SM::CheckedItems is rewritten to the new state: "Todos" + every listed
           *>         name in Todos mode, otherwise the listed names that are kept; SPACES when
           *>         nothing is to be ticked. Work items overwritten: WS-BIG, WS-BPTR.

           CALL    "SM-TICKS"

           *> SM-INFO: writes the status line under the dropdown list: matches found, rows listed,
           *> names ticked.
           *> Uses:   WS-SMN and WS-SMK (unchanged by the click), the number of names kept for
           *>         WS-SM now and the Todos flags.
           *> Result: LBL-SM-INFO::Caption = the message for the new state (Todos / N marcado(s) /
           *>         nenhum marcado).

           CALL    "SM-INFO"

           *> SM-CAPTIONS: sets the captions of the two filter labels from the picks kept for each
           *> box.
           *> Uses:   PK-N-N and PK-C-N (the names kept per box), WS-ALL-N and WS-ALL-C.
           *> Result: LBL-F-NOME::Caption = "Nome comercial  ·  Todos" (WS-ALL-N = 1), "Nome
           *>         comercial  ·  K marcado(s)" (K > 0) or "Nome comercial"; LBL-F-CAT::Caption
           *>         the same way with "Categoria".

           CALL    "SM-CAPTIONS"
]]></Event>
    <Event name="SM-SET-ALL" paragraph="SM-SET-ALL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM = "N"
               SET     WS-ALL-N                  TO    1
           ELSE
               SET     WS-ALL-C                  TO    1
           END-IF
]]></Event>
    <Event name="SM-CLR-ALL" paragraph="SM-CLR-ALL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM = "N"
               SET     WS-ALL-N                  TO    0
           ELSE
               SET     WS-ALL-C                  TO    0
           END-IF
]]></Event>
    <Event name="SM-CLEAR-PICKS" paragraph="SM-CLEAR-PICKS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLR-ALL: turns Todos mode off for the open dropdown.
           *> Uses:   WS-SM = "N" or "C": the dropdown that is open.
           *> Result: WS-ALL-N = 0 when WS-SM = "N", otherwise WS-ALL-C = 0. The picks of WS-SM are
           *>         deleted right after.

           CALL    "SM-CLR-ALL"
           IF    WS-SM = "N"
               SET     PK-N-N                    TO    0
               SET     PK-N-FLAGS                TO    SPACES
           ELSE
               SET     PK-C-N                    TO    0
           END-IF

           *> SM-TICKS: ticks the rows of LST-SM that belong to the filter (all of them in Todos
           *> mode, otherwise the kept picks).
           *> Uses:   WS-SM; the names kept for it were just dropped and its Todos flag is off.
           *> Result: LST-SM::CheckedItems = SPACES: no row of the list stays ticked. Work items
           *>         overwritten: WS-BIG, WS-BPTR.

           CALL    "SM-TICKS"

           *> SM-INFO: writes the status line under the dropdown list: matches found, rows listed,
           *> names ticked.
           *> Uses:   WS-SMN and WS-SMK (unchanged) and no name kept for WS-SM now.
           *> Result: LBL-SM-INFO::Caption = the "nenhum marcado: vale o texto digitado" message
           *>         (typed text rules again).

           CALL    "SM-INFO"

           *> SM-CAPTIONS: sets the captions of the two filter labels from the picks kept for each
           *> box.
           *> Uses:   the pick counts of 'N' and 'C' and the flags WS-ALL-N / WS-ALL-C, WS-SM's ones
           *>         just cleared.
           *> Result: the label of the open box (LBL-F-NOME for "N", LBL-F-CAT for "C") goes back to
           *>         its plain "Nome comercial" / "Categoria"; the other label is recomputed from
           *>         its own picks.

           CALL    "SM-CAPTIONS"
]]></Event>
    <Event name="SM-RESET" paragraph="SM-RESET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     PK-N-N                        TO    0
           SET     PK-N-FLAGS                    TO    SPACES
           SET     PK-C-N                        TO    0
           SET     VS-N-N                        TO    0
           SET     VS-C-N                        TO    0
           SET     WS-ALL-N                      TO    0
           SET     WS-ALL-C                      TO    0

           *> SM-CAPTIONS: sets the captions of the two filter labels from the picks kept for each
           *> box.
           *> Uses:   PK-TAB and VS-TAB were just emptied and WS-ALL-N, WS-ALL-C set to 0, so
           *>         every count is 0.
           *> Result: LBL-F-NOME::Caption = "Nome comercial" and LBL-F-CAT::Caption = "Categoria"
           *>         (no mark, no Todos).

           CALL    "SM-CAPTIONS"
]]></Event>
    <Event name="NAME-CLAUSE" paragraph="NAME-CLAUSE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-K1                                  PIC    9(9).

       PROCEDURE DIVISION.
           SET     WS-TERM                       TO    TXT-NOME::Text

           *> NORM-TERM: folds a search text like the nome_key column (no accents, upper case,
           *> apostrophe turned into _) and builds the LIKE pattern.
           *> Uses:   WS-TERM = TXT-NOME::Text, set just above (only the first 80 characters fit
           *>         WS-TERM).
           *> Result: WS-TERM = the folded text; WS-PAT = "%" when WS-TERM is blank, otherwise "%" +
           *>         WS-TERM + "%". The Backend folds FLT-NAME-TERM the same way for its LIKE test.

           CALL    "NORM-TERM"

           *> Picked names, if any, replace the typed text as the filter. Todos mode
           *> keeps no picks (FLT-NAME-N stays 0), so it falls back to the text, which
           *> means every search hit. The rule itself is applied by the Backend (OPN-MAKE-WHERE).

           SET     WS-CUT-IN                     TO    TXT-NOME::Text

           *> TERM-CUT: the part of a typed text that travels to the Backend.
           *> Uses:   WS-CUT-IN = TXT-NOME::Text, set just above (its first 84 bytes).
           *> Result: WS-CUT-OUT = its first 80 bytes (the desktop's WS-TERM) and, when the 80th
           *>         byte falls inside a letter, the rest of that letter; the Backend cuts it to 80.

           CALL    "TERM-CUT"
           SET     FLT-NAME-TERM                 TO    WS-CUT-OUT
           SET     FLT-NAME-N                    TO    0
           SET     FLT-NAME-FLAGS                TO    SPACES
           IF    WS-ALL-N = 0
               SET     FLT-NAME-N                TO    PK-N-N
               SET     FLT-NAME-FLAGS            TO    PK-N-FLAGS
           END-IF
]]></Event>
    <Event name="CAT-CLAUSE" paragraph="CAT-CLAUSE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-K2                                  PIC    9(9).

       PROCEDURE DIVISION.
           SET     WS-TERM                       TO    TXT-CAT::Text

           *> NORM-TERM: folds a search text like the nome_key column (no accents, upper case,
           *> apostrophe turned into _) and builds the LIKE pattern.
           *> Uses:   WS-TERM = TXT-CAT::Text, set just above (only the first 80 characters fit
           *>         WS-TERM).
           *> Result: WS-TERM = the folded text; WS-PAT is rebuilt too. The Backend folds
           *>         FLT-CAT-TERM the same way and keeps the categories that contain it.

           CALL    "NORM-TERM"

           *> Picked categories, if any, win. Otherwise the typed text filters through the
           *> categories whose folded name contains it (the desktop's table vis, which the
           *> Backend computes from FLT-CAT-TERM: nivel1 has no folded key column).

           SET     WS-CUT-IN                     TO    TXT-CAT::Text

           *> TERM-CUT: the part of a typed text that travels to the Backend.
           *> Uses:   WS-CUT-IN = TXT-CAT::Text, set just above (its first 84 bytes).
           *> Result: WS-CUT-OUT = its first 80 bytes (the desktop's WS-TERM) and, when the 80th
           *>         byte falls inside a letter, the rest of that letter; the Backend cuts it to 80.

           CALL    "TERM-CUT"
           SET     FLT-CAT-TERM                  TO    WS-CUT-OUT
           SET     FLT-CAT-N                     TO    0
           IF    WS-ALL-C = 0
               SET     FLT-CAT-N                 TO    PK-C-N
               PERFORM    VARYING WS-K2 FROM 1 BY 1 UNTIL WS-K2 > PK-C-N
                   SET     FLT-CAT-PICK(WS-K2)   TO    PK-C-NAME(WS-K2)
               END-PERFORM
           END-IF
]]></Event>
    <Event name="BUILD-WHERE" paragraph="BUILD-WHERE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ITEM                                PIC    X(60).
       01 WS-UP                                  PIC    9(5).
       01 WS-LEN                                 PIC    9(5).

       PROCEDURE DIVISION.
           *> On the web the filter travels as VALUES (FLT-REQ) to the Backend programs, whose
           *> fixed statements apply the rules the desktop writes into WS-WHERE: picks win over
           *> the typed text, a date or PL range left at its limits adds no test (FLT-DATE-*,
           *> FLT-PL-* are sent as they are and the Backend compares them with the limits).

           *> NAME-CLAUSE: puts the commercial-name part of the filter into FLT-REQ.
           *> Uses:   TXT-NOME::Text, WS-ALL-N (Todos mode) and the names kept in PK-N-NAME.
           *> Result: FLT-NAME-TERM = the typed text; FLT-NAME-N / FLT-NAME-PICK = the kept names
           *>         (none in Todos mode). WS-TERM = the folded text of TXT-NOME and WS-PAT its
           *>         LIKE pattern (NORM-TERM).

           CALL    "NAME-CLAUSE"

           *> CAT-CLAUSE: puts the category part of the filter into FLT-REQ.
           *> Uses:   TXT-CAT::Text, WS-ALL-C (Todos mode) and the categories kept in PK-C-NAME.
           *> Result: FLT-CAT-TERM = the typed text; FLT-CAT-N / FLT-CAT-PICK = the kept
           *>         categories (none in Todos mode). WS-TERM = the folded text of TXT-CAT and
           *>         WS-PAT its pattern (NORM-TERM).

           CALL    "CAT-CLAUSE"

           SET     FLT-DATE-FROM                 TO    DTP-INI::Value
           SET     FLT-DATE-TO                   TO    DTP-FIM::Value

           *> The PL range is in R$ million; the Backend multiplies by 1000000 and applies it
           *> only once moved from its full 0 to 300000 span, so funds with no PL stay in.

           SET     FLT-PL-FROM                   TO    NUD-PL1::Value
           SET     FLT-PL-TO                     TO    NUD-PL2::Value

           *> CheckedItems is one string of names joined by LF; UNSTRING WITH POINTER takes
           *> one name per pass (as MAKE-IN-LIST did for the SQL list): a blank one is skipped.

           SET     FLT-N2-N                      TO    0
           SET     WS-CHK                        TO    LST-N2::CheckedItems
           IF    WS-CHK NOT = SPACES
               SET     WS-LEN                    TO    FUNCTION LENGTH(WS-CHK::Trim())
               SET     WS-UP                     TO    1
               PERFORM    UNTIL WS-UP > WS-LEN
                   SET     WS-ITEM               TO    SPACES
                   UNSTRING    WS-CHK DELIMITED BY X"0A" INTO WS-ITEM WITH POINTER WS-UP
                   IF    WS-ITEM NOT = SPACES AND FLT-N2-N < 32
                       ADD    1 TO FLT-N2-N
                       SET     FLT-N2-PICK(FLT-N2-N)
                                                 TO    FUNCTION TRIM(WS-ITEM)
                   END-IF
               END-PERFORM
           END-IF

           SET     FLT-N3-N                      TO    0
           SET     WS-CHK                        TO    LST-N3::CheckedItems
           IF    WS-CHK NOT = SPACES
               SET     WS-LEN                    TO    FUNCTION LENGTH(WS-CHK::Trim())
               SET     WS-UP                     TO    1
               PERFORM    UNTIL WS-UP > WS-LEN
                   SET     WS-ITEM               TO    SPACES
                   UNSTRING    WS-CHK DELIMITED BY X"0A" INTO WS-ITEM WITH POINTER WS-UP
                   IF    WS-ITEM NOT = SPACES AND FLT-N3-N < 64
                       ADD    1 TO FLT-N3-N
                       SET     FLT-N3-PICK(FLT-N3-N)
                                                 TO    FUNCTION TRIM(WS-ITEM)
                   END-IF
               END-PERFORM
           END-IF

           *> FLT-SAVE: keeps this filter as the one of the last Apply.
           *> Uses:   FLT-REQ, just filled above.
           *> Result: FLS-REQ = a copy of FLT-REQ; Q-GRID pages and re-sorts with it (FLT-RESTORE),
           *>         as the desktop does with the WS-WHERE of the last APPLY-FILTERS.

           CALL    "FLT-SAVE"
]]></Event>
    <Event name="Q-TOTALS" paragraph="Q-TOTALS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> FUND-TOTALS runs the desktop's two statements (one row of totals; the PL per
           *> estrutura) over the funds that pass FLT-REQ. COUNT(pl) counts only the funds that
           *> report a PL and is the divisor for the average PL; MAX(ano) anchors the Q-YEARS
           *> window. "Classe" is WS-T-CLS, any other estrutura WS-T-SUB.

           SET     BE-PROG                       TO    "FUND-TOTALS"
           INITIALIZE    TOT-RES
           CALL    "FUND-TOTALS" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ
               RETURNING TOT-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   INITIALIZE    TOT-RES
                   SET     TOT-STATUS            TO    "CALL"
           END-CALL
           IF    TOT-STATUS NOT = "OK"
               IF    TOT-STATUS NOT = "CALL"
                   SET     BE-STATUS             TO    TOT-STATUS
                   SET     BE-MSG                TO    TOT-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-TOTALS"; BE-STATUS / BE-MSG = the class and message of the
               *>         failed call (COBOL::"WS-LAST-ERROR"), or the status word and message
               *>         FUND-TOTALS answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-TOTALS: <status> <message>"; the totals stay 0.

               CALL    "BACKEND-FAIL"
           END-IF

           SET     WS-T-CNT                      TO    TOT-CNT
           SET     WS-T-PL                       TO    TOT-PL
           SET     WS-T-COT                      TO    TOT-COT
           SET     WS-T-PLN                      TO    TOT-PLN
           SET     WS-T-MAX                      TO    TOT-MAX
           SET     WS-T-YMAX                     TO    TOT-YMAX
           SET     WS-T-CLS                      TO    TOT-CLS
           SET     WS-T-SUB                      TO    TOT-SUB
]]></Event>
    <Event name="Q-CATS" paragraph="Q-CATS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-K                                   PIC    99.

       PROCEDURE DIVISION.
           *> Zero every slot first: a category with no fund in the filter must show 0, not
           *> the last filter's data.

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-CNT(WS-I)          TO    0
               SET     WS-CAT-PL(WS-I)           TO    0
               SET     WS-CAT-COT(WS-I)          TO    0
               SET     WS-CAT-USED(WS-I)         TO    0
           END-PERFORM

           *> FUND-CATS counts the filtered funds, their PL and their cotistas per nivel1
           *> (the desktop's GROUP BY nivel1); the rows are matched to the slots by NAME, as
           *> the desktop does, so a category keeps its slot under any filter.

           SET     BE-PROG                       TO    "FUND-CATS"
           INITIALIZE    CAR-RES
           CALL    "FUND-CATS" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ
               RETURNING CAR-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   INITIALIZE    CAR-RES
                   SET     CAR-STATUS            TO    "CALL"
           END-CALL
           IF    CAR-STATUS NOT = "OK"
               IF    CAR-STATUS NOT = "CALL"
                   SET     BE-STATUS             TO    CAR-STATUS
                   SET     BE-MSG                TO    CAR-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-CATS"; BE-STATUS / BE-MSG = the class and message of the
               *>         failed call (COBOL::"WS-LAST-ERROR"), or the status word and message
               *>         FUND-CATS answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-CATS: <status> <message>"; every slot stays 0.

               CALL    "BACKEND-FAIL"
           END-IF

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > CAR-N
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF    WS-CAT-NAME(WS-I) = CAR-NAME(WS-K)
                       SET     WS-CAT-CNT(WS-I)  TO    CAR-CNT(WS-K)
                       SET     WS-CAT-PL(WS-I)   TO    CAR-PL(WS-K)
                       SET     WS-CAT-COT(WS-I)  TO    CAR-COT(WS-K)
                   END-IF
               END-PERFORM
           END-PERFORM
]]></Event>
    <Event name="Q-N2" paragraph="Q-N2"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.

       PROCEDURE DIVISION.
           *> FUND-N2 counts the filtered funds per nivel2, largest first: the 9 biggest keep
           *> their own slot, the rest are summed into slot 10, 'Outros' (only when there are
           *> more than nine). N2R-TOTAL adds every row, so the donut shares add up to the whole.

           SET     BE-PROG                       TO    "FUND-N2"
           INITIALIZE    N2R-RES
           CALL    "FUND-N2" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ
               RETURNING N2R-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   INITIALIZE    N2R-RES
                   SET     N2R-STATUS            TO    "CALL"
           END-CALL
           IF    N2R-STATUS NOT = "OK"
               IF    N2R-STATUS NOT = "CALL"
                   SET     BE-STATUS             TO    N2R-STATUS
                   SET     BE-MSG                TO    N2R-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-N2"; BE-STATUS / BE-MSG = the class and message of the
               *>         failed call (COBOL::"WS-LAST-ERROR"), or the status word and message
               *>         FUND-N2 answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-N2: <status> <message>"; the slots stay empty.

               CALL    "BACKEND-FAIL"
           END-IF

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-N2-NAME(WS-I)          TO    N2R-NAME(WS-I)
               SET     WS-N2-CNT(WS-I)           TO    N2R-CNT(WS-I)
           END-PERFORM
           SET     WS-N2-TOTAL                   TO    N2R-TOTAL
]]></Event>
    <Event name="Q-BINS" paragraph="Q-BINS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.

       PROCEDURE DIVISION.
           *> Five PL bands, each ten times the last, as the captions of LBL-BIN1-N to
           *> LBL-BIN5-N say (up to R$ 1 mi ... above R$ 1 bi); FUND-BINS runs the desktop's
           *> CASE statement over the filtered funds that report a PL.

           SET     BE-PROG                       TO    "FUND-BINS"
           INITIALIZE    BIN-RES
           CALL    "FUND-BINS" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ
               RETURNING BIN-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   INITIALIZE    BIN-RES
                   SET     BIN-STATUS            TO    "CALL"
           END-CALL
           IF    BIN-STATUS NOT = "OK"
               IF    BIN-STATUS NOT = "CALL"
                   SET     BE-STATUS             TO    BIN-STATUS
                   SET     BE-MSG                TO    BIN-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-BINS"; BE-STATUS / BE-MSG = the class and message of the
               *>         failed call (COBOL::"WS-LAST-ERROR"), or the status word and message
               *>         FUND-BINS answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-BINS: <status> <message>"; the bands stay 0.

               CALL    "BACKEND-FAIL"
           END-IF

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
               SET     WS-BIN-CNT(WS-I)          TO    BIN-CNT(WS-I)
           END-PERFORM
]]></Event>
    <Event name="Q-TOP" paragraph="Q-TOP"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.

       PROCEDURE DIVISION.
           *> FUND-TOP: the four filtered funds with the largest PL, largest first. A fund
           *> with no name falls back to its code; WS-TOP-NAME keeps the first 40 bytes.

           SET     BE-PROG                       TO    "FUND-TOP"
           INITIALIZE    TOP-RES
           CALL    "FUND-TOP" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ
               RETURNING TOP-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   INITIALIZE    TOP-RES
                   SET     TOP-STATUS            TO    "CALL"
           END-CALL
           IF    TOP-STATUS NOT = "OK"
               IF    TOP-STATUS NOT = "CALL"
                   SET     BE-STATUS             TO    TOP-STATUS
                   SET     BE-MSG                TO    TOP-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-TOP"; BE-STATUS / BE-MSG = the class and message of the
               *>         failed call (COBOL::"WS-LAST-ERROR"), or the status word and message
               *>         FUND-TOP answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-TOP: <status> <message>"; the list stays empty.

               CALL    "BACKEND-FAIL"
           END-IF

           SET     WS-TOP-N                      TO    TOP-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
               SET     WS-TOP-NAME(WS-I)         TO    TOP-NAME(WS-I)
               SET     WS-TOP-PL(WS-I)           TO    TOP-PL(WS-I)
           END-PERFORM
]]></Event>
    <Event name="Q-YEARS" paragraph="Q-YEARS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-K                                   PIC    99.

       PROCEDURE DIVISION.
           *> FUND-YEARS does what the desktop's Q-YEARS does with DB-1: it takes the three
           *> categories with most funds under the filter (ties to the lower slot), the window
           *> of 12 years ending at the newest start year of the filter (2015 when there is
           *> none), the yearly counts / PL / cotistas of all categories and of the three, and
           *> the same before the window. The form copies the answer into its tables.

           SET     BE-PROG                       TO    "FUND-YEARS"
           INITIALIZE    YRS-RES
           CALL    "FUND-YEARS" WITH WEBSOCKET LINKAGE
               USING BY VALUE FLT-REQ
               RETURNING YRS-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     BE-STATUS             TO    BE-CLASS
                   INITIALIZE    YRS-RES
                   SET     YRS-STATUS            TO    "CALL"
           END-CALL
           IF    YRS-STATUS NOT = "OK"
               IF    YRS-STATUS NOT = "CALL"
                   SET     BE-STATUS             TO    YRS-STATUS
                   SET     BE-MSG                TO    YRS-MESSAGE
               END-IF

               *> BACKEND-FAIL: shows in the header line that a Backend call failed.
               *> Uses:   BE-PROG = "FUND-YEARS"; BE-STATUS / BE-MSG = the class and message of the
               *>         failed call (COBOL::"WS-LAST-ERROR"), or the status word and message
               *>         FUND-YEARS answered.
               *> Result: LBL-STATUS::Caption = "Backend FUND-YEARS: <status> <message>"; the year tables stay 0.

               CALL    "BACKEND-FAIL"
           END-IF

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               SET     WS-TOP3-IDX(WS-K)         TO    YRS-TOP3(WS-K)
           END-PERFORM
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-USED(WS-I)         TO    0
           END-PERFORM

           IF    YRS-STATUS = "OK"
               SET     WS-YR-MIN                 TO    YRS-MIN
           ELSE
               SET     WS-YR-MIN                 TO    2015
           END-IF
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
               COMPUTE    WS-YR-NUM(WS-I) = WS-YR-MIN + WS-I - 1

               SET     WS-YA-CNT(WS-I)           TO    YRS-A-CNT(WS-I)
               SET     WS-YA-PL(WS-I)            TO    YRS-A-PL(WS-I)
               SET     WS-YA-COT(WS-I)           TO    YRS-A-COT(WS-I)

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   SET     WS-YS-CNT(WS-I, WS-K) TO    YRS-S-CNT(WS-I, WS-K)
                   SET     WS-YS-PL(WS-I, WS-K)  TO    YRS-S-PL(WS-I, WS-K)
                   SET     WS-YS-COT(WS-I, WS-K) TO    YRS-S-COT(WS-I, WS-K)
               END-PERFORM
           END-PERFORM

           SET     WS-OA-CNT                     TO    YRS-OA-CNT
           SET     WS-OA-PL                      TO    YRS-OA-PL
           SET     WS-OA-COT                     TO    YRS-OA-COT

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               SET     WS-OS-CNT(WS-K)           TO    YRS-OS-CNT(WS-K)
               SET     WS-OS-PL(WS-K)            TO    YRS-OS-PL(WS-K)
               SET     WS-OS-COT(WS-K)           TO    YRS-OS-COT(WS-K)
           END-PERFORM
]]></Event>
    <Event name="Q-GRID" paragraph="Q-GRID"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-OFFS                                PIC    9(9).
       01 WS-I                                   PIC    9(5).
       01 WS-GOT                                 PIC    9(5).
       01 WS-DONE                                PIC    9.

       PROCEDURE DIVISION.
           *> The page count rounds up: the COMPUTE truncates into an integer item, so
           *> PSIZE - 1 is added first. An empty result still shows one page, and the
           *> current page is clamped into 1 to WS-PAGES.

           IF    WS-T-CNT = 0
               SET     WS-PAGES                  TO    1
           ELSE
               COMPUTE    WS-PAGES = (WS-T-CNT + WS-PSIZE - 1) / WS-PSIZE
           END-IF
           IF    WS-PAGE > WS-PAGES
               SET     WS-PAGE                   TO    WS-PAGES
           END-IF
           IF    WS-PAGE < 1
               SET     WS-PAGE                   TO    1
           END-IF
           COMPUTE    WS-OFFS = (WS-PAGE - 1) * WS-PSIZE

           *> FLT-RESTORE: puts back the filter of the last Apply.
           *> Uses:   FLS-REQ, kept by FLT-SAVE at the end of BUILD-WHERE.
           *> Result: FLT-REQ = that filter: paging and re-sorting never see a filter typed but
           *>         not applied (the desktop reuses the WS-WHERE of the last Apply).

           CALL    "FLT-RESTORE"

           *> FUND-GRID reads CMB-ORDER::Value the way the desktop did (each item is recognised
           *> by its first words; every key but the name sorts IS NULL first), selects the 16
           *> columns in the column order of GRD-FUNDOS and answers one row text per fund, its
           *> cells joined by TAB. A browser call answers at most 64 KiB, so the page of 300
           *> rows comes in calls of at most 150 rows, one after the other.

           SET     GRD-ORDER                     TO    CMB-ORDER::Value
           GRD-FUNDOS::ClearRows()
           SET     WS-GOT                        TO    0
           SET     WS-DONE                       TO    0

           PERFORM    UNTIL WS-DONE = 1 OR WS-GOT >= WS-PSIZE
               COMPUTE    GRD-OFFSET = WS-OFFS + WS-GOT
               IF    WS-PSIZE - WS-GOT > 150
                   SET     GRD-LIMIT             TO    150
               ELSE
                   COMPUTE    GRD-LIMIT = WS-PSIZE - WS-GOT
               END-IF
               SET     BE-PROG                   TO    "FUND-GRID"
               SET     GRD-STATUS                TO    SPACES
               SET     GRD-N                     TO    0
               SET     GRD-MORE                  TO    SPACES
               CALL    "FUND-GRID" WITH WEBSOCKET LINKAGE
                   USING BY VALUE FLT-REQ GRD-REQ
                   RETURNING GRD-RES
                   ON EXCEPTION
                       COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                       SET     BE-STATUS         TO    BE-CLASS
                       SET     GRD-STATUS        TO    SPACES
                       SET     GRD-N             TO    0
                       SET     GRD-MORE          TO    SPACES
                       SET     GRD-STATUS        TO    "CALL"
               END-CALL
               IF    GRD-STATUS NOT = "OK" AND GRD-STATUS NOT = "TRUNC"
                   IF    GRD-STATUS NOT = "CALL"
                       SET     BE-STATUS         TO    GRD-STATUS
                       SET     BE-MSG            TO    GRD-MESSAGE
                   END-IF

                   *> BACKEND-FAIL: shows in the header line that a Backend call failed.
                   *> Uses:   BE-PROG = "FUND-GRID"; BE-STATUS / BE-MSG = the class and message
                   *>         of the failed call (COBOL::"WS-LAST-ERROR"), or the status word and
                   *>         message FUND-GRID answered.
                   *> Result: LBL-STATUS::Caption = "Backend FUND-GRID: <status> <message>"; the
                   *>         grid keeps the rows already added to this page.

                   CALL    "BACKEND-FAIL"
                   SET     WS-DONE               TO    1
               END-IF
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > GRD-N
                   GRD-FUNDOS::AddRow(GRD-ROW(WS-I)::Trim())
               END-PERFORM
               ADD    GRD-N TO WS-GOT

               *> Fewer rows than asked: the end of the result, unless GRD-MORE says the answer
               *> only reached its byte budget (then the next call starts after them).

               IF    GRD-N = 0 OR (GRD-N < GRD-LIMIT AND GRD-MORE NOT = "Y")
                   SET     WS-DONE               TO    1
               END-IF
           END-PERFORM
]]></Event>
    <Event name="SORT-CATS" paragraph="SORT-CATS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-K                                   PIC    99.
       01 WS-BI                                  PIC    99.
       01 WS-BEST                                PIC    9(15)V99.

       PROCEDURE DIVISION.
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-USED(WS-I)         TO    0
               SET     WS-RANK(WS-I)             TO    0
           END-PERFORM
           *> Selection sort by PL: WS-RANK(k) gets the slot of the k-th largest
           *> category, 0 when none is left. The test is strictly above 0, so a
           *> category with no PL is never ranked. The USED marks are cleared after.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 10
               SET     WS-BI                     TO    0
               SET     WS-BEST                   TO    0

               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF    WS-CAT-PL(WS-I) > WS-BEST AND WS-CAT-USED(WS-I) = 0
                       SET     WS-BEST           TO    WS-CAT-PL(WS-I)
                       SET     WS-BI             TO    WS-I
                   END-IF
               END-PERFORM
               IF    WS-BI > 0
                   SET     WS-RANK(WS-K)         TO    WS-BI
                   SET     WS-CAT-USED(WS-BI)    TO    1
               END-IF
           END-PERFORM
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-USED(WS-I)         TO    0
           END-PERFORM
]]></Event>
    <Event name="PAINT-KPIS" paragraph="PAINT-KPIS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-PCT                                 PIC    9(3)V9.
       01 WS-AVG                                 PIC    9(15)V99.
       01 WS-PCTI                                PIC    9(3).
       01 WS-A                                   PIC    X(24).

       PROCEDURE DIVISION.
           SET     WS-FV                         TO    WS-T-PL

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-T-PL, set just above: the total PL (R$) of the funds that pass the
           *>         filters.
           *> Result: WS-FT = that total in short form; "R$ " + WS-FT goes into LBL-KPI-V::Caption
           *>         on the next lines.

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT

           SET     LBL-KPI-V::Caption            TO    WS-TXT
           SET     WS-FC                         TO    WS-T-CNT

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-T-CNT, set just above: the number of funds that pass the filters.
           *> Result: WS-FT = that count with points between thousands; WS-A keeps it on the next
           *>         line because the next FMT call overwrites WS-FT.

           CALL    "FMT-COUNT"

           *> WS-FT is reused by every FMT-* call, so the fund count text waits in
           *> WS-A while the cotistas are formatted.

           SET     WS-A                          TO    WS-FT
           SET     WS-FV                         TO    WS-T-COT

           *> FMT-SHORTN: formats a count in short form: under 1000 it is a whole number, from 1000
           *> on it is like FMT-SHORT.
           *> Uses:   WS-FV = WS-T-COT, set just above: the total of cotistas of the filtered funds.
           *> Result: WS-FT = the total as a whole number below 1000, otherwise in short form (12300
           *>         becomes 12,30 mil); it goes with WS-A (the fund count) into
           *>         LBL-KPI-C::Caption.

           CALL    "FMT-SHORTN"
           SET     WS-TXT                        TO    SPACES
           STRING    FUNCTION TRIM(WS-A) " fundo(s)  |  " WS-FT::Trim() " cotistas" INTO WS-TXT
           SET     LBL-KPI-C::Caption            TO    WS-TXT
           IF    WS-UNIV > 0
               COMPUTE    WS-PCT = WS-T-CNT * 100 / WS-UNIV
           ELSE
               SET     WS-PCT                    TO    0
           END-IF
           COMPUTE    WS-PCTI = WS-PCT
           GAU-UNIV::SetValue(WS-PCTI)
           *> Average over the funds that report a PL (WS-T-PLN, from COUNT(pl)),
           *> not over all of them.

           IF    WS-T-PLN > 0
               COMPUTE    WS-AVG = WS-T-PL / WS-T-PLN
           ELSE
               SET     WS-AVG                    TO    0
           END-IF
           SET     WS-FV                         TO    WS-AVG

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-AVG, set just above: WS-T-PL / WS-T-PLN, the average PL of the
           *>         funds that report a PL (0 when none does).
           *> Result: WS-FT = that average in short form; "R$ " + WS-FT goes into
           *>         LBL-AVG-V::Caption.

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT

           SET     LBL-AVG-V::Caption            TO    WS-TXT
           SET     WS-FV                         TO    WS-T-MAX

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-T-MAX, set just above: the largest PL among the filtered funds.
           *> Result: WS-FT = that PL in short form; it ends the text "PL médio por fundo  |  maior:
           *>         R$ ..." placed in LBL-KPI-F::Caption.

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "PL médio por fundo  |  maior: R$ " WS-FT::Trim() INTO WS-TXT
           SET     LBL-KPI-F::Caption            TO    WS-TXT
]]></Event>
    <Event name="PAINT-RADAR" paragraph="PAINT-RADAR"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-J                                   PIC    99.
       01 WS-K                                   PIC    9.
       01 WS-NM                                  PIC    9.
       01 WS-NSEL                                PIC    9(9).
       01 WS-MX                                  PIC    9(15)V99.
       01 WS-MC                                  PIC    9(15)V99.
       01 WS-MP                                  PIC    9(15)V99.
       01 WS-MK                                  PIC    9(15)V99.
       01 WS-V1                                  PIC    9(3)V99.
       01 WS-V2                                  PIC    9(3)V99.
       01 WS-V3                                  PIC    9(3)V99.
       01 WS-RV-TAB.
           05 WS-RVK                             OCCURS    3.
               10 WS-RV                          PIC    9(9)    OCCURS 10.
       01 WS-RN-TAB.
           05 WS-RN                              PIC    X(164)    OCCURS 3.
       01 WS-C1                                  PIC    X(160).
       01 WS-C2                                  PIC    X(60).
       01 WS-C3                                  PIC    X(30).
       01 WS-W1                                  PIC    X(60).
       01 WS-W2                                  PIC    X(60).
       01 WS-LB                                  PIC    X(200).
       01 WS-LP                                  PIC    9(4).

       PROCEDURE DIVISION.
           SET     WS-NSEL                       TO    0
           IF    WS-ALL-N = 0
               SET     WS-NSEL                   TO    PK-N-N
           END-IF
           CH-RADAR::Clear()
           IF    WS-NSEL = 2 OR WS-NSEL = 3
               *>      --- one polygon per company

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   SET     WS-RN(WS-K)           TO    SPACES
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
                       SET     WS-RV(WS-K, WS-I) TO    0
                   END-PERFORM
               END-PERFORM

               *> FUND-RADAR answers what the desktop asks DB-1 here: the picked names in name
               *> order (the first three, RAD-NAME) and the funds of each of them per category
               *> slot under the whole filter (RAD-CNT, slots in the order of WS-CAT-NAME).

               SET     WS-NM                     TO    0
               SET     BE-PROG                   TO    "FUND-RADAR"
               INITIALIZE    RAD-RES
               CALL    "FUND-RADAR" WITH WEBSOCKET LINKAGE
                   USING BY VALUE FLT-REQ
                   RETURNING RAD-RES
                   ON EXCEPTION
                       COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                       SET     BE-STATUS         TO    BE-CLASS
                       INITIALIZE    RAD-RES
                       SET     RAD-STATUS        TO    "CALL"
               END-CALL
               IF    RAD-STATUS NOT = "OK"
                   IF    RAD-STATUS NOT = "CALL"
                       SET     BE-STATUS         TO    RAD-STATUS
                       SET     BE-MSG            TO    RAD-MESSAGE
                   END-IF

                   *> BACKEND-FAIL: shows in the header line that a Backend call failed.
                   *> Uses:   BE-PROG = "FUND-RADAR"; BE-STATUS / BE-MSG = the class and message
                   *>         of the failed call (COBOL::"WS-LAST-ERROR"), or the status word and
                   *>         message FUND-RADAR answered.
                   *> Result: LBL-STATUS::Caption = "Backend FUND-RADAR: <status> <message>"; the
                   *>         polygons below are drawn from zeros.

                   CALL    "BACKEND-FAIL"
               END-IF
               SET     WS-NM                     TO    RAD-NM
               IF    WS-NM > 3
                   SET     WS-NM                 TO    3
               END-IF
               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                   SET     WS-RN(WS-K)           TO    RAD-NAME(WS-K)
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       SET     WS-RV(WS-K, WS-I) TO    RAD-CNT(WS-K, WS-I)
                   END-PERFORM
               END-PERFORM
               *> Common scale for the polygons: the largest count of any company in any
               *> category is 100, so the shapes stay comparable.

               SET     WS-MX                     TO    0
               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF    WS-RV(WS-K, WS-I) > WS-MX
                           SET     WS-MX         TO    WS-RV(WS-K, WS-I)
                       END-IF
                   END-PERFORM
               END-PERFORM
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   SET     WS-V1                 TO    0
                   SET     WS-V2                 TO    0
                   SET     WS-V3                 TO    0

                   IF    WS-MX > 0
                       COMPUTE    WS-V1 = WS-RV(1, WS-I) * 100 / WS-MX
                       COMPUTE    WS-V2 = WS-RV(2, WS-I) * 100 / WS-MX

                       IF    WS-NM = 3
                           COMPUTE    WS-V3 = WS-RV(3, WS-I) * 100 / WS-MX
                       END-IF
                   END-IF
                   IF    WS-NM = 3
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1, WS-V2, WS-V3)
                   ELSE
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1, WS-V2)
                   END-IF
               END-PERFORM
               *>      the legend: the first two words of each name

               SET     WS-LB                     TO    SPACES
               SET     WS-LP                     TO    1

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                   SET     WS-W1                 TO    SPACES
                   SET     WS-W2                 TO    SPACES

                   UNSTRING    WS-RN(WS-K) DELIMITED BY SPACE INTO WS-W1 WS-W2

                   *> SeriesLabels is comma-separated, so a comma inside a company name would
                   *> split its label: turn commas into spaces.

                   INSPECT    WS-W1 REPLACING ALL "," BY " "
                   INSPECT    WS-W2 REPLACING ALL "," BY " "

                   IF    WS-K > 1
                       STRING    "," INTO WS-LB WITH POINTER WS-LP
                   END-IF
                   STRING    FUNCTION TRIM(WS-W1) " " FUNCTION TRIM(WS-W2) INTO WS-LB WITH POINTER WS-LP
               END-PERFORM
               SET     CH-RADAR::SeriesLabels    TO    WS-LB
               IF    WS-NM = 3
                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6,#C2257A,#394670"
               ELSE
                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6,#C2257A"
               END-IF

               SET     CH-RADAR::ShowLegend      TO    1
               SET     LBL-RAD-S::Caption        TO    "nº de fundos por categoria (100 = maior)"
           ELSE
               IF    WS-NSEL = 1
                   *>          --- ONE company: its three series, each indexed to its own largest category

                   SET     WS-MC                 TO    0
                   SET     WS-MP                 TO    0
                   SET     WS-MK                 TO    0

                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF    WS-CAT-CNT(WS-I) > WS-MC
                           SET     WS-MC         TO    WS-CAT-CNT(WS-I)
                       END-IF
                       IF    WS-CAT-PL(WS-I) > WS-MP
                           SET     WS-MP         TO    WS-CAT-PL(WS-I)
                       END-IF
                       IF    WS-CAT-COT(WS-I) > WS-MK
                           SET     WS-MK         TO    WS-CAT-COT(WS-I)
                       END-IF
                   END-PERFORM
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       SET     WS-V1             TO    0
                       SET     WS-V2             TO    0
                       SET     WS-V3             TO    0

                       IF    WS-MC > 0
                           COMPUTE    WS-V1 = WS-CAT-CNT(WS-I) * 100 / WS-MC
                       END-IF
                       IF    WS-MP > 0
                           COMPUTE    WS-V2 = WS-CAT-PL(WS-I) * 100 / WS-MP
                       END-IF
                       IF    WS-MK > 0
                           COMPUTE    WS-V3 = WS-CAT-COT(WS-I) * 100 / WS-MK
                       END-IF
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1, WS-V2, WS-V3)
                   END-PERFORM
                   SET     CH-RADAR::SeriesLabels
                                                 TO    "Fundos,PL,Cotistas"

                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6,#3E7BE8,#394670"

                   SET     CH-RADAR::ShowLegend  TO    1
                   SET     LBL-RAD-S::Caption    TO    "1 empresa: fundos, PL e cotistas (100 = maior)"
               ELSE
                   *>          --- everyone (or more than three picked): ONE polygon, one colour, the most popular categories

                   SET     WS-MC                 TO    0
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF    WS-CAT-CNT(WS-I) > WS-MC
                           SET     WS-MC         TO    WS-CAT-CNT(WS-I)
                       END-IF
                   END-PERFORM
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       SET     WS-V1             TO    0
                       IF    WS-MC > 0
                           COMPUTE    WS-V1 = WS-CAT-CNT(WS-I) * 100 / WS-MC
                       END-IF
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1)
                   END-PERFORM
                   SET     CH-RADAR::SeriesLabels
                                                 TO    "Fundos"

                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6"

                   SET     CH-RADAR::ShowLegend  TO    0
                   SET     LBL-RAD-S::Caption    TO    "categorias mais populares · nº de fundos (100 = líder)"
               END-IF
           END-IF
]]></Event>
    <Event name="PAINT-CHARTS" paragraph="PAINT-CHARTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-R                                   PIC    99.
       01 WS-SC                                  PIC    9(15)V99.
       01 WS-SP                                  PIC    9(15)V99.
       01 WS-SK                                  PIC    9(15)V99.
       01 WS-MC                                  PIC    9(15)V99.
       01 WS-MP                                  PIC    9(15)V99.
       01 WS-MK                                  PIC    9(15)V99.
       01 WS-V1                                  PIC    9(3)V99.
       01 WS-V2                                  PIC    9(3)V99.
       01 WS-V3                                  PIC    9(3)V99.
       01 WS-VB                                  PIC    9(9)V99.
       01 WS-TXT                                 PIC    X(120).
       01 WS-LB                                  PIC    X(12).

       PROCEDURE DIVISION.
           SET     WS-SC                         TO    0
           SET     WS-SP                         TO    0
           SET     WS-SK                         TO    0

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
               ADD    WS-CAT-CNT(WS-I) TO WS-SC
               ADD    WS-CAT-PL(WS-I) TO WS-SP
               ADD    WS-CAT-COT(WS-I) TO WS-SK
           END-PERFORM

           *> PAINT-RADAR: redraws the radar chart CH-RADAR and its subtitle for the companies
           *> picked in the Nome filter.
           *> Uses:   the number of names kept, PK-N-N (0 in Todos mode); WS-CATCNT and
           *>         WS-CAT-NAME(1..WS-CATCNT) from LOAD-DIMS; WS-CAT-CNT / WS-CAT-PL / WS-CAT-COT
           *>         from Q-CATS; for 2 or 3 picked companies, also FUND-RADAR with FLT-REQ.
           *> Result: CH-RADAR cleared and given one point per category: one polygon per company for
           *>         2-3 picks (100 = the largest count of any of them), three series (Fundos, PL,
           *>         Cotistas, each 100 = its largest category) for 1 pick, otherwise one polygon
           *>         of fund counts. Also CH-RADAR::SeriesLabels, SeriesColors, ShowLegend and
           *>         LBL-RAD-S::Caption.

           CALL    "PAINT-RADAR"
           *>  donut 1: PL (R$ billions) per category

           CH-DONUT1::Clear()
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
               COMPUTE    WS-VB = WS-CAT-PL(WS-I) / 1000000000
               CH-DONUT1::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-VB)
           END-PERFORM
           SET     WS-FV                         TO    WS-SP

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-SP, set just above: the sum of WS-CAT-PL over the categories listed
           *>         (the donut total; not WS-T-PL, as only those categories count).
           *> Result: WS-FT = that total in short form; it becomes LBL-D1-C::Caption, the centre of
           *>         donut 1.

           CALL    "FMT-SHORT"
           SET     LBL-D1-C::Caption             TO    WS-FT
           *> Legend rows run largest PL first (WS-RANK holds slot numbers). A swatch
           *> takes the WS-COLOR of the slot, the colour of that slice in the donut,
           *> whose points are added in slot order. An unused row is blanked.

           IF    WS-RANK(1) > 0
               SET     WS-R                      TO    WS-RANK(1)
               SET     LBL-L1-1-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP (0 when WS-SP = 0; no ROUNDED, so
               *>         truncated to one decimal), set just above: the share of the 1st category
               *>         by PL (WS-R = WS-RANK(1)) in WS-SP, the summed PL of the listed categories
               *>         (not WS-T-PL).
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L1-1-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L1-1-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-CAT-PL(WS-R), set just above: the PL of that same 1st category
               *>         by PL.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-L1-1-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-1-V::Caption       TO    WS-TXT
               SET     SHP-L1-1::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-1-N::Caption       TO    SPACES
               SET     LBL-L1-1-P::Caption       TO    SPACES
               SET     LBL-L1-1-V::Caption       TO    SPACES
               SET     SHP-L1-1::FillColor       TO    "#00000000"
           END-IF
           IF    WS-RANK(2) > 0
               SET     WS-R                      TO    WS-RANK(2)
               SET     LBL-L1-2-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP (0 when WS-SP = 0; no ROUNDED, so
               *>         truncated to one decimal), set just above: the share of the 2nd category
               *>         by PL (WS-R = WS-RANK(2)) in WS-SP, the summed PL of the listed categories
               *>         (not WS-T-PL).
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L1-2-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L1-2-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-CAT-PL(WS-R), set just above: the PL of that same 2nd category
               *>         by PL.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-L1-2-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-2-V::Caption       TO    WS-TXT
               SET     SHP-L1-2::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-2-N::Caption       TO    SPACES
               SET     LBL-L1-2-P::Caption       TO    SPACES
               SET     LBL-L1-2-V::Caption       TO    SPACES
               SET     SHP-L1-2::FillColor       TO    "#00000000"
           END-IF
           IF    WS-RANK(3) > 0
               SET     WS-R                      TO    WS-RANK(3)
               SET     LBL-L1-3-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP (0 when WS-SP = 0; no ROUNDED, so
               *>         truncated to one decimal), set just above: the share of the 3rd category
               *>         by PL (WS-R = WS-RANK(3)) in WS-SP, the summed PL of the listed categories
               *>         (not WS-T-PL).
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L1-3-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L1-3-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-CAT-PL(WS-R), set just above: the PL of that same 3rd category
               *>         by PL.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-L1-3-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-3-V::Caption       TO    WS-TXT
               SET     SHP-L1-3::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-3-N::Caption       TO    SPACES
               SET     LBL-L1-3-P::Caption       TO    SPACES
               SET     LBL-L1-3-V::Caption       TO    SPACES
               SET     SHP-L1-3::FillColor       TO    "#00000000"
           END-IF
           IF    WS-RANK(4) > 0
               SET     WS-R                      TO    WS-RANK(4)
               SET     LBL-L1-4-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP (0 when WS-SP = 0; no ROUNDED, so
               *>         truncated to one decimal), set just above: the share of the 4th category
               *>         by PL (WS-R = WS-RANK(4)) in WS-SP, the summed PL of the listed categories
               *>         (not WS-T-PL).
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L1-4-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L1-4-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-CAT-PL(WS-R), set just above: the PL of that same 4th category
               *>         by PL.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-L1-4-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-4-V::Caption       TO    WS-TXT
               SET     SHP-L1-4::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-4-N::Caption       TO    SPACES
               SET     LBL-L1-4-P::Caption       TO    SPACES
               SET     LBL-L1-4-V::Caption       TO    SPACES
               SET     SHP-L1-4::FillColor       TO    "#00000000"
           END-IF
           *>  donut 2: funds per level-2 category (top 9 + the rest)

           CH-DONUT2::Clear()
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               IF    WS-N2-NAME(WS-I) NOT = SPACES
                   CH-DONUT2::AddPoint(WS-N2-NAME(WS-I)::Trim(), WS-N2-CNT(WS-I))
               END-IF
           END-PERFORM
           SET     WS-FC                         TO    WS-N2-TOTAL

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-N2-TOTAL, set just above: the number of funds counted in the
           *>         level-2 categories.
           *> Result: WS-FT = that count with points between thousands; it becomes
           *>         LBL-D2-C::Caption, the centre of donut 2.

           CALL    "FMT-COUNT"
           SET     LBL-D2-C::Caption             TO    WS-FT
           IF    WS-N2-NAME(1) NOT = SPACES
               SET     LBL-L2-1-N::Caption       TO    WS-N2-NAME(1)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(1) * 100 / WS-N2-TOTAL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-N2-CNT(1) * 100 / WS-N2-TOTAL (0 when WS-N2-TOTAL = 0;
               *>         truncated to one decimal), set just above: the share of the level-2
               *>         category in WS-N2-NAME(1) among all funds counted in WS-N2-TOTAL.
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L2-1-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L2-1-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(1)

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = WS-N2-CNT(1), set just above: the number of funds of that same
               *>         category.
               *> Result: WS-FT = that count with points between thousands; it goes into
               *>         LBL-L2-1-V::Caption.

               CALL    "FMT-COUNT"

               SET     LBL-L2-1-V::Caption       TO    WS-FT
               SET     SHP-L2-1::FillColor       TO    WS-COLOR(1)
           ELSE
               SET     LBL-L2-1-N::Caption       TO    SPACES
               SET     LBL-L2-1-P::Caption       TO    SPACES
               SET     LBL-L2-1-V::Caption       TO    SPACES
               SET     SHP-L2-1::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(2) NOT = SPACES
               SET     LBL-L2-2-N::Caption       TO    WS-N2-NAME(2)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(2) * 100 / WS-N2-TOTAL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-N2-CNT(2) * 100 / WS-N2-TOTAL (0 when WS-N2-TOTAL = 0;
               *>         truncated to one decimal), set just above: the share of the level-2
               *>         category in WS-N2-NAME(2) among all funds counted in WS-N2-TOTAL.
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L2-2-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L2-2-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(2)

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = WS-N2-CNT(2), set just above: the number of funds of that same
               *>         category.
               *> Result: WS-FT = that count with points between thousands; it goes into
               *>         LBL-L2-2-V::Caption.

               CALL    "FMT-COUNT"

               SET     LBL-L2-2-V::Caption       TO    WS-FT
               SET     SHP-L2-2::FillColor       TO    WS-COLOR(2)
           ELSE
               SET     LBL-L2-2-N::Caption       TO    SPACES
               SET     LBL-L2-2-P::Caption       TO    SPACES
               SET     LBL-L2-2-V::Caption       TO    SPACES
               SET     SHP-L2-2::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(3) NOT = SPACES
               SET     LBL-L2-3-N::Caption       TO    WS-N2-NAME(3)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(3) * 100 / WS-N2-TOTAL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-N2-CNT(3) * 100 / WS-N2-TOTAL (0 when WS-N2-TOTAL = 0;
               *>         truncated to one decimal), set just above: the share of the level-2
               *>         category in WS-N2-NAME(3) among all funds counted in WS-N2-TOTAL.
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L2-3-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L2-3-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(3)

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = WS-N2-CNT(3), set just above: the number of funds of that same
               *>         category.
               *> Result: WS-FT = that count with points between thousands; it goes into
               *>         LBL-L2-3-V::Caption.

               CALL    "FMT-COUNT"

               SET     LBL-L2-3-V::Caption       TO    WS-FT
               SET     SHP-L2-3::FillColor       TO    WS-COLOR(3)
           ELSE
               SET     LBL-L2-3-N::Caption       TO    SPACES
               SET     LBL-L2-3-P::Caption       TO    SPACES
               SET     LBL-L2-3-V::Caption       TO    SPACES
               SET     SHP-L2-3::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(4) NOT = SPACES
               SET     LBL-L2-4-N::Caption       TO    WS-N2-NAME(4)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(4) * 100 / WS-N2-TOTAL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-N2-CNT(4) * 100 / WS-N2-TOTAL (0 when WS-N2-TOTAL = 0;
               *>         truncated to one decimal), set just above: the share of the level-2
               *>         category in WS-N2-NAME(4) among all funds counted in WS-N2-TOTAL.
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L2-4-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L2-4-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(4)

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = WS-N2-CNT(4), set just above: the number of funds of that same
               *>         category.
               *> Result: WS-FT = that count with points between thousands; it goes into
               *>         LBL-L2-4-V::Caption.

               CALL    "FMT-COUNT"

               SET     LBL-L2-4-V::Caption       TO    WS-FT
               SET     SHP-L2-4::FillColor       TO    WS-COLOR(4)
           ELSE
               SET     LBL-L2-4-N::Caption       TO    SPACES
               SET     LBL-L2-4-P::Caption       TO    SPACES
               SET     LBL-L2-4-V::Caption       TO    SPACES
               SET     SHP-L2-4::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(5) NOT = SPACES
               SET     LBL-L2-5-N::Caption       TO    WS-N2-NAME(5)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(5) * 100 / WS-N2-TOTAL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-N2-CNT(5) * 100 / WS-N2-TOTAL (0 when WS-N2-TOTAL = 0;
               *>         truncated to one decimal), set just above: the share of the level-2
               *>         category in WS-N2-NAME(5) among all funds counted in WS-N2-TOTAL.
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L2-5-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L2-5-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(5)

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = WS-N2-CNT(5), set just above: the number of funds of that same
               *>         category.
               *> Result: WS-FT = that count with points between thousands; it goes into
               *>         LBL-L2-5-V::Caption.

               CALL    "FMT-COUNT"

               SET     LBL-L2-5-V::Caption       TO    WS-FT
               SET     SHP-L2-5::FillColor       TO    WS-COLOR(5)
           ELSE
               SET     LBL-L2-5-N::Caption       TO    SPACES
               SET     LBL-L2-5-P::Caption       TO    SPACES
               SET     LBL-L2-5-V::Caption       TO    SPACES
               SET     SHP-L2-5::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(6) NOT = SPACES
               SET     LBL-L2-6-N::Caption       TO    WS-N2-NAME(6)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(6) * 100 / WS-N2-TOTAL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-N2-CNT(6) * 100 / WS-N2-TOTAL (0 when WS-N2-TOTAL = 0;
               *>         truncated to one decimal), set just above: the share of the level-2
               *>         category in WS-N2-NAME(6) among all funds counted in WS-N2-TOTAL.
               *> Result: WS-FT = that percentage text; the next line puts it in
               *>         LBL-L2-6-P::Caption.

               CALL    "FMT-PCT"

               SET     LBL-L2-6-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(6)

               *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
               *> becomes 1.234).
               *> Uses:   WS-FC = WS-N2-CNT(6), set just above: the number of funds of that same
               *>         category.
               *> Result: WS-FT = that count with points between thousands; it goes into
               *>         LBL-L2-6-V::Caption.

               CALL    "FMT-COUNT"

               SET     LBL-L2-6-V::Caption       TO    WS-FT
               SET     SHP-L2-6::FillColor       TO    WS-COLOR(6)
           ELSE
               SET     LBL-L2-6-N::Caption       TO    SPACES
               SET     LBL-L2-6-P::Caption       TO    SPACES
               SET     LBL-L2-6-V::Caption       TO    SPACES
               SET     SHP-L2-6::FillColor       TO    "#00000000"
           END-IF

           *> PAINT-BINS: fills the five PL-band rows: a text and a progress bar for each band.
           *> Uses:   WS-BIN-CNT(1..5) from Q-BINS: the number of funds in each PL band, from "Até
           *>         R$ 1 mi" to "Acima de R$ 1 bi".
           *> Result: LBL-BIN1-V to LBL-BIN5-V::Caption = "count  (share%)" of each band, the share
           *>         being of the five bands together; PRG-BIN1 to PRG-BIN5 = the band's count as a
           *>         whole-number percent of the largest band.

           CALL    "PAINT-BINS"
]]></Event>
    <Event name="PAINT-YEARS" paragraph="PAINT-YEARS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-K                                   PIC    99.
       01 WS-LP                                  PIC    9(4).
       01 WS-CP                                  PIC    9(4).
       01 WS-SL                                  PIC    X(200).
       01 WS-SC                                  PIC    X(80).
       01 WS-DIV                                 PIC    9(10).
       01 WS-LBL                                 PIC    9(4).
       01 WS-RAW                                 PIC    9(15)V99    OCCURS 3.
       01 WS-RUN                                 PIC    9(15)V99    OCCURS 3.
       01 WS-BV                                  PIC    9(9)V99    OCCURS 3.
       01 WS-LV                                  PIC    9(9)V99    OCCURS 3.
       01 WS-SPK                                 PIC    9(15)V99.
       01 WS-SPV                                 PIC    9(9)V99.
       01 WS-TXT                                 PIC    X(80).
       01 WS-Y1                                  PIC    9(4).
       01 WS-Y2                                  PIC    9(4).

       PROCEDURE DIVISION.
           SET     WS-SL                         TO    SPACES
           SET     WS-SC                         TO    SPACES
           SET     WS-LP                         TO    1
           SET     WS-CP                         TO    1

           *> Series are the 3 leading categories, each in the colour of its slot as
           *> in the donuts. A missing one stays as '-' in neutral grey, so the
           *> series positions never shift.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               IF    WS-K > 1
                   STRING    "," INTO WS-SL WITH POINTER WS-LP
                   STRING    "," INTO WS-SC WITH POINTER WS-CP
               END-IF
               IF    WS-TOP3-IDX(WS-K) > 0
                   STRING    WS-CAT-NAME(WS-TOP3-IDX(WS-K))::Trim() INTO WS-SL WITH POINTER WS-LP
                   STRING    WS-COLOR(WS-TOP3-IDX(WS-K)) DELIMITED BY SIZE INTO WS-SC WITH POINTER WS-CP
               ELSE
                   STRING    "-" INTO WS-SL WITH POINTER WS-LP
                   STRING    "#C9D3E6" INTO WS-SC WITH POINTER WS-CP
               END-IF
           END-PERFORM

           SET     WS-TXT                        TO    SPACES
           SET     WS-Y1                         TO    WS-YR-MIN
           SET     WS-Y2                         TO    WS-YR-NUM(12)

           STRING    "Ano de início: " WS-Y1 " a " WS-Y2 DELIMITED BY SIZE INTO WS-TXT

           SET     CH-BAR::XAxisLabel            TO    WS-TXT
           SET     CH-LINE::XAxisLabel           TO    WS-TXT
           SET     CH-BAR::SeriesLabels          TO    WS-SL
           SET     CH-BAR::SeriesColors          TO    WS-SC
           SET     CH-LINE::SeriesLabels         TO    WS-SL
           SET     CH-LINE::SeriesColors         TO    WS-SC

           *> Divisor that puts each metric in the unit named by the LBL-BAR-U and
           *> LBL-LIN-U captions below: funds as they are, PL in R$ billions,
           *> cotistas in thousands.

           EVALUATE    WS-METRIC
               WHEN 1
                   SET     WS-DIV                TO    1
               WHEN 2
                   SET     WS-DIV                TO    1000000000
               WHEN OTHER
                   SET     WS-DIV                TO    1000
           END-EVALUATE
           *> The cumulative line must start from what exists before the window:
           *> WS-RUN is seeded with WS-OS-*, each leading category's funds that
           *> began earlier, and every year then adds on top.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               EVALUATE    WS-METRIC
                   WHEN 1
                       SET     WS-RUN(WS-K)      TO    WS-OS-CNT(WS-K)
                   WHEN 2
                       SET     WS-RUN(WS-K)      TO    WS-OS-PL(WS-K)
                   WHEN OTHER
                       SET     WS-RUN(WS-K)      TO    WS-OS-COT(WS-K)
               END-EVALUATE
           END-PERFORM
           SET     WS-SPK                        TO    WS-OA-PL

           CH-BAR::Clear()
           CH-LINE::Clear()
           SPK::Clear()

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   EVALUATE    WS-METRIC
                       WHEN 1
                           SET     WS-RAW(WS-K)  TO    WS-YS-CNT(WS-I, WS-K)
                       WHEN 2
                           SET     WS-RAW(WS-K)  TO    WS-YS-PL(WS-I, WS-K)
                       WHEN OTHER
                           SET     WS-RAW(WS-K)  TO    WS-YS-COT(WS-I, WS-K)
                   END-EVALUATE
                   ADD    WS-RAW(WS-K) TO WS-RUN(WS-K)
                   COMPUTE    WS-BV(WS-K) = WS-RAW(WS-K) / WS-DIV
                   IF    WS-ACUM = 1
                       COMPUTE    WS-LV(WS-K) = WS-RUN(WS-K) / WS-DIV
                   ELSE
                       SET     WS-LV(WS-K)       TO    WS-BV(WS-K)
                   END-IF
               END-PERFORM
               SET     WS-LBL                    TO    WS-YR-NUM(WS-I)

               CH-BAR::AddPoint(WS-LBL, WS-BV(1), WS-BV(2), WS-BV(3))
               CH-LINE::AddPoint(WS-LBL, WS-LV(1), WS-LV(2), WS-LV(3))

               ADD    WS-YA-PL(WS-I) TO WS-SPK
               COMPUTE    WS-SPV = WS-SPK / 1000000000
               SPK::AddPoint(WS-LBL, WS-SPV)
           END-PERFORM
           EVALUATE    WS-METRIC
               WHEN 1
                   SET     LBL-BAR-U::Caption    TO    "quantidade de fundos"
                   SET     LBL-LIN-U::Caption    TO    "quantidade de fundos"
                   SET     WS-FC                 TO    WS-T-CNT

                   *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234
                   *> becomes 1.234).
                   *> Uses:   WS-FC = WS-T-CNT, set just above. Caller's branch (not read here):
                   *>         WHEN 1, the metric is the number of funds.
                   *> Result: WS-FT = the number of filtered funds with points between thousands; it
                   *>         becomes LBL-BAR-TOT::Caption.

                   CALL    "FMT-COUNT"
                   SET     LBL-BAR-TOT::Caption  TO    WS-FT
               WHEN 2
                   SET     LBL-BAR-U::Caption    TO    "PL em R$ bilhões"
                   SET     LBL-LIN-U::Caption    TO    "PL em R$ bilhões"
                   SET     WS-FV                 TO    WS-T-PL

                   *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled
                   *> and given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain
                   *> number (15.5 becomes 15,50).
                   *> Uses:   WS-FV = WS-T-PL, set just above. Caller's branch (not read here): WHEN
                   *>         2, the metric is PL.
                   *> Result: WS-FT = the total PL in short form; "R$ " + WS-FT becomes
                   *>         LBL-BAR-TOT::Caption.

                   CALL    "FMT-SHORT"
                   SET     WS-TXT                TO    SPACES
                   STRING    "R$ " WS-FT::Trim() INTO WS-TXT
                   SET     LBL-BAR-TOT::Caption  TO    WS-TXT
               WHEN OTHER
                   SET     LBL-BAR-U::Caption    TO    "milhares de cotistas"
                   SET     LBL-LIN-U::Caption    TO    "milhares de cotistas"
                   SET     WS-FV                 TO    WS-T-COT

                   *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled
                   *> and given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain
                   *> number (15.5 becomes 15,50).
                   *> Uses:   WS-FV = WS-T-COT, set just above. Caller's branch (not read here):
                   *>         WHEN OTHER, the metric is cotistas.
                   *> Result: WS-FT = the total of cotistas in short form; it becomes
                   *>         LBL-BAR-TOT::Caption (no "R$ ").

                   CALL    "FMT-SHORT"
                   SET     LBL-BAR-TOT::Caption  TO    WS-FT
           END-EVALUATE
]]></Event>
    <Event name="PAINT-TABS" paragraph="PAINT-TABS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     BTN-M1::BackgroundColor       TO    "#FFFFFF"
           SET     BTN-M2::BackgroundColor       TO    "#FFFFFF"
           SET     BTN-M3::BackgroundColor       TO    "#FFFFFF"
           SET     BTN-M1::ForegroundColor       TO    "#1B2A4E"
           SET     BTN-M2::ForegroundColor       TO    "#1B2A4E"
           SET     BTN-M3::ForegroundColor       TO    "#1B2A4E"

           EVALUATE    WS-METRIC
               WHEN 1
                   SET     BTN-M1::BackgroundColor
                                                 TO    "#3E7BE8"

                   SET     BTN-M1::ForegroundColor
                                                 TO    "#FFFFFF"
               WHEN 2
                   SET     BTN-M2::BackgroundColor
                                                 TO    "#3E7BE8"

                   SET     BTN-M2::ForegroundColor
                                                 TO    "#FFFFFF"
               WHEN OTHER
                   SET     BTN-M3::BackgroundColor
                                                 TO    "#3E7BE8"

                   SET     BTN-M3::ForegroundColor
                                                 TO    "#FFFFFF"
           END-EVALUATE
]]></Event>
    <Event name="PAINT-LISTS" paragraph="PAINT-LISTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-PCTI                                PIC    9(3).
       01 WS-TOT2                                PIC    9(15)V99.

       PROCEDURE DIVISION.
           *> Each bar is that fund's PL as a percent of the largest one (the first,
           *> so always 100), not of the total. A row is blanked when fewer than four
           *> funds match.

           IF    WS-TOP-N >= 1
               SET     LBL-TOP1-N::Caption       TO    WS-TOP-NAME(1)
               SET     WS-FV                     TO    WS-TOP-PL(1)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-TOP-PL(1), set just above: the PL of the 1st largest fund of
               *>         the filter.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-TOP1-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP1-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(1) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP1::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP1-N::Caption       TO    SPACES
               SET     LBL-TOP1-V::Caption       TO    SPACES

               PRG-TOP1::SetValue(0)
           END-IF
           IF    WS-TOP-N >= 2
               SET     LBL-TOP2-N::Caption       TO    WS-TOP-NAME(2)
               SET     WS-FV                     TO    WS-TOP-PL(2)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-TOP-PL(2), set just above: the PL of the 2nd largest fund of
               *>         the filter.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-TOP2-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP2-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(2) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP2::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP2-N::Caption       TO    SPACES
               SET     LBL-TOP2-V::Caption       TO    SPACES

               PRG-TOP2::SetValue(0)
           END-IF
           IF    WS-TOP-N >= 3
               SET     LBL-TOP3-N::Caption       TO    WS-TOP-NAME(3)
               SET     WS-FV                     TO    WS-TOP-PL(3)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-TOP-PL(3), set just above: the PL of the 3rd largest fund of
               *>         the filter.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-TOP3-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP3-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(3) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP3::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP3-N::Caption       TO    SPACES
               SET     LBL-TOP3-V::Caption       TO    SPACES

               PRG-TOP3::SetValue(0)
           END-IF
           IF    WS-TOP-N >= 4
               SET     LBL-TOP4-N::Caption       TO    WS-TOP-NAME(4)
               SET     WS-FV                     TO    WS-TOP-PL(4)

               *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and
               *> given a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number
               *> (15.5 becomes 15,50).
               *> Uses:   WS-FV = WS-TOP-PL(4), set just above: the PL of the 4th largest fund of
               *>         the filter.
               *> Result: WS-FT = that PL in short form; "R$ " + WS-FT goes into
               *>         LBL-TOP4-V::Caption.

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP4-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(4) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP4::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP4-N::Caption       TO    SPACES
               SET     LBL-TOP4-V::Caption       TO    SPACES

               PRG-TOP4::SetValue(0)
           END-IF
           *>  structure: share of the PL held by classes and by sub-classes

           COMPUTE    WS-TOT2 = WS-T-CLS + WS-T-SUB

           SET     WS-FP                         TO    0
           SET     WS-PCTI                       TO    0

           IF    WS-TOT2 > 0
               COMPUTE    WS-FP = WS-T-CLS * 100 / WS-TOT2
               COMPUTE    WS-PCTI = WS-T-CLS * 100 / WS-TOT2
           END-IF
           PRG-CLS::SetValue(WS-PCTI)

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-T-CLS * 100 / WS-TOT2 (0 when WS-TOT2 = 0; truncated to one
           *>         decimal), set above: the share of the "Classe" funds' PL in WS-TOT2 = WS-T-CLS
           *>         + WS-T-SUB (the PL of the Classe and Subclasse funds).
           *> Result: WS-FT = that percentage text; the next line puts it in LBL-CLS-P::Caption
           *>         (PRG-CLS was set above).

           CALL    "FMT-PCT"

           SET     LBL-CLS-P::Caption            TO    WS-FT
           SET     WS-FP                         TO    0
           SET     WS-PCTI                       TO    0

           IF    WS-TOT2 > 0
               COMPUTE    WS-FP = WS-T-SUB * 100 / WS-TOT2
               COMPUTE    WS-PCTI = WS-T-SUB * 100 / WS-TOT2
           END-IF
           PRG-SUB::SetValue(WS-PCTI)

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-T-SUB * 100 / WS-TOT2 (0 when WS-TOT2 = 0; truncated to one
           *>         decimal), set above: the share of the other funds' PL (sub-classes) in WS-TOT2
           *>         = WS-T-CLS + WS-T-SUB.
           *> Result: WS-FT = that percentage text; the next line puts it in LBL-SUB-P::Caption
           *>         (PRG-SUB was set above).

           CALL    "FMT-PCT"
           SET     LBL-SUB-P::Caption            TO    WS-FT
]]></Event>
    <Event name="PAINT-DATA" paragraph="PAINT-DATA"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-A                                   PIC    X(24).
       01 WS-PCT                                 PIC    9(3)V9.
       01 WS-AVG                                 PIC    9(15)V99.
       01 WS-R                                   PIC    99.

       PROCEDURE DIVISION.
           SET     WS-FC                         TO    WS-T-CNT

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-T-CNT, set just above: the number of funds that pass the filters.
           *> Result: WS-FT = that count with points between thousands; it becomes LBL-K1-V::Caption
           *>         (card FUNDOS).

           CALL    "FMT-COUNT"

           SET     LBL-K1-V::Caption             TO    WS-FT
           SET     WS-PCT                        TO    0

           IF    WS-UNIV > 0
               COMPUTE    WS-PCT = WS-T-CNT * 100 / WS-UNIV
           END-IF
           SET     WS-FP                         TO    WS-PCT

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-PCT = WS-T-CNT * 100 / WS-UNIV (left 0 when WS-UNIV = 0; truncated
           *>         to one decimal): the filtered funds as a share of all the funds in the
           *>         database.
           *> Result: WS-FT = that percentage text; "... do universo" is built from it for
           *>         LBL-K1-S::Caption.

           CALL    "FMT-PCT"
           SET     WS-TXT                        TO    SPACES
           STRING    WS-FT::Trim() " do universo" INTO WS-TXT

           SET     LBL-K1-S::Caption             TO    WS-TXT
           SET     WS-FV                         TO    WS-T-PL

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-T-PL, set just above: the total PL of the filtered funds.
           *> Result: WS-FT = that total in short form; "R$ " + WS-FT becomes LBL-K2-V::Caption
           *>         (card PL TOTAL).

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT

           SET     LBL-K2-V::Caption             TO    WS-TXT
           SET     WS-AVG                        TO    0

           *> Average over the funds that report a PL (WS-T-PLN, from COUNT(pl)),
           *> not over all of them.

           IF    WS-T-PLN > 0
               COMPUTE    WS-AVG = WS-T-PL / WS-T-PLN
           END-IF
           SET     WS-FV                         TO    WS-AVG

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-AVG, set just above: WS-T-PL / WS-T-PLN, the average PL of the
           *>         funds that report a PL (0 when none does).
           *> Result: WS-FT = that average in short form; "médio R$ ... por fundo" is built from it
           *>         for LBL-K2-S::Caption.

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "médio R$ " WS-FT::Trim() " por fundo" INTO WS-TXT

           SET     LBL-K2-S::Caption             TO    WS-TXT
           SET     WS-FV                         TO    WS-T-COT

           *> FMT-SHORTN: formats a count in short form: under 1000 it is a whole number, from 1000
           *> on it is like FMT-SHORT.
           *> Uses:   WS-FV = WS-T-COT, set just above: the total of cotistas of the filtered funds.
           *> Result: WS-FT = the total as a whole number below 1000, otherwise in short form; it
           *>         becomes LBL-K3-V::Caption (card COTISTAS).

           CALL    "FMT-SHORTN"

           SET     LBL-K3-V::Caption             TO    WS-FT
           SET     WS-AVG                        TO    0

           IF    WS-T-CNT > 0
               COMPUTE    WS-AVG = WS-T-COT / WS-T-CNT
           END-IF
           SET     WS-FV                         TO    WS-AVG

           *> FMT-SHORTN: formats a count in short form: under 1000 it is a whole number, from 1000
           *> on it is like FMT-SHORT.
           *> Uses:   WS-FV = WS-AVG, set just above: WS-T-COT / WS-T-CNT, the average cotistas per
           *>         fund (0 when there is no fund).
           *> Result: WS-FT = that average: below 1000 a whole number with the decimals dropped
           *>         (418.37 shows as 418), otherwise short form; "média ... por fundo" is built
           *>         from it for LBL-K3-S::Caption.

           CALL    "FMT-SHORTN"
           SET     WS-TXT                        TO    SPACES
           STRING    "média " WS-FT::Trim() " por fundo" INTO WS-TXT

           SET     LBL-K3-S::Caption             TO    WS-TXT
           SET     WS-FV                         TO    WS-T-MAX

           *> FMT-SHORT: formats an amount in short pt-BR form: from 1000 up it is scaled and given
           *> a suffix (2500000000 becomes 2,50 bi); below 1000 it stays a plain number (15.5
           *> becomes 15,50).
           *> Uses:   WS-FV = WS-T-MAX, set just above: the largest PL among the filtered funds.
           *> Result: WS-FT = that PL in short form; "R$ " + WS-FT becomes LBL-K4-V::Caption (card
           *>         MAIOR FUNDO).

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT
           SET     LBL-K4-V::Caption             TO    WS-TXT
           IF    WS-TOP-N > 0
               SET     LBL-K4-S::Caption         TO    WS-TOP-NAME(1)
           ELSE
               SET     LBL-K4-S::Caption         TO    SPACES
           END-IF
           SET     WS-R                          TO    WS-RANK(1)
           IF    WS-R > 0
               SET     LBL-K5-V::Caption         TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-T-PL > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-T-PL
               END-IF

               *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
               *> 42,5%).
               *> Uses:   WS-FP = WS-CAT-PL(WS-R) * 100 / WS-T-PL (0 when WS-T-PL = 0; truncated to
               *>         one decimal), set just above: the PL share of the leading category (WS-R =
               *>         WS-RANK(1)) in the filtered PL WS-T-PL.
               *> Result: WS-FT = that percentage text; "... do PL filtrado" is built from it for
               *>         LBL-K5-S::Caption.

               CALL    "FMT-PCT"
               SET     WS-TXT                    TO    SPACES
               STRING    WS-FT::Trim() " do PL filtrado" INTO WS-TXT
               SET     LBL-K5-S::Caption         TO    WS-TXT
           ELSE
               SET     LBL-K5-V::Caption         TO    "-"
               SET     LBL-K5-S::Caption         TO    SPACES
           END-IF
]]></Event>
    <Event name="PAINT-GRID-INFO" paragraph="PAINT-GRID-INFO"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-A                                   PIC    X(24).
       01 WS-B                                   PIC    X(24).
       01 WS-FROM                                PIC    9(9).
       01 WS-TO                                  PIC    9(9).

       PROCEDURE DIVISION.
           IF    WS-T-CNT = 0
               SET     WS-FROM                   TO    0
               SET     WS-TO                     TO    0
           ELSE
               COMPUTE    WS-FROM = (WS-PAGE - 1) * WS-PSIZE + 1
               COMPUTE    WS-TO = WS-PAGE * WS-PSIZE

               IF    WS-TO > WS-T-CNT
                   SET     WS-TO                 TO    WS-T-CNT
               END-IF
           END-IF
           *> FMT-COUNT answers in WS-FT, which the next call overwrites, so each
           *> formatted number waits in WS-A / WS-B until the sentence is built.

           SET     WS-FC                         TO    WS-FROM

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-FROM, set just above: the number of the first row of the current
           *>         page ((WS-PAGE - 1) * WS-PSIZE + 1), or 0 when there are no funds.
           *> Result: WS-FT = that number with points between thousands; WS-A keeps it because the
           *>         next call overwrites WS-FT.

           CALL    "FMT-COUNT"

           SET     WS-A                          TO    WS-FT
           SET     WS-FC                         TO    WS-TO

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-TO, set just above: the number of the last row of the page (WS-PAGE
           *>         * WS-PSIZE, capped at WS-T-CNT).
           *> Result: WS-FT = that number with points between thousands; WS-B keeps it because the
           *>         next call overwrites WS-FT.

           CALL    "FMT-COUNT"

           SET     WS-B                          TO    WS-FT
           SET     WS-FC                         TO    WS-T-CNT

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-T-CNT, set just above: the number of funds that pass the filters.
           *> Result: WS-FT = that count with points between thousands; "Mostrando A a B de N
           *>         fundo(s)" is built from WS-A, WS-B and WS-FT for LBL-GRID-S::Caption.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           STRING    "Mostrando " FUNCTION TRIM(WS-A) " a " FUNCTION TRIM(WS-B) " de " WS-FT::Trim()
               " fundo(s)" INTO WS-TXT
           SET     LBL-GRID-S::Caption           TO    WS-TXT
           SET     WS-FC                         TO    WS-PAGE

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-PAGE, set just above: the page of the grid being shown.
           *> Result: WS-FT = that page number with points between thousands; WS-A keeps it because
           *>         the next call overwrites WS-FT.

           CALL    "FMT-COUNT"

           SET     WS-A                          TO    WS-FT
           SET     WS-FC                         TO    WS-PAGES

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-PAGES, set just above: the number of pages.
           *> Result: WS-FT = that number with points between thousands; "Página A de N" is built
           *>         from WS-A and WS-FT for LBL-PAGE::Caption.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           STRING    "Página " FUNCTION TRIM(WS-A) " de " WS-FT::Trim() INTO WS-TXT
           SET     LBL-PAGE::Caption             TO    WS-TXT
           IF    WS-PAGE > 1
               BTN-PREV::Enable()
           ELSE
               BTN-PREV::Disable()
           END-IF
           IF    WS-PAGE < WS-PAGES
               BTN-NEXT::Enable()
           ELSE
               BTN-NEXT::Disable()
           END-IF
]]></Event>
    <Event name="REFRESH-GRID" paragraph="REFRESH-GRID"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> Q-GRID: loads one page of the filtered funds into the grid GRD-FUNDOS, in the order
           *> chosen in CMB-ORDER.
           *> Uses:   FLT-REQ (from BUILD-WHERE), CMB-ORDER::Value, WS-T-CNT, WS-PSIZE (300 rows
           *>         per page) and WS-PAGE.
           *> Result: WS-PAGES = WS-T-CNT / WS-PSIZE rounded up (1 when empty); WS-PAGE clamped to
           *>         1..WS-PAGES; GRD-FUNDOS cleared and given the rows of that page (16 columns
           *>         each).

           *> BE-FLOW-BEGIN: a flow of Backend calls starts (the FUND-GRID calls of Q-GRID).
           *> Uses:   WS-BE-DEPTH (0 when this is not inside APPLY-FILTERS) and WS-BE-FAILS.
           *> Result: WS-BE-DEPTH + 1; WS-BE-MARK = WS-BE-FAILS when no flow was running.

           CALL    "BE-FLOW-BEGIN"

           *> Q-GRID: loads one page of the filtered funds into the grid GRD-FUNDOS, in the order
           *> chosen in CMB-ORDER.
           *> Uses:   FLT-REQ (from BUILD-WHERE), CMB-ORDER::Value, WS-T-CNT, WS-PSIZE (300 rows
           *>         per page) and WS-PAGE.
           *> Result: WS-PAGES = WS-T-CNT / WS-PSIZE rounded up (1 when empty); WS-PAGE clamped to
           *>         1..WS-PAGES; GRD-FUNDOS cleared and given the rows of that page (16 columns
           *>         each).

           CALL    "Q-GRID"

           *> PAINT-GRID-INFO: updates the grid captions and the paging buttons.
           *> Uses:   WS-PAGE and WS-PAGES, as Q-GRID left them just above (it clamps WS-PAGE and
           *>         sets WS-PAGES), and WS-PSIZE and WS-T-CNT, which it only reads.
           *> Result: LBL-GRID-S::Caption = "Mostrando A a B de N fundo(s)"; LBL-PAGE::Caption =
           *>         "Página P de N"; BTN-PREV enabled only when WS-PAGE > 1, BTN-NEXT only when
           *>         WS-PAGE < WS-PAGES.

           CALL    "PAINT-GRID-INFO"

           *> BE-FLOW-END: the flow of Backend calls ends.
           *> Uses:   WS-BE-DEPTH, WS-BE-FAILS against WS-BE-MARK, WS-BE-SHOWN, WS-STATUS-TXT.
           *> Result: WS-BE-DEPTH - 1; when it reaches 0 with no call failed since BE-FLOW-BEGIN and
           *>         a Backend error showing, LBL-STATUS::Caption = WS-STATUS-TXT, WS-BE-SHOWN = 0.

           CALL    "BE-FLOW-END"
]]></Event>
    <Event name="APPLY-FILTERS" paragraph="APPLY-FILTERS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> BE-FLOW-BEGIN: a flow of Backend calls starts (FUND-INIT again, or the queries).
           *> Uses:   WS-BE-DEPTH (0: no flow running) and WS-BE-FAILS.
           *> Result: WS-BE-DEPTH + 1; WS-BE-MARK = WS-BE-FAILS.

           CALL    "BE-FLOW-BEGIN"

           *> A FUND-INIT that FAILED (the Backend was not reachable at start-up) is asked again:
           *> the desktop always has its database, so its Apply never meets this. Without data
           *> (NOFILE) nothing is asked again, as on the desktop (WS-LOADED stays 0).

           IF    WS-LOADED = 0 AND INI-STATUS NOT = "NOFILE"

               *> INIT-DB: asks the Backend for the database (FUND-INIT).
               *> Uses:   nothing of the form; FUND-INIT builds data/fundos.db on first use.
               *> Result: INI-RES = the universe, reference date, category slots and level
               *>         names; WS-LOADED = 1 when the answer is OK or TRUNC; a failure goes to
               *>         BACKEND-FAIL (header error, WS-BE-FAILS + 1).

               CALL    "INIT-DB"

               *> LOAD-DIMS: paints what FUND-INIT answered.
               *> Uses:   INI-RES and WS-LOADED from INIT-DB just above.
               *> Result: LBL-STATUS::Caption and WS-STATUS-TXT = the desktop's status line;
               *>         WS-UNIV, WS-CAT-NAME(1..10), WS-CATCNT; LST-N2 / LST-N3 items. Nothing
               *>         when the call failed again.

               CALL    "LOAD-DIMS"
           END-IF
           IF    WS-LOADED = 0

               *> The desktop applied this filter (its start-up, or this Apply); the page could
               *> not ask the Backend, so it keeps the filter as the one of the last Apply:
               *> ENSURE-INIT shows its results once FUND-INIT answers.

               *> BUILD-WHERE: fills the filter from the filter controls and keeps it.
               *> Uses:   TXT-NOME::Text, TXT-CAT::Text, the picks (PK-TAB), DTP-INI::Value,
               *>         DTP-FIM::Value, NUD-PL1::Value, NUD-PL2::Value and the ticks of LST-N2
               *>         and LST-N3, as they stand at this Apply (the designed values at start-up).
               *> Result: FLT-REQ = that filter; FLS-REQ = a copy (FLT-SAVE), which ENSURE-INIT
               *>         applies later. Work items overwritten: WS-TERM, WS-PAT, WS-CHK.

               CALL    "BUILD-WHERE"

               *> BE-FLOW-END: the flow of Backend calls ends.
               *> Uses:   WS-BE-DEPTH, WS-BE-FAILS against WS-BE-MARK, WS-BE-SHOWN.
               *> Result: WS-BE-DEPTH - 1 (a failed FUND-INIT keeps its error in the header).

               CALL    "BE-FLOW-END"
               EXIT PARAGRAPH
           END-IF
           SET     WS-PAGE                       TO    1

           *> BUILD-WHERE: fills the filter that every Backend call below sends, from the filter
           *> controls.
           *> Uses:   TXT-NOME::Text, TXT-CAT::Text, the picks (PK-TAB), DTP-INI::Value,
           *>         DTP-FIM::Value, NUD-PL1::Value, NUD-PL2::Value (R$ million) and the ticks of
           *>         LST-N2 and LST-N3.
           *> Result: FLT-REQ = the typed texts, the picks (none in Todos mode), the dates, the PL
           *>         range and the ticked level 2 / level 3 names, as values; FLS-REQ = a copy
           *>         (FLT-SAVE) for paging. Work items overwritten: WS-TERM, WS-PAT, WS-CHK.

           CALL    "BUILD-WHERE"

           *> RUN-QUERIES: runs every query of the filter and repaints what they feed.
           *> Uses:   FLT-REQ and FLS-REQ, just filled by BUILD-WHERE; WS-PAGE = 1, set above;
           *>         WS-CATCNT / WS-CAT-NAME (LOAD-DIMS), WS-METRIC, WS-ACUM, CMB-ORDER::Value.
           *> Result: the totals (WS-T-*), WS-CAT-*, WS-RANK, WS-N2-*, WS-BIN-CNT, WS-TOP-* and the
           *>         year tables; the KPI card, the charts, the top-4 list, the Classe / Subclasse
           *>         bars, the metric buttons, the Dados cards, and GRD-FUNDOS page 1 with
           *>         LBL-GRID-S, LBL-PAGE, BTN-PREV and BTN-NEXT.

           CALL    "RUN-QUERIES"

           *> BE-FLOW-END: the flow of Backend calls of this Apply ends.
           *> Uses:   WS-BE-DEPTH, WS-BE-FAILS against WS-BE-MARK (set by BE-FLOW-BEGIN above),
           *>         WS-BE-SHOWN and WS-STATUS-TXT.
           *> Result: WS-BE-DEPTH - 1; when every call of this Apply answered and a Backend error
           *>         was showing, LBL-STATUS::Caption = WS-STATUS-TXT again and WS-BE-SHOWN = 0.

           CALL    "BE-FLOW-END"
]]></Event>
    <Event name="RUN-QUERIES" paragraph="RUN-QUERIES"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> What the desktop's APPLY-FILTERS does after building WS-WHERE, for the filter in
           *> FLT-REQ (BUILD-WHERE for an Apply, FLT-RESTORE for ENSURE-INIT). Run in dependency
           *> order: Q-YEARS needs Q-TOTALS (newest year) and Q-CATS (counts), and the painters
           *> only read what the queries stored.

           *> Q-TOTALS: reads the totals of the funds that pass the filters.
           *> Uses:   FLT-REQ, filled by the caller.
           *> Result: WS-T-CNT = funds; WS-T-PL = sum of PL; WS-T-COT = sum of cotistas; WS-T-PLN =
           *>         funds that report a PL; WS-T-MAX = largest PL; WS-T-YMAX = newest start year;
           *>         WS-T-CLS / WS-T-SUB = PL of the "Classe" funds / of the others.

           CALL    "Q-TOTALS"

           *> Q-CATS: counts the filtered funds, their PL and their cotistas per level-1 category.
           *> Uses:   FLT-REQ and the ten names in WS-CAT-NAME(1..WS-CATCNT) that LOAD-DIMS stored.
           *> Result: WS-CAT-CNT, WS-CAT-PL and WS-CAT-COT(1..10) = funds, summed PL and summed
           *>         cotistas of each category slot; 0 for a category with no fund under the
           *>         filter.

           CALL    "Q-CATS"

           *> SORT-CATS: ranks the category slots by PL, largest first.
           *> Uses:   WS-CAT-PL(1..WS-CATCNT), just filled by Q-CATS.
           *> Result: WS-RANK(k) = slot number of the k-th largest PL, 0 where no category with a PL
           *>         is left; WS-CAT-USED marks are cleared again.

           CALL    "SORT-CATS"

           *> Q-N2: counts the filtered funds per level-2 category, keeping the nine largest and a
           *> rest.
           *> Uses:   FLT-REQ, filled by the caller.
           *> Result: WS-N2-NAME and WS-N2-CNT(1..9) = the nine level-2 categories with most funds,
           *>         largest first; slot 10 = "Outros" with the funds of all the rest (only when
           *>         there are more than nine); WS-N2-TOTAL = funds in all of them. Names are held
           *>         in 24 characters.

           CALL    "Q-N2"

           *> Q-BINS: counts the filtered funds that report a PL in five PL bands.
           *> Uses:   FLT-REQ, filled by the caller.
           *> Result: WS-BIN-CNT(1..5) = funds with PL under R$ 1 mi, under 10 mi, under 100 mi,
           *>         under 1 bi, and 1 bi or more.

           CALL    "Q-BINS"

           *> Q-TOP: finds the four filtered funds with the largest PL.
           *> Uses:   FLT-REQ, filled by the caller.
           *> Result: WS-TOP-NAME(1..4) and WS-TOP-PL(1..4) = name (or code, for a fund without a
           *>         name; the first 40 characters) and PL, largest first; WS-TOP-N = how many were
           *>         found (0 to 4).

           CALL    "Q-TOP"

           *> Q-YEARS: builds the 12-year table behind the yearly charts, for all categories and for
           *> the top three.
           *> Uses:   FLT-REQ, WS-T-YMAX (newest start year, from Q-TOTALS), WS-CATCNT and
           *>         WS-CAT-NAME (from LOAD-DIMS) and WS-CAT-CNT (from Q-CATS).
           *> Result: WS-TOP3-IDX(1..3) = slots of the three categories with most funds; WS-YR-MIN =
           *>         WS-T-YMAX - 11 (2015 with no year) and WS-YR-NUM(1..12); WS-YA-* (all) and
           *>         WS-YS-*(year, 1..3) per year; WS-OA-* and WS-OS-*(1..3) = funds that began
           *>         before the window.

           CALL    "Q-YEARS"

           *> PAINT-KPIS: repaints the KPI card of the dashboard from the totals of the filter.
           *> Uses:   WS-T-PL, WS-T-CNT, WS-T-COT, WS-T-PLN, WS-T-MAX and WS-UNIV.
           *> Result: LBL-KPI-V::Caption (total PL), LBL-KPI-C::Caption (funds and cotistas),
           *>         GAU-UNIV (whole-number percent of the universe), LBL-AVG-V::Caption (average
           *>         PL) and LBL-KPI-F::Caption (average and largest PL).

           CALL    "PAINT-KPIS"

           *> PAINT-CHARTS: repaints the radar and the two donuts with their legends, then the PL
           *> bands.
           *> Uses:   WS-CATCNT and WS-CAT-NAME (LOAD-DIMS), WS-CAT-CNT / WS-CAT-PL / WS-CAT-COT
           *>         (Q-CATS), WS-RANK (SORT-CATS), WS-N2-* (Q-N2), WS-BIN-CNT (Q-BINS) and the
           *>         picks.
           *> Result: CH-RADAR with LBL-RAD-S::Caption; CH-DONUT1 with LBL-D1-C::Caption and 4
           *>         legend rows (LBL-L1-n-N, -P, -V and SHP-L1-n::FillColor); CH-DONUT2 with
           *>         LBL-D2-C::Caption and 6 legend rows (LBL-L2-n-N, -P, -V and
           *>         SHP-L2-n::FillColor); then the PL-band rows LBL-BIN1-V to LBL-BIN5-V and
           *>         PRG-BIN1 to PRG-BIN5 (PAINT-BINS).

           CALL    "PAINT-CHARTS"

           *> PAINT-YEARS: repaints the yearly bar and line charts for the metric in WS-METRIC, and
           *> the PL sparkline SPK.
           *> Uses:   WS-METRIC (1 funds, 2 PL, 3 cotistas), WS-ACUM, the yearly tables of Q-YEARS
           *>         and WS-T-CNT/PL/COT.
           *> Result: CH-BAR, CH-LINE and SPK cleared and refilled with 12 yearly points (CH-LINE as
           *>         running totals while WS-ACUM = 1); XAxisLabel, SeriesLabels and SeriesColors
           *>         of both charts (the top-three categories); LBL-BAR-U, LBL-LIN-U and
           *>         LBL-BAR-TOT captions.

           CALL    "PAINT-YEARS"

           *> PAINT-TABS: highlights the metric button (Fundos, PL, Cotistas) that WS-METRIC
           *> selects.
           *> Uses:   WS-METRIC.
           *> Result: BTN-M1 to BTN-M3: the selected one gets BackgroundColor "#3E7BE8" and
           *>         ForegroundColor "#FFFFFF", the other two white ("#FFFFFF") with text
           *>         "#1B2A4E".

           CALL    "PAINT-TABS"

           *> PAINT-LISTS: repaints the list of the four largest funds and the Classes / Subclasses
           *> bars.
           *> Uses:   WS-TOP-N, WS-TOP-NAME(1..4), WS-TOP-PL(1..4), WS-T-CLS and WS-T-SUB.
           *> Result: LBL-TOP1-N to LBL-TOP4-N and LBL-TOP1-V to LBL-TOP4-V (blank for a missing
           *>         fund) with PRG-TOP1 to PRG-TOP4 (whole-number percent of the largest PL);
           *>         PRG-CLS, LBL-CLS-P, PRG-SUB and LBL-SUB-P.

           CALL    "PAINT-LISTS"

           *> PAINT-DATA: repaints the five KPI cards of the Dados page.
           *> Uses:   WS-T-CNT, WS-T-PL, WS-T-PLN, WS-T-COT, WS-T-MAX, WS-UNIV, WS-TOP-N,
           *>         WS-TOP-NAME(1), WS-RANK(1) and WS-CAT-*.
           *> Result: LBL-K1-V and LBL-K1-S to LBL-K5-V and LBL-K5-S::Caption (FUNDOS, PL TOTAL,
           *>         COTISTAS, MAIOR FUNDO, CATEGORIA LÍDER).

           CALL    "PAINT-DATA"

           *> REFRESH-GRID: reloads the grid page and its captions.
           *> Uses:   FLS-REQ (the filter of the last Apply, kept by FLT-SAVE) and WS-T-CNT, just
           *>         produced by Q-TOTALS above; WS-PAGE (set to 1 by the caller), WS-PSIZE and
           *>         CMB-ORDER::Value.
           *> Result: GRD-FUNDOS holds page 1 of the filtered funds; LBL-GRID-S, LBL-PAGE, BTN-PREV
           *>         and BTN-NEXT match that page.

           CALL    "REFRESH-GRID"
]]></Event>
    <Event name="ENSURE-INIT" paragraph="ENSURE-INIT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> The one guard every user act runs first. The desktop has its database before any
           *> act: onLoad ran INIT-DB, LOAD-DIMS and its first Apply. A FUND-INIT that FAILED (the
           *> page opened while the Backend was not reachable) left the page without them; the
           *> first act after the Backend starts gives them back, whatever that act is. The
           *> start-up's Apply is the filter of the LAST Apply (FLS-REQ, kept by BUILD-WHERE also
           *> while the Backend was down), never the controls as they stand: a filter the user
           *> edited since then is applied only by Aplicar, Enter, OK or Limpar, as on the
           *> desktop. Without data (NOFILE) nothing is asked again, as on the desktop.

           IF    WS-LOADED = 1 OR INI-STATUS = "NOFILE"
               EXIT PARAGRAPH
           END-IF

           *> BE-FLOW-BEGIN: a flow of Backend calls starts (FUND-INIT again, then the queries).
           *> Uses:   WS-BE-DEPTH (0: no flow running) and WS-BE-FAILS.
           *> Result: WS-BE-DEPTH + 1; WS-BE-MARK = WS-BE-FAILS.

           CALL    "BE-FLOW-BEGIN"

           *> INIT-DB: asks the Backend for the database (FUND-INIT).
           *> Uses:   nothing of the form; FUND-INIT builds data/fundos.db on first use.
           *> Result: INI-RES = the universe, reference date, category slots and level names;
           *>         WS-LOADED = 1 when the answer is OK or TRUNC; a failure goes to BACKEND-FAIL
           *>         (header error, WS-BE-FAILS + 1).

           CALL    "INIT-DB"

           *> LOAD-DIMS: paints what FUND-INIT answered.
           *> Uses:   INI-RES and WS-LOADED from INIT-DB just above.
           *> Result: LBL-STATUS::Caption and WS-STATUS-TXT = the desktop's status line; WS-UNIV,
           *>         WS-CAT-NAME(1..10), WS-CATCNT; LST-N2 / LST-N3 items. Nothing when the call
           *>         failed again.

           CALL    "LOAD-DIMS"

           IF    WS-LOADED = 1
               SET     WS-PAGE                   TO    1

               *> FLT-RESTORE: puts back the filter of the last Apply.
               *> Uses:   FLS-REQ, kept by FLT-SAVE when onLoad's APPLY-FILTERS (or a later Apply)
               *>         met the Backend down: the designed values unless the user applied others.
               *> Result: FLT-REQ = FLS-REQ, member by member.

               CALL    "FLT-RESTORE"

               *> RUN-QUERIES: runs every query of that filter and repaints what they feed.
               *> Uses:   FLT-REQ and FLS-REQ (the last Apply), WS-PAGE = 1, the dimensions LOAD-DIMS
               *>         just stored, WS-METRIC, WS-ACUM and CMB-ORDER::Value.
               *> Result: the KPI card, the charts, the top-4 list, the Classe / Subclasse bars, the
               *>         metric buttons, the Dados cards and GRD-FUNDOS page 1 with its captions:
               *>         the desktop's state after start-up. FLT-REQ holds the last Apply's filter.

               CALL    "RUN-QUERIES"
           END-IF

           *> BE-FLOW-END: the flow of Backend calls ends.
           *> Uses:   WS-BE-DEPTH, WS-BE-FAILS against WS-BE-MARK, WS-BE-SHOWN, WS-STATUS-TXT.
           *> Result: WS-BE-DEPTH - 1; a FUND-INIT that failed again keeps its error in the header.

           CALL    "BE-FLOW-END"
]]></Event>
    <Event name="PAINT-BINS" paragraph="PAINT-BINS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-BMAX                                PIC    9(9).
       01 WS-BTOT                                PIC    9(9).
       01 WS-PCTI                                PIC    9(3).
       01 WS-TXT                                 PIC    X(60).
       01 WS-A                                   PIC    X(24).

       PROCEDURE DIVISION.
           *> The text gives each band's share of the total (WS-BTOT); the bar is
           *> relative to the largest band (WS-BMAX), so the tallest always fills.

           SET     WS-BMAX                       TO    0
           SET     WS-BTOT                       TO    0

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
               ADD    WS-BIN-CNT(WS-I) TO WS-BTOT
               IF    WS-BIN-CNT(WS-I) > WS-BMAX
                   SET     WS-BMAX               TO    WS-BIN-CNT(WS-I)
               END-IF
           END-PERFORM
           SET     WS-FC                         TO    WS-BIN-CNT(1)

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-BIN-CNT(1), set just above: the funds in PL band 1 (under R$ 1 mi).
           *> Result: WS-FT = that count with points between thousands; WS-A keeps it a few lines
           *>         below, because FMT-PCT overwrites WS-FT.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(1) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-BIN-CNT(1) * 100 / WS-BTOT (0 when WS-BTOT = 0; truncated to one
           *>         decimal), set above: the share of band 1 among the funds in the five bands;
           *>         WS-A holds the count text.
           *> Result: WS-FT = that percentage text; WS-TXT = WS-A + "  (" + WS-FT + ")" is then
           *>         placed in LBL-BIN1-V::Caption.

           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN1-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(1) * 100 / WS-BMAX
           END-IF
           PRG-BIN1::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(2)

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-BIN-CNT(2), set just above: the funds in PL band 2 (R$ 1 mi to
           *>         under 10 mi).
           *> Result: WS-FT = that count with points between thousands; WS-A keeps it a few lines
           *>         below, because FMT-PCT overwrites WS-FT.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(2) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-BIN-CNT(2) * 100 / WS-BTOT (0 when WS-BTOT = 0; truncated to one
           *>         decimal), set above: the share of band 2 among the funds in the five bands;
           *>         WS-A holds the count text.
           *> Result: WS-FT = that percentage text; WS-TXT = WS-A + "  (" + WS-FT + ")" is then
           *>         placed in LBL-BIN2-V::Caption.

           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN2-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(2) * 100 / WS-BMAX
           END-IF
           PRG-BIN2::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(3)

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-BIN-CNT(3), set just above: the funds in PL band 3 (R$ 10 mi to
           *>         under 100 mi).
           *> Result: WS-FT = that count with points between thousands; WS-A keeps it a few lines
           *>         below, because FMT-PCT overwrites WS-FT.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(3) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-BIN-CNT(3) * 100 / WS-BTOT (0 when WS-BTOT = 0; truncated to one
           *>         decimal), set above: the share of band 3 among the funds in the five bands;
           *>         WS-A holds the count text.
           *> Result: WS-FT = that percentage text; WS-TXT = WS-A + "  (" + WS-FT + ")" is then
           *>         placed in LBL-BIN3-V::Caption.

           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN3-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(3) * 100 / WS-BMAX
           END-IF
           PRG-BIN3::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(4)

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-BIN-CNT(4), set just above: the funds in PL band 4 (R$ 100 mi to
           *>         under 1 bi).
           *> Result: WS-FT = that count with points between thousands; WS-A keeps it a few lines
           *>         below, because FMT-PCT overwrites WS-FT.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(4) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-BIN-CNT(4) * 100 / WS-BTOT (0 when WS-BTOT = 0; truncated to one
           *>         decimal), set above: the share of band 4 among the funds in the five bands;
           *>         WS-A holds the count text.
           *> Result: WS-FT = that percentage text; WS-TXT = WS-A + "  (" + WS-FT + ")" is then
           *>         placed in LBL-BIN4-V::Caption.

           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN4-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(4) * 100 / WS-BMAX
           END-IF
           PRG-BIN4::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(5)

           *> FMT-COUNT: formats a whole number as text with pt-BR thousands points (1234 becomes
           *> 1.234).
           *> Uses:   WS-FC = WS-BIN-CNT(5), set just above: the funds in PL band 5 (R$ 1 bi or
           *>         more).
           *> Result: WS-FT = that count with points between thousands; WS-A keeps it a few lines
           *>         below, because FMT-PCT overwrites WS-FT.

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(5) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT

           *> FMT-PCT: formats a percentage with one decimal, a comma and a % sign (42.5 becomes
           *> 42,5%).
           *> Uses:   WS-FP = WS-BIN-CNT(5) * 100 / WS-BTOT (0 when WS-BTOT = 0; truncated to one
           *>         decimal), set above: the share of band 5 among the funds in the five bands;
           *>         WS-A holds the count text.
           *> Result: WS-FT = that percentage text; WS-TXT = WS-A + "  (" + WS-FT + ")" is then
           *>         placed in LBL-BIN5-V::Caption.

           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN5-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(5) * 100 / WS-BMAX
           END-IF
           PRG-BIN5::SetValue(WS-PCTI)
]]></Event>
