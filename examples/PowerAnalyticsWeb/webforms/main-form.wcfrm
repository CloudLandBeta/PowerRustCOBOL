      <Override control="C-DONUT1" property="MinWidth">0</Override>
      <Override control="C-DONUT1" property="Order">4</Override>
      <Override control="C-DONUT2" property="FlexBasis">100%</Override>
      <Override control="C-DONUT2" property="FlexGrow">1</Override>
