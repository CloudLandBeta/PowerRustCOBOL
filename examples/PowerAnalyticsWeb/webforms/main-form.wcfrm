    <Event name="SHOW-C-DONUT1" paragraph="SHOW-C-DONUT1"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           C-DONUT1::Show()
           C-DONUT1::PlayAnimation("intro")
           LBL-D1-T::PlayAnimation("intro")
           CH-DONUT1::PlayAnimation("intro")
           LBL-D1-C::PlayAnimation("intro")
           LBL-D1-S::PlayAnimation("intro")
           LBL-CLS-N::PlayAnimation("intro")
           TRK-PRG-CLS::PlayAnimation("intro")
           PRG-CLS::PlayAnimation("intro")
           LBL-CLS-P::PlayAnimation("intro")
           LBL-SUB-N::PlayAnimation("intro")
           TRK-PRG-SUB::PlayAnimation("intro")
           PRG-SUB::PlayAnimation("intro")
           LBL-SUB-P::PlayAnimation("intro")
           BOX-AVG::PlayAnimation("intro")
           LBL-AVG-V::PlayAnimation("intro")
           LBL-AVG-C::PlayAnimation("intro")
           SHP-L1-1::PlayAnimation("intro")
