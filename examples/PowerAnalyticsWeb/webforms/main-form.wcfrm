<?xml version="1.0" encoding="UTF-8"?>
<Form name="MAIN-FORM" title="PowerAnalytics - Fundos de investimento" width="1440" height="900" background="#EAF2FA14" transparency="50" grid-size="8" snap-to-grid="true" target="Custom" main-form="true" title-visible="false" corner-radius="15" index-base="1" window-effects="false" start-position="Center" responsive="true">
