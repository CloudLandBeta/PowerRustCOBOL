  <Control id="BTN-LEVELS" type="Button" x="1050" y="136" w="116" h="34" tab-order="30" z-order="29" visible="true" enabled="true" parent="GRP-BTN">
    <Property name="Caption">Níveis 2 e 3</Property>
    <Property name="BackgroundColor">#FFFFFF</Property>
    <Property name="ForegroundColor">#1B2A4E</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">true</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">14</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="Transparency">10</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="AlignSelf">Auto</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="ColumnSpan">1</Property>
    <Property name="Dock">None</Property>
    <Property name="FlexBasis">Auto</Property>
    <Property name="FlexGrow">0</Property>
    <Property name="FlexShrink">1</Property>
    <Property name="FlowBreak">0</Property>
    <Property name="GridColumn">0</Property>
    <Property name="GridRow">0</Property>
    <Property name="JustifySelf">Auto</Property>
    <Property name="Locked">0</Property>
    <Property name="MaxFontSize">0</Property>
    <Property name="MaxHeight">0</Property>
    <Property name="MaxWidth">0</Property>
    <Property name="MinFontSize">0</Property>
    <Property name="MinHeight">0</Property>
    <Property name="MinWidth">0</Property>
    <Property name="Order">0</Property>
    <Property name="PaddingBottom" />
    <Property name="PaddingLeft" />
    <Property name="PaddingRight" />
    <Property name="PaddingTop" />
    <Property name="RowSpan">1</Property>
    <Property name="ScaleFont">1</Property>
    <Event name="onClick" paragraph="BTN-LEVELS--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> ENSURE-INIT: gives the page the desktop's start-up state when FUND-INIT failed.
           *> Uses:   WS-LOADED and INI-STATUS (nothing is done once the database answered, nor
           *>         without data); FLS-REQ, the filter of the last Apply (never the controls'
           *>         unapplied edits).
           *> Result: after a late Backend start: the header line, LST-N2 / LST-N3, the
           *>         dashboard, the Dados cards and the grid as the desktop shows them after
           *>         start-up; while the Backend is still down, its error in the header.

           CALL    "ENSURE-INIT"
           IF    WS-LEVELS-OPEN = 0
               *> Only one dropdown at a time: close the search list first. Popup layers
               *> are not laid out by the form, so SET-FILT-HEIGHT places the card
               *> before it is shown.

               *> SM-CLOSE: closes the search dropdown when one is open.
               *> Uses:   WS-SM ("N" or "C" while a dropdown is open, SPACE otherwise). Caller's
               *>         test (not read by SM-CLOSE): WS-LEVELS-OPEN = 0, so the Levels card is
               *>         closed.
               *> Result: Only when WS-SM was not SPACE: WS-SM = SPACE and POPUP-SEARCH::Visible =
               *>         FALSE, so only one dropdown shows at a time.

               CALL    "SM-CLOSE"
               SET     WS-LEVELS-OPEN            TO    1

               *> SET-FILT-HEIGHT: lays the window out for its current size: filter bar height,
               *> popup cards, KPI strip, Dados page and grid.
               *> Uses:   me::Breakpoint, me::Width and me::Height; no data item is read
               *>         (WS-LEVELS-OPEN in particular is not: the Levels card is always placed).
               *>         The Levels card is a popup layer, which the form does not lay out, so it
               *>         is placed here before it is shown (the caller set WS-LEVELS-OPEN = 1 just
               *>         above).
               *> Result: everything is repositioned: FILT::Height (76 to 332 px by breakpoint and
               *>         width); position and size of the Levels card (LV-DROP, GRP-N2, LBL-F-N2,
               *>         LST-N2, GRP-N3, LBL-F-N3, LST-N3, SCRIM-LV) and of the search card
               *>         (SM-DROP, LBL-SM-T, LST-SM, LBL-SM-INFO, BTN-SM-CLR, BTN-SM-OK, SCRIM-SM),
               *>         each only in the properties it needs (SM-DROP and LST-SM keep their
               *>         designed Height); PG-DASH::VScroll (0 in Expanded, else 1); STRIP hidden
               *>         in Compact, else shown with the cards K1-C to K5-C, their labels and the
               *>         dots DOT-K1 to DOT-K5; PG-DATA, C-GRID, LBL-GRID-T, LBL-GRID-S, CMB-ORDER,
               *>         GRD-FUNDOS, BTN-PREV, LBL-PAGE and BTN-NEXT. Work items overwritten: WS-BP
               *>         (holds me::Breakpoint).

               CALL    "SET-FILT-HEIGHT"

               SET     POPUP-LEVELS::Visible     TO    TRUE
               SET     BTN-LEVELS::Caption       TO    "Fechar níveis"
           ELSE

               *> CLOSE-LEVELS: closes the Levels 2 and 3 popup when it is open.
               *> Uses:   WS-LEVELS-OPEN, which is 1 here: the Levels card is open and the button
               *>         closes it.
               *> Result: WS-LEVELS-OPEN = 0; POPUP-LEVELS::Visible = FALSE; BTN-LEVELS::Caption =
               *>         "Níveis 2 e 3".

               CALL    "CLOSE-LEVELS"
           END-IF
]]></Event>
  </Control>
  <Control id="BTN-CLEAR" type="Button" x="1174" y="136" w="76" h="34" tab-order="31" z-order="30" visible="true" enabled="true" parent="GRP-BTN">
