    <Event name="SHOW-VIEW" paragraph="SHOW-VIEW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-VIEW = "D"
               SET     Dados::Visible            TO    FALSE
               PG-DASH::Show()

               SET     BTN-DASH::BackgroundColor TO    "#3E7BE8"
               SET     BTN-DASH::ForegroundColor TO    "#FFFFFF"
               SET     BTN-DATA::BackgroundColor TO    "#FFFFFF"
               SET     BTN-DATA::ForegroundColor TO    "#1B2A4E"
           ELSE
               PG-DASH::Hide()

               SET     Dados::Visible            TO    TRUE
               SET     BTN-DATA::BackgroundColor TO    "#3E7BE8"
               SET     BTN-DATA::ForegroundColor TO    "#FFFFFF"
               SET     BTN-DASH::BackgroundColor TO    "#FFFFFF"
               SET     BTN-DASH::ForegroundColor TO    "#1B2A4E"

               IF    WS-GSTAGE = 0

                   *> STAGE-START-G: starts the staged entrance of the Dados page.
                   *> Uses:   the clock (ACCEPT ... FROM TIME). Caller's test (not read by
                   *>         STAGE-START-G): WS-GSTAGE = 0, the first visit to Dados.
                   *> Result: WS-T0G = now in ms since midnight; WS-GSTAGE = 1; TMR-STAGE::Enabled =
                   *>         1, so STAGE-TICK starts showing K1-C to K5-C and C-GRID, one every 400
                   *>         ms.

                   CALL    "STAGE-START-G"
               END-IF
           END-IF
]]></Event>
    <Event name="SET-FILT-HEIGHT" paragraph="SET-FILT-HEIGHT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-H1                                  PIC    9(4).
       01 WS-H2                                  PIC    9(4).
       01 WS-Y1                                  PIC    9(4).
       01 WS-FWID                                PIC    9(5).
       01 WS-PW                                  PIC    9(5).
       01 WS-CW                                  PIC    9(5).
       01 WS-CH                                  PIC    9(5).
       01 WS-GX2                                 PIC    9(5).
       01 WS-GY2                                 PIC    9(5).
       01 WS-GX3                                 PIC    9(5).
       01 WS-GY3                                 PIC    9(5).
       01 WS-T                                   PIC    9(5).
       01 WS-FHT                                 PIC    9(5).
       01 WS-PY                                  PIC    9(5).
       01 WS-PH                                  PIC    9(5).
       01 WS-SW                                  PIC    9(5).
       01 WS-KH                                  PIC    9(5).
       01 WS-CY                                  PIC    9(5).
       01 WS-GX                                  PIC    9(5).
       01 WS-GW                                  PIC    9(5).
       01 WS-IW                                  PIC    9(5).

       PROCEDURE DIVISION.
           SET     WS-BP                         TO    me::Breakpoint
           SET     WS-FWID                       TO    me::Width
           SET     WS-FHT                        TO    me::Height

           *> WS-H1 = filter bar height: narrower windows need a taller bar.
           *> WS-H2 = Levels card height. Popup layers are not laid out by the form,
           *> so everything below is positioned by hand from these two.

           EVALUATE    WS-BP
               WHEN "Compact"
                   SET     WS-H1                 TO    332
                   SET     WS-H2                 TO    380
               WHEN "Medium"
                   SET     WS-H2                 TO    196
                   EVALUATE    TRUE
                       WHEN WS-FWID >= 820
                           SET     WS-H1         TO    136
                       WHEN WS-FWID >= 650
                           SET     WS-H1         TO    196
                       WHEN OTHER
                           SET     WS-H1         TO    256
                   END-EVALUATE
               WHEN OTHER
                   SET     WS-H2                 TO    196
                   IF    WS-FWID >= 1360
                       SET     WS-H1             TO    76
                   ELSE
                       SET     WS-H1             TO    136
                   END-IF
           END-EVALUATE
           SET     FILT::Height                  TO    WS-H1

           *> Popups start 8 px under the filter bar: FILT begins at y=108 (24 + 64
           *> + 20) and is WS-H1 tall. WS-PW keeps a 24 px margin on each side.

           COMPUTE    WS-Y1 = 24 + 64 + 20 + WS-H1 + 8
           COMPUTE    WS-PW = WS-FWID - 48

           *> Compact stacks the Level 2 and Level 3 lists; wider layouts put them
           *> side by side. 14 px is the inset from the card and the gap between.

           IF    WS-BP = "Compact"
               COMPUTE    WS-CW = WS-PW - 28
               COMPUTE    WS-CH = (WS-H2 - 28 - 14) / 2

               SET     WS-GX2                    TO    38
               COMPUTE    WS-GY2 = WS-Y1 + 14
               SET     WS-GX3                    TO    38
               COMPUTE    WS-GY3 = WS-Y1 + 14 + WS-CH + 14
           ELSE
               COMPUTE    WS-CW = (WS-PW - 28 - 14) / 2
               COMPUTE    WS-CH = WS-H2 - 28

               SET     WS-GX2                    TO    38

               COMPUTE    WS-GY2 = WS-Y1 + 14
               COMPUTE    WS-GX3 = 38 + WS-CW + 14

               SET     WS-GY3                    TO    WS-GY2
           END-IF

           SET     LV-DROP::X                    TO    24
           SET     LV-DROP::Y                    TO    WS-Y1
           SET     LV-DROP::Width                TO    WS-PW
           SET     LV-DROP::Height               TO    WS-H2
           SET     GRP-N2::X                     TO    WS-GX2
           SET     GRP-N2::Y                     TO    WS-GY2
           SET     GRP-N2::Width                 TO    WS-CW
           SET     GRP-N2::Height                TO    WS-CH
           SET     LBL-F-N2::X                   TO    WS-GX2
           SET     LBL-F-N2::Y                   TO    WS-GY2
           SET     LBL-F-N2::Width               TO    WS-CW
           SET     LST-N2::X                     TO    WS-GX2

           COMPUTE    WS-T = WS-GY2 + 18

           SET     LST-N2::Y                     TO    WS-T
           SET     LST-N2::Width                 TO    WS-CW

           COMPUTE    WS-T = WS-CH - 18

           SET     LST-N2::Height                TO    WS-T
           SET     GRP-N3::X                     TO    WS-GX3
           SET     GRP-N3::Y                     TO    WS-GY3
           SET     GRP-N3::Width                 TO    WS-CW
           SET     GRP-N3::Height                TO    WS-CH
           SET     LBL-F-N3::X                   TO    WS-GX3
           SET     LBL-F-N3::Y                   TO    WS-GY3
           SET     LBL-F-N3::Width               TO    WS-CW
           SET     LST-N3::X                     TO    WS-GX3

           COMPUTE    WS-T = WS-GY3 + 18

           SET     LST-N3::Y                     TO    WS-T
           SET     LST-N3::Width                 TO    WS-CW

           COMPUTE    WS-T = WS-CH - 18
           SET     LST-N3::Height                TO    WS-T
           COMPUTE    WS-T = WS-Y1 + WS-H2

           SET     SCRIM-LV::Y                   TO    WS-T
           SET     SCRIM-LV::Width               TO    WS-FWID
           SET     SM-DROP::X                    TO    24
           SET     SM-DROP::Y                    TO    WS-Y1
           SET     SM-DROP::Width                TO    WS-PW
           SET     LBL-SM-T::X                   TO    46

           COMPUTE    WS-T = WS-Y1 + 10
           SET     LBL-SM-T::Y                   TO    WS-T
           COMPUTE    WS-T = WS-PW - 44

           SET     LBL-SM-T::Width               TO    WS-T
           SET     LST-SM::X                     TO    38

           COMPUTE    WS-T = WS-Y1 + 36
           SET     LST-SM::Y                     TO    WS-T
           COMPUTE    WS-T = WS-PW - 28

           SET     LST-SM::Width                 TO    WS-T
           SET     LBL-SM-INFO::X                TO    46

           COMPUTE    WS-T = WS-Y1 + 258
           SET     LBL-SM-INFO::Y                TO    WS-T
           COMPUTE    WS-T = WS-PW - 44 - 250
           SET     LBL-SM-INFO::Width            TO    WS-T
           COMPUTE    WS-T = WS-PW - 236
           SET     BTN-SM-CLR::X                 TO    WS-T
           COMPUTE    WS-T = WS-Y1 + 258
           SET     BTN-SM-CLR::Y                 TO    WS-T
           COMPUTE    WS-T = WS-PW - 98
           SET     BTN-SM-OK::X                  TO    WS-T
           COMPUTE    WS-T = WS-Y1 + 258
           SET     BTN-SM-OK::Y                  TO    WS-T
           COMPUTE    WS-T = WS-Y1 + 300

           SET     SCRIM-SM::Y                   TO    WS-T
           SET     SCRIM-SM::Width               TO    WS-FWID

           IF    WS-BP = "Expanded"
               SET     PG-DASH::VScroll          TO    0
           ELSE
               SET     PG-DASH::VScroll          TO    1
           END-IF

           COMPUTE    WS-PY = WS-Y1 + 16
           COMPUTE    WS-PH = WS-FHT - WS-Y1 - 48
           COMPUTE    WS-IW = WS-FWID - 56

           *> Five KPI cards share the page height minus four 24 px gaps (96); the
           *> floor of 84 px stops a short window from crushing them.

           COMPUTE    WS-KH = (WS-PH - 96) / 5

           IF    WS-KH < 84
               SET     WS-KH                     TO    84
           END-IF
           *> KPI strip width per breakpoint. 0 (Compact) hides the strip so the
           *> grid takes the whole width; otherwise it starts 24 px after the strip.

           EVALUATE    WS-BP
               WHEN "Compact"
                   SET     WS-SW                 TO    0
               WHEN "Medium"
                   SET     WS-SW                 TO    200
               WHEN OTHER
                   SET     WS-SW                 TO    250
           END-EVALUATE
           IF    WS-SW = 0
               STRIP::Hide()

               SET     WS-GX                     TO    28
               SET     WS-GW                     TO    WS-IW
           ELSE
               STRIP::Show()

               COMPUTE    WS-GX = 28 + WS-SW + 24
               COMPUTE    WS-GW = WS-IW - WS-SW - 24
           END-IF
           SET     PG-DATA::X                    TO    24
           COMPUTE    WS-T = WS-Y1 + 12

           SET     PG-DATA::Y                    TO    WS-T
           SET     PG-DATA::Width                TO    WS-PW

           COMPUTE    WS-T = WS-FHT - WS-Y1 - 36
           SET     PG-DATA::Height               TO    WS-T
           IF    WS-SW > 0
               SET     STRIP::X                  TO    28
               SET     STRIP::Y                  TO    WS-PY
               SET     STRIP::Width              TO    WS-SW
               SET     STRIP::Height             TO    WS-PH

               COMPUTE    WS-CY = WS-PY + 0 * (WS-KH + 24)

               SET     K1-C::X                   TO    28
               SET     K1-C::Y                   TO    WS-CY
               SET     K1-C::Width               TO    WS-SW
               SET     K1-C::Height              TO    WS-KH
               SET     LBL-K1-T::X               TO    48

               COMPUTE    WS-T = WS-CY + 14
               SET     LBL-K1-T::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 60
               SET     LBL-K1-T::Width           TO    WS-T
               COMPUTE    WS-T = WS-SW - 2
               SET     DOT-K1::X                 TO    WS-T
               COMPUTE    WS-T = WS-CY + 17

               SET     DOT-K1::Y                 TO    WS-T
               SET     LBL-K1-V::X               TO    48

               COMPUTE    WS-T = WS-CY + 34
               SET     LBL-K1-V::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36

               SET     LBL-K1-V::Width           TO    WS-T
               SET     LBL-K1-S::X               TO    48

               COMPUTE    WS-T = WS-CY + 74
               SET     LBL-K1-S::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36
               SET     LBL-K1-S::Width           TO    WS-T
               COMPUTE    WS-CY = WS-PY + 1 * (WS-KH + 24)

               SET     K2-C::X                   TO    28
               SET     K2-C::Y                   TO    WS-CY
               SET     K2-C::Width               TO    WS-SW
               SET     K2-C::Height              TO    WS-KH
               SET     LBL-K2-T::X               TO    48

               COMPUTE    WS-T = WS-CY + 14
               SET     LBL-K2-T::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 60
               SET     LBL-K2-T::Width           TO    WS-T
               COMPUTE    WS-T = WS-SW - 2
               SET     DOT-K2::X                 TO    WS-T
               COMPUTE    WS-T = WS-CY + 17

               SET     DOT-K2::Y                 TO    WS-T
               SET     LBL-K2-V::X               TO    48

               COMPUTE    WS-T = WS-CY + 34
               SET     LBL-K2-V::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36

               SET     LBL-K2-V::Width           TO    WS-T
               SET     LBL-K2-S::X               TO    48

               COMPUTE    WS-T = WS-CY + 74
               SET     LBL-K2-S::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36
               SET     LBL-K2-S::Width           TO    WS-T
               COMPUTE    WS-CY = WS-PY + 2 * (WS-KH + 24)

               SET     K3-C::X                   TO    28
               SET     K3-C::Y                   TO    WS-CY
               SET     K3-C::Width               TO    WS-SW
               SET     K3-C::Height              TO    WS-KH
               SET     LBL-K3-T::X               TO    48

               COMPUTE    WS-T = WS-CY + 14
               SET     LBL-K3-T::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 60
               SET     LBL-K3-T::Width           TO    WS-T
               COMPUTE    WS-T = WS-SW - 2
               SET     DOT-K3::X                 TO    WS-T
               COMPUTE    WS-T = WS-CY + 17

               SET     DOT-K3::Y                 TO    WS-T
               SET     LBL-K3-V::X               TO    48

               COMPUTE    WS-T = WS-CY + 34
               SET     LBL-K3-V::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36

               SET     LBL-K3-V::Width           TO    WS-T
               SET     LBL-K3-S::X               TO    48

               COMPUTE    WS-T = WS-CY + 74
               SET     LBL-K3-S::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36
               SET     LBL-K3-S::Width           TO    WS-T
               COMPUTE    WS-CY = WS-PY + 3 * (WS-KH + 24)

               SET     K4-C::X                   TO    28
               SET     K4-C::Y                   TO    WS-CY
               SET     K4-C::Width               TO    WS-SW
               SET     K4-C::Height              TO    WS-KH
               SET     LBL-K4-T::X               TO    48

               COMPUTE    WS-T = WS-CY + 14
               SET     LBL-K4-T::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 60
               SET     LBL-K4-T::Width           TO    WS-T
               COMPUTE    WS-T = WS-SW - 2
               SET     DOT-K4::X                 TO    WS-T
               COMPUTE    WS-T = WS-CY + 17

               SET     DOT-K4::Y                 TO    WS-T
               SET     LBL-K4-V::X               TO    48

               COMPUTE    WS-T = WS-CY + 34
               SET     LBL-K4-V::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36

               SET     LBL-K4-V::Width           TO    WS-T
               SET     LBL-K4-S::X               TO    48

               COMPUTE    WS-T = WS-CY + 74
               SET     LBL-K4-S::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36
               SET     LBL-K4-S::Width           TO    WS-T
               COMPUTE    WS-CY = WS-PY + 4 * (WS-KH + 24)

               SET     K5-C::X                   TO    28
               SET     K5-C::Y                   TO    WS-CY
               SET     K5-C::Width               TO    WS-SW
               SET     K5-C::Height              TO    WS-KH
               SET     LBL-K5-T::X               TO    48

               COMPUTE    WS-T = WS-CY + 14
               SET     LBL-K5-T::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 60
               SET     LBL-K5-T::Width           TO    WS-T
               COMPUTE    WS-T = WS-SW - 2
               SET     DOT-K5::X                 TO    WS-T
               COMPUTE    WS-T = WS-CY + 17

               SET     DOT-K5::Y                 TO    WS-T
               SET     LBL-K5-V::X               TO    48

               COMPUTE    WS-T = WS-CY + 34
               SET     LBL-K5-V::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36

               SET     LBL-K5-V::Width           TO    WS-T
               SET     LBL-K5-S::X               TO    48

               COMPUTE    WS-T = WS-CY + 74
               SET     LBL-K5-S::Y               TO    WS-T
               COMPUTE    WS-T = WS-SW - 36
               SET     LBL-K5-S::Width           TO    WS-T
           END-IF

           SET     C-GRID::X                     TO    WS-GX
           SET     C-GRID::Y                     TO    WS-PY
           SET     C-GRID::Width                 TO    WS-GW
           SET     C-GRID::Height                TO    WS-PH

           COMPUTE    WS-T = WS-GX + 22
           SET     LBL-GRID-T::X                 TO    WS-T
           COMPUTE    WS-T = WS-PY + 12
           SET     LBL-GRID-T::Y                 TO    WS-T
           *> Subtitle narrows with the card to stay clear of the order ComboBox at
           *> the right edge, but never below 120 px (GW - 590 = 120 at GW = 710).

           IF    WS-GW > 710
               COMPUTE    WS-T = WS-GW - 590
           ELSE
               SET     WS-T                      TO    120
           END-IF
           SET     LBL-GRID-S::Width             TO    WS-T
           COMPUTE    WS-T = WS-GX + 22
           SET     LBL-GRID-S::X                 TO    WS-T
           COMPUTE    WS-T = WS-PY + 40
           SET     LBL-GRID-S::Y                 TO    WS-T
           COMPUTE    WS-T = WS-GX + WS-GW - 288
           SET     CMB-ORDER::X                  TO    WS-T
           COMPUTE    WS-T = WS-PY + 16
           SET     CMB-ORDER::Y                  TO    WS-T
           *> Grid sits 66 px below the card top and ends 56 px above its bottom,
           *> leaving the Prev / page / Next row free.

           COMPUTE    WS-T = WS-GX + 12
           SET     GRD-FUNDOS::X                 TO    WS-T
           COMPUTE    WS-T = WS-PY + 66
           SET     GRD-FUNDOS::Y                 TO    WS-T
           COMPUTE    WS-T = WS-GW - 24
           SET     GRD-FUNDOS::Width             TO    WS-T
           COMPUTE    WS-T = WS-PH - 122
           SET     GRD-FUNDOS::Height            TO    WS-T
           COMPUTE    WS-T = WS-GX + 24
           SET     BTN-PREV::X                   TO    WS-T
           COMPUTE    WS-T = WS-PY + WS-PH - 46
           SET     BTN-PREV::Y                   TO    WS-T
           *> LBL-PAGE is 220 wide: the 110 centers it in the card, between the
           *> Prev and Next buttons.

           COMPUTE    WS-T = WS-GX + WS-GW / 2 - 110
           SET     LBL-PAGE::X                   TO    WS-T
           COMPUTE    WS-T = WS-PY + WS-PH - 44
           SET     LBL-PAGE::Y                   TO    WS-T
           COMPUTE    WS-T = WS-GX + WS-GW - 144
           SET     BTN-NEXT::X                   TO    WS-T
           COMPUTE    WS-T = WS-PY + WS-PH - 46
           SET     BTN-NEXT::Y                   TO    WS-T
]]></Event>
    <Event name="CLOSE-LEVELS" paragraph="CLOSE-LEVELS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-LEVELS-OPEN = 1
               SET     WS-LEVELS-OPEN            TO    0
               SET     POPUP-LEVELS::Visible     TO    FALSE
               SET     BTN-LEVELS::Caption       TO    "Níveis 2 e 3"
           END-IF
]]></Event>
    <Event name="CLEAR-FILTERS" paragraph="CLEAR-FILTERS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLOSE: closes the search dropdown when one is open.
           *> Uses:   WS-SM ("N" or "C" while a dropdown is open, SPACE otherwise).
           *> Result: Only when WS-SM was not SPACE: WS-SM = SPACE and POPUP-SEARCH::Visible =
           *>         FALSE. Otherwise nothing changes.

           CALL    "SM-CLOSE"

           SET     TXT-NOME::Text                TO    SPACES
           SET     TXT-CAT::Text                 TO    SPACES

           *> SM-TYPED skips a term equal to WS-LAST-N/C; reset them with the text
           *> boxes so the next typing is not ignored.

           SET     WS-LAST-N                     TO    SPACES
           SET     WS-LAST-C                     TO    SPACES

           *> Dates and PL range go back to the controls' own limits (1970 to 2027,
           *> 0 to 300000), so the range filters exclude nothing.

           SET     DTP-INI::Value                TO    "1970-01-01"
           SET     DTP-FIM::Value                TO    "2027-12-31"
           SET     NUD-PL1::Value                TO    0
           SET     NUD-PL2::Value                TO    300000
           SET     LST-N2::CheckedItems          TO    SPACES
           SET     LST-N3::CheckedItems          TO    SPACES

           *> SM-RESET: forgets every pick of both dropdowns.
           *> Uses:   tables pick and vis, WS-ALL-N and WS-ALL-C.
           *> Result: pick and vis emptied; WS-ALL-N = 0; WS-ALL-C = 0; SM-CAPTIONS then puts
           *>         LBL-F-NOME::Caption back to "Nome comercial" and LBL-F-CAT::Caption to
           *>         "Categoria".

           CALL    "SM-RESET"

           *> APPLY-FILTERS: re-runs every query and repaints the dashboard, the charts and the grid
           *> for the current filters; it exits at once while WS-LOADED = 0.
           *> Uses:   the controls cleared above (TXT-NOME and TXT-CAT empty, dates 1970-01-01 to
           *>         2027-12-31, PL 0 to 300000, LST-N2 and LST-N3 unticked), the empty pick table
           *>         and the Todos flags WS-ALL-N / WS-ALL-C (0, reset by SM-RESET).
           *> Result: WS-PAGE = 1; FLT-REQ = no condition (nothing filtered); the Q-* steps
           *>         recompute the totals (WS-T-*), WS-CAT-*, WS-RANK, WS-N2-*, WS-BIN-CNT,
           *>         WS-TOP-* and the year tables; the PAINT-* steps repaint the KPI card, the
           *>         charts, the top-4 list with the Classe / Subclasse bars, the Dados cards and
           *>         the metric buttons; GRD-FUNDOS shows page 1, with its caption LBL-GRID-S, the
           *>         page label LBL-PAGE and BTN-PREV / BTN-NEXT enabled to match.

           CALL    "APPLY-FILTERS"
]]></Event>
    <Event name="STAGE-TICK" paragraph="STAGE-TICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TIME                                PIC    9(8).
       01 WS-NOW                                 PIC    9(9).

       PROCEDURE DIVISION.
           *> Elapsed ms since WS-T0: ACCEPT gives HHMMSSCC, converted to ms since
           *> midnight (CC is hundredths of a second). If the clock passed midnight
           *> since T0, NOW is smaller, so add a full day (86400000 ms).

           ACCEPT    WS-TIME FROM TIME
           COMPUTE    WS-NOW = (WS-TIME(1:2) * 3600 + WS-TIME(3:2) * 60 + WS-TIME(5:2)) * 1000 + WS-TIME(7:2) * 10
           IF    WS-NOW >= WS-T0
               COMPUTE    WS-ELAPSED = WS-NOW - WS-T0
           ELSE
               COMPUTE    WS-ELAPSED = WS-NOW + 86400000 - WS-T0
           END-IF
           *> Staged entrance: panel N appears 400 ms after panel N-1. WS-DSTAGE is
           *> the next panel due; ADD 1 makes each step fire only once.

           IF    WS-DSTAGE = 1 AND WS-ELAPSED >= 0

               *> SHOW-C-KPI: shows the card C-KPI ("PL total filtrado") and plays the "intro"
               *> animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 1 and WS-ELAPSED >= 0 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-KPI becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-KPI-T, LBL-KPI-V, GAU-UNIV,
               *>         LBL-KPI-GC, LBL-KPI-C, SPK and LBL-KPI-F. SPK stays hidden until
               *>         STAGE-TICK shows all the charts. No data item changes; STAGE-TICK adds 1
               *>         to WS-DSTAGE next.

               CALL    "SHOW-C-KPI"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 2 AND WS-ELAPSED >= 400

               *> SHOW-C-BAR: shows the card C-BAR ("Fundos criados por ano") and plays the "intro"
               *> animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 2 and WS-ELAPSED >= 400 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-BAR becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-BAR-T, LBL-BAR-TOT, LBL-BAR-U,
               *>         BTN-M1, BTN-M2, BTN-M3 and CH-BAR. CH-BAR stays hidden until STAGE-TICK
               *>         shows all the charts. No data item changes; STAGE-TICK adds 1 to WS-DSTAGE
               *>         next.

               CALL    "SHOW-C-BAR"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 3 AND WS-ELAPSED >= 800

               *> SHOW-C-RADAR: shows the card C-RADAR ("Estrutura") and plays the "intro" animation
               *> on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 3 and WS-ELAPSED >= 800 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-RADAR becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-RAD-T, LBL-RAD-S and CH-RADAR.
               *>         CH-RADAR stays hidden until STAGE-TICK shows all the charts. No data item
               *>         changes; STAGE-TICK adds 1 to WS-DSTAGE next.

               CALL    "SHOW-C-RADAR"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 4 AND WS-ELAPSED >= 1200

               *> SHOW-C-GOALS: shows the card C-GOALS ("Maiores fundos (PL)") and plays the "intro"
               *> animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 4 and WS-ELAPSED >= 1200 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-GOALS becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-GOAL-T and, for n = 1 to 4,
               *>         LBL-TOPn-N, LBL-TOPn-V, TRK-PRG-TOPn and PRG-TOPn. No data item changes;
               *>         STAGE-TICK adds 1 to WS-DSTAGE next.

               CALL    "SHOW-C-GOALS"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 5 AND WS-ELAPSED >= 1600

               *> SHOW-C-DONUT1: shows the card C-DONUT1 ("PL por categoria") and plays the "intro"
               *> animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 5 and WS-ELAPSED >= 1600 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-DONUT1 becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-D1-T, CH-DONUT1, LBL-D1-C,
               *>         LBL-D1-S, LBL-CLS-N, TRK-PRG-CLS, PRG-CLS, LBL-CLS-P, LBL-SUB-N,
               *>         TRK-PRG-SUB, PRG-SUB, LBL-SUB-P, BOX-AVG, LBL-AVG-V, LBL-AVG-C and, for n
               *>         = 1 to 4, SHP-L1-n, LBL-L1-n-N, LBL-L1-n-P and LBL-L1-n-V. CH-DONUT1 stays
               *>         hidden until STAGE-TICK shows all the charts. No data item changes;
               *>         STAGE-TICK adds 1 to WS-DSTAGE next.

               CALL    "SHOW-C-DONUT1"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 6 AND WS-ELAPSED >= 2000

               *> SHOW-C-DONUT2: shows the card C-DONUT2 ("Fundos por nível 2") and plays the
               *> "intro" animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 6 and WS-ELAPSED >= 2000 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-DONUT2 becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-D2-T, CH-DONUT2, LBL-D2-C,
               *>         LBL-D2-S and, for n = 1 to 6, SHP-L2-n, LBL-L2-n-N, LBL-L2-n-P and
               *>         LBL-L2-n-V. CH-DONUT2 stays hidden until STAGE-TICK shows all the charts.
               *>         No data item changes; STAGE-TICK adds 1 to WS-DSTAGE next.

               CALL    "SHOW-C-DONUT2"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 7 AND WS-ELAPSED >= 2400

               *> SHOW-C-LINE: shows the card C-LINE ("Evolução por ano de início") and plays the
               *> "intro" animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 7 and WS-ELAPSED >= 2400 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-LINE becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-LIN-T, LBL-LIN-U, LBL-ACUM,
               *>         SW-ACUM and CH-LINE. CH-LINE stays hidden until STAGE-TICK shows all the
               *>         charts. No data item changes; STAGE-TICK adds 1 to WS-DSTAGE next.

               CALL    "SHOW-C-LINE"
               ADD    1 TO WS-DSTAGE
           END-IF
           IF    WS-DSTAGE = 8 AND WS-ELAPSED >= 2800

               *> SHOW-C-BINS: shows the card C-BINS ("Faixas de PL") and plays the "intro"
               *> animation on it and on the controls inside it.
               *> Uses:   no data item; it only drives controls. Caller's test (not read here):
               *>         WS-DSTAGE = 8 and WS-ELAPSED >= 2800 ms (WS-ELAPSED = ms since WS-T0, the
               *>         start of the dashboard entrance).
               *> Result: C-BINS becomes visible; it and these controls run their programmatic
               *>         "intro" animation (ZoomOut, 1800 ms): LBL-BIN-T and, for n = 1 to 5,
               *>         LBL-BINn-N, LBL-BINn-V, TRK-PRG-BINn and PRG-BINn. No data item changes;
               *>         STAGE-TICK adds 1 to WS-DSTAGE next.

               CALL    "SHOW-C-BINS"
               ADD    1 TO WS-DSTAGE
           END-IF
           *> Charts stay hidden until the last panel (due at 2800 ms, 1800 ms
           *> animation) has finished entering, then all show together, once.

           IF    WS-CHARTS = 0 AND WS-DSTAGE > 8 AND WS-ELAPSED >= 4750
               SPK::Show()
               CH-BAR::Show()
               CH-RADAR::Show()
               CH-DONUT1::Show()
               CH-DONUT2::Show()
               CH-LINE::Show()

               SET     WS-CHARTS                 TO    1
           END-IF
           *> Dados page has its own sequence and clock (WS-T0G), started when the
           *> page is first shown. It reuses WS-ELAPSED, so it must stay after the
           *> dashboard steps above.

           IF    WS-GSTAGE >= 1 AND WS-GSTAGE <= 6
               IF    WS-NOW >= WS-T0G
                   COMPUTE    WS-ELAPSED = WS-NOW - WS-T0G
               ELSE
                   COMPUTE    WS-ELAPSED = WS-NOW + 86400000 - WS-T0G
               END-IF
               IF    WS-GSTAGE = 1 AND WS-ELAPSED >= 0

                   *> SHOW-K1-C: shows the Dados KPI card K1-C ("FUNDOS") and plays the "intro"
                   *> animation on it and on its controls.
                   *> Uses:   no data item; it only drives controls. Caller's test (not read here):
                   *>         WS-GSTAGE = 1 and WS-ELAPSED >= 0 ms (WS-ELAPSED = ms since WS-T0G,
                   *>         the start of the Dados entrance).
                   *> Result: K1-C becomes visible; it and LBL-K1-T, DOT-K1, LBL-K1-V and LBL-K1-S
                   *>         run their programmatic "intro" animation (ZoomOut, 1800 ms). No data
                   *>         item changes; STAGE-TICK adds 1 to WS-GSTAGE next.

                   CALL    "SHOW-K1-C"
                   ADD    1 TO WS-GSTAGE
               END-IF
               IF    WS-GSTAGE = 2 AND WS-ELAPSED >= 400

                   *> SHOW-K2-C: shows the Dados KPI card K2-C ("PL TOTAL") and plays the "intro"
                   *> animation on it and on its controls.
                   *> Uses:   no data item; it only drives controls. Caller's test (not read here):
                   *>         WS-GSTAGE = 2 and WS-ELAPSED >= 400 ms (WS-ELAPSED = ms since WS-T0G,
                   *>         the start of the Dados entrance).
                   *> Result: K2-C becomes visible; it and LBL-K2-T, DOT-K2, LBL-K2-V and LBL-K2-S
                   *>         run their programmatic "intro" animation (ZoomOut, 1800 ms). No data
                   *>         item changes; STAGE-TICK adds 1 to WS-GSTAGE next.

                   CALL    "SHOW-K2-C"
                   ADD    1 TO WS-GSTAGE
               END-IF
               IF    WS-GSTAGE = 3 AND WS-ELAPSED >= 800

                   *> SHOW-K3-C: shows the Dados KPI card K3-C ("COTISTAS") and plays the "intro"
                   *> animation on it and on its controls.
                   *> Uses:   no data item; it only drives controls. Caller's test (not read here):
                   *>         WS-GSTAGE = 3 and WS-ELAPSED >= 800 ms (WS-ELAPSED = ms since WS-T0G,
                   *>         the start of the Dados entrance).
                   *> Result: K3-C becomes visible; it and LBL-K3-T, DOT-K3, LBL-K3-V and LBL-K3-S
                   *>         run their programmatic "intro" animation (ZoomOut, 1800 ms). No data
                   *>         item changes; STAGE-TICK adds 1 to WS-GSTAGE next.

                   CALL    "SHOW-K3-C"
                   ADD    1 TO WS-GSTAGE
               END-IF
               IF    WS-GSTAGE = 4 AND WS-ELAPSED >= 1200

                   *> SHOW-K4-C: shows the Dados KPI card K4-C ("MAIOR FUNDO") and plays the "intro"
                   *> animation on it and on its controls.
                   *> Uses:   no data item; it only drives controls. Caller's test (not read here):
                   *>         WS-GSTAGE = 4 and WS-ELAPSED >= 1200 ms (WS-ELAPSED = ms since WS-T0G,
                   *>         the start of the Dados entrance).
                   *> Result: K4-C becomes visible; it and LBL-K4-T, DOT-K4, LBL-K4-V and LBL-K4-S
                   *>         run their programmatic "intro" animation (ZoomOut, 1800 ms). No data
                   *>         item changes; STAGE-TICK adds 1 to WS-GSTAGE next.

                   CALL    "SHOW-K4-C"
                   ADD    1 TO WS-GSTAGE
               END-IF
               IF    WS-GSTAGE = 5 AND WS-ELAPSED >= 1600

                   *> SHOW-K5-C: shows the Dados KPI card K5-C ("CATEGORIA LÍDER") and plays the
                   *> "intro" animation on it and on its controls.
                   *> Uses:   no data item; it only drives controls. Caller's test (not read here):
                   *>         WS-GSTAGE = 5 and WS-ELAPSED >= 1600 ms (WS-ELAPSED = ms since WS-T0G,
                   *>         the start of the Dados entrance).
                   *> Result: K5-C becomes visible; it and LBL-K5-T, DOT-K5, LBL-K5-V and LBL-K5-S
                   *>         run their programmatic "intro" animation (ZoomOut, 1800 ms). No data
                   *>         item changes; STAGE-TICK adds 1 to WS-GSTAGE next.

                   CALL    "SHOW-K5-C"
                   ADD    1 TO WS-GSTAGE
               END-IF
               IF    WS-GSTAGE = 6 AND WS-ELAPSED >= 2000

                   *> SHOW-C-GRID: shows the grid card C-GRID ("Fundos de investimento") and plays
                   *> the "intro" animation on it and on its controls.
                   *> Uses:   no data item; it only drives controls. Caller's test (not read here):
                   *>         WS-GSTAGE = 6 and WS-ELAPSED >= 2000 ms (WS-ELAPSED = ms since WS-T0G,
                   *>         the start of the Dados entrance).
                   *> Result: C-GRID becomes visible; it and LBL-GRID-T, LBL-GRID-S, CMB-ORDER,
                   *>         GRD-FUNDOS, BTN-PREV, LBL-PAGE and BTN-NEXT run their programmatic
                   *>         "intro" animation (ZoomOut, 1800 ms). No data item changes; STAGE-TICK
                   *>         adds 1 to WS-GSTAGE next.

                   CALL    "SHOW-C-GRID"
                   ADD    1 TO WS-GSTAGE
               END-IF
           END-IF
           *> Stop the timer when nothing is pending. WS-GSTAGE = 0 (Dados not yet
           *> opened) counts as done; STAGE-START-G enables the timer again later.

           IF    WS-DSTAGE > 8 AND WS-CHARTS = 1 AND (WS-GSTAGE = 0 OR WS-GSTAGE > 6)
               SET     TMR-STAGE::Enabled        TO    0
           END-IF
]]></Event>
    <Event name="STAGE-START" paragraph="STAGE-START"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TIME                                PIC    9(8).

       PROCEDURE DIVISION.
           ACCEPT    WS-TIME FROM TIME
           *> Start of the dashboard entrance: now in ms since midnight, the unit
           *> STAGE-TICK subtracts from. HHMMSSCC: the last two digits are 1/100 s.

           COMPUTE    WS-T0 = (WS-TIME(1:2) * 3600 + WS-TIME(3:2) * 60 + WS-TIME(5:2)) * 1000 + WS-TIME(7:2) * 10

           SET     WS-DSTAGE                     TO    1
           SET     TMR-STAGE::Enabled            TO    1
]]></Event>
    <Event name="STAGE-START-G" paragraph="STAGE-START-G"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TIME                                PIC    9(8).

       PROCEDURE DIVISION.
           ACCEPT    WS-TIME FROM TIME
           *> Same ms-since-midnight clock for the Dados entrance, kept in its own
           *> WS-T0G so Dados runs a sequence independent of the dashboard one.

           COMPUTE    WS-T0G = (WS-TIME(1:2) * 3600 + WS-TIME(3:2) * 60 + WS-TIME(5:2)) * 1000 + WS-TIME(7:2) * 10

           SET     WS-GSTAGE                     TO    1
           SET     TMR-STAGE::Enabled            TO    1
]]></Event>
    <Event name="FLT-SAVE" paragraph="FLT-SAVE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    9(3).

       PROCEDURE DIVISION.
           *> FLS-REQ = FLT-REQ, member by member (FLT-REQ's tables vary in length).

           SET     FLS-NAME-TERM                 TO    FLT-NAME-TERM
           SET     FLS-NAME-N                    TO    FLT-NAME-N
           SET     FLS-NAME-FLAGS                TO    FLT-NAME-FLAGS
           SET     FLS-CAT-TERM                  TO    FLT-CAT-TERM
           SET     FLS-CAT-N                     TO    FLT-CAT-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FLT-CAT-N
               SET     FLS-CAT-PICK(WS-I)        TO    FLT-CAT-PICK(WS-I)
           END-PERFORM
           SET     FLS-DATE-FROM                 TO    FLT-DATE-FROM
           SET     FLS-DATE-TO                   TO    FLT-DATE-TO
           SET     FLS-PL-FROM                   TO    FLT-PL-FROM
           SET     FLS-PL-TO                     TO    FLT-PL-TO
           SET     FLS-N2-N                      TO    FLT-N2-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FLT-N2-N
               SET     FLS-N2-PICK(WS-I)         TO    FLT-N2-PICK(WS-I)
           END-PERFORM
           SET     FLS-N3-N                      TO    FLT-N3-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FLT-N3-N
               SET     FLS-N3-PICK(WS-I)         TO    FLT-N3-PICK(WS-I)
           END-PERFORM
]]></Event>
    <Event name="FLT-RESTORE" paragraph="FLT-RESTORE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    9(3).

       PROCEDURE DIVISION.
           *> FLT-REQ = FLS-REQ, member by member: each count is set before its table is filled.

           SET     FLT-NAME-TERM                 TO    FLS-NAME-TERM
           SET     FLT-NAME-N                    TO    FLS-NAME-N
           SET     FLT-NAME-FLAGS                TO    FLS-NAME-FLAGS
           SET     FLT-CAT-TERM                  TO    FLS-CAT-TERM
           SET     FLT-CAT-N                     TO    FLS-CAT-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FLS-CAT-N
               SET     FLT-CAT-PICK(WS-I)        TO    FLS-CAT-PICK(WS-I)
           END-PERFORM
           SET     FLT-DATE-FROM                 TO    FLS-DATE-FROM
           SET     FLT-DATE-TO                   TO    FLS-DATE-TO
           SET     FLT-PL-FROM                   TO    FLS-PL-FROM
           SET     FLT-PL-TO                     TO    FLS-PL-TO
           SET     FLT-N2-N                      TO    FLS-N2-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FLS-N2-N
               SET     FLT-N2-PICK(WS-I)         TO    FLS-N2-PICK(WS-I)
           END-PERFORM
           SET     FLT-N3-N                      TO    FLS-N3-N
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FLS-N3-N
               SET     FLT-N3-PICK(WS-I)         TO    FLS-N3-PICK(WS-I)
           END-PERFORM
]]></Event>
    <Event name="BACKEND-FAIL" paragraph="BACKEND-FAIL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(240).

       PROCEDURE DIVISION.
           *> A Backend call failed or answered a status other than OK. The desktop has no
           *> such case (its database is in the program), so the web form says it in the
           *> header line instead of painting zeros silently.

           *> The message stays while calls fail; BE-FLOW-END puts the desktop's line back once
           *> a flow of calls (Apply, a page of the grid, a search list) runs without a failure.

           ADD    1 TO WS-BE-FAILS
           SET     WS-BE-SHOWN                   TO    1
           SET     WS-TXT                        TO    SPACES
           STRING    "Backend " BE-PROG::Trim() ": " BE-STATUS::Trim() " " BE-MSG::Trim()
               INTO WS-TXT
           SET     LBL-STATUS::Caption           TO    WS-TXT
]]></Event>
    <Event name="BE-FLOW-BEGIN" paragraph="BE-FLOW-BEGIN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> A flow of Backend calls starts (APPLY-FILTERS, REFRESH-GRID, SM-REFRESH). The
           *> outermost one notes how many calls had failed so far.

           IF    WS-BE-DEPTH = 0
               SET     WS-BE-MARK                TO    WS-BE-FAILS
           END-IF
           ADD    1 TO WS-BE-DEPTH
]]></Event>
    <Event name="BE-FLOW-END" paragraph="BE-FLOW-END"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> A flow of Backend calls ends. When the outermost one ran without a failed call and
           *> the header shows a Backend error, the header gets back the line the desktop's flow
           *> wrote (WS-STATUS-TXT): on the desktop that line never changes after start-up.
           *> No line was ever written (start-up's FUND-INIT failed): the error stays, never a
           *> blank header.

           IF    WS-BE-DEPTH > 0
               SUBTRACT    1 FROM WS-BE-DEPTH
           END-IF
           IF    WS-BE-DEPTH = 0 AND WS-BE-FAILS = WS-BE-MARK AND WS-BE-SHOWN = 1
                 AND WS-STATUS-TXT NOT = SPACES
               SET     WS-BE-SHOWN               TO    0
               SET     LBL-STATUS::Caption       TO    WS-STATUS-TXT
           END-IF
]]></Event>
    <Event name="TERM-CUT" paragraph="TERM-CUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-CUT-K                               PIC    99.
      *> One byte of the text read as a number (0 to 255): WS-CUT-LO under a zero high byte.
      *> A literal cannot spell the byte: X"80" is the CHARACTER U+0080, two bytes in UTF-8.
       01 WS-CUT-BYTE.
           05 WS-CUT-HI                          PIC    X    VALUE LOW-VALUE.
           05 WS-CUT-LO                          PIC    X.
       01 WS-CUT-CODE                            REDEFINES    WS-CUT-BYTE    PIC 9(4)    BINARY.

       PROCEDURE DIVISION.
           *> The desktop keeps the first 80 BYTES of a typed text (WS-TERM, PIC X(80)), also when
           *> the 80th byte falls inside a letter: then its search finds nothing. A request must be
           *> UTF-8, so the form sends the 80 bytes plus the bytes 81 to 83 that continue that
           *> letter (UTF-8 continuation bytes, 128 to 191); the Backend cuts the text to 80
           *> bytes again, the desktop's cut, in the same runtime.

           SET     WS-CUT-OUT                    TO    SPACES
           SET     WS-CUT-K                      TO    80
           PERFORM    UNTIL WS-CUT-K >= 83
               SET     WS-CUT-HI                 TO    LOW-VALUE
               SET     WS-CUT-LO                 TO    WS-CUT-IN(WS-CUT-K + 1:1)
               IF    WS-CUT-CODE < 128 OR WS-CUT-CODE > 191
                   EXIT PERFORM
               END-IF
               ADD    1 TO WS-CUT-K
           END-PERFORM
           SET     WS-CUT-OUT                    TO    WS-CUT-IN(1:WS-CUT-K)
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="MAIN-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> INIT-DB: asks the Backend program FUND-INIT for the start-up facts of the database.
           *> Uses:   nothing of the form; the Backend builds data/fundos.db from data/fundos.sql
           *>         on its first call ever.
           *> Result: INI-RES = the universe, the reference date, the ten category slots and the
           *>         level 2 / level 3 names; WS-LOADED = 1. If the Backend has no database
           *>         (NOFILE): LBL-STATUS::Caption = "Base de dados não encontrada
           *>         (data/fundos.sql)"; if the call fails, BACKEND-FAIL says so in LBL-STATUS;
           *>         either way WS-LOADED stays 0.

           CALL    "INIT-DB"

           *> LOAD-DIMS: reads the fixed dimensions of the data once the database exists.
           *> Uses:   INI-RES, just answered by FUND-INIT (nothing is done while WS-LOADED = 0).
           *> Result: WS-UNIV = number of funds; LBL-STATUS::Caption = "Base ANBIMA  |  referência
           *>         <newest data_ref as dd/mm/yyyy>  |  N fundo(s)"; LST-N2 and LST-N3 = every
           *>         distinct nivel2 / nivel3 name, most funds first; WS-CAT-NAME(1..10) = the ten
           *>         most populated nivel1 categories (held in 24 characters) and WS-CATCNT = how
           *>         many.

           CALL    "LOAD-DIMS"

           GRD-FUNDOS::SetColumnWidth(1, 330)
           GRD-FUNDOS::SetColumnWidth(2, 110)
           GRD-FUNDOS::SetColumnWidth(3, 90)
           GRD-FUNDOS::SetColumnWidth(4, 120)
           GRD-FUNDOS::SetColumnWidth(5, 170)
           GRD-FUNDOS::SetColumnWidth(6, 170)
           GRD-FUNDOS::SetColumnWidth(7, 92)
           GRD-FUNDOS::SetColumnWidth(8, 120)
           GRD-FUNDOS::SetColumnWidth(9, 90)
           GRD-FUNDOS::SetColumnWidth(10, 110)
           GRD-FUNDOS::SetColumnWidth(11, 190)
           GRD-FUNDOS::SetColumnWidth(12, 130)
           GRD-FUNDOS::SetColumnWidth(13, 130)
           GRD-FUNDOS::SetColumnWidth(14, 70)
           GRD-FUNDOS::SetColumnWidth(15, 90)
           GRD-FUNDOS::SetColumnWidth(16, 130)

           *> SET-FILT-HEIGHT: lays the window out for its current size: filter bar height, popup
           *> cards, KPI strip, Dados page and grid.
           *> Uses:   me::Breakpoint, me::Width and me::Height; no data item is read (WS-LEVELS-OPEN
           *>         in particular is not: the Levels card is always placed). This is the first
           *>         layout, done before the first filter run.
           *> Result: the layout is computed for the opening size: FILT::Height (76 to 332 px by
           *>         breakpoint and width); position and size of the Levels card (LV-DROP, GRP-N2,
           *>         LBL-F-N2, LST-N2, GRP-N3, LBL-F-N3, LST-N3, SCRIM-LV) and of the search card
           *>         (SM-DROP, LBL-SM-T, LST-SM, LBL-SM-INFO, BTN-SM-CLR, BTN-SM-OK, SCRIM-SM),
           *>         each only in the properties it needs (SM-DROP and LST-SM keep their designed
           *>         Height); PG-DASH::VScroll (0 in Expanded, else 1); STRIP hidden in Compact,
           *>         else shown with the cards K1-C to K5-C, their labels and the dots DOT-K1 to
           *>         DOT-K5; PG-DATA, C-GRID, LBL-GRID-T, LBL-GRID-S, CMB-ORDER, GRD-FUNDOS,
           *>         BTN-PREV, LBL-PAGE and BTN-NEXT. Work items overwritten: WS-BP (holds
           *>         me::Breakpoint).

           CALL    "SET-FILT-HEIGHT"

           *> APPLY-FILTERS: re-runs every query and repaints the dashboard, the charts and the grid
           *> for the current filters; it exits at once while WS-LOADED = 0.
           *> Uses:   WS-LOADED = 1 when INIT-DB succeeded (otherwise this call exits at once); the
           *>         controls at their design values: no text, dates 1970-01-01 to 2027-12-31, PL 0
           *>         to 300000, no ticks, no picks and the Todos flags WS-ALL-N / WS-ALL-C = 0.
           *> Result: WS-PAGE = 1; FLT-REQ = no condition (nothing filtered); the Q-* steps
           *>         recompute the totals (WS-T-*), WS-CAT-*, WS-RANK, WS-N2-*, WS-BIN-CNT,
           *>         WS-TOP-* and the year tables; the PAINT-* steps repaint the KPI card, the
           *>         charts, the top-4 list with the Classe / Subclasse bars, the Dados cards and
           *>         the metric buttons; GRD-FUNDOS shows page 1, with its caption LBL-GRID-S, the
           *>         page label LBL-PAGE and BTN-PREV / BTN-NEXT enabled to match.

           CALL    "APPLY-FILTERS"

           *> STAGE-START: starts the staged entrance of the dashboard cards.
           *> Uses:   the clock (ACCEPT ... FROM TIME).
           *> Result: WS-T0 = now in ms since midnight; WS-DSTAGE = 1; TMR-STAGE::Enabled = 1, so
           *>         STAGE-TICK shows C-KPI at once and then one card every 400 ms.

           CALL    "STAGE-START"
]]></Event>
    <Event name="onClose" paragraph="MAIN-FORM--ONCLOSE">
    </Event>
    <Event name="onBreakpointChanged" paragraph="MAIN-FORM--ONBREAKPOINTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SET-FILT-HEIGHT: lays the window out for its current size: filter bar height, popup
           *> cards, KPI strip, Dados page and grid.
           *> Uses:   me::Breakpoint, me::Width and me::Height; no data item is read (WS-LEVELS-OPEN
           *>         in particular is not: the Levels card is always placed). me::Breakpoint has
           *>         just changed (Compact, Medium or Expanded).
           *> Result: the layout is computed for the new breakpoint: FILT::Height (76 to 332 px by
           *>         breakpoint and width); position and size of the Levels card (LV-DROP, GRP-N2,
           *>         LBL-F-N2, LST-N2, GRP-N3, LBL-F-N3, LST-N3, SCRIM-LV) and of the search card
           *>         (SM-DROP, LBL-SM-T, LST-SM, LBL-SM-INFO, BTN-SM-CLR, BTN-SM-OK, SCRIM-SM),
           *>         each only in the properties it needs (SM-DROP and LST-SM keep their designed
           *>         Height); PG-DASH::VScroll (0 in Expanded, else 1); STRIP hidden in Compact,
           *>         else shown with the cards K1-C to K5-C, their labels and the dots DOT-K1 to
           *>         DOT-K5; PG-DATA, C-GRID, LBL-GRID-T, LBL-GRID-S, CMB-ORDER, GRD-FUNDOS,
           *>         BTN-PREV, LBL-PAGE and BTN-NEXT. Work items overwritten: WS-BP (holds
           *>         me::Breakpoint).

           CALL    "SET-FILT-HEIGHT"
]]></Event>
    <Event name="onResize" paragraph="MAIN-FORM--ONRESIZE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SET-FILT-HEIGHT: lays the window out for its current size: filter bar height, popup
           *> cards, KPI strip, Dados page and grid.
           *> Uses:   me::Breakpoint, me::Width and me::Height; no data item is read (WS-LEVELS-OPEN
           *>         in particular is not: the Levels card is always placed). The window size has
           *>         just changed.
           *> Result: the layout is computed for the new size: FILT::Height (76 to 332 px by
           *>         breakpoint and width); position and size of the Levels card (LV-DROP, GRP-N2,
           *>         LBL-F-N2, LST-N2, GRP-N3, LBL-F-N3, LST-N3, SCRIM-LV) and of the search card
           *>         (SM-DROP, LBL-SM-T, LST-SM, LBL-SM-INFO, BTN-SM-CLR, BTN-SM-OK, SCRIM-SM),
           *>         each only in the properties it needs (SM-DROP and LST-SM keep their designed
           *>         Height); PG-DASH::VScroll (0 in Expanded, else 1); STRIP hidden in Compact,
           *>         else shown with the cards K1-C to K5-C, their labels and the dots DOT-K1 to
           *>         DOT-K5; PG-DATA, C-GRID, LBL-GRID-T, LBL-GRID-S, CMB-ORDER, GRD-FUNDOS,
           *>         BTN-PREV, LBL-PAGE and BTN-NEXT. Work items overwritten: WS-BP (holds
           *>         me::Breakpoint).

           CALL    "SET-FILT-HEIGHT"
]]></Event>
  </form-events>
