<?xml version="1.0" encoding="UTF-8"?>
<Form name="WAR-FORM" title="PowerCallOfDuty" width="1280" height="760" background="40404008" transparency="50" grid-size="8" snap-to-grid="true" target="Custom" definition="A mini first-person shooter drawn by a Canvas3D: a ruined city under a smoky dusk sky, an AR-15 and a Desert Eagle, doors that open and close, ammunition behind pillars and inside containers, bullet marks on the walls, and tanks, helicopters and drones that attack in growing waves." index-base="1">
  <working-storage><![CDATA[      *> The city: one record per piece - kind, x, z (metres) and turn (degrees about the vertical axis).
      *> H house, A apartment block, R and B red and blue containers, P pillar, W burnt-out car, J jersey barrier.
      *> A door, or a container's open end, faces local +Z; a pillar's ammunition crate stands behind it, at local -Z.
       01 WS-CITY-DATA                           GLOBAL.
           05 FILLER    PIC X(12)    VALUE "A+018+021000".
           05 FILLER    PIC X(12)    VALUE "H-020+020000".
           05 FILLER    PIC X(12)    VALUE "H+020-020180".
           05 FILLER    PIC X(12)    VALUE "A-018-021180".
           05 FILLER    PIC X(12)    VALUE "H+054+018270".
           05 FILLER    PIC X(12)    VALUE "A+054-018270".
           05 FILLER    PIC X(12)    VALUE "H-054-018090".
           05 FILLER    PIC X(12)    VALUE "A-054+018090".
           05 FILLER    PIC X(12)    VALUE "H+018+054180".
           05 FILLER    PIC X(12)    VALUE "H-018-054000".
           05 FILLER    PIC X(12)    VALUE "A-018+054180".
           05 FILLER    PIC X(12)    VALUE "A+018-054000".
           05 FILLER    PIC X(12)    VALUE "R+011+010270".
           05 FILLER    PIC X(12)    VALUE "B-011-010090".
           05 FILLER    PIC X(12)    VALUE "R-011+010090".
           05 FILLER    PIC X(12)    VALUE "B+010-011000".
           05 FILLER    PIC X(12)    VALUE "R+050+050000".
           05 FILLER    PIC X(12)    VALUE "B+058+050000".
           05 FILLER    PIC X(12)    VALUE "B-050-050180".
           05 FILLER    PIC X(12)    VALUE "R-046+048090".
           05 FILLER    PIC X(12)    VALUE "P+022+010000".
           05 FILLER    PIC X(12)    VALUE "P+027+010000".
           05 FILLER    PIC X(12)    VALUE "P+048-046000".
           05 FILLER    PIC X(12)    VALUE "P+054-046000".
           05 FILLER    PIC X(12)    VALUE "P+060-046000".
           05 FILLER    PIC X(12)    VALUE "P+048-056180".
           05 FILLER    PIC X(12)    VALUE "P+054-056180".
           05 FILLER    PIC X(12)    VALUE "P+060-056180".
           05 FILLER    PIC X(12)    VALUE "P-052+056000".
           05 FILLER    PIC X(12)    VALUE "P-058+056000".
           05 FILLER    PIC X(12)    VALUE "P-058+050090".
           05 FILLER    PIC X(12)    VALUE "P-026-010000".
           05 FILLER    PIC X(12)    VALUE "P-021-010000".
           05 FILLER    PIC X(12)    VALUE "P+030-030000".
           05 FILLER    PIC X(12)    VALUE "W+005+020000".
           05 FILLER    PIC X(12)    VALUE "W-005-024000".
           05 FILLER    PIC X(12)    VALUE "W+024-005090".
           05 FILLER    PIC X(12)    VALUE "W-028+005090".
           05 FILLER    PIC X(12)    VALUE "W+041+030000".
           05 FILLER    PIC X(12)    VALUE "W-031-045000".
           05 FILLER    PIC X(12)    VALUE "J+006+013090".
           05 FILLER    PIC X(12)    VALUE "J-006-015090".
           05 FILLER    PIC X(12)    VALUE "J+015+006000".
           05 FILLER    PIC X(12)    VALUE "J-014-006000".
       01 WS-CITY REDEFINES WS-CITY-DATA         GLOBAL.
           05 WS-PIECE                           OCCURS 44.
               10 WS-PIECE-KIND                  PIC X.
               10 WS-PIECE-X                     PIC S999 SIGN LEADING SEPARATE.
               10 WS-PIECE-Z                     PIC S999 SIGN LEADING SEPARATE.
               10 WS-PIECE-TURN                  PIC 999.
       01 WS-PIECE-COUNT                         GLOBAL    PIC 99          VALUE 44.
       01 WS-PIECE-INDEX                         GLOBAL    PIC 99.

      *> What the city adds to the world: collision boxes (already grown by the player's radius), rooms (the inside of every
      *> building and container: the places to hide), doors, ammunition crates and fires.
       01 WS-BOXES                               GLOBAL.
           05 WS-BOX                             OCCURS 120.
               10 WS-BOX-MIN-X                   PIC S9(4)V9(4).
               10 WS-BOX-MAX-X                   PIC S9(4)V9(4).
               10 WS-BOX-MIN-Z                   PIC S9(4)V9(4).
               10 WS-BOX-MAX-Z                   PIC S9(4)V9(4).
       01 WS-BOX-COUNT                           GLOBAL    PIC 999         VALUE 0.
       01 WS-BOX-INDEX                           GLOBAL    PIC 999.
       01 WS-ROOMS                               GLOBAL.
           05 WS-ROOM                            OCCURS 24.
               10 WS-ROOM-MIN-X                  PIC S9(4)V9(4).
               10 WS-ROOM-MAX-X                  PIC S9(4)V9(4).
               10 WS-ROOM-MIN-Z                  PIC S9(4)V9(4).
               10 WS-ROOM-MAX-Z                  PIC S9(4)V9(4).
       01 WS-ROOM-COUNT                          GLOBAL    PIC 99          VALUE 0.
       01 WS-DOORS                               GLOBAL.
           05 WS-DOOR                            OCCURS 12.
               10 WS-DOOR-NODE                   PIC 9(10).
               10 WS-DOOR-X                      PIC S9(4)V9(4).
               10 WS-DOOR-Z                      PIC S9(4)V9(4).
               10 WS-DOOR-ANGLE                  PIC S999.
               10 WS-DOOR-TARGET                 PIC S999.
               10 WS-DOOR-MIN-X                  PIC S9(4)V9(4).
               10 WS-DOOR-MAX-X                  PIC S9(4)V9(4).
               10 WS-DOOR-MIN-Z                  PIC S9(4)V9(4).
               10 WS-DOOR-MAX-Z                  PIC S9(4)V9(4).
       01 WS-DOOR-COUNT                          GLOBAL    PIC 99          VALUE 0.
       01 WS-DOOR-INDEX                          GLOBAL    PIC 99.
       01 WS-NEAR-DOOR                           GLOBAL    PIC 99          VALUE 0.
       01 WS-AMMO-CRATES                         GLOBAL.
           05 WS-AMMO                            OCCURS 16.
               10 WS-AMMO-NODE                   PIC 9(10).
               10 WS-AMMO-X                      PIC S9(4)V9(4).
               10 WS-AMMO-Z                      PIC S9(4)V9(4).
               10 WS-AMMO-WAIT                   PIC S9(5).
       01 WS-AMMO-COUNT                          GLOBAL    PIC 99          VALUE 0.
       01 WS-AMMO-INDEX                          GLOBAL    PIC 99.
       01 WS-FIRES                               GLOBAL.
           05 WS-FIRE                            OCCURS 3.
               10 WS-FIRE-FLAME                  PIC 9(10).
               10 WS-FIRE-LIGHT                  PIC 9(10).
               10 WS-FIRE-X                      PIC S9(4)V9(4).
               10 WS-FIRE-Z                      PIC S9(4)V9(4).
