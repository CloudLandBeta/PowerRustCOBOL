       01 WS-SCORCH-NODE                         GLOBAL    PIC 9(10).
       01 WS-SCORCH-SEGMENTS                     GLOBAL.
           05 WS-SCORCH-SEGMENT                  PIC X(180)  OCCURS 16.
       01 WS-SCORCH-COUNT                        GLOBAL    PIC 99          VALUE 0.
       01 WS-SCORCH-NEXT                         GLOBAL    PIC 99          VALUE 1.
       01 WS-INSTANCE-LIST                       GLOBAL    PIC X(11600).
       01 WS-POINTER                             GLOBAL    PIC 9(5).
       01 WS-CELL-INDEX                          GLOBAL    PIC 99.
       01 WS-MATRIX                              GLOBAL.
           05 WS-MATRIX-CELL                     PIC ----9.9999 OCCURS 16.
       01 WS-AXIS-X1                             GLOBAL    PIC S9V9(6).
       01 WS-AXIS-Y1                             GLOBAL    PIC S9V9(6).
       01 WS-AXIS-Z1                             GLOBAL    PIC S9V9(6).
