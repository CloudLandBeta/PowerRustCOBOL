  <Control id="BTN-GREET" type="Button" x="24" y="160" w="112" h="40" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Greet</Property>
    <Property name="BackgroundColor">#36383EB3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#4E4E4EB3</Property>
    <Property name="BackgroundGradientEndColor">#000000B3</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000FF</Property>
    <Property name="ShadowLightColor">#4E4E4EFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="AccessibleLabel"></Property>
    <Event name="onClick" paragraph="BTN-GREET--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

DATA DIVISION.

WORKING-STORAGE SECTION.

LINKAGE SECTION.

PROCEDURE DIVISION.

*> Greets the person whose name is in the box. An empty box asks for a name
*> instead, so the first click already shows both ways through the handler.
*> The name is kept in the phone's secure storage for the next start; where
*> there is none (the Preview), SecureStatus is -6 and the greeting says so.

IF    TXT-NAME::Text::Trim()::Len = 0
SET     LBL-RESULT::Caption       TO    "Type your name first."
ELSE
COBOL::SecureStore( "user-name" TXT-NAME::Text::Trim() )
MOVE    SPACES                    TO    LBL-RESULT::Caption
IF    COBOL::SecureStatus = 0
STRING    "Hello, " TXT-NAME::Text::Trim() ". I will remember you." DELIMITED BY SIZE INTO LBL-RESULT::Caption
ELSE
STRING    "Hello, " TXT-NAME::Text::Trim() "." DELIMITED BY SIZE INTO LBL-RESULT::Caption
END-IF
END-IF.
]]></Event>
  </Control>
  <Control id="BTN-FORGET" type="Button" x="152" y="160" w="128" h="40" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Forget me</Property>
    <Property name="BackgroundColor">#36383EB3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#4E4E4EB3</Property>
    <Property name="BackgroundGradientEndColor">#000000B3</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000FF</Property>
    <Property name="ShadowLightColor">#4E4E4EFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="AccessibleLabel"></Property>
    <Event name="onClick" paragraph="BTN-FORGET--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

DATA DIVISION.

WORKING-STORAGE SECTION.

LINKAGE SECTION.

PROCEDURE DIVISION.

*> Removes the remembered name from the phone's secure storage and empties the
*> box, so the next start greets a new person.

COBOL::SecureDelete( "user-name" )
SET     TXT-NAME::Text            TO    SPACES
IF    COBOL::SecureStatus = 0
SET     LBL-RESULT::Caption       TO    "Forgotten. See you, stranger."
ELSE
SET     LBL-RESULT::Caption       TO    "There was nothing to forget."
END-IF.
]]></Event>
  </Control>
