           CLASS RUST-STRING IS "Rust.String"
           CLASS RUST-OSSTRING IS "Rust.OsString"
           CLASS RUST-OSSTR IS "Rust.OsStr"
           CLASS RUST-CSTRING IS "Rust.CString"
           CLASS RUST-CSTR IS "Rust.CStr"
           CLASS RUST-PATH IS "Rust.Path"
           CLASS RUST-PATHBUF IS "Rust.PathBuf"
           CLASS RUST-VEC IS "Rust.Vec"
           CLASS RUST-VECDEQUE IS "Rust.VecDeque"
           CLASS RUST-LINKEDLIST IS "Rust.LinkedList"
           CLASS RUST-HASHMAP IS "Rust.HashMap"
           CLASS RUST-BTREEMAP IS "Rust.BTreeMap"
           CLASS RUST-HASHSET IS "Rust.HashSet"
           CLASS RUST-BTREESET IS "Rust.BTreeSet"
           CLASS RUST-BINARYHEAP IS "Rust.BinaryHeap"
           CLASS RUST-OPTION IS "Rust.Option"
           CLASS RUST-RESULT IS "Rust.Result"
           CLASS RUST-BOX IS "Rust.Box"
           CLASS RUST-RC IS "Rust.Rc"
           CLASS RUST-ARC IS "Rust.Arc"
           CLASS RUST-WEAK IS "Rust.Weak"
           CLASS RUST-CELL IS "Rust.Cell"
           CLASS RUST-REFCELL IS "Rust.RefCell"
           CLASS RUST-MUTEX IS "Rust.Mutex"
           CLASS RUST-RWLOCK IS "Rust.RwLock"
           CLASS RUST-COW IS "Rust.Cow"
           CLASS RUST-DURATION IS "Rust.Duration"
           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"
]]></repository>
  <file-control><![CDATA[           SELECT SETTINGS-FILE ASSIGN TO WS-SETTINGS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS SET-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT MODELS-FILE ASSIGN TO WS-MODELS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS MDL-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
]]></file-control>
  <file-section><![CDATA[       FD SETTINGS-FILE IS GLOBAL.
       01 SETTINGS-REC.
           05 SET-NAME                           PIC    X(20).
           05 SET-VALUE                          PIC    X(200).
       FD MODELS-FILE IS GLOBAL.
       01 MODEL-REC.
           05 MDL-NAME                           PIC    X(30).
           05 MDL-API                            PIC    X(12).
           05 MDL-URL                            PIC    X(200).
           05 MDL-MODEL                          PIC    X(80).
           *>   The capability table (spec 071 R31, 063 R72): whether the model
           *>   can call tools, and how well it orchestrates, 1 (poorly) to 9.

           05 MDL-TOOLS                          PIC    X.
           05 MDL-RANK                           PIC    9.
]]></file-section>
  <user-procedures>
    <Event name="PC-PATHS" paragraph="PC-PATHS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Where PowerChat keeps its own files: POWERCHAT_DATA, else "data".

           DISPLAY    "POWERCHAT_DATA" UPON ENVIRONMENT-NAME
           ACCEPT    WS-DATA-DIR FROM ENVIRONMENT-VALUE
           IF    WS-DATA-DIR = SPACES
               SET     WS-DATA-DIR               TO    "data"
           END-IF
           SET     WS-SETTINGS-PATH              TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/settings.idx" INTO WS-SETTINGS-PATH
           SET     WS-MODELS-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/models.idx" INTO WS-MODELS-PATH
]]></Event>
    <Event name="PC-SYNC-MODELS" paragraph="PC-SYNC-MODELS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 SY-N                                   PIC    9(3).
       01 SY-I                                   PIC    9(3).
       01 SY-J                                   PIC    9(3).
       01 SY-NAME                                PIC    X(30).
       01 SY-API                                 PIC    X(12).
       01 SY-URL                                 PIC    X(200).
       01 SY-MODEL                               PIC    X(80).
       01 SY-FOUND                               PIC    X.
       01 SY-EOF                                 PIC    X.
       01 SY-GONE-N                              PIC    9(3).
       01 SY-GONE-TABLE.
           05 SY-GONE                            PIC    X(30)    OCCURS 200 TIMES.

       PROCEDURE DIVISION.
           *>   The models are the APPLICATION's (spec 085): the runtime keeps the
           *>   list for every form of it, the application's own agents included.
           *>   MODELS mirrors that list and adds what only PowerChat knows of each
           *>   model - whether it calls tools, how well it orchestrates. Once, the
           *>   models PowerChat kept before are handed to the application's list.

           OPEN    I-O MODELS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT MODELS-FILE
               CLOSE    MODELS-FILE
               OPEN    I-O MODELS-FILE
           END-IF
           SET     WS-SET-NAME                   TO    "MODELS-ADOPTED"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "MODELS-ADOPTED" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = "Y" once the models PowerChat kept before were handed to the
           *>         application's list, otherwise SPACES; the IF below runs that one-time
           *>         hand-over unless it is "Y".

           CALL    "PC-SETTING-GET"
           IF    WS-SET-VALUE NOT = "Y"
               SET     MDL-NAME                  TO    LOW-VALUES
               SET     SY-EOF                    TO    "N"

               START    MODELS-FILE KEY IS >= MDL-NAME
                   INVALID KEY MOVE "Y" TO SY-EOF
               END-START
               PERFORM    UNTIL SY-EOF = "Y"
                   READ    MODELS-FILE NEXT RECORD
                       AT END MOVE "Y" TO SY-EOF
                       NOT AT END
                           COBOL::"MODEL-SET" ( MDL-NAME MDL-API MDL-URL MDL-MODEL )
                   END-READ
               END-PERFORM

               SET     WS-SET-NAME               TO    "MODELS-ADOPTED"
               SET     WS-SET-VALUE              TO    "Y"

               *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
               *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and
               *> committed at once. The file is created empty when missing.
               *> Uses:   WS-SET-NAME = "MODELS-ADOPTED" and WS-SET-VALUE = "Y" (set just above).
               *> Result: the MODELS-ADOPTED setting is "Y", so the hand-over of the old models is
               *>         not done again. Only WS-FS and the settings record area (SET-NAME,
               *>         SET-VALUE) change.

               CALL    "PC-SETTING-PUT"
           END-IF
           *>   Every model of the application's is here, with its own metadata.

           COBOL::"MODEL-COUNT" ( SY-N )
           PERFORM    VARYING SY-I FROM 1 BY 1 UNTIL SY-I > SY-N
               SET     SY-NAME SY-API SY-URL SY-MODEL
                                                 TO    SPACES

               COBOL::"MODEL-GET" ( SY-I SY-NAME SY-API SY-URL SY-MODEL )
               SET     MDL-NAME                  TO    SY-NAME
               READ    MODELS-FILE
                   INVALID KEY
                       *> A model new to PowerChat starts without tool support and at the
                       *> middle rank, 5 (the scale is 1-9); Model selection sets both.

                       SET     MDL-API           TO    SY-API
                       SET     MDL-URL           TO    SY-URL
                       SET     MDL-MODEL         TO    SY-MODEL
                       SET     MDL-TOOLS         TO    "N"
                       SET     MDL-RANK          TO    5

                       WRITE    MODEL-REC
                           INVALID KEY CONTINUE
                       END-WRITE
                   NOT INVALID KEY
                       IF    MDL-API NOT = SY-API OR MDL-URL NOT = SY-URL
                               OR MDL-MODEL NOT = SY-MODEL

                           SET     MDL-API       TO    SY-API
                           SET     MDL-URL       TO    SY-URL
                           SET     MDL-MODEL     TO    SY-MODEL

                           REWRITE    MODEL-REC
                               INVALID KEY CONTINUE
                           END-REWRITE
                       END-IF
               END-READ
           END-PERFORM
           *>   ...and none the application has withdrawn.

           SET     SY-GONE-N                     TO    0
           SET     MDL-NAME                      TO    LOW-VALUES
           SET     SY-EOF                        TO    "N"

           START    MODELS-FILE KEY IS >= MDL-NAME
               INVALID KEY MOVE "Y" TO SY-EOF
           END-START
           PERFORM    UNTIL SY-EOF = "Y"
               READ    MODELS-FILE NEXT RECORD
                   AT END MOVE "Y" TO SY-EOF
                   NOT AT END
                       SET     SY-FOUND          TO    "N"
                       PERFORM    VARYING SY-J FROM 1 BY 1
                               UNTIL SY-J > SY-N OR SY-FOUND = "Y"
                           SET     SY-NAME       TO    SPACES
                           COBOL::"MODEL-GET" ( SY-J SY-NAME )
                           IF    FUNCTION UPPER-CASE(SY-NAME)
                                   = FUNCTION UPPER-CASE(MDL-NAME)
                               SET     SY-FOUND  TO    "Y"
                           END-IF
                       END-PERFORM
                       IF    SY-FOUND = "N" AND SY-GONE-N < 200
                           ADD    1 TO SY-GONE-N
                           SET     SY-GONE(SY-GONE-N)
                                                 TO    MDL-NAME
                       END-IF
               END-READ
           END-PERFORM
           *> Withdrawn models are deleted after the scan, from the names noted in
           *> SY-GONE: no DELETE happens in the middle of the READ NEXT loop.

           PERFORM    VARYING SY-J FROM 1 BY 1 UNTIL SY-J > SY-GONE-N
               SET     MDL-NAME                  TO    SY-GONE(SY-J)
               DELETE    MODELS-FILE
                   INVALID KEY CONTINUE
               END-DELETE
           END-PERFORM
           COMMIT
           CLOSE    MODELS-FILE
]]></Event>
    <Event name="PC-SETTING-GET" paragraph="PC-SETTING-GET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME in, WS-SET-VALUE out (spaces when the setting is unset).

           SET     WS-SET-VALUE                  TO    SPACES
           *> Status 35 means the file does not exist yet: create it empty, then
           *> open it I-O again, so a first run needs no setup.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF
           SET     SET-NAME                      TO    WS-SET-NAME
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE SET-VALUE TO WS-SET-VALUE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-SETTING-PUT" paragraph="PC-SETTING-PUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME, WS-SET-VALUE in. Written and committed at once (R10f).

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF

           SET     SET-NAME                      TO    WS-SET-NAME
           SET     SET-VALUE                     TO    WS-SET-VALUE

           WRITE    SETTINGS-REC
               INVALID KEY REWRITE SETTINGS-REC
           END-WRITE
           COMMIT
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-LOAD-CONNS" paragraph="PC-LOAD-CONNS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Every saved connection's name, in key order, into WS-CONN-NAME -
           *>   the application's models, mirrored first (spec 085).

           *> PC-SYNC-MODELS: makes MODELS-FILE mirror the application's model list (kept by the
           *> runtime) and adds what only PowerChat knows of each model: tool support and rank.
           *> Uses:   the application's model list (COBOL::"MODEL-COUNT" and "MODEL-GET"),
           *>         MODELS-FILE (<WS-DATA-DIR>/models.idx = WS-MODELS-PATH; created empty when
           *>         missing) and the MODELS-ADOPTED setting.
           *> Result: the first time only (MODELS-ADOPTED not "Y"): every MODELS-FILE record is
           *>         handed to the application's list with COBOL::"MODEL-SET" and MODELS-ADOPTED =
           *>         "Y". Every time: MODELS-FILE gets a record for each model of the list (a new
           *>         one starts with MDL-TOOLS = "N" and MDL-RANK = 5), a record whose api, url or
           *>         model differs is rewritten, and a record for a model no longer in the list is
           *>         deleted; committed. WS-SET-NAME and WS-SET-VALUE hold the MODELS-ADOPTED
           *>         setting.

           CALL    "PC-SYNC-MODELS"
           SET     WS-CONN-COUNT                 TO    0
           OPEN    I-O MODELS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT MODELS-FILE
               CLOSE    MODELS-FILE
               OPEN    I-O MODELS-FILE
           END-IF

           SET     MDL-NAME                      TO    LOW-VALUES
           SET     WS-EOF                        TO    "N"

           START    MODELS-FILE KEY IS >= MDL-NAME
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    MODELS-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    WS-CONN-COUNT < 200
                           ADD    1 TO WS-CONN-COUNT
                           SET     WS-CONN-NAME(WS-CONN-COUNT)
                                                 TO    MDL-NAME
                       END-IF
               END-READ
           END-PERFORM
           CLOSE    MODELS-FILE
]]></Event>
    <Event name="PC-LOAD-AGENTS" paragraph="PC-LOAD-AGENTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Which model each of the chat's three agents uses. Agent 1 falls
           *>   back to MODEL-ENTRY, the single setting PowerChat 1 kept.

           PERFORM    VARYING WS-A FROM 1 BY 1 UNTIL WS-A > 3
               SET     WS-SET-NAME               TO    SPACES
               STRING    "AGENT-" WS-A "-ENTRY" DELIMITED BY SIZE INTO WS-SET-NAME

               *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
               *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
               *> missing; nothing is written.
               *> Uses:   WS-SET-NAME = "AGENT-<WS-A>-ENTRY" (built just above: AGENT-1-ENTRY,
               *>         AGENT-2-ENTRY, then AGENT-3-ENTRY, one per pass of the loop).
               *> Result: WS-SET-VALUE = the name of the connection saved for that agent, or SPACES
               *>         when none; the next line copies it to WS-AGENT-ENTRY(WS-A).

               CALL    "PC-SETTING-GET"
               SET     WS-AGENT-ENTRY(WS-A)      TO    WS-SET-VALUE
           END-PERFORM
           IF    WS-AGENT-ENTRY(1) = SPACES
               SET     WS-SET-NAME               TO    "MODEL-ENTRY"

               *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
               *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
               *> missing; nothing is written. Reached only when WS-AGENT-ENTRY(1) is SPACES.
               *> Uses:   WS-SET-NAME = "MODEL-ENTRY" (set just above), the single setting PowerChat
               *>         1 kept.
               *> Result: WS-SET-VALUE = that connection name, or SPACES when none; the next line
               *>         copies it to WS-AGENT-ENTRY(1).

               CALL    "PC-SETTING-GET"
               SET     WS-AGENT-ENTRY(1)         TO    WS-SET-VALUE
           END-IF
]]></Event>
    <Event name="PC-TEXTS" paragraph="PC-TEXTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language the user picked (LANG), the texts in it, and every
           *>   designed caption and hint that shows one (R46).

           SET     WS-SET-NAME                   TO    "LANG"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "LANG" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = the language code saved under LANG ("en", "pt", "es", "fr",
           *>         "jp" or "cn"), or SPACES when none was saved. Used right below to set WS-LANG.

           CALL    "PC-SETTING-GET"
           SET     WS-LANG                       TO    WS-SET-VALUE(1:2)
           *> WS-LANG-IX is the language's column in PC-TEXT; an unset or unknown
           *> language falls back to English.

           EVALUATE    WS-LANG
               WHEN "en" MOVE 1 TO WS-LANG-IX
               WHEN "pt" MOVE 2 TO WS-LANG-IX
               WHEN "es" MOVE 3 TO WS-LANG-IX
               WHEN "fr" MOVE 4 TO WS-LANG-IX
               WHEN "jp" MOVE 5 TO WS-LANG-IX
               WHEN "cn" MOVE 6 TO WS-LANG-IX
               WHEN OTHER MOVE "en" TO WS-LANG
                   SET     WS-LANG-IX            TO    1
           END-EVALUATE
           PERFORM    VARYING WS-TX-I FROM 1 BY 1 UNTIL WS-TX-I > 8
               SET     PC-TEXT-NOW(WS-TX-I)      TO    PC-TEXT(WS-TX-I, WS-LANG-IX)
           END-PERFORM

           SET     Lbl-Title::Caption            TO    T-AGENTS-TITLE::Trim()
           SET     Btn-Save::Caption             TO    T-SAVE::Trim()
           SET     Btn-Cancel::Caption           TO    T-CANCEL::Trim()
           SET     Btn-SaveTop::Caption          TO    T-SAVE::Trim()
           SET     Btn-CancelTop::Caption        TO    T-CANCEL::Trim()
           SET     Lbl-Status::Caption           TO    T-STATUS::Trim()
           SET     WS-FMT                        TO    T-AGENT-N
           SET     WS-A                          TO    1
           SET     WS-ARG1                       TO    WS-A

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-AGENT-N (the "Agent &1" text in the current language); WS-ARG1 =
           *>         WS-A = 1, set just above.
           *> Result: WS-FMT-OUT = "Agent 1" in that language; the next line puts it on Lbl-Agent-1.
           *>         Nothing else changes.

           CALL    "PC-FMT"

           SET     Lbl-Agent-1::Caption          TO    WS-FMT-OUT::Trim()
           SET     Cmb-Agent-1::Tooltip          TO    T-TIP-AGENT-CONN::Trim()
           SET     WS-FMT                        TO    T-AGENT-N
           SET     WS-A                          TO    2
           SET     WS-ARG1                       TO    WS-A

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-AGENT-N (the "Agent &1" text in the current language); WS-ARG1 =
           *>         WS-A = 2, set just above.
           *> Result: WS-FMT-OUT = "Agent 2" in that language; the next line puts it on Lbl-Agent-2.
           *>         Nothing else changes.

           CALL    "PC-FMT"

           SET     Lbl-Agent-2::Caption          TO    WS-FMT-OUT::Trim()
           SET     Cmb-Agent-2::Tooltip          TO    T-TIP-AGENT-CONN::Trim()
           SET     WS-FMT                        TO    T-AGENT-N
           SET     WS-A                          TO    3
           SET     WS-ARG1                       TO    WS-A

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-AGENT-N (the "Agent &1" text in the current language); WS-ARG1 =
           *>         WS-A = 3, set just above.
           *> Result: WS-FMT-OUT = "Agent 3" in that language; the next line puts it on Lbl-Agent-3.
           *>         Nothing else changes.

           CALL    "PC-FMT"

           SET     Lbl-Agent-3::Caption          TO    WS-FMT-OUT::Trim()
           SET     Cmb-Agent-3::Tooltip          TO    T-TIP-AGENT-CONN::Trim()
]]></Event>
    <Event name="PC-FMT" paragraph="PC-FMT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-FROM                                PIC    9(4).
       01 WS-CNT                                 PIC    9(4).
       01 WS-PART                                PIC    X(120).
       01 WS-DELIM                               PIC    XX.

       PROCEDURE DIVISION.
           *>   A message whose words go round numbers and names differently in each
           *>   language: WS-FMT holds "&1" .. "&4" where WS-ARG1..4 go.

           SET     WS-FMT-OUT                    TO    SPACES
           SET     WS-PT                         TO    1
           SET     WS-FROM                       TO    1

           PERFORM    UNTIL WS-FROM > FUNCTION LENGTH(WS-FMT)
               SET     WS-PART WS-DELIM          TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-FMT DELIMITED BY "&1" OR "&2" OR "&3" OR "&4"
                   INTO WS-PART DELIMITER IN WS-DELIM COUNT IN WS-CNT
                   WITH POINTER WS-FROM
               END-UNSTRING
               *> WS-CNT is 0 when a placeholder comes first (or two in a row), and a
               *> zero-length reference modification is not allowed.

               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-FMT-OUT WITH POINTER WS-PT
               END-IF
               *> WS-DELIM is cleared each round, so blank means no &n was found: that
               *> was the last piece. Move the pointer past the end to stop the loop.

               EVALUATE    WS-DELIM
                   WHEN "&1" STRING WS-ARG1::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&2" STRING WS-ARG2::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&3" STRING WS-ARG3::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&4" STRING WS-ARG4::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN OTHER COMPUTE WS-FROM = FUNCTION LENGTH(WS-FMT) + 1
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-SAVE" paragraph="PC-SAVE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Save - shared by the Save buttons at the top and at the bottom.
           *>   Each agent's connection, or none. Agent 1's is also PowerChat 1's
           *>   single MODEL-ENTRY, so "(off)" does not fall back to it.

           SET     WS-INDEX                      TO    Cmb-Agent-1::GetSelectedIndex()
           *>   Item 1 is "(off)"; connection N is item N + 1.

           SUBTRACT    1 FROM WS-INDEX
           SET     WS-SET-VALUE                  TO    SPACES
           IF    WS-INDEX > 0 AND WS-INDEX <= WS-CONN-COUNT
               SET     WS-SET-VALUE              TO    WS-CONN-NAME(WS-INDEX)
           END-IF
           SET     WS-SET-NAME                   TO    "AGENT-1-ENTRY"

           *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
           *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and committed
           *> at once. The file is created empty when missing.
           *> Uses:   WS-SET-NAME = "AGENT-1-ENTRY" (set just above) and WS-SET-VALUE = the name of
           *>         the connection picked in Cmb-Agent-1, or SPACES when "(off)" is picked
           *>         (WS-CONN-NAME(WS-INDEX), set above).
           *> Result: the AGENT-1-ENTRY setting holds that connection name (or SPACES = the agent is
           *>         off). Only WS-FS and the settings record area (SET-NAME, SET-VALUE) change.

           CALL    "PC-SETTING-PUT"
           SET     WS-SET-NAME                   TO    "MODEL-ENTRY"

           *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
           *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and committed
           *> at once. The file is created empty when missing.
           *> Uses:   WS-SET-NAME = "MODEL-ENTRY" (set just above) and WS-SET-VALUE = agent 1's
           *>         connection name, or SPACES for "(off)" (unchanged since the call above).
           *> Result: the MODEL-ENTRY setting, the single one PowerChat 1 kept, follows agent 1.
           *>         Only WS-FS and the settings record area (SET-NAME, SET-VALUE) change.

           CALL    "PC-SETTING-PUT"
           SET     WS-INDEX                      TO    Cmb-Agent-2::GetSelectedIndex()
           *>   Item 1 is "(off)"; connection N is item N + 1.

           SUBTRACT    1 FROM WS-INDEX
           SET     WS-SET-VALUE                  TO    SPACES
           IF    WS-INDEX > 0 AND WS-INDEX <= WS-CONN-COUNT
               SET     WS-SET-VALUE              TO    WS-CONN-NAME(WS-INDEX)
           END-IF
           SET     WS-SET-NAME                   TO    "AGENT-2-ENTRY"

           *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
           *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and committed
           *> at once. The file is created empty when missing.
           *> Uses:   WS-SET-NAME = "AGENT-2-ENTRY" (set just above) and WS-SET-VALUE = the name of
           *>         the connection picked in Cmb-Agent-2, or SPACES when "(off)" is picked
           *>         (WS-CONN-NAME(WS-INDEX), set above).
           *> Result: the AGENT-2-ENTRY setting holds that connection name (or SPACES = the agent is
           *>         off). Only WS-FS and the settings record area (SET-NAME, SET-VALUE) change.

           CALL    "PC-SETTING-PUT"
           SET     WS-INDEX                      TO    Cmb-Agent-3::GetSelectedIndex()
           *>   Item 1 is "(off)"; connection N is item N + 1.

           SUBTRACT    1 FROM WS-INDEX
           SET     WS-SET-VALUE                  TO    SPACES
           IF    WS-INDEX > 0 AND WS-INDEX <= WS-CONN-COUNT
               SET     WS-SET-VALUE              TO    WS-CONN-NAME(WS-INDEX)
           END-IF
           SET     WS-SET-NAME                   TO    "AGENT-3-ENTRY"

           *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
           *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and committed
           *> at once. The file is created empty when missing.
           *> Uses:   WS-SET-NAME = "AGENT-3-ENTRY" (set just above) and WS-SET-VALUE = the name of
           *>         the connection picked in Cmb-Agent-3, or SPACES when "(off)" is picked
           *>         (WS-CONN-NAME(WS-INDEX), set above).
           *> Result: the AGENT-3-ENTRY setting holds that connection name (or SPACES = the agent is
           *>         off). Only WS-FS and the settings record area (SET-NAME, SET-VALUE) change.

           CALL    "PC-SETTING-PUT"
           SET     Lbl-Status::Caption           TO    T-AGENTS-SAVED::Trim()
           INVOKE    ME::Close()
]]></Event>
    <Event name="PC-CANCEL" paragraph="PC-CANCEL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Cancel - shared by the Cancel buttons at the top and at the bottom.
           *>   Nothing is written: the dialog closes as it was opened.

           INVOKE    ME::Close()
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="AGENTS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PC-PATHS: works out where PowerChat keeps its own indexed files.
           *> Uses:   the environment variable POWERCHAT_DATA.
           *> Result: WS-DATA-DIR = POWERCHAT_DATA, or "data" when empty; WS-SETTINGS-PATH =
           *>         <WS-DATA-DIR>/settings.idx and WS-MODELS-PATH = <WS-DATA-DIR>/models.idx. No
           *>         file is opened.

           CALL    "PC-PATHS"

           *> PC-TEXTS: puts the form in the user's language: it reads the LANG setting, loads the
           *> matching texts and sets every designed caption and tooltip.
           *> Uses:   the LANG setting (read through PC-SETTING-GET) and the PC-TEXT table of 8
           *>         texts in 6 languages.
           *> Result: WS-LANG = "en", "pt", "es", "fr", "jp" or "cn" ("en" when unknown) and
           *>         WS-LANG-IX = 1 to 6, its column; PC-TEXT-NOW(1..8) = the texts in that
           *>         language, which the T-... names read. Captions are set on Lbl-Title, Btn-Save,
           *>         Btn-Cancel, Btn-SaveTop, Btn-CancelTop, Lbl-Status and Lbl-Agent-1 to
           *>         Lbl-Agent-3 ("Agent n"); tooltips on Cmb-Agent-1 to Cmb-Agent-3. WS-SET-NAME =
           *>         "LANG", WS-SET-VALUE, WS-A, WS-FMT, WS-ARG1 and WS-FMT-OUT are work areas.

           CALL    "PC-TEXTS"

           *> PC-LOAD-CONNS: lists the saved connections (the application's models, mirrored into
           *> MODELS-FILE first) for the agent pickers.
           *> Uses:   MODELS-FILE (<WS-DATA-DIR>/models.idx = WS-MODELS-PATH, set by PC-PATHS above;
           *>         created empty when missing) and, through PC-SYNC-MODELS, the application's
           *>         model list.
           *> Result: WS-CONN-COUNT = the number of models, up to 200; WS-CONN-NAME(n) = the name of
           *>         the n-th one, in key order. MODELS-FILE is brought up to date by
           *>         PC-SYNC-MODELS first.

           CALL    "PC-LOAD-CONNS"

           *> PC-LOAD-AGENTS: reads which connection each of the chat's three agents uses.
           *> Uses:   the settings AGENT-1-ENTRY, AGENT-2-ENTRY and AGENT-3-ENTRY and, when agent 1
           *>         has none, MODEL-ENTRY.
           *> Result: WS-AGENT-ENTRY(1..3) = the connection name saved for each agent, SPACES = the
           *>         agent is off (agent 1 falls back to MODEL-ENTRY). The lines below select it in
           *>         each picker.

           CALL    "PC-LOAD-AGENTS"

           *>   Each agent's picker: "(off)" first (item 1), then every saved
           *>   connection (connection N is item N + 1); the one the agent uses now
           *>   is selected.

           Cmb-Agent-1::Clear()
           Cmb-Agent-1::AddItem(T-AGENT-NONE::Trim())
           SET     WS-INDEX                      TO    1

           PERFORM    VARYING WS-P FROM 1 BY 1 UNTIL WS-P > WS-CONN-COUNT
               Cmb-Agent-1::AddItem(WS-CONN-NAME(WS-P)::Trim())
               IF    WS-CONN-NAME(WS-P) = WS-AGENT-ENTRY(1)
                   COMPUTE    WS-INDEX = WS-P + 1
               END-IF
           END-PERFORM

           SET     WS-P                          TO    WS-INDEX
           Cmb-Agent-1::SetSelectedIndex(WS-P)
           Cmb-Agent-2::Clear()
           Cmb-Agent-2::AddItem(T-AGENT-NONE::Trim())
           SET     WS-INDEX                      TO    1

           PERFORM    VARYING WS-P FROM 1 BY 1 UNTIL WS-P > WS-CONN-COUNT
               Cmb-Agent-2::AddItem(WS-CONN-NAME(WS-P)::Trim())
               IF    WS-CONN-NAME(WS-P) = WS-AGENT-ENTRY(2)
                   COMPUTE    WS-INDEX = WS-P + 1
               END-IF
           END-PERFORM

           SET     WS-P                          TO    WS-INDEX
           Cmb-Agent-2::SetSelectedIndex(WS-P)
           Cmb-Agent-3::Clear()
           Cmb-Agent-3::AddItem(T-AGENT-NONE::Trim())
           SET     WS-INDEX                      TO    1

           PERFORM    VARYING WS-P FROM 1 BY 1 UNTIL WS-P > WS-CONN-COUNT
               Cmb-Agent-3::AddItem(WS-CONN-NAME(WS-P)::Trim())
               IF    WS-CONN-NAME(WS-P) = WS-AGENT-ENTRY(3)
                   COMPUTE    WS-INDEX = WS-P + 1
               END-IF
           END-PERFORM

           SET     WS-P                          TO    WS-INDEX
           Cmb-Agent-3::SetSelectedIndex(WS-P)
]]></Event>
    <Event name="onClose" paragraph="AGENTS-FORM--ONCLOSE">
    </Event>
  </form-events>
