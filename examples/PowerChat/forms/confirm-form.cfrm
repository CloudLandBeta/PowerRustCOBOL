<?xml version="1.0" encoding="UTF-8"?>
<Form name="CONFIRM-FORM" title="PowerChat" width="520" height="220" background="DFE0E1FF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" glass-style="Neumorphic Light" modal-overlay-style="Greyed">
  <working-storage><![CDATA[       01 WS-TEXT            GLOBAL PIC X(300).
]]></working-storage>
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
           CLASS RUST-I64 IS "Rust.i64"
           CLASS RUST-I128 IS "Rust.i128"
           CLASS RUST-ISIZE IS "Rust.isize"
           CLASS RUST-U8 IS "Rust.u8"
           CLASS RUST-U16 IS "Rust.u16"
           CLASS RUST-U32 IS "Rust.u32"
           CLASS RUST-U64 IS "Rust.u64"
           CLASS RUST-U128 IS "Rust.u128"
           CLASS RUST-USIZE IS "Rust.usize"
           CLASS RUST-F32 IS "Rust.f32"
           CLASS RUST-F64 IS "Rust.f64"
           CLASS RUST-STR IS "Rust.str"
           CLASS RUST-UNIT IS "Rust.unit"
           CLASS RUST-STRING IS "Rust.String"
           CLASS RUST-OSSTRING IS "Rust.OsString"
           CLASS RUST-OSSTR IS "Rust.OsStr"
           CLASS RUST-CSTRING IS "Rust.CString"
           CLASS RUST-CSTR IS "Rust.CStr"
           CLASS RUST-PATH IS "Rust.Path"
           CLASS RUST-PATHBUF IS "Rust.PathBuf"
           CLASS RUST-VEC IS "Rust.Vec"
           CLASS RUST-VECDEQUE IS "Rust.VecDeque"
           CLASS RUST-LINKEDLIST IS "Rust.LinkedList"
           CLASS RUST-HASHMAP IS "Rust.HashMap"
           CLASS RUST-BTREEMAP IS "Rust.BTreeMap"
           CLASS RUST-HASHSET IS "Rust.HashSet"
           CLASS RUST-BTREESET IS "Rust.BTreeSet"
           CLASS RUST-BINARYHEAP IS "Rust.BinaryHeap"
           CLASS RUST-OPTION IS "Rust.Option"
           CLASS RUST-RESULT IS "Rust.Result"
           CLASS RUST-BOX IS "Rust.Box"
           CLASS RUST-RC IS "Rust.Rc"
           CLASS RUST-ARC IS "Rust.Arc"
           CLASS RUST-WEAK IS "Rust.Weak"
           CLASS RUST-CELL IS "Rust.Cell"
           CLASS RUST-REFCELL IS "Rust.RefCell"
           CLASS RUST-MUTEX IS "Rust.Mutex"
           CLASS RUST-RWLOCK IS "Rust.RwLock"
           CLASS RUST-COW IS "Rust.Cow"
           CLASS RUST-DURATION IS "Rust.Duration"
           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"]]></repository>
  <form-events>
    <Event name="onLoad" paragraph="CONFIRM-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   A yes/no question for any form (operator, 2026-09-26): the
      *>   caller sets ConfirmText (and, translated, ConfirmYes /
      *>   ConfirmNo) on itself, opens this with OpenFormSync, and reads
      *>   ConfirmAnswer - Y or N - when it returns. Closing it any other
      *>   way leaves the caller's own default, which should be N.
           INVOKE super::"GetProperty"("ConfirmText") RETURNING WS-TEXT
      *>   No question given: the designed "Are you sure?" stays.
           IF WS-TEXT NOT = SPACES
               MOVE FUNCTION TRIM(WS-TEXT) TO Lbl-Question::Caption
           END-IF
           INVOKE super::"GetProperty"("ConfirmYes") RETURNING WS-TEXT
           IF WS-TEXT NOT = SPACES
               MOVE FUNCTION TRIM(WS-TEXT) TO Btn-Yes::Caption
           END-IF
           INVOKE super::"GetProperty"("ConfirmNo") RETURNING WS-TEXT
           IF WS-TEXT NOT = SPACES
               MOVE FUNCTION TRIM(WS-TEXT) TO Btn-No::Caption
           END-IF
]]></Event>
    <Event name="onClose" paragraph="CONFIRM-FORM--ONCLOSE">
    </Event>
  </form-events>
  <Control id="Lbl-Question" type="Label" x="24" y="24" w="472" h="96" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="FontSize">16</Property>
    <Property name="Bold">true</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="VerticalAlignment">Middle</Property>
    <Property name="WordWrap">true</Property>
    <Property name="AutoSize">false</Property>
    <Property name="Caption">Are you sure?</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
  </Control>
  <Control id="Btn-No" type="Button" x="256" y="156" w="112" h="36" tab-order="3" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">No</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-NO--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The caller asked; this is its answer, read after OpenFormSync.
           INVOKE super::"SetProperty"("ConfirmAnswer", "N")
           INVOKE ME::Close()
]]></Event>
  </Control>
  <Control id="Btn-Yes" type="Button" x="384" y="156" w="112" h="36" tab-order="4" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">Yes</Property>
    <Property name="IsDefault">true</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-YES--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           INVOKE super::"SetProperty"("ConfirmAnswer", "Y")
           INVOKE ME::Close()
]]></Event>
  </Control>
</Form>