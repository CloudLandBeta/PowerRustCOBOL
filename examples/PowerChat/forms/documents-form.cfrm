  <file-control><![CDATA[           SELECT SETTINGS-FILE ASSIGN TO WS-SETTINGS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS SET-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT TOPICS-FILE ASSIGN TO WS-TOPICS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS TOP-ID
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT FOLDERS-FILE ASSIGN TO WS-FOLDERS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS FLD-KEY
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
]]></file-control>
  <file-section><![CDATA[       FD SETTINGS-FILE IS GLOBAL.
       01 SETTINGS-REC.
           05 SET-NAME                           PIC    X(20).
           05 SET-VALUE                          PIC    X(200).
       FD TOPICS-FILE IS GLOBAL.
       01 TOPIC-REC.
           05 TOP-ID                             PIC    X(16).
           05 TOP-NAME                           PIC    X(40).
           05 TOP-PROMPT                         PIC    X(1000).
           05 TOP-CREATED                        PIC    X(14).
           *>   "Y" for a topic the sample installer made, so it can be removed.

           05 TOP-SAMPLE                         PIC    X.
       FD FOLDERS-FILE IS GLOBAL.
       *>   A topic's document folders (R49), so a folder exists before its
       *>   first document does.

       01 FOLDER-REC.
           05 FLD-KEY.
               10 FLD-TOPIC                      PIC    X(16).
               10 FLD-PATH                       PIC    X(200).
]]></file-section>
  <user-procedures>
    <Event name="PC-PATHS" paragraph="PC-PATHS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Where PowerChat keeps its own files: POWERCHAT_DATA, else "data".

           DISPLAY    "POWERCHAT_DATA" UPON ENVIRONMENT-NAME
           ACCEPT    WS-DATA-DIR FROM ENVIRONMENT-VALUE
           IF    WS-DATA-DIR = SPACES
               SET     WS-DATA-DIR               TO    "data"
           END-IF
           SET     WS-SETTINGS-PATH              TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/settings.idx" INTO WS-SETTINGS-PATH
           SET     WS-TOPICS-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/topics.idx" INTO WS-TOPICS-PATH
           SET     WS-FOLDERS-PATH               TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/folders.idx" INTO WS-FOLDERS-PATH
]]></Event>
    <Event name="PC-SETTING-GET" paragraph="PC-SETTING-GET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME in, WS-SET-VALUE out (spaces when the setting is unset).

           SET     WS-SET-VALUE                  TO    SPACES
           *> Status 35 = the file is not there yet (first run): create it empty and
           *> reopen it, so the read below finds a file without the setting rather
           *> than failing.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF
           SET     SET-NAME                      TO    WS-SET-NAME
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE SET-VALUE TO WS-SET-VALUE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-SETTING-PUT" paragraph="PC-SETTING-PUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME, WS-SET-VALUE in. Written and committed at once (R10f).

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF

           SET     SET-NAME                      TO    WS-SET-NAME
           SET     SET-VALUE                     TO    WS-SET-VALUE

           *> One record per setting name: WRITE adds a new name, INVALID KEY (the
           *> name is already there) turns it into an update in place.

           WRITE    SETTINGS-REC
               INVALID KEY REWRITE SETTINGS-REC
           END-WRITE
           COMMIT
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-LIST-DOCS" paragraph="PC-LIST-DOCS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The topic's documents and folders as a tree (R49): gathered into
           *>   WS-TREE, sorted so each folder comes right before what is in it,
           *>   then added node by node.

           SET     WS-NODE-N                     TO    0
           SET     WS-DOC-COUNT                  TO    KB-D::ListDocuments()

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-DOC-COUNT
               SET     WS-DOC                    TO    KB-D::GetDocument(WS-I)
               SET     WS-ONE-KIND               TO    "D"
               SET     WS-ONE-PATH               TO    WS-DOC::Trim()

               *> PC-TREE-ADD: puts the path WS-ONE-PATH and every folder above it into WS-TREE,
               *> each only once.
               *> Uses:   WS-ONE-KIND = "D" and WS-ONE-PATH = WS-DOC trimmed, the WS-I-th document
               *>         of the topic as KB-D::GetDocument(WS-I) gave it (a path under the
               *>         documents folder, such as "policies/leave.md"); the rows of WS-TREE
               *>         already added.
               *> Result: WS-TREE gains a "D" row for the document and an "F" row for each parent
               *>         folder not in it yet (WS-NODE-N grows; the table holds 1000 rows at most).
               *>         WS-ONE-KIND and WS-ONE-PATH end as they were; WS-FOUND and WS-J are
               *>         overwritten, and WS-L and WS-KEY-TMP whenever a row is added.

               CALL    "PC-TREE-ADD"
           END-PERFORM
           *>   The folders made here, including the empty ones.

           *> WS-FS doubles as the loop flag: anything but "00" ends the scan - no
           *> folders file yet, a failed START, the end of the file, or the first
           *> record of another topic (the last three set it to "10" by hand).

           OPEN    INPUT FOLDERS-FILE
           IF    WS-FS = "00"
               SET     FLD-TOPIC                 TO    WS-CUR-TOPIC
               SET     FLD-PATH                  TO    LOW-VALUES

               START    FOLDERS-FILE KEY IS NOT LESS THAN FLD-KEY
                   INVALID KEY MOVE "10" TO WS-FS
               END-START
               PERFORM    UNTIL WS-FS NOT = "00"
                   READ    FOLDERS-FILE NEXT
                       AT END MOVE "10" TO WS-FS
                   END-READ
                   IF    WS-FS = "00"
                       IF    FLD-TOPIC NOT = WS-CUR-TOPIC
                           SET     WS-FS         TO    "10"
                       ELSE
                           SET     WS-ONE-KIND   TO    "F"
                           SET     WS-ONE-PATH   TO    FLD-PATH

                           *> PC-TREE-ADD: puts the path WS-ONE-PATH and every folder above it into
                           *> WS-TREE, each only once.
                           *> Uses:   WS-ONE-KIND = "F" and WS-ONE-PATH = FLD-PATH, the folder path
                           *>         just read from FOLDERS-FILE for the topic in WS-CUR-TOPIC; the
                           *>         rows of WS-TREE already added.
                           *> Result: WS-TREE gains an "F" row for that folder, and for any parent
                           *>         folder above it that is not there yet (a folder that holds a
                           *>         document is already in); WS-NODE-N grows accordingly.
                           *>         WS-ONE-KIND and WS-ONE-PATH end as they were; WS-FOUND and
                           *>         WS-J are overwritten, and WS-L and WS-KEY-TMP whenever a row
                           *>         is added.

                           CALL    "PC-TREE-ADD"
                       END-IF
                   END-IF
               END-PERFORM
               CLOSE    FOLDERS-FILE
           END-IF
           *>   Insertion sort on the key; a topic holds tens of entries.

           PERFORM    VARYING WS-J FROM 2 BY 1 UNTIL WS-J > WS-NODE-N
               SET     WS-NODE-TMP               TO    WS-NODE(WS-J)
               SET     WS-K                      TO    WS-J
               SET     WS-FOUND                  TO    "N"

               PERFORM    UNTIL WS-K < 2 OR WS-FOUND = "Y"
                   COMPUTE    WS-K1 = WS-K - 1
                   IF    WS-NODE-KEY(WS-K1) > TMP-KEY
                       SET     WS-NODE(WS-K)     TO    WS-NODE(WS-K1)
                       SET     WS-K              TO    WS-K1
                   ELSE
                       SET     WS-FOUND          TO    "Y"
                   END-IF
               END-PERFORM
               SET     WS-NODE(WS-K)             TO    WS-NODE-TMP
           END-PERFORM
           SET     WS-OK                         TO    Trv-Docs::Clear()
           PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-NODE-N
               *>       Depth from 1 (a top-level entry), one more per "/".

               SET     WS-DEPTH                  TO    1
               INSPECT    WS-NODE-PATH(WS-J) TALLYING WS-DEPTH FOR ALL "/"

               *> The label is what follows the last "/" (WS-P stays 0 for a top-level
               *> entry, so the whole path is the label).

               SET     WS-L                      TO    FUNCTION LENGTH(WS-NODE-PATH(WS-J)::Trim())
               SET     WS-P                      TO    0

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L
                   IF    WS-NODE-PATH(WS-J)(WS-K:1) = "/"
                       SET     WS-P              TO    WS-K
                   END-IF
               END-PERFORM

               SET     WS-NAME                   TO    SPACES
               SET     WS-NAME                   TO    WS-NODE-PATH(WS-J)(WS-P + 1:WS-L - WS-P)

               *>       A folder with something under it takes the tree's own
               *>       open/shut folder icon; an empty one has to be told.

               SET     WS-ICON                   TO    SPACES
               IF    WS-NODE-KIND(WS-J) = "F"
                   SET     WS-ICON               TO    "folder"
                   *> The sort puts a folder's contents right after it, so the next row is
                   *> enough: it starts with "path/" only when the folder is not empty.

                   IF    WS-J < WS-NODE-N
                       COMPUTE    WS-K1 = WS-J + 1
                       SET     WS-KEY-TMP        TO    SPACES
                       STRING    WS-NODE-PATH(WS-J)::Trim() "/" INTO WS-KEY-TMP
                       IF    WS-NODE-PATH(WS-K1)(1:WS-L + 1) = WS-KEY-TMP(1:WS-L + 1)
                           SET     WS-ICON       TO    SPACES
                       END-IF
                   END-IF
               END-IF
               IF    WS-ICON = SPACES
                   SET     WS-OK                 TO    Trv-Docs::AddNode(WS-DEPTH, WS-NAME::Trim())
               ELSE
                   MOVE    Trv-Docs::AddNode(WS-DEPTH, WS-NAME::Trim(),
                   WS-ICON::Trim()) TO WS-OK
               END-IF
           END-PERFORM

           SET     WS-N1                         TO    WS-DOC-COUNT
           SET     WS-FMT                        TO    T-DOC-COUNT
           SET     WS-ARG1                       TO    WS-N1

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-DOC-COUNT ("&1 document(s)." in English) and WS-ARG1 = WS-N1, the
           *>         document count WS-DOC-COUNT that KB-D::ListDocuments() reported.
           *> Result: WS-FMT-OUT = the count as a sentence in the user's language, e.g. "3
           *>         document(s)."; the next line shows it in Lbl-Count::Caption.

           CALL    "PC-FMT"
           SET     Lbl-Count::Caption            TO    WS-FMT-OUT::Trim()

           *> PC-SELECT-SYNC: finds the selection again in WS-TREE after a rebuild or a click, and
           *> works out the folder new documents go into.
           *> Uses:   WS-SEL-KIND and WS-SEL-PATH (the selection, kept by path), WS-NODE-N, the rows
           *>         of WS-TREE and WS-DOCS-DIR. (WS-TREE was just rebuilt above.)
           *> Result: WS-SEL-IX = the row of the selection (0 when it is not there: WS-SEL-KIND and
           *>         WS-SEL-PATH are then cleared to SPACES); WS-FOLDER = the selected folder, or
           *>         the folder holding the selected document (SPACES = top level); WS-LINE = that
           *>         folder on disk (WS-DOCS-DIR/WS-FOLDER). WS-J is overwritten when WS-SEL-PATH
           *>         was not SPACES; WS-K, WS-L and WS-P when the selection is a document.

           CALL    "PC-SELECT-SYNC"
]]></Event>
    <Event name="PC-TREE-ADD" paragraph="PC-TREE-ADD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 LK-KIND                                PIC    X.
       01 LK-PATH                                PIC    X(260).
       01 LK-L                                   PIC    9(4).
       01 LK-P                                   PIC    9(4).

       PROCEDURE DIVISION.
           *>   WS-ONE-PATH (of kind WS-ONE-KIND) and every folder above it go
           *>   into WS-TREE, each once.

           *> WS-ONE-KIND and WS-ONE-PATH are reused for each parent folder, so the
           *> caller's values wait in LK-* and go back for the last row. Every "/"
           *> past the first character closes a parent folder that needs its row.

           SET     LK-KIND                       TO    WS-ONE-KIND
           SET     LK-PATH                       TO    WS-ONE-PATH
           SET     LK-L                          TO    FUNCTION LENGTH(FUNCTION TRIM(LK-PATH))

           PERFORM    VARYING LK-P FROM 2 BY 1 UNTIL LK-P > LK-L
               IF    LK-PATH(LK-P:1) = "/"
                   SET     WS-ONE-KIND           TO    "F"
                   SET     WS-ONE-PATH           TO    SPACES
                   SET     WS-ONE-PATH           TO    LK-PATH(1:LK-P - 1)

                   *> PC-TREE-ONE: adds one row to WS-TREE for WS-ONE-PATH unless that path is
                   *> already in it.
                   *> Uses:   WS-ONE-KIND = "F" and WS-ONE-PATH = LK-PATH(1:LK-P - 1), the part of
                   *>         the path before the "/" at position LK-P: one parent folder of the
                   *>         item being added; WS-NODE-N and the rows of WS-TREE.
                   *> Result: When that folder is not in WS-TREE yet and the table has room,
                   *>         WS-NODE-N grows by one and the new row holds "F", the path and its
                   *>         sort key (the path with "/" turned into X"01", LOW-VALUES after it);
                   *>         otherwise nothing changes. WS-FOUND and WS-J are overwritten; when a
                   *>         row is added, WS-L and WS-KEY-TMP too.

                   CALL    "PC-TREE-ONE"
               END-IF
           END-PERFORM

           SET     WS-ONE-KIND                   TO    LK-KIND
           SET     WS-ONE-PATH                   TO    LK-PATH

           *> PC-TREE-ONE: adds one row to WS-TREE for WS-ONE-PATH unless that path is already in
           *> it.
           *> Uses:   WS-ONE-KIND and WS-ONE-PATH, put back just above to the kind and path that
           *>         PC-TREE-ADD was called with (kept in LK-KIND and LK-PATH); WS-NODE-N and the
           *>         rows of WS-TREE.
           *> Result: Unless that path is already in WS-TREE (and the table has room), WS-NODE-N
           *>         grows by one and the new row holds the item's kind, its path and its sort key
           *>         (the path with "/" turned into X"01", LOW-VALUES after it). WS-FOUND and WS-J
           *>         are overwritten; when a row is added, WS-L and WS-KEY-TMP too.

           CALL    "PC-TREE-ONE"
]]></Event>
    <Event name="PC-TREE-ONE" paragraph="PC-TREE-ONE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   One row, unless the path is there already. The sort key is the
           *>   path with "/" below every other character and LOW-VALUES after it,
           *>   so a folder sorts right before its own contents.

           SET     WS-FOUND                      TO    "N"
           PERFORM    VARYING WS-J FROM 1 BY 1
                   UNTIL WS-J > WS-NODE-N OR WS-FOUND = "Y"
               IF    WS-NODE-PATH(WS-J) = WS-ONE-PATH
                   SET     WS-FOUND              TO    "Y"
               END-IF
           END-PERFORM
           *> WS-TREE holds 1000 rows; once it is full, further entries are left
           *> out without any message.

           IF    WS-FOUND = "N" AND WS-NODE-N < 1000
               ADD    1 TO WS-NODE-N

               SET     WS-NODE-KIND(WS-NODE-N)   TO    WS-ONE-KIND
               SET     WS-NODE-PATH(WS-NODE-N)   TO    WS-ONE-PATH
               SET     WS-KEY-TMP                TO    LOW-VALUES
               SET     WS-L                      TO    FUNCTION LENGTH(WS-ONE-PATH::Trim())
               SET     WS-KEY-TMP(1:WS-L)        TO    WS-ONE-PATH(1:WS-L)

               INSPECT    WS-KEY-TMP(1:WS-L) CONVERTING "/" TO X"01"
               SET     WS-NODE-KEY(WS-NODE-N)    TO    WS-KEY-TMP
           END-IF
]]></Event>
    <Event name="PC-SELECT-SYNC" paragraph="PC-SELECT-SYNC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Find the selection again after a rebuild, and point the drop zone
           *>   at the folder it names - a document's own folder - or at the top.

           SET     WS-SEL-IX                     TO    0
           IF    WS-SEL-PATH NOT = SPACES
               PERFORM    VARYING WS-J FROM 1 BY 1
                       UNTIL WS-J > WS-NODE-N OR WS-SEL-IX > 0
                   IF    WS-NODE-PATH(WS-J) = WS-SEL-PATH
                           AND WS-NODE-KIND(WS-J) = WS-SEL-KIND
                       SET     WS-SEL-IX         TO    WS-J
                   END-IF
               END-PERFORM
           END-IF
           SET     WS-FOLDER                     TO    SPACES
           IF    WS-SEL-IX = 0
               SET     WS-SEL-KIND WS-SEL-PATH   TO    SPACES
           ELSE
               IF    WS-SEL-KIND = "F"
                   SET     WS-FOLDER             TO    WS-SEL-PATH
               ELSE
                   SET     WS-L                  TO    FUNCTION LENGTH(WS-SEL-PATH::Trim())
                   SET     WS-P                  TO    0

                   PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L
                       IF    WS-SEL-PATH(WS-K:1) = "/"
                           SET     WS-P          TO    WS-K
                       END-IF
                   END-PERFORM
                   IF    WS-P > 1
                       SET     WS-FOLDER         TO    WS-SEL-PATH(1:WS-P - 1)
                   END-IF
               END-IF
           END-IF
           SET     WS-LINE                       TO    SPACES
           IF    WS-FOLDER = SPACES
               SET     WS-LINE                   TO    WS-DOCS-DIR
           ELSE
               STRING    WS-DOCS-DIR::Trim() "/" WS-FOLDER::Trim() INTO WS-LINE
           END-IF
           *>   The zone copies nothing itself (uploads are imported, asking
           *>   first when a name is taken): WS-FOLDER is where they go.
]]></Event>
    <Event name="PC-TEXTS" paragraph="PC-TEXTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language the user picked (LANG), the texts in it, and every
           *>   designed caption and hint that shows one. Called on load and again
           *>   whenever the language changes (R46).

           SET     WS-SET-NAME                   TO    "LANG"

           *> PC-SETTING-GET: reads one setting from SETTINGS-FILE (indexed,
           *> <WS-DATA-DIR>/settings.idx) by its name; it never writes a setting (a missing file is
           *> only created, empty).
           *> Uses:   WS-SET-NAME = "LANG" (set just above), the record key.
           *> Result: WS-SET-VALUE = the saved language code (PC-TEXTS reads its first two
           *>         characters), or SPACES when it was never saved. WS-SET-NAME is unchanged;
           *>         WS-FS and the record area SETTINGS-REC are overwritten.

           CALL    "PC-SETTING-GET"
           SET     WS-LANG                       TO    WS-SET-VALUE(1:2)
           *> WS-LANG-IX is the language's column in PC-TEXT (en pt es fr jp cn);
           *> an unset or unknown code means English. The copy loop below must run
           *> over every row of PC-TEXT, so its bound has to match the OCCURS.

           EVALUATE    WS-LANG
               WHEN "en" MOVE 1 TO WS-LANG-IX
               WHEN "pt" MOVE 2 TO WS-LANG-IX
               WHEN "es" MOVE 3 TO WS-LANG-IX
               WHEN "fr" MOVE 4 TO WS-LANG-IX
               WHEN "jp" MOVE 5 TO WS-LANG-IX
               WHEN "cn" MOVE 6 TO WS-LANG-IX
               WHEN OTHER MOVE "en" TO WS-LANG
                   SET     WS-LANG-IX            TO    1
           END-EVALUATE
           PERFORM    VARYING WS-TX-I FROM 1 BY 1 UNTIL WS-TX-I > 54
               SET     PC-TEXT-NOW(WS-TX-I)      TO    PC-TEXT(WS-TX-I, WS-LANG-IX)
           END-PERFORM

           SET     Lbl-Title::Caption            TO    T-DOCS-TITLE::Trim()
           SET     Drop-Docs::Hint               TO    T-DROP-HINT::Trim()
           SET     Btn-Delete::Caption           TO    T-DELETE::Trim()
           SET     Btn-Preview::Caption          TO    T-PREVIEW::Trim()
           SET     Btn-Refresh::Caption          TO    T-REFRESH::Trim()
           SET     Btn-NewFolder::Caption        TO    T-NEW-FOLDER::Trim()
           SET     Txt-Folder::HintText          TO    T-FOLDER-HINT::Trim()
           SET     Lbl-Status::Caption           TO    T-STATUS::Trim()
           SET     Btn-MoveTop::Caption          TO    T-MOVE-TOP::Trim()

           *> PC-MOVE-UI: sets the Move and To-the-top-level buttons for the next press.
           *> Uses:   WS-MOVE-SRC (the document picked for a move, SPACES when none) and
           *>         WS-MOVE-STEP (SPACE unless a move is running); T-MOVE and T-MOVE-HERE were
           *>         reloaded in the user's language just above.
           *> Result: Btn-Move::Caption = T-MOVE ("Move") and Btn-MoveTop::Enabled = "false" while
           *>         no document is picked or a move is running; otherwise "Move here" and "true".
           *>         No data item changes.

           CALL    "PC-MOVE-UI"

           SET     WS-FMT                        TO    T-ACCEPTED-TYPES
           SET     WS-ARG1                       TO    WS-DOC-TYPES

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-ACCEPTED-TYPES ("Accepted types: &1" in English) and WS-ARG1 =
           *>         WS-DOC-TYPES, the list of file extensions the Knowledge Base can read (".md
           *>         .markdown .txt ...").
           *> Result: WS-FMT-OUT = "Accepted types: .md .markdown .txt ..." in the user's language;
           *>         the next line shows it in Lbl-Types::Caption.

           CALL    "PC-FMT"
           SET     Lbl-Types::Caption            TO    WS-FMT-OUT::Trim()
]]></Event>
    <Event name="PC-UP-NEXT" paragraph="PC-UP-NEXT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Import the next queued upload; when none is left, the summary.
           *>   Busy with something else: stay queued - onIndexed calls back.

           IF    WS-UP-STEP NOT = SPACE
               EXIT PROGRAM
           END-IF
           SET     WS-UP-CUR                     TO    0
           PERFORM    VARYING WS-UP-I FROM 1 BY 1
                   UNTIL WS-UP-I > WS-UP-N OR WS-UP-CUR > 0
               IF    WS-UP-STATE(WS-UP-I) = "Q"
                   SET     WS-UP-CUR             TO    WS-UP-I
               END-IF
           END-PERFORM
           IF    WS-UP-CUR = 0
               IF    WS-UP-N > 1
                   SET     WS-FMT                TO    T-UP-SUMMARY
                   SET     WS-KB1                TO    WS-UP-ADDED
                   SET     WS-ARG1               TO    WS-KB1
                   SET     WS-KB1                TO    WS-UP-UPDATED
                   SET     WS-ARG2               TO    WS-KB1
                   SET     WS-KB1                TO    WS-UP-KEPT
                   SET     WS-ARG3               TO    WS-KB1

                   *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
                   *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
                   *> Uses:   WS-FMT = T-UP-SUMMARY ("&1 added, &2 updated, &3 not replaced." in
                   *>         English); WS-ARG1 = WS-UP-ADDED, WS-ARG2 = WS-UP-UPDATED and WS-ARG3 =
                   *>         WS-UP-KEPT (the three counters of this batch, via WS-KB1).
                   *> Result: WS-FMT-OUT = e.g. "3 added, 1 updated, 0 not replaced."; the next line
                   *>         shows it in Lbl-Status::Caption.

                   CALL    "PC-FMT"
                   SET     Lbl-Status::Caption   TO    WS-FMT-OUT::Trim()
               END-IF
               SET     WS-UP-N                   TO    0
               EXIT PROGRAM
           END-IF
           SET     KB-D::SearchModeReason        TO    SPACES
           MOVE    KB-D::ImportDocument(WS-UP-SRC(WS-UP-CUR)::Trim(),
           WS-UP-DEST(WS-UP-CUR)::Trim()) TO WS-OK
           IF    WS-OK NOT = "1"
               *>       Another update is running: this one waits for its end.

               EXIT PROGRAM
           END-IF

           SET     WS-UP-STEP                    TO    "U"
           SET     WS-FMT                        TO    T-UP-SENDING
           SET     WS-ARG1                       TO    WS-UP-DEST(WS-UP-CUR)

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-UP-SENDING ("Adding &1 to the Knowledge Base..." in English) and
           *>         WS-ARG1 = WS-UP-DEST(WS-UP-CUR), the topic path of the upload now being
           *>         imported.
           *> Result: WS-FMT-OUT = "Adding <path> to the Knowledge Base..."; the next line shows it
           *>         in Lbl-Progress::Caption.

           CALL    "PC-FMT"
           SET     Lbl-Progress::Caption         TO    WS-FMT-OUT::Trim()
]]></Event>
    <Event name="PC-PREVIEW" paragraph="PC-PREVIEW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The selected document, shown in PREVIEW-FORM (a modal window).

           IF    WS-SEL-IX = 0 OR WS-SEL-KIND NOT = "D"
               SET     Lbl-Status::Caption       TO    T-PICK-DOC-TO-PREVIEW::Trim()
               EXIT PROGRAM
           END-IF
           SET     WS-LINE                       TO    SPACES
           STRING    WS-DOCS-DIR::Trim() "/" WS-SEL-PATH::Trim() INTO WS-LINE

           INVOKE    ME::SetProperty("PreviewPath", WS-LINE)
           INVOKE    ME::SetProperty("PreviewTitle", WS-SEL-PATH)
           INVOKE    ME::SetProperty("PreviewClose", T-CLOSE)
           INVOKE    ME::OpenFormSync("PREVIEW-FORM")
]]></Event>
    <Event name="PC-KB-REFRESH" paragraph="PC-KB-REFRESH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Bring the index up to date with the folder. SearchModeReason is
           *>   only written when there is something to say, so it is cleared
           *>   first: an old warning must not outlive a clean update.

           SET     KB-D::SearchModeReason        TO    SPACES
           SET     WS-OK                         TO    KB-D::Refresh()

           IF    WS-OK NOT = "1"
               SET     Lbl-Status::Caption       TO    KB-D::LastError
           ELSE
               SET     Lbl-Progress::Caption     TO    T-KB-UPDATING::Trim()
           END-IF
]]></Event>
    <Event name="PC-MOVE-UI" paragraph="PC-MOVE-UI"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The Move button says what the next press does: pick the document,
           *>   or place the one picked. "To the top level" only while one is.

           IF    WS-MOVE-SRC = SPACES OR WS-MOVE-STEP NOT = SPACE
               SET     Btn-Move::Caption         TO    T-MOVE::Trim()
               SET     Btn-MoveTop::Enabled      TO    "false"
           ELSE
               SET     Btn-Move::Caption         TO    T-MOVE-HERE::Trim()
               SET     Btn-MoveTop::Enabled      TO    "true"
           END-IF
]]></Event>
    <Event name="PC-MOVE-GO" paragraph="PC-MOVE-GO"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 LK-FILE                                PIC    X(260).

       PROCEDURE DIVISION.
           *>   WS-MOVE-SRC goes into folder WS-MOVE-TO (spaces: the top level).
           *>   Step one copies it there through the Knowledge Base, which indexes
           *>   the copy; onIndexed then deletes the original (step two).

           SET     WS-L                          TO    FUNCTION LENGTH(WS-MOVE-SRC::Trim())
           SET     WS-P                          TO    0

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L
               IF    WS-MOVE-SRC(WS-K:1) = "/"
                   SET     WS-P                  TO    WS-K
               END-IF
           END-PERFORM

           SET     LK-FILE                       TO    SPACES
           SET     LK-FILE                       TO    WS-MOVE-SRC(WS-P + 1:WS-L - WS-P)
           SET     WS-MOVE-DEST                  TO    SPACES

           IF    WS-MOVE-TO = SPACES
               SET     WS-MOVE-DEST              TO    FUNCTION TRIM(LK-FILE)
           ELSE
               STRING    WS-MOVE-TO::Trim() "/" FUNCTION TRIM(LK-FILE) INTO WS-MOVE-DEST
           END-IF
           IF    WS-MOVE-DEST = WS-MOVE-SRC
               SET     WS-MOVE-SRC               TO    SPACES

               *> PC-MOVE-UI: sets the Move and To-the-top-level buttons for the next press (here:
               *> the move is dropped: the target is where the document already is).
               *> Uses:   WS-MOVE-SRC, just cleared to SPACES, and WS-MOVE-STEP (SPACE).
               *> Result: Btn-Move::Caption = T-MOVE ("Move") and Btn-MoveTop::Enabled = "false". No
               *>         data item changes.

               CALL    "PC-MOVE-UI"
               SET     Lbl-Status::Caption       TO    T-MOVE-SAME::Trim()
               EXIT PROGRAM
           END-IF
           *>   Never over another document: the copy would replace it.

           SET     WS-FOUND                      TO    "N"
           PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-NODE-N
               IF    WS-NODE-PATH(WS-J) = WS-MOVE-DEST
                   SET     WS-FOUND              TO    "Y"
               END-IF
           END-PERFORM
           IF    WS-FOUND = "Y"
               SET     WS-FMT                    TO    T-MOVE-EXISTS
               SET     WS-ARG1                   TO    WS-MOVE-DEST

               *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
               *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
               *> Uses:   WS-FMT = T-MOVE-EXISTS ("A document of that name is already there: &1." in
               *>         English) and WS-ARG1 = WS-MOVE-DEST, the target path that is already in
               *>         the tree.
               *> Result: WS-FMT-OUT = that sentence with the path in it; Lbl-Status::Caption shows
               *>         it a few lines below.

               CALL    "PC-FMT"
               SET     WS-MOVE-SRC               TO    SPACES

               *> PC-MOVE-UI: sets the Move and To-the-top-level buttons for the next press (here:
               *> the move is dropped: the target name is taken).
               *> Uses:   WS-MOVE-SRC, just cleared to SPACES, and WS-MOVE-STEP (SPACE).
               *> Result: Btn-Move::Caption = T-MOVE ("Move") and Btn-MoveTop::Enabled = "false". No
               *>         data item changes.

               CALL    "PC-MOVE-UI"
               SET     Lbl-Status::Caption       TO    WS-FMT-OUT::Trim()
               EXIT PROGRAM
           END-IF
           SET     WS-LINE                       TO    SPACES
           STRING    WS-DOCS-DIR::Trim() "/" WS-MOVE-SRC::Trim() INTO WS-LINE
           MOVE    KB-D::ImportDocument(WS-LINE::Trim(),
           WS-MOVE-DEST::Trim()) TO WS-OK
           IF    WS-OK NOT = "1"
               SET     WS-MOVE-SRC               TO    SPACES

               *> PC-MOVE-UI: sets the Move and To-the-top-level buttons for the next press (here:
               *> the move is dropped: KB-D did not accept the import).
               *> Uses:   WS-MOVE-SRC, just cleared to SPACES, and WS-MOVE-STEP (SPACE).
               *> Result: Btn-Move::Caption = T-MOVE ("Move") and Btn-MoveTop::Enabled = "false". No
               *>         data item changes.

               CALL    "PC-MOVE-UI"
               SET     Lbl-Status::Caption       TO    KB-D::LastError
               EXIT PROGRAM
           END-IF
           SET     WS-MOVE-STEP                  TO    "I"

           *> PC-MOVE-UI: sets the Move and To-the-top-level buttons for the next press (here: the
           *> copy has been handed to KB-D to be indexed).
           *> Uses:   WS-MOVE-STEP = "I" (set just above) and WS-MOVE-SRC, still the document being
           *>         moved.
           *> Result: Btn-Move::Caption = T-MOVE ("Move") and Btn-MoveTop::Enabled = "false" while
           *>         the move runs. No data item changes.

           CALL    "PC-MOVE-UI"
           SET     Lbl-Progress::Caption         TO    T-KB-UPDATING::Trim()
]]></Event>
    <Event name="PC-FMT" paragraph="PC-FMT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-FROM                                PIC    9(4).
       01 WS-CNT                                 PIC    9(4).
       01 WS-PART                                PIC    X(70).
       01 WS-DELIM                               PIC    XX.

       PROCEDURE DIVISION.
           *>   A message whose words go round numbers and names differently in each
           *>   language: WS-FMT holds "&1" .. "&4" where WS-ARG1..4 go.

           SET     WS-FMT-OUT                    TO    SPACES
           SET     WS-PT                         TO    1
           SET     WS-FROM                       TO    1

           PERFORM    UNTIL WS-FROM > FUNCTION LENGTH(WS-FMT)
               SET     WS-PART WS-DELIM          TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-FMT DELIMITED BY "&1" OR "&2" OR "&3" OR "&4"
                   INTO WS-PART DELIMITER IN WS-DELIM COUNT IN WS-CNT
                   WITH POINTER WS-FROM
               END-UNSTRING
               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-FMT-OUT WITH POINTER WS-PT
               END-IF
               *> No placeholder left (WS-DELIM stayed spaces): WS-PART already holds
               *> the tail of the text, so push WS-FROM past the end to leave the loop.

               EVALUATE    WS-DELIM
                   WHEN "&1" STRING WS-ARG1::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&2" STRING WS-ARG2::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&3" STRING WS-ARG3::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&4" STRING WS-ARG4::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN OTHER COMPUTE WS-FROM = FUNCTION LENGTH(WS-FMT) + 1
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-OPEN" paragraph="PC-OPEN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   What the form shows: run on load, and again when it comes back.

           *> PC-PATHS: sets the paths of the three indexed files PowerChat reads here.
           *> Uses:   The environment variable POWERCHAT_DATA.
           *> Result: WS-DATA-DIR = $POWERCHAT_DATA, or "data" when that is empty; WS-SETTINGS-PATH
           *>         = <WS-DATA-DIR>/settings.idx, WS-TOPICS-PATH = <WS-DATA-DIR>/topics.idx,
           *>         WS-FOLDERS-PATH = <WS-DATA-DIR>/folders.idx. No file is opened.

           CALL    "PC-PATHS"

           *> PC-TEXTS: loads the form's texts in the language the user picked and sets every
           *> designed caption, hint and button state that shows one.
           *> Uses:   The LANG setting in the settings file whose path PC-PATHS just set
           *>         (WS-SETTINGS-PATH), PC-TEXT (54 texts x 6 languages en pt es fr jp cn),
           *>         WS-DOC-TYPES and, for the Move buttons, WS-MOVE-SRC and WS-MOVE-STEP.
           *> Result: WS-LANG = the saved code ("en" when unset or unknown), WS-LANG-IX = its column
           *>         1-6, PC-TEXT-NOW(1..54) (the T-... names) = that column; titles, hints and
           *>         buttons are set in that language, Lbl-Status::Caption = T-STATUS,
           *>         Lbl-Types::Caption = "Accepted types: <extensions>". WS-SET-NAME = "LANG" and
           *>         WS-SET-VALUE hold the lookup; WS-FMT, WS-ARG1 and WS-FMT-OUT are overwritten.
           *>         WS-TX-I and WS-FS are overwritten.

           CALL    "PC-TEXTS"

           *>   The zone refuses whatever the Knowledge Base could not read.

           SET     Drop-Docs::AllowedExtensions  TO    WS-DOC-TYPES
           SET     WS-SET-NAME                   TO    "CUR-TOPIC"

           *> PC-SETTING-GET: reads one setting from SETTINGS-FILE (indexed,
           *> <WS-DATA-DIR>/settings.idx) by its name; it never writes a setting (a missing file is
           *> only created, empty).
           *> Uses:   WS-SET-NAME = "CUR-TOPIC" (set just above), the record key.
           *> Result: WS-SET-VALUE = the id of the current topic (set by Open in TOPICS-FORM or by
           *>         New conversation in the chat form), or SPACES when none; WS-CUR-TOPIC takes
           *>         its first 16 characters next. WS-SET-NAME is unchanged; WS-FS and the record
           *>         area SETTINGS-REC are overwritten.

           CALL    "PC-SETTING-GET"

           SET     WS-CUR-TOPIC                  TO    WS-SET-VALUE(1:16)
           SET     WS-SET-NAME                   TO    "KB-LOCATION"

           *> PC-SETTING-GET: reads one setting from SETTINGS-FILE (indexed,
           *> <WS-DATA-DIR>/settings.idx) by its name; it never writes a setting (a missing file is
           *> only created, empty).
           *> Uses:   WS-SET-NAME = "KB-LOCATION" (set just above), the record key.
           *> Result: WS-SET-VALUE = the Knowledge Base folder saved by KB-FOLDER-FORM (Save) or
           *>         restored by the settings form's Import, or SPACES; the next lines copy it to
           *>         WS-KB-LOCATION and fall back to "assets/KB". WS-SET-NAME is unchanged; WS-FS
           *>         and the record area SETTINGS-REC are overwritten.

           CALL    "PC-SETTING-GET"
           SET     WS-KB-LOCATION                TO    WS-SET-VALUE
           IF    WS-KB-LOCATION = SPACES
               SET     WS-KB-LOCATION            TO    "assets/KB"
           END-IF
           IF    WS-CUR-TOPIC = SPACES
               SET     Lbl-Status::Caption       TO    T-OPEN-TOPIC-FIRST::Trim()
               EXIT PROGRAM
           END-IF
           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF
           SET     TOP-ID                        TO    WS-CUR-TOPIC
           READ    TOPICS-FILE
               INVALID KEY MOVE "?" TO TOP-NAME
           END-READ
           CLOSE    TOPICS-FILE

           SET     WS-FMT                        TO    T-DOCS-OF
           SET     WS-ARG1                       TO    TOP-NAME

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-DOCS-OF ("Documents - &1" in English) and WS-ARG1 = TOP-NAME, the
           *>         name of the current topic read from TOPICS-FILE ("?" when its record is
           *>         missing).
           *> Result: WS-FMT-OUT = "Documents - <topic name>" in the user's language; the next line
           *>         shows it in Lbl-Title::Caption.

           CALL    "PC-FMT"

           SET     Lbl-Title::Caption            TO    WS-FMT-OUT::Trim()
           SET     KB-D::Location                TO    WS-KB-LOCATION
           SET     KB-D::Collection              TO    WS-CUR-TOPIC

           *>   Dropped files land in the collection's documents folder; a refresh
           *>   then indexes them. So does anything copied there by other means.
           *>   PC-SELECT-SYNC points the zone at the selected folder inside it.

           SET     WS-DOCS-DIR                   TO    SPACES
           STRING    WS-KB-LOCATION::Trim() "/" WS-CUR-TOPIC::Trim() "/documents" INTO WS-DOCS-DIR

           *> PC-LIST-DOCS: rebuilds the documents tree of the current topic: its documents (the
           *> files KB-D::ListDocuments finds in the documents folder on disk) and its folders
           *> (FOLDERS-FILE), sorted so a folder comes right before its contents, then adds them to
           *> Trv-Docs.
           *> Uses:   WS-CUR-TOPIC, KB-D::Location = WS-KB-LOCATION and KB-D::Collection =
           *>         WS-CUR-TOPIC (set above), WS-DOCS-DIR =
           *>         <WS-KB-LOCATION>/<WS-CUR-TOPIC>/documents, FOLDERS-FILE, and WS-SEL-KIND /
           *>         WS-SEL-PATH.
           *> Result: WS-TREE, WS-NODE-N and WS-DOC-COUNT hold the new rows; Trv-Docs shows them
           *>         (empty folders get the folder icon); Lbl-Count::Caption = "<n> document(s).".
           *>         The selection is found again by path: WS-SEL-IX, WS-FOLDER and WS-LINE (the
           *>         drop folder on disk) are set, and WS-SEL-KIND and WS-SEL-PATH are cleared to
           *>         SPACES when its row is gone. Always overwritten: WS-I, WS-J, WS-OK, WS-FS,
           *>         WS-N1, WS-FMT, WS-ARG1 and WS-FMT-OUT. Only when there is a row to list:
           *>         WS-ONE-KIND, WS-ONE-PATH, WS-FOUND, WS-KEY-TMP, WS-K, WS-L, WS-P, WS-DEPTH,
           *>         WS-NAME and WS-ICON (WS-DOC too when there is a document); with two rows or
           *>         more WS-K1 and WS-NODE-TMP; FLD-TOPIC and FLD-PATH only if the folders file
           *>         opens.

           CALL    "PC-LIST-DOCS"
           *>   The semantic model first - fetched once per installation, a quick
           *>   no-op after that - then pick up whatever changed in the folder
           *>   since the last run (R16). onIndexed runs the refresh after it.

           SET     WS-OK                         TO    KB-D::FetchModel()
           IF    WS-OK = "1"
               SET     WS-KB-STEP                TO    "M"
           END-IF
]]></Event>
    <Event name="PC-LANG-NOW" paragraph="PC-LANG-NOW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language saved now (LANG), into WS-LANG-NOW; "en" when unset.

           SET     WS-LANG-NOW                   TO    "en"
           *> Read only, unlike the other readers: a missing file (status 35) is
           *> not created here, it just means English.

           OPEN    INPUT SETTINGS-FILE
           IF    WS-FS NOT = "00"
               EXIT PROGRAM
           END-IF
           SET     SET-NAME                      TO    "LANG"
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   EVALUATE    SET-VALUE(1:2)
                       WHEN "pt" WHEN "es" WHEN "fr" WHEN "jp" WHEN "cn"
                           SET     WS-LANG-NOW   TO    SET-VALUE(1:2)
                   END-EVALUATE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-PROGRESS-IDLE" paragraph="PC-PROGRESS-IDLE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Indexing ended (done, busy or failed): the progress strip goes
           *>   back to empty. It stays in its place on the form.

           SET     Lbl-Progress::Caption         TO    SPACES
           SET     Prg-Index::Value              TO    0
           SET     Prg-Index::Visible            TO    FALSE
           SET     Lbl-Chunk::Visible            TO    FALSE
           SET     Prg-Chunk::Visible            TO    FALSE
           SET     Lbl-Embed::Visible            TO    FALSE
           SET     Prg-Embed::Visible            TO    FALSE
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="DOCUMENTS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PC-OPEN: loads what the form shows: paths, texts, the current topic and its documents
           *> tree, then starts fetching the semantic model (here: the form has just been loaded).
           *> Uses:   the environment variable POWERCHAT_DATA; the settings LANG, CUR-TOPIC and
           *>         KB-LOCATION; TOPICS-FILE (the topic's name); and what PC-LIST-DOCS reads.
           *> Result: the paths and texts are set; Drop-Docs::AllowedExtensions = WS-DOC-TYPES;
           *>         WS-CUR-TOPIC = the current topic and WS-KB-LOCATION = the Knowledge Base
           *>         folder ("assets/KB" when none is saved). With no topic it stops there and
           *>         Lbl-Status::Caption = T-OPEN-TOPIC-FIRST ("Open a topic first."). Otherwise
           *>         Lbl-Title::Caption = "Documents - <topic name>"; KB-D::Location =
           *>         WS-KB-LOCATION, KB-D::Collection = WS-CUR-TOPIC and WS-DOCS-DIR =
           *>         <WS-KB-LOCATION>/<WS-CUR-TOPIC>/documents; the documents tree and Lbl-Count
           *>         are filled; then KB-D::FetchModel() is asked: when it starts (WS-KB-STEP =
           *>         "M") the refresh follows from KB-D--ONINDEXED, or from KB-D--ONERROR if the
           *>         fetch fails; when it does not, no refresh is started.

           CALL    "PC-OPEN"
]]></Event>
    <Event name="onActivate" paragraph="DOCUMENTS-FORM--ONACTIVATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Back on the pane: the topic or the language may have changed.

           *> PC-OPEN: loads what the form shows: paths, texts, the current topic and its documents
           *> tree, then starts fetching the semantic model (here: the form is back on the pane, so
           *> the topic or the language may have changed).
           *> Uses:   the environment variable POWERCHAT_DATA; the settings LANG, CUR-TOPIC and
           *>         KB-LOCATION; TOPICS-FILE (the topic's name); and what PC-LIST-DOCS reads.
           *> Result: the paths and texts are set; Drop-Docs::AllowedExtensions = WS-DOC-TYPES;
           *>         WS-CUR-TOPIC = the current topic and WS-KB-LOCATION = the Knowledge Base
           *>         folder ("assets/KB" when none is saved). With no topic it stops there and
           *>         Lbl-Status::Caption = T-OPEN-TOPIC-FIRST ("Open a topic first."). Otherwise
           *>         Lbl-Title::Caption = "Documents - <topic name>"; KB-D::Location =
           *>         WS-KB-LOCATION, KB-D::Collection = WS-CUR-TOPIC and WS-DOCS-DIR =
           *>         <WS-KB-LOCATION>/<WS-CUR-TOPIC>/documents; the documents tree and Lbl-Count
           *>         are filled; then KB-D::FetchModel() is asked: when it starts (WS-KB-STEP =
           *>         "M") the refresh follows from KB-D--ONINDEXED, or from KB-D--ONERROR if the
           *>         fetch fails; when it does not, no refresh is started.

           CALL    "PC-OPEN"
]]></Event>
    <Event name="onClose" paragraph="DOCUMENTS-FORM--ONCLOSE">
    </Event>
  </form-events>
