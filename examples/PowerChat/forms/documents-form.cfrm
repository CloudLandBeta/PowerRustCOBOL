    <Event name="onNodeSelect" paragraph="TRV-DOCS--ONNODESELECT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       LINKAGE SECTION.
       01 CONTROL-NODE-DATA.
           05 CONTROL-NODE                       PIC    X(256).
           05 CONTROL-NODE-INDEX                 PIC    S9(4)    COMP-5.
           05 CONTROL-NODE-LEVEL                 PIC    S9(4)    COMP-5.
           05 CONTROL-NODE-CHECKED               PIC    9.

       PROCEDURE DIVISION USING CONTROL-NODE-DATA.
           *>   The node's index is its row in WS-TREE; the selection is kept by
           *>   path, and new documents dropped go into its folder.

           IF    CONTROL-NODE-INDEX > 0 AND CONTROL-NODE-INDEX NOT > WS-NODE-N
               SET     WS-J                      TO    CONTROL-NODE-INDEX
               SET     WS-SEL-KIND               TO    WS-NODE-KIND(WS-J)
               SET     WS-SEL-PATH               TO    WS-NODE-PATH(WS-J)
           END-IF

           *> PC-SELECT-SYNC: finds the selection again in WS-TREE after a rebuild or a click, and
           *> works out the folder new documents go into.
           *> Uses:   WS-SEL-KIND and WS-SEL-PATH (the selection, kept by path), WS-NODE-N, the rows
           *>         of WS-TREE and WS-DOCS-DIR. (When CONTROL-NODE-INDEX was a valid row,
           *>         WS-SEL-KIND and WS-SEL-PATH were just set from that row.)
           *> Result: WS-SEL-IX = the row of the selection (0 when it is not there: WS-SEL-KIND and
           *>         WS-SEL-PATH are then cleared to SPACES); WS-FOLDER = the selected folder, or
           *>         the folder holding the selected document (SPACES = top level); WS-LINE = that
           *>         folder on disk (WS-DOCS-DIR/WS-FOLDER). WS-J is overwritten when WS-SEL-PATH
           *>         was not SPACES; WS-K, WS-L and WS-P when the selection is a document.

           CALL    "PC-SELECT-SYNC"
           *>   While a document waits to be moved, say where Move here puts it.

           IF    WS-MOVE-SRC NOT = SPACES AND WS-MOVE-STEP = SPACE
               SET     WS-FMT                    TO    T-MOVE-INTO
               SET     WS-ARG1                   TO    WS-MOVE-SRC

               IF    WS-FOLDER = SPACES
                   SET     WS-ARG2               TO    T-TOP-LEVEL
               ELSE
                   SET     WS-ARG2               TO    WS-FOLDER
               END-IF

               *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
               *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
               *> Uses:   WS-FMT = T-MOVE-INTO ("Move here puts &1 into &2." in English); WS-ARG1 =
               *>         WS-MOVE-SRC, the document waiting to be moved; WS-ARG2 = WS-FOLDER, or
               *>         T-TOP-LEVEL ("the top level") when WS-FOLDER is SPACES.
               *> Result: WS-FMT-OUT = e.g. "Move here puts a.md into docs."; the next line shows it
               *>         in Lbl-Status::Caption.

               CALL    "PC-FMT"
               SET     Lbl-Status::Caption       TO    WS-FMT-OUT::Trim()
               EXIT PROGRAM
           END-IF
           SET     WS-FMT                        TO    T-DROP-INTO
           IF    WS-FOLDER = SPACES
               SET     WS-ARG1                   TO    T-TOP-LEVEL
           ELSE
               SET     WS-ARG1                   TO    WS-FOLDER
           END-IF

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-DROP-INTO ("New documents go into &1." in English) and WS-ARG1 =
           *>         WS-FOLDER, the folder a drop will go to, or T-TOP-LEVEL ("the top level") when
           *>         WS-FOLDER is SPACES.
           *> Result: WS-FMT-OUT = e.g. "New documents go into docs."; the next line shows it in
           *>         Lbl-Status::Caption.

           CALL    "PC-FMT"
           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()
]]></Event>
    <Event name="onNodeDblClick" paragraph="TRV-DOCS--ONNODEDBLCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       LINKAGE SECTION.
       01 CONTROL-NODE-DATA.
           05 CONTROL-NODE                       PIC    X(256).
           05 CONTROL-NODE-INDEX                 PIC    S9(4)    COMP-5.
           05 CONTROL-NODE-LEVEL                 PIC    S9(4)    COMP-5.
           05 CONTROL-NODE-CHECKED               PIC    9.

       PROCEDURE DIVISION USING CONTROL-NODE-DATA.
           *>   A double-click on a document previews it.

           IF    CONTROL-NODE-INDEX > 0 AND CONTROL-NODE-INDEX NOT > WS-NODE-N
               SET     WS-J                      TO    CONTROL-NODE-INDEX
               SET     WS-SEL-KIND               TO    WS-NODE-KIND(WS-J)
               SET     WS-SEL-PATH               TO    WS-NODE-PATH(WS-J)

               *> PC-SELECT-SYNC: finds the selection again in WS-TREE after a rebuild or a click,
               *> and works out the folder new documents go into.
               *> Uses:   WS-SEL-KIND and WS-SEL-PATH (the selection, kept by path), WS-NODE-N, the
               *>         rows of WS-TREE and WS-DOCS-DIR. (WS-SEL-KIND and WS-SEL-PATH were just
               *>         set from the double-clicked row WS-J.)
               *> Result: WS-SEL-IX = the row of the selection (0 when it is not there: WS-SEL-KIND
               *>         and WS-SEL-PATH are then cleared to SPACES); WS-FOLDER = the selected
               *>         folder, or the folder holding the selected document (SPACES = top level);
               *>         WS-LINE = that folder on disk (WS-DOCS-DIR/WS-FOLDER). WS-J is overwritten
               *>         when WS-SEL-PATH was not SPACES; WS-K, WS-L and WS-P when the selection is
               *>         a document.

               CALL    "PC-SELECT-SYNC"
               IF    WS-SEL-KIND = "D"

                   *> PC-PREVIEW: opens PREVIEW-FORM (modal) on the selected document.
                   *> Uses:   WS-SEL-IX (not 0 here), WS-SEL-KIND = "D" (tested just above),
                   *>         WS-SEL-PATH (the document's path under WS-DOCS-DIR), WS-DOCS-DIR and
                   *>         T-CLOSE.
                   *> Result: WS-LINE = WS-DOCS-DIR/WS-SEL-PATH, the file on disk. The form
                   *>         properties PreviewPath (= WS-LINE), PreviewTitle (= WS-SEL-PATH) and
                   *>         PreviewClose (= T-CLOSE) are set, PREVIEW-FORM opens modal
                   *>         (OpenFormSync) and the call returns when the user closes it.

                   CALL    "PC-PREVIEW"
               END-IF
           END-IF
]]></Event>
    <Event name="onNodeDrop" paragraph="TRV-DOCS--ONNODEDROP"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       LINKAGE SECTION.
       01 CONTROL-NODE-DATA.
           05 CONTROL-NODE                       PIC    X(256).
           05 CONTROL-NODE-INDEX                 PIC    S9(4)    COMP-5.
           05 CONTROL-NODE-LEVEL                 PIC    S9(4)    COMP-5.
           05 CONTROL-NODE-CHECKED               PIC    9.
           05 CONTROL-TARGET-INDEX               PIC    S9(4)    COMP-5.
           05 CONTROL-TARGET-NODE                PIC    X(256).

       PROCEDURE DIVISION USING CONTROL-NODE-DATA.
           *>   A document dragged onto a folder moves into it; onto a document,
           *>   into that document's folder; onto empty space, to the top level.
           *>   The move itself is the Move button's (PC-MOVE-GO): copy, index,
           *>   then delete the original, never over a document of the same name.

           IF    CONTROL-NODE-INDEX < 1 OR CONTROL-NODE-INDEX > WS-NODE-N
               EXIT PROGRAM
           END-IF
           IF    WS-MOVE-STEP NOT = SPACE
               SET     Lbl-Status::Caption       TO    T-KB-UPDATING::Trim()
               EXIT PROGRAM
           END-IF
           SET     WS-J                          TO    CONTROL-NODE-INDEX
           IF    WS-NODE-KIND(WS-J) NOT = "D"
               SET     Lbl-Status::Caption       TO    T-DRAG-DOCS-ONLY::Trim()
               EXIT PROGRAM
           END-IF

           SET     WS-MOVE-SRC                   TO    WS-NODE-PATH(WS-J)
           SET     WS-MOVE-TO                    TO    SPACES

           IF    CONTROL-TARGET-INDEX > 0 AND CONTROL-TARGET-INDEX NOT > WS-NODE-N
               SET     WS-K1                     TO    CONTROL-TARGET-INDEX
               IF    WS-NODE-KIND(WS-K1) = "F"
                   SET     WS-MOVE-TO            TO    WS-NODE-PATH(WS-K1)
               ELSE
                   SET     WS-L                  TO    FUNCTION LENGTH(WS-NODE-PATH(WS-K1)::Trim())
                   SET     WS-P                  TO    0

                   PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L
                       IF    WS-NODE-PATH(WS-K1)(WS-K:1) = "/"
                           SET     WS-P          TO    WS-K
                       END-IF
                   END-PERFORM
                   IF    WS-P > 1
                       SET     WS-MOVE-TO        TO    WS-NODE-PATH(WS-K1)(1:WS-P - 1)
                   END-IF
               END-IF
           END-IF

           *> PC-MOVE-GO: moves the document WS-MOVE-SRC into the folder WS-MOVE-TO (SPACES = top
           *> level): it copies it to WS-MOVE-DEST through KB-D::ImportDocument; KB-D--ONINDEXED
           *> deletes the original once the copy is indexed.
           *> Uses:   WS-MOVE-SRC = the path of the dragged document (it is kind "D"); WS-MOVE-TO =
           *>         the folder it was dropped on, the folder of the document it was dropped on, or
           *>         SPACES (top level) for empty space. It also reads the rows of WS-TREE (a name
           *>         already taken) and WS-DOCS-DIR.
           *> Result: either the move is refused (WS-MOVE-SRC = SPACES; Lbl-Status::Caption =
           *>         T-MOVE-SAME, "The document is already in that folder.", when the target is
           *>         where it already is; T-MOVE-EXISTS with WS-MOVE-DEST, "A document of that name
           *>         is already there: <path>.", when that name is taken; or KB-D::LastError when
           *>         KB-D did not accept the import) or it starts (WS-MOVE-DEST = the target path,
           *>         WS-MOVE-STEP = "I", Lbl-Progress::Caption = T-KB-UPDATING, "Updating the
           *>         Knowledge Base..."). WS-L, WS-P and WS-K are always overwritten; past the
           *>         same-folder check also WS-J and WS-FOUND, then WS-FMT, WS-ARG1 and WS-FMT-OUT
           *>         (name taken) or WS-LINE and WS-OK (import tried).

           CALL    "PC-MOVE-GO"
]]></Event>
  </Control>
  <Control id="Drop-Docs" type="FileDropZone" x="672" y="48" w="392" h="144" tab-order="2" z-order="0" visible="true" enabled="true">
    <Property name="Hint">Drop documents here, or click to choose</Property>
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="MaximumFileSizeKB">0</Property>
    <Property name="StageOnly">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="AllowedExtensions"></Property>
    <Property name="DestinationFolder"></Property>
    <Property name="FileListControl"></Property>
    <Event name="onFilesDropped" paragraph="DROP-DOCS--ONFILESDROPPED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Each accepted file (DroppedFiles, at its own path - the zone
           *>   copies nothing) goes into the selected folder under its own name.
           *>   A name already there is asked about first: replace, or keep.

           SET     WS-UP-ALL                     TO    Drop-Docs::DroppedFiles
           SET     WS-UP-LEN                     TO    FUNCTION LENGTH(WS-UP-ALL::Trim())
           SET     WS-UP-PT                      TO    1

           *> The queue (WS-UP-N, up to 50) outlives one drop: files dropped while
           *> an earlier batch is still importing join it, so the counters restart
           *> only when the queue was empty.

           IF    WS-UP-N = 0
               SET     WS-UP-ADDED WS-UP-UPDATED WS-UP-KEPT
                                                 TO    0
           END-IF
           PERFORM    UNTIL WS-UP-PT > WS-UP-LEN OR WS-UP-N = 50
               SET     WS-UP-ONE                 TO    SPACES
               UNSTRING    WS-UP-ALL DELIMITED BY X"0A" INTO WS-UP-ONE
                   WITH POINTER WS-UP-PT
               END-UNSTRING
               IF    WS-UP-ONE NOT = SPACES
                   *> Dropped paths may use either separator (\ on Windows, / elsewhere):
                   *> the file name is what follows the last one.

                   SET     WS-L                  TO    FUNCTION LENGTH(WS-UP-ONE::Trim())
                   SET     WS-P                  TO    0

                   PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L
                       IF    WS-UP-ONE(WS-K:1) = "/" OR WS-UP-ONE(WS-K:1) = "\"
                           SET     WS-P          TO    WS-K
                       END-IF
                   END-PERFORM

                   SET     WS-UP-NAME            TO    SPACES
                   SET     WS-UP-NAME            TO    WS-UP-ONE(WS-P + 1:WS-L - WS-P)

                   ADD    1 TO WS-UP-N

                   SET     WS-UP-SRC(WS-UP-N)    TO    WS-UP-ONE
                   SET     WS-UP-DEST(WS-UP-N)   TO    SPACES

                   IF    WS-FOLDER = SPACES
                       SET     WS-UP-DEST(WS-UP-N)
                                                 TO    WS-UP-NAME::Trim()
                   ELSE
                       STRING    WS-FOLDER::Trim() "/" WS-UP-NAME::Trim() INTO WS-UP-DEST(WS-UP-N)
                   END-IF

                   SET     WS-UP-STATE(WS-UP-N)  TO    "Q"
                   SET     WS-FOUND              TO    "N"

                   PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-NODE-N
                       IF    WS-NODE-KIND(WS-J) = "D"
                               AND WS-NODE-PATH(WS-J) = WS-UP-DEST(WS-UP-N)
                           SET     WS-FOUND      TO    "Y"
                       END-IF
                   END-PERFORM
                   IF    WS-FOUND = "Y"
                       SET     WS-FMT            TO    T-REPLACE-Q
                       SET     WS-ARG1           TO    WS-UP-DEST(WS-UP-N)

                       *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the
                       *> trimmed WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
                       *> Uses:   WS-FMT = T-REPLACE-Q ("&1 already exists in this folder. Replace
                       *>         it?" in English) and WS-ARG1 = WS-UP-DEST(WS-UP-N), the topic path
                       *>         of the file just queued, which is already in the tree.
                       *> Result: WS-FMT-OUT = that question with the path in it; the next line
                       *>         copies it to WS-UP-QUESTION for CONFIRM-FORM.

                       CALL    "PC-FMT"
                       SET     WS-UP-QUESTION    TO    WS-FMT-OUT

                       INVOKE    ME::SetProperty("ConfirmText", WS-UP-QUESTION)
                       INVOKE    ME::SetProperty("ConfirmYes", T-REPLACE-YES)
                       INVOKE    ME::SetProperty("ConfirmNo", T-REPLACE-NO)
                       INVOKE    ME::SetProperty("ConfirmAnswer", "N")
                       INVOKE    ME::OpenFormSync("CONFIRM-FORM")
                       INVOKE    ME::GetProperty("ConfirmAnswer") RETURNING WS-UP-ANSWER

                       IF    WS-UP-ANSWER(1:1) NOT = "Y"
                           SET     WS-UP-STATE(WS-UP-N)
                                                 TO    "K"

                           ADD    1 TO WS-UP-KEPT

                           SET     WS-FMT        TO    T-UP-KEPT
                           SET     WS-ARG1       TO    WS-UP-DEST(WS-UP-N)

                           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the
                           *> trimmed WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
                           *> Uses:   WS-FMT = T-UP-KEPT ("Not replaced: &1." in English) and
                           *>         WS-ARG1 = WS-UP-DEST(WS-UP-N), the path whose replacement the
                           *>         user refused.
                           *> Result: WS-FMT-OUT = "Not replaced: <path>."; the next line shows it
                           *>         in Lbl-Status::Caption.

                           CALL    "PC-FMT"
                           SET     Lbl-Status::Caption
                                                 TO    WS-FMT-OUT::Trim()
                       END-IF
                   END-IF
               END-IF
           END-PERFORM

           *> PC-UP-NEXT: imports the next queued upload (WS-UP-STATE "Q") into the Knowledge Base,
           *> or, when none is left, shows the summary of a multi-file drop.
           *> Uses:   WS-UP-STEP, WS-UP-N and WS-UP-STATE(1..WS-UP-N) (the first "Q" is taken) with
           *>         its WS-UP-SRC / WS-UP-DEST; for the summary WS-UP-ADDED, WS-UP-UPDATED and
           *>         WS-UP-KEPT. The queue was just filled from Drop-Docs::DroppedFiles (WS-UP-SRC
           *>         = the file's own path, WS-UP-DEST = its path in the topic, WS-UP-STATE "Q" or
           *>         "K").
           *> Result: if WS-UP-STEP is not SPACE (an upload is already running) nothing is done.
           *>         Otherwise the first "Q" item becomes WS-UP-CUR and KB-D::ImportDocument starts
           *>         for it: WS-UP-STEP = "U", Lbl-Progress::Caption = "Adding <path> to the
           *>         Knowledge Base..."; KB-D--ONINDEXED goes on with the rest, and if KB-D is busy
           *>         the item stays queued. With no "Q" item left, WS-UP-N = 0, and when it was > 1
           *>         Lbl-Status::Caption = "<n> added, <n> updated, <n> not replaced." Past that
           *>         check these are overwritten: WS-UP-CUR and WS-UP-I; for the summary WS-FMT,
           *>         WS-KB1, WS-ARG1..WS-ARG3 and WS-FMT-OUT; for an import KB-D::SearchModeReason
           *>         (cleared), WS-OK, WS-FMT, WS-ARG1 and WS-FMT-OUT.

           CALL    "PC-UP-NEXT"
]]></Event>
    <Event name="onFilesRejected" paragraph="DROP-DOCS--ONFILESREJECTED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 LK-ALL                                 PIC    X(4000).
       01 LK-ONE                                 PIC    X(400).
       01 LK-PATH                                PIC    X(400).
       01 LK-NAMES                               PIC    X(300).
       01 LK-LEN                                 PIC    9(4).
       01 LK-PT                                  PIC    9(4).
       01 LK-OUT                                 PIC    9(4).

       PROCEDURE DIVISION.
           *>   RejectedFiles: one "path<TAB>reason" line per refused file. Name
           *>   each one and say why, so nothing is refused without a word.

           SET     LK-ALL                        TO    Drop-Docs::RejectedFiles
           SET     LK-LEN                        TO    FUNCTION LENGTH(FUNCTION TRIM(LK-ALL))
           SET     LK-NAMES                      TO    SPACES
           SET     LK-PT                         TO    1
           SET     LK-OUT                        TO    1

           PERFORM    UNTIL LK-PT > LK-LEN
               SET     LK-ONE LK-PATH            TO    SPACES
               UNSTRING    LK-ALL DELIMITED BY X"0A" INTO LK-ONE
                   WITH POINTER LK-PT
               END-UNSTRING
               UNSTRING    LK-ONE DELIMITED BY X"09" INTO LK-PATH
               END-UNSTRING
               IF    LK-PATH NOT = SPACES
                   SET     WS-L                  TO    FUNCTION LENGTH(FUNCTION TRIM(LK-PATH))
                   SET     WS-P                  TO    0

                   PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L
                       IF    LK-PATH(WS-K:1) = "/" OR LK-PATH(WS-K:1) = "\"
                           SET     WS-P          TO    WS-K
                       END-IF
                   END-PERFORM
                   IF    LK-OUT > 1
                       STRING    ", " INTO LK-NAMES WITH POINTER LK-OUT
                   END-IF
                   STRING    LK-PATH(WS-P + 1:WS-L - WS-P) INTO LK-NAMES WITH POINTER LK-OUT
               END-IF
           END-PERFORM

           SET     WS-FMT                        TO    T-REJECTED-TYPE
           SET     WS-ARG1                       TO    LK-NAMES

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-REJECTED-TYPE ("Not added - this type of file cannot be read: &1"
           *>         in English) and WS-ARG1 = LK-NAMES, the names of the refused files, separated
           *>         by ", ".
           *> Result: WS-FMT-OUT = that message with the names in it; the next lines keep it in
           *>         WS-REJECT-MSG and show it in Lbl-Status::Caption.

           CALL    "PC-FMT"

           SET     WS-REJECT-MSG                 TO    WS-FMT-OUT
           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()
]]></Event>
  </Control>
  <Control id="Btn-Delete" type="Button" x="680" y="224" w="184" h="32" tab-order="3" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Delete</Property>
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">false</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-DELETE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SEL-IX = 0
               SET     Lbl-Status::Caption       TO    T-PICK-DOC-FIRST::Trim()
               EXIT PROGRAM
           END-IF
           IF    WS-SEL-KIND = "D"
               SET     WS-OK                     TO    KB-D::DeleteDocument(WS-SEL-PATH::Trim())
               IF    WS-OK NOT = "1"
                   SET     Lbl-Status::Caption   TO    KB-D::LastError
               ELSE
                   *>           Said while it happens, and confirmed by name when done.

                   SET     WS-DELETING           TO    WS-SEL-PATH
                   SET     WS-FMT                TO    T-REMOVING
                   SET     WS-ARG1               TO    WS-SEL-PATH

                   *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
                   *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
                   *> Uses:   WS-FMT = T-REMOVING ("Removing &1 from the Knowledge Base..." in
                   *>         English) and WS-ARG1 = WS-SEL-PATH, the document KB-D::DeleteDocument
                   *>         was just asked to remove.
                   *> Result: WS-FMT-OUT = "Removing <path> from the Knowledge Base..."; the next
                   *>         line shows it in Lbl-Progress::Caption.

                   CALL    "PC-FMT"
                   SET     Lbl-Progress::Caption TO    WS-FMT-OUT::Trim()
               END-IF
               EXIT PROGRAM
           END-IF
           *>   A folder goes only when nothing is under it: deleting a folder
           *>   never deletes documents as a side effect.

           SET     WS-KEY-TMP                    TO    SPACES
           STRING    WS-SEL-PATH::Trim() "/" INTO WS-KEY-TMP

           SET     WS-L                          TO    FUNCTION LENGTH(WS-KEY-TMP::Trim())
           SET     WS-FOUND                      TO    "N"

           PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-NODE-N
               IF    WS-NODE-PATH(WS-J)(1:WS-L) = WS-KEY-TMP(1:WS-L)
                   SET     WS-FOUND              TO    "Y"
               END-IF
           END-PERFORM
           IF    WS-FOUND = "Y"
               SET     Lbl-Status::Caption       TO    T-FOLDER-NOT-EMPTY::Trim()
               EXIT PROGRAM
           END-IF
           OPEN    I-O FOLDERS-FILE
           IF    WS-FS = "00"
               SET     FLD-TOPIC                 TO    WS-CUR-TOPIC
               SET     FLD-PATH                  TO    WS-SEL-PATH

               DELETE    FOLDERS-FILE
                   INVALID KEY CONTINUE
               END-DELETE
               COMMIT
               CLOSE    FOLDERS-FILE
           END-IF
           *>   (Not WS-NAME: PC-LIST-DOCS writes every node's label there.)

           SET     WS-GONE                       TO    WS-SEL-PATH
           SET     WS-SEL-KIND WS-SEL-PATH       TO    SPACES

           *> PC-LIST-DOCS: rebuilds the documents tree of the current topic: its documents (the
           *> files KB-D::ListDocuments finds in the documents folder on disk) and its folders
           *> (FOLDERS-FILE), sorted so a folder comes right before its contents, then adds them to
           *> Trv-Docs.
           *> Uses:   FOLDERS-FILE (the folder's record was deleted from it just above, if the OPEN
           *>         I-O succeeded), WS-CUR-TOPIC, the documents folder as KB-D lists it,
           *>         WS-DOCS-DIR, and WS-SEL-KIND / WS-SEL-PATH (cleared to SPACES).
           *> Result: WS-TREE, WS-NODE-N and WS-DOC-COUNT hold the new rows; Trv-Docs shows them
           *>         (empty folders get the folder icon); Lbl-Count::Caption = "<n> document(s).".
           *>         The selection is found again by path: WS-SEL-IX, WS-FOLDER and WS-LINE (the
           *>         drop folder on disk) are set, and WS-SEL-KIND and WS-SEL-PATH are cleared to
           *>         SPACES when its row is gone. Always overwritten: WS-I, WS-J, WS-OK, WS-FS,
           *>         WS-N1, WS-FMT, WS-ARG1 and WS-FMT-OUT. Only when there is a row to list:
           *>         WS-ONE-KIND, WS-ONE-PATH, WS-FOUND, WS-KEY-TMP, WS-K, WS-L, WS-P, WS-DEPTH,
           *>         WS-NAME and WS-ICON (WS-DOC too when there is a document); with two rows or
           *>         more WS-K1 and WS-NODE-TMP; FLD-TOPIC and FLD-PATH only if the folders file
           *>         opens. The deleted folder is gone from the tree.

           CALL    "PC-LIST-DOCS"

           SET     WS-FMT                        TO    T-FOLDER-DELETED
           SET     WS-ARG1                       TO    WS-GONE

           *> PC-FMT: replaces the &1..&4 placeholders of the template WS-FMT by the trimmed
           *> WS-ARG1..WS-ARG4 and leaves the finished text in WS-FMT-OUT.
           *> Uses:   WS-FMT = T-FOLDER-DELETED ("Folder deleted: &1." in English) and WS-ARG1 =
           *>         WS-GONE, the path of the folder just deleted.
           *> Result: WS-FMT-OUT = "Folder deleted: <path>."; the next line shows it in
           *>         Lbl-Status::Caption.

           CALL    "PC-FMT"
           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()
]]></Event>
  </Control>
