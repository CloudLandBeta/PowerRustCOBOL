    <Property name="EmbeddingAPIKey"></Property>
    <Event name="onProgress" paragraph="KB-D--ONPROGRESS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The progress panel (R16a): which document, how many of how many.
           MOVE KB-D::ProgressCurrent TO WS-N1
           MOVE KB-D::ProgressTotal TO WS-N2
           MOVE KB-D::ProgressTotal TO Prg-Index::Maximum
           MOVE KB-D::ProgressCurrent TO Prg-Index::Value
           MOVE SPACES TO WS-LINE
           STRING "Updating the Knowledge Base: " FUNCTION TRIM(WS-N1) " of "
                  FUNCTION TRIM(WS-N2) " - " FUNCTION TRIM(KB-D::ProgressDocument)
               DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Progress::Caption
           MOVE "true" TO Pnl-Progress::Visible
           MOVE "true" TO Lbl-Progress::Visible
           MOVE "true" TO Prg-Index::Visible
]]></Event>
    <Event name="onIndexed" paragraph="KB-D--ONINDEXED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "false" TO Pnl-Progress::Visible
           MOVE "false" TO Lbl-Progress::Visible
           MOVE "false" TO Prg-Index::Visible
           MOVE KB-D::AddedCount TO WS-N1
           MOVE KB-D::UpdatedCount TO WS-N2
           MOVE KB-D::RemovedCount TO WS-N3
           MOVE KB-D::SkippedCount TO WS-N4
           MOVE SPACES TO WS-LINE
           STRING "Added " FUNCTION TRIM(WS-N1) ", updated " FUNCTION TRIM(WS-N2)
                  ", removed " FUNCTION TRIM(WS-N3) ", skipped " FUNCTION TRIM(WS-N4) "."
               DELIMITED BY SIZE INTO WS-LINE
           MOVE KB-D::SkippedDocuments TO WS-SKIPPED
           IF WS-SKIPPED NOT = SPACES
               STRING FUNCTION TRIM(WS-LINE) " Skipped: " FUNCTION TRIM(WS-SKIPPED)
                   DELIMITED BY SIZE INTO WS-LINE
           END-IF
           MOVE WS-LINE TO Lbl-Status::Caption
           CALL "PC-LIST-DOCS"
]]></Event>
    <Event name="onBusy" paragraph="KB-D--ONBUSY"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "false" TO Pnl-Progress::Visible
           MOVE "false" TO Lbl-Progress::Visible
           MOVE "false" TO Prg-Index::Visible
           MOVE KB-D::LastError TO Lbl-Status::Caption
]]></Event>
    <Event name="onError" paragraph="KB-D--ONERROR"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "false" TO Pnl-Progress::Visible
           MOVE "false" TO Lbl-Progress::Visible
           MOVE "false" TO Prg-Index::Visible
           MOVE KB-D::LastError TO Lbl-Status::Caption
]]></Event>
  </Control>
</Form>