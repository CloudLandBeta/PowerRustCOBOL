    <Event name="onClick" paragraph="BTN-DELETE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Docs::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-DOC-COUNT
               MOVE FUNCTION TRIM(T-PICK-DOC-FIRST) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           MOVE WS-INDEX TO WS-I
           MOVE KB-D::GetDocument(WS-I) TO WS-DOC
           MOVE KB-D::DeleteDocument(FUNCTION TRIM(WS-DOC)) TO WS-OK
           IF WS-OK NOT = "1"
               MOVE KB-D::LastError TO Lbl-Status::Caption
           END-IF
]]></Event>
