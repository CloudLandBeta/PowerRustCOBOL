    <Property name="HoverItemColor"></Property>
    <Event name="onSelectedIndexChanged" paragraph="CMB-PROVIDER--ONSELECTEDINDEXCHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   A new provider brings its own address: fill it in, unless the field
      *>   holds one the user typed. Then ask it for its models, as the IDE
      *>   does, when it can answer (no key needed, or one to hand).
           CALL "PC-PICKED-PROVIDER"
           IF WS-PROV-IX = 0
               EXIT PROGRAM
           END-IF
           MOVE Txt-Url::Text TO WS-PATH
           IF WS-PATH = SPACES OR WS-PATH = WS-LAST-DEFAULT
               MOVE WS-PROV-EP TO Txt-Url::Text
           END-IF
           MOVE WS-PROV-EP TO WS-LAST-DEFAULT
           MOVE Cmb-Model::Clear() TO WS-OK
           MOVE SPACES TO Cmb-Model::Value
           MOVE Txt-Name::Text TO MDL-NAME
           CALL "COBOL-KEY-IS-SET" USING MDL-NAME WS-KEY-FLAG
           MOVE Txt-Key::Text TO WS-KEY
           IF WS-PROV-NEEDS = "N" OR WS-KEY NOT = SPACES OR WS-KEY-FLAG = "Y"
               CALL "PC-REFRESH-MODELS"
           END-IF
           MOVE SPACES TO WS-KEY
]]></Event>
  </Control>
