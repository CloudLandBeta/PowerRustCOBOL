  <file-control><![CDATA[           SELECT SETTINGS-FILE ASSIGN TO WS-SETTINGS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS SET-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT MODELS-FILE ASSIGN TO WS-MODELS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS MDL-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT XML-FILE ASSIGN TO WS-XML-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS.
]]></file-control>
  <file-section><![CDATA[       FD SETTINGS-FILE IS GLOBAL.
       01 SETTINGS-REC.
           05 SET-NAME                           PIC    X(20).
           05 SET-VALUE                          PIC    X(200).
       FD MODELS-FILE IS GLOBAL.
       01 MODEL-REC.
           05 MDL-NAME                           PIC    X(30).
           05 MDL-API                            PIC    X(12).
           05 MDL-URL                            PIC    X(200).
           05 MDL-MODEL                          PIC    X(80).
           *>   The capability table (spec 071 R31, 063 R72): whether the model
           *>   can call tools, and how well it orchestrates, 1 (poorly) to 9.

           05 MDL-TOOLS                          PIC    X.
           05 MDL-RANK                           PIC    9.
       FD XML-FILE IS GLOBAL.
       01 XML-REC                                PIC    X(1000).
]]></file-section>
  <user-procedures>
    <Event name="PC-PATHS" paragraph="PC-PATHS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Where PowerChat keeps its own files: POWERCHAT_DATA, else "data".

           DISPLAY    "POWERCHAT_DATA" UPON ENVIRONMENT-NAME
           ACCEPT    WS-DATA-DIR FROM ENVIRONMENT-VALUE
           IF    WS-DATA-DIR = SPACES
               SET     WS-DATA-DIR               TO    "data"
           END-IF
           SET     WS-SETTINGS-PATH              TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/settings.idx" INTO WS-SETTINGS-PATH
           SET     WS-MODELS-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/models.idx" INTO WS-MODELS-PATH
]]></Event>
    <Event name="PC-SYNC-MODELS" paragraph="PC-SYNC-MODELS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 SY-N                                   PIC    9(3).
       01 SY-I                                   PIC    9(3).
       01 SY-J                                   PIC    9(3).
       01 SY-NAME                                PIC    X(30).
       01 SY-API                                 PIC    X(12).
       01 SY-URL                                 PIC    X(200).
       01 SY-MODEL                               PIC    X(80).
       01 SY-FOUND                               PIC    X.
       01 SY-EOF                                 PIC    X.
       01 SY-GONE-N                              PIC    9(3).
       01 SY-GONE-TABLE.
           05 SY-GONE                            PIC    X(30)    OCCURS 200 TIMES.

       PROCEDURE DIVISION.
           *>   The models are the APPLICATION's (spec 085): the runtime keeps the
           *>   list for every form of it, the application's own agents included.
           *>   MODELS mirrors that list and adds what only PowerChat knows of each
           *>   model - whether it calls tools, how well it orchestrates. Once, the
           *>   models PowerChat kept before are handed to the application's list.

           OPEN    I-O MODELS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT MODELS-FILE
               CLOSE    MODELS-FILE
               OPEN    I-O MODELS-FILE
           END-IF
           SET     WS-SET-NAME                   TO    "MODELS-ADOPTED"
           CALL    "PC-SETTING-GET"
           IF    WS-SET-VALUE NOT = "Y"
               SET     MDL-NAME                  TO    LOW-VALUES
               SET     SY-EOF                    TO    "N"

               START    MODELS-FILE KEY IS >= MDL-NAME
                   INVALID KEY MOVE "Y" TO SY-EOF
               END-START
               PERFORM    UNTIL SY-EOF = "Y"
                   READ    MODELS-FILE NEXT RECORD
                       AT END MOVE "Y" TO SY-EOF
                       NOT AT END
                           COBOL::"MODEL-SET" ( MDL-NAME MDL-API MDL-URL MDL-MODEL )
                   END-READ
               END-PERFORM

               SET     WS-SET-NAME               TO    "MODELS-ADOPTED"
               SET     WS-SET-VALUE              TO    "Y"

               CALL    "PC-SETTING-PUT"
           END-IF
           *>   Every model of the application's is here, with its own metadata.

           COBOL::"MODEL-COUNT" ( SY-N )
           PERFORM    VARYING SY-I FROM 1 BY 1 UNTIL SY-I > SY-N
               SET     SY-NAME SY-API SY-URL SY-MODEL
                                                 TO    SPACES

               COBOL::"MODEL-GET" ( SY-I SY-NAME SY-API SY-URL SY-MODEL )
               *> A new model starts without tool support and at rank 5 (scale 1-9).
               *> A known one only gets the application's api, url and model refreshed:
               *> tools and rank are PowerChat's own and are left alone.

               SET     MDL-NAME                  TO    SY-NAME
               READ    MODELS-FILE
                   INVALID KEY
                       SET     MDL-API           TO    SY-API
                       SET     MDL-URL           TO    SY-URL
                       SET     MDL-MODEL         TO    SY-MODEL
                       SET     MDL-TOOLS         TO    "N"
                       SET     MDL-RANK          TO    5

                       WRITE    MODEL-REC
                           INVALID KEY CONTINUE
                       END-WRITE
                   NOT INVALID KEY
                       IF    MDL-API NOT = SY-API OR MDL-URL NOT = SY-URL
                               OR MDL-MODEL NOT = SY-MODEL

                           SET     MDL-API       TO    SY-API
                           SET     MDL-URL       TO    SY-URL
                           SET     MDL-MODEL     TO    SY-MODEL

                           REWRITE    MODEL-REC
                               INVALID KEY CONTINUE
                           END-REWRITE
                       END-IF
               END-READ
           END-PERFORM
           *>   ...and none the application has withdrawn.

           SET     SY-GONE-N                     TO    0
           SET     MDL-NAME                      TO    LOW-VALUES
           SET     SY-EOF                        TO    "N"

           START    MODELS-FILE KEY IS >= MDL-NAME
               INVALID KEY MOVE "Y" TO SY-EOF
           END-START
           PERFORM    UNTIL SY-EOF = "Y"
               READ    MODELS-FILE NEXT RECORD
                   AT END MOVE "Y" TO SY-EOF
                   NOT AT END
                       SET     SY-FOUND          TO    "N"
                       PERFORM    VARYING SY-J FROM 1 BY 1
                               UNTIL SY-J > SY-N OR SY-FOUND = "Y"
                           SET     SY-NAME       TO    SPACES
                           COBOL::"MODEL-GET" ( SY-J SY-NAME )
                           IF    FUNCTION UPPER-CASE(SY-NAME)
                                   = FUNCTION UPPER-CASE(MDL-NAME)
                               SET     SY-FOUND  TO    "Y"
                           END-IF
                       END-PERFORM
                       IF    SY-FOUND = "N" AND SY-GONE-N < 200
                           ADD    1 TO SY-GONE-N
                           SET     SY-GONE(SY-GONE-N)
                                                 TO    MDL-NAME
                       END-IF
               END-READ
           END-PERFORM
           *> Withdrawn names were only collected while READ NEXT walked the file;
           *> they are deleted now, after the scan. The table holds 200: any beyond
           *> that wait for the next sync.

           PERFORM    VARYING SY-J FROM 1 BY 1 UNTIL SY-J > SY-GONE-N
               SET     MDL-NAME                  TO    SY-GONE(SY-J)
               DELETE    MODELS-FILE
                   INVALID KEY CONTINUE
               END-DELETE
           END-PERFORM
           COMMIT
           CLOSE    MODELS-FILE
]]></Event>
    <Event name="PC-SETTING-GET" paragraph="PC-SETTING-GET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME in, WS-SET-VALUE out (spaces when the setting is unset).

           SET     WS-SET-VALUE                  TO    SPACES
           *> Status 35 = the file does not exist yet: create it empty and reopen
           *> it for update, so the very first run needs no set-up.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF
           SET     SET-NAME                      TO    WS-SET-NAME
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE SET-VALUE TO WS-SET-VALUE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-SETTING-PUT" paragraph="PC-SETTING-PUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME, WS-SET-VALUE in. Written and committed at once (R10f).

           *> Status 35 = the file does not exist yet: create it empty and reopen
           *> it for update, so the very first run needs no set-up.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF

           SET     SET-NAME                      TO    WS-SET-NAME
           SET     SET-VALUE                     TO    WS-SET-VALUE

           WRITE    SETTINGS-REC
               INVALID KEY REWRITE SETTINGS-REC
           END-WRITE
           COMMIT
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-LOAD-AGENTS" paragraph="PC-LOAD-AGENTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Which model each of the chat's three agents uses. Agent 1 falls
           *>   back to MODEL-ENTRY, the single setting PowerChat 1 kept.

           PERFORM    VARYING WS-A FROM 1 BY 1 UNTIL WS-A > 3
               SET     WS-SET-NAME               TO    SPACES
               STRING    "AGENT-" WS-A "-ENTRY" DELIMITED BY SIZE INTO WS-SET-NAME
               CALL    "PC-SETTING-GET"
               SET     WS-AGENT-ENTRY(WS-A)      TO    WS-SET-VALUE
           END-PERFORM
           IF    WS-AGENT-ENTRY(1) = SPACES
               SET     WS-SET-NAME               TO    "MODEL-ENTRY"
               CALL    "PC-SETTING-GET"
               SET     WS-AGENT-ENTRY(1)         TO    WS-SET-VALUE
           END-IF
]]></Event>
    <Event name="PC-LOAD-MODELS" paragraph="PC-LOAD-MODELS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The model list, one row each: name, model, and whether a key is
           *>   stored - never the key itself (spec 071 R37, 076 R6).

           SET     WS-OK                         TO    Lst-Models::Clear()
           SET     WS-MODEL-COUNT                TO    0
           SET     WS-WITH-MODEL                 TO    0

           CALL    "PC-LOAD-AGENTS"
           *>   The application's models, mirrored first (spec 085).

           CALL    "PC-SYNC-MODELS"
           OPEN    I-O MODELS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT MODELS-FILE
               CLOSE    MODELS-FILE
               OPEN    I-O MODELS-FILE
           END-IF

           SET     MDL-NAME                      TO    LOW-VALUES
           SET     WS-EOF                        TO    "N"

           START    MODELS-FILE KEY IS >= MDL-NAME
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    MODELS-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    WS-MODEL-COUNT < 200
                           ADD    1 TO WS-MODEL-COUNT
                           SET     WS-MODEL-NAME(WS-MODEL-COUNT)
                                                 TO    MDL-NAME

                           IF    MDL-MODEL NOT = SPACES
                               ADD    1 TO WS-WITH-MODEL
                           END-IF
                           COBOL::"KEY-IS-SET" ( MDL-NAME WS-KEY-FLAG )
                           SET     WS-PROV-ID    TO    MDL-API
                           CALL    "PC-PROVIDER-LABEL"
                           SET     WS-ROW        TO    SPACES
                           STRING    FUNCTION TRIM(MDL-NAME) " - "
                           WS-PROV-LABEL::Trim() " "
                               FUNCTION TRIM(MDL-MODEL)
                               INTO WS-ROW
                           *> Each suffix (tools, rank, key, agent) is added by parking the row so
                           *> far in WS-ARG4 and STRINGing it back in front of the suffix: STRING
                           *> cannot read and write WS-ROW at the same time.

                           IF    MDL-TOOLS = "Y"
                               SET     WS-FMT    TO    T-ROW-TOOLS
                               CALL    "PC-FMT"

                               SET     WS-ARG4   TO    WS-ROW
                               SET     WS-ROW    TO    SPACES

                               STRING    WS-ARG4::Trim() WS-FMT-OUT::Trim() INTO WS-ROW
                           END-IF
                           IF    MDL-RANK IS NUMERIC AND MDL-RANK > 0
                               SET     WS-FMT    TO    T-ROW-RANK
                               SET     WS-ARG1   TO    MDL-RANK

                               CALL    "PC-FMT"

                               SET     WS-ARG4   TO    WS-ROW
                               SET     WS-ROW    TO    SPACES

                               STRING    WS-ARG4::Trim() WS-FMT-OUT::Trim() INTO WS-ROW
                           END-IF
                           IF    WS-KEY-FLAG = "Y"
                               SET     WS-FMT    TO    T-ROW-KEY-SET
                               CALL    "PC-FMT"

                               SET     WS-ARG4   TO    WS-ROW
                               SET     WS-ROW    TO    SPACES

                               STRING    WS-ARG4::Trim() " " WS-FMT-OUT::Trim() INTO WS-ROW
                           END-IF
                           PERFORM    VARYING WS-A FROM 1 BY 1 UNTIL WS-A > 3
                               IF    MDL-NAME = WS-AGENT-ENTRY(WS-A)
                                   SET     WS-FMT
                                                 TO    T-ROW-AGENT

                                   SET     WS-ARG1
                                                 TO    WS-A

                                   CALL    "PC-FMT"
                                   SET     WS-ARG4
                                                 TO    WS-ROW

                                   SET     WS-ROW
                                                 TO    SPACES

                                   STRING    WS-ARG4::Trim() "  " WS-FMT-OUT::Trim() INTO WS-ROW
                               END-IF
                           END-PERFORM
                           SET     WS-OK         TO    Lst-Models::AddItem(WS-ROW::Trim())
                       END-IF
               END-READ
           END-PERFORM
           CLOSE    MODELS-FILE
]]></Event>
    <Event name="PC-PROVIDER-LABEL" paragraph="PC-PROVIDER-LABEL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-PROV-ID in (any case - older entries say "Ollama", "OpenAI");
           *>   out: WS-PROV-IX (1-based, 0 = unknown) and the provider's label,
           *>   default endpoint and whether it needs a key.

           SET     WS-PROV-IX                    TO    0
           SET     WS-XVAL                       TO    WS-PROV-ID
           SET     WS-XVAL                       TO    FUNCTION LOWER-CASE(WS-XVAL)

           PERFORM    VARYING WS-P FROM 1 BY 1
                   UNTIL WS-P > WS-PROV-COUNT OR WS-PROV-IX > 0
               COBOL::"PROVIDER-GET" ( WS-P WS-XNAME WS-PROV-LABEL
                   WS-PROV-EP WS-PROV-NEEDS )
               IF    WS-XNAME = WS-XVAL(1:20)
                   SET     WS-PROV-IX            TO    WS-P
               END-IF
           END-PERFORM
           *> An id the runtime does not list still works: it stands in as its own
           *> label, with no default endpoint and no key required. A known id is
           *> rewritten to the runtime's own spelling.

           IF    WS-PROV-IX = 0
               SET     WS-PROV-LABEL             TO    WS-PROV-ID
               SET     WS-PROV-EP                TO    SPACES
               SET     WS-PROV-NEEDS             TO    "N"
           ELSE
               SET     WS-PROV-ID                TO    WS-XNAME
           END-IF
]]></Event>
    <Event name="PC-XML-ESC" paragraph="PC-XML-ESC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-CH                                  PIC    9(4).

       PROCEDURE DIVISION.
           *>   WS-XIN as XML text into WS-XOUT: & < > " ' written as entities.

           SET     WS-XOUT                       TO    SPACES
           SET     WS-PT                         TO    1

           PERFORM    VARYING WS-CH FROM 1 BY 1
                   UNTIL WS-CH > FUNCTION LENGTH(WS-XIN::Trim())
                   OR WS-XIN = SPACES
               EVALUATE    WS-XIN(WS-CH:1)
                   WHEN "&" STRING "&amp;" INTO WS-XOUT WITH POINTER WS-PT
                   WHEN "<" STRING "&lt;" INTO WS-XOUT WITH POINTER WS-PT
                   WHEN ">" STRING "&gt;" INTO WS-XOUT WITH POINTER WS-PT
                   WHEN QUOTE STRING "&quot;" INTO WS-XOUT WITH POINTER WS-PT
                   WHEN "'" STRING "&apos;" INTO WS-XOUT WITH POINTER WS-PT
                   WHEN OTHER
                       STRING    WS-XIN(WS-CH:1) INTO WS-XOUT WITH POINTER WS-PT
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-XML-ATTR" paragraph="PC-XML-ATTR"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-CH                                  PIC    9(4).
       01 WS-AT                                  PIC    9(4).
       01 WS-KL                                  PIC    9(4).
       01 WS-KEYTXT                              PIC    X(30).

       PROCEDURE DIVISION.
           *>   The value of attribute WS-XNAME in WS-XLINE into WS-XVAL (entities
           *>   decoded); WS-XFOUND = "Y" when the line carries it.

           SET     WS-XVAL WS-KEYTXT             TO    SPACES
           SET     WS-XFOUND                     TO    "N"

           *> Look for ` name="` (the leading space keeps one attribute name from
           *> matching inside another) in the 1000-character line. WS-KL is its
           *> length; WS-AT ends just past it, where the value starts.

           STRING    " " WS-XNAME::Trim() "=" QUOTE DELIMITED BY SIZE INTO WS-KEYTXT
           SET     WS-KL                         TO    FUNCTION LENGTH(WS-XNAME::Trim())
           ADD    3 TO WS-KL
           SET     WS-AT                         TO    0
           PERFORM    VARYING WS-CH FROM 1 BY 1
                   UNTIL WS-CH + WS-KL > 1000 OR WS-AT > 0
               IF    WS-XLINE(WS-CH:WS-KL) = WS-KEYTXT(1:WS-KL)
                   COMPUTE    WS-AT = WS-CH + WS-KL
               END-IF
           END-PERFORM
           IF    WS-AT = 0
               EXIT PROGRAM
           END-IF

           SET     WS-XFOUND                     TO    "Y"
           SET     WS-PT                         TO    1
           SET     WS-CH                         TO    WS-AT

           PERFORM    UNTIL WS-CH > 1000 OR WS-XLINE(WS-CH:1) = QUOTE
               EVALUATE    TRUE
                   WHEN WS-XLINE(WS-CH:5) = "&amp;"
                       STRING    "&" INTO WS-XVAL WITH POINTER WS-PT
                       ADD    5 TO WS-CH
                   WHEN WS-XLINE(WS-CH:4) = "&lt;"
                       STRING    "<" INTO WS-XVAL WITH POINTER WS-PT
                       ADD    4 TO WS-CH
                   WHEN WS-XLINE(WS-CH:4) = "&gt;"
                       STRING    ">" INTO WS-XVAL WITH POINTER WS-PT
                       ADD    4 TO WS-CH
                   WHEN WS-XLINE(WS-CH:6) = "&quot;"
                       STRING    QUOTE DELIMITED BY SIZE INTO WS-XVAL WITH POINTER WS-PT
                       ADD    6 TO WS-CH
                   WHEN WS-XLINE(WS-CH:6) = "&apos;"
                       STRING    "'" INTO WS-XVAL WITH POINTER WS-PT
                       ADD    6 TO WS-CH
                   WHEN OTHER
                       STRING    WS-XLINE(WS-CH:1) INTO WS-XVAL WITH POINTER WS-PT
                       ADD    1 TO WS-CH
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-XML-PUT" paragraph="PC-XML-PUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Append WS-XLINE to the export file (the first line replaces it).

           IF    WS-XROOT = "N"
               COBOL::"WRITE-FILE" ( WS-XML-PATH WS-XLINE WS-LONG )
               SET     WS-XROOT                  TO    "Y"
           ELSE
               COBOL::"APPEND-FILE" ( WS-XML-PATH WS-XLINE WS-LONG )
           END-IF
]]></Event>
    <Event name="PC-REFRESH" paragraph="PC-REFRESH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   What each group holds, under its button. Model selection and Agents
           *>   wait for a model provider: without a connection they have nothing
           *>   to choose from (operator, 2026-09-25).
           *>   The main form owns the menu, which opens once an agent has a model:
           *>   it re-reads the settings now instead of when Chat is next clicked
           *>   (operator, 2026-09-26).

           INVOKE    super::"PC-REFRESH"()
           SET     WS-SET-NAME                   TO    "KB-LOCATION"
           CALL    "PC-SETTING-GET"
           IF    WS-SET-VALUE = SPACES
               SET     WS-SET-VALUE              TO    "assets/KB"
           END-IF
           SET     Lbl-KbSum::Caption            TO    WS-SET-VALUE
           CALL    "PC-LOAD-MODELS"
           IF    WS-MODEL-COUNT = 0
               SET     Lbl-ProvSum::Caption      TO    T-SUM-NO-CONNS::Trim()
               SET     Lbl-ModelSum::Caption     TO    T-SUM-NEED-PROVIDER::Trim()
               SET     Lbl-AgentSum::Caption     TO    T-SUM-NEED-PROVIDER::Trim()
               SET     Btn-ModelSel::Enabled     TO    "false"
               SET     Btn-Agents::Enabled       TO    "false"

               EXIT PROGRAM
           END-IF

           SET     Btn-ModelSel::Enabled         TO    "true"
           SET     Btn-Agents::Enabled           TO    "true"
           SET     WS-FMT                        TO    T-SUM-CONNS
           SET     WS-NE                         TO    WS-MODEL-COUNT
           SET     WS-ARG1                       TO    WS-NE

           CALL    "PC-FMT"

           SET     Lbl-ProvSum::Caption          TO    WS-FMT-OUT::Trim()
           SET     WS-FMT                        TO    T-SUM-MODELS
           SET     WS-NE2                        TO    WS-WITH-MODEL
           SET     WS-ARG1                       TO    WS-NE2
           SET     WS-ARG2                       TO    WS-NE

           CALL    "PC-FMT"

           SET     Lbl-ModelSum::Caption         TO    WS-FMT-OUT::Trim()
           SET     WS-AGENTS-ON                  TO    0

           PERFORM    VARYING WS-A FROM 1 BY 1 UNTIL WS-A > 3
               IF    WS-AGENT-ENTRY(WS-A) NOT = SPACES
                   ADD    1 TO WS-AGENTS-ON
               END-IF
           END-PERFORM

           SET     WS-FMT                        TO    T-SUM-AGENTS
           SET     WS-ARG1                       TO    WS-AGENTS-ON

           CALL    "PC-FMT"
           SET     Lbl-AgentSum::Caption         TO    WS-FMT-OUT::Trim()
]]></Event>
    <Event name="PC-TEXTS" paragraph="PC-TEXTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language the user picked (LANG), the texts in it, and every
           *>   designed caption and hint that shows one. Called on load and again
           *>   whenever the language changes (R46).

           SET     WS-SET-NAME                   TO    "LANG"
           CALL    "PC-SETTING-GET"
           SET     WS-LANG                       TO    WS-SET-VALUE(1:2)
           *> Unset or unknown falls back to English, and WS-LANG says "en" too:
           *> the language timer compares it with PC-LANG-NOW, which also answers
           *> "en" in that case, so it must not see a change.

           EVALUATE    WS-LANG
               WHEN "en" MOVE 1 TO WS-LANG-IX
               WHEN "pt" MOVE 2 TO WS-LANG-IX
               WHEN "es" MOVE 3 TO WS-LANG-IX
               WHEN "fr" MOVE 4 TO WS-LANG-IX
               WHEN "jp" MOVE 5 TO WS-LANG-IX
               WHEN "cn" MOVE 6 TO WS-LANG-IX
               WHEN OTHER MOVE "en" TO WS-LANG
                   SET     WS-LANG-IX            TO    1
           END-EVALUATE
           *> One row per text, one column per language (the order of the EVALUATE):
           *> the picked column becomes PC-TEXT-NOW, which the T-... names redefine.
           *> The bound is the row count of PC-TEXT-TABLE: change both together.

           PERFORM    VARYING WS-TX-I FROM 1 BY 1 UNTIL WS-TX-I > 25
               SET     PC-TEXT-NOW(WS-TX-I)      TO    PC-TEXT(WS-TX-I, WS-LANG-IX)
           END-PERFORM

           SET     Lbl-Title::Caption            TO    T-SETTINGS-TITLE::Trim()
           SET     Btn-KbFolder::Caption         TO    T-KB-FOLDER-TITLE::Trim()
           SET     Btn-Providers::Caption        TO    T-PROVIDERS-TITLE::Trim()
           SET     Btn-ModelSel::Caption         TO    T-MODEL-SEL-TITLE::Trim()
           SET     Btn-Agents::Caption           TO    T-AGENTS-TITLE::Trim()
           SET     Lbl-Models::Caption           TO    T-MODELS::Trim()
           SET     Btn-Export::Caption           TO    T-EXPORT::Trim()
           SET     Btn-Import::Caption           TO    T-IMPORT::Trim()
           SET     Lbl-Status::Caption           TO    T-STATUS::Trim()
]]></Event>
    <Event name="PC-FMT" paragraph="PC-FMT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-FROM                                PIC    9(4).
       01 WS-CNT                                 PIC    9(4).
       01 WS-PART                                PIC    X(120).
       01 WS-DELIM                               PIC    XX.

       PROCEDURE DIVISION.
           *>   A message whose words go round numbers and names differently in each
           *>   language: WS-FMT holds "&1" .. "&4" where WS-ARG1..4 go.

           SET     WS-FMT-OUT                    TO    SPACES
           SET     WS-PT                         TO    1
           SET     WS-FROM                       TO    1

           PERFORM    UNTIL WS-FROM > FUNCTION LENGTH(WS-FMT)
               SET     WS-PART WS-DELIM          TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-FMT DELIMITED BY "&1" OR "&2" OR "&3" OR "&4"
                   INTO WS-PART DELIMITER IN WS-DELIM COUNT IN WS-CNT
                   WITH POINTER WS-FROM
               END-UNSTRING
               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-FMT-OUT WITH POINTER WS-PT
               END-IF
               *> No "&n" left: WS-DELIM stays blank and the tail was copied above, so
               *> WHEN OTHER pushes WS-FROM past the end to end the loop.

               EVALUATE    WS-DELIM
                   WHEN "&1" STRING WS-ARG1::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&2" STRING WS-ARG2::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&3" STRING WS-ARG3::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&4" STRING WS-ARG4::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN OTHER COMPUTE WS-FROM = FUNCTION LENGTH(WS-FMT) + 1
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-LANG-NOW" paragraph="PC-LANG-NOW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language saved now (LANG), into WS-LANG-NOW; "en" when unset.

           SET     WS-LANG-NOW                   TO    "en"
           *> Polled by the language timer every second, so it only looks: it never
           *> creates the settings file, and a file it cannot open leaves "en".

           OPEN    INPUT SETTINGS-FILE
           IF    WS-FS NOT = "00"
               EXIT PROGRAM
           END-IF
           SET     SET-NAME                      TO    "LANG"
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   EVALUATE    SET-VALUE(1:2)
                       WHEN "pt" WHEN "es" WHEN "fr" WHEN "jp" WHEN "cn"
                           SET     WS-LANG-NOW   TO    SET-VALUE(1:2)
                   END-EVALUATE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="SETTINGS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CALL    "PC-PATHS"
           CALL    "PC-TEXTS"

           COBOL::"PROVIDER-COUNT" ( WS-PROV-COUNT )
           CALL    "PC-REFRESH"
]]></Event>
    <Event name="onActivate" paragraph="SETTINGS-FORM--ONACTIVATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Back on the pane: the language may have changed meanwhile (R46).

           CALL    "PC-TEXTS"
           CALL    "PC-REFRESH"
]]></Event>
    <Event name="onClose" paragraph="SETTINGS-FORM--ONCLOSE">
    </Event>
  </form-events>
