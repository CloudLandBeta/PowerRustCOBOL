    <Event name="onClick" paragraph="BTN-BROWSEKB--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The operating system's own folder window (no typing, no typos).
           MOVE Txt-KbLocation::Text TO WS-PATH
           CALL "COBOL-FOLDER-DIALOG" USING T-KB-BROWSE-TITLE WS-PATH WS-XML-PATH
           IF WS-XML-PATH = SPACES
               EXIT PROGRAM
           END-IF
           MOVE WS-XML-PATH TO Txt-KbLocation::Text
           MOVE "KB-LOCATION" TO WS-SET-NAME
           MOVE WS-XML-PATH TO WS-SET-VALUE
           CALL "PC-SETTING-PUT"
           MOVE FUNCTION TRIM(T-KB-FOLDER-SAVED) TO Lbl-Status::Caption
]]></Event>
  </Control>
