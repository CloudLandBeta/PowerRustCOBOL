    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-REMOVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Models::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-MODEL-COUNT
               MOVE FUNCTION TRIM(T-PICK-MODEL-FIRST) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           OPEN I-O MODELS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT MODELS-FILE
               CLOSE MODELS-FILE
               OPEN I-O MODELS-FILE
           END-IF
           MOVE WS-MODEL-NAME(WS-INDEX) TO MDL-NAME
           DELETE MODELS-FILE
               INVALID KEY CONTINUE
           END-DELETE
           COMMIT
           CLOSE MODELS-FILE
           CALL "COBOL-MODEL-REMOVE" USING MDL-NAME
           CALL "COBOL-KEY-REMOVE" USING MDL-NAME
           MOVE FUNCTION TRIM(T-MODEL-REMOVED) TO Lbl-Status::Caption
           CALL "PC-LOAD-MODELS"
]]></Event>
  </Control>
