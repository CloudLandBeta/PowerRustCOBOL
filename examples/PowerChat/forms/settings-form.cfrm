    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">Assign to agent</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-USE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Models::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-MODEL-COUNT
               MOVE FUNCTION TRIM(T-PICK-MODEL-FIRST) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           MOVE Cmb-Agent::GetSelectedIndex() TO WS-AG-IX
           IF WS-AG-IX < 0 OR WS-AG-IX > 2
               MOVE FUNCTION TRIM(T-PICK-AGENT) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-AG-IX
           MOVE WS-AG-IX TO WS-A
           MOVE WS-A TO WS-AGENT
           MOVE SPACES TO WS-SET-NAME
           STRING "AGENT-" WS-AGENT "-ENTRY" DELIMITED BY SIZE INTO WS-SET-NAME
           MOVE WS-MODEL-NAME(WS-INDEX) TO WS-SET-VALUE
           CALL "PC-SETTING-PUT"
           MOVE T-AGENT-USES TO WS-FMT
           MOVE WS-AGENT TO WS-ARG1
           CALL "PC-FMT"
           MOVE FUNCTION TRIM(WS-FMT-OUT) TO Lbl-Status::Caption
           CALL "PC-LOAD-MODELS"
]]></Event>
  </Control>
