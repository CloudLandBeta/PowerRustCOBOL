    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Event name="onClick" paragraph="BTN-EDIT--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Models::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-MODEL-COUNT
               MOVE FUNCTION TRIM(T-PICK-MODEL-FIRST) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
      *>   Fill the fields from the entry. The key field stays empty: a key is
      *>   never read back; type a new one only to replace it.
           OPEN I-O MODELS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT MODELS-FILE
               CLOSE MODELS-FILE
               OPEN I-O MODELS-FILE
           END-IF
           MOVE WS-MODEL-NAME(WS-INDEX) TO MDL-NAME
           READ MODELS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   MOVE MDL-NAME TO Txt-Name::Text
                   MOVE MDL-API TO Txt-Api::Text
                   MOVE MDL-URL TO Txt-Url::Text
                   MOVE MDL-MODEL TO Txt-Model::Text
                   MOVE MDL-RANK TO Txt-Rank::Text
                   IF MDL-TOOLS = "Y"
                       MOVE "true" TO Chk-Tools::Checked
                   ELSE
                       MOVE "false" TO Chk-Tools::Checked
                   END-IF
                   MOVE SPACES TO Txt-Key::Text
           END-READ
           CLOSE MODELS-FILE
]]></Event>
  </Control>
