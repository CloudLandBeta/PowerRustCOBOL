  <Control id="Btn-Test" type="Button" x="528" y="412" w="168" h="30" tab-order="18" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#36383EFF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
