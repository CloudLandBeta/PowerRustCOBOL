<?xml version="1.0" encoding="UTF-8"?>
<Form name="SETTINGS-FORM" title="PowerChat" width="680" height="592" background="F2F4F5FF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" glass-style="Neumorphic Light" modal-overlay-style="Greyed">
  <working-storage><![CDATA[       01 WS-FS              GLOBAL PIC XX VALUE "00".
       01 WS-DATA-DIR        GLOBAL PIC X(200).
       01 WS-SET-NAME        GLOBAL PIC X(20).
       01 WS-SET-VALUE       GLOBAL PIC X(200).
       01 WS-NOW             GLOBAL PIC X(21).
       01 WS-EOF             GLOBAL PIC X.
       01 WS-OK              GLOBAL PIC X(4).
       01 WS-SETTINGS-PATH  GLOBAL PIC X(240).
       01 WS-MODELS-PATH  GLOBAL PIC X(240).
       01 WS-MODEL-COUNT     GLOBAL PIC 9(4) VALUE 0.
       01 WS-MODEL-NAMES     GLOBAL.
          05 WS-MODEL-NAME   PIC X(30) OCCURS 200.
       01 WS-INDEX           GLOBAL PIC S9(4).
       01 WS-ACTIVE          GLOBAL PIC X(30).
       01 WS-KEY-FLAG        GLOBAL PIC X.
       01 WS-KEY             GLOBAL PIC X(300).
       01 WS-STATUS          GLOBAL PIC X(200).
       01 WS-ROW             GLOBAL PIC X(160).
       01 WS-AGENT           GLOBAL PIC X.
       01 WS-A               GLOBAL PIC 9.
       01 WS-AGENT-ENTRIES   GLOBAL.
          05 WS-AGENT-ENTRY  PIC X(30) OCCURS 3.
       01 WS-RANK-TEXT       GLOBAL PIC X.
       01 WS-TOOLS           GLOBAL PIC X(4).
      *>   The interface texts (spec 071 R44): one row per text, one column
      *>   per language - en, pt, es, fr, jp, cn. Identifiers stay English;
      *>   only the values are translated.
       01 WS-LANG            GLOBAL PIC XX VALUE "en".
       01 WS-LANG-IX         GLOBAL PIC 9 VALUE 1.
       01 WS-TX-I            GLOBAL PIC 9(4).
       01 PC-TEXT-DATA       GLOBAL.
      *>   KB-FOLDER-SAVED
          05 FILLER PIC X(90) VALUE "Knowledge Base folder saved.".
          05 FILLER PIC X(90) VALUE "Pasta da base de conhecimento salva.".
          05 FILLER PIC X(90) VALUE "Carpeta de la base de conocimiento guardada.".
          05 FILLER PIC X(90) VALUE "Dossier de la base de connaissances enregistré.".
          05 FILLER PIC X(90) VALUE "ナレッジベースのフォルダーを保存しました。".
          05 FILLER PIC X(90) VALUE "知识库文件夹已保存。".
      *>   PICK-MODEL-FIRST
          05 FILLER PIC X(90) VALUE "Pick a model in the list first.".
          05 FILLER PIC X(90) VALUE "Escolha um modelo na lista primeiro.".
          05 FILLER PIC X(90) VALUE "Primero elige un modelo de la lista.".
          05 FILLER PIC X(90) VALUE "Choisissez d'abord un modèle dans la liste.".
          05 FILLER PIC X(90) VALUE "先に一覧からモデルを選んでください。".
          05 FILLER PIC X(90) VALUE "请先在列表中选择一个模型。".
      *>   TYPE-AGENT
          05 FILLER PIC X(90) VALUE "Type the agent: 1, 2 or 3.".
          05 FILLER PIC X(90) VALUE "Digite o agente: 1, 2 ou 3.".
          05 FILLER PIC X(90) VALUE "Escribe el agente: 1, 2 o 3.".
          05 FILLER PIC X(90) VALUE "Tapez l'agent : 1, 2 ou 3.".
          05 FILLER PIC X(90) VALUE "エージェントを入力してください：1、2、3 のいずれか。".
          05 FILLER PIC X(90) VALUE "请输入代理：1、2 或 3。".
      *>   AGENT-USES
          05 FILLER PIC X(90) VALUE "Agent &1 now uses this model.".
          05 FILLER PIC X(90) VALUE "O agente &1 agora usa este modelo.".
          05 FILLER PIC X(90) VALUE "El agente &1 ahora usa este modelo.".
          05 FILLER PIC X(90) VALUE "L'agent &1 utilise désormais ce modèle.".
          05 FILLER PIC X(90) VALUE "エージェント &1 がこのモデルを使うようになりました。".
          05 FILLER PIC X(90) VALUE "代理 &1 现在使用此模型。".
      *>   AGENT-OFF
          05 FILLER PIC X(90) VALUE "Agent &1 is off.".
          05 FILLER PIC X(90) VALUE "O agente &1 está desligado.".
          05 FILLER PIC X(90) VALUE "El agente &1 está apagado.".
          05 FILLER PIC X(90) VALUE "L'agent &1 est désactivé.".
          05 FILLER PIC X(90) VALUE "エージェント &1 は停止しています。".
          05 FILLER PIC X(90) VALUE "代理 &1 已停用。".
      *>   MODEL-REMOVED
          05 FILLER PIC X(90) VALUE "Model removed, with its key.".
          05 FILLER PIC X(90) VALUE "Modelo removido, junto com a chave.".
          05 FILLER PIC X(90) VALUE "Modelo quitado, junto con su clave.".
          05 FILLER PIC X(90) VALUE "Modèle retiré, avec sa clé.".
          05 FILLER PIC X(90) VALUE "モデルをキーとともに削除しました。".
          05 FILLER PIC X(90) VALUE "模型及其密钥已移除。".
