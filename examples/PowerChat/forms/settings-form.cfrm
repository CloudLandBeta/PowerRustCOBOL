    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Event name="onClick" paragraph="BTN-SAVEMODEL--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   Add or change an entry. The key, when typed, goes straight to the
      *>   key store and the field is cleared: it is never written to a file
      *>   of ours, never shown again (spec 071 R34, R37).
           MOVE Txt-Name::Text TO MDL-NAME
           MOVE Txt-Api::Text TO MDL-API
           MOVE Txt-Url::Text TO MDL-URL
           MOVE Txt-Model::Text TO MDL-MODEL
           MOVE Chk-Tools::IsChecked() TO WS-TOOLS
           IF WS-TOOLS(1:1) = "1"
               MOVE "Y" TO MDL-TOOLS
           ELSE
               MOVE "N" TO MDL-TOOLS
           END-IF
           MOVE Txt-Rank::Text TO WS-RANK-TEXT
           IF WS-RANK-TEXT IS NUMERIC AND WS-RANK-TEXT NOT = "0"
               MOVE WS-RANK-TEXT TO MDL-RANK
           ELSE
               MOVE 5 TO MDL-RANK
           END-IF
           IF MDL-NAME = SPACES OR MDL-API = SPACES
               MOVE FUNCTION TRIM(T-MODEL-NEEDS) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           OPEN I-O MODELS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT MODELS-FILE
               CLOSE MODELS-FILE
               OPEN I-O MODELS-FILE
           END-IF
           WRITE MODEL-REC
               INVALID KEY REWRITE MODEL-REC
           END-WRITE
           COMMIT
           CLOSE MODELS-FILE
           CALL "COBOL-MODEL-SET" USING MDL-NAME MDL-API MDL-URL MDL-MODEL
           MOVE T-MODEL-SAVED TO WS-STATUS
           MOVE Txt-Key::Text TO WS-KEY
           IF WS-KEY NOT = SPACES
               CALL "COBOL-KEY-SET" USING MDL-NAME WS-KEY WS-STATUS
               IF WS-STATUS = "OK"
                   MOVE T-MODEL-KEY-SAVED TO WS-STATUS
               END-IF
               MOVE SPACES TO WS-KEY
               MOVE SPACES TO Txt-Key::Text
           END-IF
           MOVE WS-STATUS TO Lbl-Status::Caption
           CALL "PC-LOAD-MODELS"
]]></Event>
  </Control>
