    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">Export...</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-EXPORT--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   rag-settings.xml: the folder, every model and every agent. Keys are
           *>   never written - they stay in the application's key store.

           COBOL::"SAVE-FILE-DIALOG" ( T-EXPORT-TITLE "XML|xml"
               "rag-settings.xml" WS-XML-PATH )
           IF    WS-XML-PATH = SPACES
               EXIT PROGRAM
           END-IF

           *> WS-XROOT "N" tells PC-XML-PUT the file is not started: the first line
           *> replaces any old file and the rest are appended. A write that fails
           *> leaves its reason in WS-LONG.

           SET     WS-XROOT                      TO    "N"
           SET     WS-XLINE                      TO    '<?xml version="1.0" encoding="UTF-8"?>'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XROOT = "N" (set above), so this is the first line; WS-XML-PATH = the file
           *>         chosen in the save dialog; WS-XLINE = the XML declaration <?xml version="1.0"
           *>         encoding="UTF-8"?>.
           *> Result: The file at WS-XML-PATH exists and holds that one line (an old file is
           *>         replaced); WS-XROOT = "Y". WS-LONG = SPACES when the write worked, otherwise
           *>         the file system's error text, which the IF below tests.

           CALL    "PC-XML-PUT"
           IF    WS-LONG NOT = SPACES
               SET     WS-FMT                    TO    T-FILE-UNWRITABLE
               SET     WS-ARG1                   TO    WS-XML-PATH
               SET     WS-ARG2                   TO    WS-LONG

               *> PC-FMT: fills the placeholders &1 to &4 of WS-FMT with WS-ARG1 to WS-ARG4 into
               *> WS-FMT-OUT.
               *> Uses:   WS-FMT = T-FILE-UNWRITABLE ("Could not write &1: &2" in English); WS-ARG1
               *>         = WS-XML-PATH, the file chosen, and WS-ARG2 = WS-LONG, the reason the
               *>         write failed (each cut to its first 300 characters).
               *> Result: WS-FMT-OUT = that text with the path and the reason; the next line shows
               *>         it in Lbl-Status::Caption and the export stops.

               CALL    "PC-FMT"
               SET     Lbl-Status::Caption       TO    WS-FMT-OUT::Trim()
               EXIT PROGRAM
           END-IF
           SET     WS-XLINE                      TO    '<rag-settings application="PowerChat" version="1">'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XML-PATH; WS-XLINE = <rag-settings application="PowerChat" version="1">,
           *>         the opening of the root element (set just above); WS-XROOT = "Y" now, so it is
           *>         appended.
           *> Result: The file gains that second line (WS-LONG = SPACES, or the error text if the
           *>         write failed).

           CALL    "PC-XML-PUT"
           SET     WS-SET-NAME                   TO    "KB-LOCATION"

           *> PC-SETTING-GET: reads one setting from the settings file (indexed, settings.idx in the
           *> data folder) by its name. It never writes a setting; a missing file is only created
           *> empty.
           *> Uses:   WS-SET-NAME = "KB-LOCATION" (set just above): the Knowledge Base folder.
           *> Result: WS-SET-VALUE = the folder saved, or SPACES when none was (no default is
           *>         applied here); the next line copies it to WS-XIN.

           CALL    "PC-SETTING-GET"
           SET     WS-XIN                        TO    WS-SET-VALUE

           *> PC-XML-ESC: turns WS-XIN into text that is safe inside an XML attribute: & < > " and '
           *> become &amp; &lt; &gt; &quot; &apos;.
           *> Uses:   WS-XIN = the Knowledge Base folder (WS-SET-VALUE, copied there just above).
           *> Result: WS-XOUT = that folder with the five characters escaped (SPACES when WS-XIN is
           *>         blank; cut at 600 characters); the <knowledge-base> line is built from it
           *>         next.

           CALL    "PC-XML-ESC"
           SET     WS-XLINE                      TO    SPACES
           STRING    '  <knowledge-base folder="' WS-XOUT::Trim() '"/>' INTO WS-XLINE

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XLINE = the <knowledge-base folder="..."/> line built just above from
           *>         WS-XOUT; WS-XML-PATH. WS-XROOT = "Y" (the file is already started: the line is
           *>         appended).
           *> Result: The file gains that line (WS-LONG = SPACES, or the error text if the write
           *>         failed).

           CALL    "PC-XML-PUT"
           SET     WS-XLINE                      TO    '  <models>'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XLINE = "  <models>", the line that opens the list of models (set just
           *>         above); WS-XML-PATH. WS-XROOT = "Y" (the file is already started: the line is
           *>         appended).
           *> Result: The file gains that line (WS-LONG = SPACES, or the error text if the write
           *>         failed).

           CALL    "PC-XML-PUT"
           OPEN    INPUT MODELS-FILE
           IF    WS-FS = "00"
               SET     MDL-NAME                  TO    LOW-VALUES
               SET     WS-EOF                    TO    "N"

               START    MODELS-FILE KEY IS >= MDL-NAME
                   INVALID KEY MOVE "Y" TO WS-EOF
               END-START
               PERFORM    UNTIL WS-EOF = "Y"
                   READ    MODELS-FILE NEXT RECORD
                       AT END MOVE "Y" TO WS-EOF
                       NOT AT END
                           SET     WS-XLINE      TO    SPACES
                           SET     WS-P          TO    1

                           STRING    '    <model' INTO WS-XLINE WITH POINTER WS-P
                           SET     WS-XIN        TO    MDL-NAME

                           *> PC-XML-ESC: turns WS-XIN into text that is safe inside an XML
                           *> attribute: & < > " and ' become &amp; &lt; &gt; &quot; &apos;.
                           *> Uses:   WS-XIN = MDL-NAME, the name of the connection being exported
                           *>         (set just above).
                           *> Result: WS-XOUT = the name escaped; the next line puts it in the
                           *>         name="..." attribute of the <model> line being built in
                           *>         WS-XLINE.

                           CALL    "PC-XML-ESC"
                           STRING    ' name="' WS-XOUT::Trim() '"' INTO WS-XLINE WITH POINTER WS-P
                           SET     WS-XIN        TO    MDL-API

                           *> PC-XML-ESC: turns WS-XIN into text that is safe inside an XML
                           *> attribute: & < > " and ' become &amp; &lt; &gt; &quot; &apos;.
                           *> Uses:   WS-XIN = MDL-API, the provider id of the connection (set just
                           *>         above).
                           *> Result: WS-XOUT = the provider id escaped; the next line puts it in
                           *>         the provider="..." attribute.

                           CALL    "PC-XML-ESC"
                           STRING    ' provider="' WS-XOUT::Trim() '"' INTO WS-XLINE WITH POINTER WS-P
                           SET     WS-XIN        TO    MDL-URL

                           *> PC-XML-ESC: turns WS-XIN into text that is safe inside an XML
                           *> attribute: & < > " and ' become &amp; &lt; &gt; &quot; &apos;.
                           *> Uses:   WS-XIN = MDL-URL, the endpoint of the connection (set just
                           *>         above).
                           *> Result: WS-XOUT = the endpoint escaped (cut at 600 characters); the
                           *>         next line puts it in the endpoint="..." attribute.

                           CALL    "PC-XML-ESC"
                           STRING    ' endpoint="' WS-XOUT::Trim() '"' INTO WS-XLINE WITH POINTER WS-P
                           SET     WS-XIN        TO    MDL-MODEL

                           *> PC-XML-ESC: turns WS-XIN into text that is safe inside an XML
                           *> attribute: & < > " and ' become &amp; &lt; &gt; &quot; &apos;.
                           *> Uses:   WS-XIN = MDL-MODEL, the model chosen for the connection (set
                           *>         just above).
                           *> Result: WS-XOUT = the model name escaped; the next line puts it in the
                           *>         model="..." attribute.

                           CALL    "PC-XML-ESC"

                           STRING    ' model="' WS-XOUT::Trim() '"' INTO WS-XLINE WITH POINTER WS-P
                           STRING    ' tools="' MDL-TOOLS '" rank="' MDL-RANK '"/>'
                               DELIMITED BY SIZE INTO WS-XLINE WITH POINTER WS-P

                           *> PC-XML-PUT: appends WS-XLINE as one line to the export file
                           *> WS-XML-PATH (the first line, with WS-XROOT = "N", starts the file anew
                           *> instead).
                           *> Uses:   WS-XLINE = the <model name=... provider=... endpoint=...
                           *>         model=... tools=... rank=.../> line of the connection just
                           *>         read, built above; WS-XML-PATH. The API key is never part of
                           *>         it. WS-XROOT = "Y" (the file is already started: the line is
                           *>         appended).
                           *> Result: The file gains that line (WS-LONG = SPACES, or the error text
                           *>         if the write failed).

                           CALL    "PC-XML-PUT"
                   END-READ
               END-PERFORM
               CLOSE    MODELS-FILE
           END-IF
           SET     WS-XLINE                      TO    '  </models>'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XLINE = "  </models>", which closes the list of models (set just above);
           *>         WS-XML-PATH. WS-XROOT = "Y" (the file is already started: the line is
           *>         appended).
           *> Result: The file gains that line (WS-LONG = SPACES, or the error text if the write
           *>         failed).

           CALL    "PC-XML-PUT"
           SET     WS-XLINE                      TO    '  <agents>'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XLINE = "  <agents>", the line that opens the list of agents (set just
           *>         above); WS-XML-PATH. WS-XROOT = "Y" (the file is already started: the line is
           *>         appended).
           *> Result: The file gains that line (WS-LONG = SPACES, or the error text if the write
           *>         failed).

           CALL    "PC-XML-PUT"

           *> PC-LOAD-AGENTS: reads which connection each of the chat's three agents uses.
           *> Uses:   the settings AGENT-1-ENTRY, AGENT-2-ENTRY and AGENT-3-ENTRY, and MODEL-ENTRY
           *>         as the fallback of agent 1 only.
           *> Result: WS-AGENT-ENTRY(1) to WS-AGENT-ENTRY(3) = the connection name of each agent,
           *>         SPACES for an agent that has none; the loop below writes them to the export
           *>         file.

           CALL    "PC-LOAD-AGENTS"

           PERFORM    VARYING WS-A FROM 1 BY 1 UNTIL WS-A > 3
               SET     WS-XIN                    TO    WS-AGENT-ENTRY(WS-A)

               *> PC-XML-ESC: turns WS-XIN into text that is safe inside an XML attribute: & < > "
               *> and ' become &amp; &lt; &gt; &quot; &apos;.
               *> Uses:   WS-XIN = WS-AGENT-ENTRY(WS-A), the connection agent WS-A uses (set just
               *>         above).
               *> Result: WS-XOUT = that name escaped, for the model="..." attribute of the <agent>
               *>         line built next.

               CALL    "PC-XML-ESC"
               SET     WS-XLINE                  TO    SPACES
               STRING    '    <agent number="' WS-A '" model="' WS-XOUT::Trim() '"/>'
                   DELIMITED BY SIZE INTO WS-XLINE

               *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
               *> line, with WS-XROOT = "N", starts the file anew instead).
               *> Uses:   WS-XLINE = the <agent number="n" model="..."/> line for agent WS-A (n =
               *>         WS-A, 1 to 3), built just above; WS-XML-PATH. WS-XROOT = "Y" (the file is
               *>         already started: the line is appended).
               *> Result: The file gains that line (WS-LONG = SPACES, or the error text if the write
               *>         failed).

               CALL    "PC-XML-PUT"
           END-PERFORM
           SET     WS-XLINE                      TO    '  </agents>'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XLINE = "  </agents>", which closes the list of agents (set just above);
           *>         WS-XML-PATH. WS-XROOT = "Y" (the file is already started: the line is
           *>         appended).
           *> Result: The file gains that line (WS-LONG = SPACES, or the error text if the write
           *>         failed).

           CALL    "PC-XML-PUT"
           SET     WS-XLINE                      TO    '</rag-settings>'

           *> PC-XML-PUT: appends WS-XLINE as one line to the export file WS-XML-PATH (the first
           *> line, with WS-XROOT = "N", starts the file anew instead).
           *> Uses:   WS-XLINE = "</rag-settings>", which closes the root element (set just above);
           *>         WS-XML-PATH. WS-XROOT = "Y" (the file is already started: the line is
           *>         appended).
           *> Result: The file gains the last line of the export (WS-LONG = SPACES, or the error
           *>         text if the write failed).

           CALL    "PC-XML-PUT"

           SET     WS-FMT                        TO    T-EXPORTED
           SET     WS-ARG1                       TO    WS-XML-PATH

           *> PC-FMT: fills the placeholders &1 to &4 of WS-FMT with WS-ARG1 to WS-ARG4 into
           *> WS-FMT-OUT.
           *> Uses:   WS-FMT = T-EXPORTED ("Settings exported to &1 (API keys are never exported)."
           *>         in English); WS-ARG1 = WS-XML-PATH, the file written (its first 300
           *>         characters).
           *> Result: WS-FMT-OUT = that text with the path; the next line shows it in
           *>         Lbl-Status::Caption.

           CALL    "PC-FMT"
           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()
]]></Event>
  </Control>
  <Control id="Btn-Import" type="Button" x="182" y="480" w="150" h="32" tab-order="7" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">0</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">Import...</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-IMPORT--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Read a rag-settings.xml back: the folder, each model (added or
           *>   replaced) and each agent. The export never writes a key, but a
           *>   file may carry one - key="..." on a <model>, added by hand - and it
           *>   is stored in the key store like one typed in Model providers. The
           *>   models still without a key are named afterwards.

           COBOL::"OPEN-FILE-DIALOG" ( T-IMPORT-TITLE "XML|xml" WS-XML-PATH )
           IF    WS-XML-PATH = SPACES
               EXIT PROGRAM
           END-IF
           OPEN    INPUT XML-FILE
           IF    WS-FS NOT = "00"
               SET     Lbl-Status::Caption       TO    T-NOT-RAG-FILE::Trim()
               EXIT PROGRAM
           END-IF

           SET     WS-XROOT WS-EOF               TO    "N"
           SET     WS-IMPORTED                   TO    0
           SET     WS-NEED-KEYS                  TO    SPACES

           OPEN    I-O MODELS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT MODELS-FILE
               CLOSE    MODELS-FILE
               OPEN    I-O MODELS-FILE
           END-IF
           PERFORM    UNTIL WS-EOF = "Y"
               READ    XML-FILE INTO WS-XLINE
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       SET     WS-XLINE          TO    WS-XLINE::Trim()
                       *> Lines before the <rag-settings> root are skipped, so a file without
                       *> it changes nothing and is refused after the loop (WS-XROOT).

                       EVALUATE    TRUE
                           WHEN WS-XLINE(1:13) = "<rag-settings"
                               SET     WS-XROOT  TO    "Y"
                           WHEN WS-XROOT NOT = "Y"
                               CONTINUE
                           WHEN WS-XLINE(1:15) = "<knowledge-base"
                               SET     WS-XNAME  TO    "folder"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <knowledge-base .../> line just read
                               *>         (trimmed); WS-XNAME = "folder" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The IF below saves it when it is not blank.

                               CALL    "PC-XML-ATTR"
                               IF    WS-XVAL NOT = SPACES
                                   SET     WS-SET-NAME
                                                 TO    "KB-LOCATION"

                                   SET     WS-SET-VALUE
                                                 TO    WS-XVAL

                                   *> PC-SETTING-PUT: stores one setting in the settings file
                                   *> (indexed, settings.idx in the data folder): inserts the record
                                   *> or replaces it, and commits at once. A missing file is created
                                   *> empty first.
                                   *> Uses:   WS-SET-NAME = "KB-LOCATION" and WS-SET-VALUE =
                                   *>         WS-XVAL, the folder read from the file (its first 200
                                   *>         characters; both set just above).
                                   *> Result: The setting KB-LOCATION now holds the imported folder,
                                   *>         committed. The record area (SET-NAME, SET-VALUE) and
                                   *>         WS-FS are overwritten; WS-SET-NAME and WS-SET-VALUE
                                   *>         are not changed.

                                   CALL    "PC-SETTING-PUT"
                               END-IF
                           WHEN WS-XLINE(1:7) = "<model "
                               SET     MODEL-REC TO    SPACES
                               SET     WS-XNAME  TO    "name"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read (trimmed);
                               *>         WS-XNAME = "name" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies its first 30 characters
                               *>         to MDL-NAME, the key of the new record.

                               CALL    "PC-XML-ATTR"

                               SET     MDL-NAME  TO    WS-XVAL
                               SET     WS-XNAME  TO    "provider"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read; WS-XNAME =
                               *>         "provider" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies its first 12 characters
                               *>         to MDL-API, the provider id.

                               CALL    "PC-XML-ATTR"

                               SET     MDL-API   TO    WS-XVAL
                               SET     WS-XNAME  TO    "endpoint"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read; WS-XNAME =
                               *>         "endpoint" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies its first 200 characters
                               *>         to MDL-URL.

                               CALL    "PC-XML-ATTR"

                               SET     MDL-URL   TO    WS-XVAL
                               SET     WS-XNAME  TO    "model"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read; WS-XNAME =
                               *>         "model" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies its first 80 characters
                               *>         to MDL-MODEL.

                               CALL    "PC-XML-ATTR"

                               SET     MDL-MODEL TO    WS-XVAL
                               SET     WS-XNAME  TO    "tools"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read; WS-XNAME =
                               *>         "tools" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies its first character to
                               *>         MDL-TOOLS.

                               CALL    "PC-XML-ATTR"

                               SET     MDL-TOOLS TO    WS-XVAL(1:1)
                               SET     WS-XNAME  TO    "rank"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read; WS-XNAME =
                               *>         "rank" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The IF below sets MDL-RANK to its first
                               *>         character when that is a digit, otherwise to 5.

                               CALL    "PC-XML-ATTR"
                               IF    WS-XVAL(1:1) IS NUMERIC
                                   SET     MDL-RANK
                                                 TO    WS-XVAL(1:1)
                               ELSE
                                   SET     MDL-RANK
                                                 TO    5
                               END-IF
                               SET     WS-XNAME  TO    "key"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <model .../> line just read; WS-XNAME =
                               *>         "key" (set just above): the API key the export never
                               *>         writes but a hand-edited file may carry.
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies it to WS-KEY.

                               CALL    "PC-XML-ATTR"
                               SET     WS-KEY    TO    WS-XVAL
                               IF    MDL-NAME NOT = SPACES
                                   WRITE    MODEL-REC
                                       INVALID KEY REWRITE MODEL-REC
                                   END-WRITE
                                   COBOL::"MODEL-SET" ( MDL-NAME MDL-API MDL-URL MDL-MODEL )
                                   IF    WS-KEY NOT = SPACES
                                       COBOL::"KEY-SET" ( MDL-NAME WS-KEY WS-STATUS )
                                       SET     WS-KEY
                                                 TO    SPACES
                                   END-IF
                                   ADD    1 TO WS-IMPORTED
                                   *> Once the model is stored: if its provider needs a key and none is
                                   *> stored, its name joins the comma list WS-NEED-KEYS, reported at the
                                   *> end. WS-XOUT carries the list while it is rebuilt: STRING cannot
                                   *> read its own target.

                                   SET     WS-PROV-ID
                                                 TO    MDL-API

                                   *> PC-PROVIDER-LABEL: finds a provider in the IDE's provider list
                                   *> by its id (any case) and loads its label, default endpoint and
                                   *> whether it needs an API key.
                                   *> Uses:   WS-PROV-ID = MDL-API of the model just stored (set
                                   *>         above) and WS-PROV-COUNT, the number of providers.
                                   *> Result: WS-PROV-NEEDS = "Y" or "N": whether that provider
                                   *>         needs an API key (the lines below add the model to
                                   *>         WS-NEED-KEYS when it does and none is stored).
                                   *>         WS-PROV-IX (0 = unknown), WS-PROV-ID, WS-PROV-LABEL
                                   *>         and WS-PROV-EP are set too. It also overwrites WS-XVAL
                                   *>         and WS-XNAME (the import's XML scratch items, set
                                   *>         again before their next use) and WS-P.

                                   CALL    "PC-PROVIDER-LABEL"
                                   COBOL::"KEY-IS-SET" ( MDL-NAME WS-KEY-FLAG )
                                   IF    WS-PROV-NEEDS = "Y" AND WS-KEY-FLAG NOT = "Y"
                                       IF    WS-NEED-KEYS = SPACES
                                           SET     WS-NEED-KEYS
                                                 TO    MDL-NAME
                                       ELSE
                                           SET     WS-XOUT
                                                 TO    WS-NEED-KEYS

                                           SET     WS-NEED-KEYS
                                                 TO    SPACES

                                           STRING    WS-XOUT::Trim() ", " FUNCTION TRIM(MDL-NAME)
                                               INTO WS-NEED-KEYS
                                       END-IF
                                   END-IF
                               END-IF
                           WHEN WS-XLINE(1:7) = "<agent "
                               SET     WS-XNAME  TO    "number"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <agent .../> line just read; WS-XNAME =
                               *>         "number" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. The next line copies its first character to
                               *>         WS-AGENT.

                               CALL    "PC-XML-ATTR"

                               SET     WS-AGENT  TO    WS-XVAL(1:1)
                               SET     WS-XNAME  TO    "model"

                               *> PC-XML-ATTR: finds the attribute named in WS-XNAME on the XML line
                               *> in WS-XLINE and returns its value with the entities (&amp; &lt;
                               *> &gt; &quot; &apos;) turned back into characters.
                               *> Uses:   WS-XLINE = the <agent .../> line just read; WS-XNAME =
                               *>         "model" (set just above).
                               *> Result: WS-XVAL = the value (at most 300 characters), SPACES when
                               *>         the line has no such attribute; WS-XFOUND = "Y" or "N"
                               *>         accordingly. It is the connection that agent uses; the IF
                               *>         below stores it when WS-AGENT is 1, 2 or 3.

                               CALL    "PC-XML-ATTR"
                               IF    WS-AGENT = "1" OR WS-AGENT = "2" OR WS-AGENT = "3"
                                   SET     WS-SET-NAME
                                                 TO    SPACES

                                   STRING    "AGENT-" WS-AGENT "-ENTRY" DELIMITED BY SIZE
                                       INTO WS-SET-NAME
                                   SET     WS-SET-VALUE
                                                 TO    WS-XVAL

                                   *> PC-SETTING-PUT: stores one setting in the settings file
                                   *> (indexed, settings.idx in the data folder): inserts the record
                                   *> or replaces it, and commits at once. A missing file is created
                                   *> empty first.
                                   *> Uses:   WS-SET-NAME = "AGENT-n-ENTRY" with n = WS-AGENT (1 to
                                   *>         3), built just above, and WS-SET-VALUE = WS-XVAL, the
                                   *>         connection name read from the file (its first 200
                                   *>         characters).
                                   *> Result: The setting AGENT-n-ENTRY now holds that connection
                                   *>         name, committed: the agent uses the imported
                                   *>         connection. The record area (SET-NAME, SET-VALUE) and
                                   *>         WS-FS are overwritten; WS-SET-NAME and WS-SET-VALUE
                                   *>         are not changed.

                                   CALL    "PC-SETTING-PUT"
                               END-IF
                       END-EVALUATE
               END-READ
           END-PERFORM
           COMMIT

           CLOSE    MODELS-FILE
           CLOSE    XML-FILE

           IF    WS-XROOT NOT = "Y"
               SET     Lbl-Status::Caption       TO    T-NOT-RAG-FILE::Trim()
               EXIT PROGRAM
           END-IF

           *> PC-REFRESH: brings the summaries of the pane up to date: the Knowledge Base folder,
           *> the model list and what each of the four group buttons holds.
           *> Uses:   the settings, MODELS-FILE and the agent settings as the import has just left
           *>         them. It also reads the application's model list and the key store.
           *> Result: It also asks CHAT-FORM, with INVOKE super::"PC-REFRESH"(), to run its own
           *>         PC-REFRESH (fire-and-forget: the chat runs it when its event loop is next
           *>         idle), so the chat follows the change. The summaries and Lst-Models show the
           *>         imported folder, models and agents; Btn-ModelSel and Btn-Agents follow the
           *>         number of connections. MODELS-FILE is first mirrored from the application's
           *>         model list (PC-SYNC-MODELS): records may be added, updated or deleted.

           CALL    "PC-REFRESH"

           SET     WS-FMT                        TO    T-IMPORTED
           SET     WS-NE                         TO    WS-IMPORTED
           SET     WS-ARG1                       TO    WS-NE

           *> PC-FMT: fills the placeholders &1 to &4 of WS-FMT with WS-ARG1 to WS-ARG4 into
           *> WS-FMT-OUT.
           *> Uses:   WS-FMT = T-IMPORTED ("&1 models imported." in English); WS-ARG1 = WS-NE,
           *>         WS-IMPORTED edited (set just above).
           *> Result: WS-FMT-OUT = that text with &1 replaced by the number of models imported; the
           *>         next line copies it to WS-LONG (600 characters).

           CALL    "PC-FMT"
           SET     WS-LONG                       TO    WS-FMT-OUT
           IF    WS-NEED-KEYS NOT = SPACES
               SET     WS-FMT                    TO    T-IMPORT-KEYS
               SET     WS-ARG1                   TO    WS-NEED-KEYS

               *> PC-FMT: fills the placeholders &1 to &4 of WS-FMT with WS-ARG1 to WS-ARG4 into
               *> WS-FMT-OUT.
               *> Uses:   WS-FMT = T-IMPORT-KEYS ("Set the API key of: &1" in English); WS-ARG1 =
               *>         WS-NEED-KEYS, the comma-separated names of the imported connections that
               *>         need a key and have none (its first 300 characters).
               *> Result: WS-FMT-OUT = that text with the names; the lines below append it to
               *>         WS-LONG (600 characters), the status shown in Lbl-Status::Caption.

               CALL    "PC-FMT"

               SET     WS-XOUT                   TO    WS-LONG
               SET     WS-LONG                   TO    SPACES

               STRING    WS-XOUT::Trim() " " WS-FMT-OUT::Trim() INTO WS-LONG
           END-IF
           SET     Lbl-Status::Caption           TO    WS-LONG
]]></Event>
  </Control>
  <Control id="Lbl-Status" type="Label" x="24" y="524" w="672" h="80" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="AutoSize">false</Property>
    <Property name="Caption">Status</Property>
    <Property name="WordWrap">true</Property>
    <Property name="VerticalAlignment">Top</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
  </Control>
  <Control id="Tmr-Lang" type="Timer" x="720" y="16" w="48" h="48" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Interval">1000</Property>
    <Property name="Enabled">true</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onTick" paragraph="TMR-LANG--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   A flag in the chat's menu changes the language while this form is
           *>   on the pane; nothing tells a pane occupant, so it looks (R46).

           *> PC-LANG-NOW: reads the language saved now (setting LANG) without creating anything.
           *> Uses:   SETTINGS-FILE, opened for input, record "LANG"; polled by the timer Tmr-Lang
           *>         every second (Interval 1000).
           *> Result: WS-LANG-NOW = "pt", "es", "fr", "jp" or "cn" as saved, otherwise "en" (unset,
           *>         "en", unknown or a file that cannot be opened). The IF below compares it with
           *>         WS-LANG, the language of the texts on screen.

           CALL    "PC-LANG-NOW"
           IF    WS-LANG-NOW NOT = WS-LANG

               *> SETTINGS-FORM--ONACTIVATE: the form's own onActivate event: reloads the texts and
               *> the summaries.
               *> Uses:   the setting LANG (through PC-TEXTS) and the settings, MODELS-FILE and
               *>         agent settings (through PC-REFRESH). It runs because WS-LANG-NOW differs
               *>         from WS-LANG (the IF just above).
               *> Result: PC-TEXTS sets WS-LANG to the language saved now and rewrites the captions
               *>         in it; PC-REFRESH redraws the summaries and Lst-Models. WS-LANG then
               *>         equals WS-LANG-NOW, so the next tick finds no change.

               CALL    "SETTINGS-FORM--ONACTIVATE"
           END-IF
]]></Event>
  </Control>
</Form>