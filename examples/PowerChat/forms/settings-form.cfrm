    <Event name="onClick" paragraph="BTN-CLOSE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           INVOKE SUPER::SetProperty("ResultText", "SAVED")
           INVOKE ME::Close()
]]></Event>
  </Control>
</Form>