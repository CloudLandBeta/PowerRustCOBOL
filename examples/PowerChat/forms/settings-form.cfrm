    <Event name="onClick" paragraph="BTN-SAVEKB--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "KB-LOCATION" TO WS-SET-NAME
           MOVE Txt-KbLocation::Text TO WS-SET-VALUE
           IF WS-SET-VALUE = SPACES
               MOVE "assets/KB" TO WS-SET-VALUE
           END-IF
           CALL "PC-SETTING-PUT"
           MOVE "Knowledge Base folder saved." TO Lbl-Status::Caption
]]></Event>
