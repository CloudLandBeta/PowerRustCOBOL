    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="CornerRadius">10</Property>
    <Event name="onClick" paragraph="BTN-CANCEL-TOP--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The top Cancel; Btn-Cancel does the same.
           CALL "PC-CANCEL-EDIT"
]]></Event>
  </Control>
