<Form name="PROVIDERS-FORM" title="PowerChat" width="800" height="450" background="DFE0E1FF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" glass-style="Neumorphic Light" modal-overlay-style="Greyed">
  <working-storage><![CDATA[       01 WS-FS              GLOBAL PIC XX VALUE "00".
