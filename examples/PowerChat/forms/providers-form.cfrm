  <Control id="Btn-Remove" type="Button" x="24" y="390" w="140" h="36" tab-order="6" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
