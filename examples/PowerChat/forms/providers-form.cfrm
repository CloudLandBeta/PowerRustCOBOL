    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">Remove</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-REMOVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Cmb-Conn::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 1 OR WS-INDEX > WS-CONN-COUNT
               MOVE FUNCTION TRIM(T-PICK-CONN) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           OPEN I-O MODELS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT MODELS-FILE
               CLOSE MODELS-FILE
               OPEN I-O MODELS-FILE
           END-IF
           MOVE WS-CONN-NAME(WS-INDEX) TO MDL-NAME
           DELETE MODELS-FILE
               INVALID KEY CONTINUE
           END-DELETE
           COMMIT
           CLOSE MODELS-FILE
           CALL "COBOL-MODEL-REMOVE" USING MDL-NAME
           CALL "COBOL-KEY-REMOVE" USING MDL-NAME
           CALL "PC-FILL-CONNS"
           MOVE Cmb-Conn::SetSelectedIndex(0) TO WS-OK
           CALL "PC-SHOW-CONN"
           MOVE FUNCTION TRIM(T-CONN-REMOVED) TO Lbl-Status::Caption
]]></Event>
  </Control>
  <Control id="Btn-Test" type="Button" x="180" y="390" w="200" h="36" tab-order="7" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Caption">Test connection</Property>
    <Property name="Tooltip">Ask the provider for its model list, to check the address and the key.</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-TEST--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The connection test: ask the provider for its models. That proves
      *>   the address and the key; which model to use is chosen afterwards.
           CALL "PC-PICKED-PROVIDER"
           IF WS-PROV-IX = 0
               MOVE FUNCTION TRIM(T-PICK-PROVIDER) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           MOVE T-LISTING TO WS-FMT
           MOVE WS-PROV-LABEL TO WS-ARG1
           CALL "PC-FMT"
           MOVE FUNCTION TRIM(WS-FMT-OUT) TO Lbl-Status::Caption
           MOVE Txt-Url::Text TO WS-PATH
           MOVE Txt-Key::Text TO WS-KEY
           MOVE Txt-Name::Text TO MDL-NAME
           CALL "COBOL-MODEL-LIST" USING WS-PROV-ID WS-PATH WS-KEY WS-N
                WS-LONG MDL-NAME
           MOVE SPACES TO WS-KEY
           IF WS-LONG = "OK"
               MOVE T-CONN-OK-MODELS TO WS-FMT
               MOVE WS-N TO WS-NE
               MOVE WS-NE TO WS-ARG1
               CALL "PC-FMT"
               MOVE FUNCTION TRIM(WS-FMT-OUT) TO Lbl-Status::Caption
           ELSE
               MOVE WS-LONG TO Lbl-Status::Caption
           END-IF
]]></Event>
  </Control>
