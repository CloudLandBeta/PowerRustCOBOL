    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   Add or change a connection. The key, when typed, goes straight to
      *>   the key store and the field is cleared: it is never written to a
      *>   file of ours, never shown again (spec 071 R34, R37). The model
      *>   chosen for it survives, unless the provider changed.
           CALL "PC-PICKED-PROVIDER"
           MOVE Txt-Name::Text TO WS-XVAL
           IF WS-XVAL = SPACES OR WS-PROV-IX = 0
               MOVE FUNCTION TRIM(T-CONN-NEEDS) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           OPEN I-O MODELS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT MODELS-FILE
               CLOSE MODELS-FILE
               OPEN I-O MODELS-FILE
           END-IF
           MOVE WS-XVAL TO MDL-NAME
           READ MODELS-FILE
               INVALID KEY MOVE "N" TO WS-FOUND
               NOT INVALID KEY MOVE "Y" TO WS-FOUND
           END-READ
           IF WS-FOUND = "N" OR MDL-API NOT = WS-PROV-ID
               MOVE SPACES TO MDL-MODEL
               MOVE "N" TO MDL-TOOLS
               MOVE 5 TO MDL-RANK
           END-IF
           MOVE WS-XVAL TO MDL-NAME
           MOVE WS-PROV-ID TO MDL-API
           MOVE Txt-Url::Text TO MDL-URL
           IF MDL-URL = SPACES
               MOVE WS-PROV-EP TO MDL-URL
           END-IF
           IF WS-FOUND = "Y"
               REWRITE MODEL-REC
           ELSE
               WRITE MODEL-REC
           END-IF
           COMMIT
           CLOSE MODELS-FILE
           CALL "COBOL-MODEL-SET" USING MDL-NAME MDL-API MDL-URL MDL-MODEL
           MOVE T-CONN-SAVED TO WS-STATUS
           MOVE Txt-Key::Text TO WS-KEY
           IF WS-KEY NOT = SPACES
               CALL "COBOL-KEY-SET" USING MDL-NAME WS-KEY WS-STATUS
               IF WS-STATUS = "OK"
                   MOVE T-CONN-KEY-SAVED TO WS-STATUS
               END-IF
               MOVE SPACES TO WS-KEY
               MOVE SPACES TO Txt-Key::Text
           ELSE
      *>       A provider that needs a key, and none stored yet: say so, and
      *>       stay open so it can be typed now.
               CALL "COBOL-KEY-IS-SET" USING MDL-NAME WS-KEY-FLAG
               IF WS-PROV-NEEDS = "Y" AND WS-KEY-FLAG NOT = "Y"
                   MOVE FUNCTION TRIM(T-CONN-NEEDS-KEY) TO Lbl-Status::Caption
                   EXIT PROGRAM
               END-IF
           END-IF
           MOVE WS-STATUS TO Lbl-Status::Caption
           INVOKE ME::Close()
]]></Event>
  </Control>
</Form>