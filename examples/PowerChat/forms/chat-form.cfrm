    <Event name="onMenuItemClick" paragraph="SIDEMENU-1--ONMENUITEMCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE SideMenu-1::SelectedItemId TO WS-ITEM
           EVALUATE WS-ITEM
               WHEN "chat"
                   CONTINUE
               WHEN "tpcs"
                   CALL "PC-PICK-TOPIC"
               WHEN "docs"
                   INVOKE ME::"OpenFormSync"("DOCUMENTS-FORM")
               WHEN "sett"
                   INVOKE ME::"OpenFormSync"("SETTINGS-FORM")
                   CALL "PC-HAND-MODELS"
               WHEN "newc"
                   CALL "PC-NEW-CONV"
               WHEN OTHER
                   IF WS-ITEM(1:1) = "c"
                       CALL "PC-OPEN-CONV"
                   END-IF
           END-EVALUATE
           CALL "PC-STATUS"
]]></Event>
  </Control>
