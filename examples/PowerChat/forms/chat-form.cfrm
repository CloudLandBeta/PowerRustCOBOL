    <Event name="onMenuItemClick" paragraph="SIDEMENU-1--ONMENUITEMCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE SideMenu-1::SelectedItemId TO WS-ITEM
           EVALUATE WS-ITEM
               WHEN "chat"
                   CONTINUE
               WHEN "newc"
                   CALL "PC-NEW-CONV"
               WHEN OTHER
                   IF WS-ITEM(1:1) = "c"
                       CALL "PC-OPEN-CONV"
                   END-IF
           END-EVALUATE
           CALL "PC-STATUS"
]]></Event>
  </Control>
