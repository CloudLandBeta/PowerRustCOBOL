    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ToolProtocol">Native</Property>
    <Property name="MaximumToolRounds">8</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="Configuration"></Property>
    <Property name="ModelEntry"></Property>
    <Property name="AgentURL">http://localhost:11434</Property>
    <Property name="AgentModel">llama3.2</Property>
    <Property name="AgentAPI">Ollama</Property>
    <Property name="AgentAPIKey"></Property>
    <Property name="AgentEndpoint"></Property>
    <Property name="Temperature">70</Property>
    <Property name="Stream">true</Property>
    <Property name="TargetControls"></Property>
    <Property name="ResponseDataItem"></Property>
    <Property name="Verbose">false</Property>
    <Event name="onResponse" paragraph="AGENT-1--ONRESPONSE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE 1 TO WS-FROM
           MOVE AGENT-1::LastReply TO WS-REPLY
           MOVE AGENT-1::LastInputTokens TO WS-T-IN
           MOVE AGENT-1::LastOutputTokens TO WS-T-OUT
           CALL "PC-ON-REPLY"
]]></Event>
    <Event name="onError" paragraph="AGENT-1--ONERROR"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "IDLE" TO WS-STAGE
           MOVE AGENT-1::LastError TO WS-TEXT
           MOVE SPACES TO WS-MSG
           STRING "**Agent 1 could not answer:** " FUNCTION TRIM(WS-TEXT)
               DELIMITED BY SIZE INTO WS-MSG
           MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(WS-MSG)) TO WS-OK
           MOVE "The last question failed." TO Lbl-Status::Caption
]]></Event>
    <Event name="onModelChanged" paragraph="AGENT-1--ONMODELCHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   A model an agent uses changed: a new election (R36; 063 R71).
           CALL "PC-HAND-MODELS"
           CALL "PC-ELECT"
           CALL "PC-STATUS"
]]></Event>
  </Control>
