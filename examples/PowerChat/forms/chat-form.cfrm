  <Control id="Btn-Send" type="Button" x="868" y="620" w="108" h="112" tab-order="2" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Send</Property>
    <Property name="BackgroundColor">#36383EFF</Property>
