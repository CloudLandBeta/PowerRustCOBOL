    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-SEND--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Txt-Input::Text TO WS-QUESTION
           IF WS-QUESTION = SPACES
               EXIT PROGRAM
           END-IF
           IF WS-CUR-TOPIC = SPACES
               MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(T-OPEN-TOPIC-MENU)) TO WS-OK
               EXIT PROGRAM
           END-IF
           IF WS-ORCH = 0
               MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(T-ASSIGN-MODEL-MENU)) TO WS-OK
               EXIT PROGRAM
           END-IF
           IF WS-STAGE NOT = "IDLE"
               EXIT PROGRAM
           END-IF
           CALL "PC-START-CONV"
           MOVE "U" TO WS-ROLE
           MOVE WS-QUESTION TO WS-TEXT
           CALL "PC-SAVE-TURN"
           MOVE SPACES TO WS-MSG
           STRING "**" FUNCTION TRIM(T-YOU) ":** " FUNCTION TRIM(WS-QUESTION)
               DELIMITED BY SIZE INTO WS-MSG
           MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(WS-MSG)) TO WS-OK
           MOVE SPACES TO Txt-Input::Text
           CALL "PC-BUILD-PROMPT"
           MOVE WS-PROMPT TO WS-HISTORY
           IF WS-N-AGENTS = 1
      *>       One agent answers by itself (R52).
               MOVE "SINGLE" TO WS-STAGE
           ELSE
      *>       Several: the orchestrator plans first (R58).
               MOVE "PLAN" TO WS-STAGE
               STRING X"0A" X"0A"
                      "Split the user's last question into at most 3 independent"
                      " tasks for assistants who can search this topic's documents."
                      " Reply with one line per task, each starting with TASK:"
                   DELIMITED BY SIZE INTO WS-PROMPT WITH POINTER WS-PTR
               END-STRING
           END-IF
           MOVE WS-ORCH TO WS-FROM
           CALL "PC-ASK"
           MOVE FUNCTION TRIM(T-THINKING) TO Lbl-Status::Caption
]]></Event>
  </Control>
