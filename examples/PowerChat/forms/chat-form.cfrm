    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Event name="onClick" paragraph="BTN-SEND--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Txt-Input::Text TO WS-QUESTION
           IF WS-QUESTION = SPACES
               EXIT PROGRAM
           END-IF
           IF WS-CUR-TOPIC = SPACES
               MOVE Vwr-Chat::AppendMarkdown("Open a topic first - **Topics** in the menu.") TO WS-OK
               EXIT PROGRAM
           END-IF
           IF WS-ORCH = 0
               MOVE Vwr-Chat::AppendMarkdown("Assign a model to an agent first - **RAG settings** in the menu.") TO WS-OK
               EXIT PROGRAM
           END-IF
           IF WS-STAGE NOT = "IDLE"
               EXIT PROGRAM
           END-IF
           CALL "PC-START-CONV"
           MOVE "U" TO WS-ROLE
           MOVE WS-QUESTION TO WS-TEXT
           CALL "PC-SAVE-TURN"
           MOVE SPACES TO WS-MSG
           STRING "**You:** " FUNCTION TRIM(WS-QUESTION) DELIMITED BY SIZE INTO WS-MSG
           MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(WS-MSG)) TO WS-OK
           MOVE SPACES TO Txt-Input::Text
           CALL "PC-BUILD-PROMPT"
           MOVE WS-PROMPT TO WS-HISTORY
           IF WS-N-AGENTS = 1
      *>       One agent answers by itself (R52).
               MOVE "SINGLE" TO WS-STAGE
           ELSE
      *>       Several: the orchestrator plans first (R58).
               MOVE "PLAN" TO WS-STAGE
               STRING X"0A" X"0A"
                      "Split the user's last question into at most 3 independent"
                      " tasks for assistants who can search this topic's documents."
                      " Reply with one line per task, each starting with TASK:"
                   DELIMITED BY SIZE INTO WS-PROMPT WITH POINTER WS-PTR
               END-STRING
           END-IF
           MOVE WS-ORCH TO WS-FROM
           CALL "PC-ASK"
           MOVE "Thinking..." TO Lbl-Status::Caption
]]></Event>
  </Control>
  <Control id="AGENT-1" type="AgentObject" x="1000" y="16" w="48" h="48" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="TimeoutSeconds">120</Property>
    <Property name="MaximumTokens">1024</Property>
    <Property name="SystemPrompt">You are a careful research assistant. Answer only from what the topic&apos;s documents and data say, and say so when they do not.</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
