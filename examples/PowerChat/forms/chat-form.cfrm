    <Event name="onClick" paragraph="BTN-SEND--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Txt-Input::Text TO WS-QUESTION
           IF WS-QUESTION = SPACES
               EXIT PROGRAM
           END-IF
           IF WS-CUR-TOPIC = SPACES
               MOVE Vwr-Chat::AppendMarkdown("Open a topic first - **Topics** in the menu.") TO WS-OK
               EXIT PROGRAM
           END-IF
           CALL "PC-START-CONV"
           MOVE "U" TO WS-ROLE
           MOVE WS-QUESTION TO WS-TEXT
           CALL "PC-SAVE-TURN"
           MOVE SPACES TO WS-MSG
           STRING "**You:** " FUNCTION TRIM(WS-QUESTION) DELIMITED BY SIZE INTO WS-MSG
           MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(WS-MSG)) TO WS-OK
           MOVE SPACES TO Txt-Input::Text
           CALL "PC-BUILD-PROMPT"
           MOVE AGENT-1::Ask(FUNCTION TRIM(WS-PROMPT)) TO WS-OK
           MOVE "Thinking..." TO Lbl-Status::Caption
]]></Event>
  </Control>
  <Control id="AGENT-1" type="AgentObject" x="1000" y="16" w="48" h="48" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="TimeoutSeconds">120</Property>
    <Property name="MaximumTokens">1024</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ToolProtocol">Native</Property>
    <Property name="MaximumToolRounds">8</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="Configuration"></Property>
    <Property name="ModelEntry"></Property>
    <Property name="AgentURL">http://localhost:11434</Property>
    <Property name="AgentModel">llama3.2</Property>
    <Property name="AgentAPI">Ollama</Property>
    <Property name="AgentAPIKey"></Property>
    <Property name="AgentEndpoint"></Property>
    <Property name="SystemPrompt">You are a helpful assistant.</Property>
    <Property name="Temperature">70</Property>
    <Property name="Stream">true</Property>
    <Property name="TargetControls"></Property>
    <Property name="ResponseDataItem"></Property>
    <Property name="Verbose">false</Property>
    <Event name="onResponse" paragraph="AGENT-1--ONRESPONSE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE AGENT-1::LastReply TO WS-REPLY
           MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(WS-REPLY)) TO WS-OK
           MOVE Vwr-Chat::JumpToLatest() TO WS-OK
           MOVE "A" TO WS-ROLE
           MOVE WS-REPLY TO WS-TEXT
           CALL "PC-SAVE-TURN"
      *>   Token counts, per conversation (R42).
           OPEN I-O CONVS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT CONVS-FILE
               CLOSE CONVS-FILE
               OPEN I-O CONVS-FILE
           END-IF
           MOVE WS-CUR-CONV TO CNV-ID
           READ CONVS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   MOVE AGENT-1::LastInputTokens TO WS-TOKENS
                   ADD WS-TOKENS TO CNV-IN-TOKENS
                   MOVE AGENT-1::LastOutputTokens TO WS-TOKENS
                   ADD WS-TOKENS TO CNV-OUT-TOKENS
                   MOVE WS-SEQ TO CNV-TURNS
                   REWRITE CONV-REC
                   END-REWRITE
                   COMMIT
           END-READ
           CLOSE CONVS-FILE
           CALL "PC-STATUS"
]]></Event>
    <Event name="onError" paragraph="AGENT-1--ONERROR"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE AGENT-1::LastError TO WS-TEXT
           MOVE SPACES TO WS-MSG
           STRING "**The assistant could not answer:** " FUNCTION TRIM(WS-TEXT)
               DELIMITED BY SIZE INTO WS-MSG
           MOVE Vwr-Chat::AppendMarkdown(FUNCTION TRIM(WS-MSG)) TO WS-OK
           MOVE "The last question failed." TO Lbl-Status::Caption
]]></Event>
    <Event name="onModelChanged" paragraph="AGENT-1--ONMODELCHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The model this chat uses was changed in the settings (076).
           MOVE "The model settings changed; the next question uses them." TO Lbl-Status::Caption
]]></Event>
  </Control>
