    <Event name="onClick" paragraph="BTN-REMOVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Files::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-FILE-COUNT
               MOVE "Pick a file in the list first." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           OPEN I-O TFILES-FILE
           IF WS-FS = "35"
               OPEN OUTPUT TFILES-FILE
               CLOSE TFILES-FILE
               OPEN I-O TFILES-FILE
           END-IF
           MOVE WS-CUR-TOPIC TO TF-TOPIC
           MOVE WS-FILE-SEQ(WS-INDEX) TO TF-SEQ
           DELETE TFILES-FILE
               INVALID KEY CONTINUE
           END-DELETE
           COMMIT
           CLOSE TFILES-FILE
           MOVE "Removed. The file itself is untouched." TO Lbl-Status::Caption
           CALL "PC-LOAD-FILES"
]]></Event>
  </Control>
