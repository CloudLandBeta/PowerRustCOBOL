    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-ADD--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   A file is only kept when it can be registered: its .cidx describes
      *>   it, and it can be read (R23-R25). Otherwise the reason is shown.
           MOVE Txt-Data::Text TO WS-DATA
           MOVE Txt-Cidx::Text TO WS-CIDX
           IF WS-DATA = SPACES OR WS-CIDX = SPACES
               MOVE "Give both the data file and its .cidx description." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           CALL "PC-TRY"
           IF WS-OK NOT = "1"
               MOVE SPACES TO WS-LINE
               STRING "Not added - " FUNCTION TRIM(WS-RESULT) ": " FUNCTION TRIM(WS-MESSAGE)
                   DELIMITED BY SIZE INTO WS-LINE
               MOVE WS-LINE TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           OPEN I-O TFILES-FILE
           IF WS-FS = "35"
               OPEN OUTPUT TFILES-FILE
               CLOSE TFILES-FILE
               OPEN I-O TFILES-FILE
           END-IF
           MOVE WS-CUR-TOPIC TO TF-TOPIC
           MOVE WS-NEXT-SEQ TO TF-SEQ
           MOVE WS-NAME TO TF-NAME
           MOVE WS-DATA TO TF-DATA
           MOVE WS-CIDX TO TF-CIDX
           WRITE TFILE-REC
               INVALID KEY REWRITE TFILE-REC
           END-WRITE
           COMMIT
           CLOSE TFILES-FILE
           MOVE SPACES TO WS-LINE
           STRING "Added " FUNCTION TRIM(WS-NAME) " - " FUNCTION TRIM(WS-MESSAGE)
               DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Status::Caption
           MOVE SPACES TO Txt-Data::Text
           MOVE SPACES TO Txt-Cidx::Text
           CALL "PC-LOAD-FILES"
]]></Event>
  </Control>
