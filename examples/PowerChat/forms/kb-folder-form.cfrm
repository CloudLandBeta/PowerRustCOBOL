    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-BROWSEKB--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The operating system's own folder window (no typing, no typos).
      *>   The choice waits in the field until Save.
           MOVE Txt-KbLocation::Text TO WS-SET-VALUE
           CALL "COBOL-FOLDER-DIALOG" USING T-KB-BROWSE-TITLE WS-SET-VALUE WS-PATH
           IF WS-PATH NOT = SPACES
               MOVE WS-PATH TO Txt-KbLocation::Text
           END-IF
]]></Event>
  </Control>
