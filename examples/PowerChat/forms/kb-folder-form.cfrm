    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "KB-LOCATION" TO WS-SET-NAME
           MOVE Txt-KbLocation::Text TO WS-SET-VALUE
           IF WS-SET-VALUE = SPACES
               MOVE "assets/KB" TO WS-SET-VALUE
           END-IF
           CALL "PC-SETTING-PUT"
           MOVE FUNCTION TRIM(T-KB-FOLDER-SAVED) TO Lbl-Status::Caption
           INVOKE ME::Close()
]]></Event>
  </Control>
</Form>