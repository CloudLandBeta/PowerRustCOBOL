    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-CLOSE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   No choice: PickAnswer keeps the caller's own 0.
           INVOKE ME::Close()
]]></Event>
  </Control>
</Form>
