    <Event name="onClick" paragraph="BTN-CANCEL--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   No choice: PickAnswer keeps the caller's own 0.
           INVOKE ME::Close()
]]></Event>
