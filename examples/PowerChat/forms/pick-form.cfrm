    <Property name="SelectedItemsColor"></Property>
    <Property name="ActiveItemTextColor"></Property>
  </Control>
  <Control id="Btn-Cancel" type="Button" x="256" y="356" w="112" h="36" tab-order="3" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
