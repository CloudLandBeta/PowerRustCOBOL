  <file-control><![CDATA[           SELECT SETTINGS-FILE ASSIGN TO WS-SETTINGS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS SET-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT TOPICS-FILE ASSIGN TO WS-TOPICS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS TOP-ID
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT TFILES-FILE ASSIGN TO WS-TFILES-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS TF-KEY
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT PROMPTS-FILE ASSIGN TO WS-PROMPTS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS PRM-KEY
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT SAMPLES-FILE ASSIGN TO WS-SAMPLES-LIST
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS.
]]></file-control>
  <file-section><![CDATA[       FD SETTINGS-FILE IS GLOBAL.
       01 SETTINGS-REC.
           05 SET-NAME                           PIC    X(20).
           05 SET-VALUE                          PIC    X(200).
       FD TOPICS-FILE IS GLOBAL.
       01 TOPIC-REC.
           05 TOP-ID                             PIC    X(16).
           05 TOP-NAME                           PIC    X(40).
           05 TOP-PROMPT                         PIC    X(1000).
           05 TOP-CREATED                        PIC    X(14).
           *>   "Y" for a topic the sample installer made, so it can be removed.

           05 TOP-SAMPLE                         PIC    X.
       FD TFILES-FILE IS GLOBAL.
       *>   The users' indexed files each topic registers by path (R20-R25):
       *>   the data file and its .cidx. Nothing is copied or attached.

       01 TFILE-REC.
           05 TF-KEY.
               10 TF-TOPIC                       PIC    X(16).
               10 TF-SEQ                         PIC    9(3).
           05 TF-NAME                            PIC    X(30).
           05 TF-DATA                            PIC    X(250).
           05 TF-CIDX                            PIC    X(250).
       FD PROMPTS-FILE IS GLOBAL.
       *>   Every version of each topic's system prompt (R48). The active one's
       *>   text is also the topic's TOP-PROMPT, which is what the chat reads.

       01 PROMPT-REC.
           05 PRM-KEY.
               10 PRM-TOPIC                      PIC    X(16).
               10 PRM-VERSION                    PIC    9(4).
           05 PRM-CREATED                        PIC    X(14).
           05 PRM-ACTIVE                         PIC    X.
           05 PRM-TEXT                           PIC    X(32000).
       FD SAMPLES-FILE IS GLOBAL.
       01 SAMPLE-LINE                            PIC    X(1400).
]]></file-section>
  <user-procedures>
    <Event name="PC-PATHS" paragraph="PC-PATHS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Where PowerChat keeps its own files: POWERCHAT_DATA, else "data".

           DISPLAY    "POWERCHAT_DATA" UPON ENVIRONMENT-NAME
           ACCEPT    WS-DATA-DIR FROM ENVIRONMENT-VALUE
           IF    WS-DATA-DIR = SPACES
               SET     WS-DATA-DIR               TO    "data"
           END-IF
           SET     WS-SETTINGS-PATH              TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/settings.idx" INTO WS-SETTINGS-PATH
           SET     WS-TOPICS-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/topics.idx" INTO WS-TOPICS-PATH
           SET     WS-TFILES-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/topic-files.idx" INTO WS-TFILES-PATH
           SET     WS-PROMPTS-PATH               TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/prompt-versions.idx" INTO WS-PROMPTS-PATH
]]></Event>
    <Event name="PC-SETTING-GET" paragraph="PC-SETTING-GET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME in, WS-SET-VALUE out (spaces when the setting is unset).

           SET     WS-SET-VALUE                  TO    SPACES
           *> Status 35 = the file does not exist yet: create it empty and reopen
           *> it for update, so the very first run needs no set-up.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF
           SET     SET-NAME                      TO    WS-SET-NAME
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE SET-VALUE TO WS-SET-VALUE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-SETTING-PUT" paragraph="PC-SETTING-PUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME, WS-SET-VALUE in. Written and committed at once (R10f).

           *> Status 35 = the file does not exist yet: create it empty and reopen
           *> it for update, so the very first run needs no set-up.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF

           SET     SET-NAME                      TO    WS-SET-NAME
           SET     SET-VALUE                     TO    WS-SET-VALUE

           WRITE    SETTINGS-REC
               INVALID KEY REWRITE SETTINGS-REC
           END-WRITE
           COMMIT
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-LOAD-TOPICS" paragraph="PC-LOAD-TOPICS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Every topic, in the order they were created (the key is a timestamp),
           *>   one grid row each: name, prompt, then the open / edit / delete
           *>   buttons. Grid row n is WS-TOPIC-ID(n).

           SET     WS-OK                         TO    Dg-List::ClearRows()
           SET     WS-TOPIC-COUNT                TO    0

           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF

           SET     TOP-ID                        TO    LOW-VALUES
           SET     WS-EOF                        TO    "N"

           START    TOPICS-FILE KEY IS >= TOP-ID
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    TOPICS-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    WS-TOPIC-COUNT < 500
                           ADD    1 TO WS-TOPIC-COUNT
                           SET     WS-TOPIC-ID(WS-TOPIC-COUNT)
                                                 TO    TOP-ID

                           *> A prompt may span lines: line breaks and tabs would break the grid
                           *> row (its cells are tab-separated), so they become spaces.

                           SET     WS-PREVIEW    TO    TOP-PROMPT
                           INSPECT    WS-PREVIEW REPLACING ALL X"0A" BY SPACE
                               ALL X"0D" BY SPACE ALL X"09" BY SPACE
                           SET     WS-ROW        TO    SPACES
                           STRING    FUNCTION TRIM(TOP-NAME) X"09"
                           WS-PREVIEW::Trim() X"09"
                               "icon:chat" X"09" "icon:pencil" X"09"
                               "icon:trash"
                               INTO WS-ROW
                           SET     WS-OK         TO    Dg-List::AddRow(WS-ROW)
                       END-IF
               END-READ
           END-PERFORM
           CLOSE    TOPICS-FILE
           *>   The chat's menu turns Chat and New conversation on only while a
           *>   topic exists: tell it the list may have changed (the first topic
           *>   saved, the last one deleted), or it waits until it is shown again.

           INVOKE    super::"PC-REFRESH"()
]]></Event>
    <Event name="PC-NEXT-IMPORT" paragraph="PC-NEXT-IMPORT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   One sample document at a time: a Knowledge Base import runs in the
           *>   background and reports through onIndexed, which calls back here.

           IF    WS-Q-NEXT > WS-Q-COUNT
               SET     WS-INSTALLING             TO    "N"
               SET     WS-N1                     TO    WS-MAP-COUNT
               SET     WS-N2                     TO    WS-Q-COUNT
               SET     WS-FMT                    TO    T-SAMPLES-INSTALLED
               SET     WS-ARG1                   TO    WS-N1
               SET     WS-ARG2                   TO    WS-N2

               *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
               *> WS-ARG1 to WS-ARG4 (trimmed).
               *> Uses:   WS-FMT = T-SAMPLES-INSTALLED (the "Sample topics installed: &1 topics, &2
               *>         documents." text in the current language); WS-ARG1 = WS-N1 (the sample
               *>         topics made, WS-MAP-COUNT); WS-ARG2 = WS-N2 (the documents queued,
               *>         WS-Q-COUNT).
               *> Result: WS-FMT-OUT = that text with both counts filled in, shown on Lbl-Status
               *>         just below. Nothing else changes.

               CALL    "PC-FMT"
               SET     Lbl-Status::Caption       TO    WS-FMT-OUT::Trim()

               *> PC-LOAD-TOPICS: fills the topics grid Dg-List with every topic stored in
               *> TOPICS-FILE, in key (creation) order. Called here when the last sample document
               *> has been handled.
               *> Uses:   TOPICS-FILE (<WS-DATA-DIR>/topics.idx = WS-TOPICS-PATH; created empty when
               *>         missing). It holds all the sample topics now.
               *> Result: Dg-List is emptied and gets one row per topic (up to 500): name, prompt on
               *>         one line, and the open, edit and delete icons. WS-TOPIC-COUNT = rows
               *>         added; WS-TOPIC-ID(n) = id of grid row n. Then it asks the parent form
               *>         (the chat) to run its PC-REFRESH, INVOKE super::"PC-REFRESH"()
               *>         (fire-and-forget: it runs when the chat next waits for an event): the chat
               *>         re-hands the models to its agents, reloads the current topic (a blank
               *>         conversation starts when the current topic changed to another topic) and
               *>         rebuilds the conversation list, the menu state and the status line.

               CALL    "PC-LOAD-TOPICS"
               EXIT PROGRAM
           END-IF

           SET     KB-T::Collection              TO    WS-Q-TOPIC(WS-Q-NEXT)
           SET     WS-N1                         TO    WS-Q-NEXT
           SET     WS-N2                         TO    WS-Q-COUNT
           SET     WS-FMT                        TO    T-SAMPLES-PROGRESS
           SET     WS-ARG1                       TO    WS-N1
           SET     WS-ARG2                       TO    WS-N2

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-SAMPLES-PROGRESS (the "Installing the sample topics: document &1 of
           *>         &2..." text in the current language); WS-ARG1 = WS-N1 (the document about to
           *>         be imported, WS-Q-NEXT); WS-ARG2 = WS-N2 (the documents queued, WS-Q-COUNT).
           *> Result: WS-FMT-OUT = that text with both numbers filled in, shown on Lbl-Status just
           *>         below. Nothing else changes.

           CALL    "PC-FMT"

           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()
           SET     WS-OK                         TO    KB-T::ImportDocument(WS-Q-PATH(WS-Q-NEXT)::Trim())

           ADD    1 TO WS-Q-NEXT
]]></Event>
    <Event name="PC-TOPIC-OF" paragraph="PC-TOPIC-OF"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-FOLDER in: the id the installer gave that sample folder's topic.

           SET     WS-TOPIC-ID-OF                TO    SPACES
           PERFORM    VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-MAP-COUNT
               IF    WS-MAP-FOLDER(WS-J) = WS-FOLDER
                   SET     WS-TOPIC-ID-OF        TO    WS-MAP-ID(WS-J)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="PC-HAS-SAMPLES" paragraph="PC-HAS-SAMPLES"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-OK out: "Y" when sample topics are installed.

           SET     WS-OK                         TO    "N"
           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF

           SET     TOP-ID                        TO    LOW-VALUES
           SET     WS-EOF                        TO    "N"

           START    TOPICS-FILE KEY IS >= TOP-ID
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    TOPICS-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    TOP-SAMPLE = "Y"
                           SET     WS-OK         TO    "Y"
                       END-IF
               END-READ
           END-PERFORM
           CLOSE    TOPICS-FILE
]]></Event>
    <Event name="PC-DROP-TOPIC-ROWS" paragraph="PC-DROP-TOPIC-ROWS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-TOPIC-ID-OF in: its registered files and prompt versions go.

           SET     WS-SEQ-COUNT                  TO    0
           OPEN    I-O TFILES-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TFILES-FILE
               CLOSE    TFILES-FILE
               OPEN    I-O TFILES-FILE
           END-IF

           *> A range scan over the composite key: start at (topic, 0) and stop at
           *> the first record of another topic.

           SET     TF-TOPIC                      TO    WS-TOPIC-ID-OF
           SET     TF-SEQ                        TO    0
           SET     WS-EOF                        TO    "N"

           START    TFILES-FILE KEY IS >= TF-KEY
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    TFILES-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    TF-TOPIC NOT = WS-TOPIC-ID-OF
                           SET     WS-EOF        TO    "Y"
                       ELSE
                           IF    WS-SEQ-COUNT < 200
                               ADD    1 TO WS-SEQ-COUNT
                               SET     WS-SEQ-OF(WS-SEQ-COUNT)
                                                 TO    TF-SEQ
                           END-IF
                       END-IF
               END-READ
           END-PERFORM
           *> The keys are gathered first (up to 200) and deleted after the scan,
           *> not while READ NEXT is still walking the file.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-SEQ-COUNT
               SET     TF-TOPIC                  TO    WS-TOPIC-ID-OF
               SET     TF-SEQ                    TO    WS-SEQ-OF(WS-K)

               DELETE    TFILES-FILE
                   INVALID KEY CONTINUE
               END-DELETE
           END-PERFORM
           COMMIT
           CLOSE    TFILES-FILE
           SET     WS-SEQ-COUNT                  TO    0
           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF

           SET     PRM-TOPIC                     TO    WS-TOPIC-ID-OF
           SET     PRM-VERSION                   TO    0
           SET     WS-EOF                        TO    "N"

           START    PROMPTS-FILE KEY IS >= PRM-KEY
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    PROMPTS-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    PRM-TOPIC NOT = WS-TOPIC-ID-OF
                           SET     WS-EOF        TO    "Y"
                       ELSE
                           IF    WS-SEQ-COUNT < 200
                               ADD    1 TO WS-SEQ-COUNT
                               SET     WS-SEQ-OF(WS-SEQ-COUNT)
                                                 TO    PRM-VERSION
                           END-IF
                       END-IF
               END-READ
           END-PERFORM
           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-SEQ-COUNT
               SET     PRM-TOPIC                 TO    WS-TOPIC-ID-OF
               SET     PRM-VERSION               TO    WS-SEQ-OF(WS-K)

               DELETE    PROMPTS-FILE
                   INVALID KEY CONTINUE
               END-DELETE
           END-PERFORM
           COMMIT
           CLOSE    PROMPTS-FILE
]]></Event>
    <Event name="PC-ADD-SAMPLE-TOPIC" paragraph="PC-ADD-SAMPLE-TOPIC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   A TOPIC line: the topic, marked as a sample, and its collection.

           IF    WS-MAP-COUNT >= 10
               EXIT PROGRAM
           END-IF
           ADD    1 TO WS-SEQ-N WS-MAP-COUNT
           *> Id = 15 characters of the timestamp + a 1-digit counter: samples are
           *> made within the same instant, so the counter keeps their ids apart.

           SET     WS-NEW-ID                     TO    SPACES
           STRING    WS-NOW(1:15) WS-SEQ-N DELIMITED BY SIZE INTO WS-NEW-ID

           SET     WS-MAP-FOLDER(WS-MAP-COUNT)   TO    WS-FOLDER
           SET     WS-MAP-ID(WS-MAP-COUNT)       TO    WS-NEW-ID

           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF

           SET     TOP-ID                        TO    WS-NEW-ID
           SET     TOP-NAME                      TO    WS-F3
           SET     TOP-PROMPT                    TO    WS-F4
           SET     TOP-CREATED                   TO    WS-NOW(1:14)
           SET     TOP-SAMPLE                    TO    "Y"

           WRITE    TOPIC-REC
               INVALID KEY CONTINUE
           END-WRITE
           COMMIT
           CLOSE    TOPICS-FILE
           SET     WS-OK                         TO    KB-T::CreateCollection(WS-NEW-ID)
]]></Event>
    <Event name="PC-ADD-SAMPLE-FILE" paragraph="PC-ADD-SAMPLE-FILE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   A FILE line: the data file and its .cidx, registered by path for the
           *>   topic. They stay in samples/ and are only ever read.

           *> PC-TOPIC-OF: finds the topic the installer made for a sample folder.
           *> Uses:   WS-FOLDER (the folder named on the FILE line of samples.txt) and the
           *>         WS-MAP-FOLDER(n) / WS-MAP-ID(n) pairs the TOPIC lines filled, n = 1 to
           *>         WS-MAP-COUNT.
           *> Result: WS-TOPIC-ID-OF = the id of that folder's topic, or SPACES when no TOPIC line
           *>         named the folder; the procedure then ends and the FILE line registers nothing.
           *>         WS-J is a work area.

           CALL    "PC-TOPIC-OF"
           IF    WS-TOPIC-ID-OF = SPACES
               EXIT PROGRAM
           END-IF
           ADD    1 TO WS-TF-SEQ
           OPEN    I-O TFILES-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TFILES-FILE
               CLOSE    TFILES-FILE
               OPEN    I-O TFILES-FILE
           END-IF

           SET     TF-TOPIC                      TO    WS-TOPIC-ID-OF
           SET     TF-SEQ                        TO    WS-TF-SEQ
           SET     TF-NAME                       TO    WS-F3
           SET     TF-DATA TF-CIDX               TO    SPACES

           STRING    WS-SAMPLES-DIR::Trim() "/" WS-FOLDER::Trim() "/" WS-F3::Trim() INTO TF-DATA
           STRING    WS-SAMPLES-DIR::Trim() "/" WS-FOLDER::Trim() "/" WS-F4::Trim() INTO TF-CIDX

           WRITE    TFILE-REC
               INVALID KEY REWRITE TFILE-REC
           END-WRITE
           COMMIT
           CLOSE    TFILES-FILE
]]></Event>
    <Event name="PC-TEXTS" paragraph="PC-TEXTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language the user picked (LANG), the texts in it, and every
           *>   designed caption and hint that shows one. Called on load and again
           *>   whenever the language changes (R46).

           SET     WS-SET-NAME                   TO    "LANG"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "LANG" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = the language code saved under LANG ("en", "pt", "es", "fr",
           *>         "jp" or "cn"), or SPACES when none was saved. Used right below to set WS-LANG.

           CALL    "PC-SETTING-GET"
           SET     WS-LANG                       TO    WS-SET-VALUE(1:2)
           *> Unset or unknown falls back to English, and WS-LANG says "en" too:
           *> the language timer compares it with PC-LANG-NOW, which also answers
           *> "en" in that case, so it must not see a change.

           EVALUATE    WS-LANG
               WHEN "en" MOVE 1 TO WS-LANG-IX
               WHEN "pt" MOVE 2 TO WS-LANG-IX
               WHEN "es" MOVE 3 TO WS-LANG-IX
               WHEN "fr" MOVE 4 TO WS-LANG-IX
               WHEN "jp" MOVE 5 TO WS-LANG-IX
               WHEN "cn" MOVE 6 TO WS-LANG-IX
               WHEN OTHER MOVE "en" TO WS-LANG
                   SET     WS-LANG-IX            TO    1
           END-EVALUATE
           *> One row per text, one column per language (the order of the EVALUATE):
           *> the picked column becomes PC-TEXT-NOW, which the T-... names redefine.
           *> The bound is the row count of PC-TEXT-TABLE: change both together.

           PERFORM    VARYING WS-TX-I FROM 1 BY 1 UNTIL WS-TX-I > 35
               SET     PC-TEXT-NOW(WS-TX-I)      TO    PC-TEXT(WS-TX-I, WS-LANG-IX)
           END-PERFORM

           SET     Lbl-Title::Caption            TO    T-TOPICS-TITLE::Trim()
           SET     WS-TABS                       TO    SPACES

           STRING    T-TAB-BROWSE::Trim() X"0A" T-TAB-EDIT::Trim() INTO WS-TABS
           SET     Tab-Crud::Tabs                TO    WS-TABS

           Dg-List::SetColumnTitle("name", T-COL-NAME)
           Dg-List::SetColumnTitle("prompt", T-COL-PROMPT)

           SET     Btn-New::Caption              TO    T-NEW::Trim()
           SET     Btn-Save::Caption             TO    T-SAVE::Trim()
           SET     Btn-Save2::Caption            TO    T-SAVE::Trim()
           SET     Btn-Cancel::Caption           TO    T-CANCEL::Trim()
           SET     Btn-Cancel2::Caption          TO    T-CANCEL::Trim()

           IF    WS-EDIT-ID = SPACES
               SET     Lbl-New::Caption          TO    T-NEW-TOPIC::Trim()
           ELSE
               SET     Lbl-New::Caption          TO    T-EDIT-TOPIC::Trim()
           END-IF

           SET     Txt-Name::HintText            TO    T-HINT-TOPIC-NAME::Trim()
           SET     Txt-Prompt::HintText          TO    T-HINT-TOPIC-PROMPT::Trim()
           SET     Btn-Install::Caption          TO    T-INSTALL-SAMPLES::Trim()
           SET     Btn-RemoveSamples::Caption    TO    T-REMOVE-SAMPLES::Trim()
           SET     Lbl-Status::Caption           TO    T-STATUS::Trim()
]]></Event>
    <Event name="PC-FMT" paragraph="PC-FMT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-FROM                                PIC    9(4).
       01 WS-CNT                                 PIC    9(4).
       01 WS-PART                                PIC    X(110).
       01 WS-DELIM                               PIC    XX.

       PROCEDURE DIVISION.
           *>   A message whose words go round numbers and names differently in each
           *>   language: WS-FMT holds "&1" .. "&4" where WS-ARG1..4 go.

           SET     WS-FMT-OUT                    TO    SPACES
           SET     WS-PT                         TO    1
           SET     WS-FROM                       TO    1

           PERFORM    UNTIL WS-FROM > FUNCTION LENGTH(WS-FMT)
               SET     WS-PART WS-DELIM          TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-FMT DELIMITED BY "&1" OR "&2" OR "&3" OR "&4"
                   INTO WS-PART DELIMITER IN WS-DELIM COUNT IN WS-CNT
                   WITH POINTER WS-FROM
               END-UNSTRING
               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-FMT-OUT WITH POINTER WS-PT
               END-IF
               *> No "&n" left: WS-DELIM stays blank and the tail was copied above, so
               *> WHEN OTHER pushes WS-FROM past the end to end the loop.

               EVALUATE    WS-DELIM
                   WHEN "&1" STRING WS-ARG1::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&2" STRING WS-ARG2::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&3" STRING WS-ARG3::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&4" STRING WS-ARG4::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN OTHER COMPUTE WS-FROM = FUNCTION LENGTH(WS-FMT) + 1
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-OPEN" paragraph="PC-OPEN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   What the form shows: run on load, and again when it comes back.

           *> PC-PATHS: works out where PowerChat keeps its own indexed files.
           *> Uses:   the environment variable POWERCHAT_DATA.
           *> Result: WS-DATA-DIR = POWERCHAT_DATA, or "data" when it is empty; WS-SETTINGS-PATH =
           *>         <WS-DATA-DIR>/settings.idx, WS-TOPICS-PATH = <WS-DATA-DIR>/topics.idx,
           *>         WS-TFILES-PATH = <WS-DATA-DIR>/topic-files.idx, WS-PROMPTS-PATH =
           *>         <WS-DATA-DIR>/prompt-versions.idx. No file is opened.

           CALL    "PC-PATHS"

           *> PC-TEXTS: puts the form in the user's language: it reads the LANG setting, loads the
           *> matching texts and sets every designed caption and hint.
           *> Uses:   the LANG setting (read through PC-SETTING-GET), the PC-TEXT table of 35 texts
           *>         in 6 languages, and WS-EDIT-ID (SPACES = the page is for a new topic).
           *> Result: WS-LANG = "en", "pt", "es", "fr", "jp" or "cn" ("en" when unset or unknown)
           *>         and WS-LANG-IX = 1 to 6, its column; PC-TEXT-NOW(1..35) = the texts in that
           *>         language, which the T-... names read. Captions, hints and titles are set on
           *>         Lbl-Title, Tab-Crud, Dg-List, Btn-New, Btn-Save, Btn-Save2, Btn-Cancel,
           *>         Btn-Cancel2, Lbl-New, Txt-Name, Txt-Prompt, Btn-Install, Btn-RemoveSamples and
           *>         Lbl-Status. WS-SET-NAME = "LANG" and WS-SET-VALUE hold the saved code.

           CALL    "PC-TEXTS"

           DISPLAY    "POWERCHAT_SAMPLES" UPON ENVIRONMENT-NAME
           ACCEPT    WS-SAMPLES-DIR FROM ENVIRONMENT-VALUE
           IF    WS-SAMPLES-DIR = SPACES
               SET     WS-SAMPLES-DIR            TO    "samples"
           END-IF
           SET     WS-SAMPLES-LIST               TO    SPACES
           STRING    WS-SAMPLES-DIR::Trim() "/samples.txt" INTO WS-SAMPLES-LIST
           SET     WS-SET-NAME                   TO    "KB-LOCATION"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "KB-LOCATION" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = the Knowledge Base folder saved under KB-LOCATION, or SPACES
           *>         when none was saved; the IF below sets KB-T::Location from it only when it is
           *>         not SPACES.

           CALL    "PC-SETTING-GET"
           IF    WS-SET-VALUE NOT = SPACES
               SET     KB-T::Location            TO    WS-SET-VALUE
           END-IF

           *> PC-LOAD-TOPICS: fills the topics grid Dg-List with every topic stored in TOPICS-FILE,
           *> in key (creation) order. Called by PC-OPEN, right after PC-PATHS set the file paths.
           *> Uses:   TOPICS-FILE (<WS-DATA-DIR>/topics.idx = WS-TOPICS-PATH; created empty when
           *>         missing).
           *> Result: Dg-List is emptied and gets one row per topic (up to 500): name, prompt on one
           *>         line, and the open, edit and delete icons. WS-TOPIC-COUNT = rows added;
           *>         WS-TOPIC-ID(n) = id of grid row n. Then it asks the parent form (the chat) to
           *>         run its PC-REFRESH, INVOKE super::"PC-REFRESH"() (fire-and-forget: it runs
           *>         when the chat next waits for an event): the chat re-hands the models to its
           *>         agents, reloads the current topic (a blank conversation starts when the
           *>         current topic changed to another topic) and rebuilds the conversation list,
           *>         the menu state and the status line. The IF below then reads WS-TOPIC-COUNT to
           *>         choose the Lbl-Status text.

           CALL    "PC-LOAD-TOPICS"
           IF    WS-TOPIC-COUNT = 0
               SET     Lbl-Status::Caption       TO    T-NO-TOPICS::Trim()
           ELSE
               SET     Lbl-Status::Caption       TO    T-PICK-OR-CREATE::Trim()
           END-IF
]]></Event>
    <Event name="PC-LANG-NOW" paragraph="PC-LANG-NOW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language saved now (LANG), into WS-LANG-NOW; "en" when unset.

           SET     WS-LANG-NOW                   TO    "en"
           *> Polled by the language timer every second, so it only looks: it never
           *> creates the settings file, and a file it cannot open leaves "en".

           OPEN    INPUT SETTINGS-FILE
           IF    WS-FS NOT = "00"
               EXIT PROGRAM
           END-IF
           SET     SET-NAME                      TO    "LANG"
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   EVALUATE    SET-VALUE(1:2)
                       WHEN "pt" WHEN "es" WHEN "fr" WHEN "jp" WHEN "cn"
                           SET     WS-LANG-NOW   TO    SET-VALUE(1:2)
                   END-EVALUATE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-OPEN-TOPIC" paragraph="PC-OPEN-TOPIC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-TOPIC-ID-OF in: that topic becomes the current one (CUR-TOPIC).

           SET     WS-SET-NAME                   TO    "CUR-TOPIC"
           SET     WS-SET-VALUE                  TO    WS-TOPIC-ID-OF

           *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
           *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and committed
           *> at once. The file is created empty when missing.
           *> Uses:   WS-SET-NAME = "CUR-TOPIC" and WS-SET-VALUE = WS-TOPIC-ID-OF, the id of the
           *>         topic whose open button was clicked (both set just above).
           *> Result: the CUR-TOPIC record of the settings file holds that id, i.e. that topic
           *>         becomes the current one. Only WS-FS and the settings record area (SET-NAME,
           *>         SET-VALUE) change.

           CALL    "PC-SETTING-PUT"
           SET     Lbl-Status::Caption           TO    T-TOPIC-OPENED::Trim()
]]></Event>
    <Event name="PC-NEW-TOPIC" paragraph="PC-NEW-TOPIC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The Create/Update page, empty: Save writes a new topic.

           SET     WS-EDIT-ID                    TO    SPACES
           SET     Txt-Name::Text                TO    SPACES
           SET     Txt-Prompt::Text              TO    SPACES
           SET     Lbl-New::Caption              TO    T-NEW-TOPIC::Trim()
           SET     Tab-Crud::SelectedTab         TO    2
]]></Event>
    <Event name="PC-EDIT-TOPIC" paragraph="PC-EDIT-TOPIC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-TOPIC-ID-OF in: its name and prompt on the Create/Update page.
           *>   The key is the topic's id, so the name stays editable (a rename).

           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF

           SET     WS-SAVE-OK                    TO    "N"
           SET     TOP-ID                        TO    WS-TOPIC-ID-OF

           READ    TOPICS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE "Y" TO WS-SAVE-OK
           END-READ
           CLOSE    TOPICS-FILE
           IF    WS-SAVE-OK NOT = "Y"
               SET     Lbl-Status::Caption       TO    T-PICK-TOPIC-FIRST::Trim()

               *> PC-LOAD-TOPICS: fills the topics grid Dg-List with every topic stored in
               *> TOPICS-FILE, in key (creation) order. Called here because the clicked row's topic
               *> is no longer in the file (Lbl-Status::Caption was just set to the "pick a topic
               *> first" text).
               *> Uses:   TOPICS-FILE (<WS-DATA-DIR>/topics.idx = WS-TOPICS-PATH; created empty when
               *>         missing).
               *> Result: Dg-List is emptied and gets one row per topic (up to 500): name, prompt on
               *>         one line, and the open, edit and delete icons. WS-TOPIC-COUNT = rows
               *>         added; WS-TOPIC-ID(n) = id of grid row n. Then it asks the parent form
               *>         (the chat) to run its PC-REFRESH, INVOKE super::"PC-REFRESH"()
               *>         (fire-and-forget: it runs when the chat next waits for an event): the chat
               *>         re-hands the models to its agents, reloads the current topic (a blank
               *>         conversation starts when the current topic changed to another topic) and
               *>         rebuilds the conversation list, the menu state and the status line. The
               *>         edit page stays as it was; the procedure ends after this call.

               CALL    "PC-LOAD-TOPICS"
               EXIT PROGRAM
           END-IF

           SET     WS-EDIT-ID                    TO    WS-TOPIC-ID-OF
           SET     Txt-Name::Text                TO    FUNCTION TRIM(TOP-NAME)
           SET     Txt-Prompt::Text              TO    FUNCTION TRIM(TOP-PROMPT)
           SET     Lbl-New::Caption              TO    T-EDIT-TOPIC::Trim()
           SET     Tab-Crud::SelectedTab         TO    2
]]></Event>
    <Event name="PC-SAVE-TOPIC" paragraph="PC-SAVE-TOPIC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   A topic is data: its own id, name, prompt, documents and Knowledge
           *>   Base collection. Nothing about any topic is written in this code.
           *>   WS-EDIT-ID spaces = a new topic (a fresh id and its collection);
           *>   otherwise that topic, keeping its creation stamp and sample mark.

           SET     WS-NEW-NAME                   TO    Txt-Name::Text
           SET     WS-NEW-PROMPT                 TO    Txt-Prompt::Text

           IF    WS-NEW-NAME = SPACES
               SET     Lbl-Status::Caption       TO    T-NAME-FIRST::Trim()
               EXIT PROGRAM
           END-IF
           SET     WS-NOW                        TO    FUNCTION CURRENT-DATE
           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF
           IF    WS-EDIT-ID = SPACES
               SET     WS-NEW-ID                 TO    WS-NOW(1:16)
               SET     TOP-ID                    TO    WS-NEW-ID
               SET     TOP-CREATED               TO    WS-NOW(1:14)
               SET     TOP-SAMPLE                TO    "N"
           ELSE
               SET     WS-NEW-ID                 TO    WS-EDIT-ID
               SET     TOP-ID                    TO    WS-EDIT-ID

               READ    TOPICS-FILE
                   INVALID KEY
                       SET     TOP-ID            TO    WS-EDIT-ID
                       SET     TOP-CREATED       TO    WS-NOW(1:14)
                       SET     TOP-SAMPLE        TO    "N"
               END-READ
           END-IF

           SET     TOP-NAME                      TO    WS-NEW-NAME
           SET     TOP-PROMPT                    TO    WS-NEW-PROMPT
           SET     WS-SAVE-OK                    TO    "Y"

           *> WRITE comes first: a new id is inserted. On an edit the key already
           *> exists, so the WRITE fails and REWRITE takes over; a topic deleted in
           *> the meantime is just inserted again.

           WRITE    TOPIC-REC
               INVALID KEY
                   IF    WS-EDIT-ID = SPACES
                       *>               A fresh id already taken: another topic, this instant.

                       SET     Lbl-Status::Caption
                                                 TO    T-SAME-INSTANT::Trim()

                       SET     WS-SAVE-OK        TO    "N"
                   ELSE
                       REWRITE    TOPIC-REC
                           INVALID KEY
                               SET     WS-FMT    TO    T-SAVE-FAILED
                               SET     WS-ARG1   TO    WS-FS

                               *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT
                               *> is replaced by WS-ARG1 to WS-ARG4 (trimmed).
                               *> Uses:   WS-FMT = T-SAVE-FAILED (the "The topic could not be saved
                               *>         (status &1)." text in the current language); WS-ARG1 =
                               *>         WS-FS, the file status of the REWRITE that just failed.
                               *> Result: WS-FMT-OUT = the message with that status in it, shown on
                               *>         Lbl-Status just below. Nothing else changes.

                               CALL    "PC-FMT"
                               SET     Lbl-Status::Caption
                                                 TO    WS-FMT-OUT::Trim()

                               SET     WS-SAVE-OK
                                                 TO    "N"
                       END-REWRITE
                   END-IF
           END-WRITE
           IF    WS-SAVE-OK NOT = "Y"
               CLOSE    TOPICS-FILE
               EXIT PROGRAM
           END-IF
           COMMIT
           CLOSE    TOPICS-FILE
           IF    WS-EDIT-ID = SPACES
               *>       Its Knowledge Base collection: an empty documents folder and index.

               SET     WS-OK                     TO    KB-T::CreateCollection(WS-NEW-ID)
               IF    WS-OK NOT = "1"
                   SET     Lbl-Status::Caption   TO    KB-T::LastError
               ELSE
                   SET     Lbl-Status::Caption   TO    T-TOPIC-CREATED::Trim()
               END-IF
           ELSE
               SET     Lbl-Status::Caption       TO    T-TOPIC-SAVED::Trim()
           END-IF

           SET     WS-EDIT-ID                    TO    SPACES
           SET     Txt-Name::Text                TO    SPACES
           SET     Txt-Prompt::Text              TO    SPACES

           *> PC-LOAD-TOPICS: fills the topics grid Dg-List with every topic stored in TOPICS-FILE,
           *> in key (creation) order. Called here after the topic was written.
           *> Uses:   TOPICS-FILE (<WS-DATA-DIR>/topics.idx = WS-TOPICS-PATH; created empty when
           *>         missing). It holds the new or changed topic.
           *> Result: Dg-List is emptied and gets one row per topic (up to 500): name, prompt on one
           *>         line, and the open, edit and delete icons. WS-TOPIC-COUNT = rows added;
           *>         WS-TOPIC-ID(n) = id of grid row n. Then it asks the parent form (the chat) to
           *>         run its PC-REFRESH, INVOKE super::"PC-REFRESH"() (fire-and-forget: it runs
           *>         when the chat next waits for an event): the chat re-hands the models to its
           *>         agents, reloads the current topic (a blank conversation starts when the
           *>         current topic changed to another topic) and rebuilds the conversation list,
           *>         the menu state and the status line. Tab-Crud::SelectedTab is set to 1 right
           *>         after.

           CALL    "PC-LOAD-TOPICS"
           SET     Tab-Crud::SelectedTab         TO    1
]]></Event>
    <Event name="PC-CANCEL-EDIT" paragraph="PC-CANCEL-EDIT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Back to Browse, nothing written and the list not reloaded.

           SET     WS-EDIT-ID                    TO    SPACES
           SET     Tab-Crud::SelectedTab         TO    1
]]></Event>
    <Event name="PC-DELETE-TOPIC" paragraph="PC-DELETE-TOPIC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-TOPIC-ID-OF in, after a confirmation: the topic goes the way the
           *>   sample topics go - its Knowledge Base (moved aside, never deleted),
           *>   its registered files and its prompt versions, and CUR-TOPIC when
           *>   it was the current one.

           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF

           SET     WS-SAVE-OK                    TO    "N"
           SET     TOP-ID                        TO    WS-TOPIC-ID-OF

           READ    TOPICS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE "Y" TO WS-SAVE-OK
           END-READ
           CLOSE    TOPICS-FILE
           IF    WS-SAVE-OK NOT = "Y"
               SET     Lbl-Status::Caption       TO    T-PICK-TOPIC-FIRST::Trim()

               *> PC-LOAD-TOPICS: fills the topics grid Dg-List with every topic stored in
               *> TOPICS-FILE, in key (creation) order. Called here because the clicked row's topic
               *> is no longer in the file (Lbl-Status::Caption was just set to the "pick a topic
               *> first" text).
               *> Uses:   TOPICS-FILE (<WS-DATA-DIR>/topics.idx = WS-TOPICS-PATH; created empty when
               *>         missing).
               *> Result: Dg-List is emptied and gets one row per topic (up to 500): name, prompt on
               *>         one line, and the open, edit and delete icons. WS-TOPIC-COUNT = rows
               *>         added; WS-TOPIC-ID(n) = id of grid row n. Then it asks the parent form
               *>         (the chat) to run its PC-REFRESH, INVOKE super::"PC-REFRESH"()
               *>         (fire-and-forget: it runs when the chat next waits for an event): the chat
               *>         re-hands the models to its agents, reloads the current topic (a blank
               *>         conversation starts when the current topic changed to another topic) and
               *>         rebuilds the conversation list, the menu state and the status line.
               *>         Nothing is deleted; the procedure ends after this call.

               CALL    "PC-LOAD-TOPICS"
               EXIT PROGRAM
           END-IF

           SET     WS-FMT                        TO    T-CONFIRM-DELETE
           SET     WS-ARG1                       TO    TOP-NAME

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-CONFIRM-DELETE (the "Delete the topic "&1" and its Knowledge Base?"
           *>         text in the current language); WS-ARG1 = TOP-NAME, the name of the topic just
           *>         read.
           *> Result: WS-FMT-OUT = the question with the topic's name in it; the next line copies it
           *>         to WS-QUESTION for the confirmation dialog. Nothing else changes.

           CALL    "PC-FMT"
           SET     WS-QUESTION                   TO    WS-FMT-OUT

           *> The confirm dialog reads these properties from this form and answers
           *> in ConfirmAnswer; it is preset to "N" so closing the dialog any other
           *> way counts as no.

           INVOKE    ME::SetProperty("ConfirmText", WS-QUESTION)
           INVOKE    ME::SetProperty("ConfirmYes", T-YES)
           INVOKE    ME::SetProperty("ConfirmNo", T-NO)
           INVOKE    ME::SetProperty("ConfirmAnswer", "N")
           INVOKE    ME::OpenFormSync("CONFIRM-FORM")
           INVOKE    ME::GetProperty("ConfirmAnswer") RETURNING WS-ANSWER

           IF    WS-ANSWER NOT = "Y"
               EXIT PROGRAM
           END-IF
           OPEN    I-O TOPICS-FILE
           SET     TOP-ID                        TO    WS-TOPIC-ID-OF
           DELETE    TOPICS-FILE
               INVALID KEY CONTINUE
           END-DELETE
           COMMIT
           CLOSE    TOPICS-FILE
           SET     WS-OK                         TO    KB-T::RemoveCollection(WS-TOPIC-ID-OF)

           *> PC-DROP-TOPIC-ROWS: removes what a topic registered besides its own record: its files
           *> in TFILES-FILE and its prompt versions in PROMPTS-FILE.
           *> Uses:   WS-TOPIC-ID-OF = the id of the topic just deleted from TOPICS-FILE;
           *>         TFILES-FILE and PROMPTS-FILE (each created empty when missing).
           *> Result: every TFILES-FILE record whose TF-TOPIC is that id and every PROMPTS-FILE
           *>         record whose PRM-TOPIC is that id is deleted and committed (at most 200 of
           *>         each per call: the keys are gathered first). WS-SEQ-COUNT, WS-SEQ-OF, WS-K and
           *>         WS-EOF are work areas.

           CALL    "PC-DROP-TOPIC-ROWS"
           SET     WS-SET-NAME                   TO    "CUR-TOPIC"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "CUR-TOPIC" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = the id of the current topic, or SPACES when none; the IF below
           *>         compares its first 16 characters with WS-TOPIC-ID-OF.

           CALL    "PC-SETTING-GET"
           IF    WS-SET-VALUE(1:16) = WS-TOPIC-ID-OF
               SET     WS-SET-VALUE              TO    SPACES

               *> PC-SETTING-PUT: writes one setting by name to the settings file (indexed,
               *> WS-SETTINGS-PATH): the record is written, or rewritten when it exists, and
               *> committed at once. The file is created empty when missing. Reached only when the
               *> deleted topic was the current one.
               *> Uses:   WS-SET-NAME = "CUR-TOPIC" and WS-SET-VALUE = SPACES (set just above).
               *> Result: the CUR-TOPIC record of the settings file is blank, so no topic is
               *>         current. Only WS-FS and the settings record area (SET-NAME, SET-VALUE)
               *>         change.

               CALL    "PC-SETTING-PUT"
           END-IF
           SET     Lbl-Status::Caption           TO    T-TOPIC-DELETED::Trim()

           *> PC-LOAD-TOPICS: fills the topics grid Dg-List with every topic stored in TOPICS-FILE,
           *> in key (creation) order. Called here after the topic and its rows were deleted
           *> (Lbl-Status::Caption was just set to the "topic deleted" text).
           *> Uses:   TOPICS-FILE (<WS-DATA-DIR>/topics.idx = WS-TOPICS-PATH; created empty when
           *>         missing). It no longer holds the topic.
           *> Result: Dg-List is emptied and gets one row per topic (up to 500): name, prompt on one
           *>         line, and the open, edit and delete icons. WS-TOPIC-COUNT = rows added;
           *>         WS-TOPIC-ID(n) = id of grid row n. Then it asks the parent form (the chat) to
           *>         run its PC-REFRESH, INVOKE super::"PC-REFRESH"() (fire-and-forget: it runs
           *>         when the chat next waits for an event): the chat re-hands the models to its
           *>         agents, reloads the current topic (a blank conversation starts when the
           *>         current topic changed to another topic) and rebuilds the conversation list,
           *>         the menu state and the status line. The grid no longer lists the deleted
           *>         topic.

           CALL    "PC-LOAD-TOPICS"
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="TOPICS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PC-OPEN: prepares what the form shows: the data file paths, the texts in the user's
           *> language, the samples location, the Knowledge Base location and the topics grid.
           *> Uses:   the environment variables POWERCHAT_DATA and POWERCHAT_SAMPLES, the LANG and
           *>         KB-LOCATION settings, and TOPICS-FILE.
           *> Result: WS-DATA-DIR and the WS-*-PATH items (PC-PATHS); WS-LANG, WS-LANG-IX and every
           *>         caption and hint (PC-TEXTS); WS-SAMPLES-DIR = POWERCHAT_SAMPLES, or "samples"
           *>         when empty; WS-SAMPLES-LIST = <WS-SAMPLES-DIR>/samples.txt; KB-T::Location =
           *>         the KB-LOCATION setting when one is saved; Dg-List, WS-TOPIC-COUNT and
           *>         WS-TOPIC-ID reloaded (PC-LOAD-TOPICS, which also asks the chat to refresh
           *>         itself, fire-and-forget); Lbl-Status::Caption = the "no topics yet" text when
           *>         WS-TOPIC-COUNT = 0, else the "pick a topic" text.

           CALL    "PC-OPEN"
]]></Event>
    <Event name="onActivate" paragraph="TOPICS-FORM--ONACTIVATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Back on the pane: the topic or the language may have changed.

           *> PC-OPEN: refreshes what the form shows, now that it is back on the pane (the topic
           *> list or the language may have changed meanwhile): paths, texts, samples location,
           *> Knowledge Base location and grid.
           *> Uses:   the environment variables POWERCHAT_DATA and POWERCHAT_SAMPLES, the LANG and
           *>         KB-LOCATION settings, and TOPICS-FILE.
           *> Result: WS-DATA-DIR and the WS-*-PATH items (PC-PATHS); WS-LANG, WS-LANG-IX and every
           *>         caption and hint (PC-TEXTS); WS-SAMPLES-DIR = POWERCHAT_SAMPLES, or "samples"
           *>         when empty; WS-SAMPLES-LIST = <WS-SAMPLES-DIR>/samples.txt; KB-T::Location =
           *>         the KB-LOCATION setting when one is saved; Dg-List, WS-TOPIC-COUNT and
           *>         WS-TOPIC-ID reloaded (PC-LOAD-TOPICS, which also asks the chat to refresh
           *>         itself, fire-and-forget); Lbl-Status::Caption = the "no topics yet" text when
           *>         WS-TOPIC-COUNT = 0, else the "pick a topic" text.

           CALL    "PC-OPEN"
]]></Event>
    <Event name="onClose" paragraph="TOPICS-FORM--ONCLOSE">
    </Event>
  </form-events>
