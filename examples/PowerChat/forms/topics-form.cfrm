    <Property name="ArchiveMaximumDepth">3</Property>
    <Event name="onIndexed" paragraph="KB-T--ONINDEXED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-INSTALLING = "Y"
               CALL "PC-NEXT-IMPORT"
           END-IF
]]></Event>
    <Event name="onError" paragraph="KB-T--ONERROR"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE KB-T::LastError TO Lbl-Status::Caption
           IF WS-INSTALLING = "Y"
               CALL "PC-NEXT-IMPORT"
           END-IF
]]></Event>
    <Event name="onBusy" paragraph="KB-T--ONBUSY"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE KB-T::LastError TO Lbl-Status::Caption
           IF WS-INSTALLING = "Y"
               CALL "PC-NEXT-IMPORT"
           END-IF
]]></Event>
  </Control>
