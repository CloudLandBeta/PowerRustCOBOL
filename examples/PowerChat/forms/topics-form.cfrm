    <Event name="onClick" paragraph="BTN-OPEN--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Topics::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-TOPIC-COUNT
               MOVE "Pick a topic in the list first." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           MOVE "CUR-TOPIC" TO WS-SET-NAME
           MOVE WS-TOPIC-ID(WS-INDEX) TO WS-SET-VALUE
           CALL "PC-SETTING-PUT"
           MOVE "Topic opened." TO Lbl-Status::Caption
           INVOKE SUPER::SetProperty("ResultText", "OPENED")
           INVOKE ME::Close()
]]></Event>
  </Control>
