  <Control id="Btn-Create" type="Button" x="424" y="496" w="152" h="36" tab-order="5" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Create topic</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Event name="onClick" paragraph="BTN-CREATE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   A topic is data: its own id, name, prompt, documents and Knowledge
      *>   Base collection. Nothing about any topic is written in this code.
           MOVE Txt-Name::Text TO WS-NEW-NAME
           MOVE Txt-Prompt::Text TO WS-NEW-PROMPT
           IF WS-NEW-NAME = SPACES
               MOVE FUNCTION TRIM(T-NAME-FIRST) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           MOVE FUNCTION CURRENT-DATE TO WS-NOW
           MOVE WS-NOW(1:16) TO WS-NEW-ID
           OPEN I-O TOPICS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT TOPICS-FILE
               CLOSE TOPICS-FILE
               OPEN I-O TOPICS-FILE
           END-IF
           MOVE WS-NEW-ID TO TOP-ID
           MOVE WS-NEW-NAME TO TOP-NAME
           MOVE WS-NEW-PROMPT TO TOP-PROMPT
           MOVE WS-NOW(1:14) TO TOP-CREATED
           MOVE "N" TO TOP-SAMPLE
           WRITE TOPIC-REC
               INVALID KEY
                   MOVE FUNCTION TRIM(T-SAME-INSTANT) TO Lbl-Status::Caption
                   CLOSE TOPICS-FILE
                   EXIT PROGRAM
           END-WRITE
           COMMIT
           CLOSE TOPICS-FILE
      *>   Its Knowledge Base collection: an empty documents folder and index.
           MOVE KB-T::CreateCollection(WS-NEW-ID) TO WS-OK
           IF WS-OK NOT = "1"
               MOVE KB-T::LastError TO Lbl-Status::Caption
           ELSE
               MOVE FUNCTION TRIM(T-TOPIC-CREATED) TO Lbl-Status::Caption
           END-IF
           MOVE SPACES TO Txt-Name::Text
           MOVE SPACES TO Txt-Prompt::Text
           CALL "PC-LOAD-TOPICS"
           MOVE WS-TOPIC-COUNT TO WS-INDEX
           SUBTRACT 1 FROM WS-INDEX
           MOVE Lst-Topics::SetSelectedIndex(WS-INDEX) TO WS-OK
]]></Event>
  </Control>
