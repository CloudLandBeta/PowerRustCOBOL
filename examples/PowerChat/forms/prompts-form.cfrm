  <Control id="Tmr-Lang" type="Timer" x="952" y="16" w="48" h="48" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
