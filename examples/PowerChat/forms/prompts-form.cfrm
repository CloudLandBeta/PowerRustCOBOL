    <Property name="Interval">1000</Property>
    <Property name="Enabled">true</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onTick" paragraph="TMR-LANG--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   A flag in the chat's menu changes the language while this form is
           *>   on the pane; nothing tells a pane occupant, so it looks (R46).

           *> PC-LANG-NOW: reads the language saved now, without creating anything.
           *> Uses:   the LANG record of the settings file, opened for input only.
           *> Result: WS-LANG-NOW = "pt", "es", "fr", "jp" or "cn" when LANG holds that code, else
           *>         "en" (also when the file cannot be opened). The IF below compares it with
           *>         WS-LANG, the language on screen.

           CALL    "PC-LANG-NOW"
           IF    WS-LANG-NOW NOT = WS-LANG

               *> PROMPTS-FORM--ONACTIVATE: this form's onActivate event, which runs PC-OPEN. Called
               *> here because WS-LANG-NOW differs from WS-LANG: the user picked another language
               *> since the texts were loaded.
               *> Uses:   WS-SCOPE ("M" = the main prompt, "T" = the open topic's), the CUR-TOPIC
               *>         and LANG settings, PROMPTS-FILE and the old prompts.idx (migration) and,
               *>         in scope "T", TOPICS-FILE.
               *> Result: PC-OPEN runs again: WS-LANG and WS-LANG-IX follow the saved language, all
               *>         captions and hints are redone and the prompt for the current scope is
               *>         shown again (title, versions grid).

               CALL    "PROMPTS-FORM--ONACTIVATE"
           END-IF
]]></Event>
  </Control>
