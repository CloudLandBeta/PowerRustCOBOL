    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="Tooltip"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IconPath"></Property>
    <Event name="onClick" paragraph="BTN-VIEW--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Versions::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-VER-COUNT
               MOVE FUNCTION TRIM(T-PICK-VERSION-FIRST) TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           MOVE WS-VER(WS-INDEX) TO WS-PICKED
           MOVE WS-PICKED TO WS-VNUM
           OPEN I-O PROMPTS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT PROMPTS-FILE
               CLOSE PROMPTS-FILE
               OPEN I-O PROMPTS-FILE
           END-IF
           MOVE WS-CUR-TOPIC TO PRM-TOPIC
           MOVE WS-PICKED TO PRM-VERSION
           READ PROMPTS-FILE
               NOT INVALID KEY MOVE PRM-TEXT TO Txt-Prompt::Text
           END-READ
           CLOSE PROMPTS-FILE
           MOVE T-SHOWING-V TO WS-FMT
           MOVE WS-VNUM TO WS-ARG1
           CALL "PC-FMT"
           MOVE FUNCTION TRIM(WS-FMT-OUT) TO Lbl-Status::Caption
]]></Event>
  </Control>
  <Control id="Btn-Activate" type="Button" x="384" y="388" w="128" h="32" tab-order="4" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Activate</Property>
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#003758FF</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">3</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
