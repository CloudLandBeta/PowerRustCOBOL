    <Event name="onClick" paragraph="BTN-VIEW--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Versions::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-VER-COUNT
               MOVE "Pick a version in the list first." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           MOVE WS-VER(WS-INDEX) TO WS-PICKED
           MOVE WS-PICKED TO WS-VNUM
           OPEN I-O PROMPTS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT PROMPTS-FILE
               CLOSE PROMPTS-FILE
               OPEN I-O PROMPTS-FILE
           END-IF
           MOVE WS-CUR-TOPIC TO PRM-TOPIC
           MOVE WS-PICKED TO PRM-VERSION
           READ PROMPTS-FILE
               NOT INVALID KEY MOVE PRM-TEXT TO Txt-Prompt::Text
           END-READ
           CLOSE PROMPTS-FILE
           MOVE SPACES TO WS-LINE
           STRING "Showing v" FUNCTION TRIM(WS-VNUM) "." DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Status::Caption
]]></Event>
  </Control>
