    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Event name="onClick" paragraph="BTN-ACTIVATE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE Lst-Versions::GetSelectedIndex() TO WS-INDEX
           IF WS-INDEX < 0 OR WS-INDEX >= WS-VER-COUNT
               MOVE "Pick a version in the list first." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           ADD 1 TO WS-INDEX
           MOVE WS-VER(WS-INDEX) TO WS-PICKED
           MOVE WS-PICKED TO WS-VNUM
      *>   Promoting another version asks first (R48): the first press asks,
      *>   a second press on the same version confirms.
           IF WS-PICKED = WS-ACTIVE-VER
               MOVE "That version is already the active one." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           IF WS-CONFIRM-VER NOT = WS-PICKED
               MOVE WS-PICKED TO WS-CONFIRM-VER
               MOVE SPACES TO WS-LINE
               STRING "Make v" FUNCTION TRIM(WS-VNUM) " the active prompt? Press Activate again to confirm."
                   DELIMITED BY SIZE INTO WS-LINE
               MOVE WS-LINE TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           MOVE 0 TO WS-CONFIRM-VER
           CALL "PC-ACTIVATE"
           MOVE SPACES TO WS-LINE
           STRING "v" FUNCTION TRIM(WS-VNUM) " is the active prompt." DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Status::Caption
           CALL "PC-LOAD-VERSIONS"
]]></Event>
  </Control>
  <Control id="Btn-Save" type="Button" x="528" y="388" w="128" h="32" tab-order="5" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Save as new</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">3</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ZOrder">0</Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconPath"></Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The editor's text becomes a new version, and the active one.
           MOVE Txt-Prompt::Text TO WS-TEXT
           IF WS-TEXT = SPACES
               MOVE "The prompt is empty." TO Lbl-Status::Caption
               EXIT PROGRAM
           END-IF
           OPEN I-O PROMPTS-FILE
           IF WS-FS = "35"
               OPEN OUTPUT PROMPTS-FILE
               CLOSE PROMPTS-FILE
               OPEN I-O PROMPTS-FILE
           END-IF
           MOVE WS-CUR-TOPIC TO PRM-TOPIC
           COMPUTE PRM-VERSION = WS-LAST-VER + 1
           MOVE FUNCTION CURRENT-DATE TO WS-NOW
           MOVE WS-NOW(1:14) TO PRM-CREATED
           MOVE "N" TO PRM-ACTIVE
           MOVE WS-TEXT TO PRM-TEXT
           WRITE PROMPT-REC
               INVALID KEY CONTINUE
           END-WRITE
           COMMIT
           CLOSE PROMPTS-FILE
           ADD 1 TO WS-LAST-VER
           MOVE WS-LAST-VER TO WS-PICKED
           CALL "PC-ACTIVATE"
           MOVE WS-LAST-VER TO WS-VNUM
           MOVE SPACES TO WS-LINE
           STRING "Saved as v" FUNCTION TRIM(WS-VNUM) ", now active." DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Status::Caption
           MOVE 0 TO WS-CONFIRM-VER
           CALL "PC-LOAD-VERSIONS"
]]></Event>
  </Control>
