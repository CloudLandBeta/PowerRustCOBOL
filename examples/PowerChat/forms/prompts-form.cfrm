           05 T-PROMPT-EMPTY                     PIC    X(130).
           05 T-SAVED-AS                         PIC    X(130).
           05 T-ACTIVE-MARK                      PIC    X(130).
           05 T-PROMPT-TITLE                     PIC    X(130).
           05 T-HINT-PROMPT-EDITOR               PIC    X(130).
           05 T-NEW-VERSION                      PIC    X(130).
           05 T-ACTIVATE                         PIC    X(130).
           05 T-SAVE                             PIC    X(130).
           05 T-STATUS                           PIC    X(130).
           05 T-TAB-BROWSE                       PIC    X(130).
           05 T-TAB-EDIT                         PIC    X(130).
           05 T-NEW                              PIC    X(130).
           05 T-CANCEL                           PIC    X(130).
           05 T-YES                              PIC    X(130).
           05 T-NO                               PIC    X(130).
           05 T-CONFIRM-DELETE                   PIC    X(130).
           05 T-ACTIVE-NO-DELETE                 PIC    X(130).
           05 T-DELETED                          PIC    X(130).
           05 T-SAVED-V                          PIC    X(130).
           05 T-SAVE-FAILED                      PIC    X(130).
           05 T-DELETE-FAILED                    PIC    X(130).
           05 T-COL-VERSION                      PIC    X(130).
           05 T-COL-CREATED                      PIC    X(130).
           05 T-COL-ACTIVE                       PIC    X(130).
           05 T-COL-TEXT                         PIC    X(130).
           05 T-MAIN-PROMPT                      PIC    X(130).
           05 T-TOPIC-PROMPT                     PIC    X(130).
           05 T-RESTORE-DEFAULT                  PIC    X(130).
           05 T-MAIN-TITLE                       PIC    X(130).
           05 T-HINT-MAIN-EDITOR                 PIC    X(130).
       01 PC-TEXTS-NOW-R                         REDEFINES    PC-TEXTS-NOW    GLOBAL.
           05 PC-TEXT-NOW                        PIC    X(130)    OCCURS 37.
       *>   PC-FMT: WS-FMT with &1..&4 replaced by WS-ARG1..4, into WS-FMT-OUT.

       01 WS-FMT                                 GLOBAL    PIC X(130).
       01 WS-ARG1                                GLOBAL    PIC X(300).
       01 WS-ARG2                                GLOBAL    PIC X(300).
       01 WS-ARG3                                GLOBAL    PIC X(300).
       01 WS-ARG4                                GLOBAL    PIC X(300).
       01 WS-FMT-OUT                             GLOBAL    PIC X(1200).
]]></working-storage>
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
           CLASS RUST-I64 IS "Rust.i64"
           CLASS RUST-I128 IS "Rust.i128"
           CLASS RUST-ISIZE IS "Rust.isize"
           CLASS RUST-U8 IS "Rust.u8"
           CLASS RUST-U16 IS "Rust.u16"
           CLASS RUST-U32 IS "Rust.u32"
           CLASS RUST-U64 IS "Rust.u64"
           CLASS RUST-U128 IS "Rust.u128"
           CLASS RUST-USIZE IS "Rust.usize"
           CLASS RUST-F32 IS "Rust.f32"
           CLASS RUST-F64 IS "Rust.f64"
           CLASS RUST-STR IS "Rust.str"
           CLASS RUST-UNIT IS "Rust.unit"
           CLASS RUST-STRING IS "Rust.String"
           CLASS RUST-OSSTRING IS "Rust.OsString"
           CLASS RUST-OSSTR IS "Rust.OsStr"
           CLASS RUST-CSTRING IS "Rust.CString"
           CLASS RUST-CSTR IS "Rust.CStr"
           CLASS RUST-PATH IS "Rust.Path"
           CLASS RUST-PATHBUF IS "Rust.PathBuf"
           CLASS RUST-VEC IS "Rust.Vec"
           CLASS RUST-VECDEQUE IS "Rust.VecDeque"
           CLASS RUST-LINKEDLIST IS "Rust.LinkedList"
           CLASS RUST-HASHMAP IS "Rust.HashMap"
           CLASS RUST-BTREEMAP IS "Rust.BTreeMap"
           CLASS RUST-HASHSET IS "Rust.HashSet"
           CLASS RUST-BTREESET IS "Rust.BTreeSet"
           CLASS RUST-BINARYHEAP IS "Rust.BinaryHeap"
           CLASS RUST-OPTION IS "Rust.Option"
           CLASS RUST-RESULT IS "Rust.Result"
           CLASS RUST-BOX IS "Rust.Box"
           CLASS RUST-RC IS "Rust.Rc"
           CLASS RUST-ARC IS "Rust.Arc"
           CLASS RUST-WEAK IS "Rust.Weak"
           CLASS RUST-CELL IS "Rust.Cell"
           CLASS RUST-REFCELL IS "Rust.RefCell"
           CLASS RUST-MUTEX IS "Rust.Mutex"
           CLASS RUST-RWLOCK IS "Rust.RwLock"
           CLASS RUST-COW IS "Rust.Cow"
           CLASS RUST-DURATION IS "Rust.Duration"
           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"
]]></repository>
  <file-control><![CDATA[           SELECT SETTINGS-FILE ASSIGN TO WS-SETTINGS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS SET-NAME
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT TOPICS-FILE ASSIGN TO WS-TOPICS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS TOP-ID
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT PROMPTS-FILE ASSIGN TO WS-PROMPTS-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS PRM-KEY
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT OLDPRM-FILE ASSIGN TO WS-OLDPRM-PATH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS OLD-KEY
               FILE STATUS IS WS-FS
               STORAGE MODE IS DISK.
           SELECT MPSEED-FILE ASSIGN TO WS-MPSEED-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS.
]]></file-control>
  <file-section><![CDATA[       FD SETTINGS-FILE IS GLOBAL.
       01 SETTINGS-REC.
           05 SET-NAME                           PIC    X(20).
           05 SET-VALUE                          PIC    X(200).
       FD TOPICS-FILE IS GLOBAL.
       01 TOPIC-REC.
           05 TOP-ID                             PIC    X(16).
           05 TOP-NAME                           PIC    X(40).
           05 TOP-PROMPT                         PIC    X(1000).
           05 TOP-CREATED                        PIC    X(14).
           *>   "Y" for a topic the sample installer made, so it can be removed.

           05 TOP-SAMPLE                         PIC    X.
       FD PROMPTS-FILE IS GLOBAL.
       *>   Every version of each topic's system prompt (R48), and of the main
       *>   prompt under "*MAIN": data/prompt-versions.idx. A topic's active
       *>   text is also its TOP-PROMPT, which is what the chat reads.

       01 PROMPT-REC.
           05 PRM-KEY.
               10 PRM-TOPIC                      PIC    X(16).
               10 PRM-VERSION                    PIC    9(4).
           05 PRM-CREATED                        PIC    X(14).
           05 PRM-ACTIVE                         PIC    X.
           05 PRM-TEXT                           PIC    X(32000).
       *>   The versions' file before 1.70.332, read once to move them over.

       FD OLDPRM-FILE IS GLOBAL.
       01 OLD-PROMPT-REC.
           05 OLD-KEY.
               10 OLD-TOPIC                      PIC    X(16).
               10 OLD-VERSION                    PIC    9(4).
           05 OLD-CREATED                        PIC    X(14).
           05 OLD-ACTIVE                         PIC    X.
           05 OLD-TEXT                           PIC    X(1000).
       FD MPSEED-FILE IS GLOBAL.
       01 MPSEED-REC                             PIC    X(1000).
]]></file-section>
  <user-procedures>
    <Event name="PC-PATHS" paragraph="PC-PATHS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Where PowerChat keeps its own files: POWERCHAT_DATA, else "data".

           DISPLAY    "POWERCHAT_DATA" UPON ENVIRONMENT-NAME
           ACCEPT    WS-DATA-DIR FROM ENVIRONMENT-VALUE
           IF    WS-DATA-DIR = SPACES
               SET     WS-DATA-DIR               TO    "data"
           END-IF
           SET     WS-SETTINGS-PATH              TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/settings.idx" INTO WS-SETTINGS-PATH
           SET     WS-TOPICS-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/topics.idx" INTO WS-TOPICS-PATH
           SET     WS-PROMPTS-PATH               TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/prompt-versions.idx" INTO WS-PROMPTS-PATH
           SET     WS-OLDPRM-PATH                TO    SPACES
           STRING    WS-DATA-DIR::Trim() "/prompts.idx" INTO WS-OLDPRM-PATH
           DISPLAY    "POWERCHAT_SAMPLES" UPON ENVIRONMENT-NAME
           ACCEPT    WS-SAMPLES-DIR FROM ENVIRONMENT-VALUE
           IF    WS-SAMPLES-DIR = SPACES
               SET     WS-SAMPLES-DIR            TO    "samples"
           END-IF
           SET     WS-MPSEED-PATH                TO    SPACES
           STRING    WS-SAMPLES-DIR::Trim() "/main-prompt.md" INTO WS-MPSEED-PATH
]]></Event>
    <Event name="PC-SETTING-GET" paragraph="PC-SETTING-GET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME in, WS-SET-VALUE out (spaces when the setting is unset).

           SET     WS-SET-VALUE                  TO    SPACES
           *> Status 35 is a missing file (first run): create it empty and reopen
           *> I-O, so the read below simply finds no record.

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF
           SET     SET-NAME                      TO    WS-SET-NAME
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY MOVE SET-VALUE TO WS-SET-VALUE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-SETTING-PUT" paragraph="PC-SETTING-PUT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-SET-NAME, WS-SET-VALUE in. Written and committed at once (R10f).

           OPEN    I-O SETTINGS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT SETTINGS-FILE
               CLOSE    SETTINGS-FILE
               OPEN    I-O SETTINGS-FILE
           END-IF

           SET     SET-NAME                      TO    WS-SET-NAME
           SET     SET-VALUE                     TO    WS-SET-VALUE

           WRITE    SETTINGS-REC
               INVALID KEY REWRITE SETTINGS-REC
           END-WRITE
           COMMIT
           CLOSE    SETTINGS-FILE
]]></Event>
    <Event name="PC-LOAD-VERSIONS" paragraph="PC-LOAD-VERSIONS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The topic's versions, newest first, the active one marked (R48).
           *>   A topic that has none yet gets version 1 from its current prompt.
           *>   One grid row per version: number (the key), date, the active
           *>   marker, a preview of the text, then the promote, edit and delete
           *>   icon buttons.

           Dg-List::ClearRows()
           SET     WS-VER-COUNT WS-LAST-VER WS-ACTIVE-VER
                                                 TO    0

           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF

           *> PRM-KEY is topic then version, so from version 0 the topic's records
           *> come oldest first: WS-LAST-VER ends as the newest, and the first
           *> record of another topic ends the scan.

           SET     PRM-TOPIC                     TO    WS-CUR-TOPIC
           SET     PRM-VERSION                   TO    0
           SET     WS-EOF                        TO    "N"

           START    PROMPTS-FILE KEY IS >= PRM-KEY
               INVALID KEY MOVE "Y" TO WS-EOF
           END-START
           PERFORM    UNTIL WS-EOF = "Y"
               READ    PROMPTS-FILE NEXT RECORD
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       IF    PRM-TOPIC NOT = WS-CUR-TOPIC
                           SET     WS-EOF        TO    "Y"
                       ELSE
                           SET     WS-LAST-VER   TO    PRM-VERSION
                           IF    PRM-ACTIVE = "Y"
                               SET     WS-ACTIVE-VER
                                                 TO    PRM-VERSION
                           END-IF
                       END-IF
               END-READ
           END-PERFORM
           IF    WS-LAST-VER = 0
               SET     PRM-TOPIC                 TO    WS-CUR-TOPIC
               SET     PRM-VERSION WS-LAST-VER WS-ACTIVE-VER
                                                 TO    1

               SET     WS-NOW                    TO    FUNCTION CURRENT-DATE
               SET     PRM-CREATED               TO    WS-NOW(1:14)
               SET     PRM-ACTIVE                TO    "Y"

               *> The main prompt is not a topic: its first version is the shipped
               *> default (samples/main-prompt.md), not a topic's prompt.

               IF    WS-CUR-TOPIC = "*MAIN"

                   *> PC-MAIN-DEFAULT: reads the main prompt as shipped (the samples folder's
                   *> main-prompt.md) into WS-TEXT, keeping every line's indentation. Called here
                   *> because the main prompt ("*MAIN") has no version yet.
                   *> Uses:   WS-MPSEED-PATH = <WS-SAMPLES-DIR>/main-prompt.md (WS-SAMPLES-DIR =
                   *>         POWERCHAT_SAMPLES, else "samples"; set by PC-PATHS).
                   *> Result: WS-TEXT = every line of the file (a line is held in 1000 characters,
                   *>         the whole text in 32000), each followed by a line break (the last one
                   *>         too), or SPACES when the file cannot be opened. The lines below store
                   *>         it as version 1 of "*MAIN", active, and write it.

                   CALL    "PC-MAIN-DEFAULT"

                   SET     PRM-TOPIC             TO    WS-CUR-TOPIC
                   SET     PRM-VERSION           TO    1
                   SET     PRM-ACTIVE            TO    "Y"
                   SET     PRM-TEXT              TO    WS-TEXT
               ELSE
                   SET     PRM-TEXT              TO    TOP-PROMPT
               END-IF
               WRITE    PROMPT-REC
                   INVALID KEY CONTINUE
               END-WRITE
               COMMIT
           END-IF
           *>   Newest first: walk down from the last version.

           PERFORM    VARYING WS-I FROM WS-LAST-VER BY -1 UNTIL WS-I < 1
               SET     PRM-TOPIC                 TO    WS-CUR-TOPIC
               SET     PRM-VERSION               TO    WS-I

               READ    PROMPTS-FILE
                   INVALID KEY CONTINUE
                   NOT INVALID KEY
                       IF    WS-VER-COUNT < 200
                           ADD    1 TO WS-VER-COUNT
                           SET     WS-VER(WS-VER-COUNT)
                                                 TO    PRM-VERSION

                           SET     WS-VNUM       TO    PRM-VERSION
                           *>   A tab or a line break inside the text would split the row.

                           SET     WS-PREVIEW    TO    PRM-TEXT(1:57)
                           INSPECT    WS-PREVIEW REPLACING ALL X"09" BY SPACE
                               ALL X"0A" BY SPACE
                               ALL X"0D" BY SPACE
                           IF    PRM-TEXT(58:) NOT = SPACES
                               SET     WS-LINE   TO    SPACES
                               STRING    WS-PREVIEW::Trim() "..." INTO WS-LINE
                               SET     WS-PREVIEW
                                                 TO    WS-LINE
                           END-IF
                           SET     WS-LINE       TO    SPACES
                           IF    PRM-ACTIVE = "Y"
                               SET     WS-LINE   TO    T-ACTIVE-MARK
                           END-IF
                           SET     WS-ROW        TO    SPACES
                           *> One tab-separated row, in the grid's column order. WS-VNUM is
                           *> zero-suppressed (3, not 0003); PRM-CREATED is YYYYMMDDHHMMSS and
                           *> shows as YYYY-MM-DD HH:MM.

                           STRING    WS-VNUM::Trim() X"09"
                               PRM-CREATED(1:4) "-" PRM-CREATED(5:2) "-"
                               PRM-CREATED(7:2) " " PRM-CREATED(9:2) ":"
                               PRM-CREATED(11:2) X"09"
                           WS-LINE::Trim() X"09"
                           WS-PREVIEW::Trim() X"09"
                               "icon:check-circle" X"09"
                               "icon:pencil" X"09"
                               "icon:trash"
                               INTO WS-ROW

                           Dg-List::AddRow(WS-ROW)
                       END-IF
               END-READ
           END-PERFORM
           CLOSE    PROMPTS-FILE
]]></Event>
    <Event name="PC-ACTIVATE" paragraph="PC-ACTIVATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-PICKED in: that version becomes the active one, and its text the
           *>   topic's prompt, which the chat's orchestrator is given (R63).

           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF
           *> Exactly one version stays active: the picked one is switched on and
           *> every other version of the topic is switched off in the same pass.

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-LAST-VER
               SET     PRM-TOPIC                 TO    WS-CUR-TOPIC
               SET     PRM-VERSION               TO    WS-I

               READ    PROMPTS-FILE
                   INVALID KEY CONTINUE
                   NOT INVALID KEY
                       IF    WS-I = WS-PICKED
                           SET     PRM-ACTIVE    TO    "Y"
                           SET     WS-TEXT       TO    PRM-TEXT
                       ELSE
                           SET     PRM-ACTIVE    TO    "N"
                       END-IF
                       REWRITE    PROMPT-REC
                       END-REWRITE
               END-READ
           END-PERFORM
           COMMIT
           CLOSE    PROMPTS-FILE
           SET     WS-ACTIVE-VER                 TO    WS-PICKED
           *> The main prompt is no topic: there is no topic record to copy it to.

           IF    WS-CUR-TOPIC = "*MAIN"
               EXIT PROGRAM
           END-IF
           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF
           SET     TOP-ID                        TO    WS-CUR-TOPIC
           READ    TOPICS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   SET     TOP-PROMPT            TO    WS-TEXT
                   REWRITE    TOPIC-REC
                   END-REWRITE
                   COMMIT
           END-READ
           CLOSE    TOPICS-FILE
           SET     WS-ACTIVE-VER                 TO    WS-PICKED
]]></Event>
    <Event name="PC-TEXTS" paragraph="PC-TEXTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language the user picked (LANG), the texts in it, and every
           *>   designed caption and hint that shows one. Called on load and again
           *>   whenever the language changes (R46).

           SET     WS-SET-NAME                   TO    "LANG"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "LANG" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = the language code saved under LANG ("en", "pt", "es", "fr",
           *>         "jp" or "cn"), or SPACES when none was saved. Used right below to set WS-LANG.

           CALL    "PC-SETTING-GET"
           SET     WS-LANG                       TO    WS-SET-VALUE(1:2)
           EVALUATE    WS-LANG
               WHEN "en" MOVE 1 TO WS-LANG-IX
               WHEN "pt" MOVE 2 TO WS-LANG-IX
               WHEN "es" MOVE 3 TO WS-LANG-IX
               WHEN "fr" MOVE 4 TO WS-LANG-IX
               WHEN "jp" MOVE 5 TO WS-LANG-IX
               WHEN "cn" MOVE 6 TO WS-LANG-IX
               WHEN OTHER MOVE "en" TO WS-LANG
                   SET     WS-LANG-IX            TO    1
           END-EVALUATE
           *> PC-TEXT-NOW overlays the T- names, so row N of the table becomes the
           *> Nth name. The bound is the number of texts (the OCCURS of the table).

           PERFORM    VARYING WS-TX-I FROM 1 BY 1 UNTIL WS-TX-I > 37
               SET     PC-TEXT-NOW(WS-TX-I)      TO    PC-TEXT(WS-TX-I, WS-LANG-IX)
           END-PERFORM

           SET     Lbl-Title::Caption            TO    T-PROMPT-TITLE::Trim()
           SET     Txt-Prompt::HintText          TO    T-HINT-PROMPT-EDITOR::Trim()
           SET     Btn-New::Caption              TO    T-NEW::Trim()
           SET     Btn-Save::Caption             TO    T-SAVE::Trim()
           SET     Btn-Save-Bottom::Caption      TO    T-SAVE::Trim()
           SET     Btn-Cancel::Caption           TO    T-CANCEL::Trim()
           SET     Btn-Cancel-Bottom::Caption    TO    T-CANCEL::Trim()
           SET     Btn-Main::Caption             TO    T-MAIN-PROMPT::Trim()
           SET     Btn-Topic::Caption            TO    T-TOPIC-PROMPT::Trim()
           SET     Btn-Default::Caption          TO    T-RESTORE-DEFAULT::Trim()
           SET     Lbl-Status::Caption           TO    T-STATUS::Trim()
           SET     WS-TABS                       TO    SPACES

           STRING    T-TAB-BROWSE::Trim() X"0A" T-TAB-EDIT::Trim() INTO WS-TABS
           SET     Tab-Crud::Tabs                TO    WS-TABS

           Dg-List::SetColumnTitle("Ver", T-COL-VERSION)
           Dg-List::SetColumnTitle("Created", T-COL-CREATED)
           Dg-List::SetColumnTitle("Active", T-COL-ACTIVE)
           Dg-List::SetColumnTitle("Text", T-COL-TEXT)
]]></Event>
    <Event name="PC-FMT" paragraph="PC-FMT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-PT                                  PIC    9(4).
       01 WS-FROM                                PIC    9(4).
       01 WS-CNT                                 PIC    9(4).
       01 WS-PART                                PIC    X(130).
       01 WS-DELIM                               PIC    XX.

       PROCEDURE DIVISION.
           *>   A message whose words go round numbers and names differently in each
           *>   language: WS-FMT holds "&1" .. "&4" where WS-ARG1..4 go.

           SET     WS-FMT-OUT                    TO    SPACES
           SET     WS-PT                         TO    1
           SET     WS-FROM                       TO    1

           PERFORM    UNTIL WS-FROM > FUNCTION LENGTH(WS-FMT)
               SET     WS-PART WS-DELIM          TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-FMT DELIMITED BY "&1" OR "&2" OR "&3" OR "&4"
                   INTO WS-PART DELIMITER IN WS-DELIM COUNT IN WS-CNT
                   WITH POINTER WS-FROM
               END-UNSTRING
               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-FMT-OUT WITH POINTER WS-PT
               END-IF
               EVALUATE    WS-DELIM
                   WHEN "&1" STRING WS-ARG1::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&2" STRING WS-ARG2::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&3" STRING WS-ARG3::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   WHEN "&4" STRING WS-ARG4::Trim() INTO WS-FMT-OUT WITH POINTER WS-PT
                   *> No &n left: the tail was copied above, so move the pointer past the
                   *> end to stop the loop.
                   WHEN OTHER COMPUTE WS-FROM = FUNCTION LENGTH(WS-FMT) + 1
               END-EVALUATE
           END-PERFORM
]]></Event>
    <Event name="PC-OPEN" paragraph="PC-OPEN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   What the form shows: run on load, and again when it comes back.

           *> PC-PATHS: works out where PowerChat keeps its own files and where the shipped samples
           *> are.
           *> Uses:   the environment variables POWERCHAT_DATA and POWERCHAT_SAMPLES.
           *> Result: WS-DATA-DIR = POWERCHAT_DATA, or "data" when empty; WS-SETTINGS-PATH,
           *>         WS-TOPICS-PATH, WS-PROMPTS-PATH and WS-OLDPRM-PATH =
           *>         <WS-DATA-DIR>/settings.idx, topics.idx, prompt-versions.idx and prompts.idx;
           *>         WS-SAMPLES-DIR = POWERCHAT_SAMPLES, or "samples" when empty; WS-MPSEED-PATH =
           *>         <WS-SAMPLES-DIR>/main-prompt.md. No file is opened.

           CALL    "PC-PATHS"

           *> PC-MIGRATE: copies the prompt versions of the old file prompts.idx into
           *> prompt-versions.idx, once.
           *> Uses:   PROMPTS-FILE (WS-PROMPTS-PATH, just set by PC-PATHS) and OLDPRM-FILE
           *>         (WS-OLDPRM-PATH).
           *> Result: only while PROMPTS-FILE has no record, and only if the old file opens: every
           *>         old version is written to PROMPTS-FILE (topic, number, date, active flag,
           *>         text) and committed. The old file is only read. Otherwise no file changes.
           *>         WS-EMPTY = "Y" when PROMPTS-FILE was empty; WS-EOF = "N".

           CALL    "PC-MIGRATE"

           *> PC-TEXTS: puts the form in the user's language: it reads the LANG setting, loads the
           *> matching texts and sets every designed caption and hint.
           *> Uses:   the LANG setting (read through PC-SETTING-GET) and the PC-TEXT table of 37
           *>         texts in 6 languages.
           *> Result: WS-LANG = "en", "pt", "es", "fr", "jp" or "cn" ("en" when unknown) and
           *>         WS-LANG-IX = 1 to 6, its column; PC-TEXT-NOW(1..37) = the texts in that
           *>         language, which the T-... names read. Captions, hints and column titles are
           *>         set on Lbl-Title, Txt-Prompt, Btn-New, Btn-Save, Btn-Save-Bottom, Btn-Cancel,
           *>         Btn-Cancel-Bottom, Btn-Main, Btn-Topic, Btn-Default, Lbl-Status, Tab-Crud and
           *>         Dg-List. WS-SET-NAME = "LANG" and WS-SET-VALUE hold the saved code.

           CALL    "PC-TEXTS"

           SET     WS-SET-NAME                   TO    "CUR-TOPIC"

           *> PC-SETTING-GET: reads one setting by name from the settings file (indexed,
           *> WS-SETTINGS-PATH = <WS-DATA-DIR>/settings.idx). The file is created empty when
           *> missing; nothing is written.
           *> Uses:   WS-SET-NAME = "CUR-TOPIC" (set just above; it is the record key).
           *> Result: WS-SET-VALUE = the id of the topic opened on the Topics form, or SPACES when
           *>         none; the next line copies its first 16 characters to WS-TOPIC-ID.

           CALL    "PC-SETTING-GET"
           SET     WS-TOPIC-ID                   TO    WS-SET-VALUE(1:16)
           *>   The main prompt: every topic's, whether one is open or not.

           IF    WS-SCOPE = "M"
               SET     WS-CUR-TOPIC              TO    "*MAIN"
               SET     Lbl-Title::Caption        TO    T-MAIN-TITLE::Trim()
               SET     Txt-Prompt::HintText      TO    T-HINT-MAIN-EDITOR::Trim()
               SET     Btn-Default::Visible      TO    TRUE

               *> PC-LOAD-VERSIONS: fills the versions grid Dg-List with the prompt versions of
               *> WS-CUR-TOPIC, newest first, the active one marked; a prompt with no version yet
               *> gets version 1, active, written to the file. Called here for the main prompt
               *> shared by every topic.
               *> Uses:   WS-CUR-TOPIC, PROMPTS-FILE (<WS-DATA-DIR>/prompt-versions.idx =
               *>         WS-PROMPTS-PATH; created empty when missing) and T-ACTIVE-MARK (the
               *>         "[active]" text). Here WS-CUR-TOPIC = "*MAIN" (just set).
               *> Result: Dg-List is emptied and gets one row per version (up to 200): number,
               *>         created date and time, "[active]" marker, the first 57 characters of the
               *>         text ("..." when longer) and the promote, edit and delete icons.
               *>         WS-VER-COUNT = rows; WS-VER(n) = version of row n; WS-LAST-VER = highest
               *>         version; WS-ACTIVE-VER = the version flagged active. With no version,
               *>         version 1 is the shipped default (PC-MAIN-DEFAULT).

               CALL    "PC-LOAD-VERSIONS"
               SET     Tab-Crud::SelectedTab     TO    1
               EXIT PROGRAM
           END-IF

           SET     Btn-Default::Visible          TO    FALSE
           SET     WS-CUR-TOPIC                  TO    WS-TOPIC-ID

           IF    WS-CUR-TOPIC = SPACES
               SET     Lbl-Status::Caption       TO    T-OPEN-TOPIC-FIRST::Trim()
               EXIT PROGRAM
           END-IF
           OPEN    I-O TOPICS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT TOPICS-FILE
               CLOSE    TOPICS-FILE
               OPEN    I-O TOPICS-FILE
           END-IF
           SET     TOP-ID                        TO    WS-CUR-TOPIC
           READ    TOPICS-FILE
               INVALID KEY MOVE "?" TO TOP-NAME
           END-READ
           CLOSE    TOPICS-FILE

           SET     WS-FMT                        TO    T-PROMPT-OF
           SET     WS-ARG1                       TO    TOP-NAME

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-PROMPT-OF (the "Prompt - &1" text in the current language); WS-ARG1
           *>         = TOP-NAME, the name of the open topic ("?" when its record was not found).
           *> Result: WS-FMT-OUT = the heading with the topic's name in it; the next line puts it on
           *>         Lbl-Title. Nothing else changes.

           CALL    "PC-FMT"
           SET     Lbl-Title::Caption            TO    WS-FMT-OUT::Trim()

           *> PC-LOAD-VERSIONS: fills the versions grid Dg-List with the prompt versions of
           *> WS-CUR-TOPIC, newest first, the active one marked; a prompt with no version yet gets
           *> version 1, active, written to the file. Called here for the open topic's prompt.
           *> Uses:   WS-CUR-TOPIC, PROMPTS-FILE (<WS-DATA-DIR>/prompt-versions.idx =
           *>         WS-PROMPTS-PATH; created empty when missing) and T-ACTIVE-MARK (the "[active]"
           *>         text). Here WS-CUR-TOPIC = the open topic's id; TOP-PROMPT (read just above)
           *>         is used only when the topic has no version.
           *> Result: Dg-List is emptied and gets one row per version (up to 200): number, created
           *>         date and time, "[active]" marker, the first 57 characters of the text ("..."
           *>         when longer) and the promote, edit and delete icons. WS-VER-COUNT = rows;
           *>         WS-VER(n) = version of row n; WS-LAST-VER = highest version; WS-ACTIVE-VER =
           *>         the version flagged active. With no version, version 1 is the topic's current
           *>         prompt, TOP-PROMPT.

           CALL    "PC-LOAD-VERSIONS"
           SET     Tab-Crud::SelectedTab         TO    1
]]></Event>
    <Event name="PC-NEW" paragraph="PC-NEW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   An empty editor on the Create/Update tab: Save adds a new version.

           IF    WS-CUR-TOPIC = SPACES
               SET     Lbl-Status::Caption       TO    T-OPEN-TOPIC-FIRST::Trim()
               EXIT PROGRAM
           END-IF

           SET     WS-EDIT-VER                   TO    0
           SET     WS-TEXT                       TO    SPACES
           SET     Txt-Prompt::Text              TO    WS-TEXT
           SET     Lbl-Edit-Ver::Caption         TO    T-NEW-VERSION::Trim()
           SET     Tab-Crud::SelectedTab         TO    2
]]></Event>
    <Event name="PC-EDIT" paragraph="PC-EDIT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-PICKED in: that version's text on the Create/Update tab.

           SET     WS-VNUM                       TO    WS-PICKED
           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF

           SET     PRM-TOPIC                     TO    WS-CUR-TOPIC
           SET     PRM-VERSION                   TO    WS-PICKED
           SET     WS-SAVE-OK                    TO    "Y"

           READ    PROMPTS-FILE
               INVALID KEY MOVE "N" TO WS-SAVE-OK
           END-READ
           CLOSE    PROMPTS-FILE
           IF    WS-SAVE-OK NOT = "Y"
               SET     Lbl-Status::Caption       TO    T-PICK-VERSION-FIRST::Trim()
               EXIT PROGRAM
           END-IF

           SET     WS-EDIT-VER                   TO    WS-PICKED
           SET     WS-TEXT                       TO    PRM-TEXT
           SET     Txt-Prompt::Text              TO    WS-TEXT
           SET     WS-FMT                        TO    T-EDITING-V
           SET     WS-ARG1                       TO    WS-VNUM

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-EDITING-V (the "Editing v&1" text in the current language); WS-ARG1
           *>         = WS-VNUM, the number of the version being edited (WS-PICKED).
           *> Result: WS-FMT-OUT = "Editing v<n>" in that language; the next line puts it on
           *>         Lbl-Edit-Ver. Nothing else changes.

           CALL    "PC-FMT"

           SET     Lbl-Edit-Ver::Caption         TO    WS-FMT-OUT::Trim()
           SET     Tab-Crud::SelectedTab         TO    2
]]></Event>
    <Event name="PC-SAVE" paragraph="PC-SAVE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Both Save buttons. A new version (WS-EDIT-VER = 0) is written as
           *>   the last one and becomes the active prompt; an edited one keeps its
           *>   date and its active flag, and when it is the active one the topic's
           *>   prompt follows. WRITE first; an existing key is REWRITTEN.

           SET     WS-TEXT                       TO    Txt-Prompt::Text
           IF    WS-TEXT = SPACES
               SET     Lbl-Status::Caption       TO    T-PROMPT-EMPTY::Trim()
               EXIT PROGRAM
           END-IF
           IF    WS-CUR-TOPIC = SPACES
               SET     Lbl-Status::Caption       TO    T-OPEN-TOPIC-FIRST::Trim()
               EXIT PROGRAM
           END-IF
           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF

           SET     WS-NOW                        TO    FUNCTION CURRENT-DATE
           SET     PRM-TOPIC                     TO    WS-CUR-TOPIC

           IF    WS-EDIT-VER = 0
               COMPUTE    WS-SAVE-VER = WS-LAST-VER + 1

               SET     PRM-VERSION               TO    WS-SAVE-VER
               SET     PRM-CREATED               TO    WS-NOW(1:14)
               SET     PRM-ACTIVE                TO    "N"
           ELSE
               SET     WS-SAVE-VER               TO    WS-EDIT-VER
               SET     PRM-VERSION               TO    WS-SAVE-VER

               READ    PROMPTS-FILE
                   INVALID KEY
                       SET     PRM-CREATED       TO    WS-NOW(1:14)
                       SET     PRM-ACTIVE        TO    "N"
               END-READ

               SET     PRM-TOPIC                 TO    WS-CUR-TOPIC
               SET     PRM-VERSION               TO    WS-SAVE-VER
           END-IF

           SET     PRM-TEXT                      TO    WS-TEXT
           SET     WS-SAVE-OK                    TO    "Y"

           WRITE    PROMPT-REC
               INVALID KEY
                   REWRITE    PROMPT-REC
                       INVALID KEY MOVE "N" TO WS-SAVE-OK
                       SET     WS-FS-ERR         TO    WS-FS
                   END-REWRITE
           END-WRITE
           IF    WS-SAVE-OK = "Y"
               COMMIT
           ELSE
               ROLLBACK
           END-IF
           CLOSE    PROMPTS-FILE
           SET     WS-VNUM                       TO    WS-SAVE-VER
           IF    WS-SAVE-OK NOT = "Y"
               SET     WS-FMT                    TO    T-SAVE-FAILED
               SET     WS-ARG1                   TO    WS-VNUM
               SET     WS-ARG2                   TO    WS-FS-ERR

               *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
               *> WS-ARG1 to WS-ARG4 (trimmed).
               *> Uses:   WS-FMT = T-SAVE-FAILED (the "Could not save v&1 (file status &2)." text in
               *>         the current language); WS-ARG1 = WS-VNUM (the version number tried);
               *>         WS-ARG2 = WS-FS-ERR, the file status of the REWRITE that failed.
               *> Result: WS-FMT-OUT = the message with both values in it, shown on Lbl-Status just
               *>         below, after which PC-SAVE ends. Nothing else changes.

               CALL    "PC-FMT"
               SET     Lbl-Status::Caption       TO    WS-FMT-OUT::Trim()
               EXIT PROGRAM
           END-IF
           IF    WS-EDIT-VER = 0
               *> PC-ACTIVATE walks the versions up to WS-LAST-VER, so the new one
               *> must be counted before it runs.

               SET     WS-LAST-VER               TO    WS-SAVE-VER
               SET     WS-PICKED                 TO    WS-SAVE-VER

               *> PC-ACTIVATE: makes version WS-PICKED of WS-CUR-TOPIC's prompt the active one and,
               *> for a topic, copies its text to the topic's prompt, which the chat reads.
               *> Uses:   WS-PICKED (the version to activate), WS-LAST-VER (how many versions to
               *>         walk), WS-CUR-TOPIC, PROMPTS-FILE and TOPICS-FILE (each created empty when
               *>         missing). Here WS-PICKED and WS-LAST-VER both = WS-SAVE-VER, the new
               *>         version just written (set just above).
               *> Result: in PROMPTS-FILE, versions 1 to WS-LAST-VER of the prompt get PRM-ACTIVE =
               *>         "Y" for WS-PICKED and "N" for the others (committed). WS-TEXT = the picked
               *>         version's text; WS-ACTIVE-VER = WS-PICKED. Unless WS-CUR-TOPIC = "*MAIN"
               *>         (or the topic is missing from TOPICS-FILE), TOP-PROMPT of the topic = the
               *>         first 1000 characters of that text (rewritten and committed). So the new
               *>         version becomes the active prompt.

               CALL    "PC-ACTIVATE"
               SET     WS-FMT                    TO    T-SAVED-AS
           ELSE
               IF    WS-SAVE-VER = WS-ACTIVE-VER
                   SET     WS-PICKED             TO    WS-SAVE-VER

                   *> PC-ACTIVATE: makes version WS-PICKED of WS-CUR-TOPIC's prompt the active one
                   *> and, for a topic, copies its text to the topic's prompt, which the chat reads.
                   *> Called here because the edited version is the active one (WS-SAVE-VER =
                   *> WS-ACTIVE-VER).
                   *> Uses:   WS-PICKED (the version to activate), WS-LAST-VER (how many versions to
                   *>         walk), WS-CUR-TOPIC, PROMPTS-FILE and TOPICS-FILE (each created empty
                   *>         when missing). Here WS-PICKED = WS-SAVE-VER, the edited version (set
                   *>         just above).
                   *> Result: in PROMPTS-FILE, versions 1 to WS-LAST-VER of the prompt get
                   *>         PRM-ACTIVE = "Y" for WS-PICKED and "N" for the others (committed).
                   *>         WS-TEXT = the picked version's text; WS-ACTIVE-VER = WS-PICKED. Unless
                   *>         WS-CUR-TOPIC = "*MAIN" (or the topic is missing from TOPICS-FILE),
                   *>         TOP-PROMPT of the topic = the first 1000 characters of that text
                   *>         (rewritten and committed). So the topic's prompt follows the edit.

                   CALL    "PC-ACTIVATE"
               END-IF
               SET     WS-FMT                    TO    T-SAVED-V
           END-IF
           SET     WS-ARG1                       TO    WS-VNUM

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-SAVED-AS ("Saved as v&1, now active.") for a new version, or
           *>         T-SAVED-V ("v&1 saved.") for an edited one, in the current language; WS-ARG1 =
           *>         WS-VNUM, the version number saved.
           *> Result: WS-FMT-OUT = that message, shown on Lbl-Status just below. Nothing else
           *>         changes.

           CALL    "PC-FMT"

           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()
           SET     WS-EDIT-VER                   TO    0

           *> PC-LOAD-VERSIONS: fills the versions grid Dg-List with the prompt versions of
           *> WS-CUR-TOPIC, newest first, the active one marked; a prompt with no version yet gets
           *> version 1, active, written to the file. Called here after the version was written, so
           *> none is created.
           *> Uses:   WS-CUR-TOPIC, PROMPTS-FILE (<WS-DATA-DIR>/prompt-versions.idx =
           *>         WS-PROMPTS-PATH; created empty when missing) and T-ACTIVE-MARK (the "[active]"
           *>         text).
           *> Result: Dg-List is emptied and gets one row per version (up to 200): number, created
           *>         date and time, "[active]" marker, the first 57 characters of the text ("..."
           *>         when longer) and the promote, edit and delete icons. WS-VER-COUNT = rows;
           *>         WS-VER(n) = version of row n; WS-LAST-VER = highest version; WS-ACTIVE-VER =
           *>         the version flagged active. The new or edited version shows, and "[active]"
           *>         sits on the active one.

           CALL    "PC-LOAD-VERSIONS"
           SET     Tab-Crud::SelectedTab         TO    1
]]></Event>
    <Event name="PC-DELETE" paragraph="PC-DELETE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-PICKED in, already confirmed: that version leaves the history.
           *>   The active version is refused before the question is asked.

           SET     WS-VNUM                       TO    WS-PICKED
           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF

           SET     PRM-TOPIC                     TO    WS-CUR-TOPIC
           SET     PRM-VERSION                   TO    WS-PICKED
           SET     WS-SAVE-OK                    TO    "Y"

           DELETE    PROMPTS-FILE RECORD
               INVALID KEY MOVE "N" TO WS-SAVE-OK
               SET     WS-FS-ERR                 TO    WS-FS
           END-DELETE
           IF    WS-SAVE-OK = "Y"
               COMMIT
           ELSE
               ROLLBACK
           END-IF
           CLOSE    PROMPTS-FILE
           IF    WS-SAVE-OK = "Y"
               SET     WS-FMT                    TO    T-DELETED
           ELSE
               SET     WS-FMT                    TO    T-DELETE-FAILED
               SET     WS-ARG2                   TO    WS-FS-ERR
           END-IF
           SET     WS-ARG1                       TO    WS-VNUM

           *> PC-FMT: builds a message: each "&1" to "&4" in the template WS-FMT is replaced by
           *> WS-ARG1 to WS-ARG4 (trimmed).
           *> Uses:   WS-FMT = T-DELETED ("v&1 deleted.") when the delete worked, else
           *>         T-DELETE-FAILED ("Could not delete v&1 (file status &2)."), in the current
           *>         language; WS-ARG1 = WS-VNUM (the version, WS-PICKED); WS-ARG2 = WS-FS-ERR, set
           *>         only on a failure.
           *> Result: WS-FMT-OUT = that message, shown on Lbl-Status just below. Nothing else
           *>         changes.

           CALL    "PC-FMT"
           SET     Lbl-Status::Caption           TO    WS-FMT-OUT::Trim()

           *> PC-LOAD-VERSIONS: fills the versions grid Dg-List with the prompt versions of
           *> WS-CUR-TOPIC, newest first, the active one marked; a prompt with no version yet gets
           *> version 1, active, written to the file. Called here after the delete was tried (also
           *> when it failed).
           *> Uses:   WS-CUR-TOPIC, PROMPTS-FILE (<WS-DATA-DIR>/prompt-versions.idx =
           *>         WS-PROMPTS-PATH; created empty when missing) and T-ACTIVE-MARK (the "[active]"
           *>         text).
           *> Result: Dg-List is emptied and gets one row per version (up to 200): number, created
           *>         date and time, "[active]" marker, the first 57 characters of the text ("..."
           *>         when longer) and the promote, edit and delete icons. WS-VER-COUNT = rows;
           *>         WS-VER(n) = version of row n; WS-LAST-VER = highest version; WS-ACTIVE-VER =
           *>         the version flagged active. The version no longer shows unless the delete
           *>         failed.

           CALL    "PC-LOAD-VERSIONS"
]]></Event>
    <Event name="PC-MIGRATE" paragraph="PC-MIGRATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The versions moved to prompt-versions.idx (1.70.332), where a text
           *>   holds 32,000 characters for the main prompt: while the new file is
           *>   empty, every version of the old prompts.idx is copied over. The old
           *>   file is only read, and left as it was.

           OPEN    I-O PROMPTS-FILE
           IF    WS-FS = "35"
               OPEN    OUTPUT PROMPTS-FILE
               CLOSE    PROMPTS-FILE
               OPEN    I-O PROMPTS-FILE
           END-IF

           *> Lowest possible key: START finds no record from here only when the
           *> new file is empty, the one time the old file is copied over.

           SET     PRM-TOPIC                     TO    SPACES
           SET     PRM-VERSION                   TO    0
           SET     WS-EMPTY                      TO    "N"

           START    PROMPTS-FILE KEY IS >= PRM-KEY
               INVALID KEY MOVE "Y" TO WS-EMPTY
           END-START
           IF    WS-EMPTY = "Y"
               OPEN    INPUT OLDPRM-FILE
               IF    WS-FS = "00"
                   SET     WS-EOF                TO    "N"
                   PERFORM    UNTIL WS-EOF = "Y"
                       READ    OLDPRM-FILE NEXT RECORD
                           AT END MOVE "Y" TO WS-EOF
                           NOT AT END
                               SET     PRM-TOPIC TO    OLD-TOPIC
                               SET     PRM-VERSION
                                                 TO    OLD-VERSION

                               SET     PRM-CREATED
                                                 TO    OLD-CREATED

                               SET     PRM-ACTIVE
                                                 TO    OLD-ACTIVE

                               SET     PRM-TEXT  TO    OLD-TEXT
                               WRITE    PROMPT-REC
                                   INVALID KEY CONTINUE
                               END-WRITE
                       END-READ
                   END-PERFORM
                   CLOSE    OLDPRM-FILE
                   COMMIT
               END-IF
           END-IF
           CLOSE    PROMPTS-FILE
           SET     WS-EOF                        TO    "N"
]]></Event>
    <Event name="PC-MAIN-DEFAULT" paragraph="PC-MAIN-DEFAULT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   WS-TEXT out: the main prompt as shipped - samples/main-prompt.md,
           *>   each line's indentation kept.

           SET     WS-TEXT                       TO    SPACES
           SET     WS-SX-B                       TO    1

           OPEN    INPUT MPSEED-FILE
           IF    WS-FS NOT = "00"
               EXIT PROGRAM
           END-IF
           SET     WS-EOF                        TO    "N"
           PERFORM    UNTIL WS-EOF = "Y"
               READ    MPSEED-FILE
                   AT END MOVE "Y" TO WS-EOF
                   NOT AT END
                       SET     WS-LN-BUF         TO    MPSEED-REC
                       *> The line's real length, trailing blanks off but indentation kept (TRIM
                       *> would strip it): leading blanks of the reversed line, out of 1000.

                       SET     WS-LN-REV         TO    FUNCTION REVERSE(WS-LN-BUF)
                       SET     WS-LN-LEN         TO    0

                       INSPECT    WS-LN-REV TALLYING WS-LN-LEN FOR LEADING SPACES
                       COMPUTE    WS-LN-LEN = 1000 - WS-LN-LEN
                       *> A blank line has nothing to copy (a zero-length piece is not valid),
                       *> only its line break.

                       IF    WS-LN-LEN > 0
                           STRING    WS-LN-BUF(1:WS-LN-LEN) X"0A" INTO WS-TEXT WITH POINTER WS-SX-B
                           END-STRING
                       ELSE
                           STRING    X"0A" INTO WS-TEXT
                               WITH POINTER WS-SX-B
                           END-STRING
                       END-IF
               END-READ
           END-PERFORM
           CLOSE    MPSEED-FILE
           SET     WS-EOF                        TO    "N"
]]></Event>
    <Event name="PC-LANG-NOW" paragraph="PC-LANG-NOW"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   The language saved now (LANG), into WS-LANG-NOW; "en" when unset.

           SET     WS-LANG-NOW                   TO    "en"
           OPEN    INPUT SETTINGS-FILE
           IF    WS-FS NOT = "00"
               EXIT PROGRAM
           END-IF
           SET     SET-NAME                      TO    "LANG"
           READ    SETTINGS-FILE
               INVALID KEY CONTINUE
               NOT INVALID KEY
                   EVALUATE    SET-VALUE(1:2)
                       WHEN "pt" WHEN "es" WHEN "fr" WHEN "jp" WHEN "cn"
                           SET     WS-LANG-NOW   TO    SET-VALUE(1:2)
                   END-EVALUATE
           END-READ
           CLOSE    SETTINGS-FILE
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="PROMPTS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PC-OPEN: prepares the prompt screen: the data file paths, the old prompt file
           *> migrated, the texts in the user's language, then the prompt for the chosen scope.
           *> Uses:   WS-SCOPE ("M" = the main prompt, "T" = the open topic's), the CUR-TOPIC and
           *>         LANG settings, PROMPTS-FILE and the old prompts.idx (migration) and, in scope
           *>         "T", TOPICS-FILE.
           *> Result: paths, migration and texts as their procedures leave them. Scope "M":
           *>         WS-CUR-TOPIC = "*MAIN", the main-prompt title and hint are set, Btn-Default is
           *>         shown, the versions grid is loaded and Tab-Crud::SelectedTab = 1. Scope "T":
           *>         Btn-Default is hidden and WS-CUR-TOPIC = the CUR-TOPIC setting. With no topic
           *>         open Lbl-Status::Caption = the "open a topic first" text and the grid is left
           *>         as it was; otherwise Lbl-Title::Caption = "Prompt - <topic name>" ("?" when
           *>         the topic record is missing), the grid is loaded and Tab-Crud::SelectedTab =
           *>         1.

           CALL    "PC-OPEN"
]]></Event>
    <Event name="onActivate" paragraph="PROMPTS-FORM--ONACTIVATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *>   Back on the pane: the topic or the language may have changed.

           *> PC-OPEN: prepares the prompt screen again, now that the form is back on the pane (the
           *> open topic or the language may have changed meanwhile): paths, texts, then the prompt
           *> for the chosen scope.
           *> Uses:   WS-SCOPE ("M" = the main prompt, "T" = the open topic's), the CUR-TOPIC and
           *>         LANG settings, PROMPTS-FILE and the old prompts.idx (migration) and, in scope
           *>         "T", TOPICS-FILE.
           *> Result: paths, migration and texts as their procedures leave them. Scope "M":
           *>         WS-CUR-TOPIC = "*MAIN", the main-prompt title and hint are set, Btn-Default is
           *>         shown, the versions grid is loaded and Tab-Crud::SelectedTab = 1. Scope "T":
           *>         Btn-Default is hidden and WS-CUR-TOPIC = the CUR-TOPIC setting. With no topic
           *>         open Lbl-Status::Caption = the "open a topic first" text and the grid is left
           *>         as it was; otherwise Lbl-Title::Caption = "Prompt - <topic name>" ("?" when
           *>         the topic record is missing), the grid is loaded and Tab-Crud::SelectedTab =
           *>         1.

           CALL    "PC-OPEN"
]]></Event>
    <Event name="onClose" paragraph="PROMPTS-FORM--ONCLOSE">
    </Event>
  </form-events>
  <Control id="Lbl-Title" type="Label" x="24" y="16" w="632" h="32" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Prompt</Property>
    <Property name="FontSize">20</Property>
    <Property name="Bold">true</Property>
