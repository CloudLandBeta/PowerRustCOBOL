<?xml version="1.0" encoding="UTF-8"?>
<Form name="APROVACAO-FORM" title="Envio e aprovação" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Quote delivery and approval screen: the consultant sends a quote to the customer by email and WhatsApp (simulated), the customer approves or refuses with the quote number and the short code, and the consultant can register the decision made by phone, WhatsApp or at the counter, through the Backend programs QUOTE-SEND, QUOTE-VIEW, QUOTE-APPROVE and QUOTE-EXPIRE." index-base="1" responsive="true">
  <user-procedures>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(160).
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 QSN-REQ                             GLOBAL.
          05 QSN-ID                              PIC    9(8).
          05 QSN-OPERATOR                        PIC    X(30).
          05 QSN-DOWN-EMAIL                      PIC    X(1).
          05 QSN-DOWN-WA                         PIC    X(1).
       01 QSN-RES                             GLOBAL.
          05 QNS-STATUS                          PIC    X(10).
          05 QNS-MESSAGE                         PIC    X(80).
          05 QNS-ID                              PIC    9(8).
          05 QNS-REV                             PIC    9(2).
          05 QNS-EMAIL                           PIC    X(8).
          05 QNS-EMAIL-TRIES                     PIC    9.
          05 QNS-WA                              PIC    X(8).
          05 QNS-WA-TRIES                        PIC    9.
          05 QNS-TOKEN                           PIC    X(32).
          05 QNS-CODE                            PIC    X(6).
          05 QNS-EXPIRES                         PIC    9(14).
          05 QNS-TEXT                            PIC    X(200).
       01 QVW-REQ                             GLOBAL.
          05 QVW-TOKEN                           PIC    X(32).
          05 QVW-QUO-ID                          PIC    9(8).
          05 QVW-CODE                            PIC    X(6).
       01 QUO-RES                             GLOBAL.
          05 QTS-STATUS                          PIC    X(10).
          05 QTS-MESSAGE                         PIC    X(80).
          05 QTS-FIELD                           PIC    X(10).
          05 QTS-LINE-NO                         PIC    9(3).
          05 QTS-ACTION                          PIC    X(12).
          05 QTS-ID                              PIC    9(8).
          05 QTS-REV                             PIC    9(2).
          05 QTS-CUS-ID                          PIC    9(8).
          05 QTS-PLATE                           PIC    X(8).
          05 QTS-DGN-ID                          PIC    9(8).
          05 QTS-CURRENCY                        PIC    X(3).
          05 QTS-QSTATUS                         PIC    X(10).
          05 QTS-CREATED                         PIC    9(14).
          05 QTS-VALID-UNTIL                     PIC    9(8).
          05 QTS-DEADLINE                        PIC    9(8).
          05 QTS-SUGGESTED                       PIC    9(8).
          05 QTS-HOURS                           PIC    9(4)V99.
          05 QTS-SUBTOTAL                        PIC    9(9)V99.
          05 QTS-TAX                             PIC    9(9)V99.
          05 QTS-TOTAL                           PIC    9(9)V99.
          05 QTS-OPERATOR                        PIC    X(30).
          05 QTS-COUNT                           PIC    9(3).
          05 QTS-LINE                            OCCURS 20.
             10 QTL-KIND                         PIC    X(1).
             10 QTL-CODE                         PIC    X(12).
             10 QTL-NAME                         PIC    X(40).
             10 QTL-QTY                          PIC    9(4)V99.
             10 QTL-UNIT                         PIC    9(7)V99.
             10 QTL-TAX-RATE                     PIC    9(2)V99.
             10 QTL-AMOUNT                       PIC    9(9)V99.
             10 QTL-TAX                          PIC    9(9)V99.
             10 QTL-MANUAL                       PIC    X(1).
             10 QTL-NOTE                         PIC    X(60).
       01 QAP-REQ                             GLOBAL.
          05 QAP-MODE                            PIC    X(1).
          05 QAP-TOKEN                           PIC    X(32).
          05 QAP-QUO-ID                          PIC    9(8).
          05 QAP-CODE                            PIC    X(6).
          05 QAP-CHANNEL                         PIC    X(10).
          05 QAP-DECISION                        PIC    X(1).
          05 QAP-REASON                          PIC    X(80).
          05 QAP-OPERATOR                        PIC    X(30).
       01 QAP-RES                             GLOBAL.
          05 QAS-STATUS                          PIC    X(10).
          05 QAS-MESSAGE                         PIC    X(80).
          05 QAS-FIELD                           PIC    X(10).
          05 QAS-QUO-ID                          PIC    9(8).
          05 QAS-REV                             PIC    9(2).
          05 QAS-QSTATUS                         PIC    X(10).
          05 QAS-AT                              PIC    9(14).
          05 QAS-CHANNEL                         PIC    X(10).
       01 QEX-REQ                             GLOBAL.
          05 QEX-OPERATOR                        PIC    X(30).
       01 QEX-RES                             GLOBAL.
          05 QEY-STATUS                          PIC    X(10).
          05 QEY-COUNT                           PIC    9(4).
]]></working-storage>
  <form-events>
    <Event name="onLoad" paragraph="APROVACAO-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QEX-REQ
           SET     QEX-OPERATOR                  TO    "sistema"

           *> QUOTE-EXPIRE: marks as EXPIRADO the quotes still open or sent whose validity has passed.
           *> Uses:   QEX-OPERATOR = "sistema" (the audit trail records who ran it).
           *> Result: QEY-COUNT quotes changed; nothing else on this screen depends on it.
           CALL    "QUOTE-EXPIRE" WITH WEBSOCKET LINKAGE
               USING BY VALUE QEX-REQ
               RETURNING QEX-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QEY-STATUS            TO    "CALL"
           END-CALL
]]></Event>
  </form-events>
