<Control id="BTN-MAPPROVE" type="Button" x="690" y="632" w="210" h="46" tab-order="39" z-order="39" visible="true" enabled="true" parent="CARD-MAN">
    <Property name="Caption">Registrar aprovação</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Registers that the customer approved the quote by the chosen channel.</Property>
    <Event name="onClick" paragraph="BTN-MAPPROVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QAP-REQ
           SET     QAP-MODE                      TO    "M"
           COMPUTE QAP-QUO-ID                    =     FUNCTION NUMVAL ( TXT-QUO::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           SET     QAP-DECISION                  TO    "A"
           SET     QAP-REASON                    TO    TXT-MREASON::Text
           SET     QAP-OPERATOR                  TO    TXT-OPERATOR::Text
           EVALUATE    TRUE
               WHEN  RDO-WA::Selected = 1
                   SET     QAP-CHANNEL           TO    "WHATSAPP"
               WHEN  RDO-COUNTER::Selected = 1
                   SET     QAP-CHANNEL           TO    "COUNTER"
               WHEN  OTHER
                   SET     QAP-CHANNEL           TO    "PHONE"
           END-EVALUATE
           SET     QAS-STATUS                    TO    SPACES

           *> QUOTE-APPROVE (manual): the consultant registers the decision the customer gave by phone, WhatsApp or at the counter.
           *> Uses:   QAP-MODE = "M"; QAP-QUO-ID = TXT-QUO; QAP-DECISION = A or R; QAP-CHANNEL = the chosen radio; QAP-OPERATOR = TXT-OPERATOR.
           *> Result: QAS-STATUS = OK or INVALID; the quote becomes APROVADO or RECUSADO and the decision is written with channel and operator.
           CALL    "QUOTE-APPROVE" WITH WEBSOCKET LINKAGE
               USING BY VALUE QAP-REQ
               RETURNING QAP-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QAS-STATUS            TO    "CALL"
           END-CALL

           IF    QAS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    QAS-MESSAGE
           END-IF
]]></Event>
  </Control>
