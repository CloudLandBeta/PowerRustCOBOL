<Control id="BTN-APPROVE" type="Button" x="624" y="350" w="250" h="46" tab-order="28" z-order="28" visible="true" enabled="true" parent="CARD-CUST">
    <Property name="Caption">Aprovar orçamento</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">The customer approves the quote with the number and the code.</Property>
    <Event name="onClick" paragraph="BTN-APPROVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QAP-REQ
           SET     QAP-MODE                      TO    "L"
           COMPUTE QAP-QUO-ID                    =     FUNCTION NUMVAL ( TXT-CQUO::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           SET     QAP-CODE                      TO    TXT-CODE::Text
           SET     QAP-DECISION                  TO    "A"
           SET     QAP-REASON                    TO    TXT-REASON::Text
           SET     QAS-STATUS                    TO    SPACES

           *> QUOTE-APPROVE (link): the customer decides with the quote number and the short code; the code works only once.
           *> Uses:   QAP-MODE = "L"; QAP-QUO-ID = TXT-CQUO; QAP-CODE = TXT-CODE; QAP-DECISION = A or R; QAP-REASON = TXT-REASON.
           *> Result: QAS-STATUS = OK, BADCODE, USED, EXPIRED or INVALID; with OK the quote becomes APROVADO or RECUSADO.
           CALL    "QUOTE-APPROVE" WITH WEBSOCKET LINKAGE
               USING BY VALUE QAP-REQ
               RETURNING QAP-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QAS-STATUS            TO    "CALL"
           END-CALL

           IF    QAS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    QAS-MESSAGE
           END-IF
]]></Event>
  </Control>
