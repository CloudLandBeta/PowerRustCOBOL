<Control id="BTN-SEND" type="Button" x="56" y="288" w="260" h="44" tab-order="12" z-order="12" visible="true" enabled="true" parent="CARD-SEND">
    <Property name="Caption">Enviar por email e WhatsApp</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Sends the quote to the customer through the simulated email and WhatsApp channels.</Property>
    <Event name="onClick" paragraph="BTN-SEND--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QSN-REQ
           COMPUTE QSN-ID                        =     FUNCTION NUMVAL ( TXT-QUO::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           SET     QSN-OPERATOR                  TO    TXT-OPERATOR::Text
           SET     QSN-DOWN-EMAIL                TO    "N"
           SET     QSN-DOWN-WA                   TO    "N"
           IF    CHK-NOEMAIL::Checked = 1
               SET     QSN-DOWN-EMAIL            TO    "S"
           END-IF
           IF    CHK-NOWA::Checked = 1
               SET     QSN-DOWN-WA               TO    "S"
           END-IF
           SET     QNS-STATUS                    TO    SPACES

           *> QUOTE-SEND: sends the quote to the customer by email and WhatsApp (simulated), only to the channels with consent.
           *> Uses:   QSN-ID = TXT-QUO; QSN-OPERATOR = TXT-OPERATOR; QSN-DOWN-EMAIL / QSN-DOWN-WA = the two ticks (S forces a failure).
           *> Result: QNS-STATUS = OK, NOTFOUND, INVALID...; QNS-EMAIL and QNS-WA say SENT, FAILED or SKIPPED; the quote becomes
           *>         ENVIADO when one channel delivered; QNS-CODE is the short code the customer types, QNS-TEXT the message sent.
           CALL    "QUOTE-SEND" WITH WEBSOCKET LINKAGE
               USING BY VALUE QSN-REQ
               RETURNING QSN-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QNS-STATUS            TO    "CALL"
           END-CALL

           IF    QNS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    QNS-MESSAGE
               SET     LBL-R-EMAIL::Caption      TO    "-"
               STRING    "Email: " QNS-EMAIL " (tentativas " QNS-EMAIL-TRIES ")"  INTO  LBL-R-EMAIL::Caption
               SET     LBL-R-WA::Caption         TO    "-"
               STRING    "WhatsApp: " QNS-WA " (tentativas " QNS-WA-TRIES ")"  INTO  LBL-R-WA::Caption
               SET     LBL-R-CODE::Caption       TO    "-"
               STRING    "Código do cliente: " QNS-CODE  INTO  LBL-R-CODE::Caption
               SET     LST-MSG::Text             TO    QNS-TEXT
           END-IF
]]></Event>
  </Control>
