<Control id="BTN-VIEW" type="Button" x="964" y="194" w="172" h="42" tab-order="24" z-order="24" visible="true" enabled="true" parent="CARD-CUST">
    <Property name="Caption">Ver orçamento</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Opens the quote for the customer with the number and the code.</Property>
    <Event name="onClick" paragraph="BTN-VIEW--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QVW-REQ
           COMPUTE QVW-QUO-ID                    =     FUNCTION NUMVAL ( TXT-CQUO::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           SET     QVW-CODE                      TO    TXT-CODE::Text
           SET     QTS-STATUS                    TO    SPACES

           *> QUOTE-VIEW: shows the customer the quote that the number and the code open; it does not use up the code.
           *> Uses:   QVW-QUO-ID = TXT-CQUO; QVW-CODE = TXT-CODE.
           *> Result: QTS-STATUS = OK, NOTFOUND, BADCODE, USED, REPLACED or EXPIRED; with OK the summary shows total and validity.
           CALL    "QUOTE-VIEW" WITH WEBSOCKET LINKAGE
               USING BY VALUE QVW-REQ
               RETURNING QUO-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QTS-STATUS            TO    "CALL"
           END-CALL

           SET     LBL-C-SUM::Caption            TO    "-"
           IF    QTS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    QTS-MESSAGE
               IF    QTS-STATUS = "OK"
                   SET     WS-ED-AMT             TO    QTS-TOTAL
                   STRING    "Orçamento " QTS-ID " - " QTS-PLATE " - total " QTS-CURRENCY " " WS-ED-AMT  INTO  LBL-C-SUM::Caption
               END-IF
           END-IF
]]></Event>
  </Control>
