       01 WS-LABEL                               GLOBAL    PIC X(12).
       01 WS-ED-INT                              GLOBAL    PIC Z(5)9.
       01 WS-ED-APR                              GLOBAL    PIC Z(3)9.
       01 WS-ED-RATE                             GLOBAL    PIC ZZ9.9.
       01 WS-ED-QTY                              GLOBAL    PIC Z(5)9.99.
       01 WS-KIND-PT                             GLOBAL    PIC X(8).
       01 DSH-REQ                             GLOBAL.
          05 DSQ-CURRENCY                        PIC    X(3).
          05 DSQ-ASOF                            PIC    9(8).
       01 DSH-RES                             GLOBAL.
          05 DSS-STATUS                          PIC    X(10).
          05 DSS-MESSAGE                         PIC    X(80).
          05 DSS-CURRENCY                        PIC    X(3).
          05 DSS-VEHICLES                        PIC    9(4).
          05 DSS-AWAITING                        PIC    9(4).
          05 DSS-RUNNING                         PIC    9(4).
          05 DSS-READY                           PIC    9(4).
          05 DSS-SENT                            PIC    9(4).
          05 DSS-APPROVED                        PIC    9(4).
          05 DSS-RATE                            PIC    9(3)V9.
          05 DSS-APPROVED-TOTAL                  PIC    9(11)V99.
          05 DSS-TICKET                          PIC    9(9)V99.
          05 DSS-MONTH                           OCCURS 6.
             10 DSM-YM                           PIC    9(6).
             10 DSM-SENT                         PIC    9(4).
             10 DSM-APPROVED                     PIC    9(4).
          05 DSS-TOP-COUNT                       PIC    9(2).
          05 DSS-TOP                             OCCURS 5.
             10 DST-CODE                         PIC    X(12).
             10 DST-NAME                         PIC    X(40).
             10 DST-QTY                          PIC    9(6)V99.
          05 DSS-PAY-CASH                        PIC    9(4).
          05 DSS-PAY-INST                        PIC    9(4).
          05 DSS-PAY-REFUNDED                    PIC    9(4).
          05 DSS-APR-LINK                        PIC    9(4).
          05 DSS-APR-MANUAL                      PIC    9(4).
          05 DSS-FAILED                          PIC    9(4).
          05 DSS-GAVE-UP                         PIC    9(4).
          05 DSS-DL-COUNT                        PIC    9(2).
          05 DSS-DL                              OCCURS 8.
             10 DDL-DATE                         PIC    9(8).
             10 DDL-QUO                          PIC    9(8).
             10 DDL-PLATE                        PIC    X(8).
             10 DDL-KIND                         PIC    X(1).
       01 WS-3D-READY                            GLOBAL    PIC 9        VALUE 0.
       01 WS-ROOT-TOP                            GLOBAL    PIC 9(10)    VALUE 0.
       01 WS-ROOT-DL                             GLOBAL    PIC 9(10)    VALUE 0.
       01 WS-NODE                                GLOBAL    PIC 9(10).
       01 WS-FLOOR-TOP                           GLOBAL    PIC 9(10).
       01 WS-FLOOR-DL                            GLOBAL    PIC 9(10).
       01 WS-CAM-TOP                             GLOBAL    PIC 9(10).
       01 WS-CAM-DL                              GLOBAL    PIC 9(10).
       01 WS-LIGHT-TOP                           GLOBAL    PIC 9(10).
       01 WS-LIGHT-DL                            GLOBAL    PIC 9(10).
       01 WS-MAX-QTY                             GLOBAL    PIC 9(6)V99.
       01 WS-MAX-COUNT                           GLOBAL    PIC 99.
       01 WS-ED-COUNT                            GLOBAL    PIC Z9.
       01 WS-BAR-H                               GLOBAL    PIC 9(3)V99.
       01 WS-BAR-Y                               GLOBAL    PIC 9(3)V99.
       01 WS-BAR-X                               GLOBAL    PIC S9(3)V99.
       01 WS-BAR-POS                             GLOBAL    PIC S9(3)V99.
       01 WS-J                                   GLOBAL    PIC 999.
       01 WS-K                                   GLOBAL    PIC 999.
       01 WS-LINE-2                              GLOBAL    PIC X(160).
       01 WS-DATE-ROWS                           GLOBAL.
          05 WS-DR-COUNT                         PIC    9.
          05 WS-DR                               OCCURS 5.
             10 WS-DR-DATE                       PIC    9(8).
             10 WS-DR-DELIVERIES                 PIC    99.
             10 WS-DR-PICKUPS                    PIC    99.
]]></working-storage>
