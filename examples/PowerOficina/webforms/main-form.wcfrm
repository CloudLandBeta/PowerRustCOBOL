  <user-procedures>
    <Event name="LOAD-DASH" paragraph="LOAD-DASH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    DSH-REQ
           SET     DSQ-CURRENCY                  TO    "BRL"
           IF    RDO-EUR::Selected = 1
               SET     DSQ-CURRENCY              TO    "EUR"
           END-IF
           SET     DSS-STATUS                    TO    SPACES

           *> DASH-SUMMARY: every figure of the dashboard for one currency, never mixed with the other.
           *> Uses:   DSQ-CURRENCY = BRL or EUR from the two radio buttons; DSQ-ASOF = 0 (today).
           *> Result: DSS-... hold the indicators, the six months, the five top items, the payments, the channels, the failed
           *>         installments and the next dates; SHOW-DASH puts them on the screen and hides what has no data.
           CALL    "DASH-SUMMARY" WITH WEBSOCKET LINKAGE
               USING BY VALUE DSH-REQ
               RETURNING DSH-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     DSS-STATUS            TO    "CALL"
           END-CALL

           IF    DSS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               IF    DSS-STATUS = "OK"
                   *> SHOW-DASH: puts the indicators on the screen.
                   *> Uses:   DSS-... counters, rate, ticket and total.
                   *> Result: the cards and the total line are filled; what has no data says so.
                   CALL    "SHOW-DASH"
               ELSE
                   SET     LBL-STATUS::Caption   TO    DSS-MESSAGE
               END-IF
           END-IF
]]></Event>
    <Event name="SHOW-DASH" paragraph="SHOW-DASH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     LBL-STATUS::Caption           TO    "-"
           STRING    "Valores em " DSS-CURRENCY ". Atualiza a cada 15 segundos."  INTO  LBL-STATUS::Caption

           SET     WS-ED-INT                     TO    DSS-VEHICLES
           SET     VAL-VEH::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-AWAITING
           SET     VAL-AWA::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-RUNNING
           SET     VAL-RUN::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-READY
           SET     VAL-RDY::Caption              TO    WS-ED-INT::Trim()

           SET     VAL-RAT::Caption              TO    "sem dados"
           SET     VAL-TIC::Caption              TO    "sem dados"
           SET     LBL-TOTAL::Caption            TO    "Nenhum orçamento aprovado ainda."
           IF    DSS-SENT > 0
               SET     WS-ED-RATE                TO    DSS-RATE
               SET     VAL-RAT::Caption          TO    "-"
               STRING    WS-ED-RATE::Trim() " %"  INTO  VAL-RAT::Caption
           END-IF
           IF    DSS-APPROVED > 0
               SET     WS-ED-AMT                 TO    DSS-TICKET
               SET     VAL-TIC::Caption          TO    "-"
               STRING    DSS-CURRENCY " " WS-ED-AMT::Trim()  INTO  VAL-TIC::Caption
               SET     WS-ED-AMT                 TO    DSS-APPROVED-TOTAL
               SET     WS-ED-INT                 TO    DSS-SENT
               SET     WS-ED-APR                 TO    DSS-APPROVED
               SET     WS-LINE                   TO    SPACES
               STRING    "Total aprovado: " DSS-CURRENCY " " WS-ED-AMT::Trim() "   (" WS-ED-APR::Trim() " aprovados de " WS-ED-INT::Trim()
                         " enviados)"  INTO  WS-LINE
               SET     LBL-TOTAL::Caption        TO    WS-LINE
           END-IF

           *> SHOW-CHARTS: draws the two charts.
           *> Uses:   DSM-... months and the payment counters of the answer.
           *> Result: CH-MONTHS and CH-PAYS are filled, or their empty notice is shown.
           CALL    "SHOW-CHARTS"
           *> SHOW-LISTS: fills the lists and the alert.
           *> Uses:   DST-... top items, DDL-... dates, the channel and failed-installment counters.
           *> Result: DG-TOP, DG-DL, LBL-CH and LBL-ALERT are filled.
           CALL    "SHOW-LISTS"
]]></Event>
    <Event name="PAINT-LEGEND" paragraph="PAINT-LEGEND"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-ON-M1 = 1
               SET     BTN-LEG-M1::BackgroundColor    TO    "#D9DBF9"
               SET     BTN-LEG-M1::ForegroundColor    TO    "#0F172AFF"
           ELSE
               SET     BTN-LEG-M1::BackgroundColor    TO    "#FFFFFFFF"
               SET     BTN-LEG-M1::ForegroundColor    TO    "#0F172AFF"
           END-IF
           IF    WS-ON-M2 = 1
               SET     BTN-LEG-M2::BackgroundColor    TO    "#5B4FE9"
               SET     BTN-LEG-M2::ForegroundColor    TO    "#FFFFFFFF"
           ELSE
               SET     BTN-LEG-M2::BackgroundColor    TO    "#FFFFFFFF"
               SET     BTN-LEG-M2::ForegroundColor    TO    "#0F172AFF"
           END-IF
           IF    WS-ON-P1 = 1
               SET     BTN-LEG-P1::BackgroundColor    TO    "#5B4FE9"
               SET     BTN-LEG-P1::ForegroundColor    TO    "#FFFFFFFF"
           ELSE
               SET     BTN-LEG-P1::BackgroundColor    TO    "#FFFFFFFF"
               SET     BTN-LEG-P1::ForegroundColor    TO    "#0F172AFF"
           END-IF
           IF    WS-ON-P2 = 1
               SET     BTN-LEG-P2::BackgroundColor    TO    "#A9A3F5"
               SET     BTN-LEG-P2::ForegroundColor    TO    "#0F172AFF"
           ELSE
               SET     BTN-LEG-P2::BackgroundColor    TO    "#FFFFFFFF"
               SET     BTN-LEG-P2::ForegroundColor    TO    "#0F172AFF"
           END-IF
           IF    WS-ON-P3 = 1
               SET     BTN-LEG-P3::BackgroundColor    TO    "#F28B8B"
               SET     BTN-LEG-P3::ForegroundColor    TO    "#0F172AFF"
           ELSE
               SET     BTN-LEG-P3::BackgroundColor    TO    "#FFFFFFFF"
               SET     BTN-LEG-P3::ForegroundColor    TO    "#0F172AFF"
           END-IF

]]></Event>
    <Event name="SHOW-CHARTS" paragraph="SHOW-CHARTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CH-MONTHS::Clear()
           CH-PAYS::Clear()
           SET     LBL-MON-EMPTY::Visible        TO    1
           SET     LBL-PAY-EMPTY::Visible        TO    1

           *> The legend buttons choose what the charts show: only the marked items, or all when none is marked.
           SET     WS-ALL-M                      TO    0
           IF    WS-ON-M1 = 0 AND WS-ON-M2 = 0
               SET     WS-ALL-M                  TO    1
           END-IF

           IF    WS-ALL-M = 1
               SET     CH-MONTHS::SeriesColors   TO    "#D9DBF9,#5B4FE9"
               SET     CH-MONTHS::SeriesLabels   TO    "Enviados,Aprovados"
           ELSE
               IF    WS-ON-M1 = 1 AND WS-ON-M2 = 1
                   SET     CH-MONTHS::SeriesColors TO  "#D9DBF9,#5B4FE9"
                   SET     CH-MONTHS::SeriesLabels TO  "Enviados,Aprovados"
               ELSE
                   IF    WS-ON-M1 = 1
                       SET     CH-MONTHS::SeriesColors TO "#D9DBF9"
                       SET     CH-MONTHS::SeriesLabels TO "Enviados"
                   ELSE
                       SET     CH-MONTHS::SeriesColors TO "#5B4FE9"
                       SET     CH-MONTHS::SeriesLabels TO "Aprovados"
                   END-IF
               END-IF
           END-IF

           IF    DSS-SENT > 0
               SET     LBL-MON-EMPTY::Visible    TO    0
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
                   MOVE    DSM-YM (WS-I)         TO    WS-YM-X
                   SET     WS-LABEL              TO    SPACES
                   STRING    WS-YM-X (5:2) "/" WS-YM-X (1:4)  INTO  WS-LABEL
                   SET     WS-V1                 TO    DSM-SENT (WS-I)
                   SET     WS-V2                 TO    DSM-APPROVED (WS-I)

                   EVALUATE    TRUE
                       WHEN WS-ALL-M = 1 OR (WS-ON-M1 = 1 AND WS-ON-M2 = 1)
                           CH-MONTHS::AddPoint( WS-LABEL, WS-V1, WS-V2 )
                       WHEN WS-ON-M1 = 1
                           CH-MONTHS::AddPoint( WS-LABEL, WS-V1 )
                       WHEN OTHER
                           CH-MONTHS::AddPoint( WS-LABEL, WS-V2 )
                   END-EVALUATE
               END-PERFORM
           END-IF

           *> The payments donut: each slice keeps its own colour whatever is hidden.
           SET     WS-COLORS                     TO    SPACES
           SET     WS-PTR                        TO    1
           SET     WS-ALL-P                      TO    0
           IF    WS-ON-P1 = 0 AND WS-ON-P2 = 0 AND WS-ON-P3 = 0
               SET     WS-ALL-P                  TO    1
           END-IF

           IF    DSS-PAY-CASH + DSS-PAY-INST + DSS-PAY-REFUNDED > 0
               SET     LBL-PAY-EMPTY::Visible    TO    0

               IF    WS-ALL-P = 1 OR WS-ON-P1 = 1
                   CH-PAYS::AddPoint( "À vista", DSS-PAY-CASH )
                   STRING    "#5B4FE9," INTO  WS-COLORS WITH POINTER WS-PTR
               END-IF

               IF    WS-ALL-P = 1 OR WS-ON-P2 = 1
                   CH-PAYS::AddPoint( "Parcelado", DSS-PAY-INST )
                   STRING    "#A9A3F5," INTO  WS-COLORS WITH POINTER WS-PTR
               END-IF

               IF    WS-ALL-P = 1 OR WS-ON-P3 = 1
                   CH-PAYS::AddPoint( "Estornado", DSS-PAY-REFUNDED )
                   STRING    "#F28B8B," INTO  WS-COLORS WITH POINTER WS-PTR
               END-IF

               COMPUTE WS-PTR                    =     WS-PTR - 1
               SET     WS-COLORS (WS-PTR:1)      TO    SPACE
               SET     CH-PAYS::SeriesColors     TO    WS-COLORS::Trim()
           END-IF

           *> PAINT-LEGEND: fills the marked legend buttons with their series colour.
           *> Uses:   WS-ON-M1, WS-ON-M2, WS-ON-P1, WS-ON-P2, WS-ON-P3.
           *> Result: a marked button is filled; an unmarked one is white with a coloured outline.
           CALL    "PAINT-LEGEND"
]]></Event>
    <Event name="SHOW-LISTS" paragraph="SHOW-LISTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> PREPARE-3D: builds the floor, the light and the isometric camera of the two 3D histograms, the first time only.
           *> Uses:   SCN-TOP, SCN-DL, CNV-TOP and CNV-DL.
           *> Result: both canvases show their scene; WS-3D-READY is 1.
           CALL    "PREPARE-3D"

           *> DRAW-TOP: draws one bar per most sold item, as tall as its quantity, and writes the legend under it.
           *> Uses:   DSS-TOP-COUNT and DST-NAME / DST-QTY of the answer.
           *> Result: CNV-TOP shows the bars; LBL-T1 to LBL-T5 and SW-T1 to SW-T5 name them.
           CALL    "DRAW-TOP"

           *> DRAW-DELIVERIES: draws, for each date, one bar of deliveries and one of pickups, and writes the dates under them.
           *> Uses:   DSS-DL-COUNT and DDL-DATE / DDL-KIND of the answer.
           *> Result: CNV-DL shows the bars; LBL-D1 to LBL-D5 give the counts of each date.
           CALL    "DRAW-DELIVERIES"

           SET     WS-ED-INT                     TO    DSS-APR-LINK
           SET     VAL-LNK::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-APR-MANUAL
           SET     VAL-MAN::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-FAILED
           SET     VAL-REF::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-GAVE-UP
           SET     VAL-GUP::Caption              TO    WS-ED-INT::Trim()

           IF    DSS-FAILED > 0
               SET     VAL-REF::ForegroundColor  TO    "#B91C1C"
           ELSE
               SET     VAL-REF::ForegroundColor  TO    "#1E1B4BFF"
           END-IF
           IF    DSS-GAVE-UP > 0
               SET     VAL-GUP::ForegroundColor  TO    "#B91C1C"
           ELSE
               SET     VAL-GUP::ForegroundColor  TO    "#1E1B4BFF"
           END-IF
]]></Event>
    <Event name="PREPARE-3D" paragraph="PREPARE-3D"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-3D-READY = 0
               SET     WS-3D-READY               TO    1

               SCN-TOP::SetBackground( "#FFFFFF00" )
               SCN-TOP::SetAmbient( 1 1 1 0.55 )
               SET     WS-FLOOR-TOP              TO    SCN-TOP::AddPlane( 16 7 )
               SCN-TOP::SetColor( WS-FLOOR-TOP "#E9EDF7" )
               SET     WS-CAM-TOP                TO    SCN-TOP::AddOrthographicCamera( 9 0.1 100 )
               SCN-TOP::SetPosition( WS-CAM-TOP 10 9 10 )
               SCN-TOP::LookAt( WS-CAM-TOP 0 1.6 0 )
               SET     WS-LIGHT-TOP              TO    SCN-TOP::AddDirectionalLight( 1 1 1 1.1 )
               SCN-TOP::SetRotation( WS-LIGHT-TOP, -50, 35, 0 )
               CNV-TOP::SetScene( SCN-TOP::GetHandle() )
               CNV-TOP::SetCamera( WS-CAM-TOP )

               SCN-DL::SetBackground( "#FFFFFF00" )
               SCN-DL::SetAmbient( 1 1 1 0.55 )
               SET     WS-FLOOR-DL               TO    SCN-DL::AddPlane( 16 7 )
               SCN-DL::SetColor( WS-FLOOR-DL "#E9EDF7" )
               SET     WS-CAM-DL                 TO    SCN-DL::AddOrthographicCamera( 9 0.1 100 )
               SCN-DL::SetPosition( WS-CAM-DL 10 9 10 )
               SCN-DL::LookAt( WS-CAM-DL 0 1.6 0 )
               SET     WS-LIGHT-DL               TO    SCN-DL::AddDirectionalLight( 1 1 1 1.1 )
               SCN-DL::SetRotation( WS-LIGHT-DL, -50, 35, 0 )
               CNV-DL::SetScene( SCN-DL::GetHandle() )
               CNV-DL::SetCamera( WS-CAM-DL )
           END-IF
]]></Event>
    <Event name="DRAW-TOP" paragraph="DRAW-TOP"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-ROOT-TOP > 0
               SCN-TOP::Remove( WS-ROOT-TOP )
           END-IF
           SET     WS-ROOT-TOP                   TO    SCN-TOP::AddGroup()
           SET     WS-MAX-QTY                    TO    1
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DSS-TOP-COUNT
               IF    DST-QTY (WS-I) > WS-MAX-QTY
                   SET     WS-MAX-QTY            TO    DST-QTY (WS-I)
               END-IF
           END-PERFORM

           SET     LBL-T1::Caption               TO    SPACES
           SET     SW-T1::Visible                TO    0
           SET     LBL-T2::Caption               TO    SPACES
           SET     SW-T2::Visible                TO    0
           SET     LBL-T3::Caption               TO    SPACES
           SET     SW-T3::Visible                TO    0
           SET     LBL-T4::Caption               TO    SPACES
           SET     SW-T4::Visible                TO    0
           SET     LBL-T5::Caption               TO    SPACES
           SET     SW-T5::Visible                TO    0

           IF    DSS-TOP-COUNT = 0
               SET     LBL-T1::Caption           TO    "Nenhum item vendido ainda."
           END-IF

           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DSS-TOP-COUNT
               COMPUTE WS-BAR-H              =     0.4 + 4 * DST-QTY (WS-I) / WS-MAX-QTY
               COMPUTE WS-BAR-Y              =     WS-BAR-H / 2
               COMPUTE WS-BAR-X              =     1.6 * WS-I - 0.8 * (DSS-TOP-COUNT + 1)
               SET     WS-NODE                   TO    SCN-TOP::AddBox( 1.2 WS-BAR-H 1.2 )
               SCN-TOP::SetParent( WS-NODE WS-ROOT-TOP )
               SCN-TOP::SetPosition( WS-NODE, WS-BAR-X, WS-BAR-Y, 0 )

               SET     WS-ED-QTY                 TO    DST-QTY (WS-I)
               SET     WS-LINE                   TO    SPACES
               STRING    WS-ED-QTY::Trim() "  " DST-NAME (WS-I)  INTO  WS-LINE

               EVALUATE WS-I
                   WHEN 1
                       SCN-TOP::SetColor( WS-NODE "#1E3A8A" )
                       SET     LBL-T1::Caption   TO    WS-LINE::Trim()
                       SET     SW-T1::Visible    TO    1
                   WHEN 2
                       SCN-TOP::SetColor( WS-NODE "#22B8F0" )
                       SET     LBL-T2::Caption   TO    WS-LINE::Trim()
                       SET     SW-T2::Visible    TO    1
                   WHEN 3
                       SCN-TOP::SetColor( WS-NODE "#2EC27E" )
                       SET     LBL-T3::Caption   TO    WS-LINE::Trim()
                       SET     SW-T3::Visible    TO    1
                   WHEN 4
                       SCN-TOP::SetColor( WS-NODE "#FF9F1C" )
                       SET     LBL-T4::Caption   TO    WS-LINE::Trim()
                       SET     SW-T4::Visible    TO    1
                   WHEN 5
                       SCN-TOP::SetColor( WS-NODE "#F43F7A" )
                       SET     LBL-T5::Caption   TO    WS-LINE::Trim()
                       SET     SW-T5::Visible    TO    1
               END-EVALUATE
           END-PERFORM

           CNV-TOP::Render()
]]></Event>
    <Event name="DRAW-DELIVERIES" paragraph="DRAW-DELIVERIES"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-ROOT-DL > 0
               SCN-DL::Remove( WS-ROOT-DL )
           END-IF
           SET     WS-ROOT-DL                    TO    SCN-DL::AddGroup()
           MOVE    0                         TO    WS-DR-COUNT
           SET     WS-MAX-COUNT                  TO    1

           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DSS-DL-COUNT
               SET     WS-J                      TO    0
               PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-DR-COUNT
                   IF    DDL-DATE (WS-I) = WS-DR-DATE (WS-K)
                   SET     WS-J                  TO    WS-K
                   END-IF
               END-PERFORM

               IF    WS-J = 0 AND WS-DR-COUNT < 5
                   ADD     1                 TO    WS-DR-COUNT
                   SET     WS-J                  TO    WS-DR-COUNT
                   MOVE    DDL-DATE (WS-I)   TO    WS-DR-DATE (WS-J)
                   MOVE    0                 TO    WS-DR-DELIVERIES (WS-J)
                   MOVE    0                 TO    WS-DR-PICKUPS (WS-J)
               END-IF

               IF    WS-J > 0
                   IF    DDL-KIND (WS-I) = "R"
                       ADD     1             TO    WS-DR-PICKUPS (WS-J)
                   ELSE
                       ADD     1             TO    WS-DR-DELIVERIES (WS-J)
                   END-IF
               END-IF
           END-PERFORM

           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-DR-COUNT
               IF    WS-DR-DELIVERIES (WS-I) > WS-MAX-COUNT
                   SET     WS-MAX-COUNT          TO    WS-DR-DELIVERIES (WS-I)
               END-IF
               IF    WS-DR-PICKUPS (WS-I) > WS-MAX-COUNT
                   SET     WS-MAX-COUNT          TO    WS-DR-PICKUPS (WS-I)
               END-IF
           END-PERFORM

           SET     LBL-D1::Caption               TO    SPACES
           SET     LBL-D2::Caption               TO    SPACES
           SET     LBL-D3::Caption               TO    SPACES
           SET     LBL-D4::Caption               TO    SPACES
           SET     LBL-D5::Caption               TO    SPACES

           IF    DSS-DL-COUNT = 0
               SET     LBL-D1::Caption           TO    "Nenhuma entrega ou retirada marcada."
           END-IF

           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-DR-COUNT
               COMPUTE WS-BAR-X              =     2.6 * WS-I - 1.3 * (WS-DR-COUNT + 1)

               IF    WS-DR-DELIVERIES (WS-I) > 0
                   COMPUTE WS-BAR-H          =     0.4 + 4 * WS-DR-DELIVERIES (WS-I) / WS-MAX-COUNT
                   COMPUTE WS-BAR-Y          =     WS-BAR-H / 2
                   COMPUTE WS-BAR-POS          =     WS-BAR-X - 0.65
                   SET     WS-NODE               TO    SCN-DL::AddBox( 1.1 WS-BAR-H 1.1 )
                   SCN-DL::SetParent( WS-NODE WS-ROOT-DL )
                   SCN-DL::SetPosition( WS-NODE, WS-BAR-POS, WS-BAR-Y, 0 )
                   SCN-DL::SetColor( WS-NODE "#FF9F1C" )
               END-IF

               IF    WS-DR-PICKUPS (WS-I) > 0
                   COMPUTE WS-BAR-H          =     0.4 + 4 * WS-DR-PICKUPS (WS-I) / WS-MAX-COUNT
                   COMPUTE WS-BAR-Y          =     WS-BAR-H / 2
                   COMPUTE WS-BAR-POS          =     WS-BAR-X + 0.65
                   SET     WS-NODE               TO    SCN-DL::AddBox( 1.1 WS-BAR-H 1.1 )
                   SCN-DL::SetParent( WS-NODE WS-ROOT-DL )
                   SCN-DL::SetPosition( WS-NODE, WS-BAR-POS, WS-BAR-Y, 0 )
                   SCN-DL::SetColor( WS-NODE "#22B8F0" )
               END-IF

               MOVE    WS-DR-DATE (WS-I)     TO    WS-DATE-X
               SET     WS-LINE                   TO    SPACES
               SET     WS-ED-COUNT               TO    WS-DR-DELIVERIES (WS-I)
               STRING    WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4) "   Entregas " WS-ED-COUNT::Trim()
                   INTO  WS-LINE
               SET     WS-ED-COUNT               TO    WS-DR-PICKUPS (WS-I)
               SET     WS-LINE-2                 TO    SPACES
               STRING    WS-LINE::Trim() "   Retiradas " WS-ED-COUNT::Trim()  INTO  WS-LINE-2

               EVALUATE WS-I
                   WHEN 1
                       SET     LBL-D1::Caption   TO    WS-LINE-2::Trim()
                   WHEN 2
                       SET     LBL-D2::Caption   TO    WS-LINE-2::Trim()
                   WHEN 3
                       SET     LBL-D3::Caption   TO    WS-LINE-2::Trim()
                   WHEN 4
                       SET     LBL-D4::Caption   TO    WS-LINE-2::Trim()
                   WHEN 5
                       SET     LBL-D5::Caption   TO    WS-LINE-2::Trim()
               END-EVALUATE
           END-PERFORM

           CNV-DL::Render()
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="MAIN-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> DASH-SUMMARY: the dashboard is read when the screen opens as the application home (LOAD-DASH); a timer keeps it current.
           *> Uses:   the currency radio buttons (BRL at first).
           *> Result: indicators, charts and lists are filled; what has no data says so.

           *> LOAD-DASH: reads every figure of the dashboard for the chosen currency.
           *> Uses:   the BRL and EUR radio buttons.
           *> Result: the indicators, charts and lists are filled.
           CALL    "LOAD-DASH"
]]></Event>
    <Event name="onClose" paragraph="MAIN-FORM--ONCLOSE">
    </Event>
  </form-events>
