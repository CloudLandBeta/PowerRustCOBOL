<?xml version="1.0" encoding="UTF-8"?>
<Form name="MAIN-FORM" title="PowerOficina" width="1440" height="900" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" definition="Main form of the PowerOficina workshop application: the single-page shell, with the side navigation rail and the content area where each screen (dashboard, intake, quotes, queue, payments, reports, settings) is loaded. It shows the Dashboard as its own home content." main-form="true" index-base="1" responsive="true">
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(160).
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 WS-I                                   GLOBAL    PIC 999.
       01 WS-ON-M1                               GLOBAL    PIC 9       VALUE 0.
       01 WS-ON-M2                               GLOBAL    PIC 9       VALUE 0.
       01 WS-ON-P1                               GLOBAL    PIC 9       VALUE 0.
       01 WS-ON-P2                               GLOBAL    PIC 9       VALUE 0.
       01 WS-ON-P3                               GLOBAL    PIC 9       VALUE 0.
       01 WS-ALL-M                               GLOBAL    PIC 9.
