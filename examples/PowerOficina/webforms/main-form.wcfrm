  <Control id="BTN-LEG-M1" type="Button" x="420" y="574" w="120" h="30" tab-order="61" z-order="61" visible="true" enabled="true" parent="CARD-MON">
    <Property name="Caption">Enviados</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">14</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="ForegroundColor">#0F172AFF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#D9DBF9</Property>
    <Property name="AccessibleLabel">Legend item of the monthly chart: show only the quotes sent.</Property>
    <Property name="Definition">Legend item of the monthly chart: show only the quotes sent.</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-LEG-M1--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Legend button: marks or unmarks this item; the chart then shows only the marked ones (none marked = all).
           *> Uses:   WS-ON-M1 (1 = marked, 0 = not marked).
           *> Result: WS-ON-M1 flips, the buttons are repainted and the charts are drawn again.

           IF    WS-ON-M1 = 1
               SET     WS-ON-M1                    TO    0
           ELSE
               SET     WS-ON-M1                    TO    1
           END-IF

           *> SHOW-CHARTS: draws the two charts again with only the marked legend items, and repaints the legend buttons.
           *> Uses:   WS-ON-M1, WS-ON-M2, WS-ON-P1, WS-ON-P2, WS-ON-P3 and the figures of the last reading (DSS-...).
           *> Result: CH-MONTHS and CH-PAYS show what is marked (all when nothing is); the buttons show their state.
           CALL    "SHOW-CHARTS"
]]></Event>
  </Control>
