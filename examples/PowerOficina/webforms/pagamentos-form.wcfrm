    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Heading of the refund card. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="LBL-QS" type="Label" x="632" y="612" w="160" h="20" tab-order="34" z-order="34" visible="true" enabled="true" parent="CARD-REF">
    <Property name="Caption">Nº do serviço na fila</Property>
