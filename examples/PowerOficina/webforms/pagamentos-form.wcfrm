    <Property name="FontName">Arial</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">false</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Caption of the queue service number. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="TXT-QUE" type="TextBox" x="632" y="634" w="150" h="38" tab-order="35" z-order="35" visible="true" enabled="true" parent="CARD-REF">
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#D5D8E6</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="FontSize">14</Property>
    <Property name="HintText">1</Property>
    <Property name="AccessibleLabel">Number of the service on the execution queue screen.</Property>
    <Property name="InnerPadding">8</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Number of the service on the execution queue screen.</Property>
  </Control>
<Control id="LBL-RS" type="Label" x="802" y="612" w="300" h="20" tab-order="36" z-order="36" visible="true" enabled="true" parent="CARD-REF">
    <Property name="Caption">Motivo do estorno</Property>
    <Property name="ForegroundColor">#4B5563FF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">false</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Caption of the refund reason. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="TXT-REASON" type="TextBox" x="802" y="634" w="334" h="38" tab-order="37" z-order="37" visible="true" enabled="true" parent="CARD-REF">
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#D5D8E6</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="FontSize">14</Property>
    <Property name="HintText">Motivo</Property>
    <Property name="AccessibleLabel">Reason for the refund.</Property>
    <Property name="InnerPadding">8</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Reason for the refund. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="CHK-REFDECLINE" type="CheckBox" x="632" y="682" w="400" h="28" tab-order="38" z-order="38" visible="true" enabled="true" parent="CARD-REF">
    <Property name="Caption">Simular recusa do gateway na devolução</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontSize">13</Property>
    <Property name="CheckBoxColor">#FFFFFFFF</Property>
    <Property name="CheckBoxBorderStyle">Single</Property>
    <Property name="CheckBoxBorderColor">#5B4FE9</Property>
    <Property name="CheckColor">#5B4FE9</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Test mode: the gateway does not return the amount already paid, so nothing changes.</Property>
  </Control>
<Control id="BTN-REFUND" type="Button" x="632" y="718" w="260" h="44" tab-order="39" z-order="39" visible="true" enabled="true" parent="CARD-REF">
    <Property name="Caption">Pedir estorno</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Asks the refund of the service; only a service still waiting in the queue is accepted.</Property>
    <Event name="onClick" paragraph="BTN-REFUND--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> DO-REFUND: asks the refund of a service not yet started.
           *> Uses:   TXT-QUE, TXT-REASON, TXT-OPERATOR and the decline tick.
           *> Result: LBL-REFR shows the amount returned and the installments cancelled.
           CALL    "DO-REFUND"
]]></Event>
  </Control>
<Control id="LBL-REFR" type="Label" x="632" y="770" w="500" h="48" tab-order="40" z-order="40" visible="true" enabled="true" parent="CARD-REF">
    <Property name="Caption">-</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">false</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Result of the last refund request: value, installments cancelled and amount returned.</Property>
  </Control>
</Form>
