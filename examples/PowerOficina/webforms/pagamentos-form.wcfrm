<?xml version="1.0" encoding="UTF-8"?>
<Form name="PAGAMENTOS-FORM" title="Pagamentos" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Payment screen of the workshop: shows the installment schedule of an approved quote before it is confirmed, charges the first installment by credit card through the gateway (test mode), collects the installments that have fallen due and refunds a service that has not started, through the Backend programs PAYMENT-CONFIRM, INSTALLMENT-RUN and REFUND-REQUEST. The card number and the security code are never typed or kept: only the brand and the last four digits." index-base="1" responsive="true">
  <user-procedures>
    <Event name="DO-PAYMENT" paragraph="DO-PAYMENT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    PCF-REQ
           SET     PCQ-MODE                      TO    WS-MODE
           COMPUTE PCQ-QUO-ID                    =     FUNCTION NUMVAL ( TXT-QUO::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           COMPUTE PCQ-INSTALLMENTS              =     FUNCTION NUMVAL ( TXT-N::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           SET     PCQ-CONSENT                   TO    "N"
           IF    CHK-CONSENT::Checked = 1
               SET     PCQ-CONSENT               TO    "S"
           END-IF
           SET     PCQ-BRAND                     TO    TXT-BRAND::Text
           SET     PCQ-LAST4                     TO    TXT-LAST4::Text
           SET     PCQ-OPERATOR                  TO    TXT-OPERATOR::Text
           IF    CHK-DECLINE::Checked = 1
               SET     PCQ-GATEWAY               TO    "D"
           END-IF
           IF    CHK-TIMEOUT::Checked = 1
               SET     PCQ-GATEWAY               TO    "T"
           END-IF
           SET     PCS-STATUS                    TO    SPACES

           *> PAYMENT-CONFIRM: shows (mode P) or charges (mode C) the payment of an approved quote by credit card.
           *> Uses:   WS-MODE = P or C; PCQ-QUO-ID = TXT-QUO; PCQ-INSTALLMENTS = TXT-N; PCQ-CONSENT = CHK-CONSENT; PCQ-BRAND and
           *>         PCQ-LAST4 = the brand and the last four digits (never the card number); PCQ-GATEWAY = D or T for the test
           *>         simulations; PCQ-OPERATOR = TXT-OPERATOR.
           *> Result: PCS-STATUS = OK, ALREADY, DECLINED, TIMEOUT, INVALID, NOTFOUND or UNAPPROVED; PCI-... hold the installments
           *>         (number, due date, amount, state); with OK in mode C the first installment is paid, the payment exists and
           *>         the services are in the queue; ALREADY returns the payment that exists, nothing is charged again.
           CALL    "PAYMENT-CONFIRM" WITH WEBSOCKET LINKAGE
               USING BY VALUE PCF-REQ
               RETURNING PCF-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     PCS-STATUS            TO    "CALL"
           END-CALL

           DG-SCHED::ClearRows()
           IF    PCS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    PCS-MESSAGE
               IF    PCS-N > 0
                   *> SHOW-SCHEDULE: lists the installments of the last answer.
                   *> Uses:   PCI-NO, PCI-DUE, PCI-AMOUNT and PCI-STATUS of the PCS-N installments.
                   *> Result: DG-SCHED, LBL-TOTAL and LBL-REF are filled.
                   CALL    "SHOW-SCHEDULE"
               END-IF
           END-IF
]]></Event>
    <Event name="SHOW-SCHEDULE" paragraph="SHOW-SCHEDULE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PCS-N
               SET     WS-ED-AMT                 TO    PCI-AMOUNT (WS-I)
               MOVE    PCI-DUE (WS-I)            TO    WS-DATE-X
               SET     WS-LINE                   TO    SPACES
               STRING    PCI-NO (WS-I) X"09" WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4)
                         X"09" PCS-CURRENCY " " WS-ED-AMT::Trim() X"09" PCI-STATUS (WS-I)
                   INTO  WS-LINE
               DG-SCHED::AddRow( WS-LINE )
           END-PERFORM

           SET     WS-ED-AMT                     TO    PCS-TOTAL
           SET     LBL-TOTAL::Caption            TO    "-"
           STRING    "Total: " PCS-CURRENCY " " WS-ED-AMT  INTO  LBL-TOTAL::Caption
           SET     LBL-REF::Caption              TO    "Pagamento ainda não confirmado."
           IF    PCS-PAY-ID > 0
               SET     LBL-REF::Caption          TO    "-"
               STRING    "Pagamento " PCS-PAY-ID " - " PCS-GW-REF  INTO  LBL-REF::Caption
           END-IF
]]></Event>
    <Event name="DO-RUN" paragraph="DO-RUN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    IRN-REQ
           SET     IRQ-OPERATOR                  TO    TXT-OPERATOR::Text
           IF    CHK-RUNDECLINE::Checked = 1
               SET     IRQ-GATEWAY               TO    "D"
           END-IF
           SET     IRS-STATUS                    TO    SPACES

           *> INSTALLMENT-RUN: records the gateway's answer for every installment that has fallen due.
           *> Uses:   IRQ-ASOF = 0 (today); IRQ-GATEWAY = D when CHK-RUNDECLINE is ticked (test mode); IRQ-OPERATOR = TXT-OPERATOR.
           *> Result: IRS-CHARGED installments paid, IRS-FAILED declined (the customer is told by email and WhatsApp, and the
           *>         installment is tried again next time, at most 3 tries), IRS-GAVE-UP given up after the third failure.
           CALL    "INSTALLMENT-RUN" WITH WEBSOCKET LINKAGE
               USING BY VALUE IRN-REQ
               RETURNING IRN-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     IRS-STATUS            TO    "CALL"
           END-CALL

           IF    IRS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    IRS-MESSAGE
               SET     LBL-RUN::Caption          TO    "-"
               STRING    "Cobradas: " IRS-CHARGED "   Recusadas: " IRS-FAILED "   Desistidas após 3 tentativas: " IRS-GAVE-UP
                   INTO  LBL-RUN::Caption
           END-IF
]]></Event>
    <Event name="DO-REFUND" paragraph="DO-REFUND"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    RFN-REQ
           COMPUTE RFQ-QUE-ID                    =     FUNCTION NUMVAL ( TXT-QUE::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE
           SET     RFQ-BY                        TO    TXT-OPERATOR::Text
           SET     RFQ-REASON                    TO    TXT-REASON::Text
           IF    CHK-REFDECLINE::Checked = 1
               SET     RFQ-GATEWAY               TO    "D"
           END-IF
           SET     RFS-STATUS                    TO    SPACES

           *> REFUND-REQUEST: asks the refund of one service of a paid order; only a service still QUEUED is accepted.
           *> Uses:   RFQ-QUE-ID = TXT-QUE; RFQ-BY = TXT-OPERATOR (who asked, customer or consultant); RFQ-REASON = TXT-REASON;
           *>         RFQ-GATEWAY = D when CHK-REFDECLINE is ticked (test mode).
           *> Result: RFS-STATUS = OK, REFUSED (running, done or already refunded, with the reason), DECLINED, NOTFOUND or INVALID;
           *>         with OK the service leaves the queue, RFS-CANCELLED is taken from future installments and RFS-RETURNED is
           *>         returned through the gateway; the customer is told by email and WhatsApp.
           CALL    "REFUND-REQUEST" WITH WEBSOCKET LINKAGE
               USING BY VALUE RFN-REQ
               RETURNING RFN-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     RFS-STATUS            TO    "CALL"
           END-CALL

           IF    RFS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               SET     LBL-STATUS::Caption       TO    RFS-MESSAGE
               SET     LBL-REFR::Caption         TO    "-"
               IF    RFS-STATUS = "OK"
                   SET     WS-ED-AMT             TO    RFS-AMOUNT
                   SET     WS-ED-AMT2            TO    RFS-CANCELLED
                   STRING    "Valor " RFS-CURRENCY " " WS-ED-AMT "; parcelas futuras canceladas " WS-ED-AMT2
                       INTO  LBL-REFR::Caption
               END-IF
           END-IF
]]></Event>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(160).
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 WS-I                                   GLOBAL    PIC 999.
       01 WS-MODE                                GLOBAL    PIC X(1).
       01 WS-ED-AMT2                             GLOBAL    PIC Z(8)9.99.
       01 PCF-REQ                             GLOBAL.
          05 PCQ-MODE                            PIC    X(1).
          05 PCQ-QUO-ID                          PIC    9(8).
          05 PCQ-INSTALLMENTS                    PIC    9(2).
          05 PCQ-CONSENT                         PIC    X(1).
          05 PCQ-BRAND                           PIC    X(12).
          05 PCQ-LAST4                           PIC    X(4).
          05 PCQ-GATEWAY                         PIC    X(1).
          05 PCQ-OPERATOR                        PIC    X(30).
       01 PCF-RES                             GLOBAL.
          05 PCS-STATUS                          PIC    X(10).
          05 PCS-MESSAGE                         PIC    X(80).
          05 PCS-FIELD                           PIC    X(10).
          05 PCS-PAY-ID                          PIC    9(8).
          05 PCS-QUO-ID                          PIC    9(8).
          05 PCS-CURRENCY                        PIC    X(3).
          05 PCS-TOTAL                           PIC    9(9)V99.
          05 PCS-N                               PIC    9(2).
          05 PCS-GW-REF                          PIC    X(40).
          05 PCS-QUEUED                          PIC    9(2).
          05 PCS-INS                             OCCURS 12.
             10 PCI-NO                           PIC    9(2).
             10 PCI-DUE                          PIC    9(8).
             10 PCI-AMOUNT                       PIC    9(9)V99.
             10 PCI-STATUS                       PIC    X(10).
       01 IRN-REQ                             GLOBAL.
          05 IRQ-ASOF                            PIC    9(8).
          05 IRQ-GATEWAY                         PIC    X(1).
          05 IRQ-OPERATOR                        PIC    X(30).
       01 IRN-RES                             GLOBAL.
          05 IRS-STATUS                          PIC    X(10).
          05 IRS-MESSAGE                         PIC    X(80).
          05 IRS-CHARGED                         PIC    9(4).
          05 IRS-FAILED                          PIC    9(4).
          05 IRS-GAVE-UP                         PIC    9(4).
       01 RFN-REQ                             GLOBAL.
          05 RFQ-QUE-ID                          PIC    9(8).
          05 RFQ-BY                              PIC    X(30).
          05 RFQ-REASON                          PIC    X(60).
          05 RFQ-GATEWAY                         PIC    X(1).
       01 RFN-RES                             GLOBAL.
          05 RFS-STATUS                          PIC    X(10).
          05 RFS-MESSAGE                         PIC    X(80).
          05 RFS-RFD-ID                          PIC    9(8).
          05 RFS-PAY-ID                          PIC    9(8).
          05 RFS-CURRENCY                        PIC    X(3).
          05 RFS-AMOUNT                          PIC    9(9)V99.
          05 RFS-CANCELLED                       PIC    9(9)V99.
          05 RFS-RETURNED                        PIC    9(9)V99.
          05 RFS-QSTATE                          PIC    X(10).
]]></working-storage>
  <form-events>
    <Event name="onLoad" paragraph="PAGAMENTOS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     LBL-STATUS::Caption           TO    "Informe o operador e o número do orçamento aprovado."
]]></Event>
  </form-events>
