    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Heading of the due installments card. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="CHK-RUNDECLINE" type="CheckBox" x="56" y="612" w="400" h="28" tab-order="29" z-order="29" visible="true" enabled="true" parent="CARD-RUN">
    <Property name="Caption">Simular recusa do gateway nesta cobrança</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontSize">13</Property>
    <Property name="CheckBoxColor">#FFFFFFFF</Property>
    <Property name="CheckBoxBorderStyle">Single</Property>
    <Property name="CheckBoxBorderColor">#5B4FE9</Property>
    <Property name="CheckColor">#5B4FE9</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Test mode: the gateway declines the due installments, to show the failure notice and the limit of three tries.</Property>
  </Control>
<Control id="BTN-RUN" type="Button" x="56" y="650" w="260" h="44" tab-order="30" z-order="30" visible="true" enabled="true" parent="CARD-RUN">
    <Property name="Caption">Cobrar parcelas vencidas</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Records what the gateway answered for every installment that has fallen due.</Property>
    <Event name="onClick" paragraph="BTN-RUN--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> DO-RUN: collects the installments that have fallen due.
           *> Uses:   the operator and the decline tick of the screen.
           *> Result: LBL-RUN shows how many were charged, declined or given up.
           CALL    "DO-RUN"
]]></Event>
  </Control>
<Control id="LBL-RUN" type="Label" x="56" y="706" w="500" h="40" tab-order="31" z-order="31" visible="true" enabled="true" parent="CARD-RUN">
    <Property name="Caption">-</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">false</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
