    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Payment number and gateway reference. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="CARD-RUN" type="Panel" x="32" y="564" w="560" h="200" tab-order="27" z-order="27" visible="true" enabled="true">
