  </Control>
<Control id="CHK-TIMEOUT" type="CheckBox" x="366" y="344" w="300" h="28" tab-order="18" z-order="18" visible="true" enabled="true" parent="CARD-PAY">
    <Property name="Caption">Simular gateway sem resposta</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontSize">13</Property>
    <Property name="CheckBoxColor">#FFFFFFFF</Property>
    <Property name="CheckBoxBorderStyle">Single</Property>
    <Property name="CheckBoxBorderColor">#5B4FE9</Property>
    <Property name="CheckColor">#5B4FE9</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Test mode: the gateway does not answer, to show that nothing is charged and the payment can be tried again.</Property>
  </Control>
<Control id="BTN-PREVIEW" type="Button" x="56" y="382" w="284" h="44" tab-order="19" z-order="19" visible="true" enabled="true" parent="CARD-PAY">
    <Property name="Caption">Conferir parcelas</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Shows the installments, due dates and total before the payment is confirmed.</Property>
    <Event name="onClick" paragraph="BTN-PREVIEW--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-MODE                       TO    "P"
           *> DO-PAYMENT: shows or confirms the payment of the approved quote typed in TXT-QUO.
           *> Uses:   WS-MODE (P or C) and the card fields of the screen.
           *> Result: the installments listed, the status line set, and with mode C the payment recorded and the services queued.
           CALL    "DO-PAYMENT"
]]></Event>
  </Control>
<Control id="BTN-PAY" type="Button" x="356" y="382" w="284" h="44" tab-order="20" z-order="20" visible="true" enabled="true" parent="CARD-PAY">
    <Property name="Caption">Confirmar pagamento</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Charges the first installment at the gateway and puts the services of the quote in the execution queue.</Property>
    <Event name="onClick" paragraph="BTN-PAY--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-MODE                       TO    "C"
           *> DO-PAYMENT: shows or confirms the payment of the approved quote typed in TXT-QUO.
           *> Uses:   WS-MODE (P or C) and the card fields of the screen.
           *> Result: the installments listed, the status line set, and with mode C the payment recorded and the services queued.
           CALL    "DO-PAYMENT"
]]></Event>
  </Control>
<Control id="LBL-NOTE" type="Label" x="56" y="440" w="570" h="40" tab-order="21" z-order="21" visible="true" enabled="true" parent="CARD-PAY">
    <Property name="Caption">Parcelas iguais; o centavo que sobra vai na primeira. A primeira é cobrada agora e as outras a cada 30 dias pelo gateway, sem pedir o cartão de novo.</Property>
    <Property name="ForegroundColor">#4B5563FF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">12</Property>
    <Property name="Bold">false</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Reminder of how the installments are charged.</Property>
  </Control>
