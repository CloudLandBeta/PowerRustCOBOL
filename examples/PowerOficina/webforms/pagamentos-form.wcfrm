    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#CBD5E1</Property>
    <Property name="CornerRadius">8</Property>
    <Property name="FontSize">13</Property>
    <Property name="HeaderBackgroundColor">#E6E8F2</Property>
    <Property name="HeaderForegroundColor">#0F172AFF</Property>
    <Property name="GridLineColor">#E2E8F0</Property>
    <Property name="AlternatingMode">Rows</Property>
    <Property name="AlternatingRowColor">#F5F7FB</Property>
