<?xml version="1.0" encoding="UTF-8"?>
<Form name="RELATORIOS-FORM" title="Relatórios" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Reports of the workshop: the quotes, the payments, the installments the gateway declined and the notices that were not delivered, filtered by status, with the total of one currency at a time (never added across currencies), through the Backend program REPORT-LIST." index-base="1" responsive="true">
  <user-procedures>
    <Event name="LOAD-REPORT" paragraph="LOAD-REPORT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    RPT-REQ
           SET     RPQ-MODE                      TO    "Q"
           IF    RDO-P::Selected = 1
               SET     RPQ-MODE                  TO    "P"
           END-IF
           IF    RDO-F::Selected = 1
               SET     RPQ-MODE                  TO    "F"
           END-IF
           IF    RDO-N::Selected = 1
               SET     RPQ-MODE                  TO    "N"
           END-IF
           SET     RPQ-CURRENCY                  TO    "BRL"
           IF    RDO-EUR::Selected = 1
               SET     RPQ-CURRENCY              TO    "EUR"
           END-IF
           SET     RPQ-FILTER                    TO    TXT-FILTER::Text::Trim()
           SET     RPS-STATUS                    TO    SPACES

           *> REPORT-LIST: the rows of one report, with the total of one currency.
           *> Uses:   RPQ-MODE = Q, P, F or N from the radio buttons; RPQ-CURRENCY = BRL or EUR; RPQ-FILTER = TXT-FILTER.
           *> Result: RPL-... hold up to 40 rows; RPS-TOTAL-ROWS says how many exist; RPS-TOTAL adds the rows of that currency
           *>         only; a wrong choice answers INVALID with a message.
           CALL    "REPORT-LIST" WITH WEBSOCKET LINKAGE
               USING BY VALUE RPT-REQ
               RETURNING RPT-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     RPS-STATUS            TO    "CALL"
           END-CALL

           DG-REPORT::ClearRows()
           IF    RPS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               IF    RPS-STATUS = "OK"
                   *> SHOW-REPORT: lists the rows of the last report.
                   *> Uses:   RPL-... rows, RPS-COUNT and RPS-TOTAL.
                   *> Result: DG-REPORT, the status line and LBL-SUM are filled.
                   CALL    "SHOW-REPORT"
               ELSE
                   SET     LBL-STATUS::Caption   TO    RPS-MESSAGE
               END-IF
           END-IF
]]></Event>
    <Event name="SHOW-REPORT" paragraph="SHOW-REPORT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    RPS-COUNT = 0
               DG-REPORT::AddRow( "Nenhum registro para este relatório." )
           END-IF
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > RPS-COUNT
               SET     WS-ED-AMT                 TO    RPL-AMOUNT (WS-I)
               SET     WS-LINE                   TO    SPACES
               MOVE    RPL-DATE (WS-I)           TO    WS-DATE-X
               STRING    RPL-ID (WS-I) X"09" RPL-REF (WS-I) X"09" RPL-STATUS (WS-I) X"09" WS-ED-AMT::Trim() X"09"
                         WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4) X"09" RPL-TEXT (WS-I)  INTO  WS-LINE
               DG-REPORT::AddRow( WS-LINE )
           END-PERFORM

           SET     WS-ED-INT                     TO    RPS-TOTAL-ROWS
           SET     LBL-STATUS::Caption           TO    "Relatório gerado."
           SET     LBL-SUM::Caption              TO    "-"
           SET     WS-ED-AMT                     TO    RPS-TOTAL
           STRING    WS-ED-INT::Trim() " registro(s)." INTO LBL-SUM::Caption
           IF    RPS-TOTAL > 0
               STRING    WS-ED-INT::Trim() " registro(s). Total em " RPQ-CURRENCY ": " WS-ED-AMT::Trim()  INTO  LBL-SUM::Caption
           END-IF
           IF    RPS-TOTAL-ROWS > RPS-COUNT
               SET     LBL-STATUS::Caption       TO    "Mostrando os primeiros 40 registros; refine pelo estado."
           END-IF
]]></Event>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(160).
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 WS-I                                   GLOBAL    PIC 999.
       01 WS-ED-INT                              GLOBAL    PIC Z(4)9.
       01 RPT-REQ                             GLOBAL.
          05 RPQ-MODE                            PIC    X(1).
          05 RPQ-CURRENCY                        PIC    X(3).
          05 RPQ-FILTER                          PIC    X(10).
       01 RPT-RES                             GLOBAL.
          05 RPS-STATUS                          PIC    X(10).
          05 RPS-MESSAGE                         PIC    X(80).
          05 RPS-COUNT                           PIC    9(3).
          05 RPS-TOTAL-ROWS                      PIC    9(5).
          05 RPS-TOTAL                           PIC    9(11)V99.
          05 RPS-ROW                             OCCURS 40.
             10 RPL-ID                           PIC    9(8).
             10 RPL-REF                          PIC    X(8).
             10 RPL-STATUS                       PIC    X(10).
             10 RPL-AMOUNT                       PIC    9(9)V99.
             10 RPL-DATE                         PIC    9(8).
             10 RPL-TEXT                         PIC    X(60).
]]></working-storage>
  <form-events>
    <Event name="onLoad" paragraph="RELATORIOS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     LBL-STATUS::Caption           TO    "Escolha o relatório e toque em Gerar relatório."
]]></Event>
  </form-events>
