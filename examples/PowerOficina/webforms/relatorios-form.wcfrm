<Control id="DG-REPORT" type="DataGrid" x="56" y="340" w="1072" h="410" tab-order="17" z-order="17" visible="true" enabled="true" parent="CARD-L">
    <Property name="Columns">Nº:string
Referência:string
Estado:string
Valor:string
Data:string
Observação:string</Property>
    <Property name="Rows"></Property>
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="ForegroundColor">#0F172AFF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#CBD5E1</Property>
    <Property name="CornerRadius">8</Property>
    <Property name="FontSize">13</Property>
    <Property name="HeaderBackgroundColor">#E6E8F2</Property>
    <Property name="HeaderForegroundColor">#0F172AFF</Property>
    <Property name="GridLineColor">#E2E8F0</Property>
    <Property name="AlternatingMode">Rows</Property>
    <Property name="AlternatingRowColor">#F5F7FB</Property>
    <Property name="RowHeight">28</Property>
    <Property name="SelectionMode">Row</Property>
    <Property name="AllowSorting">1</Property>
    <Property name="ShowColumnFilters">1</Property>
    <Property name="AllowColumnResize">1</Property>
    <Property name="AutoFitColumns">1</Property>
    <Property name="AllowColumnReorder">0</Property>
    <Property name="AllowRowResize">0</Property>
    <Property name="AllowCellEditing">0</Property>
    <Property name="AccessibleLabel">The rows of the report: number, reference, state, amount, da</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">The rows of the report: number, reference, state, amount, date and note.</Property>
  </Control>
