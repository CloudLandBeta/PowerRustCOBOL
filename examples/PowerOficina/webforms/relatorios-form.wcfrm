    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Reads the report chosen from the Backend and lists it.</Property>
    <Event name="onClick" paragraph="BTN-GO--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-REPORT: reads the report chosen from the Backend.
           *> Uses:   the report, currency and status filter of the screen.
           *> Result: DG-REPORT and the total line are filled.
           CALL    "LOAD-REPORT"
]]></Event>
  </Control>
