<?xml version="1.0" encoding="UTF-8"?>
<Form name="ORCAMENTOS-FORM" title="Orçamentos" width="1192" height="1062" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Quote screen of the workshop: builds a quote from the suggested parts and services, adds parts and add-ons from the catalog of one currency, adjusts service hours with a reason, and shows the total without taxes, the taxes and the total, plus the execution date and validity, through the Backend programs CATALOG-LIST, QUOTE-SUGGEST and QUOTE-SAVE." index-base="1" responsive="true">
  <user-procedures>
    <Event name="GET-CURRENCY" paragraph="GET-CURRENCY"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    RDO-EUR::Selected = 1
               SET     WS-CUR                    TO    "EUR"
           ELSE
               SET     WS-CUR                    TO    "BRL"
           END-IF
]]></Event>
    <Event name="LOAD-LISTS" paragraph="LOAD-LISTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CALL    "GET-CURRENCY"

           *> CATALOG-LIST: the parts of the catalog in one currency.
           *> Uses:   CLQ-CURRENCY = WS-CUR; CLQ-KIND = "P" (parts).
           *> Result: CLR-ROW lists CLR-COUNT parts with price; DG-PARTS shows them, WS-PART-CODE keeps the codes.

           INITIALIZE    CLS-REQ
           SET     CLQ-CURRENCY                  TO    WS-CUR
           SET     CLQ-KIND                      TO    "P"
           SET     CLR-STATUS                    TO    SPACES
           CALL    "CATALOG-LIST" WITH WEBSOCKET LINKAGE
               USING BY VALUE CLS-REQ
               RETURNING CLS-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     CLR-STATUS            TO    "CALL"
           END-CALL

           DG-PARTS::ClearRows()
           IF    CLR-STATUS = "OK"
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CLR-COUNT
                   SET     WS-ED-UNIT            TO    CLR-UNIT (WS-I)
                   SET     WS-LINE               TO    SPACES
                   STRING    CLR-CODE (WS-I) X"09" CLR-NAME (WS-I) X"09" WS-ED-UNIT::Trim()  INTO  WS-LINE
                   DG-PARTS::AddRow( WS-LINE )
                   SET     WS-PART-CODE (WS-I)          TO    CLR-CODE (WS-I)
               END-PERFORM
           END-IF

           *> CATALOG-LIST: the add-on services of the catalog in one currency.
           *> Uses:   CLQ-CURRENCY = WS-CUR; CLQ-KIND = "A" (add-ons).
           *> Result: CLR-ROW lists CLR-COUNT add-ons with price; DG-ADDONS shows them, WS-ADD-CODE keeps the codes.

           INITIALIZE    CLS-REQ
           SET     CLQ-CURRENCY                  TO    WS-CUR
           SET     CLQ-KIND                      TO    "A"
           SET     CLR-STATUS                    TO    SPACES
           CALL    "CATALOG-LIST" WITH WEBSOCKET LINKAGE
               USING BY VALUE CLS-REQ
               RETURNING CLS-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     CLR-STATUS            TO    "CALL"
           END-CALL

           DG-ADDONS::ClearRows()
           IF    CLR-STATUS = "OK"
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CLR-COUNT
                   SET     WS-ED-UNIT            TO    CLR-UNIT (WS-I)
                   SET     WS-LINE               TO    SPACES
                   STRING    CLR-CODE (WS-I) X"09" CLR-NAME (WS-I) X"09" WS-ED-UNIT::Trim()  INTO  WS-LINE
                   DG-ADDONS::AddRow( WS-LINE )
                   SET     WS-ADD-CODE (WS-I)          TO    CLR-CODE (WS-I)
               END-PERFORM
           END-IF
]]></Event>
    <Event name="REFRESH-LINES" paragraph="REFRESH-LINES"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           DG-LINES::ClearRows()
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QRQ-COUNT
               EVALUATE    QRL-KIND (WS-I)
                   WHEN "P"
                       SET     WS-KIND-TXT       TO    "Peça"
                   WHEN "S"
                       SET     WS-KIND-TXT       TO    "Serviço"
                   WHEN OTHER
                       SET     WS-KIND-TXT       TO    "Adicional"
               END-EVALUATE

               SET     WS-LINE                   TO    SPACES
               IF    QRL-KIND (WS-I) = "S"
                   IF    QRL-HOURS (WS-I) > 0
                       SET     WS-ED-QTY         TO    QRL-HOURS (WS-I)
                       STRING    WS-KIND-TXT " " QRL-CODE (WS-I) X"09" WS-ED-QTY::Trim() " h (ajustadas)"  INTO  WS-LINE
                   ELSE
                       STRING    WS-KIND-TXT " " QRL-CODE (WS-I) X"09" "horas padrão do catálogo"  INTO  WS-LINE
                   END-IF
               ELSE
                   SET     WS-ED-QTY             TO    QRL-QTY (WS-I)
                   STRING    WS-KIND-TXT " " QRL-CODE (WS-I) X"09" WS-ED-QTY::Trim()  INTO  WS-LINE
               END-IF

               DG-LINES::AddRow( WS-LINE )
           END-PERFORM
]]></Event>
    <Event name="SHOW-QUOTE" paragraph="SHOW-QUOTE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> SHOW-QUOTE: paints the quote just answered (QUO-RES) on the list and the summary, and keeps its lines
           *> and its number so the next "Gerar orçamento" is a revision of it.
           *> Uses:   QTS-... = the quote answered by QUOTE-SAVE (lines QTL-..., totals, dates).
           *> Result: DG-LINES shows each line with quantity, unit price, amount and tax; the summary labels
           *>         show number, currency, hours, totals and dates; WS-QUOTE-ID = QTS-ID; QRQ-LINE = the lines.

           SET     WS-QUOTE-ID                   TO    QTS-ID
           DG-LINES::ClearRows()
           SET     QRQ-COUNT                     TO    QTS-COUNT
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QTS-COUNT
               SET     WS-ED-QTY                 TO    QTL-QTY (WS-I)
               SET     WS-ED-UNIT                TO    QTL-UNIT (WS-I)
               SET     WS-ED-AMT                 TO    QTL-AMOUNT (WS-I)
               SET     WS-ED-TAX                 TO    QTL-TAX (WS-I)
               SET     WS-LINE                   TO    SPACES
               STRING    QTL-NAME (WS-I) X"09" WS-ED-QTY::Trim() X"09" WS-ED-UNIT::Trim() X"09" WS-ED-AMT::Trim() X"09" WS-ED-TAX::Trim()
                   INTO  WS-LINE
               DG-LINES::AddRow( WS-LINE )

               SET     QRL-KIND (WS-I)           TO    QTL-KIND (WS-I)
               SET     QRL-CODE (WS-I)           TO    QTL-CODE (WS-I)
               SET     QRL-QTY (WS-I)            TO    QTL-QTY (WS-I)
               SET     QRL-HOURS (WS-I)          TO    0
               SET     QRL-MANUAL (WS-I)         TO    QTL-MANUAL (WS-I)
               SET     QRL-NOTE (WS-I)           TO    QTL-NOTE (WS-I)
               IF    QTL-KIND (WS-I) = "S" AND QTL-MANUAL (WS-I) = "S"
                   SET     QRL-HOURS (WS-I)      TO    QTL-QTY (WS-I)
               END-IF
               IF    QTL-KIND (WS-I) NOT = "P"
                   SET     QRL-QTY (WS-I)        TO    1
               END-IF
           END-PERFORM

           SET     LBL-V-NUM::Caption            TO    "-"
           STRING    QTS-ID "/" QTS-REV  INTO  LBL-V-NUM::Caption
           SET     LBL-V-CUR::Caption            TO    QTS-CURRENCY
           SET     WS-ED-QTY                     TO    QTS-HOURS
           SET     LBL-V-HRS::Caption            TO    WS-ED-QTY
           SET     WS-ED-AMT                     TO    QTS-SUBTOTAL
           STRING    QTS-CURRENCY " " WS-ED-AMT  INTO  LBL-V-SUB::Caption
           SET     WS-ED-AMT                     TO    QTS-TAX
           STRING    QTS-CURRENCY " " WS-ED-AMT  INTO  LBL-V-TAX::Caption
           SET     WS-ED-AMT                     TO    QTS-TOTAL
           STRING    QTS-CURRENCY " " WS-ED-AMT  INTO  LBL-V-TOT::Caption

           MOVE    QTS-SUGGESTED                 TO    WS-DATE-X
           STRING    WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4)  INTO  LBL-V-SUG::Caption
           MOVE    QTS-VALID-UNTIL               TO    WS-DATE-X
           STRING    WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4)  INTO  LBL-V-VAL::Caption
]]></Event>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(120).
       01 WS-I                                   GLOBAL    PIC 999.
       01 WS-J                                   GLOBAL    PIC 999.
       01 WS-K                                   GLOBAL    PIC 999.
       01 WS-CUR                                 GLOBAL    PIC X(3)    VALUE "BRL".
       01 WS-QUOTE-ID                            GLOBAL    PIC 9(8)    VALUE 0.
       01 WS-KIND-TXT                            GLOBAL    PIC X(9).
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 WS-DEADLINE-ISO                        GLOBAL    PIC X(10).
       01 WS-PART-CODE                           GLOBAL    PIC X(12)    OCCURS 30.
       01 WS-ADD-CODE                            GLOBAL    PIC X(12)    OCCURS 30.
       01 WS-ED-QTY                              GLOBAL    PIC ZZZ9.99.
       01 WS-ED-UNIT                             GLOBAL    PIC Z(6)9.99.
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-ED-TAX                              GLOBAL    PIC Z(8)9.99.
       01 CLS-REQ                             GLOBAL.
          05 CLQ-CURRENCY                        PIC    X(3).
          05 CLQ-KIND                            PIC    X(1).
       01 CLS-RES                             GLOBAL.
          05 CLR-STATUS                          PIC    X(10).
          05 CLR-MESSAGE                         PIC    X(80).
          05 CLR-COUNT                           PIC    9(3).
          05 CLR-ROW                             OCCURS 30.
             10 CLR-CODE                         PIC    X(12).
             10 CLR-NAME                         PIC    X(40).
             10 CLR-UNIT                         PIC    9(7)V99.
             10 CLR-HOURS                        PIC    9(3)V99.
             10 CLR-TAX-RATE                     PIC    9(2)V99.
       01 QSG-REQ                             GLOBAL.
          05 QSQ-DGN-ID                          PIC    9(8).
          05 QSQ-CURRENCY                        PIC    X(3).
       01 QSG-RES                             GLOBAL.
          05 QSS-STATUS                          PIC    X(10).
          05 QSS-MESSAGE                         PIC    X(80).
          05 QSS-COUNT                           PIC    9(3).
          05 QSS-LINE                            OCCURS 20.
             10 QSL-KIND                         PIC    X(1).
             10 QSL-CODE                         PIC    X(12).
             10 QSL-NAME                         PIC    X(40).
             10 QSL-QTY                          PIC    9(4)V99.
             10 QSL-UNIT                         PIC    9(7)V99.
             10 QSL-HOURS                        PIC    9(3)V99.
             10 QSL-FAULT                        PIC    X(8).
       01 QUO-REQ                             GLOBAL.
          05 QRQ-ID                              PIC    9(8).
          05 QRQ-PLATE                           PIC    X(8).
          05 QRQ-DGN-ID                          PIC    9(8).
          05 QRQ-CURRENCY                        PIC    X(3).
          05 QRQ-OPERATOR                        PIC    X(30).
          05 QRQ-DEADLINE                        PIC    9(8).
          05 QRQ-COUNT                           PIC    9(3).
          05 QRQ-LINE                            OCCURS 20.
             10 QRL-KIND                         PIC    X(1).
             10 QRL-CODE                         PIC    X(12).
             10 QRL-QTY                          PIC    9(4)V99.
             10 QRL-HOURS                        PIC    9(3)V99.
             10 QRL-MANUAL                       PIC    X(1).
             10 QRL-NOTE                         PIC    X(60).
       01 QUO-RES                             GLOBAL.
          05 QTS-STATUS                          PIC    X(10).
          05 QTS-MESSAGE                         PIC    X(80).
          05 QTS-FIELD                           PIC    X(10).
          05 QTS-LINE-NO                         PIC    9(3).
          05 QTS-ACTION                          PIC    X(12).
          05 QTS-ID                              PIC    9(8).
          05 QTS-REV                             PIC    9(2).
          05 QTS-CUS-ID                          PIC    9(8).
          05 QTS-PLATE                           PIC    X(8).
          05 QTS-DGN-ID                          PIC    9(8).
          05 QTS-CURRENCY                        PIC    X(3).
          05 QTS-QSTATUS                         PIC    X(10).
          05 QTS-CREATED                         PIC    9(14).
          05 QTS-VALID-UNTIL                     PIC    9(8).
          05 QTS-DEADLINE                        PIC    9(8).
          05 QTS-SUGGESTED                       PIC    9(8).
          05 QTS-HOURS                           PIC    9(4)V99.
          05 QTS-SUBTOTAL                        PIC    9(9)V99.
          05 QTS-TAX                             PIC    9(9)V99.
          05 QTS-TOTAL                           PIC    9(9)V99.
          05 QTS-OPERATOR                        PIC    X(30).
          05 QTS-COUNT                           PIC    9(3).
          05 QTS-LINE                            OCCURS 20.
             10 QTL-KIND                         PIC    X(1).
             10 QTL-CODE                         PIC    X(12).
             10 QTL-NAME                         PIC    X(40).
             10 QTL-QTY                          PIC    9(4)V99.
             10 QTL-UNIT                         PIC    9(7)V99.
             10 QTL-TAX-RATE                     PIC    9(2)V99.
             10 QTL-AMOUNT                       PIC    9(9)V99.
             10 QTL-TAX                          PIC    9(9)V99.
             10 QTL-MANUAL                       PIC    X(1).
             10 QTL-NOTE                         PIC    X(60).
]]></working-storage>
  <form-events>
    <Event name="onLoad" paragraph="ORCAMENTOS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-LISTS: fills the part and add-on lists from the catalog of the currency chosen (BRL at first).
           *> Uses:   WS-CUR = the currency of RDO-BRL / RDO-EUR.
           *> Result: DG-PARTS and DG-ADDONS are filled; the quote starts empty.

           SET     QRQ-COUNT                     TO    0
           CALL    "LOAD-LISTS"
]]></Event>
  </form-events>
