<Control id="BTN-ADD-PART" type="Button" x="146" y="868" w="240" h="38" tab-order="29" z-order="29" visible="true" enabled="true" parent="CARD-LINES">
    <Property name="Caption">Adicionar peça</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Adds the selected part, with the typed quantity, to the quote.</Property>
    <Event name="onClick" paragraph="BTN-ADD-PART--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-I                          TO    DG-PARTS::ClickedRow
           IF    WS-I > 0 AND WS-I NOT > 30 AND QRQ-COUNT < 20
               ADD     1                         TO    QRQ-COUNT
               SET     QRL-KIND (QRQ-COUNT)      TO    "P"
               SET     QRL-CODE (QRQ-COUNT)      TO    WS-PART-CODE (WS-I)
               COMPUTE QRL-QTY (QRQ-COUNT)       =     FUNCTION NUMVAL ( TXT-QTY::Text )
               IF    QRL-QTY (QRQ-COUNT) = 0
                   SET     QRL-QTY (QRQ-COUNT)   TO    1
               END-IF

               SET     QRL-HOURS (QRQ-COUNT)     TO    0
               SET     QRL-MANUAL (QRQ-COUNT)    TO    "S"
               SET     QRL-NOTE (QRQ-COUNT)      TO    SPACES
               CALL    "REFRESH-LINES"
               SET     LBL-STATUS::Caption       TO    "Peça adicionada."
           ELSE
               SET     LBL-STATUS::Caption       TO    "Selecione uma peça (e há espaço para até 20 itens)."
           END-IF
]]></Event>
  </Control>
<Control id="BTN-ADD-ADDON" type="Button" x="410" y="868" w="338" h="38" tab-order="30" z-order="30" visible="true" enabled="true" parent="CARD-LINES">
    <Property name="Caption">Adicionar adicional</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Adds the selected add-on service to the quote.</Property>
    <Event name="onClick" paragraph="BTN-ADD-ADDON--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-I                          TO    DG-ADDONS::ClickedRow
           IF    WS-I > 0 AND WS-I NOT > 30 AND QRQ-COUNT < 20
               ADD     1                         TO    QRQ-COUNT
               SET     QRL-KIND (QRQ-COUNT)      TO    "A"
               SET     QRL-CODE (QRQ-COUNT)      TO    WS-ADD-CODE (WS-I)
               SET     QRL-QTY (QRQ-COUNT)       TO    1
               SET     QRL-HOURS (QRQ-COUNT)     TO    0
               SET     QRL-MANUAL (QRQ-COUNT)    TO    "S"
               SET     QRL-NOTE (QRQ-COUNT)      TO    SPACES
               CALL    "REFRESH-LINES"
               SET     LBL-STATUS::Caption       TO    "Adicional incluído. O total muda ao gerar o orçamento."
           ELSE
               SET     LBL-STATUS::Caption       TO    "Selecione um adicional (e há espaço para até 20 itens)."
           END-IF
]]></Event>
  </Control>
