<Control id="RDO-BRL" type="RadioButton" x="632" y="144" w="76" h="28" tab-order="11" z-order="11" visible="true" enabled="true" parent="CARD-HEAD">
    <Property name="Caption">BRL (R$)</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontSize">14</Property>
    <Property name="Selected">true</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Choice of the currency of the quote: BRL (R$). A quote has one currency only and prices are never converted.</Property>
    <Property name="CheckColor">#5B4FE9</Property>
    <Property name="CheckBoxBorderColor">#5B4FE9</Property>
    <Event name="onClick" paragraph="RDO-BRL--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-LISTS: fills the part list and the add-on list with the catalog of the chosen currency.
           *> Uses:   RDO-EUR::Selected decides the currency (WS-CUR).
           *> Result: DG-PARTS and DG-ADDONS show the catalog rows of that currency only; WS-PART-CODE and
           *>         WS-ADD-CODE keep the code of each row, in the same order.

           CALL    "LOAD-LISTS"
]]></Event>
  </Control>
<Control id="RDO-EUR" type="RadioButton" x="716" y="144" w="76" h="28" tab-order="12" z-order="12" visible="true" enabled="true" parent="CARD-HEAD">
    <Property name="Caption">EUR (€)</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontSize">14</Property>
    <Property name="Selected">false</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Choice of the currency of the quote: EUR (€). A quote has one currency only and prices are never converted.</Property>
    <Property name="CheckColor">#5B4FE9</Property>
    <Property name="CheckBoxBorderColor">#5B4FE9</Property>
    <Event name="onClick" paragraph="RDO-EUR--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-LISTS: fills the part list and the add-on list with the catalog of the chosen currency.
           *> Uses:   RDO-EUR::Selected decides the currency (WS-CUR).
           *> Result: DG-PARTS and DG-ADDONS show the catalog rows of that currency only; WS-PART-CODE and
           *>         WS-ADD-CODE keep the code of each row, in the same order.

           CALL    "LOAD-LISTS"
]]></Event>
  </Control>
<Control id="BTN-SUGGEST" type="Button" x="840" y="140" w="200" h="40" tab-order="13" z-order="13" visible="true" enabled="true" parent="CARD-HEAD">
    <Property name="Caption">Sugerir do diagnóstico</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Asks the Backend which parts and services the diagnosis calls for and puts them on the quote.</Property>
    <Event name="onClick" paragraph="BTN-SUGGEST--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> QUOTE-SUGGEST: asks which parts and services the diagnosis calls for.
           *> Uses:   QSQ-DGN-ID = the number typed in TXT-DGN; QSQ-CURRENCY = WS-CUR.
           *> Result: QSS-STATUS = OK, NODIAG or INVALID; with OK, QSS-LINE lists the parts and services
           *>         (QSS-COUNT of them) in that currency, and they become the lines of the quote.

           CALL    "GET-CURRENCY"
           INITIALIZE    QSG-REQ
           COMPUTE QSQ-DGN-ID                    =     FUNCTION NUMVAL ( TXT-DGN::Text )
           SET     QSQ-CURRENCY                  TO    WS-CUR
           SET     QSS-STATUS                    TO    SPACES
           CALL    "QUOTE-SUGGEST" WITH WEBSOCKET LINKAGE
               USING BY VALUE QSG-REQ
               RETURNING QSG-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QSS-STATUS            TO    "CALL"
           END-CALL

           EVALUATE    QSS-STATUS
               WHEN "OK"
                   IF    QSS-COUNT = 0
                       SET     LBL-STATUS::Caption  TO    QSS-MESSAGE
                   ELSE
                       SET     QRQ-COUNT         TO    QSS-COUNT
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QSS-COUNT
                           SET     QRL-KIND (WS-I)    TO    QSL-KIND (WS-I)
                           SET     QRL-CODE (WS-I)    TO    QSL-CODE (WS-I)
                           SET     QRL-QTY (WS-I)     TO    QSL-QTY (WS-I)
                           SET     QRL-HOURS (WS-I)   TO    0
                           SET     QRL-MANUAL (WS-I)  TO    "N"
                           SET     QRL-NOTE (WS-I)    TO    SPACES
                       END-PERFORM

                       CALL    "REFRESH-LINES"
                       SET     LBL-STATUS::Caption    TO    "Itens sugeridos pelos códigos de falha. Ajuste o que precisar."
                   END-IF
               WHEN "CALL"
                   SET     LBL-STATUS::Caption   TO    "Não foi possível falar com o Backend."
               WHEN OTHER
                   SET     LBL-STATUS::Caption   TO    QSS-MESSAGE
           END-EVALUATE
]]></Event>
  </Control>
<Control id="BTN-NEW" type="Button" x="1056" y="140" w="80" h="40" tab-order="14" z-order="14" visible="true" enabled="true" parent="CARD-HEAD">
    <Property name="Caption">Novo</Property>
