<Control id="BTN-ADJUST" type="Button" x="616" y="572" w="132" h="38" tab-order="23" z-order="23" visible="true" enabled="true" parent="CARD-LINES">
    <Property name="Caption">Ajustar horas</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Applies the typed hours and reason to the selected service line.</Property>
    <Event name="onClick" paragraph="BTN-ADJUST--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-I                          TO    DG-LINES::ClickedRow
           IF    WS-I > 0 AND WS-I NOT > QRQ-COUNT AND QRL-KIND (WS-I) = "S"
               COMPUTE QRL-HOURS (WS-I)          =     FUNCTION NUMVAL ( TXT-HOURS::Text )
               SET     QRL-NOTE (WS-I)           TO    TXT-NOTE::Text
               SET     QRL-MANUAL (WS-I)         TO    "S"
               CALL    "REFRESH-LINES"
               SET     LBL-STATUS::Caption       TO    "Horas ajustadas. Gere o orçamento para ver o novo valor."
           ELSE
               SET     LBL-STATUS::Caption       TO    "Selecione um serviço da lista para ajustar as horas."
           END-IF
]]></Event>
  </Control>
