<Control id="BTN-SAVE" type="Button" x="32" y="942" w="220" h="44" tab-order="51" z-order="51" visible="true" enabled="true">
    <Property name="Caption">Gerar orçamento</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Sends the lines to the Backend, which prices them in the chosen currency and saves the quote or its next revision.</Property>
    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> QUOTE-SAVE: prices the lines in the catalog of the currency and saves the quote.
           *> Uses:   QRQ-ID = WS-QUOTE-ID (0 = new; a number = a change of that quote, which adds the next
           *>         revision, or a NEW quote when the currency is another one); QRQ-PLATE, QRQ-DGN-ID,
           *>         QRQ-CURRENCY, QRQ-OPERATOR and QRQ-DEADLINE from the fields above; the lines in QRQ-LINE.
           *> Result: QTS-STATUS = OK, INVALID, NOVEHICLE, NODIAG, NOTFOUND or ERROR; with OK the quote comes
           *>         back priced, with taxes, totals, execution date and validity, and is shown on the summary.

           CALL    "GET-CURRENCY"
           SET     QRQ-ID                        TO    WS-QUOTE-ID
           SET     QRQ-PLATE                     TO    TXT-PLATE::Text
           SET     QRQ-CURRENCY                  TO    WS-CUR
           SET     QRQ-OPERATOR                  TO    TXT-OPERATOR::Text
           COMPUTE QRQ-DGN-ID                    =     FUNCTION NUMVAL ( TXT-DGN::Text )
           SET     WS-DEADLINE-ISO               TO    DTP-DEADLINE::Value

           COMPUTE QRQ-DEADLINE                  =     FUNCTION NUMVAL ( WS-DEADLINE-ISO (1:4) ) * 10000
                                                       + FUNCTION NUMVAL ( WS-DEADLINE-ISO (6:2) ) * 100
                                                       + FUNCTION NUMVAL ( WS-DEADLINE-ISO (9:2) )

           SET     QTS-STATUS                    TO    SPACES
           CALL    "QUOTE-SAVE" WITH WEBSOCKET LINKAGE
               USING BY VALUE QUO-REQ
               RETURNING QUO-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     QTS-STATUS            TO    "CALL"
           END-CALL

           EVALUATE    QTS-STATUS
               WHEN "OK"
                   CALL    "SHOW-QUOTE"
                   EVALUATE    QTS-ACTION
                       WHEN "REVISED"
                           SET     LBL-STATUS::Caption  TO    "Nova revisão gerada; as anteriores foram mantidas."
                       WHEN "NEWCURRENCY"
                           SET     LBL-STATUS::Caption  TO    "Novo orçamento criado na outra moeda; o original foi mantido."
                       WHEN OTHER
                           SET     LBL-STATUS::Caption  TO    "Orçamento gerado."
                   END-EVALUATE
               WHEN "CALL"
                   SET     LBL-STATUS::Caption   TO    "Não foi possível falar com o Backend."
               WHEN OTHER
                   SET     LBL-STATUS::Caption   TO    QTS-MESSAGE
           END-EVALUATE
]]></Event>
  </Control>
<Control id="LBL-STATUS" type="Label" x="272" y="952" w="888" h="28" tab-order="52" z-order="52" visible="true" enabled="true">
    <Property name="Caption"></Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">15</Property>
    <Property name="Bold">true</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left,Right</Property>
    <Property name="Definition">Answer of the last action: what was done or what is wrong.</Property>
  </Control>
</Form>
