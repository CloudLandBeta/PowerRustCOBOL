    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Clears the quote on the screen to start a new one.</Property>
    <Event name="onClick" paragraph="BTN-NEW--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-QUOTE-ID                   TO    0
           SET     QRQ-COUNT                     TO    0
           DG-LINES::ClearRows()
           SET     LBL-V-NUM::Caption            TO    "-"
           SET     LBL-V-CUR::Caption            TO    "-"
           SET     LBL-V-HRS::Caption            TO    "-"
           SET     LBL-V-SUB::Caption            TO    "-"
           SET     LBL-V-TAX::Caption            TO    "-"
           SET     LBL-V-TOT::Caption            TO    "-"
           SET     LBL-V-SUG::Caption            TO    "-"
           SET     LBL-V-VAL::Caption            TO    "-"
           SET     LBL-STATUS::Caption           TO    "Novo orçamento."
]]></Event>
  </Control>
