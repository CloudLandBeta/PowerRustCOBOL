<Control id="BTN-REMOVE" type="Button" x="56" y="506" w="180" h="36" tab-order="18" z-order="18" visible="true" enabled="true" parent="CARD-LINES">
    <Property name="Caption">Remover item</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Removes the selected line from the quote.</Property>
    <Event name="onClick" paragraph="BTN-REMOVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-I                          TO    DG-LINES::ClickedRow
           IF    WS-I > 0 AND WS-I NOT > QRQ-COUNT
               PERFORM VARYING WS-J FROM WS-I BY 1 UNTIL WS-J NOT < QRQ-COUNT
                   COMPUTE WS-K                  =     WS-J + 1
                   SET     QRL-KIND (WS-J)       TO    QRL-KIND (WS-K)
                   SET     QRL-CODE (WS-J)       TO    QRL-CODE (WS-K)
                   SET     QRL-QTY (WS-J)        TO    QRL-QTY (WS-K)
                   SET     QRL-HOURS (WS-J)      TO    QRL-HOURS (WS-K)
                   SET     QRL-MANUAL (WS-J)     TO    QRL-MANUAL (WS-K)
                   SET     QRL-NOTE (WS-J)       TO    QRL-NOTE (WS-K)
               END-PERFORM

               SUBTRACT 1                        FROM  QRQ-COUNT
               CALL    "REFRESH-LINES"
               SET     LBL-STATUS::Caption       TO    "Item removido."
           ELSE
               SET     LBL-STATUS::Caption       TO    "Selecione o item da lista que deseja remover."
           END-IF
]]></Event>
  </Control>
