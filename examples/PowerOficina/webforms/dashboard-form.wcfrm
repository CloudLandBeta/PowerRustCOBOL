    <Property name="CheckColor">#5B4FE9</Property>
    <Property name="CheckBoxBorderColor">#5B4FE9</Property>
    <Event name="onClick" paragraph="RDO-BRL--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-DASH: reads every figure of the dashboard for the chosen currency.
