<?xml version="1.0" encoding="UTF-8"?>
<Form name="DASHBOARD-FORM" title="Dashboard" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Dashboard of the workshop: the vehicles in service, quotes waiting for approval, services running and vehicles ready for pickup, the approval rate, the total approved and the average ticket, the quotes sent and approved by month, the most sold items, the payments and the approval channels, the installments that failed and the next delivery and pickup dates, for one currency at a time (Brazilian real or euro, never added together), through the Backend program DASH-SUMMARY. The figures refresh at regular intervals and nothing is shown that has no data behind it." index-base="1" responsive="true">
  <user-procedures>
    <Event name="LOAD-DASH" paragraph="LOAD-DASH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    DSH-REQ
           SET     DSQ-CURRENCY                  TO    "BRL"
           IF    RDO-EUR::Selected = 1
               SET     DSQ-CURRENCY              TO    "EUR"
           END-IF
           SET     DSS-STATUS                    TO    SPACES

           *> DASH-SUMMARY: every figure of the dashboard for one currency, never mixed with the other.
           *> Uses:   DSQ-CURRENCY = BRL or EUR from the two radio buttons; DSQ-ASOF = 0 (today).
           *> Result: DSS-... hold the indicators, the six months, the five top items, the payments, the channels, the failed
           *>         installments and the next dates; SHOW-DASH puts them on the screen and hides what has no data.
           CALL    "DASH-SUMMARY" WITH WEBSOCKET LINKAGE
               USING BY VALUE DSH-REQ
               RETURNING DSH-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     DSS-STATUS            TO    "CALL"
           END-CALL

           IF    DSS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
               SET     LBL-MON-EMPTY::Caption    TO    "Sem resposta do Backend."
               SET     LBL-PAY-EMPTY::Caption    TO    "Sem resposta do Backend."
           ELSE
               IF    DSS-STATUS = "OK"
                   *> SHOW-DASH: puts the indicators on the screen.
                   *> Uses:   DSS-... counters, rate, ticket and total.
                   *> Result: the cards and the total line are filled; what has no data says so.
                   CALL    "SHOW-DASH"
               ELSE
                   SET     LBL-STATUS::Caption   TO    DSS-MESSAGE
                   SET     LBL-MON-EMPTY::Caption TO   "Sem dados."
                   SET     LBL-PAY-EMPTY::Caption TO   "Sem dados."
               END-IF
           END-IF
]]></Event>
    <Event name="SHOW-DASH" paragraph="SHOW-DASH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     LBL-STATUS::Caption           TO    "-"
           STRING    "Valores em " DSS-CURRENCY ". Atualiza a cada 15 segundos."  INTO  LBL-STATUS::Caption

           SET     WS-ED-INT                     TO    DSS-VEHICLES
           SET     VAL-VEH::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-AWAITING
           SET     VAL-AWA::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-RUNNING
           SET     VAL-RUN::Caption              TO    WS-ED-INT::Trim()
           SET     WS-ED-INT                     TO    DSS-READY
           SET     VAL-RDY::Caption              TO    WS-ED-INT::Trim()

           SET     VAL-RAT::Caption              TO    "sem dados"
           SET     VAL-TIC::Caption              TO    "sem dados"
           SET     LBL-TOTAL::Caption            TO    "Nenhum orçamento aprovado ainda."
           IF    DSS-SENT > 0
               SET     WS-ED-RATE                TO    DSS-RATE
               SET     VAL-RAT::Caption          TO    "-"
               STRING    WS-ED-RATE::Trim() " %"  INTO  VAL-RAT::Caption
           END-IF
           IF    DSS-APPROVED > 0
               SET     WS-ED-AMT                 TO    DSS-TICKET
               SET     VAL-TIC::Caption          TO    "-"
               STRING    DSS-CURRENCY " " WS-ED-AMT::Trim()  INTO  VAL-TIC::Caption
               SET     WS-ED-AMT                 TO    DSS-APPROVED-TOTAL
               SET     WS-ED-INT                 TO    DSS-SENT
               SET     WS-ED-APR                 TO    DSS-APPROVED
               SET     WS-LINE                   TO    SPACES
               STRING    "Total aprovado: " DSS-CURRENCY " " WS-ED-AMT::Trim() "   (" WS-ED-APR::Trim() " aprovados de " WS-ED-INT::Trim()
                         " enviados)"  INTO  WS-LINE
               SET     LBL-TOTAL::Caption        TO    WS-LINE
           END-IF

           *> SHOW-CHARTS: draws the two charts.
           *> Uses:   DSM-... months and the payment counters of the answer.
           *> Result: CH-MONTHS and CH-PAYS are filled, or their empty notice is shown.
           CALL    "SHOW-CHARTS"
           *> SHOW-LISTS: fills the lists and the alert.
           *> Uses:   DST-... top items, DDL-... dates, the channel and failed-installment counters.
           *> Result: DG-TOP, DG-DL, LBL-CH and LBL-ALERT are filled.
           CALL    "SHOW-LISTS"
]]></Event>
    <Event name="SHOW-CHARTS" paragraph="SHOW-CHARTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CH-MONTHS::Clear()
           CH-PAYS::Clear()
           SET     LBL-MON-EMPTY::Caption        TO    "Sem orçamentos enviados ainda."
           SET     LBL-PAY-EMPTY::Caption        TO    "Sem pagamentos ainda."
           SET     LBL-MON-EMPTY::Visible        TO    1
           SET     LBL-PAY-EMPTY::Visible        TO    1

           IF    DSS-SENT > 0
               SET     LBL-MON-EMPTY::Visible    TO    0
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
                   MOVE    DSM-YM (WS-I)         TO    WS-YM-X
                   SET     WS-LABEL              TO    SPACES
                   STRING    WS-YM-X (5:2) "/" WS-YM-X (1:4)  INTO  WS-LABEL
                   SET     WS-V1                 TO    DSM-SENT (WS-I)
                   SET     WS-V2                 TO    DSM-APPROVED (WS-I)
                   CH-MONTHS::AddPoint( WS-LABEL, WS-V1, WS-V2 )
               END-PERFORM
           END-IF

           IF    DSS-PAY-CASH + DSS-PAY-INST + DSS-PAY-REFUNDED > 0
               SET     LBL-PAY-EMPTY::Visible    TO    0
               CH-PAYS::AddPoint( "À vista", DSS-PAY-CASH )
               CH-PAYS::AddPoint( "Parcelado", DSS-PAY-INST )
               CH-PAYS::AddPoint( "Estornado", DSS-PAY-REFUNDED )
           END-IF
]]></Event>
    <Event name="SHOW-LISTS" paragraph="SHOW-LISTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           DG-TOP::ClearRows()
           DG-DL::ClearRows()
           IF    DSS-TOP-COUNT = 0
               DG-TOP::AddRow( "Nenhum item vendido ainda." )
           END-IF
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DSS-TOP-COUNT
               SET     WS-ED-QTY                 TO    DST-QTY (WS-I)
               SET     WS-LINE                   TO    SPACES
               STRING    WS-ED-QTY::Trim() X"09" DST-NAME (WS-I)  INTO  WS-LINE
               DG-TOP::AddRow( WS-LINE )
           END-PERFORM

           IF    DSS-DL-COUNT = 0
               DG-DL::AddRow( "Nenhuma entrega ou retirada marcada." )
           END-IF
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DSS-DL-COUNT
               MOVE    DDL-DATE (WS-I)           TO    WS-DATE-X
               SET     WS-KIND-PT                TO    "Entrega"
               IF    DDL-KIND (WS-I) = "R"
                   SET     WS-KIND-PT            TO    "Retirada"
               END-IF
               SET     WS-LINE                   TO    SPACES
               STRING    WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4) X"09" WS-KIND-PT
                         X"09" DDL-QUO (WS-I) X"09" DDL-PLATE (WS-I)  INTO  WS-LINE
               DG-DL::AddRow( WS-LINE )
           END-PERFORM

           SET     LBL-CH::Caption               TO    "-"
           STRING    "Aprovações pelo link: " DSS-APR-LINK "   Registradas à mão: " DSS-APR-MANUAL  INTO  LBL-CH::Caption
           SET     LBL-ALERT::Caption            TO    "Nenhuma parcela recusada."
           IF    DSS-FAILED > 0 OR DSS-GAVE-UP > 0
               SET     LBL-ALERT::Caption        TO    "-"
               STRING    "ATENÇÃO: parcelas recusadas " DSS-FAILED "; desistidas após 3 tentativas " DSS-GAVE-UP
                   INTO  LBL-ALERT::Caption
           END-IF
]]></Event>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(160).
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 WS-I                                   GLOBAL    PIC 999.
       01 WS-V1                                  GLOBAL    PIC 9(6).
       01 WS-V2                                  GLOBAL    PIC 9(6).
       01 WS-YM-X                                GLOBAL    PIC X(6).
       01 WS-LABEL                               GLOBAL    PIC X(12).
       01 WS-ED-INT                              GLOBAL    PIC Z(5)9.
       01 WS-ED-APR                              GLOBAL    PIC Z(3)9.
       01 WS-ED-RATE                             GLOBAL    PIC ZZ9.9.
       01 WS-ED-QTY                              GLOBAL    PIC Z(5)9.99.
       01 WS-KIND-PT                             GLOBAL    PIC X(8).
       01 DSH-REQ                             GLOBAL.
          05 DSQ-CURRENCY                        PIC    X(3).
          05 DSQ-ASOF                            PIC    9(8).
       01 DSH-RES                             GLOBAL.
          05 DSS-STATUS                          PIC    X(10).
          05 DSS-MESSAGE                         PIC    X(80).
          05 DSS-CURRENCY                        PIC    X(3).
          05 DSS-VEHICLES                        PIC    9(4).
          05 DSS-AWAITING                        PIC    9(4).
          05 DSS-RUNNING                         PIC    9(4).
          05 DSS-READY                           PIC    9(4).
          05 DSS-SENT                            PIC    9(4).
          05 DSS-APPROVED                        PIC    9(4).
          05 DSS-RATE                            PIC    9(3)V9.
          05 DSS-APPROVED-TOTAL                  PIC    9(11)V99.
          05 DSS-TICKET                          PIC    9(9)V99.
          05 DSS-MONTH                           OCCURS 6.
             10 DSM-YM                           PIC    9(6).
             10 DSM-SENT                         PIC    9(4).
             10 DSM-APPROVED                     PIC    9(4).
          05 DSS-TOP-COUNT                       PIC    9(2).
          05 DSS-TOP                             OCCURS 5.
             10 DST-CODE                         PIC    X(12).
             10 DST-NAME                         PIC    X(40).
             10 DST-QTY                          PIC    9(6)V99.
          05 DSS-PAY-CASH                        PIC    9(4).
          05 DSS-PAY-INST                        PIC    9(4).
          05 DSS-PAY-REFUNDED                    PIC    9(4).
          05 DSS-APR-LINK                        PIC    9(4).
          05 DSS-APR-MANUAL                      PIC    9(4).
          05 DSS-FAILED                          PIC    9(4).
          05 DSS-GAVE-UP                         PIC    9(4).
          05 DSS-DL-COUNT                        PIC    9(2).
          05 DSS-DL                              OCCURS 8.
             10 DDL-DATE                         PIC    9(8).
             10 DDL-QUO                          PIC    9(8).
             10 DDL-PLATE                        PIC    X(8).
             10 DDL-KIND                         PIC    X(1).
]]></working-storage>
  <form-events>
    <Event name="onLoad" paragraph="DASHBOARD-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> DASH-SUMMARY: the dashboard is read when the screen opens (LOAD-DASH); a timer keeps it current.
           *> Uses:   the currency radio buttons (BRL at first).
           *> Result: indicators, charts and lists are filled; what has no data says so.

           *> LOAD-DASH: reads every figure of the dashboard for the chosen currency.
           *> Uses:   the BRL and EUR radio buttons.
           *> Result: the indicators, charts and lists are filled.
           CALL    "LOAD-DASH"
]]></Event>
  </form-events>
