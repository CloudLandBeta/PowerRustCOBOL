<Control id="TMR-REFRESH" type="Timer" x="1100" y="16" w="48" h="48" tab-order="6" z-order="6" visible="true" enabled="true">
    <Property name="Interval">15000</Property>
    <Property name="Enabled">1</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Timer that reads the figures again every fifteen seconds, so the dashboard follows the work without reloading the page.</Property>
    <Event name="onTick" paragraph="TMR-REFRESH--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-DASH: reads every figure of the dashboard for the chosen currency.
           *> Uses:   the BRL and EUR radio buttons.
           *> Result: the indicators, charts and lists are filled.
           CALL    "LOAD-DASH"
]]></Event>
  </Control>
