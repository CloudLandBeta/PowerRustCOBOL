<?xml version="1.0" encoding="UTF-8"?>
<Form name="DIAGNOSTICO-FORM" title="Diagnóstico" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Diagnosis screen of the workshop: collects the vehicle readings (simulated connection, may drop and be finished by hand) or takes them typed, through the Backend program DIAG-COLLECT." index-base="1" responsive="true">
  <user-procedures>
    <Event name="SHOW-RESULT" paragraph="SHOW-RESULT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           EVALUATE    DCS-STATUS
               WHEN "OK"
               WHEN "PARTIAL"
                   IF    DCS-STATUS = "PARTIAL"
                       SET     WS-DIAG-ID        TO    DCS-ID
                       SET     LBL-STATUS::Caption  TO    DCS-MESSAGE
                   ELSE
                       SET     WS-DIAG-ID        TO    0
                       SET     LBL-STATUS::Caption  TO    "Diagnóstico gravado."
                   END-IF

                   SET     LBL-V-ID::Caption     TO    DCS-ID
                   SET     LBL-V-MODEL::Caption  TO    DCS-MODEL
                   IF    DCS-SOURCE = "M"
                       SET     LBL-V-SRC::Caption  TO  "Digitado à mão"
                   ELSE
                       SET     LBL-V-SRC::Caption  TO  "Coletado do veículo"
                   END-IF

                   SET     WS-EDIT-TEMP          TO    DCS-ENGINE-TEMP
                   SET     WS-EDIT-RPM           TO    DCS-RPM
                   SET     WS-EDIT-BATTERY       TO    DCS-BATTERY
                   SET     WS-EDIT-OIL           TO    DCS-OIL-PRESSURE
                   STRING    WS-EDIT-TEMP " °C"  INTO  LBL-V-TEMP::Caption
                   STRING    WS-EDIT-RPM " rpm"  INTO  LBL-V-RPM::Caption
                   STRING    WS-EDIT-BATTERY " V"  INTO  LBL-V-BAT::Caption
                   STRING    WS-EDIT-OIL " kPa"  INTO  LBL-V-OIL::Caption
                   SET     LBL-V-FLT::Caption    TO    "-"
                   IF    DCS-FAULT-1 NOT = SPACES
                       STRING    DCS-FAULT-1 " " DCS-FAULT-2  INTO  LBL-V-FLT::Caption
                   END-IF
               WHEN "CALL"
                   SET     LBL-STATUS::Caption   TO    "Não foi possível falar com o Backend."
               WHEN OTHER
                   SET     LBL-STATUS::Caption   TO    DCS-MESSAGE
           END-EVALUATE
]]></Event>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(120).
       01 WS-DIAG-ID                             GLOBAL    PIC 9(8)    VALUE 0.
       01 WS-EDIT-TEMP                           GLOBAL    PIC ZZ9.
       01 WS-EDIT-RPM                            GLOBAL    PIC ZZZZ9.
       01 WS-EDIT-BATTERY                        GLOBAL    PIC Z9.9.
       01 WS-EDIT-OIL                            GLOBAL    PIC ZZ9.9.
       01 DGC-REQ                             GLOBAL.
          05 DCQ-PLATE                           PIC    X(8).
          05 DCQ-OPERATOR                        PIC    X(30).
          05 DCQ-MODE                            PIC    X(1).
          05 DCQ-ID                              PIC    9(8).
          05 DCQ-INTERRUPT-AFTER                 PIC    9(1).
          05 DCQ-ENGINE-TEMP                     PIC    9(3).
          05 DCQ-RPM                             PIC    9(5).
          05 DCQ-BATTERY                         PIC    9(2)V9.
          05 DCQ-OIL-PRESSURE                    PIC    9(3)V9.
          05 DCQ-FAULT-1                         PIC    X(8).
          05 DCQ-FAULT-2                         PIC    X(8).
          05 DCQ-FAULT-3                         PIC    X(8).
          05 DCQ-FAULT-4                         PIC    X(8).
          05 DCQ-FAULT-5                         PIC    X(8).
       01 DGC-RES                             GLOBAL.
          05 DCS-STATUS                          PIC    X(10).
          05 DCS-MESSAGE                         PIC    X(80).
          05 DCS-FIELD                           PIC    X(10).
          05 DCS-ID                              PIC    9(8).
          05 DCS-AT                              PIC    9(14).
          05 DCS-SOURCE                          PIC    X(1).
          05 DCS-MODEL                           PIC    X(30).
          05 DCS-COLLECTED                       PIC    9(1).
          05 DCS-ENGINE-TEMP                     PIC    9(3).
          05 DCS-RPM                             PIC    9(5).
          05 DCS-BATTERY                         PIC    9(2)V9.
          05 DCS-OIL-PRESSURE                    PIC    9(3)V9.
          05 DCS-FAULT-1                         PIC    X(8).
          05 DCS-FAULT-2                         PIC    X(8).
          05 DCS-FAULT-3                         PIC    X(8).
          05 DCS-FAULT-4                         PIC    X(8).
          05 DCS-FAULT-5                         PIC    X(8).
]]></working-storage>
