<Control id="BTN-MANUAL" type="Button" x="56" y="684" w="200" h="40" tab-order="25" z-order="25" visible="true" enabled="true" parent="CARD-MAN">
    <Property name="Caption">Gravar manualmente</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Saves the typed readings, completing the pending partial collection when there is one.</Property>
    <Event name="onClick" paragraph="BTN-MANUAL--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> DIAG-COLLECT: saves hand-typed readings (mode M); with WS-DIAG-ID set it completes that
           *> partial collection instead of making a new diagnosis.
           *> Uses:   DCQ-PLATE = TXT-PLATE; DCQ-MODE = "M"; DCQ-ID = WS-DIAG-ID (0 = new); the readings
           *>         typed in the boxes above and one fault code.
           *> Result: DCS-STATUS = OK or what is wrong (field in DCS-FIELD); the saved diagnosis is shown below.

           INITIALIZE    DGC-REQ
           SET     DCQ-PLATE                     TO    TXT-PLATE::Text
           SET     DCQ-OPERATOR                  TO    TXT-OPERATOR::Text
           SET     DCQ-MODE                      TO    "M"
           SET     DCQ-ID                        TO    WS-DIAG-ID
           SET     DCQ-FAULT-1                   TO    TXT-FAULTS::Text
           COMPUTE DCQ-ENGINE-TEMP               =     FUNCTION NUMVAL ( TXT-TEMP::Text )
           COMPUTE DCQ-RPM                       =     FUNCTION NUMVAL ( TXT-RPM::Text )
           COMPUTE DCQ-BATTERY                   =     FUNCTION NUMVAL ( TXT-BATTERY::Text )
           COMPUTE DCQ-OIL-PRESSURE              =     FUNCTION NUMVAL ( TXT-OIL::Text )
           SET     DCS-STATUS                    TO    SPACES
           CALL    "DIAG-COLLECT" WITH WEBSOCKET LINKAGE
               USING BY VALUE DGC-REQ
               RETURNING DGC-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     DCS-STATUS            TO    "CALL"
           END-CALL

           *> SHOW-RESULT: paints the answer of DIAG-COLLECT on the result card and the status line.
           *> Uses:   DCS-... = the answer just received; DCS-STATUS decides what is shown.
           *> Result: LBL-V-... captions and LBL-STATUS::Caption are set; WS-DIAG-ID keeps the number of
           *>         a partial collection (0 otherwise) so the manual entry can complete it.

           CALL    "SHOW-RESULT"
]]></Event>
  </Control>
