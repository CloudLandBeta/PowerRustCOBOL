<?xml version="1.0" encoding="UTF-8"?>
<Form name="ATENDIMENTOS-FORM" title="Atendimentos" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Intake screen of the workshop: finds a vehicle by plate, registers or changes the customer (with consent per channel) and the vehicle, through the Backend programs VEHICLE-FIND, CUSTOMER-SAVE and VEHICLE-SAVE." index-base="1" responsive="true">
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(120).
       01 WS-CUS-ID                              GLOBAL    PIC 9(8)    VALUE 0.
       01 CUS-REQ                             GLOBAL.
          05 CRQ-ID                              PIC    9(8).
          05 CRQ-NAME                            PIC    X(60).
          05 CRQ-DOC                             PIC    X(14).
          05 CRQ-ADDRESS                         PIC    X(80).
          05 CRQ-PHONE                           PIC    X(20).
          05 CRQ-WHATSAPP                        PIC    X(20).
          05 CRQ-EMAIL                           PIC    X(60).
          05 CRQ-CONSENT-EMAIL                   PIC    X(1).
          05 CRQ-CONSENT-WA                      PIC    X(1).
          05 CRQ-OPERATOR                        PIC    X(30).
       01 CUS-RES                             GLOBAL.
          05 CRS-STATUS                          PIC    X(10).
          05 CRS-MESSAGE                         PIC    X(80).
          05 CRS-FIELD                           PIC    X(10).
          05 CRS-ID                              PIC    9(8).
       01 VEH-REQ                             GLOBAL.
          05 VRQ-PLATE                           PIC    X(8).
          05 VRQ-CUS-ID                          PIC    9(8).
          05 VRQ-CHASSIS                         PIC    X(17).
          05 VRQ-BRAND                           PIC    X(20).
          05 VRQ-MODEL                           PIC    X(30).
          05 VRQ-YEAR                            PIC    9(4).
          05 VRQ-COLOR                           PIC    X(15).
          05 VRQ-MILEAGE                         PIC    9(7).
          05 VRQ-OPERATOR                        PIC    X(30).
       01 VEH-RES                             GLOBAL.
          05 VRS-STATUS                          PIC    X(10).
          05 VRS-MESSAGE                         PIC    X(80).
          05 VRS-FIELD                           PIC    X(10).
          05 VRS-ACTION                          PIC    X(8).
          05 VRS-PLATE                           PIC    X(8).
       01 VFD-REQ                             GLOBAL.
          05 VFQ-PLATE                           PIC    X(8).
       01 VFD-RES                             GLOBAL.
          05 VFS-STATUS                          PIC    X(10).
          05 VFS-PLATE                           PIC    X(8).
          05 VFS-CHASSIS                         PIC    X(17).
          05 VFS-BRAND                           PIC    X(20).
          05 VFS-MODEL                           PIC    X(30).
          05 VFS-YEAR                            PIC    9(4).
          05 VFS-COLOR                           PIC    X(15).
          05 VFS-MILEAGE                         PIC    9(7).
          05 VFS-CUS-ID                          PIC    9(8).
          05 VFS-CUS-NAME                        PIC    X(60).
          05 VFS-CUS-DOC                         PIC    X(14).
          05 VFS-CUS-ADDRESS                     PIC    X(80).
          05 VFS-CUS-PHONE                       PIC    X(20).
          05 VFS-CUS-WHATSAPP                    PIC    X(20).
          05 VFS-CUS-EMAIL                       PIC    X(60).
          05 VFS-CUS-CONSENT-EMAIL               PIC    X(1).
          05 VFS-CUS-CONSENT-WA                  PIC    X(1).
]]></working-storage>
