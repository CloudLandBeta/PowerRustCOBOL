<Control id="BTN-SAVE" type="Button" x="32" y="732" w="200" h="44" tab-order="39" z-order="39" visible="true" enabled="true">
    <Property name="Caption">Salvar atendimento</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Saves the customer and then the vehicle through the Backend and says how it went.</Property>
    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> CUSTOMER-SAVE: validates and saves the customer (new, or changed when CRQ-ID is set).
           *> Uses:   CRQ-... = the customer fields typed on the screen and the consent boxes
           *>         (S or N); CRQ-ID = WS-CUS-ID (0 for a new customer); CRQ-OPERATOR.
           *> Result: CRS-STATUS = OK, INVALID, DUPLICATE or ERROR; with OK, CRS-ID is the number.

           INITIALIZE    CUS-REQ
           SET     CRQ-ID                        TO    WS-CUS-ID
           SET     CRQ-NAME                      TO    TXT-NAME::Text
           SET     CRQ-DOC                       TO    TXT-DOC::Text
           SET     CRQ-ADDRESS                   TO    TXT-ADDRESS::Text
           SET     CRQ-PHONE                     TO    TXT-PHONE::Text
           SET     CRQ-WHATSAPP                  TO    TXT-WHATSAPP::Text
           SET     CRQ-EMAIL                     TO    TXT-EMAIL::Text
           SET     CRQ-OPERATOR                  TO    TXT-OPERATOR::Text
           IF    CHK-EMAIL::Checked = 1
               SET     CRQ-CONSENT-EMAIL         TO    "S"
           ELSE
               SET     CRQ-CONSENT-EMAIL         TO    "N"
           END-IF

           IF    CHK-WA::Checked = 1
               SET     CRQ-CONSENT-WA            TO    "S"
           ELSE
               SET     CRQ-CONSENT-WA            TO    "N"
           END-IF

           SET     CRS-STATUS                    TO    SPACES
           CALL    "CUSTOMER-SAVE" WITH WEBSOCKET LINKAGE
               USING BY VALUE CUS-REQ
               RETURNING CUS-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     CRS-STATUS            TO    "CALL"
           END-CALL

           EVALUATE    CRS-STATUS
               WHEN "OK"
                   SET     WS-CUS-ID             TO    CRS-ID

                   *> VEHICLE-SAVE: saves the vehicle for that customer (the plate decides new or changed).
                   *> Uses:   VRQ-... = the vehicle fields typed on the screen; VRQ-CUS-ID = WS-CUS-ID,
                   *>         the customer just saved; VRQ-OPERATOR.
                   *> Result: VRS-STATUS = OK, INVALID, NOCUSTOMER or ERROR; VRS-ACTION = CREATED or UPDATED.

                   INITIALIZE    VEH-REQ
                   SET     VRQ-PLATE             TO    TXT-PLATE::Text
                   SET     VRQ-CUS-ID            TO    WS-CUS-ID
                   SET     VRQ-CHASSIS           TO    TXT-CHASSIS::Text
                   SET     VRQ-BRAND             TO    TXT-BRAND::Text
                   SET     VRQ-MODEL             TO    TXT-MODEL::Text
                   SET     VRQ-COLOR             TO    TXT-COLOR::Text
                   SET     VRQ-OPERATOR          TO    TXT-OPERATOR::Text
                   COMPUTE VRQ-YEAR              =     FUNCTION NUMVAL ( TXT-YEAR::Text )
                   COMPUTE VRQ-MILEAGE           =     FUNCTION NUMVAL ( TXT-MILEAGE::Text )
                   SET     VRS-STATUS            TO    SPACES
                   CALL    "VEHICLE-SAVE" WITH WEBSOCKET LINKAGE
                       USING BY VALUE VEH-REQ
                       RETURNING VEH-RES
                       ON EXCEPTION
                           COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                           SET     VRS-STATUS    TO    "CALL"
                   END-CALL

                   IF    VRS-STATUS = "OK"
                       SET     LBL-STATUS::Caption  TO    "Cliente e veículo salvos."
                   ELSE
                       IF    VRS-STATUS = "CALL"
                           SET     LBL-STATUS::Caption  TO    "Não foi possível falar com o Backend."
                       ELSE
                           SET     LBL-STATUS::Caption  TO    VRS-MESSAGE
                       END-IF
                   END-IF
               WHEN "CALL"
                   SET     LBL-STATUS::Caption   TO    "Não foi possível falar com o Backend."
               WHEN OTHER
                   SET     LBL-STATUS::Caption   TO    CRS-MESSAGE
           END-EVALUATE
]]></Event>
  </Control>
<Control id="LBL-STATUS" type="Label" x="252" y="742" w="908" h="28" tab-order="40" z-order="40" visible="true" enabled="true">
    <Property name="Caption"></Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">15</Property>
    <Property name="Bold">true</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left,Right</Property>
    <Property name="Definition">Answer of the last action: found, saved or what is wrong with the data.</Property>
  </Control>
</Form>
