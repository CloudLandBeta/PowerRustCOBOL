  </Control>
<Control id="BTN-FIND" type="Button" x="616" y="140" w="160" h="40" tab-order="8" z-order="8" visible="true" enabled="true" parent="CARD-FIND">
    <Property name="Caption">Buscar</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#5B4FE9FF</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Looks the plate up through the Backend and fills the screen when the vehicle is known.</Property>
    <Event name="onClick" paragraph="BTN-FIND--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> VEHICLE-FIND: looks the plate up and answers the vehicle with its owner.
           *> Uses:   VFQ-PLATE = the plate typed in TXT-PLATE.
           *> Result: VFS-STATUS = FOUND, NOTFOUND or INVALID; with FOUND the vehicle and owner
           *>         fields (VFS-...) are filled; WS-CUS-ID takes the owner's number.

           SET     VFQ-PLATE                     TO    TXT-PLATE::Text
           SET     VFS-STATUS                    TO    SPACES
           CALL    "VEHICLE-FIND" WITH WEBSOCKET LINKAGE
               USING BY VALUE VFD-REQ
               RETURNING VFD-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )
                   SET     VFS-STATUS            TO    "CALL"
           END-CALL

           EVALUATE    VFS-STATUS
               WHEN "FOUND"
                   SET     WS-CUS-ID             TO    VFS-CUS-ID
                   SET     TXT-NAME::Text        TO    VFS-CUS-NAME
                   SET     TXT-DOC::Text         TO    VFS-CUS-DOC
                   SET     TXT-ADDRESS::Text     TO    VFS-CUS-ADDRESS
                   SET     TXT-PHONE::Text       TO    VFS-CUS-PHONE
                   SET     TXT-WHATSAPP::Text    TO    VFS-CUS-WHATSAPP
                   SET     TXT-EMAIL::Text       TO    VFS-CUS-EMAIL
                   IF    VFS-CUS-CONSENT-EMAIL = "S"
                       SET     CHK-EMAIL::Checked  TO    1
                   ELSE
                       SET     CHK-EMAIL::Checked  TO    0
                   END-IF
                   IF    VFS-CUS-CONSENT-WA = "S"
                       SET     CHK-WA::Checked  TO    1
                   ELSE
                       SET     CHK-WA::Checked  TO    0
                   END-IF
                   SET     TXT-CHASSIS::Text     TO    VFS-CHASSIS
                   SET     TXT-BRAND::Text       TO    VFS-BRAND
                   SET     TXT-MODEL::Text       TO    VFS-MODEL
                   SET     TXT-YEAR::Text        TO    VFS-YEAR
                   SET     TXT-COLOR::Text       TO    VFS-COLOR
                   SET     TXT-MILEAGE::Text     TO    VFS-MILEAGE
                   SET     LBL-STATUS::Caption   TO    "Veículo encontrado. Confira os dados e altere o que precisar."
               WHEN "NOTFOUND"
                   SET     WS-CUS-ID             TO    0
                   SET     LBL-STATUS::Caption   TO    "Placa nova: preencha o cliente e o veículo."
               WHEN "INVALID"
                   SET     LBL-STATUS::Caption   TO    "A placa deve ter 7 letras ou números."
               WHEN OTHER
                   SET     LBL-STATUS::Caption   TO    "Não foi possível falar com o Backend."
           END-EVALUATE
]]></Event>
  </Control>
