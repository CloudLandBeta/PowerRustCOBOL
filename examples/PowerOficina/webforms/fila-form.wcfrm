<Control id="CARD-DL" type="Panel" x="32" y="564" w="1128" h="150" tab-order="17" z-order="17" visible="true" enabled="true">
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#ECEEF5</Property>
    <Property name="CornerRadius">16</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Card to change the delivery date of an order.</Property>
  </Control>
