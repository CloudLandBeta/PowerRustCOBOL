    <Property name="FontSize">13</Property>
    <Property name="Bold">false</Property>
    <Property name="BackgroundColor">#FFFFFF00</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Caption of the new delivery date field. It belongs to a screen of the PowerOficina workshop application.</Property>
  </Control>
<Control id="TXT-DATE" type="TextBox" x="226" y="634" w="200" h="38" tab-order="22" z-order="22" visible="true" enabled="true" parent="CARD-DL">
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="ForegroundColor">#1E1B4BFF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#D5D8E6</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="FontSize">14</Property>
    <Property name="HintText">31/12/2026</Property>
    <Property name="AccessibleLabel">New delivery date, day, month and year with slashes.</Property>
    <Property name="InnerPadding">8</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">New delivery date, day, month and year with slashes.</Property>
  </Control>
<Control id="BTN-DATE" type="Button" x="446" y="632" w="300" h="42" tab-order="23" z-order="23" visible="true" enabled="true" parent="CARD-DL">
    <Property name="Caption">Alterar data e avisar cliente</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="BackgroundColor">#EEEDFDFF</Property>
    <Property name="ForegroundColor">#4338CAFF</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#EEEDFD</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Changes the delivery date of the services still open and tells the customer the date to come back.</Property>
    <Event name="onClick" paragraph="BTN-DATE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-ACTION                     TO    "D"

           *> DO-UPDATE: starts or finishes the selected service, or changes the delivery date.
           *> Uses:   WS-ACTION (S, F or D), the selected row, TXT-QUO and TXT-DATE.
           *> Result: the queue is read again and the status line shows the answer.
           CALL    "DO-UPDATE"
]]></Event>
  </Control>
<Control id="TMR-REFRESH" type="Timer" x="1100" y="20" w="48" h="48" tab-order="24" z-order="24" visible="true" enabled="true">
    <Property name="Interval">15000</Property>
    <Property name="Enabled">1</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Definition">Timer that reads the queue again every fifteen seconds, so the list follows the work without reloading the page.</Property>
    <Event name="onTick" paragraph="TMR-REFRESH--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> LOAD-QUEUE: reads the queue again from the Backend.
           *> Uses:   the filter radio buttons.
           *> Result: DG-QUEUE and the counters in LBL-STATUS are filled.
           CALL    "LOAD-QUEUE"
]]></Event>
  </Control>
</Form>
