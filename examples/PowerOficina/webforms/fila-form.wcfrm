<?xml version="1.0" encoding="UTF-8"?>
<Form name="FILA-FORM" title="Fila de execução" width="1192" height="852" background="#F7F8FCFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded" definition="Execution queue screen of the workshop: lists the paid services ordered by priority and approval, starts and finishes a service with the operator and time recorded, warns when the vehicle is ready for pickup, and changes the delivery date of an order, through the Backend programs QUEUE-LIST and QUEUE-UPDATE. The list refreshes itself at regular intervals." index-base="1" responsive="true">
  <user-procedures>
    <Event name="LOAD-QUEUE" paragraph="LOAD-QUEUE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QLN-REQ

           IF    RDO-ALL::Selected = 1
               SET     QLQ-FILTER                TO    "ALL"
           END-IF
           IF    RDO-DONE::Selected = 1
               SET     QLQ-FILTER                TO    "DONE"
           END-IF
           IF    RDO-REFUNDED::Selected = 1
               SET     QLQ-FILTER                TO    "REFUNDED"
           END-IF

           SET     QLS-STATUS                    TO    SPACES

           *> QUEUE-LIST: the services of the queue, by priority and approval, for the filter chosen.
           *> Uses:   QLQ-FILTER = blank (waiting and running), ALL, DONE or REFUNDED, from the radio buttons.
           *> Result: QLR-... hold up to 40 rows (number, quote, vehicle, service, state, priority, delivery date, ready);
           *>         QLS-COUNT, QLS-QUEUED, QLS-RUNNING and QLS-READY count them; DG-QUEUE shows them.
           CALL    "QUEUE-LIST" WITH WEBSOCKET LINKAGE
               USING BY VALUE QLN-REQ
               RETURNING QLN-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )

                   SET     QLS-STATUS            TO    "CALL"
           END-CALL

           IF    QLS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               *> SHOW-QUEUE: lists the rows of the last queue answer.
               *> Uses:   QLR-... rows, QLS-COUNT and the counters QLS-QUEUED, QLS-RUNNING and QLS-READY.
               *> Result: DG-QUEUE, WS-QID and the status line are filled.
               CALL    "SHOW-QUEUE"
           END-IF
]]></Event>
    <Event name="SHOW-QUEUE" paragraph="SHOW-QUEUE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           DG-QUEUE::ClearRows()

           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QLS-COUNT
               SET     WS-QID (WS-I)             TO    QLR-ID (WS-I)
               SET     WS-QUO (WS-I)             TO    QLR-QUO-ID (WS-I)

               EVALUATE    QLR-STATE (WS-I)
                   WHEN "QUEUED"
                       SET     WS-STATE-PT       TO    "Na fila"
                   WHEN "RUNNING"
                       SET     WS-STATE-PT       TO    "Em execução"
                   WHEN "DONE"
                       SET     WS-STATE-PT       TO    "Concluído"
                   WHEN OTHER
                       SET     WS-STATE-PT       TO    "Estornado"
               END-EVALUATE

               MOVE    QLR-DEADLINE (WS-I)       TO    WS-DATE-X

               SET     WS-RDY                    TO    SPACES

               IF    QLR-READY (WS-I) = "Y"
                   SET     WS-RDY                TO    "PRONTO PARA RETIRADA"
               END-IF

               SET     WS-LINE                   TO    SPACES

               STRING    QLR-ID (WS-I) X"09" QLR-PLATE (WS-I) X"09" QLR-SERVICE (WS-I) X"09" WS-STATE-PT X"09"
                         WS-DATE-X (7:2) "/" WS-DATE-X (5:2) "/" WS-DATE-X (1:4) X"09" WS-RDY
                   INTO  WS-LINE

               DG-QUEUE::AddRow( WS-LINE )
           END-PERFORM

           SET     LBL-STATUS::Caption           TO    "-"
           SET     WS-ED-N1                      TO    QLS-QUEUED
           SET     WS-ED-N2                      TO    QLS-RUNNING
           SET     WS-ED-N3                      TO    QLS-READY

           STRING    "Na fila: " WS-ED-N1::Trim() "   Em execução: " WS-ED-N2::Trim() "   Veículos prontos: " WS-ED-N3::Trim()
               INTO  LBL-STATUS::Caption
]]></Event>
    <Event name="DO-UPDATE" paragraph="DO-UPDATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INITIALIZE    QUN-REQ

           SET     QUQ-ACTION                    TO    WS-ACTION
           SET     QUQ-OPERATOR                  TO    TXT-OPERATOR::Text
           SET     WS-I                          TO    DG-QUEUE::ClickedRow

           IF    WS-I > 0 AND WS-I NOT > QLS-COUNT
               SET     QUQ-QUE-ID                TO    WS-QID (WS-I)
           END-IF

           COMPUTE QUQ-QUO-ID                    =     FUNCTION NUMVAL ( TXT-QUO::Text )
               ON SIZE ERROR
                   CONTINUE
           END-COMPUTE

           SET     WS-DATE-IN                    TO    TXT-DATE::Text

           COMPUTE QUQ-DEADLINE                  =     FUNCTION NUMVAL ( WS-DATE-IN (7:4) ) * 10000
                                                       + FUNCTION NUMVAL ( WS-DATE-IN (4:2) ) * 100
                                                       + FUNCTION NUMVAL ( WS-DATE-IN (1:2) )

           SET     QUS-STATUS                    TO    SPACES

           *> QUEUE-UPDATE: starts (S) or finishes (F) the selected service, or changes the delivery date of an order (D).
           *> Uses:   WS-ACTION = S, F or D; QUQ-QUE-ID = the number of the selected row of DG-QUEUE; for D, QUQ-QUO-ID = TXT-QUO
           *>         and QUQ-DEADLINE = TXT-DATE read as dd/mm/aaaa; QUQ-OPERATOR = TXT-OPERATOR.
           *> Result: QUS-STATUS = OK, INVALID or NOTFOUND with QUS-MESSAGE; the time and the operator are written on the row; when
           *>         the last service of an order is done QUS-READY = Y and the customer is told the vehicle is ready; with D the
           *>         customer is told the new date.
           CALL    "QUEUE-UPDATE" WITH WEBSOCKET LINKAGE
               USING BY VALUE QUN-REQ
               RETURNING QUN-RES
               ON EXCEPTION
                   COBOL::"WS-LAST-ERROR" ( BE-CLASS BE-CODE BE-MSG )

                   SET     QUS-STATUS            TO    "CALL"
           END-CALL

           IF    QUS-STATUS = "CALL"
               SET     LBL-STATUS::Caption       TO    "Não foi possível falar com o Backend."
           ELSE
               *> LOAD-QUEUE: reads the queue again from the Backend.
               *> Uses:   the filter radio buttons.
               *> Result: DG-QUEUE and the counters in LBL-STATUS are filled.
               CALL    "LOAD-QUEUE"

               SET     LBL-STATUS::Caption       TO    QUS-MESSAGE
           END-IF
]]></Event>
  </user-procedures>
  <working-storage><![CDATA[       01 BE-CLASS                               GLOBAL    PIC X(16).
       01 BE-CODE                                GLOBAL    PIC 9(9).
       01 BE-MSG                                 GLOBAL    PIC X(80).
       01 WS-LINE                                GLOBAL    PIC X(160).
       01 WS-ED-AMT                              GLOBAL    PIC Z(8)9.99.
       01 WS-DATE-X                              GLOBAL    PIC X(8).
       01 WS-I                                   GLOBAL    PIC 999.
       01 WS-ACTION                              GLOBAL    PIC X(1).
       01 WS-QID                                 GLOBAL    PIC 9(8)    OCCURS 40.
       01 WS-QUO                                 GLOBAL    PIC 9(8)    OCCURS 40.
       01 WS-DATE-IN                             GLOBAL    PIC X(10).
       01 WS-STATE-PT                            GLOBAL    PIC X(13).
       01 WS-RDY                                 GLOBAL    PIC X(24).
       01 WS-ED-N1                               GLOBAL    PIC Z(2)9.
       01 WS-ED-N2                               GLOBAL    PIC Z(2)9.
       01 WS-ED-N3                               GLOBAL    PIC Z(2)9.
       01 QLN-REQ                             GLOBAL.
          05 QLQ-FILTER                          PIC    X(10).
       01 QLN-RES                             GLOBAL.
          05 QLS-STATUS                          PIC    X(10).
          05 QLS-MESSAGE                         PIC    X(80).
          05 QLS-COUNT                           PIC    9(3).
          05 QLS-READY                           PIC    9(3).
          05 QLS-RUNNING                         PIC    9(3).
          05 QLS-QUEUED                          PIC    9(3).
          05 QLS-ROW                             OCCURS 40.
             10 QLR-ID                           PIC    9(8).
             10 QLR-QUO-ID                       PIC    9(8).
             10 QLR-PLATE                        PIC    X(8).
             10 QLR-SERVICE                      PIC    X(40).
             10 QLR-STATE                        PIC    X(10).
             10 QLR-PRIORITY                     PIC    9(2).
             10 QLR-APPROVED-AT                  PIC    9(14).
             10 QLR-DEADLINE                     PIC    9(8).
             10 QLR-READY                        PIC    X(1).
       01 QUN-REQ                             GLOBAL.
          05 QUQ-ACTION                          PIC    X(1).
          05 QUQ-QUE-ID                          PIC    9(8).
          05 QUQ-QUO-ID                          PIC    9(8).
          05 QUQ-DEADLINE                        PIC    9(8).
          05 QUQ-OPERATOR                        PIC    X(30).
       01 QUN-RES                             GLOBAL.
          05 QUS-STATUS                          PIC    X(10).
          05 QUS-MESSAGE                         PIC    X(80).
          05 QUS-QUO-ID                          PIC    9(8).
          05 QUS-STATE                           PIC    X(10).
          05 QUS-READY                           PIC    X(1).
          05 QUS-CHANGED                         PIC    9(3).
]]></working-storage>
  <form-events>
    <Event name="onLoad" paragraph="FILA-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> QUEUE-LIST: the queue is read when the screen opens (LOAD-QUEUE); a timer keeps it current.
           *> Uses:   the filter radio buttons (waiting and running at first).
           *> Result: DG-QUEUE is filled.

           *> LOAD-QUEUE: reads the queue again from the Backend.
           *> Uses:   the filter radio buttons.
           *> Result: DG-QUEUE and the counters in LBL-STATUS are filled.
           CALL    "LOAD-QUEUE"
]]></Event>
  </form-events>
