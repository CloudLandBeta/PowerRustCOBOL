<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="TOKEN-FILE" finalized="false" version="1.0">
<assign-path>data/tokens.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="63"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[Approval link: a single-use token with an expiry and the short code the customer types on the approval page.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="TOK-TOKEN" offset="0" length="32" encoding="bytes"/></primary><alternate name="TOK-QUO-ID" duplicates="true" ordering="ascending"><part field="TOK-QUO-ID" offset="32" length="8" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="TOKEN-RECORD" usage="display">
<Field level="5" name="TOK-TOKEN" pic="X(32)" usage="display" offset="0" length="32">
<comment><![CDATA[Primary key]]></comment>
</Field>
<Field level="5" name="TOK-QUO-ID" pic="9(8)" usage="display" offset="32" length="8">
</Field>
<Field level="5" name="TOK-REV" pic="9(2)" usage="display" offset="40" length="2">
</Field>
<Field level="5" name="TOK-CODE" pic="X(6)" usage="display" offset="42" length="6">
<comment><![CDATA[Short code typed by the customer]]></comment>
</Field>
<Field level="5" name="TOK-EXPIRES" pic="9(14)" usage="display" offset="48" length="14">
</Field>
<Field level="5" name="TOK-USED" pic="X(1)" usage="display" offset="62" length="1">
<comment><![CDATA[S once used]]></comment>
</Field>
</Field>
</fields>
</IndexedFile>
