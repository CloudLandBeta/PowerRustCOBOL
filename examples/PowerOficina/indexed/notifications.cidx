<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="NOTIFY-FILE" finalized="false" version="1.0">
<assign-path>data/notifications.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="318"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[Every message the application sends to a customer. In this version delivery is simulated: the message is recorded as sent and nothing leaves the application.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="NTF-ID" offset="0" length="8" encoding="bytes"/></primary><alternate name="NTF-QUO-ID" duplicates="true" ordering="ascending"><part field="NTF-QUO-ID" offset="8" length="8" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="NOTIFY-RECORD" usage="display">
<Field level="5" name="NTF-ID" pic="9(8)" usage="display" offset="0" length="8">
<comment><![CDATA[Primary key]]></comment>
</Field>
<Field level="5" name="NTF-QUO-ID" pic="9(8)" usage="display" offset="8" length="8">
</Field>
<Field level="5" name="NTF-CHANNEL" pic="X(8)" usage="display" offset="16" length="8">
<comment><![CDATA[EMAIL or WHATSAPP]]></comment>
</Field>
<Field level="5" name="NTF-KIND" pic="X(12)" usage="display" offset="24" length="12">
<comment><![CDATA[QUOTE, RECEIPT, PICKUP, READY, REFUND or ALERT]]></comment>
</Field>
<Field level="5" name="NTF-TO" pic="X(60)" usage="display" offset="36" length="60">
</Field>
<Field level="5" name="NTF-AT" pic="9(14)" usage="display" offset="96" length="14">
</Field>
<Field level="5" name="NTF-STATUS" pic="X(8)" usage="display" offset="110" length="8">
<comment><![CDATA[SENT or FAILED]]></comment>
</Field>
<Field level="5" name="NTF-TEXT" pic="X(200)" usage="display" offset="118" length="200">
</Field>
</Field>
</fields>
</IndexedFile>
