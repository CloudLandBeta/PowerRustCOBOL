<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="PAYMENT-FILE" finalized="false" version="1.0">
<assign-path>data/payments.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="126"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[One card contract per approved quote. The card number and the security code are never stored: only the brand, the last four digits and the gateway reference.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="PAY-ID" offset="0" length="8" encoding="bytes"/></primary><alternate name="PAY-QUO-ID" duplicates="true" ordering="ascending"><part field="PAY-QUO-ID" offset="8" length="8" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="PAYMENT-RECORD" usage="display">
<Field level="5" name="PAY-ID" pic="9(8)" usage="display" offset="0" length="8">
<comment><![CDATA[Primary key]]></comment>
</Field>
<Field level="5" name="PAY-QUO-ID" pic="9(8)" usage="display" offset="8" length="8">
</Field>
<Field level="5" name="PAY-CURRENCY" pic="X(3)" usage="display" offset="16" length="3">
</Field>
<Field level="5" name="PAY-TOTAL" pic="9(9)V99" usage="display" offset="19" length="11">
</Field>
<Field level="5" name="PAY-INSTALLMENTS" pic="9(2)" usage="display" offset="30" length="2">
<comment><![CDATA[1 to 12, no interest]]></comment>
</Field>
<Field level="5" name="PAY-CARD-BRAND" pic="X(12)" usage="display" offset="32" length="12">
</Field>
<Field level="5" name="PAY-CARD-LAST4" pic="X(4)" usage="display" offset="44" length="4">
</Field>
<Field level="5" name="PAY-GW-REF" pic="X(40)" usage="display" offset="48" length="40">
<comment><![CDATA[Gateway transaction or recurring authorisation]]></comment>
</Field>
<Field level="5" name="PAY-STATUS" pic="X(10)" usage="display" offset="88" length="10">
<comment><![CDATA[PENDING, ACTIVE, PAID, FAILED or REFUNDED]]></comment>
</Field>
<Field level="5" name="PAY-CONSENT-AT" pic="9(14)" usage="display" offset="98" length="14">
<comment><![CDATA[When the customer agreed to the future charges]]></comment>
</Field>
<Field level="5" name="PAY-AT" pic="9(14)" usage="display" offset="112" length="14">
</Field>
</Field>
</fields>
</IndexedFile>
