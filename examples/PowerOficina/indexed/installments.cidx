<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="INSTALLMENT-FILE" finalized="false" version="1.0">
<assign-path>data/installments.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="94"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[One installment of a payment. The first is charged at the contract and each next one 30 days after the previous, by the gateway's recurring billing.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="INS-KEY" offset="0" length="10" encoding="bytes"/></primary><alternate name="INS-DUE" duplicates="true" ordering="ascending"><part field="INS-DUE" offset="10" length="8" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="INSTALLMENT-RECORD" usage="display">
<Field level="5" name="INS-KEY" usage="display">
<Field level="10" name="INS-PAY-ID" pic="9(8)" usage="display" offset="0" length="8">
</Field>
<Field level="10" name="INS-NO" pic="9(2)" usage="display" offset="8" length="2">
</Field>
<comment><![CDATA[Primary key: payment then number]]></comment>
</Field>
<Field level="5" name="INS-DUE" pic="9(8)" usage="display" offset="10" length="8">
<comment><![CDATA[YYYYMMDD]]></comment>
</Field>
<Field level="5" name="INS-AMOUNT" pic="9(9)V99" usage="display" offset="18" length="11">
</Field>
<Field level="5" name="INS-STATUS" pic="X(10)" usage="display" offset="29" length="10">
<comment><![CDATA[DUE, PAID, FAILED or CANCELLED]]></comment>
</Field>
<Field level="5" name="INS-GW-REF" pic="X(40)" usage="display" offset="39" length="40">
</Field>
<Field level="5" name="INS-PAID-AT" pic="9(14)" usage="display" offset="79" length="14">
</Field>
<Field level="5" name="INS-TRIES" pic="9(1)" usage="display" offset="93" length="1">
<comment><![CDATA[Charge attempts made on this installment (at most 3)]]></comment>
</Field>
</Field>
</fields>
</IndexedFile>
