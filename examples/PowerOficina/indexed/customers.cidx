<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="CUSTOMER-FILE" finalized="false" version="1.0">
<assign-path>data/customers.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="264"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[One row per customer of the workshop. CUS-DOC is the CPF or CNPJ. The two CONSENT flags (S or N) say whether the customer agreed to be contacted by email and by WhatsApp.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="CUS-ID" offset="0" length="8" encoding="bytes"/></primary><alternate name="CUS-DOC" duplicates="true" ordering="ascending"><part field="CUS-DOC" offset="68" length="14" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="CUSTOMER-RECORD" usage="display">
<Field level="5" name="CUS-ID" pic="9(8)" usage="display" offset="0" length="8">
<comment><![CDATA[Primary key]]></comment>
</Field>
<Field level="5" name="CUS-NAME" pic="X(60)" usage="display" offset="8" length="60">
</Field>
<Field level="5" name="CUS-DOC" pic="X(14)" usage="display" offset="68" length="14">
<comment><![CDATA[CPF or CNPJ, digits only]]></comment>
</Field>
<Field level="5" name="CUS-ADDRESS" pic="X(80)" usage="display" offset="82" length="80">
</Field>
<Field level="5" name="CUS-PHONE" pic="X(20)" usage="display" offset="162" length="20">
</Field>
<Field level="5" name="CUS-WHATSAPP" pic="X(20)" usage="display" offset="182" length="20">
</Field>
<Field level="5" name="CUS-EMAIL" pic="X(60)" usage="display" offset="202" length="60">
</Field>
<Field level="5" name="CUS-CONSENT-EMAIL" pic="X(1)" usage="display" offset="262" length="1">
<comment><![CDATA[S or N]]></comment>
</Field>
<Field level="5" name="CUS-CONSENT-WA" pic="X(1)" usage="display" offset="263" length="1">
<comment><![CDATA[S or N]]></comment>
</Field>
</Field>
</fields>
</IndexedFile>
