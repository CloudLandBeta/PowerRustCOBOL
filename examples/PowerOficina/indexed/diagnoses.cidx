<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="DIAGNOSIS-FILE" finalized="false" version="1.0">
<assign-path>data/diagnoses.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="116"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[One vehicle data collection: when the car came in, its model and what the sensors read. DGN-SOURCE is S for the simulated collector, R for a real reader and M for values typed by hand.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="DGN-ID" offset="0" length="8" encoding="bytes"/></primary><alternate name="DGN-PLATE" duplicates="true" ordering="ascending"><part field="DGN-PLATE" offset="8" length="8" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="DIAGNOSIS-RECORD" usage="display">
<Field level="5" name="DGN-ID" pic="9(8)" usage="display" offset="0" length="8">
<comment><![CDATA[Primary key]]></comment>
</Field>
<Field level="5" name="DGN-PLATE" pic="X(8)" usage="display" offset="8" length="8">
</Field>
<Field level="5" name="DGN-AT" pic="9(14)" usage="display" offset="16" length="14">
<comment><![CDATA[Entry date and time, YYYYMMDDHHMMSS]]></comment>
</Field>
<Field level="5" name="DGN-SOURCE" pic="X(1)" usage="display" offset="30" length="1">
<comment><![CDATA[S, R or M]]></comment>
</Field>
<Field level="5" name="DGN-MODEL" pic="X(30)" usage="display" offset="31" length="30">
</Field>
<Field level="5" name="DGN-ENGINE-TEMP" pic="9(3)" usage="display" offset="61" length="3">
<comment><![CDATA[Degrees Celsius]]></comment>
</Field>
<Field level="5" name="DGN-RPM" pic="9(5)" usage="display" offset="64" length="5">
</Field>
<Field level="5" name="DGN-BATTERY" pic="9(2)V9" usage="display" offset="69" length="3">
<comment><![CDATA[Volts]]></comment>
</Field>
<Field level="5" name="DGN-OIL-PRESSURE" pic="9(3)V9" usage="display" offset="72" length="4">
<comment><![CDATA[kPa]]></comment>
</Field>
<Field level="5" name="DGN-FAULT-1" pic="X(8)" usage="display" offset="76" length="8">
<comment><![CDATA[Fault code]]></comment>
</Field>
<Field level="5" name="DGN-FAULT-2" pic="X(8)" usage="display" offset="84" length="8">
</Field>
<Field level="5" name="DGN-FAULT-3" pic="X(8)" usage="display" offset="92" length="8">
</Field>
<Field level="5" name="DGN-FAULT-4" pic="X(8)" usage="display" offset="100" length="8">
</Field>
<Field level="5" name="DGN-FAULT-5" pic="X(8)" usage="display" offset="108" length="8">
</Field>
</Field>
</fields>
</IndexedFile>
