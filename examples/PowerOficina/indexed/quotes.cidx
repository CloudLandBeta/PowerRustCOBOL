<?xml version="1.0" encoding="UTF-8"?>
<IndexedFile name="QUOTE-FILE" finalized="false" version="1.0">
<assign-path>data/quotes.idx</assign-path>
<access-mode>dynamic</access-mode>
<record-format fixed-length="146"/>
<storage mode="disk" compression="false" persistence="false"/>
<comment><![CDATA[One revision of a quote. A sent quote is never changed: a change makes revision 2, 3 and so on. The currency is fixed when the quote is created.]]></comment>
<keys><primary duplicates="false" ordering="ascending"><part field="QUO-KEY" offset="0" length="10" encoding="bytes"/></primary><alternate name="QUO-CUS-ID" duplicates="true" ordering="ascending"><part field="QUO-CUS-ID" offset="10" length="8" encoding="bytes"/></alternate><alternate name="QUO-PLATE" duplicates="true" ordering="ascending"><part field="QUO-PLATE" offset="18" length="8" encoding="bytes"/></alternate></keys>
<fields>
<Field level="1" name="QUOTE-RECORD" usage="display">
<Field level="5" name="QUO-KEY" usage="display">
<Field level="10" name="QUO-ID" pic="9(8)" usage="display" offset="0" length="8">
</Field>
<Field level="10" name="QUO-REV" pic="9(2)" usage="display" offset="8" length="2">
</Field>
<comment><![CDATA[Primary key: number then revision]]></comment>
</Field>
<Field level="5" name="QUO-CUS-ID" pic="9(8)" usage="display" offset="10" length="8">
</Field>
<Field level="5" name="QUO-PLATE" pic="X(8)" usage="display" offset="18" length="8">
</Field>
<Field level="5" name="QUO-DGN-ID" pic="9(8)" usage="display" offset="26" length="8">
<comment><![CDATA[Diagnosis that originated the quote]]></comment>
</Field>
<Field level="5" name="QUO-CURRENCY" pic="X(3)" usage="display" offset="34" length="3">
<comment><![CDATA[BRL or EUR]]></comment>
</Field>
<Field level="5" name="QUO-STATUS" pic="X(10)" usage="display" offset="37" length="10">
<comment><![CDATA[DRAFT, SENT, APPROVED, REFUSED, EXPIRED, PAID or CANCELLED]]></comment>
</Field>
<Field level="5" name="QUO-CREATED" pic="9(14)" usage="display" offset="47" length="14">
</Field>
<Field level="5" name="QUO-VALID-UNTIL" pic="9(8)" usage="display" offset="61" length="8">
<comment><![CDATA[YYYYMMDD]]></comment>
</Field>
<Field level="5" name="QUO-DEADLINE" pic="9(8)" usage="display" offset="69" length="8">
<comment><![CDATA[Agreed execution deadline, YYYYMMDD]]></comment>
</Field>
<Field level="5" name="QUO-HOURS" pic="9(4)V99" usage="display" offset="77" length="6">
<comment><![CDATA[Total labour hours]]></comment>
</Field>
<Field level="5" name="QUO-SUBTOTAL" pic="9(9)V99" usage="display" offset="83" length="11">
<comment><![CDATA[Without tax]]></comment>
</Field>
<Field level="5" name="QUO-TAX" pic="9(9)V99" usage="display" offset="94" length="11">
</Field>
<Field level="5" name="QUO-TOTAL" pic="9(9)V99" usage="display" offset="105" length="11">
<comment><![CDATA[With tax]]></comment>
</Field>
<Field level="5" name="QUO-OPERATOR" pic="X(30)" usage="display" offset="116" length="30">
</Field>
</Field>
</fields>
</IndexedFile>
