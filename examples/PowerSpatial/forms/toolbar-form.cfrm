<?xml version="1.0" encoding="UTF-8"?>
<Form name="TOOLBAR-FORM" background="40404008" transparency="50" title="PowerSpatial" width="1000" height="76" grid-size="8" snap-to-grid="true" target="Custom" form-format="Standalone" responsive="true" index-base="1" title-visible="false" corner-radius="29" resizable="false" dock-to-opener="Top" dock-gap="14" dock-length="100">
  <FormLayout FontScaling="Fluid" MinFontScale="1" MaxFontScale="1.6"/>
  <working-storage><![CDATA[       01 WS-SET-NAME  GLOBAL PIC X(20).
       01 WS-SET-VALUE GLOBAL PIC X(200).
       01 WS-LANG-IX   GLOBAL PIC 9 VALUE 0.
       01 WS-NEW-IX    GLOBAL PIC 9 VALUE 1.
      *>   The texts the operator reads, one row per text and one
      *>   column per language - en, pt, es, fr, jp, cn.
       01 PS-TEXT-DATA GLOBAL.
      *>   SIDEBAR
           05 FILLER PIC X(80) VALUE "Sidebar".
           05 FILLER PIC X(80) VALUE "Barra lateral".
           05 FILLER PIC X(80) VALUE "Barra lateral".
           05 FILLER PIC X(80) VALUE "Barre latérale".
           05 FILLER PIC X(80) VALUE "サイドバー".
           05 FILLER PIC X(80) VALUE "侧边栏".
      *>   BACK
           05 FILLER PIC X(80) VALUE "Back".
           05 FILLER PIC X(80) VALUE "Voltar".
           05 FILLER PIC X(80) VALUE "Atrás".
           05 FILLER PIC X(80) VALUE "Précédent".
           05 FILLER PIC X(80) VALUE "戻る".
           05 FILLER PIC X(80) VALUE "后退".
      *>   FORWARD
           05 FILLER PIC X(80) VALUE "Forward".
           05 FILLER PIC X(80) VALUE "Avançar".
           05 FILLER PIC X(80) VALUE "Adelante".
           05 FILLER PIC X(80) VALUE "Suivant".
           05 FILLER PIC X(80) VALUE "進む".
           05 FILLER PIC X(80) VALUE "前进".
      *>   CLOSE
           05 FILLER PIC X(80) VALUE "Close".
           05 FILLER PIC X(80) VALUE "Fechar".
           05 FILLER PIC X(80) VALUE "Cerrar".
           05 FILLER PIC X(80) VALUE "Fermer".
           05 FILLER PIC X(80) VALUE "閉じる".
           05 FILLER PIC X(80) VALUE "关闭".
      *>   NEWTAB
           05 FILLER PIC X(80) VALUE "New tab".
           05 FILLER PIC X(80) VALUE "Nova aba".
           05 FILLER PIC X(80) VALUE "Nueva pestaña".
           05 FILLER PIC X(80) VALUE "Nouvel onglet".
           05 FILLER PIC X(80) VALUE "新しいタブ".
           05 FILLER PIC X(80) VALUE "新标签页".
      *>   SHARE
           05 FILLER PIC X(80) VALUE "Share".
           05 FILLER PIC X(80) VALUE "Compartilhar".
           05 FILLER PIC X(80) VALUE "Compartir".
           05 FILLER PIC X(80) VALUE "Partager".
           05 FILLER PIC X(80) VALUE "共有".
           05 FILLER PIC X(80) VALUE "分享".
      *>   TABS
           05 FILLER PIC X(80) VALUE "Tabs".
           05 FILLER PIC X(80) VALUE "Abas".
           05 FILLER PIC X(80) VALUE "Pestañas".
           05 FILLER PIC X(80) VALUE "Onglets".
           05 FILLER PIC X(80) VALUE "タブ".
           05 FILLER PIC X(80) VALUE "标签页".
       01 PS-TEXT-TABLE REDEFINES PS-TEXT-DATA GLOBAL.
           05 PS-TEXT-ROW OCCURS 7.
              10 PS-TEXT PIC X(80) OCCURS 6.
]]></working-storage>
  <user-procedures>
    <Event name="PS-LANG-CHECK" paragraph="PS-LANG-CHECK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The language kept in the settings; the texts follow it.
           MOVE "LANG" TO WS-SET-NAME
           CALL "PS-SETTING-GET" USING WS-SET-NAME WS-SET-VALUE
           EVALUATE WS-SET-VALUE(1:2)
               WHEN "pt" MOVE 2 TO WS-NEW-IX
               WHEN "es" MOVE 3 TO WS-NEW-IX
               WHEN "fr" MOVE 4 TO WS-NEW-IX
               WHEN "jp" MOVE 5 TO WS-NEW-IX
               WHEN "cn" MOVE 6 TO WS-NEW-IX
               WHEN OTHER MOVE 1 TO WS-NEW-IX
           END-EVALUATE
           IF WS-NEW-IX NOT = WS-LANG-IX
               MOVE WS-NEW-IX TO WS-LANG-IX
               CALL "PS-APPLY-TEXT"
           END-IF
]]></Event>
    <Event name="PS-APPLY-TEXT" paragraph="PS-APPLY-TEXT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE FUNCTION TRIM(PS-TEXT(1, WS-LANG-IX)) TO Btn-Sidebar::Tooltip
           MOVE FUNCTION TRIM(PS-TEXT(2, WS-LANG-IX)) TO Btn-Back::Tooltip
           MOVE FUNCTION TRIM(PS-TEXT(3, WS-LANG-IX)) TO Btn-Forward::Tooltip
           MOVE FUNCTION TRIM(PS-TEXT(4, WS-LANG-IX)) TO Btn-Close::Tooltip
           MOVE FUNCTION TRIM(PS-TEXT(5, WS-LANG-IX)) TO Btn-New::Tooltip
           MOVE FUNCTION TRIM(PS-TEXT(6, WS-LANG-IX)) TO Btn-Share::Tooltip
           MOVE FUNCTION TRIM(PS-TEXT(7, WS-LANG-IX)) TO Btn-Tabs::Tooltip
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="TOOLBAR-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "PS-LANG-CHECK"
]]></Event>
  </form-events>
  <Control id="Pnl-Bar" type="Panel" x="0" y="0" w="1000" h="76" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="LayoutMode">Grid</Property>
    <Property name="GridColumns">190px 42px 42px 42px 1fr 42px 42px 42px 48px</Property>
    <Property name="GridRows">1fr</Property>
    <Property name="Gap">10</Property>
    <Property name="Padding">6</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="HideBackground">true</Property>
    <Property name="Dock">Fill</Property>
  </Control>
  <Control id="Pic-Logo" type="PictureBox" x="8" y="10" w="190" h="56" tab-order="1" z-order="0" visible="true" enabled="true" parent="Pnl-Bar">
