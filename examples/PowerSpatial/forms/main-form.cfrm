  <Control id="Sw-AC" type="Switch" x="332" y="301" w="60" h="30" tab-order="30" z-order="0" visible="true" enabled="true" parent="Crd-AC">
    <Property name="Checked">true</Property>
    <Property name="Accent">#0A84FFFF</Property>
    <Property name="GridColumn">2</Property>
    <Property name="GridRow">1</Property>
    <Property name="RowSpan">2</Property>
    <Property name="JustifySelf">End</Property>
    <Property name="AlignSelf">Start</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="CornerRadius">0</Property>
    <Property name="Transparency">0</Property>
    <Event name="onCheckedChanged" paragraph="SW-AC--ONCHECKEDCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-AC-TOGGLE: follows the air conditioner switch.
           *> Uses:   Sw-AC::Checked (1 = on, 0 = off): flipped by the operator, just moved by
           *>         PS-AC-SHOW when the power button was used, or possibly once at load (the host
           *>         compares text, so a first write spelled differently may count as a change).
           *>         PS-AC-SHOW also reads Knb-AC::Value and WS-LANG-IX.
           *> Result: WS-AC-ON = "Y" when Sw-AC::Checked = 1, otherwise "N"; then PS-AC-SHOW redraws
           *>         the card: WS-N = Knb-AC::Value, WS-N-TXT = WS-N and WS-LINE = the value + "°C"
           *>         (28 gives "28°C"); Lbl-Target::Caption = WS-LINE. Lbl-Cooling::Caption =
           *>         PS-TEXT row 9 (on) or 10 (off); Lbl-Under::Visible and Knb-AC::Enabled = 1 or
           *>         0; Sw-AC::Checked is written back with its own value.

           CALL    "PS-AC-TOGGLE"
]]></Event>
  </Control>
