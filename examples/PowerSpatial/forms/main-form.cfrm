  <Control id="Knb-AC" type="Knob" x="42" y="359" w="348" h="113" tab-order="32" z-order="0" visible="true" enabled="true" parent="Pnl-Dial">
    <Property name="Minimum">16</Property>
    <Property name="Maximum">30</Property>
    <Property name="Value">28</Property>
    <Property name="Step">1</Property>
    <Property name="DefaultValue">24</Property>
    <Property name="Accent">#0A84FFFF</Property>
    <Property name="FaceColor">#00000000</Property>
    <Property name="RimColor">#00000000</Property>
    <Property name="IndicatorStyle">Thumb</Property>
    <Property name="TrackColor">#FFFFFF26</Property>
    <Property name="ShowValue">false</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="GridColumn">1</Property>
    <Property name="GridRow">1</Property>
    <Property name="ColumnSpan">3</Property>
    <Property name="RowSpan">6</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="CornerRadius">0</Property>
    <Property name="Transparency">0</Property>
    <Event name="onValueChanged" paragraph="KNB-AC--ONVALUECHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-AC-SHOW: redraws the air conditioner card from the dial and the on/off flag: target
           *> temperature, cooling/off caption, and the state of the dial and the switch.
           *> Uses:   Knb-AC::Value, the position the operator just turned the dial to (16 to 30,
           *>         step 1); WS-AC-ON and WS-LANG-IX are only read, as they stand.
           *> Result: WS-N = Knb-AC::Value, WS-N-TXT = WS-N, WS-LINE = the value + "°C" and
           *>         Lbl-Target::Caption = WS-LINE (24 gives "24°C"). The state is applied again
           *>         from WS-AC-ON: Lbl-Cooling::Caption = PS-TEXT row 9 ("Y") or 10 ("N");
           *>         Lbl-Under::Visible, Knb-AC::Enabled and Sw-AC::Checked = 1 or 0 (a write of
           *>         the text already held raises no event).

           CALL    "PS-AC-SHOW"
]]></Event>
  </Control>
