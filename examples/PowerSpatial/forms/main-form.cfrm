  <Control id="Tmr-Wave" type="Timer" x="0" y="0" w="24" h="24" tab-order="70" z-order="0" visible="true" enabled="true">
    <Property name="Interval">140</Property>
    <Property name="Enabled">false</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Transparency">0</Property>
    <Event name="onTick" paragraph="TMR-WAVE--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-WAVE-SHIFT: moves the waveform one sample to the left, so the bars rotate while a
           *> song plays.
           *> Uses:   WS-WAVE-VALUE(1) to (48) (the 48 samples) and WS-WAVE-N = 48.
           *> Result: WS-FIRST = the old WS-WAVE-VALUE(1); each WS-WAVE-VALUE(i) takes the value of
           *>         i + 1 (i = 1 to 47); WS-WAVE-VALUE(48) = WS-FIRST. WS-I ends at 48. The labels
           *>         do not move. COBOL::"CHART-SET-TABLE" hands WS-WAVE and 48 to Cht-Wave; the
           *>         chart names no LabelField or ValueFields, so the built-in reads the table as
           *>         rows of X(64) + 9(18)V9(6) (88 bytes), not as these 7-byte rows (X(4) + 9(3)).

           CALL    "PS-WAVE-SHIFT"
]]></Event>
  </Control>
