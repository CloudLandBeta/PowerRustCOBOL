    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Transparency">0</Property>
    <Event name="onClick" paragraph="BTN-PLAY--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-PLAY-TOGGLE: switches between playing and paused.
           *> Uses:   WS-PLAYING ("N" at load).
           *> Result: WS-PLAYING is flipped. To "Y": Btn-Play::IconPath = "Assets/icons/pause.svg"
           *>         and Tmr-Wave::Enabled = 1 (its 140 ms ticks call PS-WAVE-SHIFT). To "N":
           *>         "Assets/icons/play.svg" and Tmr-Wave::Enabled = 0.

           CALL    "PS-PLAY-TOGGLE"
]]></Event>
  </Control>
