    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-PREV--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-SONG-PREV: goes back to the previous song and shows it.
           *> Uses:   WS-SONG (1 to 3; 1 at load); PS-SONG-SHOW also reads the WS-SONG-TABLE rows.
           *> Result: WS-SONG = WS-SONG - 1, or 3 when it was 1. PS-SONG-SHOW then sets
           *>         Lbl-Song::Caption to the title and Lbl-Album-Name::Caption to the album of
           *>         that song.

           CALL    "PS-SONG-PREV"
]]></Event>
  </Control>
  <Control id="Btn-Play" type="Button" x="716" y="137" w="40" h="40" tab-order="65" z-order="0" visible="true" enabled="true" parent="Pnl-Player">
