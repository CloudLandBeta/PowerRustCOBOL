<?xml version="1.0" encoding="UTF-8"?>
<Form name="MAIN-FORM" title="PowerSpatial" width="1000" height="600" background="40404008" transparency="50" grid-size="8" snap-to-grid="true" target="Custom" main-form="true" title-visible="false" corner-radius="34" resizable="false" screen-fill="70" index-base="1" window-effects="false" start-position="Center" responsive="true">
  <FormLayout FontScaling="Fluid" MaxFontScale="1.8" MinFontScale="1"/>
  <working-storage><![CDATA[       01 WS-DEV-INIT                            GLOBAL    PIC X(3)    VALUE "YNY".
       01 WS-NOW                                 GLOBAL    PIC X(21).
       01 WS-MONTH                               GLOBAL    PIC 99.
       01 WS-DAY                                 GLOBAL    PIC 99.
       01 WS-LINE                                GLOBAL    PIC X(80).
       01 WS-N                                   GLOBAL    PIC 9(3).
       01 WS-N-TXT                               GLOBAL    PIC ZZ9.
       01 WS-AC-ON                               GLOBAL    PIC X    VALUE "Y".
       01 WS-PLAYING                             GLOBAL    PIC X    VALUE "N".
       01 WS-SONG                                GLOBAL    PIC 9    VALUE 1.
       01 WS-SONG-DATA                           GLOBAL.
           05 FILLER                             PIC    X(40)    VALUE "Ed Sheeran - Shape of You".
           05 FILLER                             PIC    X(20)    VALUE "Divide".
           05 FILLER                             PIC    X(40)    VALUE "Coldplay - Yellow".
           05 FILLER                             PIC    X(20)    VALUE "Parachutes".
           05 FILLER                             PIC    X(40)    VALUE "Adele - Hello".
           05 FILLER                             PIC    X(20)    VALUE "25".
       01 WS-SONG-TABLE                          REDEFINES    WS-SONG-DATA    GLOBAL.
           05 WS-SONG-ROW                        OCCURS    3.
               10 WS-SONG-TITLE                  PIC    X(40).
               10 WS-SONG-ALBUM                  PIC    X(20).

       *>   The waveform: one bar per sample, shifted while a song plays.

       01 WS-WAVE                                GLOBAL.
           05 WS-WAVE-ROW                        OCCURS    48.
               10 WS-WAVE-LABEL                  PIC    X(4).
               10 WS-WAVE-VALUE                  PIC    9(3).
       01 WS-WAVE-N                              GLOBAL    PIC 9(3)    VALUE 48.
       01 WS-I                                   GLOBAL    PIC 9(3).
       01 WS-SEED                                GLOBAL    PIC 9(5)    VALUE 7.
       01 WS-FIRST                               GLOBAL    PIC 9(3).

       *>   Per device card: is it on (cast) and powered (plug).

