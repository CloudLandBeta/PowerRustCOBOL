  <Control id="Tmr-Lang" type="Timer" x="0" y="0" w="24" h="24" tab-order="106" z-order="0" visible="true" enabled="true">
    <Property name="Interval">1000</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Transparency">0</Property>
    <Event name="onTick" paragraph="TMR-LANG--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-LANG-CHECK: Tmr-Lang fires every 1000 ms; each tick re-reads the saved language.
           *> Uses:   The LANG setting in the settings file and WS-LANG-IX, the language on screen;
           *>         when it applies the texts, also WS-AC-ON, Knb-AC::Value, WS-DEV-ON(1) to (3)
           *>         and the system date.
           *> Result: Every tick: WS-SET-NAME = "LANG", WS-SET-VALUE = the code read (SPACES if
           *>         none), WS-NEW-IX = 1-6. Only when WS-NEW-IX differs from WS-LANG-IX are
           *>         WS-LANG-IX and the texts changed (PS-APPLY-TEXT, with PS-AC-SHOW,
           *>         PS-DEVICES-SHOW and PS-CLOCK, which also leave WS-N, WS-N-TXT, WS-LINE,
           *>         WS-NOW, WS-MONTH and WS-DAY changed).

           CALL    "PS-LANG-CHECK"
]]></Event>
  </Control>
