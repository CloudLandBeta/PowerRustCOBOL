  <Control id="Btn-Thermostat-Cast" type="Button" x="556" y="407" w="30" h="34" tab-order="87" z-order="0" visible="true" enabled="true" parent="Pnl-Thermostat-Buttons">
    <Property name="Caption"></Property>
    <Property name="IconPath">Assets/icons/cast.svg</Property>
    <Property name="IconSize">32</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#0A84FFFF</Property>
    <Property name="GridColumn">1</Property>
    <Property name="GridRow">1</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Transparency">0</Property>
    <Event name="onClick" paragraph="BTN-THERMOSTAT-CAST--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-I                          TO    1

           *> PS-DEVICE-TOGGLE: turns one device card on or off (Btn-Thermostat-Cast was pressed).
           *> Uses:   WS-I = 1 (set just above: the Thermostat card) and WS-DEV-ON(1);
           *>         PS-DEVICES-SHOW also reads the other two flags, WS-LANG-IX and PS-TEXT rows 18
           *>         and 19.
           *> Result: WS-DEV-ON(1) is flipped: "Y" becomes "N" and "N" becomes "Y". PS-DEVICES-SHOW
           *>         then redraws the cards: Lbl-Thermostat-Status::Caption = PS-TEXT row 18 (on)
           *>         or 19 (off); Btn-Thermostat-Cast::BackgroundColor = "#0A84FFFF" and
           *>         Btn-Thermostat-Plug::BackgroundColor = "#2DC653FF" when on, both "#FFFFFF26"
           *>         when off. The other two cards are redrawn from their own flags.

           CALL    "PS-DEVICE-TOGGLE"
]]></Event>
  </Control>
  <Control id="Btn-Thermostat-Plug" type="Button" x="556" y="449" w="30" h="34" tab-order="88" z-order="0" visible="true" enabled="true" parent="Pnl-Thermostat-Buttons">
    <Property name="Caption"></Property>
    <Property name="IconPath">Assets/icons/plug.svg</Property>
    <Property name="IconSize">32</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#2DC653FF</Property>
    <Property name="GridColumn">1</Property>
    <Property name="GridRow">2</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Transparency">0</Property>
    <Event name="onClick" paragraph="BTN-THERMOSTAT-PLUG--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-I                          TO    1

           *> PS-DEVICE-TOGGLE: turns one device card on or off (Btn-Thermostat-Plug was pressed).
           *> Uses:   WS-I = 1 (set just above: the Thermostat card) and WS-DEV-ON(1);
           *>         PS-DEVICES-SHOW also reads the other two flags, WS-LANG-IX and PS-TEXT rows 18
           *>         and 19.
           *> Result: WS-DEV-ON(1) is flipped: "Y" becomes "N" and "N" becomes "Y". PS-DEVICES-SHOW
           *>         then redraws the cards: Lbl-Thermostat-Status::Caption = PS-TEXT row 18 (on)
           *>         or 19 (off); Btn-Thermostat-Cast::BackgroundColor = "#0A84FFFF" and
           *>         Btn-Thermostat-Plug::BackgroundColor = "#2DC653FF" when on, both "#FFFFFF26"
           *>         when off. The other two cards are redrawn from their own flags.

           CALL    "PS-DEVICE-TOGGLE"
]]></Event>
  </Control>
