  <user-procedures>
    <Event name="PS-LANG-CHECK" paragraph="PS-LANG-CHECK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The language kept in the settings; the texts follow it.
           MOVE "LANG" TO WS-SET-NAME
           CALL "PS-SETTING-GET" USING WS-SET-NAME WS-SET-VALUE
           EVALUATE WS-SET-VALUE(1:2)
               WHEN "pt" MOVE 2 TO WS-NEW-IX
               WHEN "es" MOVE 3 TO WS-NEW-IX
               WHEN "fr" MOVE 4 TO WS-NEW-IX
               WHEN "jp" MOVE 5 TO WS-NEW-IX
               WHEN "cn" MOVE 6 TO WS-NEW-IX
               WHEN OTHER MOVE 1 TO WS-NEW-IX
           END-EVALUATE
           IF WS-NEW-IX NOT = WS-LANG-IX
               MOVE WS-NEW-IX TO WS-LANG-IX
               CALL "PS-APPLY-TEXT"
           END-IF
]]></Event>
    <Event name="PS-APPLY-TEXT" paragraph="PS-APPLY-TEXT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE FUNCTION TRIM(PS-TEXT(1, WS-LANG-IX)) TO Lbl-Light::Caption
           MOVE FUNCTION TRIM(PS-TEXT(2, WS-LANG-IX)) TO Lbl-AirCon::Caption
           MOVE FUNCTION TRIM(PS-TEXT(3, WS-LANG-IX)) TO Lbl-Wifi::Caption
           MOVE FUNCTION TRIM(PS-TEXT(4, WS-LANG-IX)) TO Lbl-Outdoor::Caption
           MOVE FUNCTION TRIM(PS-TEXT(5, WS-LANG-IX)) TO Txt-Search::HintText
           MOVE FUNCTION TRIM(PS-TEXT(6, WS-LANG-IX)) TO Lbl-Hi::Caption
           MOVE FUNCTION TRIM(PS-TEXT(7, WS-LANG-IX)) TO Lbl-Album::Caption
           MOVE FUNCTION TRIM(PS-TEXT(8, WS-LANG-IX)) TO Lbl-AC::Caption
           MOVE FUNCTION TRIM(PS-TEXT(11, WS-LANG-IX)) TO Lbl-Under::Caption
           MOVE FUNCTION TRIM(PS-TEXT(12, WS-LANG-IX)) TO Lbl-Consumption::Caption
           MOVE FUNCTION TRIM(PS-TEXT(13, WS-LANG-IX)) TO Lbl-Humidity::Caption
           MOVE FUNCTION TRIM(PS-TEXT(14, WS-LANG-IX)) TO Lbl-Pressure::Caption
           MOVE FUNCTION TRIM(PS-TEXT(15, WS-LANG-IX)) TO Lbl-Thermostat::Caption
           MOVE FUNCTION TRIM(PS-TEXT(16, WS-LANG-IX)) TO Lbl-Lighting::Caption
           MOVE FUNCTION TRIM(PS-TEXT(17, WS-LANG-IX)) TO Lbl-Speaker::Caption
           CALL "PS-AC-SHOW"
           CALL "PS-DEVICES-SHOW"
           CALL "PS-CLOCK"
]]></Event>
    <Event name="PS-CLOCK" paragraph="PS-CLOCK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The date and the time, in the operator's language.
           MOVE FUNCTION CURRENT-DATE TO WS-NOW
           MOVE WS-NOW(5:2) TO WS-MONTH
           MOVE WS-NOW(7:2) TO WS-DAY
           MOVE SPACES TO WS-LINE
           MOVE WS-DAY TO WS-N-TXT
           EVALUATE WS-LANG-IX
      *>       2026年10月4日
               WHEN 5 WHEN 6
                   STRING WS-NOW(1:4) "年" FUNCTION TRIM(PS-TEXT(WS-MONTH + 20, WS-LANG-IX))
                       FUNCTION TRIM(WS-N-TXT) "日" DELIMITED BY SIZE INTO WS-LINE
      *>       4 de outubro de 2026 / 4 de octubre de 2026
               WHEN 2 WHEN 3
                   STRING FUNCTION TRIM(WS-N-TXT) " de " FUNCTION TRIM(PS-TEXT(WS-MONTH + 20, WS-LANG-IX))
                       " de " WS-NOW(1:4) DELIMITED BY SIZE INTO WS-LINE
      *>       4 octobre 2026
               WHEN 4
                   STRING FUNCTION TRIM(WS-N-TXT) " " FUNCTION TRIM(PS-TEXT(WS-MONTH + 20, WS-LANG-IX))
                       " " WS-NOW(1:4) DELIMITED BY SIZE INTO WS-LINE
      *>       04 October, 2026
               WHEN OTHER
                   STRING WS-NOW(7:2) " " FUNCTION TRIM(PS-TEXT(WS-MONTH + 20, WS-LANG-IX))
                       ", " WS-NOW(1:4) DELIMITED BY SIZE INTO WS-LINE
           END-EVALUATE
           MOVE WS-LINE TO Lbl-Date::Caption
           MOVE SPACES TO WS-LINE
           STRING WS-NOW(9:2) ":" WS-NOW(11:2) DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Time::Caption
]]></Event>
    <Event name="PS-AC-SHOW" paragraph="PS-AC-SHOW"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The dial and its readout follow the air conditioner's switch.
           MOVE Knb-AC::Value TO WS-N
           MOVE WS-N TO WS-N-TXT
           MOVE SPACES TO WS-LINE
           STRING FUNCTION TRIM(WS-N-TXT) "°C" DELIMITED BY SIZE INTO WS-LINE
           MOVE WS-LINE TO Lbl-Target::Caption
           IF WS-AC-ON = "Y"
               MOVE FUNCTION TRIM(PS-TEXT(9, WS-LANG-IX)) TO Lbl-Cooling::Caption
               MOVE 1 TO Lbl-Under::Visible
               MOVE 1 TO Knb-AC::Enabled
               MOVE 1 TO Sw-AC::Checked
           ELSE
               MOVE FUNCTION TRIM(PS-TEXT(10, WS-LANG-IX)) TO Lbl-Cooling::Caption
               MOVE 0 TO Lbl-Under::Visible
               MOVE 0 TO Knb-AC::Enabled
               MOVE 0 TO Sw-AC::Checked
           END-IF
]]></Event>
    <Event name="PS-AC-TOGGLE" paragraph="PS-AC-TOGGLE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF Sw-AC::Checked = 1
               MOVE "Y" TO WS-AC-ON
           ELSE
               MOVE "N" TO WS-AC-ON
           END-IF
           CALL "PS-AC-SHOW"
]]></Event>
    <Event name="PS-AC-TOGGLE-BUTTON" paragraph="PS-AC-TOGGLE-BUTTON"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-AC-ON = "Y"
               MOVE "N" TO WS-AC-ON
           ELSE
               MOVE "Y" TO WS-AC-ON
           END-IF
           CALL "PS-AC-SHOW"
]]></Event>
    <Event name="PS-PLAY-TOGGLE" paragraph="PS-PLAY-TOGGLE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-PLAYING = "Y"
               MOVE "N" TO WS-PLAYING
               MOVE "Assets/icons/play.svg" TO Btn-Play::IconPath
               MOVE 0 TO Tmr-Wave::Enabled
           ELSE
               MOVE "Y" TO WS-PLAYING
               MOVE "Assets/icons/pause.svg" TO Btn-Play::IconPath
               MOVE 1 TO Tmr-Wave::Enabled
           END-IF
]]></Event>
    <Event name="PS-SONG-SHOW" paragraph="PS-SONG-SHOW"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE WS-SONG-TITLE(WS-SONG) TO Lbl-Song::Caption
           MOVE WS-SONG-ALBUM(WS-SONG) TO Lbl-Album-Name::Caption
]]></Event>
    <Event name="PS-SONG-NEXT" paragraph="PS-SONG-NEXT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-SONG >= 3
               MOVE 1 TO WS-SONG
           ELSE
               ADD 1 TO WS-SONG
           END-IF
           CALL "PS-SONG-SHOW"
]]></Event>
    <Event name="PS-SONG-PREV" paragraph="PS-SONG-PREV"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-SONG <= 1
               MOVE 3 TO WS-SONG
           ELSE
               SUBTRACT 1 FROM WS-SONG
           END-IF
           CALL "PS-SONG-SHOW"
]]></Event>
    <Event name="PS-WAVE-INIT" paragraph="PS-WAVE-INIT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   A waveform of 48 samples, made once.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-WAVE-N
               COMPUTE WS-SEED = FUNCTION MOD(WS-SEED * 73 + 41, 997)
               COMPUTE WS-WAVE-VALUE(WS-I) = 15 + FUNCTION MOD(WS-SEED, 85)
               MOVE WS-I TO WS-N-TXT
               MOVE WS-N-TXT TO WS-WAVE-LABEL(WS-I)
           END-PERFORM
           COBOL::"CHART-SET-TABLE" ( "Cht-Wave" WS-WAVE WS-WAVE-N )
]]></Event>
    <Event name="PS-WAVE-SHIFT" paragraph="PS-WAVE-SHIFT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   While a song plays the waveform moves left one sample a tick.
           MOVE WS-WAVE-VALUE(1) TO WS-FIRST
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I >= WS-WAVE-N
               MOVE WS-WAVE-VALUE(WS-I + 1) TO WS-WAVE-VALUE(WS-I)
           END-PERFORM
           MOVE WS-FIRST TO WS-WAVE-VALUE(WS-WAVE-N)
           COBOL::"CHART-SET-TABLE" ( "Cht-Wave" WS-WAVE WS-WAVE-N )
]]></Event>
    <Event name="PS-DEVICES-SHOW" paragraph="PS-DEVICES-SHOW"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   Each device card shows whether the device is on.
           IF WS-DEV-ON(1) = "Y"
               MOVE FUNCTION TRIM(PS-TEXT(18, WS-LANG-IX)) TO Lbl-Thermostat-Status::Caption
               MOVE "#0A84FFFF" TO Btn-Thermostat-Cast::BackgroundColor
               MOVE "#2DC653FF" TO Btn-Thermostat-Plug::BackgroundColor
           ELSE
               MOVE FUNCTION TRIM(PS-TEXT(19, WS-LANG-IX)) TO Lbl-Thermostat-Status::Caption
               MOVE "#FFFFFF26" TO Btn-Thermostat-Cast::BackgroundColor
               MOVE "#FFFFFF26" TO Btn-Thermostat-Plug::BackgroundColor
           END-IF
           IF WS-DEV-ON(2) = "Y"
               MOVE FUNCTION TRIM(PS-TEXT(18, WS-LANG-IX)) TO Lbl-Lighting-Status::Caption
               MOVE "#0A84FFFF" TO Btn-Lighting-Cast::BackgroundColor
               MOVE "#2DC653FF" TO Btn-Lighting-Plug::BackgroundColor
           ELSE
               MOVE FUNCTION TRIM(PS-TEXT(19, WS-LANG-IX)) TO Lbl-Lighting-Status::Caption
               MOVE "#FFFFFF26" TO Btn-Lighting-Cast::BackgroundColor
               MOVE "#FFFFFF26" TO Btn-Lighting-Plug::BackgroundColor
           END-IF
           IF WS-DEV-ON(3) = "Y"
               MOVE FUNCTION TRIM(PS-TEXT(18, WS-LANG-IX)) TO Lbl-Speaker-Status::Caption
               MOVE "#0A84FFFF" TO Btn-Speaker-Cast::BackgroundColor
               MOVE "#2DC653FF" TO Btn-Speaker-Plug::BackgroundColor
           ELSE
               MOVE FUNCTION TRIM(PS-TEXT(19, WS-LANG-IX)) TO Lbl-Speaker-Status::Caption
               MOVE "#FFFFFF26" TO Btn-Speaker-Cast::BackgroundColor
               MOVE "#FFFFFF26" TO Btn-Speaker-Plug::BackgroundColor
           END-IF
]]></Event>
    <Event name="PS-DEVICE-TOGGLE" paragraph="PS-DEVICE-TOGGLE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   WS-I names the device card pressed.
           IF WS-DEV-ON(WS-I) = "Y"
               MOVE "N" TO WS-DEV-ON(WS-I)
           ELSE
               MOVE "Y" TO WS-DEV-ON(WS-I)
           END-IF
           CALL "PS-DEVICES-SHOW"
]]></Event>
    <Event name="PS-NOTIFY" paragraph="PS-NOTIFY"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE FUNCTION TRIM(PS-TEXT(20, WS-LANG-IX)) TO Snb-Note::Text
           INVOKE Snb-Note::Show()
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="MAIN-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
      *>   The dashboard opens its floating windows, docked around it.
           MOVE WS-DEV-INIT(1:1) TO WS-DEV-ON(1)
           MOVE WS-DEV-INIT(2:1) TO WS-DEV-ON(2)
           MOVE WS-DEV-INIT(3:1) TO WS-DEV-ON(3)
           CALL "PS-LANG-CHECK"
           CALL "PS-WAVE-INIT"
           CALL "PS-SONG-SHOW"
           INVOKE me::"OpenFormAsync"("TOOLBAR-FORM")
           INVOKE me::"OpenFormAsync"("RAIL-FORM")
           INVOKE me::"OpenFormAsync"("ROOMS-FORM")
]]></Event>
    <Event name="onClose" paragraph="MAIN-FORM--ONCLOSE">
    </Event>
  </form-events>
