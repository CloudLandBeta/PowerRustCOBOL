    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Event name="onClick" paragraph="BTN-AC-POWER--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-AC-TOGGLE-BUTTON: turns the air conditioner on or off from the power button.
           *> Uses:   WS-AC-ON ("Y" at load); PS-AC-SHOW also reads Knb-AC::Value and WS-LANG-IX.
           *> Result: WS-AC-ON is flipped: "Y" becomes "N" and "N" becomes "Y". PS-AC-SHOW then
           *>         redraws the card: WS-N = Knb-AC::Value, WS-N-TXT = WS-N and WS-LINE = the
           *>         value + "°C" (28 gives "28°C"); Lbl-Target::Caption = WS-LINE. Sw-AC::Checked,
           *>         Knb-AC::Enabled and Lbl-Under::Visible become 1 ("Y") or 0 ("N"), and
           *>         Lbl-Cooling::Caption = PS-TEXT row 9 or 10. When the Sw-AC change alters the
           *>         stored value it raises SW-AC--ONCHECKEDCHANGED, which runs PS-AC-TOGGLE and
           *>         repeats the redraw with the same values.

           CALL    "PS-AC-TOGGLE-BUTTON"
]]></Event>
  </Control>
