  <Control id="Tmr-Clock" type="Timer" x="0" y="0" w="24" h="24" tab-order="104" z-order="0" visible="true" enabled="true">
    <Property name="Interval">1000</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="Transparency">0</Property>
    <Event name="onTick" paragraph="TMR-CLOCK--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-CLOCK: shows the current date and time in the language on screen; Tmr-Clock fires
           *> every 1000 ms and each tick calls it.
           *> Uses:   FUNCTION CURRENT-DATE, WS-LANG-IX (picks the date layout) and PS-TEXT rows 21
           *>         to 32 (the month names).
           *> Result: WS-NOW = FUNCTION CURRENT-DATE; WS-MONTH, WS-DAY, WS-N-TXT and WS-LINE hold
           *>         the parts last cut from it. Lbl-Date::Caption = the date by language (shown
           *>         for 4 October 2026): en "04 October, 2026", pt "4 de outubro de 2026", es
           *>         "4 de octubre de 2026", fr "4 octobre 2026", jp/cn "2026年10月4日";
           *>         Lbl-Time::Caption = "hh:mm".

           CALL    "PS-CLOCK"
]]></Event>
  </Control>
