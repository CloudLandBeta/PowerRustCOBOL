<?xml version="1.0" encoding="UTF-8"?>
<Form name="SETTINGS-FORM" background="40404008" transparency="50" title="PowerSpatial" width="440" height="240" grid-size="8" snap-to-grid="true" target="Custom" form-format="Standalone" responsive="true" index-base="1" title-visible="false" corner-radius="28" resizable="false" start-position="Center">
  <working-storage><![CDATA[       01 WS-PICK                                GLOBAL    PIC 9.
       01 WS-SET-NAME                            GLOBAL    PIC X(20).
       01 WS-SET-VALUE                           GLOBAL    PIC X(200).
       01 WS-LANG-IX                             GLOBAL    PIC 9    VALUE 0.
       01 WS-NEW-IX                              GLOBAL    PIC 9    VALUE 1.

       *>   The texts the operator reads, one row per text and one
       *>   column per language - en, pt, es, fr, jp, cn.

       01 PS-TEXT-DATA                           GLOBAL.

           *>   TITLE

           05 FILLER                             PIC    X(80)    VALUE "Settings".
           05 FILLER                             PIC    X(80)    VALUE "Configurações".
           05 FILLER                             PIC    X(80)    VALUE "Ajustes".
           05 FILLER                             PIC    X(80)    VALUE "Paramètres".
           05 FILLER                             PIC    X(80)    VALUE "設定".
           05 FILLER                             PIC    X(80)    VALUE "设置".

           *>   LANGUAGE

           05 FILLER                             PIC    X(80)    VALUE "Language".
           05 FILLER                             PIC    X(80)    VALUE "Idioma".
           05 FILLER                             PIC    X(80)    VALUE "Idioma".
           05 FILLER                             PIC    X(80)    VALUE "Langue".
           05 FILLER                             PIC    X(80)    VALUE "言語".
           05 FILLER                             PIC    X(80)    VALUE "语言".

           *>   CLOSE

           05 FILLER                             PIC    X(80)    VALUE "Close".
           05 FILLER                             PIC    X(80)    VALUE "Fechar".
           05 FILLER                             PIC    X(80)    VALUE "Cerrar".
           05 FILLER                             PIC    X(80)    VALUE "Fermer".
           05 FILLER                             PIC    X(80)    VALUE "閉じる".
           05 FILLER                             PIC    X(80)    VALUE "关闭".
       01 PS-TEXT-TABLE                          REDEFINES    PS-TEXT-DATA    GLOBAL.
           05 PS-TEXT-ROW                        OCCURS    3.
               10 PS-TEXT                        PIC    X(80)    OCCURS 6.
]]></working-storage>
  <user-procedures>
    <Event name="PS-LANG-CHECK" paragraph="PS-LANG-CHECK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *>   The language kept in the settings; the texts follow it.

           SET     WS-SET-NAME                   TO    "LANG"

           *> PS-SETTING-GET: reads one setting from the settings file (indexed, data/settings.idx
           *> or $POWERSPATIAL_DATA/settings.idx) by its name. It never writes a setting (the OPEN
           *> only leaves an empty settings.idx.lck beside the file).
           *> Uses:   WS-SET-NAME = "LANG" (set just above; it is the record key) and the file.
           *> Result: WS-SET-VALUE = the saved language code ("pt", "es", ...), or SPACES when the
           *>         setting was never kept or the file is missing or cannot be opened.

           CALL    "PS-SETTING-GET" USING WS-SET-NAME WS-SET-VALUE

           *> WS-NEW-IX is the PS-TEXT column: 1 en, 2 pt, 3 es, 4 fr, 5 jp, 6 cn.
           *> A setting never kept, or any other code, means English.

           EVALUATE    WS-SET-VALUE(1:2)
               WHEN "pt" MOVE 2 TO WS-NEW-IX
               WHEN "es" MOVE 3 TO WS-NEW-IX
               WHEN "fr" MOVE 4 TO WS-NEW-IX
               WHEN "jp" MOVE 5 TO WS-NEW-IX
               WHEN "cn" MOVE 6 TO WS-NEW-IX
               WHEN OTHER MOVE 1 TO WS-NEW-IX
           END-EVALUATE

           *> Tmr-Lang calls this every second. WS-LANG-IX starts at 0, so the first
           *> call always applies the texts; later ones only when the language moved.

           IF    WS-NEW-IX NOT = WS-LANG-IX
               SET     WS-LANG-IX                TO    WS-NEW-IX

               *> PS-APPLY-TEXT: writes the texts of the chosen language on this window and selects
               *> it in the combo.
               *> Uses:   WS-LANG-IX (just set to WS-NEW-IX, 1-6) as the PS-TEXT column.
               *> Result: Lbl-Title::Caption = PS-TEXT row 1, Lbl-Language::Caption = row 2,
               *>         Btn-Close::Caption = row 3 (trimmed); Cmb-Language::SelectedIndex =
               *>         WS-LANG-IX, so the combo shows the language in use. No data item changes
               *>         here. That write raises onSelectedIndexChanged (so PS-SAVE-LANGUAGE runs)
               *>         only if the combo already holds a different index; the .cfrm designs none,
               *>         so the first write (at load) and a write of the pick raise nothing.

               CALL    "PS-APPLY-TEXT"
           END-IF
]]></Event>
    <Event name="PS-APPLY-TEXT" paragraph="PS-APPLY-TEXT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     Lbl-Title::Caption            TO    PS-TEXT(1, WS-LANG-IX)::Trim()
           SET     Lbl-Language::Caption         TO    PS-TEXT(2, WS-LANG-IX)::Trim()
           SET     Btn-Close::Caption            TO    PS-TEXT(3, WS-LANG-IX)::Trim()
           SET     Cmb-Language::SelectedIndex   TO    WS-LANG-IX
]]></Event>
    <Event name="PS-SAVE-LANGUAGE" paragraph="PS-SAVE-LANGUAGE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *>   The language picked is kept; every window follows within a second.

           SET     WS-PICK                       TO    Cmb-Language::SelectedIndex
           SET     WS-SET-NAME                   TO    "LANG"

           *> The combo lists the languages in PS-TEXT column order, so its index
           *> maps straight to the two-letter code kept in the settings.

           EVALUATE    WS-PICK
               WHEN 2 MOVE "pt" TO WS-SET-VALUE
               WHEN 3 MOVE "es" TO WS-SET-VALUE
               WHEN 4 MOVE "fr" TO WS-SET-VALUE
               WHEN 5 MOVE "jp" TO WS-SET-VALUE
               WHEN 6 MOVE "cn" TO WS-SET-VALUE
               WHEN OTHER MOVE "en" TO WS-SET-VALUE
           END-EVALUATE

           *> PS-SETTING-PUT: keeps one setting in the settings file (indexed, data/settings.idx or
           *> $POWERSPATIAL_DATA/settings.idx): written when new, rewritten when it was already
           *> there. The file is made the first time a setting is kept.
           *> Uses:   WS-SET-NAME = "LANG" (the record key) and WS-SET-VALUE = the code of the
           *>         language picked ("en", "pt", "es", "fr", "jp" or "cn", chosen just above from
           *>         WS-PICK).
           *> Result: The record LANG in the file holds WS-SET-VALUE. No data item changes. If the
           *>         file will not open, the setting is dropped without any sign.

           CALL    "PS-SETTING-PUT" USING WS-SET-NAME WS-SET-VALUE

           *> Re-read at once so this window follows now; the other windows catch
           *> up on their one-second Tmr-Lang tick.

           *> PS-LANG-CHECK: reads the saved language back and, when it is not the one on screen,
           *> applies its texts.
           *> Uses:   The LANG setting just kept (read through PS-SETTING-GET) and WS-LANG-IX, the
           *>         language on screen before the pick.
           *> Result: WS-SET-NAME = "LANG"; WS-SET-VALUE = the code just kept; WS-NEW-IX = 1-6 for
           *>         it. When WS-NEW-IX differs from WS-LANG-IX, WS-LANG-IX = WS-NEW-IX and
           *>         PS-APPLY-TEXT sets the Lbl-Title, Lbl-Language and Btn-Close captions and
           *>         Cmb-Language::SelectedIndex (a write of the index the combo already holds
           *>         raises no event).

           CALL    "PS-LANG-CHECK"
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="SETTINGS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-LANG-CHECK: reads the saved language and, when it is not the one on screen, applies
           *> its texts.
           *> Uses:   The LANG setting in the settings file, WS-LANG-IX = 0 (its VALUE at load) and,
           *>         for the captions, the PS-TEXT table.
           *> Result: WS-SET-NAME = "LANG"; WS-SET-VALUE = the code read (SPACES if none); WS-NEW-IX
           *>         = 1-6; WS-LANG-IX = WS-NEW-IX, so the first call always sets the captions and
           *>         selects the saved language in Cmb-Language. The combo holds no SelectedIndex
           *>         yet (the .cfrm designs none), so that write raises no onSelectedIndexChanged:
           *>         PS-SAVE-LANGUAGE does not run and nothing is saved at load.

           CALL    "PS-LANG-CHECK"
]]></Event>
  </form-events>
  <Control id="Pnl-Settings" type="Panel" x="0" y="0" w="440" h="240" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Dock">Fill</Property>
    <Property name="LayoutMode">Flex</Property>
    <Property name="FlexDirection">Column</Property>
    <Property name="Gap">14</Property>
    <Property name="Padding">28</Property>
    <Property name="HideBackground">true</Property>
    <Property name="BorderStyle">None</Property>
  </Control>
  <Control id="Lbl-Title" type="Label" x="28" y="28" w="384" h="34" tab-order="1" z-order="0" visible="true" enabled="true" parent="Pnl-Settings">
    <Property name="Caption">Settings</Property>
    <Property name="FontSize">24</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Transparency">100</Property>
  </Control>
  <Control id="Lbl-Language" type="Label" x="28" y="76" w="384" h="22" tab-order="2" z-order="0" visible="true" enabled="true" parent="Pnl-Settings">
    <Property name="Caption">Language</Property>
    <Property name="FontSize">14</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="Transparency">100</Property>
    <Property name="ForegroundColor">#FFFFFFAA</Property>
  </Control>
  <Control id="Cmb-Language" type="ComboBox" x="28" y="106" w="384" h="40" tab-order="3" z-order="0" visible="true" enabled="true" parent="Pnl-Settings">
    <Property name="Items">English
Português
Español
Français
日本語
中文</Property>
    <Property name="DropDownStyle">DropDownList</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">12</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Event name="onSelectedIndexChanged" paragraph="CMB-LANGUAGE--ONSELECTEDINDEXCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-SAVE-LANGUAGE: keeps the language the operator picked in the combo and applies it
           *> to this window.
           *> Uses:   Cmb-Language::SelectedIndex = the entry picked by the operator (1 English, 2
           *>         Portuguese, 3 Spanish, 4 French, 5 Japanese, 6 Chinese: the order of its
           *>         Items). It can also run after PS-APPLY-TEXT writes a different index, which
           *>         happens only if the saved language changed outside this window. PS-LANG-CHECK
           *>         also reads the settings file and WS-LANG-IX.
           *> Result: WS-PICK = that index; WS-SET-NAME = "LANG"; WS-SET-VALUE = "en", "pt", "es",
           *>         "fr", "jp" or "cn". PS-SETTING-PUT keeps it in the settings file, then
           *>         PS-LANG-CHECK reads it back: WS-NEW-IX = WS-PICK and, if that is a new
           *>         language, WS-LANG-IX = WS-PICK and PS-APPLY-TEXT sets the three captions and
           *>         Cmb-Language::SelectedIndex, so this window follows now. The other windows
           *>         follow on their Tmr-Lang tick (within a second), except the one that opened
           *>         this window (the rail or the main form): it is parked in OpenFormSync and
           *>         follows when this window closes.

           CALL    "PS-SAVE-LANGUAGE"
]]></Event>
  </Control>
  <Control id="Btn-Close" type="Button" x="292" y="172" w="120" h="44" tab-order="4" z-order="0" visible="true" enabled="true" parent="Pnl-Settings">
    <Property name="Caption">Close</Property>
    <Property name="FontSize">15</Property>
    <Property name="CornerRadius">22</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#0A84FFFF</Property>
    <Property name="AlignSelf">End</Property>
    <Event name="onClick" paragraph="BTN-CLOSE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           INVOKE    me::Close()
]]></Event>
  </Control>
  <Control id="Tmr-Lang" type="Timer" x="0" y="0" w="24" h="24" tab-order="5" z-order="0" visible="true" enabled="true">
    <Property name="Interval">1000</Property>
    <Event name="onTick" paragraph="TMR-LANG--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> PS-LANG-CHECK: Tmr-Lang fires every 1000 ms; each tick re-reads the saved language.
           *> Uses:   The LANG setting in the settings file, WS-LANG-IX (the language on screen)
           *>         and, for the captions, the PS-TEXT table.
           *> Result: Every tick: WS-SET-NAME = "LANG", WS-SET-VALUE = the code read (SPACES if
           *>         none), WS-NEW-IX = 1-6. Only when WS-NEW-IX differs from WS-LANG-IX are
           *>         WS-LANG-IX and the texts changed (PS-APPLY-TEXT; its
           *>         Cmb-Language::SelectedIndex write raises onSelectedIndexChanged, and so runs
           *>         PS-SAVE-LANGUAGE, only if the combo already holds a different index).

           CALL    "PS-LANG-CHECK"
]]></Event>
  </Control>
</Form>
