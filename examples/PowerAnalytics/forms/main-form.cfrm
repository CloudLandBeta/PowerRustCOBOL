    <Event name="SHOW-C-GRID" paragraph="SHOW-C-GRID"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           INVOKE C-GRID::Show()
           INVOKE C-GRID::PlayAnimation("intro")
           INVOKE LBL-GRID-T::PlayAnimation("intro")
           INVOKE LBL-GRID-S::PlayAnimation("intro")
           INVOKE CMB-ORDER::PlayAnimation("intro")
           INVOKE GRD-FUNDOS::PlayAnimation("intro")
           INVOKE BTN-PREV::PlayAnimation("intro")
           INVOKE LBL-PAGE::PlayAnimation("intro")
           INVOKE BTN-NEXT::PlayAnimation("intro")
]]></Event>
    <Event name="SHOW-VIEW" paragraph="SHOW-VIEW"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-VIEW = "D"
               INVOKE PG-DATA::Hide()
               INVOKE PG-DASH::Show()
               MOVE "#3E7BE8" TO BTN-DASH::BackgroundColor
               MOVE "#FFFFFF" TO BTN-DASH::ForegroundColor
               MOVE "#FFFFFF" TO BTN-DATA::BackgroundColor
               MOVE "#1B2A4E" TO BTN-DATA::ForegroundColor
           ELSE
               INVOKE PG-DASH::Hide()
               INVOKE PG-DATA::Show()
               MOVE "#3E7BE8" TO BTN-DATA::BackgroundColor
               MOVE "#FFFFFF" TO BTN-DATA::ForegroundColor
               MOVE "#FFFFFF" TO BTN-DASH::BackgroundColor
               MOVE "#1B2A4E" TO BTN-DASH::ForegroundColor
               IF WS-GSTAGE = 0
                   CALL "STAGE-START-G"
               END-IF
           END-IF
]]></Event>
    <Event name="SET-FILT-HEIGHT" paragraph="SET-FILT-HEIGHT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-H1 PIC 9(4).
       01 WS-H2 PIC 9(4).
       01 WS-Y1 PIC 9(4).
       01 WS-FWID PIC 9(5).
       PROCEDURE DIVISION.
           MOVE me::Breakpoint TO WS-BP
           MOVE me::Width TO WS-FWID
           EVALUATE WS-BP
               WHEN "Compact"
                   MOVE 332 TO WS-H1
                   MOVE 380 TO WS-H2
               WHEN "Medium"
                   MOVE 196 TO WS-H2
                   EVALUATE TRUE
                       WHEN WS-FWID >= 820
                           MOVE 136 TO WS-H1
                       WHEN WS-FWID >= 650
                           MOVE 196 TO WS-H1
                       WHEN OTHER
                           MOVE 256 TO WS-H1
                   END-EVALUATE
               WHEN OTHER
                   MOVE 196 TO WS-H2
                   IF WS-FWID >= 1360
                       MOVE 76 TO WS-H1
                   ELSE
                       MOVE 136 TO WS-H1
                   END-IF
           END-EVALUATE
           MOVE WS-H1 TO FILT::Height
           COMPUTE WS-Y1 = 24 + 64 + 20 + WS-H1 + 8
           MOVE WS-Y1 TO LV-DROP::Y
           MOVE WS-H2 TO LV-DROP::Height
           MOVE WS-Y1 TO SM-DROP::Y
           IF WS-BP = "Expanded"
               MOVE 0 TO PG-DASH::VScroll
               MOVE 0 TO PG-DATA::VScroll
           ELSE
               MOVE 1 TO PG-DASH::VScroll
               MOVE 1 TO PG-DATA::VScroll
           END-IF
]]></Event>
    <Event name="CLOSE-LEVELS" paragraph="CLOSE-LEVELS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-LEVELS-OPEN = 1
               MOVE 0 TO WS-LEVELS-OPEN
               INVOKE LV-DROP::Hide()
               INVOKE SCRIM::Hide()
               MOVE "Níveis 2 e 3" TO BTN-LEVELS::Caption
           END-IF
]]></Event>
    <Event name="CLEAR-FILTERS" paragraph="CLEAR-FILTERS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "SM-CLOSE"
           MOVE SPACES TO TXT-NOME::Text
           MOVE SPACES TO TXT-CAT::Text
           MOVE SPACES TO WS-LAST-N
           MOVE SPACES TO WS-LAST-C
           MOVE "1970-01-01" TO DTP-INI::Value
           MOVE "2027-12-31" TO DTP-FIM::Value
           MOVE 0 TO NUD-PL1::Value
           MOVE 300000 TO NUD-PL2::Value
           MOVE SPACES TO LST-N2::CheckedItems
           MOVE SPACES TO LST-N3::CheckedItems
           CALL "SM-RESET"
           CALL "APPLY-FILTERS"
]]></Event>
    <Event name="STAGE-TICK" paragraph="STAGE-TICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TIME PIC 9(8).
       01 WS-NOW  PIC 9(9).
       PROCEDURE DIVISION.
           ACCEPT WS-TIME FROM TIME
           COMPUTE WS-NOW = (WS-TIME(1:2) * 3600 + WS-TIME(3:2) * 60 + WS-TIME(5:2)) * 1000 + WS-TIME(7:2) * 10
           IF WS-NOW >= WS-T0
               COMPUTE WS-ELAPSED = WS-NOW - WS-T0
           ELSE
               COMPUTE WS-ELAPSED = WS-NOW + 86400000 - WS-T0
           END-IF
           IF WS-DSTAGE = 1 AND WS-ELAPSED >= 0
               CALL "SHOW-C-KPI"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 2 AND WS-ELAPSED >= 400
               CALL "SHOW-C-BAR"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 3 AND WS-ELAPSED >= 800
               CALL "SHOW-C-RADAR"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 4 AND WS-ELAPSED >= 1200
               CALL "SHOW-C-GOALS"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 5 AND WS-ELAPSED >= 1600
               CALL "SHOW-C-DONUT1"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 6 AND WS-ELAPSED >= 2000
               CALL "SHOW-C-DONUT2"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 7 AND WS-ELAPSED >= 2400
               CALL "SHOW-C-LINE"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-DSTAGE = 8 AND WS-ELAPSED >= 2800
               CALL "SHOW-C-BINS"
               ADD 1 TO WS-DSTAGE
           END-IF
           IF WS-CHARTS = 0 AND WS-DSTAGE > 8 AND WS-ELAPSED >= 4750
               INVOKE SPK::Show()
               INVOKE CH-BAR::Show()
               INVOKE CH-RADAR::Show()
               INVOKE CH-DONUT1::Show()
               INVOKE CH-DONUT2::Show()
               INVOKE CH-LINE::Show()
               MOVE 1 TO WS-CHARTS
           END-IF
           IF WS-GSTAGE >= 1 AND WS-GSTAGE <= 6
               IF WS-NOW >= WS-T0G
                   COMPUTE WS-ELAPSED = WS-NOW - WS-T0G
               ELSE
                   COMPUTE WS-ELAPSED = WS-NOW + 86400000 - WS-T0G
               END-IF
           IF WS-GSTAGE = 1 AND WS-ELAPSED >= 0
               CALL "SHOW-K1-C"
               ADD 1 TO WS-GSTAGE
           END-IF
           IF WS-GSTAGE = 2 AND WS-ELAPSED >= 400
               CALL "SHOW-K2-C"
               ADD 1 TO WS-GSTAGE
           END-IF
           IF WS-GSTAGE = 3 AND WS-ELAPSED >= 800
               CALL "SHOW-K3-C"
               ADD 1 TO WS-GSTAGE
           END-IF
           IF WS-GSTAGE = 4 AND WS-ELAPSED >= 1200
               CALL "SHOW-K4-C"
               ADD 1 TO WS-GSTAGE
           END-IF
           IF WS-GSTAGE = 5 AND WS-ELAPSED >= 1600
               CALL "SHOW-K5-C"
               ADD 1 TO WS-GSTAGE
           END-IF
           IF WS-GSTAGE = 6 AND WS-ELAPSED >= 2000
               CALL "SHOW-C-GRID"
               ADD 1 TO WS-GSTAGE
           END-IF
           END-IF
           IF WS-DSTAGE > 8 AND WS-CHARTS = 1 AND (WS-GSTAGE = 0 OR WS-GSTAGE > 6)
               MOVE 0 TO TMR-STAGE::Enabled
           END-IF
]]></Event>
    <Event name="STAGE-START" paragraph="STAGE-START"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TIME PIC 9(8).
       PROCEDURE DIVISION.
           ACCEPT WS-TIME FROM TIME
           COMPUTE WS-T0 = (WS-TIME(1:2) * 3600 + WS-TIME(3:2) * 60 + WS-TIME(5:2)) * 1000 + WS-TIME(7:2) * 10
           MOVE 1 TO WS-DSTAGE
           MOVE 1 TO TMR-STAGE::Enabled
]]></Event>
    <Event name="STAGE-START-G" paragraph="STAGE-START-G"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TIME PIC 9(8).
       PROCEDURE DIVISION.
           ACCEPT WS-TIME FROM TIME
           COMPUTE WS-T0G = (WS-TIME(1:2) * 3600 + WS-TIME(3:2) * 60 + WS-TIME(5:2)) * 1000 + WS-TIME(7:2) * 10
           MOVE 1 TO WS-GSTAGE
           MOVE 1 TO TMR-STAGE::Enabled
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="MAIN-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "INIT-DB"
           CALL "LOAD-DIMS"
           INVOKE GRD-FUNDOS::SetColumnWidth(1, 330)
           INVOKE GRD-FUNDOS::SetColumnWidth(2, 110)
           INVOKE GRD-FUNDOS::SetColumnWidth(3, 90)
           INVOKE GRD-FUNDOS::SetColumnWidth(4, 120)
           INVOKE GRD-FUNDOS::SetColumnWidth(5, 170)
           INVOKE GRD-FUNDOS::SetColumnWidth(6, 170)
           INVOKE GRD-FUNDOS::SetColumnWidth(7, 92)
           INVOKE GRD-FUNDOS::SetColumnWidth(8, 120)
           INVOKE GRD-FUNDOS::SetColumnWidth(9, 90)
           INVOKE GRD-FUNDOS::SetColumnWidth(10, 110)
           INVOKE GRD-FUNDOS::SetColumnWidth(11, 190)
           INVOKE GRD-FUNDOS::SetColumnWidth(12, 130)
           INVOKE GRD-FUNDOS::SetColumnWidth(13, 130)
           INVOKE GRD-FUNDOS::SetColumnWidth(14, 70)
           INVOKE GRD-FUNDOS::SetColumnWidth(15, 90)
           INVOKE GRD-FUNDOS::SetColumnWidth(16, 130)
           CALL "SET-FILT-HEIGHT"
           CALL "APPLY-FILTERS"
           CALL "STAGE-START"
]]></Event>
    <Event name="onClose" paragraph="MAIN-FORM--ONCLOSE">
    </Event>
    <Event name="onBreakpointChanged" paragraph="MAIN-FORM--ONBREAKPOINTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "SET-FILT-HEIGHT"
]]></Event>
    <Event name="onResize" paragraph="MAIN-FORM--ONRESIZE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "SET-FILT-HEIGHT"
]]></Event>
  </form-events>
