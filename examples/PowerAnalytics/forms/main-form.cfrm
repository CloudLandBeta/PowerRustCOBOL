    <Event name="onCheckedChanged" paragraph="SW-ACUM--ONCHECKEDCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    SW-ACUM::Checked = 1
               SET     WS-ACUM                   TO    1
           ELSE
               SET     WS-ACUM                   TO    0
           END-IF
           CALL    "PAINT-YEARS"
]]></Event>
