  <Control id="CMB-ORDER" type="ComboBox" x="1124" y="224" w="230" h="34" tab-order="192" z-order="191" visible="true" enabled="true" parent="C-GRID">
    <Property name="BackgroundColor">#FFFFFF</Property>
