  <Control id="BTN-M1" type="Button" x="401" y="248" w="84" h="26" tab-order="47" z-order="46" visible="true" enabled="true" parent="C-BAR">
    <Property name="Caption">Fundos</Property>
    <Property name="BackgroundColor">#3E7BE8</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontSize">12</Property>
    <Property name="Bold">true</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">13</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="Transparency">10</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-M1--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-METRIC                     TO    1

           *> PAINT-YEARS: repaints the yearly bar and line charts for the metric in WS-METRIC, and
           *> the PL sparkline SPK.
           *> Uses:   WS-METRIC = 1 (the number of funds), set just above; WS-ACUM (1 = running
           *>         totals in CH-LINE; its VALUE is 1 and SW-ACUM changes it) and the yearly
           *>         tables of Q-YEARS.
           *> Result: CH-BAR shows the number of funds per start year; CH-LINE the same as running
           *>         totals while WS-ACUM = 1 (seeded with the funds that began before the 12-year
           *>         window), otherwise per year; SPK is refilled (always the cumulative PL);
           *>         XAxisLabel, SeriesLabels and SeriesColors of both charts are rewritten;
           *>         LBL-BAR-U::Caption and LBL-LIN-U::Caption = "quantidade de fundos";
           *>         LBL-BAR-TOT::Caption = WS-T-CNT as a count.

           CALL    "PAINT-YEARS"

           *> PAINT-TABS: highlights the metric button (Fundos, PL, Cotistas) that WS-METRIC
           *> selects.
           *> Uses:   WS-METRIC = 1, set above.
           *> Result: BTN-M1 gets BackgroundColor "#3E7BE8" and ForegroundColor "#FFFFFF"; BTN-M2
           *>         and BTN-M3 go back to "#FFFFFF" with text "#1B2A4E".

           CALL    "PAINT-TABS"
]]></Event>
    <Animation name="intro" trigger="Programmatic" kind="ZoomOut" duration="1800" delay="0" easing="Elastic" repeat="Once" slide-dx="0" slide-dy="0"/>
  </Control>
  <Control id="BTN-M2" type="Button" x="492" y="248" w="56" h="26" tab-order="48" z-order="47" visible="true" enabled="true" parent="C-BAR">
    <Property name="Caption">PL</Property>
    <Property name="BackgroundColor">#FFFFFF</Property>
    <Property name="ForegroundColor">#1B2A4E</Property>
