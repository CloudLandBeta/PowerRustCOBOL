  <Control id="BTN-SM-CLR" type="Button" x="1156" y="450" w="130" h="32" tab-order="208" z-order="207" visible="true" enabled="true" parent="SM-DROP">
    <Property name="Caption">Limpar seleção</Property>
    <Property name="BackgroundColor">#FFFFFF</Property>
    <Property name="ForegroundColor">#1B2A4E</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">true</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">14</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="Transparency">10</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-SM-CLR--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLEAR-PICKS: forgets the picks kept for the open dropdown.
           *> Uses:   WS-SM ("N" or "C"): the dropdown that is open.
           *> Result: WS-ALL-N or WS-ALL-C = 0; the rows of pick with fld = WS-SM deleted;
           *>         LST-SM::CheckedItems = SPACES (no row ticked, "Todos" included);
           *>         LBL-SM-INFO::Caption = the "nenhum marcado" message; the captions of
           *>         LBL-F-NOME and LBL-F-CAT recomputed (the open box's goes back to its plain
           *>         text). The filter is not applied.

           CALL    "SM-CLEAR-PICKS"
]]></Event>
  </Control>
  <Control id="BTN-SM-OK" type="Button" x="1294" y="450" w="100" h="32" tab-order="209" z-order="208" visible="true" enabled="true" parent="SM-DROP">
    <Property name="Caption">Aplicar</Property>
    <Property name="BackgroundColor">#3E7BE8</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">true</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">14</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="Transparency">10</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-SM-OK--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLOSE: closes the search dropdown when one is open.
           *> Uses:   WS-SM ("N" or "C" while a dropdown is open, SPACE otherwise).
           *> Result: Only when WS-SM was not SPACE: WS-SM = SPACE and POPUP-SEARCH::Visible =
           *>         FALSE.

           CALL    "SM-CLOSE"

           *> APPLY-FILTERS: re-runs every query and repaints the dashboard, the charts and the grid
           *> for the current filters; it exits at once while WS-LOADED = 0.
           *> Uses:   the picks and Todos flags made in the dropdown (table pick, WS-ALL-N,
           *>         WS-ALL-C; in Todos mode the picks are ignored and the typed text is used), the
           *>         text of TXT-NOME and TXT-CAT and the other filters.
           *> Result: WS-PAGE = 1; WS-WHERE rebuilt from the controls; the Q-* steps recompute the
           *>         totals (WS-T-*), WS-CAT-*, WS-RANK, WS-N2-*, WS-BIN-CNT, WS-TOP-* and the year
           *>         tables; the PAINT-* steps repaint the KPI card, the charts, the top-4 list
           *>         with the Classe / Subclasse bars, the Dados cards and the metric buttons;
           *>         GRD-FUNDOS shows page 1, with its caption LBL-GRID-S, the page label LBL-PAGE
           *>         and BTN-PREV / BTN-NEXT enabled to match.

           CALL    "APPLY-FILTERS"
]]></Event>
  </Control>
  <Control id="SCRIM-SM" type="Panel" x="0" y="492" w="1440" h="1000" tab-order="210" z-order="209" visible="true" enabled="true" layer="POPUP-SEARCH">
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="HideBackground">true</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="CornerRadius">0</Property>
    <Event name="onClick" paragraph="SCRIM-SM--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLOSE: closes the search dropdown when one is open.
           *> Uses:   WS-SM ("N" or "C" while a dropdown is open, SPACE otherwise); the click landed
           *>         outside the dropdown.
           *> Result: Only when WS-SM was not SPACE: WS-SM = SPACE and POPUP-SEARCH::Visible =
           *>         FALSE. The filter is not applied; the picks made stay in table pick.

           CALL    "SM-CLOSE"
]]></Event>
  </Control>
  <Control id="SCRIM-LV" type="Panel" x="0" y="388" w="1440" h="1000" tab-order="213" z-order="212" visible="true" enabled="true" layer="POPUP-LEVELS">
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="HideBackground">true</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="CornerRadius">0</Property>
    <Event name="onClick" paragraph="SCRIM-LV--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> CLOSE-LEVELS: closes the Levels 2 and 3 popup when it is open.
           *> Uses:   WS-LEVELS-OPEN (1 = the Levels card is open); the click landed outside the
           *>         card.
           *> Result: Only when WS-LEVELS-OPEN = 1: WS-LEVELS-OPEN = 0, POPUP-LEVELS::Visible =
           *>         FALSE and BTN-LEVELS::Caption = "Níveis 2 e 3". The ticks of LST-N2 and LST-N3
           *>         stay and count in the next filter run.

           CALL    "CLOSE-LEVELS"
]]></Event>
  </Control>
