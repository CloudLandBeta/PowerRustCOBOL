  <Control id="TMR-STAGE" type="Timer" x="0" y="0" w="24" h="24" tab-order="212" z-order="211" visible="true" enabled="true">
    <Property name="Interval">50</Property>
    <Property name="Enabled">false</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onTick" paragraph="TMR-STAGE--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> STAGE-TICK: runs the entrance steps that are due: dashboard cards, then the charts,
           *> then the Dados cards.
           *> Uses:   the TMR-STAGE tick (Interval 50 ms while Enabled), the clock, WS-T0 / WS-T0G
           *>         and the stage counters WS-DSTAGE, WS-GSTAGE and WS-CHARTS.
           *> Result: WS-ELAPSED = ms since WS-T0, then recomputed as ms since WS-T0G while the
           *>         Dados steps (WS-GSTAGE 1 to 6) are pending; each step that is due runs its
           *>         SHOW-* procedure and adds 1 to WS-DSTAGE or WS-GSTAGE; at 4750 ms the six
           *>         charts are shown once (WS-CHARTS = 1); TMR-STAGE::Enabled = 0 when nothing is
           *>         pending.

           CALL    "STAGE-TICK"
]]></Event>
  </Control>
