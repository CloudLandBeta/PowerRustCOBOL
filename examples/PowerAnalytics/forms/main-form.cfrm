  <Control id="SW-ACUM" type="Switch" x="598" y="713" w="52" h="26" tab-order="138" z-order="137" visible="true" enabled="true" parent="C-LINE">
    <Property name="Checked">true</Property>
    <Property name="Accent">#22C3D6</Property>
    <Property name="Anchor">Top,Right</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="CornerRadius">0</Property>
    <Event name="onCheckedChanged" paragraph="SW-ACUM--ONCHECKEDCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    SW-ACUM::Checked = 1
               SET     WS-ACUM                   TO    1
           ELSE
               SET     WS-ACUM                   TO    0
           END-IF

           *> PAINT-YEARS: repaints the yearly bar and line charts for the metric in WS-METRIC, and
           *> the PL sparkline SPK.
           *> Uses:   WS-ACUM = 1 when SW-ACUM::Checked = 1, otherwise 0 (set just above); WS-METRIC
           *>         is unchanged.
           *> Result: CH-LINE redrawn with running totals (seeded with the funds that began before
           *>         the 12-year window) when WS-ACUM = 1, otherwise with each year alone; CH-BAR,
           *>         SPK, the axis and series labels, the series colours and the captions are
           *>         rewritten with the same values as before.

           CALL    "PAINT-YEARS"
]]></Event>
    <Animation name="intro" trigger="Programmatic" kind="ZoomOut" duration="1800" delay="0" easing="Elastic" repeat="Once" slide-dx="0" slide-dy="0"/>
  </Control>
