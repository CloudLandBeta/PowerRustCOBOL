  <working-storage><![CDATA[       01 WS-H                                   GLOBAL    PIC S9(9)    COMP-5.
       01 WS-N                                   GLOBAL    PIC S9(9)    COMP-5.
       01 WS-FS                                  GLOBAL    PIC XX.
       01 WS-ROW                                 GLOBAL    PIC X(1600).
       01 WS-SQL                                 GLOBAL    PIC X(8000).
       01 WS-WHERE                               GLOBAL    PIC X(3000).
       01 WS-P                                   GLOBAL    PIC 9(5).
       01 WS-VIEW                                GLOBAL    PIC X    VALUE "D".
       01 WS-METRIC                              GLOBAL    PIC 9    VALUE 1.
       01 WS-ACUM                                GLOBAL    PIC 9    VALUE 1.
       01 WS-LEVELS-OPEN                         GLOBAL    PIC 9    VALUE 0.
       01 WS-LOADED                              GLOBAL    PIC 9    VALUE 0.
       01 WS-PAGE                                GLOBAL    PIC 9(5)    VALUE 1.
       01 WS-PAGES                               GLOBAL    PIC 9(5)    VALUE 1.
       01 WS-PSIZE                               GLOBAL    PIC 9(4)    VALUE 300.
       01 WS-UNIV                                GLOBAL    PIC 9(9)    VALUE 0.
       01 WS-CATCNT                              GLOBAL    PIC 99    VALUE 0.
       01 WS-FV                                  GLOBAL    PIC 9(15)V99.
       01 WS-FC                                  GLOBAL    PIC 9(12).
       01 WS-FP                                  GLOBAL    PIC 9(3)V9.
       01 WS-FT                                  GLOBAL    PIC X(24).
       01 WS-CHK                                 GLOBAL    PIC X(1200).
       01 WS-IN                                  GLOBAL    PIC X(1500).
       01 WS-SM                                  GLOBAL    PIC X    VALUE SPACE.
       01 WS-SMX                                 GLOBAL    PIC X    VALUE SPACE.
       01 WS-ALL-N                               GLOBAL    PIC 9    VALUE 0.
       01 WS-ALL-C                               GLOBAL    PIC 9    VALUE 0.
       01 WS-TERM                                GLOBAL    PIC X(80).
       01 WS-LAST-N                              GLOBAL    PIC X(80).
       01 WS-LAST-C                              GLOBAL    PIC X(80).
       01 WS-PAT                                 GLOBAL    PIC X(90).
       01 WS-ONE                                 GLOBAL    PIC X(200).
       01 WS-ESC                                 GLOBAL    PIC X(420).
       01 WS-BIG                                 GLOBAL    PIC X(24000).
       01 WS-BPTR                                GLOBAL    PIC 9(5).
       01 WS-SMN                                 GLOBAL    PIC 9(9)    VALUE 0.
       01 WS-SMK                                 GLOBAL    PIC 9(9)    VALUE 0.
       01 WS-T0                                  GLOBAL    PIC 9(9)    VALUE 0.
       01 WS-ELAPSED                             GLOBAL    PIC S9(9)    VALUE 0.
       01 WS-STAGE                               GLOBAL    PIC 99    VALUE 0.
       01 WS-COLOR-DATA                          GLOBAL.
           05 FILLER                             PIC    X(7)    VALUE "#3E7BE8".
           05 FILLER                             PIC    X(7)    VALUE "#F5A524".
           05 FILLER                             PIC    X(7)    VALUE "#22C3D6".
           05 FILLER                             PIC    X(7)    VALUE "#8B5CF6".
           05 FILLER                             PIC    X(7)    VALUE "#2FBF71".
           05 FILLER                             PIC    X(7)    VALUE "#F0527A".
           05 FILLER                             PIC    X(7)    VALUE "#FF7A45".
           05 FILLER                             PIC    X(7)    VALUE "#394670".
           05 FILLER                             PIC    X(7)    VALUE "#B5D334".
           05 FILLER                             PIC    X(7)    VALUE "#C9D3E6".
       01 WS-COLOR-TAB                           REDEFINES    WS-COLOR-DATA    GLOBAL.
           05 WS-COLOR                           PIC    X(7)    OCCURS 10.
       01 WS-CAT-TAB                             GLOBAL.
           05 WS-CAT-ROW                         OCCURS    10.
               10 WS-CAT-NAME                    PIC    X(24).
               10 WS-CAT-CNT                     PIC    9(9).
               10 WS-CAT-PL                      PIC    9(15)V99.
               10 WS-CAT-COT                     PIC    9(12).
               10 WS-CAT-USED                    PIC    9.
       01 WS-TOT                                 GLOBAL.
           05 WS-T-CNT                           PIC    9(9).
           05 WS-T-PL                            PIC    9(15)V99.
           05 WS-T-COT                           PIC    9(12).
           05 WS-T-PLN                           PIC    9(9).
           05 WS-T-MAX                           PIC    9(15)V99.
           05 WS-T-YMAX                          PIC    9(4).
           05 WS-T-CLS                           PIC    9(15)V99.
           05 WS-T-SUB                           PIC    9(15)V99.
           05 WS-T-TOPN                          PIC    X(60).
       01 WS-N2-TAB                              GLOBAL.
           05 WS-N2-ROW                          OCCURS    10.
               10 WS-N2-NAME                     PIC    X(24).
               10 WS-N2-CNT                      PIC    9(9).
       01 WS-N2-TOTAL                            GLOBAL    PIC 9(9).
       01 WS-BIN-TAB                             GLOBAL.
           05 WS-BIN-CNT                         PIC    9(9)    OCCURS 5.
       01 WS-TOP-TAB                             GLOBAL.
           05 WS-TOP-ROW                         OCCURS    4.
               10 WS-TOP-NAME                    PIC    X(40).
               10 WS-TOP-PL                      PIC    9(15)V99.
       01 WS-TOP-N                               GLOBAL    PIC 9.
       01 WS-RANK-TAB                            GLOBAL.
           05 WS-RANK                            PIC    99    OCCURS 10.
       01 WS-TOP3                                GLOBAL.
           05 WS-TOP3-IDX                        PIC    99    OCCURS 3.
       01 WS-YR-TAB                              GLOBAL.
           05 WS-YR-MIN                          PIC    9(4).
           05 WS-YR                              OCCURS    12.
               10 WS-YR-NUM                      PIC    9(4).
               10 WS-YA-CNT                      PIC    9(9).
               10 WS-YA-PL                       PIC    9(15)V99.
               10 WS-YA-COT                      PIC    9(12).
               10 WS-YS                          OCCURS    3.
                   15 WS-YS-CNT                  PIC    9(9).
                   15 WS-YS-PL                   PIC    9(15)V99.
                   15 WS-YS-COT                  PIC    9(12).
       01 WS-OFF-TAB                             GLOBAL.
           05 WS-OA-CNT                          PIC    9(9).
           05 WS-OA-PL                           PIC    9(15)V99.
           05 WS-OA-COT                          PIC    9(12).
           05 WS-OS                              OCCURS    3.
               10 WS-OS-CNT                      PIC    9(9).
               10 WS-OS-PL                       PIC    9(15)V99.
               10 WS-OS-COT                      PIC    9(12).
       01 WS-BP                                  GLOBAL    PIC X(12).
       01 WS-CHARTS                              GLOBAL    PIC 9    VALUE 0.
       01 WS-DSTAGE                              GLOBAL    PIC 99    VALUE 1.
       01 WS-GSTAGE                              GLOBAL    PIC 99    VALUE 0.
       01 WS-T0G                                 GLOBAL    PIC 9(9)    VALUE 0.
]]></working-storage>
