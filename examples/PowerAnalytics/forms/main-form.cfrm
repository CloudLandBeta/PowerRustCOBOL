  <Layer name="POPUP-LEVELS" color="#00000000"/>
  <Layer name="POPUP-SEARCH" color="#00000000"/>
  <FormLayout FontScaling="Fluid" MaxFontScale="1.3" MinFormHeight="520" MinFormWidth="360"/>
