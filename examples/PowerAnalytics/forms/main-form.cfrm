]]></repository>
  <file-control><![CDATA[           SELECT SQL-FILE ASSIGN TO "data/fundos.sql"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS.
]]></file-control>
  <file-section><![CDATA[       FD SQL-FILE IS GLOBAL.
       01 SQL-REC                                PIC    X(30000).
]]></file-section>
  <user-procedures>
    <Event name="FMT-SHORT" paragraph="FMT-SHORT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-FD                                  PIC    9(4)V99.
       01 WS-ED                                  PIC    ZZZ9.99.
       01 WS-EX                                  PIC    X(9).
       01 WS-SUF                                 PIC    X(4).

       PROCEDURE DIVISION.
           SET     WS-SUF                        TO    SPACES
           *> Scale to the largest unit WS-FV reaches (mil, mi, bi, tri), which keeps
           *> the mantissa small enough for WS-FD; below 1000 it is shown as is.

           IF    WS-FV >= 1000000000000
               COMPUTE    WS-FD ROUNDED = WS-FV / 1000000000000
               SET     WS-SUF                    TO    "tri"
           ELSE
               IF    WS-FV >= 1000000000
                   COMPUTE    WS-FD ROUNDED = WS-FV / 1000000000
                   SET     WS-SUF                TO    "bi"
               ELSE
                   IF    WS-FV >= 1000000
                       COMPUTE    WS-FD ROUNDED = WS-FV / 1000000
                       SET     WS-SUF            TO    "mi"
                   ELSE
                       IF    WS-FV >= 1000
                           COMPUTE    WS-FD ROUNDED = WS-FV / 1000
                           SET     WS-SUF        TO    "mil"
                       ELSE
                           SET     WS-FD         TO    WS-FV
                       END-IF
                   END-IF
               END-IF
           END-IF

           SET     WS-ED                         TO    WS-FD
           SET     WS-EX                         TO    WS-ED

           *> The edited picture prints a decimal point; pt-BR writes a comma.

           INSPECT    WS-EX CONVERTING "." TO ","
           SET     WS-FT                         TO    SPACES
           STRING    FUNCTION TRIM(WS-EX) " " FUNCTION TRIM(WS-SUF) INTO WS-FT
]]></Event>
    <Event name="FMT-SHORTN" paragraph="FMT-SHORTN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-FV < 1000
               SET     WS-FC                     TO    WS-FV
               CALL    "FMT-COUNT"
           ELSE
               CALL    "FMT-SHORT"
           END-IF
]]></Event>
    <Event name="FMT-COUNT" paragraph="FMT-COUNT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ED                                  PIC    ZZZ,ZZZ,ZZZ,ZZ9.
       01 WS-EX                                  PIC    X(20).

       PROCEDURE DIVISION.
           SET     WS-ED                         TO    WS-FC
           SET     WS-EX                         TO    WS-ED

           *> The picture groups thousands with commas; pt-BR groups with a point.

           INSPECT    WS-EX CONVERTING "," TO "."
           SET     WS-FT                         TO    FUNCTION TRIM(WS-EX)
]]></Event>
    <Event name="FMT-PCT" paragraph="FMT-PCT"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ED                                  PIC    ZZ9.9.
       01 WS-EX                                  PIC    X(8).

       PROCEDURE DIVISION.
           SET     WS-ED                         TO    WS-FP
           SET     WS-EX                         TO    WS-ED

           *> The edited picture prints a decimal point; pt-BR writes a comma.

           INSPECT    WS-EX CONVERTING "." TO ","
           SET     WS-FT                         TO    SPACES
           STRING    FUNCTION TRIM(WS-EX) "%" INTO WS-FT
]]></Event>
    <Event name="INIT-DB" paragraph="INIT-DB"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Builds the database in memory from data/fundos.sql, one statement per
           *> line. A .db path would be resolved from the working directory, while
           *> ASSIGN TO resolves from the project, so the SQL text runs from anywhere.

           SET     WS-H                          TO    DB-1::Open(":memory:")
           OPEN    INPUT SQL-FILE
           IF    WS-FS NOT = "00"
               SET     LBL-STATUS::Caption       TO    "Base de dados não encontrada (data/fundos.sql)"
               EXIT PARAGRAPH
           END-IF
           SET     WS-N                          TO    DB-1::Execute("BEGIN")
           PERFORM    UNTIL 1 = 2
               READ    SQL-FILE
                   AT END EXIT PERFORM
               END-READ
               SET     WS-N                      TO    DB-1::Execute(SQL-REC)
           END-PERFORM
           SET     WS-N                          TO    DB-1::Execute("COMMIT")
           CLOSE    SQL-FILE

           *> Picker state, keyed by fld ('N' name, 'C' category): pick = ticked
           *> names that persist, vis = rows the open list shows, chk = ticks being
           *> read back from the list.

           SET     WS-N                          TO    DB-1::Execute("CREATE TABLE pick (fld TEXT, name TEXT, PRIMARY KEY (fld, name))")
           SET     WS-N                          TO    DB-1::Execute("CREATE TABLE vis (fld TEXT, name TEXT)")
           SET     WS-N                          TO    DB-1::Execute("CREATE TABLE chk (name TEXT)")
           SET     WS-LOADED                     TO    1
]]></Event>
    <Event name="LOAD-DIMS" paragraph="LOAD-DIMS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(60).
       01 WS-I                                   PIC    99.
       01 WS-TXT                                 PIC    X(120).

       PROCEDURE DIVISION.
           SET     WS-SQL                        TO    "SELECT COUNT(*) FROM fundos"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()

           COMPUTE    WS-UNIV = FUNCTION NUMVAL(WS-ROW)

           SET     WS-SQL                        TO    "SELECT COALESCE(strftime('%d/%m/%Y', MAX(data_ref)),'') FROM fundos"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()
           SET     WS-FC                         TO    WS-UNIV

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           STRING    "Base ANBIMA  |  referência " WS-ROW::Trim() "  |  " WS-FT::Trim() " fundo(s)"
               INTO WS-TXT
           SET     LBL-STATUS::Caption           TO    WS-TXT

           LST-N2::Clear()
           LST-N3::Clear()

           *> The 10 most populated level-1 categories, most funds first, fill the
           *> fixed table WS-CAT-TAB. Q-CATS later matches its counts to these slots
           *> by name, so a category keeps its slot under any filter.

           SET     WS-CATCNT                     TO    0
           SET     WS-SQL                        TO    "SELECT nivel1 FROM fundos WHERE nivel1 IS NOT NULL GROUP BY nivel1 ORDER BY COUNT(*) DESC"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)

           *> Fetch() returns an empty row when the result is spent, and a NULL reads
           *> as empty too: the queries filter IS NOT NULL so a NULL cannot end the
           *> loop early.

           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               IF    WS-CATCNT < 10
                   ADD    1 TO WS-CATCNT
                   SET     WS-CAT-NAME(WS-CATCNT)
                                                 TO    WS-ROW
               END-IF
           END-PERFORM

           SET     WS-SQL                        TO    "SELECT nivel2 FROM fundos WHERE nivel2 IS NOT NULL GROUP BY nivel2 ORDER BY COUNT(*) DESC"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)

           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               LST-N2::AddItem(WS-ROW::Trim())
           END-PERFORM

           SET     WS-SQL                        TO    "SELECT nivel3 FROM fundos WHERE nivel3 IS NOT NULL GROUP BY nivel3 ORDER BY COUNT(*) DESC"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)

           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               LST-N3::AddItem(WS-ROW::Trim())
           END-PERFORM
]]></Event>
    <Event name="MAKE-IN-LIST" paragraph="MAKE-IN-LIST"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ITEM                                PIC    X(60).
       01 WS-UP                                  PIC    9(5).
       01 WS-LEN                                 PIC    9(5).
       01 WS-IP                                  PIC    9(5).

       PROCEDURE DIVISION.
           SET     WS-IN                         TO    SPACES
           SET     WS-IP                         TO    1

           IF    WS-CHK = SPACES
               EXIT PARAGRAPH
           END-IF

           *> CheckedItems is one string of names joined by LF; UNSTRING WITH POINTER
           *> takes one name per pass until WS-UP passes the end. Names are quoted
           *> but not escaped: no level 2/3 name holds an apostrophe, unlike fund
           *> names (see SQ-ESC).

           SET     WS-LEN                        TO    FUNCTION LENGTH(WS-CHK::Trim())
           SET     WS-UP                         TO    1

           PERFORM    UNTIL WS-UP > WS-LEN
               SET     WS-ITEM                   TO    SPACES
               UNSTRING    WS-CHK DELIMITED BY X"0A" INTO WS-ITEM WITH POINTER WS-UP
               IF    WS-ITEM NOT = SPACES
                   IF    WS-IP > 1
                       STRING    "," INTO WS-IN WITH POINTER WS-IP
                   END-IF
                   STRING    "'" FUNCTION TRIM(WS-ITEM) "'" INTO WS-IN WITH POINTER WS-IP
               END-IF
           END-PERFORM
]]></Event>
    <Event name="NORM-TERM" paragraph="NORM-TERM"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Fold the text like the nome_key column (no accents, upper case) so
           *> 'itaú' finds 'ITAU'. An apostrophe becomes _, the LIKE wildcard for one
           *> character, so it can never end the quoted pattern early.

           INSPECT    WS-TERM CONVERTING "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑ'" TO "aaaaaeeeeiiiiooooouuuucnAAAAAEEEEIIIIOOOOOUUUUCN_"
           SET     WS-TERM                       TO    FUNCTION UPPER-CASE(WS-TERM)
           IF    WS-TERM = SPACES
               SET     WS-PAT                    TO    "%"
           ELSE
               SET     WS-PAT                    TO    SPACES
               STRING    "%" WS-TERM::Trim() "%" INTO WS-PAT
           END-IF
]]></Event>
    <Event name="SQ-ESC" paragraph="SQ-ESC"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-EI                                  PIC    9(5).
       01 WS-EL                                  PIC    9(5).
       01 WS-PART                                PIC    X(200).
       01 WS-DL                                  PIC    X(2).
       01 WS-CNT                                 PIC    9(5).

       PROCEDURE DIVISION.
           SET     WS-ESC                        TO    SPACES
           SET     WS-BPTR                       TO    1
           SET     WS-EL                         TO    FUNCTION LENGTH(WS-ONE::Trim())
           SET     WS-EI                         TO    1

           *> Doubles every apostrophe, the escape inside an SQL string literal. Each
           *> UNSTRING pass gives the text before the next ' (COUNT IN = its length)
           *> and the delimiter found, blank for the last piece. WS-CNT > 0 avoids a
           *> zero-length reference modification.

           PERFORM    UNTIL WS-EI > WS-EL
               SET     WS-PART                   TO    SPACES
               SET     WS-DL                     TO    SPACES
               SET     WS-CNT                    TO    0

               UNSTRING    WS-ONE DELIMITED BY "'" INTO WS-PART DELIMITER IN WS-DL COUNT IN WS-CNT WITH POINTER WS-EI
               IF    WS-CNT > 0
                   STRING    WS-PART(1:WS-CNT) INTO WS-ESC WITH POINTER WS-BPTR
               END-IF
               IF    WS-DL = "'"
                   STRING    "''" INTO WS-ESC WITH POINTER WS-BPTR
               END-IF
           END-PERFORM
]]></Event>
    <Event name="SM-TYPED" paragraph="SM-TYPED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Skip when the term is the same as the last one handled for this box.
           *> CLEAR-FILTERS and the x buttons reset WS-LAST-N / WS-LAST-C, so the
           *> same term can be searched again after a clear.

           IF    WS-SMX = "N"
               SET     WS-TERM                   TO    TXT-NOME::Text
               IF    WS-TERM = WS-LAST-N
                   EXIT PARAGRAPH
               END-IF
               SET     WS-LAST-N                 TO    WS-TERM
           ELSE
               SET     WS-TERM                   TO    TXT-CAT::Text
               IF    WS-TERM = WS-LAST-C
                   EXIT PARAGRAPH
               END-IF
               SET     WS-LAST-C                 TO    WS-TERM
           END-IF
           IF    WS-SM NOT = WS-SMX
               CALL    "SM-OPEN"
           ELSE
               CALL    "SM-REFRESH"
           END-IF
]]></Event>
    <Event name="SM-OPEN" paragraph="SM-OPEN"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CALL    "CLOSE-LEVELS"
           SET     WS-SM                         TO    WS-SMX
           IF    WS-SM = "N"
               SET     LBL-SM-T::Caption         TO    "Nome comercial  ·  marque os fundos que quer ver"
           ELSE
               SET     LBL-SM-T::Caption         TO    "Categoria  ·  marque as categorias que quer ver"
           END-IF

           CALL    "SET-FILT-HEIGHT"
           CALL    "SM-REFRESH"

           SET     POPUP-SEARCH::Visible         TO    TRUE
]]></Event>
    <Event name="SM-CLOSE" paragraph="SM-CLOSE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM NOT = SPACE
               SET     WS-SM                     TO    SPACE
               SET     POPUP-SEARCH::Visible     TO    FALSE
           END-IF
]]></Event>
    <Event name="SM-REFRESH" paragraph="SM-REFRESH"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-SK2                                 PIC    9(3).
       01 WS-TL                                  PIC    9(3).
       01 WS-CMP                                 PIC    X(60).
       01 WS-HIT                                 PIC    9(5).

       PROCEDURE DIVISION.
           IF    WS-SM = "N"
               SET     WS-TERM                   TO    TXT-NOME::Text
           ELSE
               SET     WS-TERM                   TO    TXT-CAT::Text
           END-IF
           CALL    "NORM-TERM"
           SET     WS-SQL                        TO    SPACES
           STRING    "DELETE FROM vis WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
           SET     WS-N                          TO    DB-1::Execute(WS-SQL)
           IF    WS-SM = "N"
               *> The list shows at most 150 unique names (LIMIT), while WS-SMN counts
               *> every match for the footer, so the total can exceed what is listed.

               SET     WS-SQL                    TO    SPACES
               STRING    "INSERT INTO vis SELECT 'N', nome FROM fundos WHERE nome IS NOT NULL AND nome <> '' AND nome_key LIKE '"
               WS-PAT::Trim() "' GROUP BY nome ORDER BY nome LIMIT 150"
                   INTO WS-SQL
               SET     WS-N                      TO    DB-1::Execute(WS-SQL)
               SET     WS-SQL                    TO    SPACES

               STRING    "SELECT COUNT(DISTINCT nome) FROM fundos WHERE nome IS NOT NULL AND nome <> '' AND nome_key LIKE '"
               WS-PAT::Trim() "'" INTO WS-SQL

               SET     WS-N                      TO    DB-1::Query(WS-SQL)
               SET     WS-ROW                    TO    DB-1::Fetch()

               COMPUTE    WS-SMN = FUNCTION NUMVAL(WS-ROW)
           ELSE
               SET     WS-SMN                    TO    0
               SET     WS-TL                     TO    FUNCTION LENGTH(WS-TERM::Trim())

               *> Only 10 categories, so match them here: fold each name like the term
               *> (accents, case) and let SQLite instr() test that it contains the term.
               *> WS-HIT starts at 1, so an empty term keeps every category.

               PERFORM    VARYING WS-SK2 FROM 1 BY 1 UNTIL WS-SK2 > WS-CATCNT
                   SET     WS-ONE                TO    SPACES
                   SET     WS-ONE                TO    WS-CAT-NAME(WS-SK2)::Trim()
                   SET     WS-CMP                TO    WS-ONE

                   INSPECT    WS-CMP CONVERTING "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑ'" TO "aaaaaeeeeiiiiooooouuuucnAAAAAEEEEIIIIOOOOOUUUUCN_"

                   SET     WS-CMP                TO    FUNCTION UPPER-CASE(WS-CMP)
                   SET     WS-HIT                TO    1

                   IF    WS-TERM NOT = SPACES
                       SET     WS-SQL            TO    SPACES
                       STRING    "SELECT instr('" FUNCTION TRIM(WS-CMP) "','" WS-TERM::Trim() "')"
                           INTO WS-SQL
                       SET     WS-N              TO    DB-1::Query(WS-SQL)
                       SET     WS-ROW            TO    DB-1::Fetch()

                       COMPUTE    WS-HIT = FUNCTION NUMVAL(WS-ROW)
                   END-IF
                   IF    WS-HIT > 0
                       ADD    1 TO WS-SMN
                       CALL    "SQ-ESC"
                       SET     WS-SQL            TO    SPACES
                       STRING    "INSERT INTO vis VALUES ('C','" WS-ESC::Trim() "')" INTO WS-SQL
                       SET     WS-N              TO    DB-1::Execute(WS-SQL)
                   END-IF
               END-PERFORM
           END-IF

           LST-SM::Clear()
           LST-SM::AddItem("Todos")

           SET     WS-SQL                        TO    SPACES
           STRING    "SELECT name FROM vis WHERE fld = '" WS-SM "' ORDER BY rowid" DELIMITED BY SIZE INTO WS-SQL

           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-SMK                        TO    0

           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               ADD    1 TO WS-SMK
               LST-SM::AddItem(WS-ROW::Trim())
           END-PERFORM

           CALL    "SM-TICKS"
           CALL    "SM-INFO"
]]></Event>
    <Event name="SM-TICKS" paragraph="SM-TICKS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-BIG                        TO    SPACES
           SET     WS-BPTR                       TO    1
           SET     WS-SQL                        TO    SPACES

           *> In Todos mode the list ticks 'Todos' and every name; otherwise only the
           *> listed names already in pick. Names are joined with LF, the separator
           *> CheckedItems uses.

           IF    (WS-SM = "N" AND WS-ALL-N = 1) OR (WS-SM = "C" AND WS-ALL-C = 1)
               STRING    "Todos" INTO WS-BIG WITH POINTER WS-BPTR
               STRING    "SELECT name FROM vis WHERE fld = '" WS-SM "' ORDER BY rowid" DELIMITED BY SIZE INTO WS-SQL
           ELSE
               STRING    "SELECT name FROM vis WHERE fld = '" WS-SM "' AND name IN (SELECT name FROM pick WHERE fld = '"
                   WS-SM "') ORDER BY rowid" DELIMITED BY SIZE INTO WS-SQL
           END-IF
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               IF    WS-BPTR > 1
                   STRING    X"0A" INTO WS-BIG WITH POINTER WS-BPTR
               END-IF
               STRING    WS-ROW::Trim() INTO WS-BIG WITH POINTER WS-BPTR
           END-PERFORM
           IF    WS-BPTR = 1
               SET     LST-SM::CheckedItems      TO    SPACES
           ELSE
               SET     LST-SM::CheckedItems      TO    WS-BIG::Trim()
           END-IF
]]></Event>
    <Event name="SM-INFO" paragraph="SM-INFO"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-SMP                                 PIC    9(9).
       01 WS-E1                                  PIC    Z(8)9.
       01 WS-E2                                  PIC    Z(8)9.
       01 WS-E3                                  PIC    Z(8)9.
       01 WS-MSG                                 PIC    X(160).

       PROCEDURE DIVISION.
           SET     WS-SQL                        TO    SPACES
           STRING    "SELECT COUNT(*) FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL

           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()

           COMPUTE    WS-SMP = FUNCTION NUMVAL(WS-ROW)
           SET     WS-FC                         TO    WS-SMN
           CALL    "FMT-COUNT"
           SET     WS-MSG                        TO    SPACES
           *> Same rule as NAME-CLAUSE / CAT-CLAUSE: Todos = every search hit, any
           *> ticks = only those, no ticks = the typed text.

           IF    (WS-SM = "N" AND WS-ALL-N = 1) OR (WS-SM = "C" AND WS-ALL-C = 1)
               STRING    "Todos: os " WS-FT::Trim() " resultado(s) da busca entram no filtro."
                   INTO WS-MSG
           ELSE
               SET     WS-E2                     TO    WS-SMK
               SET     WS-E3                     TO    WS-SMP

               IF    WS-SMP > 0
                   STRING    WS-FT::Trim() " encontrado(s)  ·  exibindo " FUNCTION TRIM(WS-E2)
                       "  ·  " FUNCTION TRIM(WS-E3) " marcado(s): só eles entram no filtro"
                       INTO WS-MSG
               ELSE
                   STRING    WS-FT::Trim() " encontrado(s)  ·  exibindo " FUNCTION TRIM(WS-E2)
                       "  ·  nenhum marcado: vale o texto digitado"
                       INTO WS-MSG
               END-IF
           END-IF
           SET     LBL-SM-INFO::Caption          TO    WS-MSG
]]></Event>
    <Event name="SM-CAPTIONS" paragraph="SM-CAPTIONS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-KN                                  PIC    9(9).
       01 WS-KC                                  PIC    9(9).
       01 WS-EN                                  PIC    Z(8)9.
       01 WS-CAPT                                PIC    X(60).

       PROCEDURE DIVISION.
           SET     WS-SQL                        TO    "SELECT COUNT(*) FROM pick WHERE fld = 'N'"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()

           COMPUTE    WS-KN = FUNCTION NUMVAL(WS-ROW)

           SET     WS-SQL                        TO    "SELECT COUNT(*) FROM pick WHERE fld = 'C'"
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()

           COMPUTE    WS-KC = FUNCTION NUMVAL(WS-ROW)
           SET     WS-CAPT                       TO    SPACES
           IF    WS-ALL-N = 1
               SET     WS-CAPT                   TO    "Nome comercial  ·  Todos"
           ELSE
               IF    WS-KN > 0
                   SET     WS-EN                 TO    WS-KN
                   STRING    "Nome comercial  ·  " FUNCTION TRIM(WS-EN) " marcado(s)" INTO WS-CAPT
               ELSE
                   SET     WS-CAPT               TO    "Nome comercial"
               END-IF
           END-IF

           SET     LBL-F-NOME::Caption           TO    WS-CAPT
           SET     WS-CAPT                       TO    SPACES

           IF    WS-ALL-C = 1
               SET     WS-CAPT                   TO    "Categoria  ·  Todos"
           ELSE
               IF    WS-KC > 0
                   SET     WS-EN                 TO    WS-KC
                   STRING    "Categoria  ·  " FUNCTION TRIM(WS-EN) " marcado(s)" INTO WS-CAPT
               ELSE
                   SET     WS-CAPT               TO    "Categoria"
               END-IF
           END-IF
           SET     LBL-F-CAT::Caption            TO    WS-CAPT
]]></Event>
    <Event name="SM-CHECKED" paragraph="SM-CHECKED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-UP2                                 PIC    9(5).
       01 WS-LN                                  PIC    9(5).
       01 WS-TODOS                               PIC    9.
       01 WS-ALLC                                PIC    9.

       PROCEDURE DIVISION.
           SET     WS-BIG                        TO    LST-SM::CheckedItems
           SET     WS-N                          TO    DB-1::Execute("DELETE FROM chk")
           SET     WS-TODOS                      TO    0

           IF    WS-BIG NOT = SPACES
               SET     WS-LN                     TO    FUNCTION LENGTH(WS-BIG::Trim())
               SET     WS-UP2                    TO    1

               PERFORM    UNTIL WS-UP2 > WS-LN
                   SET     WS-ONE                TO    SPACES
                   UNSTRING    WS-BIG DELIMITED BY X"0A" INTO WS-ONE WITH POINTER WS-UP2
                   IF    WS-ONE = "Todos"
                       SET     WS-TODOS          TO    1
                   ELSE
                       IF    WS-ONE NOT = SPACES
                           CALL    "SQ-ESC"
                           SET     WS-SQL        TO    SPACES
                           STRING    "INSERT INTO chk VALUES ('" WS-ESC::Trim() "')" INTO WS-SQL
                           SET     WS-N          TO    DB-1::Execute(WS-SQL)
                       END-IF
                   END-IF
               END-PERFORM
           END-IF
           IF    WS-SM = "N"
               SET     WS-ALLC                   TO    WS-ALL-N
           ELSE
               SET     WS-ALLC                   TO    WS-ALL-C
           END-IF
           *> Old mode (WS-ALLC) against the ticks now: Todos just ticked = all hits,
           *> picks dropped; Todos just unticked = nothing picked; else an item
           *> changed: leave Todos mode and sync pick only for the names listed in
           *> vis, so picks made under an earlier search survive.

           EVALUATE    TRUE
               WHEN WS-ALLC = 0 AND WS-TODOS = 1
                   CALL    "SM-SET-ALL"
                   SET     WS-SQL                TO    SPACES
                   STRING    "DELETE FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
                   SET     WS-N                  TO    DB-1::Execute(WS-SQL)
               WHEN WS-ALLC = 1 AND WS-TODOS = 0
                   CALL    "SM-CLR-ALL"
                   SET     WS-SQL                TO    SPACES
                   STRING    "DELETE FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
                   SET     WS-N                  TO    DB-1::Execute(WS-SQL)
               WHEN OTHER
                   CALL    "SM-CLR-ALL"
                   SET     WS-SQL                TO    SPACES
                   STRING    "DELETE FROM pick WHERE fld = '" WS-SM "' AND name IN (SELECT name FROM vis WHERE fld = '"
                       WS-SM "') AND name NOT IN (SELECT name FROM chk)" DELIMITED BY SIZE INTO WS-SQL
                   SET     WS-N                  TO    DB-1::Execute(WS-SQL)
                   SET     WS-SQL                TO    SPACES

                   STRING    "INSERT OR IGNORE INTO pick SELECT '" WS-SM "', name FROM chk WHERE name IN (SELECT name FROM vis WHERE fld = '"
                       WS-SM "')" DELIMITED BY SIZE INTO WS-SQL
                   SET     WS-N                  TO    DB-1::Execute(WS-SQL)
           END-EVALUATE

           CALL    "SM-TICKS"
           CALL    "SM-INFO"
           CALL    "SM-CAPTIONS"
]]></Event>
    <Event name="SM-SET-ALL" paragraph="SM-SET-ALL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM = "N"
               SET     WS-ALL-N                  TO    1
           ELSE
               SET     WS-ALL-C                  TO    1
           END-IF
]]></Event>
    <Event name="SM-CLR-ALL" paragraph="SM-CLR-ALL"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM = "N"
               SET     WS-ALL-N                  TO    0
           ELSE
               SET     WS-ALL-C                  TO    0
           END-IF
]]></Event>
    <Event name="SM-CLEAR-PICKS" paragraph="SM-CLEAR-PICKS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CALL    "SM-CLR-ALL"
           SET     WS-SQL                        TO    SPACES
           STRING    "DELETE FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
           SET     WS-N                          TO    DB-1::Execute(WS-SQL)

           CALL    "SM-TICKS"
           CALL    "SM-INFO"
           CALL    "SM-CAPTIONS"
]]></Event>
    <Event name="SM-RESET" paragraph="SM-RESET"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-N                          TO    DB-1::Execute("DELETE FROM pick")
           SET     WS-N                          TO    DB-1::Execute("DELETE FROM vis")
           SET     WS-ALL-N                      TO    0
           SET     WS-ALL-C                      TO    0

           CALL    "SM-CAPTIONS"
]]></Event>
    <Event name="NAME-CLAUSE" paragraph="NAME-CLAUSE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-K1                                  PIC    9(9).

       PROCEDURE DIVISION.
           SET     WS-TERM                       TO    TXT-NOME::Text
           CALL    "NORM-TERM"
           SET     WS-K1                         TO    0
           *> Picked names, if any, replace the typed text as the filter. Todos mode
           *> keeps no picks (WS-K1 stays 0), so it falls back to the text, which
           *> means every search hit.

           IF    WS-ALL-N = 0
               SET     WS-SQL                    TO    "SELECT COUNT(*) FROM pick WHERE fld = 'N'"
               SET     WS-N                      TO    DB-1::Query(WS-SQL)
               SET     WS-ROW                    TO    DB-1::Fetch()

               COMPUTE    WS-K1 = FUNCTION NUMVAL(WS-ROW)
           END-IF
           IF    WS-K1 > 0
               STRING    " AND nome IN (SELECT name FROM pick WHERE fld = 'N')" INTO WS-WHERE WITH POINTER WS-P
           ELSE
               IF    WS-TERM NOT = SPACES
                   STRING    " AND nome_key LIKE '" WS-PAT::Trim() "'" INTO WS-WHERE WITH POINTER WS-P
               END-IF
           END-IF
]]></Event>
    <Event name="CAT-CLAUSE" paragraph="CAT-CLAUSE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-K2                                  PIC    9(9).

       PROCEDURE DIVISION.
           SET     WS-TERM                       TO    TXT-CAT::Text
           CALL    "NORM-TERM"
           SET     WS-K2                         TO    0
           *> Picked categories, if any, win. Otherwise the typed text filters through
           *> vis, the categories SM-REFRESH matched for it in COBOL (nivel1 has no
           *> folded key column like nome_key).

           IF    WS-ALL-C = 0
               SET     WS-SQL                    TO    "SELECT COUNT(*) FROM pick WHERE fld = 'C'"
               SET     WS-N                      TO    DB-1::Query(WS-SQL)
               SET     WS-ROW                    TO    DB-1::Fetch()

               COMPUTE    WS-K2 = FUNCTION NUMVAL(WS-ROW)
           END-IF
           IF    WS-K2 > 0
               STRING    " AND nivel1 IN (SELECT name FROM pick WHERE fld = 'C')" INTO WS-WHERE WITH POINTER WS-P
           ELSE
               IF    WS-TERM NOT = SPACES
                   STRING    " AND nivel1 IN (SELECT name FROM vis WHERE fld = 'C')" INTO WS-WHERE WITH POINTER WS-P
               END-IF
           END-IF
]]></Event>
    <Event name="BUILD-WHERE" paragraph="BUILD-WHERE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-DT1                                 PIC    X(10).
       01 WS-DT2                                 PIC    X(10).
       01 WS-V1                                  PIC    9(9).
       01 WS-V2                                  PIC    9(9).
       01 WS-X1                                  PIC    Z(14)9.
       01 WS-X2                                  PIC    Z(14)9.

       PROCEDURE DIVISION.
           SET     WS-WHERE                      TO    SPACES
           SET     WS-P                          TO    1

           STRING    "WHERE 1=1" INTO WS-WHERE WITH POINTER WS-P

           CALL    "NAME-CLAUSE"
           CALL    "CAT-CLAUSE"

           SET     WS-DT1                        TO    DTP-INI::Value
           SET     WS-DT2                        TO    DTP-FIM::Value

           *> A range left at its default (1970-01-01 to 2027-12-31) adds no test: a
           *> date predicate would drop the funds that have no start date.

           IF    WS-DT1 NOT = SPACES AND WS-DT2 NOT = SPACES
               IF    WS-DT1 NOT = "1970-01-01" OR WS-DT2 NOT = "2027-12-31"
                   STRING    " AND inicio >= '" WS-DT1 "' AND inicio <= '" WS-DT2 "'"
                       DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
               END-IF
           END-IF

           SET     WS-V1                         TO    NUD-PL1::Value
           SET     WS-V2                         TO    NUD-PL2::Value

           *> The PL range is in R$ million (hence * 1000000) and applies only once
           *> moved from its full 0 to 300000 span, so funds with no PL stay in.

           IF    WS-V1 > 0 OR WS-V2 < 300000
               COMPUTE    WS-X1 = WS-V1 * 1000000
               COMPUTE    WS-X2 = WS-V2 * 1000000

               STRING    " AND pl >= " FUNCTION TRIM(WS-X1) " AND pl <= " FUNCTION TRIM(WS-X2)
                   INTO WS-WHERE WITH POINTER WS-P
           END-IF
           SET     WS-CHK                        TO    LST-N2::CheckedItems
           CALL    "MAKE-IN-LIST"
           IF    WS-IN NOT = SPACES
               STRING    " AND nivel2 IN (" WS-IN::Trim() ")" INTO WS-WHERE WITH POINTER WS-P
           END-IF
           SET     WS-CHK                        TO    LST-N3::CheckedItems
           CALL    "MAKE-IN-LIST"
           IF    WS-IN NOT = SPACES
               STRING    " AND nivel3 IN (" WS-IN::Trim() ")" INTO WS-WHERE WITH POINTER WS-P
           END-IF
]]></Event>
    <Event name="Q-TOTALS" paragraph="Q-TOTALS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(40).
       01 WS-C2                                  PIC    X(40).
       01 WS-C3                                  PIC    X(40).
       01 WS-C4                                  PIC    X(40).
       01 WS-C5                                  PIC    X(40).
       01 WS-C6                                  PIC    X(40).

       PROCEDURE DIVISION.
           SET     WS-SQL                        TO    SPACES
           *> One row of totals. COUNT(pl) counts only the funds that report a PL and
           *> is the divisor for the average PL; MAX(ano) anchors the Q-YEARS window.

           STRING    "SELECT COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0), COUNT(pl), "
               "COALESCE(MAX(pl),0), COALESCE(MAX(ano),0) FROM fundos " WS-WHERE::Trim()
               INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()

           UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5 WS-C6

           COMPUTE    WS-T-CNT = FUNCTION NUMVAL(WS-C1)
           COMPUTE    WS-T-PL = FUNCTION NUMVAL(WS-C2)
           COMPUTE    WS-T-COT = FUNCTION NUMVAL(WS-C3)
           COMPUTE    WS-T-PLN = FUNCTION NUMVAL(WS-C4)
           COMPUTE    WS-T-MAX = FUNCTION NUMVAL(WS-C5)
           COMPUTE    WS-T-YMAX = FUNCTION NUMVAL(WS-C6)

           SET     WS-T-CLS                      TO    0
           SET     WS-T-SUB                      TO    0
           SET     WS-SQL                        TO    SPACES

           STRING    "SELECT estrutura, COALESCE(SUM(pl),0) FROM fundos " WS-WHERE::Trim()
               " GROUP BY estrutura"
               INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
               IF    WS-C1 = "Classe"
                   COMPUTE    WS-T-CLS = FUNCTION NUMVAL(WS-C2)
               ELSE
                   COMPUTE    WS-T-SUB = FUNCTION NUMVAL(WS-C2)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-CATS" paragraph="Q-CATS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(40).
       01 WS-C2                                  PIC    X(40).
       01 WS-C3                                  PIC    X(40).
       01 WS-C4                                  PIC    X(40).
       01 WS-I                                   PIC    99.

       PROCEDURE DIVISION.
           *> Zero every slot first: a category with no fund in the filter never
           *> comes back from the query and must show 0, not the last filter's data.

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-CNT(WS-I)          TO    0
               SET     WS-CAT-PL(WS-I)           TO    0
               SET     WS-CAT-COT(WS-I)          TO    0
               SET     WS-CAT-USED(WS-I)         TO    0
           END-PERFORM
           SET     WS-SQL                        TO    SPACES
           STRING    "SELECT nivel1, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
           WS-WHERE::Trim() " AND nivel1 IS NOT NULL GROUP BY nivel1"
               INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF    WS-CAT-NAME(WS-I) = WS-C1
                       COMPUTE    WS-CAT-CNT(WS-I) = FUNCTION NUMVAL(WS-C2)
                       COMPUTE    WS-CAT-PL(WS-I) = FUNCTION NUMVAL(WS-C3)
                       COMPUTE    WS-CAT-COT(WS-I) = FUNCTION NUMVAL(WS-C4)
                   END-IF
               END-PERFORM
           END-PERFORM
]]></Event>
    <Event name="Q-N2" paragraph="Q-N2"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(40).
       01 WS-C2                                  PIC    X(40).
       01 WS-I                                   PIC    99.
       01 WS-V                                   PIC    9(9).

       PROCEDURE DIVISION.
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-N2-NAME(WS-I)          TO    SPACES
               SET     WS-N2-CNT(WS-I)           TO    0
           END-PERFORM

           SET     WS-N2-TOTAL                   TO    0
           SET     WS-I                          TO    0
           SET     WS-SQL                        TO    SPACES

           STRING    "SELECT nivel2, COUNT(*) FROM fundos " WS-WHERE::Trim()
               " AND nivel2 IS NOT NULL GROUP BY nivel2 ORDER BY 2 DESC"
               INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
               COMPUTE    WS-V = FUNCTION NUMVAL(WS-C2)
               ADD    WS-V TO WS-N2-TOTAL
               *> Largest first: the 9 biggest keep their own slot, the rest are summed
               *> into slot 10, 'Outros'. WS-N2-TOTAL adds every row, so the donut shares
               *> add up to the whole.

               IF    WS-I < 9
                   ADD    1 TO WS-I

                   SET     WS-N2-NAME(WS-I)      TO    WS-C1
                   SET     WS-N2-CNT(WS-I)       TO    WS-V
               ELSE
                   SET     WS-N2-NAME(10)        TO    "Outros"
                   ADD    WS-V TO WS-N2-CNT(10)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-BINS" paragraph="Q-BINS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(40).
       01 WS-C2                                  PIC    X(40).
       01 WS-I                                   PIC    99.

       PROCEDURE DIVISION.
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
               SET     WS-BIN-CNT(WS-I)          TO    0
           END-PERFORM
           SET     WS-SQL                        TO    SPACES
           *> Five PL bands, each ten times the last, as the captions of LBL-BIN1-N to
           *> LBL-BIN5-N say (up to R$ 1 mi ... above R$ 1 bi). The CASE number
           *> indexes WS-BIN-CNT.

           STRING    "SELECT CASE WHEN pl < 1000000 THEN 1 WHEN pl < 10000000 THEN 2 "
               "WHEN pl < 100000000 THEN 3 WHEN pl < 1000000000 THEN 4 ELSE 5 END, COUNT(*) FROM fundos "
           WS-WHERE::Trim() " AND pl IS NOT NULL GROUP BY 1"
               INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
               COMPUTE    WS-I = FUNCTION NUMVAL(WS-C1)
               IF    WS-I >= 1 AND WS-I <= 5
                   COMPUTE    WS-BIN-CNT(WS-I) = FUNCTION NUMVAL(WS-C2)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-TOP" paragraph="Q-TOP"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(200).
       01 WS-C2                                  PIC    X(40).
       01 WS-I                                   PIC    99.

       PROCEDURE DIVISION.
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
               SET     WS-TOP-NAME(WS-I)         TO    SPACES
               SET     WS-TOP-PL(WS-I)           TO    0
           END-PERFORM

           SET     WS-TOP-N                      TO    0
           SET     WS-SQL                        TO    SPACES

           *> A fund with no name falls back to its code. WS-C1 is X(200) because
           *> names reach 200 characters; WS-TOP-NAME keeps the first 40.

           STRING    "SELECT COALESCE(nome,codigo), pl FROM fundos " WS-WHERE::Trim()
               " AND pl IS NOT NULL ORDER BY pl DESC LIMIT 4"
               INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               IF    WS-TOP-N < 4
                   ADD    1 TO WS-TOP-N
                   UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
                   SET     WS-TOP-NAME(WS-TOP-N) TO    WS-C1
                   COMPUTE    WS-TOP-PL(WS-TOP-N) = FUNCTION NUMVAL(WS-C2)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-YEARS" paragraph="Q-YEARS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-C1                                  PIC    X(40).
       01 WS-C2                                  PIC    X(40).
       01 WS-C3                                  PIC    X(40).
       01 WS-C4                                  PIC    X(40).
       01 WS-C5                                  PIC    X(40).
       01 WS-I                                   PIC    99.
       01 WS-J                                   PIC    99.
       01 WS-K                                   PIC    99.
       01 WS-Y                                   PIC    9(4).
       01 WS-BEST                                PIC    9(9).
       01 WS-BI                                  PIC    99.
       01 WS-LIST                                PIC    X(300).
       01 WS-LP                                  PIC    9(4).

       PROCEDURE DIVISION.
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
               SET     WS-TOP3-IDX(WS-I)         TO    0
           END-PERFORM
           *> Top 3 categories by fund count: three passes, each takes the largest
           *> WS-CAT-CNT whose WS-CAT-USED mark is still 0. The marks are cleared
           *> again right after.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               SET     WS-BI                     TO    0
               SET     WS-BEST                   TO    0

               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF    WS-CAT-CNT(WS-I) > WS-BEST AND WS-CAT-USED(WS-I) = 0
                       SET     WS-BEST           TO    WS-CAT-CNT(WS-I)
                       SET     WS-BI             TO    WS-I
                   END-IF
               END-PERFORM
               IF    WS-BI > 0
                   SET     WS-TOP3-IDX(WS-K)     TO    WS-BI
                   SET     WS-CAT-USED(WS-BI)    TO    1
               END-IF
           END-PERFORM
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-USED(WS-I)         TO    0
           END-PERFORM

           SET     WS-LIST                       TO    SPACES
           SET     WS-LP                         TO    1

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               IF    WS-TOP3-IDX(WS-K) > 0
                   IF    WS-LP > 1
                       STRING    "," INTO WS-LIST WITH POINTER WS-LP
                   END-IF
                   STRING    "'" WS-CAT-NAME(WS-TOP3-IDX(WS-K))::Trim() "'"
                       INTO WS-LIST WITH POINTER WS-LP
               END-IF
           END-PERFORM
           *> With no category left, use '' so the IN (...) below still has an item
           *> and matches nothing.

           IF    WS-LIST = SPACES
               SET     WS-LIST                   TO    "''"
           END-IF
           *> The window is the 12 years ending at the newest start year in the
           *> filter (WS-T-YMAX); with no year at all it starts at 2015.

           IF    WS-T-YMAX > 0
               COMPUTE    WS-YR-MIN = WS-T-YMAX - 11
           ELSE
               SET     WS-YR-MIN                 TO    2015
           END-IF
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
               COMPUTE    WS-YR-NUM(WS-I) = WS-YR-MIN + WS-I - 1

               SET     WS-YA-CNT(WS-I)           TO    0
               SET     WS-YA-PL(WS-I)            TO    0
               SET     WS-YA-COT(WS-I)           TO    0

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   SET     WS-YS-CNT(WS-I, WS-K) TO    0
                   SET     WS-YS-PL(WS-I, WS-K)  TO    0
                   SET     WS-YS-COT(WS-I, WS-K) TO    0
               END-PERFORM
           END-PERFORM

           SET     WS-OA-CNT                     TO    0
           SET     WS-OA-PL                      TO    0
           SET     WS-OA-COT                     TO    0

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               SET     WS-OS-CNT(WS-K)           TO    0
               SET     WS-OS-PL(WS-K)            TO    0
               SET     WS-OS-COT(WS-K)           TO    0
           END-PERFORM
           SET     WS-Y                          TO    WS-YR-MIN
           *>  all categories, per year in the window

           SET     WS-SQL                        TO    SPACES
           STRING    "SELECT ano, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
           WS-WHERE::Trim() " AND ano >= " WS-Y " GROUP BY ano"
               DELIMITED BY SIZE INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4

               COMPUTE    WS-Y = FUNCTION NUMVAL(WS-C1)
               COMPUTE    WS-I = WS-Y - WS-YR-MIN + 1

               IF    WS-I >= 1 AND WS-I <= 12
                   COMPUTE    WS-YA-CNT(WS-I) = FUNCTION NUMVAL(WS-C2)
                   COMPUTE    WS-YA-PL(WS-I) = FUNCTION NUMVAL(WS-C3)
                   COMPUTE    WS-YA-COT(WS-I) = FUNCTION NUMVAL(WS-C4)
               END-IF
           END-PERFORM
           *>  all categories, before the window

           SET     WS-Y                          TO    WS-YR-MIN
           SET     WS-SQL                        TO    SPACES

           STRING    "SELECT COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
           WS-WHERE::Trim() " AND ano < " WS-Y
               DELIMITED BY SIZE INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           SET     WS-ROW                        TO    DB-1::Fetch()

           UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3

           COMPUTE    WS-OA-CNT = FUNCTION NUMVAL(WS-C1)
           COMPUTE    WS-OA-PL = FUNCTION NUMVAL(WS-C2)
           COMPUTE    WS-OA-COT = FUNCTION NUMVAL(WS-C3)

           *>  the three leading categories, per year in the window

           SET     WS-SQL                        TO    SPACES
           STRING    "SELECT ano, nivel1, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
           WS-WHERE::Trim() " AND ano >= " WS-Y " AND nivel1 IN (" FUNCTION TRIM(WS-LIST)
               ") GROUP BY ano, nivel1"
               DELIMITED BY SIZE INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5

               COMPUTE    WS-Y = FUNCTION NUMVAL(WS-C1)
               COMPUTE    WS-I = WS-Y - WS-YR-MIN + 1

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   IF    WS-TOP3-IDX(WS-K) > 0
                       IF    WS-CAT-NAME(WS-TOP3-IDX(WS-K)) = WS-C2 AND WS-I >= 1 AND WS-I <= 12
                           COMPUTE    WS-YS-CNT(WS-I, WS-K) = FUNCTION NUMVAL(WS-C3)
                           COMPUTE    WS-YS-PL(WS-I, WS-K) = FUNCTION NUMVAL(WS-C4)
                           COMPUTE    WS-YS-COT(WS-I, WS-K) = FUNCTION NUMVAL(WS-C5)
                       END-IF
                   END-IF
               END-PERFORM
           END-PERFORM
           *>  the three leading categories, before the window

           SET     WS-Y                          TO    WS-YR-MIN
           SET     WS-SQL                        TO    SPACES

           STRING    "SELECT nivel1, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
           WS-WHERE::Trim() " AND ano < " WS-Y " AND nivel1 IN (" FUNCTION TRIM(WS-LIST)
               ") GROUP BY nivel1"
               DELIMITED BY SIZE INTO WS-SQL
           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4
               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   IF    WS-TOP3-IDX(WS-K) > 0
                       IF    WS-CAT-NAME(WS-TOP3-IDX(WS-K)) = WS-C1
                           COMPUTE    WS-OS-CNT(WS-K) = FUNCTION NUMVAL(WS-C2)
                           COMPUTE    WS-OS-PL(WS-K) = FUNCTION NUMVAL(WS-C3)
                           COMPUTE    WS-OS-COT(WS-K) = FUNCTION NUMVAL(WS-C4)
                       END-IF
                   END-IF
               END-PERFORM
           END-PERFORM
]]></Event>
    <Event name="Q-GRID" paragraph="Q-GRID"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-ORD                                 PIC    X(60).
       01 WS-OFFS                                PIC    9(9).
       01 WS-LIM                                 PIC    9(4).
       01 WS-I                                   PIC    9(5).
       01 WS-SEL                                 PIC    X(40).

       PROCEDURE DIVISION.
           SET     WS-SEL                        TO    CMB-ORDER::Value
           *> Each CMB-ORDER item is recognised by its first words. Every key but the
           *> name sorts IS NULL first, which sends funds with no value to the end:
           *> SQLite puts NULLs first when ascending (as in oldest first).

           EVALUATE    TRUE
               WHEN WS-SEL(1:6) = "Maior "
                   SET     WS-ORD                TO    "pl IS NULL, pl DESC"
               WHEN WS-SEL(1:5) = "Mais "
                   IF    WS-SEL(1:9) = "Mais coti"
                       SET     WS-ORD            TO    "cotistas IS NULL, cotistas DESC"
                   ELSE
                       IF    WS-SEL(1:9) = "Mais rece"
                           SET     WS-ORD        TO    "inicio IS NULL, inicio DESC"
                       ELSE
                           SET     WS-ORD        TO    "inicio IS NULL, inicio ASC"
                       END-IF
                   END-IF
               WHEN OTHER
                   SET     WS-ORD                TO    "nome_key ASC"
           END-EVALUATE
           *> The page count rounds up: the COMPUTE truncates into an integer item, so
           *> PSIZE - 1 is added first. An empty result still shows one page, and the
           *> current page is clamped into 1 to WS-PAGES.

           IF    WS-T-CNT = 0
               SET     WS-PAGES                  TO    1
           ELSE
               COMPUTE    WS-PAGES = (WS-T-CNT + WS-PSIZE - 1) / WS-PSIZE
           END-IF
           IF    WS-PAGE > WS-PAGES
               SET     WS-PAGE                   TO    WS-PAGES
           END-IF
           IF    WS-PAGE < 1
               SET     WS-PAGE                   TO    1
           END-IF
           COMPUTE    WS-OFFS = (WS-PAGE - 1) * WS-PSIZE

           SET     WS-LIM                        TO    WS-PSIZE
           SET     WS-SQL                        TO    SPACES

           *> The 16 columns follow the column order of GRD-FUNDOS, PL scaled to R$
           *> million as its header says. LIMIT / OFFSET fetch only the current page.

           STRING    "SELECT COALESCE(nome,''), codigo, COALESCE(estrutura,''), COALESCE(nivel1,''), "
               "COALESCE(nivel2,''), COALESCE(nivel3,''), COALESCE(strftime('%d/%m/%Y', inicio),''), "
               "COALESCE(printf('%.2f', pl/1000000.0),''), COALESCE(cotistas,''), "
               "COALESCE(printf('%.4f', cota),''), COALESCE(foco,''), COALESCE(cnpj_classe,''), "
               "COALESCE(cnpj_fundo,''), COALESCE(status,''), COALESCE(subclasses,''), "
               "COALESCE(strftime('%d/%m/%Y', data_ref),'') FROM fundos "
           WS-WHERE::Trim() " ORDER BY " FUNCTION TRIM(WS-ORD)
               " LIMIT " WS-LIM " OFFSET " WS-OFFS
               DELIMITED BY SIZE INTO WS-SQL
           GRD-FUNDOS::ClearRows()

           SET     WS-N                          TO    DB-1::Query(WS-SQL)
           PERFORM    UNTIL 1 = 2
               SET     WS-ROW                    TO    DB-1::Fetch()
               IF    WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               GRD-FUNDOS::AddRow(WS-ROW::Trim())
           END-PERFORM
]]></Event>
    <Event name="SORT-CATS" paragraph="SORT-CATS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-K                                   PIC    99.
       01 WS-BI                                  PIC    99.
       01 WS-BEST                                PIC    9(15)V99.

       PROCEDURE DIVISION.
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-USED(WS-I)         TO    0
               SET     WS-RANK(WS-I)             TO    0
           END-PERFORM
           *> Selection sort by PL: WS-RANK(k) gets the slot of the k-th largest
           *> category, 0 when none is left. The test is strictly above 0, so a
           *> category with no PL is never ranked. The USED marks are cleared after.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 10
               SET     WS-BI                     TO    0
               SET     WS-BEST                   TO    0

               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF    WS-CAT-PL(WS-I) > WS-BEST AND WS-CAT-USED(WS-I) = 0
                       SET     WS-BEST           TO    WS-CAT-PL(WS-I)
                       SET     WS-BI             TO    WS-I
                   END-IF
               END-PERFORM
               IF    WS-BI > 0
                   SET     WS-RANK(WS-K)         TO    WS-BI
                   SET     WS-CAT-USED(WS-BI)    TO    1
               END-IF
           END-PERFORM
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               SET     WS-CAT-USED(WS-I)         TO    0
           END-PERFORM
]]></Event>
    <Event name="PAINT-KPIS" paragraph="PAINT-KPIS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-PCT                                 PIC    9(3)V9.
       01 WS-AVG                                 PIC    9(15)V99.
       01 WS-PCTI                                PIC    9(3).
       01 WS-A                                   PIC    X(24).

       PROCEDURE DIVISION.
           SET     WS-FV                         TO    WS-T-PL
           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT

           SET     LBL-KPI-V::Caption            TO    WS-TXT
           SET     WS-FC                         TO    WS-T-CNT

           CALL    "FMT-COUNT"

           *> WS-FT is reused by every FMT-* call, so the fund count text waits in
           *> WS-A while the cotistas are formatted.

           SET     WS-A                          TO    WS-FT
           SET     WS-FV                         TO    WS-T-COT

           CALL    "FMT-SHORTN"
           SET     WS-TXT                        TO    SPACES
           STRING    FUNCTION TRIM(WS-A) " fundo(s)  |  " WS-FT::Trim() " cotistas" INTO WS-TXT
           SET     LBL-KPI-C::Caption            TO    WS-TXT
           IF    WS-UNIV > 0
               COMPUTE    WS-PCT = WS-T-CNT * 100 / WS-UNIV
           ELSE
               SET     WS-PCT                    TO    0
           END-IF
           COMPUTE    WS-PCTI = WS-PCT
           GAU-UNIV::SetValue(WS-PCTI)
           *> Average over the funds that report a PL (WS-T-PLN, from COUNT(pl)),
           *> not over all of them.

           IF    WS-T-PLN > 0
               COMPUTE    WS-AVG = WS-T-PL / WS-T-PLN
           ELSE
               SET     WS-AVG                    TO    0
           END-IF
           SET     WS-FV                         TO    WS-AVG
           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT

           SET     LBL-AVG-V::Caption            TO    WS-TXT
           SET     WS-FV                         TO    WS-T-MAX

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "PL médio por fundo  |  maior: R$ " WS-FT::Trim() INTO WS-TXT
           SET     LBL-KPI-F::Caption            TO    WS-TXT
]]></Event>
    <Event name="PAINT-RADAR" paragraph="PAINT-RADAR"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-J                                   PIC    99.
       01 WS-K                                   PIC    9.
       01 WS-NM                                  PIC    9.
       01 WS-NSEL                                PIC    9(9).
       01 WS-MX                                  PIC    9(15)V99.
       01 WS-MC                                  PIC    9(15)V99.
       01 WS-MP                                  PIC    9(15)V99.
       01 WS-MK                                  PIC    9(15)V99.
       01 WS-V1                                  PIC    9(3)V99.
       01 WS-V2                                  PIC    9(3)V99.
       01 WS-V3                                  PIC    9(3)V99.
       01 WS-RV-TAB.
           05 WS-RVK                             OCCURS    3.
               10 WS-RV                          PIC    9(9)    OCCURS 10.
       01 WS-RN-TAB.
           05 WS-RN                              PIC    X(160)    OCCURS 3.
       01 WS-C1                                  PIC    X(160).
       01 WS-C2                                  PIC    X(60).
       01 WS-C3                                  PIC    X(30).
       01 WS-W1                                  PIC    X(60).
       01 WS-W2                                  PIC    X(60).
       01 WS-LB                                  PIC    X(200).
       01 WS-LP                                  PIC    9(4).

       PROCEDURE DIVISION.
           SET     WS-NSEL                       TO    0
           IF    WS-ALL-N = 0
               SET     WS-SQL                    TO    "SELECT COUNT(*) FROM pick WHERE fld = 'N'"
               SET     WS-N                      TO    DB-1::Query(WS-SQL)
               SET     WS-ROW                    TO    DB-1::Fetch()

               COMPUTE    WS-NSEL = FUNCTION NUMVAL(WS-ROW)
           END-IF
           CH-RADAR::Clear()
           IF    WS-NSEL = 2 OR WS-NSEL = 3
               *>      --- one polygon per company

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   SET     WS-RN(WS-K)           TO    SPACES
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
                       SET     WS-RV(WS-K, WS-I) TO    0
                   END-PERFORM
               END-PERFORM

               SET     WS-NM                     TO    0
               SET     WS-SQL                    TO    "SELECT name FROM pick WHERE fld = 'N' ORDER BY name"
               SET     WS-N                      TO    DB-1::Query(WS-SQL)

               PERFORM    UNTIL 1 = 2
                   SET     WS-ROW                TO    DB-1::Fetch()
                   IF    WS-ROW = SPACES
                       EXIT PERFORM
                   END-IF
                   IF    WS-NM < 3
                       ADD    1 TO WS-NM
                       SET     WS-RN(WS-NM)      TO    WS-ROW
                   END-IF
               END-PERFORM
               SET     WS-SQL                    TO    SPACES
               STRING    "SELECT nome, nivel1, COUNT(*) FROM fundos " WS-WHERE::Trim()
                   " AND nivel1 IS NOT NULL GROUP BY nome, nivel1"
                   INTO WS-SQL
               SET     WS-N                      TO    DB-1::Query(WS-SQL)
               PERFORM    UNTIL 1 = 2
                   SET     WS-ROW                TO    DB-1::Fetch()
                   IF    WS-ROW = SPACES
                       EXIT PERFORM
                   END-IF
                   UNSTRING    WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3
                   PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                       IF    WS-RN(WS-K) = WS-C1
                           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                               IF    WS-CAT-NAME(WS-I) = WS-C2
                                   COMPUTE    WS-RV(WS-K, WS-I) = FUNCTION NUMVAL(WS-C3)
                               END-IF
                           END-PERFORM
                       END-IF
                   END-PERFORM
               END-PERFORM
               *> Common scale for the polygons: the largest count of any company in any
               *> category is 100, so the shapes stay comparable.

               SET     WS-MX                     TO    0
               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF    WS-RV(WS-K, WS-I) > WS-MX
                           SET     WS-MX         TO    WS-RV(WS-K, WS-I)
                       END-IF
                   END-PERFORM
               END-PERFORM
               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   SET     WS-V1                 TO    0
                   SET     WS-V2                 TO    0
                   SET     WS-V3                 TO    0

                   IF    WS-MX > 0
                       COMPUTE    WS-V1 = WS-RV(1, WS-I) * 100 / WS-MX
                       COMPUTE    WS-V2 = WS-RV(2, WS-I) * 100 / WS-MX

                       IF    WS-NM = 3
                           COMPUTE    WS-V3 = WS-RV(3, WS-I) * 100 / WS-MX
                       END-IF
                   END-IF
                   IF    WS-NM = 3
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1, WS-V2, WS-V3)
                   ELSE
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1, WS-V2)
                   END-IF
               END-PERFORM
               *>      the legend: the first two words of each name

               SET     WS-LB                     TO    SPACES
               SET     WS-LP                     TO    1

               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                   SET     WS-W1                 TO    SPACES
                   SET     WS-W2                 TO    SPACES

                   UNSTRING    WS-RN(WS-K) DELIMITED BY SPACE INTO WS-W1 WS-W2

                   *> SeriesLabels is comma-separated, so a comma inside a company name would
                   *> split its label: turn commas into spaces.

                   INSPECT    WS-W1 REPLACING ALL "," BY " "
                   INSPECT    WS-W2 REPLACING ALL "," BY " "

                   IF    WS-K > 1
                       STRING    "," INTO WS-LB WITH POINTER WS-LP
                   END-IF
                   STRING    FUNCTION TRIM(WS-W1) " " FUNCTION TRIM(WS-W2) INTO WS-LB WITH POINTER WS-LP
               END-PERFORM
               SET     CH-RADAR::SeriesLabels    TO    WS-LB
               IF    WS-NM = 3
                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6,#C2257A,#394670"
               ELSE
                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6,#C2257A"
               END-IF

               SET     CH-RADAR::ShowLegend      TO    1
               SET     LBL-RAD-S::Caption        TO    "nº de fundos por categoria (100 = maior)"
           ELSE
               IF    WS-NSEL = 1
                   *>          --- ONE company: its three series, each indexed to its own largest category

                   SET     WS-MC                 TO    0
                   SET     WS-MP                 TO    0
                   SET     WS-MK                 TO    0

                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF    WS-CAT-CNT(WS-I) > WS-MC
                           SET     WS-MC         TO    WS-CAT-CNT(WS-I)
                       END-IF
                       IF    WS-CAT-PL(WS-I) > WS-MP
                           SET     WS-MP         TO    WS-CAT-PL(WS-I)
                       END-IF
                       IF    WS-CAT-COT(WS-I) > WS-MK
                           SET     WS-MK         TO    WS-CAT-COT(WS-I)
                       END-IF
                   END-PERFORM
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       SET     WS-V1             TO    0
                       SET     WS-V2             TO    0
                       SET     WS-V3             TO    0

                       IF    WS-MC > 0
                           COMPUTE    WS-V1 = WS-CAT-CNT(WS-I) * 100 / WS-MC
                       END-IF
                       IF    WS-MP > 0
                           COMPUTE    WS-V2 = WS-CAT-PL(WS-I) * 100 / WS-MP
                       END-IF
                       IF    WS-MK > 0
                           COMPUTE    WS-V3 = WS-CAT-COT(WS-I) * 100 / WS-MK
                       END-IF
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1, WS-V2, WS-V3)
                   END-PERFORM
                   SET     CH-RADAR::SeriesLabels
                                                 TO    "Fundos,PL,Cotistas"

                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6,#3E7BE8,#394670"

                   SET     CH-RADAR::ShowLegend  TO    1
                   SET     LBL-RAD-S::Caption    TO    "1 empresa: fundos, PL e cotistas (100 = maior)"
               ELSE
                   *>          --- everyone (or more than three picked): ONE polygon, one colour, the most popular categories

                   SET     WS-MC                 TO    0
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF    WS-CAT-CNT(WS-I) > WS-MC
                           SET     WS-MC         TO    WS-CAT-CNT(WS-I)
                       END-IF
                   END-PERFORM
                   PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       SET     WS-V1             TO    0
                       IF    WS-MC > 0
                           COMPUTE    WS-V1 = WS-CAT-CNT(WS-I) * 100 / WS-MC
                       END-IF
                       CH-RADAR::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-V1)
                   END-PERFORM
                   SET     CH-RADAR::SeriesLabels
                                                 TO    "Fundos"

                   SET     CH-RADAR::SeriesColors
                                                 TO    "#22C3D6"

                   SET     CH-RADAR::ShowLegend  TO    0
                   SET     LBL-RAD-S::Caption    TO    "categorias mais populares · nº de fundos (100 = líder)"
               END-IF
           END-IF
]]></Event>
    <Event name="PAINT-CHARTS" paragraph="PAINT-CHARTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-R                                   PIC    99.
       01 WS-SC                                  PIC    9(15)V99.
       01 WS-SP                                  PIC    9(15)V99.
       01 WS-SK                                  PIC    9(15)V99.
       01 WS-MC                                  PIC    9(15)V99.
       01 WS-MP                                  PIC    9(15)V99.
       01 WS-MK                                  PIC    9(15)V99.
       01 WS-V1                                  PIC    9(3)V99.
       01 WS-V2                                  PIC    9(3)V99.
       01 WS-V3                                  PIC    9(3)V99.
       01 WS-VB                                  PIC    9(9)V99.
       01 WS-TXT                                 PIC    X(120).
       01 WS-LB                                  PIC    X(12).

       PROCEDURE DIVISION.
           SET     WS-SC                         TO    0
           SET     WS-SP                         TO    0
           SET     WS-SK                         TO    0

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
               ADD    WS-CAT-CNT(WS-I) TO WS-SC
               ADD    WS-CAT-PL(WS-I) TO WS-SP
               ADD    WS-CAT-COT(WS-I) TO WS-SK
           END-PERFORM
           CALL    "PAINT-RADAR"
           *>  donut 1: PL (R$ billions) per category

           CH-DONUT1::Clear()
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
               COMPUTE    WS-VB = WS-CAT-PL(WS-I) / 1000000000
               CH-DONUT1::AddPoint(WS-CAT-NAME(WS-I)::Trim(), WS-VB)
           END-PERFORM
           SET     WS-FV                         TO    WS-SP
           CALL    "FMT-SHORT"
           SET     LBL-D1-C::Caption             TO    WS-FT
           *> Legend rows run largest PL first (WS-RANK holds slot numbers). A swatch
           *> takes the WS-COLOR of the slot, the colour of that slice in the donut,
           *> whose points are added in slot order. An unused row is blanked.

           IF    WS-RANK(1) > 0
               SET     WS-R                      TO    WS-RANK(1)
               SET     LBL-L1-1-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L1-1-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-1-V::Caption       TO    WS-TXT
               SET     SHP-L1-1::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-1-N::Caption       TO    SPACES
               SET     LBL-L1-1-P::Caption       TO    SPACES
               SET     LBL-L1-1-V::Caption       TO    SPACES
               SET     SHP-L1-1::FillColor       TO    "#00000000"
           END-IF
           IF    WS-RANK(2) > 0
               SET     WS-R                      TO    WS-RANK(2)
               SET     LBL-L1-2-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L1-2-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-2-V::Caption       TO    WS-TXT
               SET     SHP-L1-2::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-2-N::Caption       TO    SPACES
               SET     LBL-L1-2-P::Caption       TO    SPACES
               SET     LBL-L1-2-V::Caption       TO    SPACES
               SET     SHP-L1-2::FillColor       TO    "#00000000"
           END-IF
           IF    WS-RANK(3) > 0
               SET     WS-R                      TO    WS-RANK(3)
               SET     LBL-L1-3-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L1-3-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-3-V::Caption       TO    WS-TXT
               SET     SHP-L1-3::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-3-N::Caption       TO    SPACES
               SET     LBL-L1-3-P::Caption       TO    SPACES
               SET     LBL-L1-3-V::Caption       TO    SPACES
               SET     SHP-L1-3::FillColor       TO    "#00000000"
           END-IF
           IF    WS-RANK(4) > 0
               SET     WS-R                      TO    WS-RANK(4)
               SET     LBL-L1-4-N::Caption       TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-SP > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L1-4-P::Caption       TO    WS-FT
               SET     WS-FV                     TO    WS-CAT-PL(WS-R)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-L1-4-V::Caption       TO    WS-TXT
               SET     SHP-L1-4::FillColor       TO    WS-COLOR(WS-R)
           ELSE
               SET     LBL-L1-4-N::Caption       TO    SPACES
               SET     LBL-L1-4-P::Caption       TO    SPACES
               SET     LBL-L1-4-V::Caption       TO    SPACES
               SET     SHP-L1-4::FillColor       TO    "#00000000"
           END-IF
           *>  donut 2: funds per level-2 category (top 9 + the rest)

           CH-DONUT2::Clear()
           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               IF    WS-N2-NAME(WS-I) NOT = SPACES
                   CH-DONUT2::AddPoint(WS-N2-NAME(WS-I)::Trim(), WS-N2-CNT(WS-I))
               END-IF
           END-PERFORM
           SET     WS-FC                         TO    WS-N2-TOTAL
           CALL    "FMT-COUNT"
           SET     LBL-D2-C::Caption             TO    WS-FT
           IF    WS-N2-NAME(1) NOT = SPACES
               SET     LBL-L2-1-N::Caption       TO    WS-N2-NAME(1)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(1) * 100 / WS-N2-TOTAL
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L2-1-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(1)

               CALL    "FMT-COUNT"

               SET     LBL-L2-1-V::Caption       TO    WS-FT
               SET     SHP-L2-1::FillColor       TO    WS-COLOR(1)
           ELSE
               SET     LBL-L2-1-N::Caption       TO    SPACES
               SET     LBL-L2-1-P::Caption       TO    SPACES
               SET     LBL-L2-1-V::Caption       TO    SPACES
               SET     SHP-L2-1::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(2) NOT = SPACES
               SET     LBL-L2-2-N::Caption       TO    WS-N2-NAME(2)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(2) * 100 / WS-N2-TOTAL
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L2-2-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(2)

               CALL    "FMT-COUNT"

               SET     LBL-L2-2-V::Caption       TO    WS-FT
               SET     SHP-L2-2::FillColor       TO    WS-COLOR(2)
           ELSE
               SET     LBL-L2-2-N::Caption       TO    SPACES
               SET     LBL-L2-2-P::Caption       TO    SPACES
               SET     LBL-L2-2-V::Caption       TO    SPACES
               SET     SHP-L2-2::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(3) NOT = SPACES
               SET     LBL-L2-3-N::Caption       TO    WS-N2-NAME(3)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(3) * 100 / WS-N2-TOTAL
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L2-3-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(3)

               CALL    "FMT-COUNT"

               SET     LBL-L2-3-V::Caption       TO    WS-FT
               SET     SHP-L2-3::FillColor       TO    WS-COLOR(3)
           ELSE
               SET     LBL-L2-3-N::Caption       TO    SPACES
               SET     LBL-L2-3-P::Caption       TO    SPACES
               SET     LBL-L2-3-V::Caption       TO    SPACES
               SET     SHP-L2-3::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(4) NOT = SPACES
               SET     LBL-L2-4-N::Caption       TO    WS-N2-NAME(4)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(4) * 100 / WS-N2-TOTAL
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L2-4-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(4)

               CALL    "FMT-COUNT"

               SET     LBL-L2-4-V::Caption       TO    WS-FT
               SET     SHP-L2-4::FillColor       TO    WS-COLOR(4)
           ELSE
               SET     LBL-L2-4-N::Caption       TO    SPACES
               SET     LBL-L2-4-P::Caption       TO    SPACES
               SET     LBL-L2-4-V::Caption       TO    SPACES
               SET     SHP-L2-4::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(5) NOT = SPACES
               SET     LBL-L2-5-N::Caption       TO    WS-N2-NAME(5)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(5) * 100 / WS-N2-TOTAL
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L2-5-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(5)

               CALL    "FMT-COUNT"

               SET     LBL-L2-5-V::Caption       TO    WS-FT
               SET     SHP-L2-5::FillColor       TO    WS-COLOR(5)
           ELSE
               SET     LBL-L2-5-N::Caption       TO    SPACES
               SET     LBL-L2-5-P::Caption       TO    SPACES
               SET     LBL-L2-5-V::Caption       TO    SPACES
               SET     SHP-L2-5::FillColor       TO    "#00000000"
           END-IF
           IF    WS-N2-NAME(6) NOT = SPACES
               SET     LBL-L2-6-N::Caption       TO    WS-N2-NAME(6)
               SET     WS-FP                     TO    0

               IF    WS-N2-TOTAL > 0
                   COMPUTE    WS-FP = WS-N2-CNT(6) * 100 / WS-N2-TOTAL
               END-IF
               CALL    "FMT-PCT"

               SET     LBL-L2-6-P::Caption       TO    WS-FT
               SET     WS-FC                     TO    WS-N2-CNT(6)

               CALL    "FMT-COUNT"

               SET     LBL-L2-6-V::Caption       TO    WS-FT
               SET     SHP-L2-6::FillColor       TO    WS-COLOR(6)
           ELSE
               SET     LBL-L2-6-N::Caption       TO    SPACES
               SET     LBL-L2-6-P::Caption       TO    SPACES
               SET     LBL-L2-6-V::Caption       TO    SPACES
               SET     SHP-L2-6::FillColor       TO    "#00000000"
           END-IF
           CALL    "PAINT-BINS"
]]></Event>
    <Event name="PAINT-YEARS" paragraph="PAINT-YEARS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-K                                   PIC    99.
       01 WS-LP                                  PIC    9(4).
       01 WS-CP                                  PIC    9(4).
       01 WS-SL                                  PIC    X(200).
       01 WS-SC                                  PIC    X(80).
       01 WS-DIV                                 PIC    9(10).
       01 WS-LBL                                 PIC    9(4).
       01 WS-RAW                                 PIC    9(15)V99    OCCURS 3.
       01 WS-RUN                                 PIC    9(15)V99    OCCURS 3.
       01 WS-BV                                  PIC    9(9)V99    OCCURS 3.
       01 WS-LV                                  PIC    9(9)V99    OCCURS 3.
       01 WS-SPK                                 PIC    9(15)V99.
       01 WS-SPV                                 PIC    9(9)V99.
       01 WS-TXT                                 PIC    X(80).
       01 WS-Y1                                  PIC    9(4).
       01 WS-Y2                                  PIC    9(4).

       PROCEDURE DIVISION.
           SET     WS-SL                         TO    SPACES
           SET     WS-SC                         TO    SPACES
           SET     WS-LP                         TO    1
           SET     WS-CP                         TO    1

           *> Series are the 3 leading categories, each in the colour of its slot as
           *> in the donuts. A missing one stays as '-' in neutral grey, so the
           *> series positions never shift.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               IF    WS-K > 1
                   STRING    "," INTO WS-SL WITH POINTER WS-LP
                   STRING    "," INTO WS-SC WITH POINTER WS-CP
               END-IF
               IF    WS-TOP3-IDX(WS-K) > 0
                   STRING    WS-CAT-NAME(WS-TOP3-IDX(WS-K))::Trim() INTO WS-SL WITH POINTER WS-LP
                   STRING    WS-COLOR(WS-TOP3-IDX(WS-K)) DELIMITED BY SIZE INTO WS-SC WITH POINTER WS-CP
               ELSE
                   STRING    "-" INTO WS-SL WITH POINTER WS-LP
                   STRING    "#C9D3E6" INTO WS-SC WITH POINTER WS-CP
               END-IF
           END-PERFORM

           SET     WS-TXT                        TO    SPACES
           SET     WS-Y1                         TO    WS-YR-MIN
           SET     WS-Y2                         TO    WS-YR-NUM(12)

           STRING    "Ano de início: " WS-Y1 " a " WS-Y2 DELIMITED BY SIZE INTO WS-TXT

           SET     CH-BAR::XAxisLabel            TO    WS-TXT
           SET     CH-LINE::XAxisLabel           TO    WS-TXT
           SET     CH-BAR::SeriesLabels          TO    WS-SL
           SET     CH-BAR::SeriesColors          TO    WS-SC
           SET     CH-LINE::SeriesLabels         TO    WS-SL
           SET     CH-LINE::SeriesColors         TO    WS-SC

           *> Divisor that puts each metric in the unit named by the LBL-BAR-U and
           *> LBL-LIN-U captions below: funds as they are, PL in R$ billions,
           *> cotistas in thousands.

           EVALUATE    WS-METRIC
               WHEN 1
                   SET     WS-DIV                TO    1
               WHEN 2
                   SET     WS-DIV                TO    1000000000
               WHEN OTHER
                   SET     WS-DIV                TO    1000
           END-EVALUATE
           *> The cumulative line must start from what exists before the window:
           *> WS-RUN is seeded with WS-OS-*, each leading category's funds that
           *> began earlier, and every year then adds on top.

           PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               EVALUATE    WS-METRIC
                   WHEN 1
                       SET     WS-RUN(WS-K)      TO    WS-OS-CNT(WS-K)
                   WHEN 2
                       SET     WS-RUN(WS-K)      TO    WS-OS-PL(WS-K)
                   WHEN OTHER
                       SET     WS-RUN(WS-K)      TO    WS-OS-COT(WS-K)
               END-EVALUATE
           END-PERFORM
           SET     WS-SPK                        TO    WS-OA-PL

           CH-BAR::Clear()
           CH-LINE::Clear()
           SPK::Clear()

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
               PERFORM    VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   EVALUATE    WS-METRIC
                       WHEN 1
                           SET     WS-RAW(WS-K)  TO    WS-YS-CNT(WS-I, WS-K)
                       WHEN 2
                           SET     WS-RAW(WS-K)  TO    WS-YS-PL(WS-I, WS-K)
                       WHEN OTHER
                           SET     WS-RAW(WS-K)  TO    WS-YS-COT(WS-I, WS-K)
                   END-EVALUATE
                   ADD    WS-RAW(WS-K) TO WS-RUN(WS-K)
                   COMPUTE    WS-BV(WS-K) = WS-RAW(WS-K) / WS-DIV
                   IF    WS-ACUM = 1
                       COMPUTE    WS-LV(WS-K) = WS-RUN(WS-K) / WS-DIV
                   ELSE
                       SET     WS-LV(WS-K)       TO    WS-BV(WS-K)
                   END-IF
               END-PERFORM
               SET     WS-LBL                    TO    WS-YR-NUM(WS-I)

               CH-BAR::AddPoint(WS-LBL, WS-BV(1), WS-BV(2), WS-BV(3))
               CH-LINE::AddPoint(WS-LBL, WS-LV(1), WS-LV(2), WS-LV(3))

               ADD    WS-YA-PL(WS-I) TO WS-SPK
               COMPUTE    WS-SPV = WS-SPK / 1000000000
               SPK::AddPoint(WS-LBL, WS-SPV)
           END-PERFORM
           EVALUATE    WS-METRIC
               WHEN 1
                   SET     LBL-BAR-U::Caption    TO    "quantidade de fundos"
                   SET     LBL-LIN-U::Caption    TO    "quantidade de fundos"
                   SET     WS-FC                 TO    WS-T-CNT

                   CALL    "FMT-COUNT"
                   SET     LBL-BAR-TOT::Caption  TO    WS-FT
               WHEN 2
                   SET     LBL-BAR-U::Caption    TO    "PL em R$ bilhões"
                   SET     LBL-LIN-U::Caption    TO    "PL em R$ bilhões"
                   SET     WS-FV                 TO    WS-T-PL

                   CALL    "FMT-SHORT"
                   SET     WS-TXT                TO    SPACES
                   STRING    "R$ " WS-FT::Trim() INTO WS-TXT
                   SET     LBL-BAR-TOT::Caption  TO    WS-TXT
               WHEN OTHER
                   SET     LBL-BAR-U::Caption    TO    "milhares de cotistas"
                   SET     LBL-LIN-U::Caption    TO    "milhares de cotistas"
                   SET     WS-FV                 TO    WS-T-COT

                   CALL    "FMT-SHORT"
                   SET     LBL-BAR-TOT::Caption  TO    WS-FT
           END-EVALUATE
]]></Event>
    <Event name="PAINT-TABS" paragraph="PAINT-TABS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     BTN-M1::BackgroundColor       TO    "#FFFFFF"
           SET     BTN-M2::BackgroundColor       TO    "#FFFFFF"
           SET     BTN-M3::BackgroundColor       TO    "#FFFFFF"
           SET     BTN-M1::ForegroundColor       TO    "#1B2A4E"
           SET     BTN-M2::ForegroundColor       TO    "#1B2A4E"
           SET     BTN-M3::ForegroundColor       TO    "#1B2A4E"

           EVALUATE    WS-METRIC
               WHEN 1
                   SET     BTN-M1::BackgroundColor
                                                 TO    "#3E7BE8"

                   SET     BTN-M1::ForegroundColor
                                                 TO    "#FFFFFF"
               WHEN 2
                   SET     BTN-M2::BackgroundColor
                                                 TO    "#3E7BE8"

                   SET     BTN-M2::ForegroundColor
                                                 TO    "#FFFFFF"
               WHEN OTHER
                   SET     BTN-M3::BackgroundColor
                                                 TO    "#3E7BE8"

                   SET     BTN-M3::ForegroundColor
                                                 TO    "#FFFFFF"
           END-EVALUATE
]]></Event>
    <Event name="PAINT-LISTS" paragraph="PAINT-LISTS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-PCTI                                PIC    9(3).
       01 WS-TOT2                                PIC    9(15)V99.

       PROCEDURE DIVISION.
           *> Each bar is that fund's PL as a percent of the largest one (the first,
           *> so always 100), not of the total. A row is blanked when fewer than four
           *> funds match.

           IF    WS-TOP-N >= 1
               SET     LBL-TOP1-N::Caption       TO    WS-TOP-NAME(1)
               SET     WS-FV                     TO    WS-TOP-PL(1)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP1-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(1) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP1::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP1-N::Caption       TO    SPACES
               SET     LBL-TOP1-V::Caption       TO    SPACES

               PRG-TOP1::SetValue(0)
           END-IF
           IF    WS-TOP-N >= 2
               SET     LBL-TOP2-N::Caption       TO    WS-TOP-NAME(2)
               SET     WS-FV                     TO    WS-TOP-PL(2)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP2-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(2) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP2::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP2-N::Caption       TO    SPACES
               SET     LBL-TOP2-V::Caption       TO    SPACES

               PRG-TOP2::SetValue(0)
           END-IF
           IF    WS-TOP-N >= 3
               SET     LBL-TOP3-N::Caption       TO    WS-TOP-NAME(3)
               SET     WS-FV                     TO    WS-TOP-PL(3)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP3-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(3) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP3::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP3-N::Caption       TO    SPACES
               SET     LBL-TOP3-V::Caption       TO    SPACES

               PRG-TOP3::SetValue(0)
           END-IF
           IF    WS-TOP-N >= 4
               SET     LBL-TOP4-N::Caption       TO    WS-TOP-NAME(4)
               SET     WS-FV                     TO    WS-TOP-PL(4)

               CALL    "FMT-SHORT"
               SET     WS-TXT                    TO    SPACES
               STRING    "R$ " WS-FT::Trim() INTO WS-TXT

               SET     LBL-TOP4-V::Caption       TO    WS-TXT
               SET     WS-PCTI                   TO    0

               IF    WS-TOP-PL(1) > 0
                   COMPUTE    WS-PCTI = WS-TOP-PL(4) * 100 / WS-TOP-PL(1)
               END-IF
               PRG-TOP4::SetValue(WS-PCTI)
           ELSE
               SET     LBL-TOP4-N::Caption       TO    SPACES
               SET     LBL-TOP4-V::Caption       TO    SPACES

               PRG-TOP4::SetValue(0)
           END-IF
           *>  structure: share of the PL held by classes and by sub-classes

           COMPUTE    WS-TOT2 = WS-T-CLS + WS-T-SUB

           SET     WS-FP                         TO    0
           SET     WS-PCTI                       TO    0

           IF    WS-TOT2 > 0
               COMPUTE    WS-FP = WS-T-CLS * 100 / WS-TOT2
               COMPUTE    WS-PCTI = WS-T-CLS * 100 / WS-TOT2
           END-IF
           PRG-CLS::SetValue(WS-PCTI)
           CALL    "FMT-PCT"

           SET     LBL-CLS-P::Caption            TO    WS-FT
           SET     WS-FP                         TO    0
           SET     WS-PCTI                       TO    0

           IF    WS-TOT2 > 0
               COMPUTE    WS-FP = WS-T-SUB * 100 / WS-TOT2
               COMPUTE    WS-PCTI = WS-T-SUB * 100 / WS-TOT2
           END-IF
           PRG-SUB::SetValue(WS-PCTI)
           CALL    "FMT-PCT"
           SET     LBL-SUB-P::Caption            TO    WS-FT
]]></Event>
    <Event name="PAINT-DATA" paragraph="PAINT-DATA"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-A                                   PIC    X(24).
       01 WS-PCT                                 PIC    9(3)V9.
       01 WS-AVG                                 PIC    9(15)V99.
       01 WS-R                                   PIC    99.

       PROCEDURE DIVISION.
           SET     WS-FC                         TO    WS-T-CNT
           CALL    "FMT-COUNT"

           SET     LBL-K1-V::Caption             TO    WS-FT
           SET     WS-PCT                        TO    0

           IF    WS-UNIV > 0
               COMPUTE    WS-PCT = WS-T-CNT * 100 / WS-UNIV
           END-IF
           SET     WS-FP                         TO    WS-PCT
           CALL    "FMT-PCT"
           SET     WS-TXT                        TO    SPACES
           STRING    WS-FT::Trim() " do universo" INTO WS-TXT

           SET     LBL-K1-S::Caption             TO    WS-TXT
           SET     WS-FV                         TO    WS-T-PL

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT

           SET     LBL-K2-V::Caption             TO    WS-TXT
           SET     WS-AVG                        TO    0

           *> Average over the funds that report a PL (WS-T-PLN, from COUNT(pl)),
           *> not over all of them.

           IF    WS-T-PLN > 0
               COMPUTE    WS-AVG = WS-T-PL / WS-T-PLN
           END-IF
           SET     WS-FV                         TO    WS-AVG
           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "médio R$ " WS-FT::Trim() " por fundo" INTO WS-TXT

           SET     LBL-K2-S::Caption             TO    WS-TXT
           SET     WS-FV                         TO    WS-T-COT

           CALL    "FMT-SHORTN"

           SET     LBL-K3-V::Caption             TO    WS-FT
           SET     WS-AVG                        TO    0

           IF    WS-T-CNT > 0
               COMPUTE    WS-AVG = WS-T-COT / WS-T-CNT
           END-IF
           SET     WS-FV                         TO    WS-AVG
           CALL    "FMT-SHORTN"
           SET     WS-TXT                        TO    SPACES
           STRING    "média " WS-FT::Trim() " por fundo" INTO WS-TXT

           SET     LBL-K3-S::Caption             TO    WS-TXT
           SET     WS-FV                         TO    WS-T-MAX

           CALL    "FMT-SHORT"
           SET     WS-TXT                        TO    SPACES
           STRING    "R$ " WS-FT::Trim() INTO WS-TXT
           SET     LBL-K4-V::Caption             TO    WS-TXT
           IF    WS-TOP-N > 0
               SET     LBL-K4-S::Caption         TO    WS-TOP-NAME(1)
           ELSE
               SET     LBL-K4-S::Caption         TO    SPACES
           END-IF
           SET     WS-R                          TO    WS-RANK(1)
           IF    WS-R > 0
               SET     LBL-K5-V::Caption         TO    WS-CAT-NAME(WS-R)
               SET     WS-FP                     TO    0

               IF    WS-T-PL > 0
                   COMPUTE    WS-FP = WS-CAT-PL(WS-R) * 100 / WS-T-PL
               END-IF
               CALL    "FMT-PCT"
               SET     WS-TXT                    TO    SPACES
               STRING    WS-FT::Trim() " do PL filtrado" INTO WS-TXT
               SET     LBL-K5-S::Caption         TO    WS-TXT
           ELSE
               SET     LBL-K5-V::Caption         TO    "-"
               SET     LBL-K5-S::Caption         TO    SPACES
           END-IF
]]></Event>
    <Event name="PAINT-GRID-INFO" paragraph="PAINT-GRID-INFO"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-TXT                                 PIC    X(120).
       01 WS-A                                   PIC    X(24).
       01 WS-B                                   PIC    X(24).
       01 WS-FROM                                PIC    9(9).
       01 WS-TO                                  PIC    9(9).

       PROCEDURE DIVISION.
           IF    WS-T-CNT = 0
               SET     WS-FROM                   TO    0
               SET     WS-TO                     TO    0
           ELSE
               COMPUTE    WS-FROM = (WS-PAGE - 1) * WS-PSIZE + 1
               COMPUTE    WS-TO = WS-PAGE * WS-PSIZE

               IF    WS-TO > WS-T-CNT
                   SET     WS-TO                 TO    WS-T-CNT
               END-IF
           END-IF
           *> FMT-COUNT answers in WS-FT, which the next call overwrites, so each
           *> formatted number waits in WS-A / WS-B until the sentence is built.

           SET     WS-FC                         TO    WS-FROM
           CALL    "FMT-COUNT"

           SET     WS-A                          TO    WS-FT
           SET     WS-FC                         TO    WS-TO

           CALL    "FMT-COUNT"

           SET     WS-B                          TO    WS-FT
           SET     WS-FC                         TO    WS-T-CNT

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           STRING    "Mostrando " FUNCTION TRIM(WS-A) " a " FUNCTION TRIM(WS-B) " de " WS-FT::Trim()
               " fundo(s)" INTO WS-TXT
           SET     LBL-GRID-S::Caption           TO    WS-TXT
           SET     WS-FC                         TO    WS-PAGE

           CALL    "FMT-COUNT"

           SET     WS-A                          TO    WS-FT
           SET     WS-FC                         TO    WS-PAGES

           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           STRING    "Página " FUNCTION TRIM(WS-A) " de " WS-FT::Trim() INTO WS-TXT
           SET     LBL-PAGE::Caption             TO    WS-TXT
           IF    WS-PAGE > 1
               BTN-PREV::Enable()
           ELSE
               BTN-PREV::Disable()
           END-IF
           IF    WS-PAGE < WS-PAGES
               BTN-NEXT::Enable()
           ELSE
               BTN-NEXT::Disable()
           END-IF
]]></Event>
    <Event name="REFRESH-GRID" paragraph="REFRESH-GRID"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           CALL    "Q-GRID"
           CALL    "PAINT-GRID-INFO"
]]></Event>
    <Event name="APPLY-FILTERS" paragraph="APPLY-FILTERS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-LOADED = 0
               EXIT PARAGRAPH
           END-IF
           SET     WS-PAGE                       TO    1

           *> Run in dependency order: BUILD-WHERE feeds every query, Q-YEARS needs
           *> Q-TOTALS (newest year) and Q-CATS (counts), and the painters only read
           *> what the queries stored.

           CALL    "BUILD-WHERE"
           CALL    "Q-TOTALS"
           CALL    "Q-CATS"
           CALL    "SORT-CATS"
           CALL    "Q-N2"
           CALL    "Q-BINS"
           CALL    "Q-TOP"
           CALL    "Q-YEARS"
           CALL    "PAINT-KPIS"
           CALL    "PAINT-CHARTS"
           CALL    "PAINT-YEARS"
           CALL    "PAINT-TABS"
           CALL    "PAINT-LISTS"
           CALL    "PAINT-DATA"
           CALL    "REFRESH-GRID"
]]></Event>
    <Event name="PAINT-BINS" paragraph="PAINT-BINS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    99.
       01 WS-BMAX                                PIC    9(9).
       01 WS-BTOT                                PIC    9(9).
       01 WS-PCTI                                PIC    9(3).
       01 WS-TXT                                 PIC    X(60).
       01 WS-A                                   PIC    X(24).

       PROCEDURE DIVISION.
           *> The text gives each band's share of the total (WS-BTOT); the bar is
           *> relative to the largest band (WS-BMAX), so the tallest always fills.

           SET     WS-BMAX                       TO    0
           SET     WS-BTOT                       TO    0

           PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
               ADD    WS-BIN-CNT(WS-I) TO WS-BTOT
               IF    WS-BIN-CNT(WS-I) > WS-BMAX
                   SET     WS-BMAX               TO    WS-BIN-CNT(WS-I)
               END-IF
           END-PERFORM
           SET     WS-FC                         TO    WS-BIN-CNT(1)
           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(1) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT
           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN1-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(1) * 100 / WS-BMAX
           END-IF
           PRG-BIN1::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(2)
           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(2) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT
           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN2-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(2) * 100 / WS-BMAX
           END-IF
           PRG-BIN2::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(3)
           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(3) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT
           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN3-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(3) * 100 / WS-BMAX
           END-IF
           PRG-BIN3::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(4)
           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(4) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT
           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN4-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(4) * 100 / WS-BMAX
           END-IF
           PRG-BIN4::SetValue(WS-PCTI)
           SET     WS-FC                         TO    WS-BIN-CNT(5)
           CALL    "FMT-COUNT"
           SET     WS-TXT                        TO    SPACES
           IF    WS-BTOT > 0
               COMPUTE    WS-FP = WS-BIN-CNT(5) * 100 / WS-BTOT
           ELSE
               SET     WS-FP                     TO    0
           END-IF
           SET     WS-A                          TO    WS-FT
           CALL    "FMT-PCT"
           STRING    FUNCTION TRIM(WS-A) "  (" WS-FT::Trim() ")" INTO WS-TXT

           SET     LBL-BIN5-V::Caption           TO    WS-TXT
           SET     WS-PCTI                       TO    0

           IF    WS-BMAX > 0
               COMPUTE    WS-PCTI = WS-BIN-CNT(5) * 100 / WS-BMAX
           END-IF
           PRG-BIN5::SetValue(WS-PCTI)
]]></Event>
    <Event name="SHOW-C-KPI" paragraph="SHOW-C-KPI"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           C-KPI::Show()
           C-KPI::PlayAnimation("intro")
           LBL-KPI-T::PlayAnimation("intro")
           LBL-KPI-V::PlayAnimation("intro")
           GAU-UNIV::PlayAnimation("intro")
           LBL-KPI-GC::PlayAnimation("intro")
           LBL-KPI-C::PlayAnimation("intro")
           SPK::PlayAnimation("intro")
           LBL-KPI-F::PlayAnimation("intro")
]]></Event>
    <Event name="SHOW-C-BAR" paragraph="SHOW-C-BAR"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           C-BAR::Show()
           C-BAR::PlayAnimation("intro")
           LBL-BAR-T::PlayAnimation("intro")
           LBL-BAR-TOT::PlayAnimation("intro")
           LBL-BAR-U::PlayAnimation("intro")
           BTN-M1::PlayAnimation("intro")
           BTN-M2::PlayAnimation("intro")
           BTN-M3::PlayAnimation("intro")
           CH-BAR::PlayAnimation("intro")
]]></Event>
    <Event name="SHOW-C-RADAR" paragraph="SHOW-C-RADAR"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           C-RADAR::Show()
           C-RADAR::PlayAnimation("intro")
           LBL-RAD-T::PlayAnimation("intro")
           LBL-RAD-S::PlayAnimation("intro")
           CH-RADAR::PlayAnimation("intro")
]]></Event>
    <Event name="SHOW-C-GOALS" paragraph="SHOW-C-GOALS"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           C-GOALS::Show()
           C-GOALS::PlayAnimation("intro")
           LBL-GOAL-T::PlayAnimation("intro")
           LBL-TOP1-N::PlayAnimation("intro")
