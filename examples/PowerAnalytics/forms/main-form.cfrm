  <file-control><![CDATA[           SELECT SQL-FILE ASSIGN TO "data/fundos.sql"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-FS.
]]></file-control>
  <file-section><![CDATA[       FD SQL-FILE IS GLOBAL.
       01 SQL-REC PIC X(30000).
]]></file-section>
  <user-procedures>
    <Event name="FMT-SHORT" paragraph="FMT-SHORT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-FD  PIC 9(4)V99.
       01 WS-ED  PIC ZZZ9.99.
       01 WS-EX  PIC X(9).
       01 WS-SUF PIC X(4).
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-SUF
           IF WS-FV >= 1000000000000
               COMPUTE WS-FD ROUNDED = WS-FV / 1000000000000
               MOVE "tri" TO WS-SUF
           ELSE
               IF WS-FV >= 1000000000
                   COMPUTE WS-FD ROUNDED = WS-FV / 1000000000
                   MOVE "bi" TO WS-SUF
               ELSE
                   IF WS-FV >= 1000000
                       COMPUTE WS-FD ROUNDED = WS-FV / 1000000
                       MOVE "mi" TO WS-SUF
                   ELSE
                       IF WS-FV >= 1000
                           COMPUTE WS-FD ROUNDED = WS-FV / 1000
                           MOVE "mil" TO WS-SUF
                       ELSE
                           MOVE WS-FV TO WS-FD
                       END-IF
                   END-IF
               END-IF
           END-IF
           MOVE WS-FD TO WS-ED
           MOVE WS-ED TO WS-EX
           INSPECT WS-EX CONVERTING "." TO ","
           MOVE SPACES TO WS-FT
           STRING FUNCTION TRIM(WS-EX) " " FUNCTION TRIM(WS-SUF)
               DELIMITED BY SIZE INTO WS-FT
]]></Event>
    <Event name="FMT-SHORTN" paragraph="FMT-SHORTN"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-FV < 1000
               MOVE WS-FV TO WS-FC
               CALL "FMT-COUNT"
           ELSE
               CALL "FMT-SHORT"
           END-IF
]]></Event>
    <Event name="FMT-COUNT" paragraph="FMT-COUNT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ED PIC ZZZ,ZZZ,ZZZ,ZZ9.
       01 WS-EX PIC X(20).
       PROCEDURE DIVISION.
           MOVE WS-FC TO WS-ED
           MOVE WS-ED TO WS-EX
           INSPECT WS-EX CONVERTING "," TO "."
           MOVE FUNCTION TRIM(WS-EX) TO WS-FT
]]></Event>
    <Event name="FMT-PCT" paragraph="FMT-PCT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ED PIC ZZ9.9.
       01 WS-EX PIC X(8).
       PROCEDURE DIVISION.
           MOVE WS-FP TO WS-ED
           MOVE WS-ED TO WS-EX
           INSPECT WS-EX CONVERTING "." TO ","
           MOVE SPACES TO WS-FT
           STRING FUNCTION TRIM(WS-EX) "%" DELIMITED BY SIZE INTO WS-FT
]]></Event>
    <Event name="INIT-DB" paragraph="INIT-DB"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE DB-1::Open(":memory:") TO WS-H
           OPEN INPUT SQL-FILE
           IF WS-FS NOT = "00"
               MOVE "Base de dados não encontrada (data/fundos.sql)" TO LBL-STATUS::Caption
               EXIT PARAGRAPH
           END-IF
           MOVE DB-1::Execute("BEGIN") TO WS-N
           PERFORM UNTIL 1 = 2
               READ SQL-FILE
                   AT END EXIT PERFORM
               END-READ
               MOVE DB-1::Execute(SQL-REC) TO WS-N
           END-PERFORM
           MOVE DB-1::Execute("COMMIT") TO WS-N
           CLOSE SQL-FILE
           MOVE DB-1::Execute("CREATE TABLE pick (fld TEXT, name TEXT, PRIMARY KEY (fld, name))") TO WS-N
           MOVE DB-1::Execute("CREATE TABLE vis (fld TEXT, name TEXT)") TO WS-N
           MOVE DB-1::Execute("CREATE TABLE chk (name TEXT)") TO WS-N
           MOVE 1 TO WS-LOADED
]]></Event>
    <Event name="LOAD-DIMS" paragraph="LOAD-DIMS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1  PIC X(60).
       01 WS-I   PIC 99.
       01 WS-TXT PIC X(120).
       PROCEDURE DIVISION.
           MOVE "SELECT COUNT(*) FROM fundos" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE DB-1::Fetch() TO WS-ROW
           COMPUTE WS-UNIV = FUNCTION NUMVAL(WS-ROW)
           MOVE "SELECT COALESCE(strftime('%d/%m/%Y', MAX(data_ref)),'') FROM fundos" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE DB-1::Fetch() TO WS-ROW
           MOVE WS-UNIV TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           STRING "Base ANBIMA  |  referência " FUNCTION TRIM(WS-ROW) "  |  " FUNCTION TRIM(WS-FT) " fundo(s)"
               DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-STATUS::Caption
           INVOKE LST-N2::Clear()
           INVOKE LST-N3::Clear()
           MOVE 0 TO WS-CATCNT
           MOVE "SELECT nivel1 FROM fundos WHERE nivel1 IS NOT NULL GROUP BY nivel1 ORDER BY COUNT(*) DESC" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               IF WS-CATCNT < 10
                   ADD 1 TO WS-CATCNT
                   MOVE WS-ROW TO WS-CAT-NAME(WS-CATCNT)
               END-IF
           END-PERFORM
           MOVE "SELECT nivel2 FROM fundos WHERE nivel2 IS NOT NULL GROUP BY nivel2 ORDER BY COUNT(*) DESC" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               INVOKE LST-N2::AddItem(FUNCTION TRIM(WS-ROW))
           END-PERFORM
           MOVE "SELECT nivel3 FROM fundos WHERE nivel3 IS NOT NULL GROUP BY nivel3 ORDER BY COUNT(*) DESC" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               INVOKE LST-N3::AddItem(FUNCTION TRIM(WS-ROW))
           END-PERFORM
]]></Event>
    <Event name="MAKE-IN-LIST" paragraph="MAKE-IN-LIST"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ITEM PIC X(60).
       01 WS-UP   PIC 9(5).
       01 WS-LEN  PIC 9(5).
       01 WS-IP   PIC 9(5).
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-IN
           MOVE 1 TO WS-IP
           IF WS-CHK = SPACES
               EXIT PARAGRAPH
           END-IF
           MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-CHK)) TO WS-LEN
           MOVE 1 TO WS-UP
           PERFORM UNTIL WS-UP > WS-LEN
               MOVE SPACES TO WS-ITEM
               UNSTRING WS-CHK DELIMITED BY X"0A" INTO WS-ITEM WITH POINTER WS-UP
               IF WS-ITEM NOT = SPACES
                   IF WS-IP > 1
                       STRING "," DELIMITED BY SIZE INTO WS-IN WITH POINTER WS-IP
                   END-IF
                   STRING "'" FUNCTION TRIM(WS-ITEM) "'" DELIMITED BY SIZE INTO WS-IN WITH POINTER WS-IP
               END-IF
           END-PERFORM
]]></Event>
    <Event name="NORM-TERM" paragraph="NORM-TERM"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           INSPECT WS-TERM CONVERTING "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑ'" TO "aaaaaeeeeiiiiooooouuuucnAAAAAEEEEIIIIOOOOOUUUUCN_"
           MOVE FUNCTION UPPER-CASE(WS-TERM) TO WS-TERM
           IF WS-TERM = SPACES
               MOVE "%" TO WS-PAT
           ELSE
               MOVE SPACES TO WS-PAT
               STRING "%" FUNCTION TRIM(WS-TERM) "%" DELIMITED BY SIZE INTO WS-PAT
           END-IF
]]></Event>
    <Event name="SQ-ESC" paragraph="SQ-ESC"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-EI   PIC 9(5).
       01 WS-EL   PIC 9(5).
       01 WS-PART PIC X(200).
       01 WS-DL   PIC X(2).
       01 WS-CNT  PIC 9(5).
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-ESC
           MOVE 1 TO WS-BPTR
           MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-ONE)) TO WS-EL
           MOVE 1 TO WS-EI
           PERFORM UNTIL WS-EI > WS-EL
               MOVE SPACES TO WS-PART
               MOVE SPACES TO WS-DL
               MOVE 0 TO WS-CNT
               UNSTRING WS-ONE DELIMITED BY "'" INTO WS-PART DELIMITER IN WS-DL COUNT IN WS-CNT WITH POINTER WS-EI
               IF WS-CNT > 0
                   STRING WS-PART(1:WS-CNT) DELIMITED BY SIZE INTO WS-ESC WITH POINTER WS-BPTR
               END-IF
               IF WS-DL = "'"
                   STRING "''" DELIMITED BY SIZE INTO WS-ESC WITH POINTER WS-BPTR
               END-IF
           END-PERFORM
]]></Event>
    <Event name="SM-TYPED" paragraph="SM-TYPED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-SMX = "N"
               MOVE TXT-NOME::Text TO WS-TERM
               IF WS-TERM = WS-LAST-N
                   EXIT PARAGRAPH
               END-IF
               MOVE WS-TERM TO WS-LAST-N
           ELSE
               MOVE TXT-CAT::Text TO WS-TERM
               IF WS-TERM = WS-LAST-C
                   EXIT PARAGRAPH
               END-IF
               MOVE WS-TERM TO WS-LAST-C
           END-IF
           IF WS-SM NOT = WS-SMX
               CALL "SM-OPEN"
           ELSE
               CALL "SM-REFRESH"
           END-IF
]]></Event>
    <Event name="SM-OPEN" paragraph="SM-OPEN"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "CLOSE-LEVELS"
           MOVE WS-SMX TO WS-SM
           IF WS-SM = "N"
               MOVE "Nome comercial  ·  marque os fundos que quer ver" TO LBL-SM-T::Caption
           ELSE
               MOVE "Categoria  ·  marque as categorias que quer ver" TO LBL-SM-T::Caption
           END-IF
           CALL "SET-FILT-HEIGHT"
           CALL "SM-REFRESH"
           COMPUTE WS-N = SM-DROP::Y + SM-DROP::Height
           MOVE WS-N TO SCRIM::Y
           INVOKE SCRIM::Show()
           INVOKE SM-DROP::Show()
           INVOKE SCRIM::BringToFront()
           INVOKE SM-DROP::BringToFront()
]]></Event>
    <Event name="SM-CLOSE" paragraph="SM-CLOSE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-SM NOT = SPACE
               MOVE SPACE TO WS-SM
               INVOKE SM-DROP::Hide()
               INVOKE SCRIM::Hide()
           END-IF
]]></Event>
    <Event name="SM-REFRESH" paragraph="SM-REFRESH"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SK2 PIC 9(3).
       01 WS-TL  PIC 9(3).
       01 WS-CMP PIC X(60).
       01 WS-HIT PIC 9(5).
       PROCEDURE DIVISION.
           IF WS-SM = "N"
               MOVE TXT-NOME::Text TO WS-TERM
           ELSE
               MOVE TXT-CAT::Text TO WS-TERM
           END-IF
           CALL "NORM-TERM"
           MOVE SPACES TO WS-SQL
           STRING "DELETE FROM vis WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Execute(WS-SQL) TO WS-N
           IF WS-SM = "N"
               MOVE SPACES TO WS-SQL
               STRING "INSERT INTO vis SELECT 'N', nome FROM fundos WHERE nome IS NOT NULL AND nome <> '' AND nome_key LIKE '"
                   FUNCTION TRIM(WS-PAT) "' GROUP BY nome ORDER BY nome LIMIT 150"
                   DELIMITED BY SIZE INTO WS-SQL
               MOVE DB-1::Execute(WS-SQL) TO WS-N
               MOVE SPACES TO WS-SQL
               STRING "SELECT COUNT(DISTINCT nome) FROM fundos WHERE nome IS NOT NULL AND nome <> '' AND nome_key LIKE '"
                   FUNCTION TRIM(WS-PAT) "'" DELIMITED BY SIZE INTO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               MOVE DB-1::Fetch() TO WS-ROW
               COMPUTE WS-SMN = FUNCTION NUMVAL(WS-ROW)
           ELSE
               MOVE 0 TO WS-SMN
               MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-TERM)) TO WS-TL
               PERFORM VARYING WS-SK2 FROM 1 BY 1 UNTIL WS-SK2 > WS-CATCNT
                   MOVE SPACES TO WS-ONE
                   MOVE FUNCTION TRIM(WS-CAT-NAME(WS-SK2)) TO WS-ONE
                   MOVE WS-ONE TO WS-CMP
                   INSPECT WS-CMP CONVERTING "áàâãäéèêëíìîïóòôõöúùûüçñÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇÑ'" TO "aaaaaeeeeiiiiooooouuuucnAAAAAEEEEIIIIOOOOOUUUUCN_"
                   MOVE FUNCTION UPPER-CASE(WS-CMP) TO WS-CMP
                   MOVE 1 TO WS-HIT
                   IF WS-TERM NOT = SPACES
                       MOVE SPACES TO WS-SQL
                       STRING "SELECT instr('" FUNCTION TRIM(WS-CMP) "','" FUNCTION TRIM(WS-TERM) "')"
                           DELIMITED BY SIZE INTO WS-SQL
                       MOVE DB-1::Query(WS-SQL) TO WS-N
                       MOVE DB-1::Fetch() TO WS-ROW
                       COMPUTE WS-HIT = FUNCTION NUMVAL(WS-ROW)
                   END-IF
                   IF WS-HIT > 0
                       ADD 1 TO WS-SMN
                       CALL "SQ-ESC"
                       MOVE SPACES TO WS-SQL
                       STRING "INSERT INTO vis VALUES ('C','" FUNCTION TRIM(WS-ESC) "')" DELIMITED BY SIZE INTO WS-SQL
                       MOVE DB-1::Execute(WS-SQL) TO WS-N
                   END-IF
               END-PERFORM
           END-IF
           INVOKE LST-SM::Clear()
           INVOKE LST-SM::AddItem("Todos")
           MOVE SPACES TO WS-SQL
           STRING "SELECT name FROM vis WHERE fld = '" WS-SM "' ORDER BY rowid" DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE 0 TO WS-SMK
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               ADD 1 TO WS-SMK
               INVOKE LST-SM::AddItem(FUNCTION TRIM(WS-ROW))
           END-PERFORM
           CALL "SM-TICKS"
           CALL "SM-INFO"
]]></Event>
    <Event name="SM-TICKS" paragraph="SM-TICKS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-BIG
           MOVE 1 TO WS-BPTR
           MOVE SPACES TO WS-SQL
           IF (WS-SM = "N" AND WS-ALL-N = 1) OR (WS-SM = "C" AND WS-ALL-C = 1)
               STRING "Todos" DELIMITED BY SIZE INTO WS-BIG WITH POINTER WS-BPTR
               STRING "SELECT name FROM vis WHERE fld = '" WS-SM "' ORDER BY rowid" DELIMITED BY SIZE INTO WS-SQL
           ELSE
               STRING "SELECT name FROM vis WHERE fld = '" WS-SM "' AND name IN (SELECT name FROM pick WHERE fld = '"
                   WS-SM "') ORDER BY rowid" DELIMITED BY SIZE INTO WS-SQL
           END-IF
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               IF WS-BPTR > 1
                   STRING X"0A" DELIMITED BY SIZE INTO WS-BIG WITH POINTER WS-BPTR
               END-IF
               STRING FUNCTION TRIM(WS-ROW) DELIMITED BY SIZE INTO WS-BIG WITH POINTER WS-BPTR
           END-PERFORM
           IF WS-BPTR = 1
               MOVE SPACES TO LST-SM::CheckedItems
           ELSE
               MOVE FUNCTION TRIM(WS-BIG) TO LST-SM::CheckedItems
           END-IF
]]></Event>
    <Event name="SM-INFO" paragraph="SM-INFO"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-SMP PIC 9(9).
       01 WS-E1  PIC Z(8)9.
       01 WS-E2  PIC Z(8)9.
       01 WS-E3  PIC Z(8)9.
       01 WS-MSG PIC X(160).
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-SQL
           STRING "SELECT COUNT(*) FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE DB-1::Fetch() TO WS-ROW
           COMPUTE WS-SMP = FUNCTION NUMVAL(WS-ROW)
           MOVE WS-SMN TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-MSG
           IF (WS-SM = "N" AND WS-ALL-N = 1) OR (WS-SM = "C" AND WS-ALL-C = 1)
               STRING "Todos: os " FUNCTION TRIM(WS-FT) " resultado(s) da busca entram no filtro."
                   DELIMITED BY SIZE INTO WS-MSG
           ELSE
               MOVE WS-SMK TO WS-E2
               MOVE WS-SMP TO WS-E3
               IF WS-SMP > 0
                   STRING FUNCTION TRIM(WS-FT) " encontrado(s)  ·  exibindo " FUNCTION TRIM(WS-E2)
                       "  ·  " FUNCTION TRIM(WS-E3) " marcado(s): só eles entram no filtro"
                       DELIMITED BY SIZE INTO WS-MSG
               ELSE
                   STRING FUNCTION TRIM(WS-FT) " encontrado(s)  ·  exibindo " FUNCTION TRIM(WS-E2)
                       "  ·  nenhum marcado: vale o texto digitado"
                       DELIMITED BY SIZE INTO WS-MSG
               END-IF
           END-IF
           MOVE WS-MSG TO LBL-SM-INFO::Caption
]]></Event>
    <Event name="SM-CAPTIONS" paragraph="SM-CAPTIONS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-KN PIC 9(9).
       01 WS-KC PIC 9(9).
       01 WS-EN PIC Z(8)9.
       01 WS-CAPT PIC X(60).
       PROCEDURE DIVISION.
           MOVE "SELECT COUNT(*) FROM pick WHERE fld = 'N'" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE DB-1::Fetch() TO WS-ROW
           COMPUTE WS-KN = FUNCTION NUMVAL(WS-ROW)
           MOVE "SELECT COUNT(*) FROM pick WHERE fld = 'C'" TO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE DB-1::Fetch() TO WS-ROW
           COMPUTE WS-KC = FUNCTION NUMVAL(WS-ROW)
           MOVE SPACES TO WS-CAPT
           IF WS-ALL-N = 1
               MOVE "Nome comercial  ·  Todos" TO WS-CAPT
           ELSE
               IF WS-KN > 0
                   MOVE WS-KN TO WS-EN
                   STRING "Nome comercial  ·  " FUNCTION TRIM(WS-EN) " marcado(s)" DELIMITED BY SIZE INTO WS-CAPT
               ELSE
                   MOVE "Nome comercial" TO WS-CAPT
               END-IF
           END-IF
           MOVE WS-CAPT TO LBL-F-NOME::Caption
           MOVE SPACES TO WS-CAPT
           IF WS-ALL-C = 1
               MOVE "Categoria  ·  Todos" TO WS-CAPT
           ELSE
               IF WS-KC > 0
                   MOVE WS-KC TO WS-EN
                   STRING "Categoria  ·  " FUNCTION TRIM(WS-EN) " marcado(s)" DELIMITED BY SIZE INTO WS-CAPT
               ELSE
                   MOVE "Categoria" TO WS-CAPT
               END-IF
           END-IF
           MOVE WS-CAPT TO LBL-F-CAT::Caption
]]></Event>
    <Event name="SM-CHECKED" paragraph="SM-CHECKED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-UP2   PIC 9(5).
       01 WS-LN    PIC 9(5).
       01 WS-TODOS PIC 9.
       01 WS-ALLC  PIC 9.
       PROCEDURE DIVISION.
           MOVE LST-SM::CheckedItems TO WS-BIG
           MOVE DB-1::Execute("DELETE FROM chk") TO WS-N
           MOVE 0 TO WS-TODOS
           IF WS-BIG NOT = SPACES
               MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-BIG)) TO WS-LN
               MOVE 1 TO WS-UP2
               PERFORM UNTIL WS-UP2 > WS-LN
                   MOVE SPACES TO WS-ONE
                   UNSTRING WS-BIG DELIMITED BY X"0A" INTO WS-ONE WITH POINTER WS-UP2
                   IF WS-ONE = "Todos"
                       MOVE 1 TO WS-TODOS
                   ELSE
                       IF WS-ONE NOT = SPACES
                           CALL "SQ-ESC"
                           MOVE SPACES TO WS-SQL
                           STRING "INSERT INTO chk VALUES ('" FUNCTION TRIM(WS-ESC) "')" DELIMITED BY SIZE INTO WS-SQL
                           MOVE DB-1::Execute(WS-SQL) TO WS-N
                       END-IF
                   END-IF
               END-PERFORM
           END-IF
           IF WS-SM = "N"
               MOVE WS-ALL-N TO WS-ALLC
           ELSE
               MOVE WS-ALL-C TO WS-ALLC
           END-IF
           EVALUATE TRUE
               WHEN WS-ALLC = 0 AND WS-TODOS = 1
                   CALL "SM-SET-ALL"
                   MOVE SPACES TO WS-SQL
                   STRING "DELETE FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
                   MOVE DB-1::Execute(WS-SQL) TO WS-N
               WHEN WS-ALLC = 1 AND WS-TODOS = 0
                   CALL "SM-CLR-ALL"
                   MOVE SPACES TO WS-SQL
                   STRING "DELETE FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
                   MOVE DB-1::Execute(WS-SQL) TO WS-N
               WHEN OTHER
                   CALL "SM-CLR-ALL"
                   MOVE SPACES TO WS-SQL
                   STRING "DELETE FROM pick WHERE fld = '" WS-SM "' AND name IN (SELECT name FROM vis WHERE fld = '"
                       WS-SM "') AND name NOT IN (SELECT name FROM chk)" DELIMITED BY SIZE INTO WS-SQL
                   MOVE DB-1::Execute(WS-SQL) TO WS-N
                   MOVE SPACES TO WS-SQL
                   STRING "INSERT OR IGNORE INTO pick SELECT '" WS-SM "', name FROM chk WHERE name IN (SELECT name FROM vis WHERE fld = '"
                       WS-SM "')" DELIMITED BY SIZE INTO WS-SQL
                   MOVE DB-1::Execute(WS-SQL) TO WS-N
           END-EVALUATE
           CALL "SM-TICKS"
           CALL "SM-INFO"
           CALL "SM-CAPTIONS"
]]></Event>
    <Event name="SM-SET-ALL" paragraph="SM-SET-ALL"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-SM = "N"
               MOVE 1 TO WS-ALL-N
           ELSE
               MOVE 1 TO WS-ALL-C
           END-IF
]]></Event>
    <Event name="SM-CLR-ALL" paragraph="SM-CLR-ALL"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-SM = "N"
               MOVE 0 TO WS-ALL-N
           ELSE
               MOVE 0 TO WS-ALL-C
           END-IF
]]></Event>
    <Event name="SM-CLEAR-PICKS" paragraph="SM-CLEAR-PICKS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "SM-CLR-ALL"
           MOVE SPACES TO WS-SQL
           STRING "DELETE FROM pick WHERE fld = '" WS-SM "'" DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Execute(WS-SQL) TO WS-N
           CALL "SM-TICKS"
           CALL "SM-INFO"
           CALL "SM-CAPTIONS"
]]></Event>
    <Event name="SM-RESET" paragraph="SM-RESET"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE DB-1::Execute("DELETE FROM pick") TO WS-N
           MOVE DB-1::Execute("DELETE FROM vis") TO WS-N
           MOVE 0 TO WS-ALL-N
           MOVE 0 TO WS-ALL-C
           CALL "SM-CAPTIONS"
]]></Event>
    <Event name="NAME-CLAUSE" paragraph="NAME-CLAUSE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-K1 PIC 9(9).
       PROCEDURE DIVISION.
           MOVE TXT-NOME::Text TO WS-TERM
           CALL "NORM-TERM"
           MOVE 0 TO WS-K1
           IF WS-ALL-N = 0
               MOVE "SELECT COUNT(*) FROM pick WHERE fld = 'N'" TO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               MOVE DB-1::Fetch() TO WS-ROW
               COMPUTE WS-K1 = FUNCTION NUMVAL(WS-ROW)
           END-IF
           IF WS-K1 > 0
               STRING " AND nome IN (SELECT name FROM pick WHERE fld = 'N')" DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
           ELSE
               IF WS-TERM NOT = SPACES
                   STRING " AND nome_key LIKE '" FUNCTION TRIM(WS-PAT) "'" DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
               END-IF
           END-IF
]]></Event>
    <Event name="CAT-CLAUSE" paragraph="CAT-CLAUSE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-K2 PIC 9(9).
       PROCEDURE DIVISION.
           MOVE TXT-CAT::Text TO WS-TERM
           CALL "NORM-TERM"
           MOVE 0 TO WS-K2
           IF WS-ALL-C = 0
               MOVE "SELECT COUNT(*) FROM pick WHERE fld = 'C'" TO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               MOVE DB-1::Fetch() TO WS-ROW
               COMPUTE WS-K2 = FUNCTION NUMVAL(WS-ROW)
           END-IF
           IF WS-K2 > 0
               STRING " AND nivel1 IN (SELECT name FROM pick WHERE fld = 'C')" DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
           ELSE
               IF WS-TERM NOT = SPACES
                   STRING " AND nivel1 IN (SELECT name FROM vis WHERE fld = 'C')" DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
               END-IF
           END-IF
]]></Event>
    <Event name="BUILD-WHERE" paragraph="BUILD-WHERE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-DT1  PIC X(10).
       01 WS-DT2  PIC X(10).
       01 WS-V1   PIC 9(9).
       01 WS-V2   PIC 9(9).
       01 WS-X1   PIC Z(14)9.
       01 WS-X2   PIC Z(14)9.
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-WHERE
           MOVE 1 TO WS-P
           STRING "WHERE 1=1" DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
           CALL "NAME-CLAUSE"
           CALL "CAT-CLAUSE"
           MOVE DTP-INI::Value TO WS-DT1
           MOVE DTP-FIM::Value TO WS-DT2
           IF WS-DT1 NOT = SPACES AND WS-DT2 NOT = SPACES
               IF WS-DT1 NOT = "1970-01-01" OR WS-DT2 NOT = "2027-12-31"
                   STRING " AND inicio >= '" WS-DT1 "' AND inicio <= '" WS-DT2 "'"
                       DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
               END-IF
           END-IF
           MOVE NUD-PL1::Value TO WS-V1
           MOVE NUD-PL2::Value TO WS-V2
           IF WS-V1 > 0 OR WS-V2 < 300000
               COMPUTE WS-X1 = WS-V1 * 1000000
               COMPUTE WS-X2 = WS-V2 * 1000000
               STRING " AND pl >= " FUNCTION TRIM(WS-X1) " AND pl <= " FUNCTION TRIM(WS-X2)
                   DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
           END-IF
           MOVE LST-N2::CheckedItems TO WS-CHK
           CALL "MAKE-IN-LIST"
           IF WS-IN NOT = SPACES
               STRING " AND nivel2 IN (" FUNCTION TRIM(WS-IN) ")"
                   DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
           END-IF
           MOVE LST-N3::CheckedItems TO WS-CHK
           CALL "MAKE-IN-LIST"
           IF WS-IN NOT = SPACES
               STRING " AND nivel3 IN (" FUNCTION TRIM(WS-IN) ")"
                   DELIMITED BY SIZE INTO WS-WHERE WITH POINTER WS-P
           END-IF
]]></Event>
    <Event name="Q-TOTALS" paragraph="Q-TOTALS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1 PIC X(40).
       01 WS-C2 PIC X(40).
       01 WS-C3 PIC X(40).
       01 WS-C4 PIC X(40).
       01 WS-C5 PIC X(40).
       01 WS-C6 PIC X(40).
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-SQL
           STRING "SELECT COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0), COUNT(pl), "
                  "COALESCE(MAX(pl),0), COALESCE(MAX(ano),0) FROM fundos " FUNCTION TRIM(WS-WHERE)
               DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           MOVE DB-1::Fetch() TO WS-ROW
           UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5 WS-C6
           COMPUTE WS-T-CNT  = FUNCTION NUMVAL(WS-C1)
           COMPUTE WS-T-PL   = FUNCTION NUMVAL(WS-C2)
           COMPUTE WS-T-COT  = FUNCTION NUMVAL(WS-C3)
           COMPUTE WS-T-PLN  = FUNCTION NUMVAL(WS-C4)
           COMPUTE WS-T-MAX  = FUNCTION NUMVAL(WS-C5)
           COMPUTE WS-T-YMAX = FUNCTION NUMVAL(WS-C6)
           MOVE 0 TO WS-T-CLS
           MOVE 0 TO WS-T-SUB
           MOVE SPACES TO WS-SQL
           STRING "SELECT estrutura, COALESCE(SUM(pl),0) FROM fundos " FUNCTION TRIM(WS-WHERE)
                  " GROUP BY estrutura"
               DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
               IF WS-C1 = "Classe"
                   COMPUTE WS-T-CLS = FUNCTION NUMVAL(WS-C2)
               ELSE
                   COMPUTE WS-T-SUB = FUNCTION NUMVAL(WS-C2)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-CATS" paragraph="Q-CATS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1 PIC X(40).
       01 WS-C2 PIC X(40).
       01 WS-C3 PIC X(40).
       01 WS-C4 PIC X(40).
       01 WS-I  PIC 99.
       PROCEDURE DIVISION.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               MOVE 0 TO WS-CAT-CNT(WS-I)
               MOVE 0 TO WS-CAT-PL(WS-I)
               MOVE 0 TO WS-CAT-COT(WS-I)
               MOVE 0 TO WS-CAT-USED(WS-I)
           END-PERFORM
           MOVE SPACES TO WS-SQL
           STRING "SELECT nivel1, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
                  FUNCTION TRIM(WS-WHERE) " AND nivel1 IS NOT NULL GROUP BY nivel1"
               DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF WS-CAT-NAME(WS-I) = WS-C1
                       COMPUTE WS-CAT-CNT(WS-I) = FUNCTION NUMVAL(WS-C2)
                       COMPUTE WS-CAT-PL(WS-I)  = FUNCTION NUMVAL(WS-C3)
                       COMPUTE WS-CAT-COT(WS-I) = FUNCTION NUMVAL(WS-C4)
                   END-IF
               END-PERFORM
           END-PERFORM
]]></Event>
    <Event name="Q-N2" paragraph="Q-N2"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1 PIC X(40).
       01 WS-C2 PIC X(40).
       01 WS-I  PIC 99.
       01 WS-V  PIC 9(9).
       PROCEDURE DIVISION.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               MOVE SPACES TO WS-N2-NAME(WS-I)
               MOVE 0 TO WS-N2-CNT(WS-I)
           END-PERFORM
           MOVE 0 TO WS-N2-TOTAL
           MOVE 0 TO WS-I
           MOVE SPACES TO WS-SQL
           STRING "SELECT nivel2, COUNT(*) FROM fundos " FUNCTION TRIM(WS-WHERE)
                  " AND nivel2 IS NOT NULL GROUP BY nivel2 ORDER BY 2 DESC"
               DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
               COMPUTE WS-V = FUNCTION NUMVAL(WS-C2)
               ADD WS-V TO WS-N2-TOTAL
               IF WS-I < 9
                   ADD 1 TO WS-I
                   MOVE WS-C1 TO WS-N2-NAME(WS-I)
                   MOVE WS-V TO WS-N2-CNT(WS-I)
               ELSE
                   MOVE "Outros" TO WS-N2-NAME(10)
                   ADD WS-V TO WS-N2-CNT(10)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-BINS" paragraph="Q-BINS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1 PIC X(40).
       01 WS-C2 PIC X(40).
       01 WS-I  PIC 99.
       PROCEDURE DIVISION.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
               MOVE 0 TO WS-BIN-CNT(WS-I)
           END-PERFORM
           MOVE SPACES TO WS-SQL
           STRING "SELECT CASE WHEN pl < 1000000 THEN 1 WHEN pl < 10000000 THEN 2 "
                  "WHEN pl < 100000000 THEN 3 WHEN pl < 1000000000 THEN 4 ELSE 5 END, COUNT(*) FROM fundos "
                  FUNCTION TRIM(WS-WHERE) " AND pl IS NOT NULL GROUP BY 1"
               DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
               COMPUTE WS-I = FUNCTION NUMVAL(WS-C1)
               IF WS-I >= 1 AND WS-I <= 5
                   COMPUTE WS-BIN-CNT(WS-I) = FUNCTION NUMVAL(WS-C2)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-TOP" paragraph="Q-TOP"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1 PIC X(200).
       01 WS-C2 PIC X(40).
       01 WS-I  PIC 99.
       PROCEDURE DIVISION.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
               MOVE SPACES TO WS-TOP-NAME(WS-I)
               MOVE 0 TO WS-TOP-PL(WS-I)
           END-PERFORM
           MOVE 0 TO WS-TOP-N
           MOVE SPACES TO WS-SQL
           STRING "SELECT COALESCE(nome,codigo), pl FROM fundos " FUNCTION TRIM(WS-WHERE)
                  " AND pl IS NOT NULL ORDER BY pl DESC LIMIT 4"
               DELIMITED BY SIZE INTO WS-SQL
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               IF WS-TOP-N < 4
                   ADD 1 TO WS-TOP-N
                   UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2
                   MOVE WS-C1 TO WS-TOP-NAME(WS-TOP-N)
                   COMPUTE WS-TOP-PL(WS-TOP-N) = FUNCTION NUMVAL(WS-C2)
               END-IF
           END-PERFORM
]]></Event>
    <Event name="Q-YEARS" paragraph="Q-YEARS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-C1 PIC X(40).
       01 WS-C2 PIC X(40).
       01 WS-C3 PIC X(40).
       01 WS-C4 PIC X(40).
       01 WS-C5 PIC X(40).
       01 WS-I  PIC 99.
       01 WS-J  PIC 99.
       01 WS-K  PIC 99.
       01 WS-Y  PIC 9(4).
       01 WS-BEST PIC 9(9).
       01 WS-BI   PIC 99.
       01 WS-LIST PIC X(300).
       01 WS-LP   PIC 9(4).
       PROCEDURE DIVISION.
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
                   MOVE 0 TO WS-TOP3-IDX(WS-I)
               END-PERFORM
               PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   MOVE 0 TO WS-BI
                   MOVE 0 TO WS-BEST
                   PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       IF WS-CAT-CNT(WS-I) > WS-BEST AND WS-CAT-USED(WS-I) = 0
                           MOVE WS-CAT-CNT(WS-I) TO WS-BEST
                           MOVE WS-I TO WS-BI
                       END-IF
                   END-PERFORM
                   IF WS-BI > 0
                       MOVE WS-BI TO WS-TOP3-IDX(WS-K)
                       MOVE 1 TO WS-CAT-USED(WS-BI)
                   END-IF
               END-PERFORM
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
                   MOVE 0 TO WS-CAT-USED(WS-I)
               END-PERFORM
               MOVE SPACES TO WS-LIST
               MOVE 1 TO WS-LP
               PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   IF WS-TOP3-IDX(WS-K) > 0
                       IF WS-LP > 1
                           STRING "," DELIMITED BY SIZE INTO WS-LIST WITH POINTER WS-LP
                       END-IF
                       STRING "'" FUNCTION TRIM(WS-CAT-NAME(WS-TOP3-IDX(WS-K))) "'"
                           DELIMITED BY SIZE INTO WS-LIST WITH POINTER WS-LP
                   END-IF
               END-PERFORM
               IF WS-LIST = SPACES
                   MOVE "''" TO WS-LIST
               END-IF
               IF WS-T-YMAX > 0
                   COMPUTE WS-YR-MIN = WS-T-YMAX - 11
               ELSE
                   MOVE 2015 TO WS-YR-MIN
               END-IF
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
                   COMPUTE WS-YR-NUM(WS-I) = WS-YR-MIN + WS-I - 1
                   MOVE 0 TO WS-YA-CNT(WS-I)
                   MOVE 0 TO WS-YA-PL(WS-I)
                   MOVE 0 TO WS-YA-COT(WS-I)
                   PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                       MOVE 0 TO WS-YS-CNT(WS-I, WS-K)
                       MOVE 0 TO WS-YS-PL(WS-I, WS-K)
                       MOVE 0 TO WS-YS-COT(WS-I, WS-K)
                   END-PERFORM
               END-PERFORM
               MOVE 0 TO WS-OA-CNT
               MOVE 0 TO WS-OA-PL
               MOVE 0 TO WS-OA-COT
               PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   MOVE 0 TO WS-OS-CNT(WS-K)
                   MOVE 0 TO WS-OS-PL(WS-K)
                   MOVE 0 TO WS-OS-COT(WS-K)
               END-PERFORM
               MOVE WS-YR-MIN TO WS-Y
           *>  all categories, per year in the window
               MOVE SPACES TO WS-SQL
               STRING "SELECT ano, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
                      FUNCTION TRIM(WS-WHERE) " AND ano >= " WS-Y " GROUP BY ano"
                   DELIMITED BY SIZE INTO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               PERFORM UNTIL 1 = 2
                   MOVE DB-1::Fetch() TO WS-ROW
                   IF WS-ROW = SPACES
                       EXIT PERFORM
                   END-IF
                   UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4
                   COMPUTE WS-Y = FUNCTION NUMVAL(WS-C1)
                   COMPUTE WS-I = WS-Y - WS-YR-MIN + 1
                   IF WS-I >= 1 AND WS-I <= 12
                       COMPUTE WS-YA-CNT(WS-I) = FUNCTION NUMVAL(WS-C2)
                       COMPUTE WS-YA-PL(WS-I)  = FUNCTION NUMVAL(WS-C3)
                       COMPUTE WS-YA-COT(WS-I) = FUNCTION NUMVAL(WS-C4)
                   END-IF
               END-PERFORM
           *>  all categories, before the window
               MOVE WS-YR-MIN TO WS-Y
               MOVE SPACES TO WS-SQL
               STRING "SELECT COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
                      FUNCTION TRIM(WS-WHERE) " AND ano < " WS-Y
                   DELIMITED BY SIZE INTO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               MOVE DB-1::Fetch() TO WS-ROW
               UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3
               COMPUTE WS-OA-CNT = FUNCTION NUMVAL(WS-C1)
               COMPUTE WS-OA-PL  = FUNCTION NUMVAL(WS-C2)
               COMPUTE WS-OA-COT = FUNCTION NUMVAL(WS-C3)
           *>  the three leading categories, per year in the window
               MOVE SPACES TO WS-SQL
               STRING "SELECT ano, nivel1, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
                      FUNCTION TRIM(WS-WHERE) " AND ano >= " WS-Y " AND nivel1 IN (" FUNCTION TRIM(WS-LIST)
                      ") GROUP BY ano, nivel1"
                   DELIMITED BY SIZE INTO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               PERFORM UNTIL 1 = 2
                   MOVE DB-1::Fetch() TO WS-ROW
                   IF WS-ROW = SPACES
                       EXIT PERFORM
                   END-IF
                   UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4 WS-C5
                   COMPUTE WS-Y = FUNCTION NUMVAL(WS-C1)
                   COMPUTE WS-I = WS-Y - WS-YR-MIN + 1
                   PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                       IF WS-TOP3-IDX(WS-K) > 0
                           IF WS-CAT-NAME(WS-TOP3-IDX(WS-K)) = WS-C2 AND WS-I >= 1 AND WS-I <= 12
                               COMPUTE WS-YS-CNT(WS-I, WS-K) = FUNCTION NUMVAL(WS-C3)
                               COMPUTE WS-YS-PL(WS-I, WS-K)  = FUNCTION NUMVAL(WS-C4)
                               COMPUTE WS-YS-COT(WS-I, WS-K) = FUNCTION NUMVAL(WS-C5)
                           END-IF
                       END-IF
                   END-PERFORM
               END-PERFORM
           *>  the three leading categories, before the window
               MOVE WS-YR-MIN TO WS-Y
               MOVE SPACES TO WS-SQL
               STRING "SELECT nivel1, COUNT(*), COALESCE(SUM(pl),0), COALESCE(SUM(cotistas),0) FROM fundos "
                      FUNCTION TRIM(WS-WHERE) " AND ano < " WS-Y " AND nivel1 IN (" FUNCTION TRIM(WS-LIST)
                      ") GROUP BY nivel1"
                   DELIMITED BY SIZE INTO WS-SQL
               MOVE DB-1::Query(WS-SQL) TO WS-N
               PERFORM UNTIL 1 = 2
                   MOVE DB-1::Fetch() TO WS-ROW
                   IF WS-ROW = SPACES
                       EXIT PERFORM
                   END-IF
                   UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3 WS-C4
                   PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                       IF WS-TOP3-IDX(WS-K) > 0
                           IF WS-CAT-NAME(WS-TOP3-IDX(WS-K)) = WS-C1
                               COMPUTE WS-OS-CNT(WS-K) = FUNCTION NUMVAL(WS-C2)
                               COMPUTE WS-OS-PL(WS-K)  = FUNCTION NUMVAL(WS-C3)
                               COMPUTE WS-OS-COT(WS-K) = FUNCTION NUMVAL(WS-C4)
                           END-IF
                       END-IF
                   END-PERFORM
               END-PERFORM
]]></Event>
    <Event name="Q-GRID" paragraph="Q-GRID"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-ORD  PIC X(60).
       01 WS-OFFS PIC 9(9).
       01 WS-LIM  PIC 9(4).
       01 WS-I    PIC 9(5).
       01 WS-SEL  PIC X(40).
       PROCEDURE DIVISION.
           MOVE CMB-ORDER::Value TO WS-SEL
           EVALUATE TRUE
               WHEN WS-SEL(1:6) = "Maior "
                   MOVE "pl IS NULL, pl DESC" TO WS-ORD
               WHEN WS-SEL(1:5) = "Mais "
                   IF WS-SEL(1:9) = "Mais coti"
                       MOVE "cotistas IS NULL, cotistas DESC" TO WS-ORD
                   ELSE
                       IF WS-SEL(1:9) = "Mais rece"
                           MOVE "inicio IS NULL, inicio DESC" TO WS-ORD
                       ELSE
                           MOVE "inicio IS NULL, inicio ASC" TO WS-ORD
                       END-IF
                   END-IF
               WHEN OTHER
                   MOVE "nome_key ASC" TO WS-ORD
           END-EVALUATE
           IF WS-T-CNT = 0
               MOVE 1 TO WS-PAGES
           ELSE
               COMPUTE WS-PAGES = (WS-T-CNT + WS-PSIZE - 1) / WS-PSIZE
           END-IF
           IF WS-PAGE > WS-PAGES
               MOVE WS-PAGES TO WS-PAGE
           END-IF
           IF WS-PAGE < 1
               MOVE 1 TO WS-PAGE
           END-IF
           COMPUTE WS-OFFS = (WS-PAGE - 1) * WS-PSIZE
           MOVE WS-PSIZE TO WS-LIM
           MOVE SPACES TO WS-SQL
           STRING "SELECT COALESCE(nome,''), codigo, COALESCE(estrutura,''), COALESCE(nivel1,''), "
                  "COALESCE(nivel2,''), COALESCE(nivel3,''), COALESCE(strftime('%d/%m/%Y', inicio),''), "
                  "COALESCE(printf('%.2f', pl/1000000.0),''), COALESCE(cotistas,''), "
                  "COALESCE(printf('%.4f', cota),''), COALESCE(foco,''), COALESCE(cnpj_classe,''), "
                  "COALESCE(cnpj_fundo,''), COALESCE(status,''), COALESCE(subclasses,''), "
                  "COALESCE(strftime('%d/%m/%Y', data_ref),'') FROM fundos "
                  FUNCTION TRIM(WS-WHERE) " ORDER BY " FUNCTION TRIM(WS-ORD)
                  " LIMIT " WS-LIM " OFFSET " WS-OFFS
               DELIMITED BY SIZE INTO WS-SQL
           INVOKE GRD-FUNDOS::ClearRows()
           MOVE DB-1::Query(WS-SQL) TO WS-N
           PERFORM UNTIL 1 = 2
               MOVE DB-1::Fetch() TO WS-ROW
               IF WS-ROW = SPACES
                   EXIT PERFORM
               END-IF
               INVOKE GRD-FUNDOS::AddRow(FUNCTION TRIM(WS-ROW))
           END-PERFORM
]]></Event>
    <Event name="SORT-CATS" paragraph="SORT-CATS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-I    PIC 99.
       01 WS-K    PIC 99.
       01 WS-BI   PIC 99.
       01 WS-BEST PIC 9(15)V99.
       PROCEDURE DIVISION.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               MOVE 0 TO WS-CAT-USED(WS-I)
               MOVE 0 TO WS-RANK(WS-I)
           END-PERFORM
           PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 10
               MOVE 0 TO WS-BI
               MOVE 0 TO WS-BEST
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   IF WS-CAT-PL(WS-I) > WS-BEST AND WS-CAT-USED(WS-I) = 0
                       MOVE WS-CAT-PL(WS-I) TO WS-BEST
                       MOVE WS-I TO WS-BI
                   END-IF
               END-PERFORM
               IF WS-BI > 0
                   MOVE WS-BI TO WS-RANK(WS-K)
                   MOVE 1 TO WS-CAT-USED(WS-BI)
               END-IF
           END-PERFORM
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
               MOVE 0 TO WS-CAT-USED(WS-I)
           END-PERFORM
]]></Event>
    <Event name="PAINT-KPIS" paragraph="PAINT-KPIS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TXT  PIC X(120).
       01 WS-PCT  PIC 9(3)V9.
       01 WS-AVG  PIC 9(15)V99.
       01 WS-PCTI PIC 9(3).
       01 WS-A    PIC X(24).
       PROCEDURE DIVISION.
           MOVE WS-T-PL TO WS-FV
           CALL "FMT-SHORT"
           MOVE SPACES TO WS-TXT
           STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-KPI-V::Caption
           MOVE WS-T-CNT TO WS-FC
           CALL "FMT-COUNT"
           MOVE WS-FT TO WS-A
           MOVE WS-T-COT TO WS-FV
           CALL "FMT-SHORTN"
           MOVE SPACES TO WS-TXT
           STRING FUNCTION TRIM(WS-A) " fundo(s)  |  " FUNCTION TRIM(WS-FT) " cotistas"
               DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-KPI-C::Caption
           IF WS-UNIV > 0
               COMPUTE WS-PCT = WS-T-CNT * 100 / WS-UNIV
           ELSE
               MOVE 0 TO WS-PCT
           END-IF
           COMPUTE WS-PCTI = WS-PCT
           INVOKE GAU-UNIV::SetValue(WS-PCTI)
           IF WS-T-PLN > 0
               COMPUTE WS-AVG = WS-T-PL / WS-T-PLN
           ELSE
               MOVE 0 TO WS-AVG
           END-IF
           MOVE WS-AVG TO WS-FV
           CALL "FMT-SHORT"
           MOVE SPACES TO WS-TXT
           STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-AVG-V::Caption
           MOVE WS-T-MAX TO WS-FV
           CALL "FMT-SHORT"
           MOVE SPACES TO WS-TXT
           STRING "PL médio por fundo  |  maior: R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-KPI-F::Caption
]]></Event>
    <Event name="PAINT-RADAR" paragraph="PAINT-RADAR"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-I    PIC 99.
       01 WS-J    PIC 99.
       01 WS-K    PIC 9.
       01 WS-NM   PIC 9.
       01 WS-NSEL PIC 9(9).
       01 WS-MX   PIC 9(15)V99.
       01 WS-MC   PIC 9(15)V99.
       01 WS-MP   PIC 9(15)V99.
       01 WS-MK   PIC 9(15)V99.
       01 WS-V1   PIC 9(3)V99.
       01 WS-V2   PIC 9(3)V99.
       01 WS-V3   PIC 9(3)V99.
       01 WS-RV-TAB.
          05 WS-RVK OCCURS 3.
             10 WS-RV PIC 9(9) OCCURS 10.
       01 WS-RN-TAB.
          05 WS-RN PIC X(160) OCCURS 3.
       01 WS-C1   PIC X(160).
       01 WS-C2   PIC X(60).
       01 WS-C3   PIC X(30).
       01 WS-W1   PIC X(60).
       01 WS-W2   PIC X(60).
       01 WS-LB   PIC X(200).
       01 WS-LP   PIC 9(4).
       PROCEDURE DIVISION.
               MOVE 0 TO WS-NSEL
               IF WS-ALL-N = 0
                   MOVE "SELECT COUNT(*) FROM pick WHERE fld = 'N'" TO WS-SQL
                   MOVE DB-1::Query(WS-SQL) TO WS-N
                   MOVE DB-1::Fetch() TO WS-ROW
                   COMPUTE WS-NSEL = FUNCTION NUMVAL(WS-ROW)
               END-IF
               INVOKE CH-RADAR::Clear()
               IF WS-NSEL = 2 OR WS-NSEL = 3
           *>      --- one polygon per company
                   PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                       MOVE SPACES TO WS-RN(WS-K)
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
                           MOVE 0 TO WS-RV(WS-K, WS-I)
                       END-PERFORM
                   END-PERFORM
                   MOVE 0 TO WS-NM
                   MOVE "SELECT name FROM pick WHERE fld = 'N' ORDER BY name" TO WS-SQL
                   MOVE DB-1::Query(WS-SQL) TO WS-N
                   PERFORM UNTIL 1 = 2
                       MOVE DB-1::Fetch() TO WS-ROW
                       IF WS-ROW = SPACES
                           EXIT PERFORM
                       END-IF
                       IF WS-NM < 3
                           ADD 1 TO WS-NM
                           MOVE WS-ROW TO WS-RN(WS-NM)
                       END-IF
                   END-PERFORM
                   MOVE SPACES TO WS-SQL
                   STRING "SELECT nome, nivel1, COUNT(*) FROM fundos " FUNCTION TRIM(WS-WHERE)
                          " AND nivel1 IS NOT NULL GROUP BY nome, nivel1"
                       DELIMITED BY SIZE INTO WS-SQL
                   MOVE DB-1::Query(WS-SQL) TO WS-N
                   PERFORM UNTIL 1 = 2
                       MOVE DB-1::Fetch() TO WS-ROW
                       IF WS-ROW = SPACES
                           EXIT PERFORM
                       END-IF
                       UNSTRING WS-ROW DELIMITED BY X"09" INTO WS-C1 WS-C2 WS-C3
                       PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                           IF WS-RN(WS-K) = WS-C1
                               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                                   IF WS-CAT-NAME(WS-I) = WS-C2
                                       COMPUTE WS-RV(WS-K, WS-I) = FUNCTION NUMVAL(WS-C3)
                                   END-IF
                               END-PERFORM
                           END-IF
                       END-PERFORM
                   END-PERFORM
                   MOVE 0 TO WS-MX
                   PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                           IF WS-RV(WS-K, WS-I) > WS-MX
                               MOVE WS-RV(WS-K, WS-I) TO WS-MX
                           END-IF
                       END-PERFORM
                   END-PERFORM
                   PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                       MOVE 0 TO WS-V1
                       MOVE 0 TO WS-V2
                       MOVE 0 TO WS-V3
                       IF WS-MX > 0
                           COMPUTE WS-V1 = WS-RV(1, WS-I) * 100 / WS-MX
                           COMPUTE WS-V2 = WS-RV(2, WS-I) * 100 / WS-MX
                           IF WS-NM = 3
                               COMPUTE WS-V3 = WS-RV(3, WS-I) * 100 / WS-MX
                           END-IF
                       END-IF
                       IF WS-NM = 3
                           INVOKE CH-RADAR::AddPoint(FUNCTION TRIM(WS-CAT-NAME(WS-I)), WS-V1, WS-V2, WS-V3)
                       ELSE
                           INVOKE CH-RADAR::AddPoint(FUNCTION TRIM(WS-CAT-NAME(WS-I)), WS-V1, WS-V2)
                       END-IF
                   END-PERFORM
           *>      the legend: the first two words of each name
                   MOVE SPACES TO WS-LB
                   MOVE 1 TO WS-LP
                   PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NM
                       MOVE SPACES TO WS-W1
                       MOVE SPACES TO WS-W2
                       UNSTRING WS-RN(WS-K) DELIMITED BY SPACE INTO WS-W1 WS-W2
                       INSPECT WS-W1 REPLACING ALL "," BY " "
                       INSPECT WS-W2 REPLACING ALL "," BY " "
                       IF WS-K > 1
                           STRING "," DELIMITED BY SIZE INTO WS-LB WITH POINTER WS-LP
                       END-IF
                       STRING FUNCTION TRIM(WS-W1) " " FUNCTION TRIM(WS-W2) DELIMITED BY SIZE INTO WS-LB WITH POINTER WS-LP
                   END-PERFORM
                   MOVE WS-LB TO CH-RADAR::SeriesLabels
                   IF WS-NM = 3
                       MOVE "#22C3D6,#C2257A,#394670" TO CH-RADAR::SeriesColors
                   ELSE
                       MOVE "#22C3D6,#C2257A" TO CH-RADAR::SeriesColors
                   END-IF
                   MOVE 1 TO CH-RADAR::ShowLegend
                   MOVE "nº de fundos por categoria (100 = maior)" TO LBL-RAD-S::Caption
               ELSE
                   IF WS-NSEL = 1
           *>          --- ONE company: its three series, each indexed to its own largest category
                       MOVE 0 TO WS-MC
                       MOVE 0 TO WS-MP
                       MOVE 0 TO WS-MK
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                           IF WS-CAT-CNT(WS-I) > WS-MC
                               MOVE WS-CAT-CNT(WS-I) TO WS-MC
                           END-IF
                           IF WS-CAT-PL(WS-I) > WS-MP
                               MOVE WS-CAT-PL(WS-I) TO WS-MP
                           END-IF
                           IF WS-CAT-COT(WS-I) > WS-MK
                               MOVE WS-CAT-COT(WS-I) TO WS-MK
                           END-IF
                       END-PERFORM
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                           MOVE 0 TO WS-V1
                           MOVE 0 TO WS-V2
                           MOVE 0 TO WS-V3
                           IF WS-MC > 0
                               COMPUTE WS-V1 = WS-CAT-CNT(WS-I) * 100 / WS-MC
                           END-IF
                           IF WS-MP > 0
                               COMPUTE WS-V2 = WS-CAT-PL(WS-I) * 100 / WS-MP
                           END-IF
                           IF WS-MK > 0
                               COMPUTE WS-V3 = WS-CAT-COT(WS-I) * 100 / WS-MK
                           END-IF
                           INVOKE CH-RADAR::AddPoint(FUNCTION TRIM(WS-CAT-NAME(WS-I)), WS-V1, WS-V2, WS-V3)
                       END-PERFORM
                       MOVE "Fundos,PL,Cotistas" TO CH-RADAR::SeriesLabels
                       MOVE "#22C3D6,#3E7BE8,#394670" TO CH-RADAR::SeriesColors
                       MOVE 1 TO CH-RADAR::ShowLegend
                       MOVE "1 empresa: fundos, PL e cotistas (100 = maior)" TO LBL-RAD-S::Caption
                   ELSE
           *>          --- everyone (or more than three picked): ONE polygon, one colour, the most popular categories
                       MOVE 0 TO WS-MC
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                           IF WS-CAT-CNT(WS-I) > WS-MC
                               MOVE WS-CAT-CNT(WS-I) TO WS-MC
                           END-IF
                       END-PERFORM
                       PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                           MOVE 0 TO WS-V1
                           IF WS-MC > 0
                               COMPUTE WS-V1 = WS-CAT-CNT(WS-I) * 100 / WS-MC
                           END-IF
                           INVOKE CH-RADAR::AddPoint(FUNCTION TRIM(WS-CAT-NAME(WS-I)), WS-V1)
                       END-PERFORM
                       MOVE "Fundos" TO CH-RADAR::SeriesLabels
                       MOVE "#22C3D6" TO CH-RADAR::SeriesColors
                       MOVE 0 TO CH-RADAR::ShowLegend
                       MOVE "categorias mais populares · nº de fundos (100 = líder)" TO LBL-RAD-S::Caption
                   END-IF
               END-IF
]]></Event>
    <Event name="PAINT-CHARTS" paragraph="PAINT-CHARTS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-I    PIC 99.
       01 WS-R    PIC 99.
       01 WS-SC   PIC 9(15)V99.
       01 WS-SP   PIC 9(15)V99.
       01 WS-SK   PIC 9(15)V99.
       01 WS-MC   PIC 9(15)V99.
       01 WS-MP   PIC 9(15)V99.
       01 WS-MK   PIC 9(15)V99.
       01 WS-V1   PIC 9(3)V99.
       01 WS-V2   PIC 9(3)V99.
       01 WS-V3   PIC 9(3)V99.
       01 WS-VB   PIC 9(9)V99.
       01 WS-TXT  PIC X(120).
       01 WS-LB   PIC X(12).
       PROCEDURE DIVISION.
               MOVE 0 TO WS-SC
               MOVE 0 TO WS-SP
               MOVE 0 TO WS-SK
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   ADD WS-CAT-CNT(WS-I) TO WS-SC
                   ADD WS-CAT-PL(WS-I)  TO WS-SP
                   ADD WS-CAT-COT(WS-I) TO WS-SK
               END-PERFORM
               CALL "PAINT-RADAR"
           *>  donut 1: PL (R$ billions) per category
               INVOKE CH-DONUT1::Clear()
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CATCNT
                   COMPUTE WS-VB = WS-CAT-PL(WS-I) / 1000000000
                   INVOKE CH-DONUT1::AddPoint(FUNCTION TRIM(WS-CAT-NAME(WS-I)), WS-VB)
               END-PERFORM
               MOVE WS-SP TO WS-FV
               CALL "FMT-SHORT"
               MOVE WS-FT TO LBL-D1-C::Caption
               IF WS-RANK(1) > 0
                   MOVE WS-RANK(1) TO WS-R
                   MOVE WS-CAT-NAME(WS-R) TO LBL-L1-1-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-SP > 0
                       COMPUTE WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L1-1-P::Caption
                   MOVE WS-CAT-PL(WS-R) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-L1-1-V::Caption
                   MOVE WS-COLOR(WS-R) TO SHP-L1-1::FillColor
               ELSE
                   MOVE SPACES TO LBL-L1-1-N::Caption
                   MOVE SPACES TO LBL-L1-1-P::Caption
                   MOVE SPACES TO LBL-L1-1-V::Caption
                   MOVE "#00000000" TO SHP-L1-1::FillColor
               END-IF
               IF WS-RANK(2) > 0
                   MOVE WS-RANK(2) TO WS-R
                   MOVE WS-CAT-NAME(WS-R) TO LBL-L1-2-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-SP > 0
                       COMPUTE WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L1-2-P::Caption
                   MOVE WS-CAT-PL(WS-R) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-L1-2-V::Caption
                   MOVE WS-COLOR(WS-R) TO SHP-L1-2::FillColor
               ELSE
                   MOVE SPACES TO LBL-L1-2-N::Caption
                   MOVE SPACES TO LBL-L1-2-P::Caption
                   MOVE SPACES TO LBL-L1-2-V::Caption
                   MOVE "#00000000" TO SHP-L1-2::FillColor
               END-IF
               IF WS-RANK(3) > 0
                   MOVE WS-RANK(3) TO WS-R
                   MOVE WS-CAT-NAME(WS-R) TO LBL-L1-3-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-SP > 0
                       COMPUTE WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L1-3-P::Caption
                   MOVE WS-CAT-PL(WS-R) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-L1-3-V::Caption
                   MOVE WS-COLOR(WS-R) TO SHP-L1-3::FillColor
               ELSE
                   MOVE SPACES TO LBL-L1-3-N::Caption
                   MOVE SPACES TO LBL-L1-3-P::Caption
                   MOVE SPACES TO LBL-L1-3-V::Caption
                   MOVE "#00000000" TO SHP-L1-3::FillColor
               END-IF
               IF WS-RANK(4) > 0
                   MOVE WS-RANK(4) TO WS-R
                   MOVE WS-CAT-NAME(WS-R) TO LBL-L1-4-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-SP > 0
                       COMPUTE WS-FP = WS-CAT-PL(WS-R) * 100 / WS-SP
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L1-4-P::Caption
                   MOVE WS-CAT-PL(WS-R) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-L1-4-V::Caption
                   MOVE WS-COLOR(WS-R) TO SHP-L1-4::FillColor
               ELSE
                   MOVE SPACES TO LBL-L1-4-N::Caption
                   MOVE SPACES TO LBL-L1-4-P::Caption
                   MOVE SPACES TO LBL-L1-4-V::Caption
                   MOVE "#00000000" TO SHP-L1-4::FillColor
               END-IF
           *>  donut 2: funds per level-2 category (top 9 + the rest)
               INVOKE CH-DONUT2::Clear()
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
                   IF WS-N2-NAME(WS-I) NOT = SPACES
                       INVOKE CH-DONUT2::AddPoint(FUNCTION TRIM(WS-N2-NAME(WS-I)), WS-N2-CNT(WS-I))
                   END-IF
               END-PERFORM
               MOVE WS-N2-TOTAL TO WS-FC
               CALL "FMT-COUNT"
               MOVE WS-FT TO LBL-D2-C::Caption
               IF WS-N2-NAME(1) NOT = SPACES
                   MOVE WS-N2-NAME(1) TO LBL-L2-1-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-N2-TOTAL > 0
                       COMPUTE WS-FP = WS-N2-CNT(1) * 100 / WS-N2-TOTAL
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L2-1-P::Caption
                   MOVE WS-N2-CNT(1) TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-L2-1-V::Caption
                   MOVE WS-COLOR(1) TO SHP-L2-1::FillColor
               ELSE
                   MOVE SPACES TO LBL-L2-1-N::Caption
                   MOVE SPACES TO LBL-L2-1-P::Caption
                   MOVE SPACES TO LBL-L2-1-V::Caption
                   MOVE "#00000000" TO SHP-L2-1::FillColor
               END-IF
               IF WS-N2-NAME(2) NOT = SPACES
                   MOVE WS-N2-NAME(2) TO LBL-L2-2-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-N2-TOTAL > 0
                       COMPUTE WS-FP = WS-N2-CNT(2) * 100 / WS-N2-TOTAL
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L2-2-P::Caption
                   MOVE WS-N2-CNT(2) TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-L2-2-V::Caption
                   MOVE WS-COLOR(2) TO SHP-L2-2::FillColor
               ELSE
                   MOVE SPACES TO LBL-L2-2-N::Caption
                   MOVE SPACES TO LBL-L2-2-P::Caption
                   MOVE SPACES TO LBL-L2-2-V::Caption
                   MOVE "#00000000" TO SHP-L2-2::FillColor
               END-IF
               IF WS-N2-NAME(3) NOT = SPACES
                   MOVE WS-N2-NAME(3) TO LBL-L2-3-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-N2-TOTAL > 0
                       COMPUTE WS-FP = WS-N2-CNT(3) * 100 / WS-N2-TOTAL
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L2-3-P::Caption
                   MOVE WS-N2-CNT(3) TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-L2-3-V::Caption
                   MOVE WS-COLOR(3) TO SHP-L2-3::FillColor
               ELSE
                   MOVE SPACES TO LBL-L2-3-N::Caption
                   MOVE SPACES TO LBL-L2-3-P::Caption
                   MOVE SPACES TO LBL-L2-3-V::Caption
                   MOVE "#00000000" TO SHP-L2-3::FillColor
               END-IF
               IF WS-N2-NAME(4) NOT = SPACES
                   MOVE WS-N2-NAME(4) TO LBL-L2-4-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-N2-TOTAL > 0
                       COMPUTE WS-FP = WS-N2-CNT(4) * 100 / WS-N2-TOTAL
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L2-4-P::Caption
                   MOVE WS-N2-CNT(4) TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-L2-4-V::Caption
                   MOVE WS-COLOR(4) TO SHP-L2-4::FillColor
               ELSE
                   MOVE SPACES TO LBL-L2-4-N::Caption
                   MOVE SPACES TO LBL-L2-4-P::Caption
                   MOVE SPACES TO LBL-L2-4-V::Caption
                   MOVE "#00000000" TO SHP-L2-4::FillColor
               END-IF
               IF WS-N2-NAME(5) NOT = SPACES
                   MOVE WS-N2-NAME(5) TO LBL-L2-5-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-N2-TOTAL > 0
                       COMPUTE WS-FP = WS-N2-CNT(5) * 100 / WS-N2-TOTAL
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L2-5-P::Caption
                   MOVE WS-N2-CNT(5) TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-L2-5-V::Caption
                   MOVE WS-COLOR(5) TO SHP-L2-5::FillColor
               ELSE
                   MOVE SPACES TO LBL-L2-5-N::Caption
                   MOVE SPACES TO LBL-L2-5-P::Caption
                   MOVE SPACES TO LBL-L2-5-V::Caption
                   MOVE "#00000000" TO SHP-L2-5::FillColor
               END-IF
               IF WS-N2-NAME(6) NOT = SPACES
                   MOVE WS-N2-NAME(6) TO LBL-L2-6-N::Caption
                   MOVE 0 TO WS-FP
                   IF WS-N2-TOTAL > 0
                       COMPUTE WS-FP = WS-N2-CNT(6) * 100 / WS-N2-TOTAL
                   END-IF
                   CALL "FMT-PCT"
                   MOVE WS-FT TO LBL-L2-6-P::Caption
                   MOVE WS-N2-CNT(6) TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-L2-6-V::Caption
                   MOVE WS-COLOR(6) TO SHP-L2-6::FillColor
               ELSE
                   MOVE SPACES TO LBL-L2-6-N::Caption
                   MOVE SPACES TO LBL-L2-6-P::Caption
                   MOVE SPACES TO LBL-L2-6-V::Caption
                   MOVE "#00000000" TO SHP-L2-6::FillColor
               END-IF
               CALL "PAINT-BINS"
]]></Event>
    <Event name="PAINT-YEARS" paragraph="PAINT-YEARS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-I    PIC 99.
       01 WS-K    PIC 99.
       01 WS-LP   PIC 9(4).
       01 WS-CP   PIC 9(4).
       01 WS-SL   PIC X(200).
       01 WS-SC   PIC X(80).
       01 WS-DIV  PIC 9(10).
       01 WS-LBL  PIC 9(4).
       01 WS-RAW  PIC 9(15)V99 OCCURS 3.
       01 WS-RUN  PIC 9(15)V99 OCCURS 3.
       01 WS-BV   PIC 9(9)V99 OCCURS 3.
       01 WS-LV   PIC 9(9)V99 OCCURS 3.
       01 WS-SPK  PIC 9(15)V99.
       01 WS-SPV  PIC 9(9)V99.
       01 WS-TXT  PIC X(80).
       01 WS-Y1   PIC 9(4).
       01 WS-Y2   PIC 9(4).
       PROCEDURE DIVISION.
           MOVE SPACES TO WS-SL
           MOVE SPACES TO WS-SC
           MOVE 1 TO WS-LP
           MOVE 1 TO WS-CP
           PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               IF WS-K > 1
                   STRING "," DELIMITED BY SIZE INTO WS-SL WITH POINTER WS-LP
                   STRING "," DELIMITED BY SIZE INTO WS-SC WITH POINTER WS-CP
               END-IF
               IF WS-TOP3-IDX(WS-K) > 0
                   STRING FUNCTION TRIM(WS-CAT-NAME(WS-TOP3-IDX(WS-K))) DELIMITED BY SIZE
                       INTO WS-SL WITH POINTER WS-LP
                   STRING WS-COLOR(WS-TOP3-IDX(WS-K)) DELIMITED BY SIZE INTO WS-SC WITH POINTER WS-CP
               ELSE
                   STRING "-" DELIMITED BY SIZE INTO WS-SL WITH POINTER WS-LP
                   STRING "#C9D3E6" DELIMITED BY SIZE INTO WS-SC WITH POINTER WS-CP
               END-IF
           END-PERFORM
           MOVE SPACES TO WS-TXT
           MOVE WS-YR-MIN TO WS-Y1
           MOVE WS-YR-NUM(12) TO WS-Y2
           STRING "Ano de início: " WS-Y1 " a " WS-Y2 DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO CH-BAR::XAxisLabel
           MOVE WS-TXT TO CH-LINE::XAxisLabel
           MOVE WS-SL TO CH-BAR::SeriesLabels
           MOVE WS-SC TO CH-BAR::SeriesColors
           MOVE WS-SL TO CH-LINE::SeriesLabels
           MOVE WS-SC TO CH-LINE::SeriesColors
           EVALUATE WS-METRIC
               WHEN 1
                   MOVE 1 TO WS-DIV
               WHEN 2
                   MOVE 1000000000 TO WS-DIV
               WHEN OTHER
                   MOVE 1000 TO WS-DIV
           END-EVALUATE
           PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
               EVALUATE WS-METRIC
                   WHEN 1
                       MOVE WS-OS-CNT(WS-K) TO WS-RUN(WS-K)
                   WHEN 2
                       MOVE WS-OS-PL(WS-K) TO WS-RUN(WS-K)
                   WHEN OTHER
                       MOVE WS-OS-COT(WS-K) TO WS-RUN(WS-K)
               END-EVALUATE
           END-PERFORM
           MOVE WS-OA-PL TO WS-SPK
           INVOKE CH-BAR::Clear()
           INVOKE CH-LINE::Clear()
           INVOKE SPK::Clear()
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
               PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 3
                   EVALUATE WS-METRIC
                       WHEN 1
                           MOVE WS-YS-CNT(WS-I, WS-K) TO WS-RAW(WS-K)
                       WHEN 2
                           MOVE WS-YS-PL(WS-I, WS-K) TO WS-RAW(WS-K)
                       WHEN OTHER
                           MOVE WS-YS-COT(WS-I, WS-K) TO WS-RAW(WS-K)
                   END-EVALUATE
                   ADD WS-RAW(WS-K) TO WS-RUN(WS-K)
                   COMPUTE WS-BV(WS-K) = WS-RAW(WS-K) / WS-DIV
                   IF WS-ACUM = 1
                       COMPUTE WS-LV(WS-K) = WS-RUN(WS-K) / WS-DIV
                   ELSE
                       MOVE WS-BV(WS-K) TO WS-LV(WS-K)
                   END-IF
               END-PERFORM
               MOVE WS-YR-NUM(WS-I) TO WS-LBL
               INVOKE CH-BAR::AddPoint(WS-LBL, WS-BV(1), WS-BV(2), WS-BV(3))
               INVOKE CH-LINE::AddPoint(WS-LBL, WS-LV(1), WS-LV(2), WS-LV(3))
               ADD WS-YA-PL(WS-I) TO WS-SPK
               COMPUTE WS-SPV = WS-SPK / 1000000000
               INVOKE SPK::AddPoint(WS-LBL, WS-SPV)
           END-PERFORM
           EVALUATE WS-METRIC
               WHEN 1
                   MOVE "quantidade de fundos" TO LBL-BAR-U::Caption
                   MOVE "quantidade de fundos" TO LBL-LIN-U::Caption
                   MOVE WS-T-CNT TO WS-FC
                   CALL "FMT-COUNT"
                   MOVE WS-FT TO LBL-BAR-TOT::Caption
               WHEN 2
                   MOVE "PL em R$ bilhões" TO LBL-BAR-U::Caption
                   MOVE "PL em R$ bilhões" TO LBL-LIN-U::Caption
                   MOVE WS-T-PL TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-BAR-TOT::Caption
               WHEN OTHER
                   MOVE "milhares de cotistas" TO LBL-BAR-U::Caption
                   MOVE "milhares de cotistas" TO LBL-LIN-U::Caption
                   MOVE WS-T-COT TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE WS-FT TO LBL-BAR-TOT::Caption
           END-EVALUATE
]]></Event>
    <Event name="PAINT-TABS" paragraph="PAINT-TABS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "#FFFFFF" TO BTN-M1::BackgroundColor
           MOVE "#FFFFFF" TO BTN-M2::BackgroundColor
           MOVE "#FFFFFF" TO BTN-M3::BackgroundColor
           MOVE "#1B2A4E" TO BTN-M1::ForegroundColor
           MOVE "#1B2A4E" TO BTN-M2::ForegroundColor
           MOVE "#1B2A4E" TO BTN-M3::ForegroundColor
           EVALUATE WS-METRIC
               WHEN 1
                   MOVE "#3E7BE8" TO BTN-M1::BackgroundColor
                   MOVE "#FFFFFF" TO BTN-M1::ForegroundColor
               WHEN 2
                   MOVE "#3E7BE8" TO BTN-M2::BackgroundColor
                   MOVE "#FFFFFF" TO BTN-M2::ForegroundColor
               WHEN OTHER
                   MOVE "#3E7BE8" TO BTN-M3::BackgroundColor
                   MOVE "#FFFFFF" TO BTN-M3::ForegroundColor
           END-EVALUATE
]]></Event>
    <Event name="PAINT-LISTS" paragraph="PAINT-LISTS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TXT  PIC X(120).
       01 WS-PCTI PIC 9(3).
       01 WS-TOT2 PIC 9(15)V99.
       PROCEDURE DIVISION.
               IF WS-TOP-N >= 1
                   MOVE WS-TOP-NAME(1) TO LBL-TOP1-N::Caption
                   MOVE WS-TOP-PL(1) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-TOP1-V::Caption
                   MOVE 0 TO WS-PCTI
                   IF WS-TOP-PL(1) > 0
                       COMPUTE WS-PCTI = WS-TOP-PL(1) * 100 / WS-TOP-PL(1)
                   END-IF
                   INVOKE PRG-TOP1::SetValue(WS-PCTI)
               ELSE
                   MOVE SPACES TO LBL-TOP1-N::Caption
                   MOVE SPACES TO LBL-TOP1-V::Caption
                   INVOKE PRG-TOP1::SetValue(0)
               END-IF
               IF WS-TOP-N >= 2
                   MOVE WS-TOP-NAME(2) TO LBL-TOP2-N::Caption
                   MOVE WS-TOP-PL(2) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-TOP2-V::Caption
                   MOVE 0 TO WS-PCTI
                   IF WS-TOP-PL(1) > 0
                       COMPUTE WS-PCTI = WS-TOP-PL(2) * 100 / WS-TOP-PL(1)
                   END-IF
                   INVOKE PRG-TOP2::SetValue(WS-PCTI)
               ELSE
                   MOVE SPACES TO LBL-TOP2-N::Caption
                   MOVE SPACES TO LBL-TOP2-V::Caption
                   INVOKE PRG-TOP2::SetValue(0)
               END-IF
               IF WS-TOP-N >= 3
                   MOVE WS-TOP-NAME(3) TO LBL-TOP3-N::Caption
                   MOVE WS-TOP-PL(3) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-TOP3-V::Caption
                   MOVE 0 TO WS-PCTI
                   IF WS-TOP-PL(1) > 0
                       COMPUTE WS-PCTI = WS-TOP-PL(3) * 100 / WS-TOP-PL(1)
                   END-IF
                   INVOKE PRG-TOP3::SetValue(WS-PCTI)
               ELSE
                   MOVE SPACES TO LBL-TOP3-N::Caption
                   MOVE SPACES TO LBL-TOP3-V::Caption
                   INVOKE PRG-TOP3::SetValue(0)
               END-IF
               IF WS-TOP-N >= 4
                   MOVE WS-TOP-NAME(4) TO LBL-TOP4-N::Caption
                   MOVE WS-TOP-PL(4) TO WS-FV
                   CALL "FMT-SHORT"
                   MOVE SPACES TO WS-TXT
                   STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
                   MOVE WS-TXT TO LBL-TOP4-V::Caption
                   MOVE 0 TO WS-PCTI
                   IF WS-TOP-PL(1) > 0
                       COMPUTE WS-PCTI = WS-TOP-PL(4) * 100 / WS-TOP-PL(1)
                   END-IF
                   INVOKE PRG-TOP4::SetValue(WS-PCTI)
               ELSE
                   MOVE SPACES TO LBL-TOP4-N::Caption
                   MOVE SPACES TO LBL-TOP4-V::Caption
                   INVOKE PRG-TOP4::SetValue(0)
               END-IF
           *>  structure: share of the PL held by classes and by sub-classes
               COMPUTE WS-TOT2 = WS-T-CLS + WS-T-SUB
               MOVE 0 TO WS-FP
               MOVE 0 TO WS-PCTI
               IF WS-TOT2 > 0
                   COMPUTE WS-FP = WS-T-CLS * 100 / WS-TOT2
                   COMPUTE WS-PCTI = WS-T-CLS * 100 / WS-TOT2
               END-IF
               INVOKE PRG-CLS::SetValue(WS-PCTI)
               CALL "FMT-PCT"
               MOVE WS-FT TO LBL-CLS-P::Caption
               MOVE 0 TO WS-FP
               MOVE 0 TO WS-PCTI
               IF WS-TOT2 > 0
                   COMPUTE WS-FP = WS-T-SUB * 100 / WS-TOT2
                   COMPUTE WS-PCTI = WS-T-SUB * 100 / WS-TOT2
               END-IF
               INVOKE PRG-SUB::SetValue(WS-PCTI)
               CALL "FMT-PCT"
               MOVE WS-FT TO LBL-SUB-P::Caption
]]></Event>
    <Event name="PAINT-DATA" paragraph="PAINT-DATA"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TXT  PIC X(120).
       01 WS-A    PIC X(24).
       01 WS-PCT  PIC 9(3)V9.
       01 WS-AVG  PIC 9(15)V99.
       01 WS-R    PIC 99.
       PROCEDURE DIVISION.
           MOVE WS-T-CNT TO WS-FC
           CALL "FMT-COUNT"
           MOVE WS-FT TO LBL-K1-V::Caption
           MOVE 0 TO WS-PCT
           IF WS-UNIV > 0
               COMPUTE WS-PCT = WS-T-CNT * 100 / WS-UNIV
           END-IF
           MOVE WS-PCT TO WS-FP
           CALL "FMT-PCT"
           MOVE SPACES TO WS-TXT
           STRING FUNCTION TRIM(WS-FT) " do universo" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-K1-S::Caption
           MOVE WS-T-PL TO WS-FV
           CALL "FMT-SHORT"
           MOVE SPACES TO WS-TXT
           STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-K2-V::Caption
           MOVE 0 TO WS-AVG
           IF WS-T-PLN > 0
               COMPUTE WS-AVG = WS-T-PL / WS-T-PLN
           END-IF
           MOVE WS-AVG TO WS-FV
           CALL "FMT-SHORT"
           MOVE SPACES TO WS-TXT
           STRING "médio R$ " FUNCTION TRIM(WS-FT) " por fundo" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-K2-S::Caption
           MOVE WS-T-COT TO WS-FV
           CALL "FMT-SHORTN"
           MOVE WS-FT TO LBL-K3-V::Caption
           MOVE 0 TO WS-AVG
           IF WS-T-CNT > 0
               COMPUTE WS-AVG = WS-T-COT / WS-T-CNT
           END-IF
           MOVE WS-AVG TO WS-FV
           CALL "FMT-SHORTN"
           MOVE SPACES TO WS-TXT
           STRING "média " FUNCTION TRIM(WS-FT) " por fundo" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-K3-S::Caption
           MOVE WS-T-MAX TO WS-FV
           CALL "FMT-SHORT"
           MOVE SPACES TO WS-TXT
           STRING "R$ " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-K4-V::Caption
           IF WS-TOP-N > 0
               MOVE WS-TOP-NAME(1) TO LBL-K4-S::Caption
           ELSE
               MOVE SPACES TO LBL-K4-S::Caption
           END-IF
           MOVE WS-RANK(1) TO WS-R
           IF WS-R > 0
               MOVE WS-CAT-NAME(WS-R) TO LBL-K5-V::Caption
               MOVE 0 TO WS-FP
               IF WS-T-PL > 0
                   COMPUTE WS-FP = WS-CAT-PL(WS-R) * 100 / WS-T-PL
               END-IF
               CALL "FMT-PCT"
               MOVE SPACES TO WS-TXT
               STRING FUNCTION TRIM(WS-FT) " do PL filtrado" DELIMITED BY SIZE INTO WS-TXT
               MOVE WS-TXT TO LBL-K5-S::Caption
           ELSE
               MOVE "-" TO LBL-K5-V::Caption
               MOVE SPACES TO LBL-K5-S::Caption
           END-IF
]]></Event>
    <Event name="PAINT-GRID-INFO" paragraph="PAINT-GRID-INFO"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-TXT  PIC X(120).
       01 WS-A    PIC X(24).
       01 WS-B    PIC X(24).
       01 WS-FROM PIC 9(9).
       01 WS-TO   PIC 9(9).
       PROCEDURE DIVISION.
           IF WS-T-CNT = 0
               MOVE 0 TO WS-FROM
               MOVE 0 TO WS-TO
           ELSE
               COMPUTE WS-FROM = (WS-PAGE - 1) * WS-PSIZE + 1
               COMPUTE WS-TO = WS-PAGE * WS-PSIZE
               IF WS-TO > WS-T-CNT
                   MOVE WS-T-CNT TO WS-TO
               END-IF
           END-IF
           MOVE WS-FROM TO WS-FC
           CALL "FMT-COUNT"
           MOVE WS-FT TO WS-A
           MOVE WS-TO TO WS-FC
           CALL "FMT-COUNT"
           MOVE WS-FT TO WS-B
           MOVE WS-T-CNT TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           STRING "Mostrando " FUNCTION TRIM(WS-A) " a " FUNCTION TRIM(WS-B) " de " FUNCTION TRIM(WS-FT)
               " fundo(s)" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-GRID-S::Caption
           MOVE WS-PAGE TO WS-FC
           CALL "FMT-COUNT"
           MOVE WS-FT TO WS-A
           MOVE WS-PAGES TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           STRING "Página " FUNCTION TRIM(WS-A) " de " FUNCTION TRIM(WS-FT) DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-PAGE::Caption
           IF WS-PAGE > 1
               INVOKE BTN-PREV::Enable()
           ELSE
               INVOKE BTN-PREV::Disable()
           END-IF
           IF WS-PAGE < WS-PAGES
               INVOKE BTN-NEXT::Enable()
           ELSE
               INVOKE BTN-NEXT::Disable()
           END-IF
]]></Event>
    <Event name="REFRESH-GRID" paragraph="REFRESH-GRID"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           CALL "Q-GRID"
           CALL "PAINT-GRID-INFO"
]]></Event>
    <Event name="APPLY-FILTERS" paragraph="APPLY-FILTERS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-LOADED = 0
               EXIT PARAGRAPH
           END-IF
           MOVE 1 TO WS-PAGE
           CALL "BUILD-WHERE"
           CALL "Q-TOTALS"
           CALL "Q-CATS"
           CALL "SORT-CATS"
           CALL "Q-N2"
           CALL "Q-BINS"
           CALL "Q-TOP"
           CALL "Q-YEARS"
           CALL "PAINT-KPIS"
           CALL "PAINT-CHARTS"
           CALL "PAINT-YEARS"
           CALL "PAINT-TABS"
           CALL "PAINT-LISTS"
           CALL "PAINT-DATA"
           CALL "REFRESH-GRID"
]]></Event>
    <Event name="PAINT-BINS" paragraph="PAINT-BINS"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-I    PIC 99.
       01 WS-BMAX PIC 9(9).
       01 WS-BTOT PIC 9(9).
       01 WS-PCTI PIC 9(3).
       01 WS-TXT  PIC X(60).
       01 WS-A    PIC X(24).
       PROCEDURE DIVISION.
           MOVE 0 TO WS-BMAX
           MOVE 0 TO WS-BTOT
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
               ADD WS-BIN-CNT(WS-I) TO WS-BTOT
               IF WS-BIN-CNT(WS-I) > WS-BMAX
                   MOVE WS-BIN-CNT(WS-I) TO WS-BMAX
               END-IF
           END-PERFORM
           MOVE WS-BIN-CNT(1) TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           IF WS-BTOT > 0
               COMPUTE WS-FP = WS-BIN-CNT(1) * 100 / WS-BTOT
           ELSE
               MOVE 0 TO WS-FP
           END-IF
           MOVE WS-FT TO WS-A
           CALL "FMT-PCT"
           STRING FUNCTION TRIM(WS-A) "  (" FUNCTION TRIM(WS-FT) ")" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-BIN1-V::Caption
           MOVE 0 TO WS-PCTI
           IF WS-BMAX > 0
               COMPUTE WS-PCTI = WS-BIN-CNT(1) * 100 / WS-BMAX
           END-IF
           INVOKE PRG-BIN1::SetValue(WS-PCTI)
           MOVE WS-BIN-CNT(2) TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           IF WS-BTOT > 0
               COMPUTE WS-FP = WS-BIN-CNT(2) * 100 / WS-BTOT
           ELSE
               MOVE 0 TO WS-FP
           END-IF
           MOVE WS-FT TO WS-A
           CALL "FMT-PCT"
           STRING FUNCTION TRIM(WS-A) "  (" FUNCTION TRIM(WS-FT) ")" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-BIN2-V::Caption
           MOVE 0 TO WS-PCTI
           IF WS-BMAX > 0
               COMPUTE WS-PCTI = WS-BIN-CNT(2) * 100 / WS-BMAX
           END-IF
           INVOKE PRG-BIN2::SetValue(WS-PCTI)
           MOVE WS-BIN-CNT(3) TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           IF WS-BTOT > 0
               COMPUTE WS-FP = WS-BIN-CNT(3) * 100 / WS-BTOT
           ELSE
               MOVE 0 TO WS-FP
           END-IF
           MOVE WS-FT TO WS-A
           CALL "FMT-PCT"
           STRING FUNCTION TRIM(WS-A) "  (" FUNCTION TRIM(WS-FT) ")" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-BIN3-V::Caption
           MOVE 0 TO WS-PCTI
           IF WS-BMAX > 0
               COMPUTE WS-PCTI = WS-BIN-CNT(3) * 100 / WS-BMAX
           END-IF
           INVOKE PRG-BIN3::SetValue(WS-PCTI)
           MOVE WS-BIN-CNT(4) TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           IF WS-BTOT > 0
               COMPUTE WS-FP = WS-BIN-CNT(4) * 100 / WS-BTOT
           ELSE
               MOVE 0 TO WS-FP
           END-IF
           MOVE WS-FT TO WS-A
           CALL "FMT-PCT"
           STRING FUNCTION TRIM(WS-A) "  (" FUNCTION TRIM(WS-FT) ")" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-BIN4-V::Caption
           MOVE 0 TO WS-PCTI
           IF WS-BMAX > 0
               COMPUTE WS-PCTI = WS-BIN-CNT(4) * 100 / WS-BMAX
           END-IF
           INVOKE PRG-BIN4::SetValue(WS-PCTI)
           MOVE WS-BIN-CNT(5) TO WS-FC
           CALL "FMT-COUNT"
           MOVE SPACES TO WS-TXT
           IF WS-BTOT > 0
               COMPUTE WS-FP = WS-BIN-CNT(5) * 100 / WS-BTOT
           ELSE
               MOVE 0 TO WS-FP
           END-IF
           MOVE WS-FT TO WS-A
           CALL "FMT-PCT"
           STRING FUNCTION TRIM(WS-A) "  (" FUNCTION TRIM(WS-FT) ")" DELIMITED BY SIZE INTO WS-TXT
           MOVE WS-TXT TO LBL-BIN5-V::Caption
           MOVE 0 TO WS-PCTI
           IF WS-BMAX > 0
               COMPUTE WS-PCTI = WS-BIN-CNT(5) * 100 / WS-BMAX
           END-IF
           INVOKE PRG-BIN5::SetValue(WS-PCTI)
]]></Event>
