  <Control id="TXT-NOME" type="TextBox" x="34" y="136" w="186" h="34" tab-order="13" z-order="12" visible="true" enabled="true" parent="GRP-NOME">
    <Property name="BackgroundColor">#FFFFFF</Property>
    <Property name="Transparency">18</Property>
    <Property name="ForegroundColor">#1B2A4E</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#C4D3EA</Property>
    <Property name="CornerRadius">12</Property>
    <Property name="FontSize">13</Property>
    <Property name="HintText">Digite para buscar fundos</Property>
    <Property name="Anchor">Top,Left,Right</Property>
    <Property name="InnerPadding">8</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="EnterAsTab">true</Property>
    <Property name="AutoEnter">false</Property>
    <Event name="onTextChanged" paragraph="TXT-NOME--ONTEXTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-SMX                        TO    "N"

           *> SM-TYPED: reacts to typing in a filter box: opens or refreshes its search dropdown.
           *> Uses:   WS-SMX = "N" (set just above), TXT-NOME::Text, WS-LAST-N (the last term
           *>         handled for this box) and WS-SM, which decides between SM-OPEN (WS-SM differs
           *>         from WS-SMX) and SM-REFRESH (it equals it).
           *> Result: Text equal to WS-LAST-N: nothing else happens (WS-TERM = the text). Otherwise
           *>         WS-LAST-N = the text and the names dropdown is opened (SM-OPEN) or, if already
           *>         open, refreshed (SM-REFRESH). Either way WS-TERM ends as the folded text (no
           *>         accents, upper case) and WS-PAT as its LIKE pattern (NORM-TERM), and LST-SM,
           *>         its CheckedItems, WS-SMN (all the matches), WS-SMK (at most 150 names are
           *>         listed) and LBL-SM-INFO::Caption are rebuilt. SM-OPEN also sets WS-SM = "N",
           *>         closes the Levels popup if it was open, recomputes the layout and sets
           *>         POPUP-SEARCH::Visible = TRUE.

           CALL    "SM-TYPED"
]]></Event>
    <Event name="onEnterPressed" paragraph="TXT-NOME--ONENTERPRESSED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLOSE: closes the search dropdown when one is open.
           *> Uses:   WS-SM ("N" or "C" while a dropdown is open, SPACE otherwise).
           *> Result: Only when WS-SM was not SPACE: WS-SM = SPACE and POPUP-SEARCH::Visible =
           *>         FALSE. Otherwise nothing changes.

           CALL    "SM-CLOSE"

           *> APPLY-FILTERS: re-runs every query and repaints the dashboard, the charts and the grid
           *> for the current filters; it exits at once while WS-LOADED = 0.
           *> Uses:   TXT-NOME::Text as typed, the other filter controls, the picks in table pick
           *>         and the Todos flags WS-ALL-N / WS-ALL-C (in Todos mode the picks are ignored
           *>         and the typed text is used).
           *> Result: WS-PAGE = 1; WS-WHERE rebuilt from the controls; the Q-* steps recompute the
           *>         totals (WS-T-*), WS-CAT-*, WS-RANK, WS-N2-*, WS-BIN-CNT, WS-TOP-* and the year
           *>         tables; the PAINT-* steps repaint the KPI card, the charts, the top-4 list
           *>         with the Classe / Subclasse bars, the Dados cards and the metric buttons;
           *>         GRD-FUNDOS shows page 1, with its caption LBL-GRID-S, the page label LBL-PAGE
           *>         and BTN-PREV / BTN-NEXT enabled to match.

           CALL    "APPLY-FILTERS"
]]></Event>
    <Event name="onEscapePressed" paragraph="TXT-NOME--ONESCAPEPRESSED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> SM-CLOSE: closes the search dropdown when one is open.
           *> Uses:   WS-SM ("N" or "C" while a dropdown is open, SPACE otherwise).
           *> Result: Only when WS-SM was not SPACE: WS-SM = SPACE and POPUP-SEARCH::Visible =
           *>         FALSE. The filter is not applied.

           CALL    "SM-CLOSE"
]]></Event>
  </Control>
  <Control id="BTN-NM-X" type="Button" x="224" y="136" w="28" h="34" tab-order="14" z-order="13" visible="true" enabled="true" parent="GRP-NOME">
    <Property name="Caption">×</Property>
    <Property name="BackgroundColor">#FFFFFF</Property>
    <Property name="ForegroundColor">#1B2A4E</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="CornerRadius">12</Property>
    <Property name="Anchor">Top,Right</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="Transparency">18</Property>
    <Property name="BorderColor">#C4D3EA</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-NM-X--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     TXT-NOME::Text                TO    SPACES
           SET     WS-LAST-N                     TO    SPACES
           SET     WS-SMX                        TO    "N"

           *> SM-OPEN: opens the search dropdown (layer POPUP-SEARCH) for the filter box named in
           *> WS-SMX.
           *> Uses:   WS-SMX = "N" (set above); TXT-NOME::Text, which SM-REFRESH reads, was just
           *>         cleared (WS-LAST-N too), so the list is not narrowed.
           *> Result: WS-SM = "N"; the Levels popup is closed if it was open (CLOSE-LEVELS);
           *>         LBL-SM-T::Caption = "Nome comercial  ·  marque os fundos que quer ver"; the
           *>         layout is recomputed (SET-FILT-HEIGHT places the search card); SM-REFRESH
           *>         fills LST-SM with "Todos" + up to 150 distinct fund names, sets WS-SMN (the
           *>         count of all the matches) and WS-SMK, sets LST-SM::CheckedItems (SM-TICKS) and
           *>         LBL-SM-INFO::Caption (SM-INFO); POPUP-SEARCH::Visible = TRUE. The filter
           *>         itself is not applied yet.

           CALL    "SM-OPEN"
]]></Event>
  </Control>
  <Control id="BTN-NM-TG" type="Button" x="256" y="136" w="28" h="34" tab-order="15" z-order="14" visible="true" enabled="true" parent="GRP-NOME">
    <Property name="Caption">▾</Property>
    <Property name="BackgroundColor">#FFFFFF</Property>
    <Property name="ForegroundColor">#1B2A4E</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">true</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="CornerRadius">12</Property>
    <Property name="Anchor">Top,Right</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="Transparency">18</Property>
    <Property name="BorderColor">#C4D3EA</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Event name="onClick" paragraph="BTN-NM-TG--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           IF    WS-SM = "N"

               *> SM-CLOSE: closes the search dropdown when one is open.
               *> Uses:   WS-SM, which is "N" here: the names dropdown is open and the button
               *>         toggles it.
               *> Result: WS-SM = SPACE and POPUP-SEARCH::Visible = FALSE.

               CALL    "SM-CLOSE"
           ELSE
               SET     WS-SMX                    TO    "N"

               *> SM-OPEN: opens the search dropdown (layer POPUP-SEARCH) for the filter box named
               *> in WS-SMX.
               *> Uses:   WS-SMX = "N" (set just above). Caller's test (not read by SM-OPEN): WS-SM
               *>         is not "N", so no dropdown, or the category one, is open.
               *> Result: WS-SM = "N"; the Levels popup is closed if it was open (CLOSE-LEVELS);
               *>         LBL-SM-T::Caption = "Nome comercial  ·  marque os fundos que quer ver";
               *>         the layout is recomputed (SET-FILT-HEIGHT places the search card);
               *>         SM-REFRESH fills LST-SM for the current TXT-NOME::Text (at most 150
               *>         names), sets WS-SMN (all matches) and WS-SMK, sets LST-SM::CheckedItems
               *>         (SM-TICKS) and sets LBL-SM-INFO::Caption (SM-INFO); POPUP-SEARCH::Visible
               *>         = TRUE.

               CALL    "SM-OPEN"
           END-IF
]]></Event>
  </Control>
