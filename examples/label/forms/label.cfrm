]]></repository>
  <form-events>
    <Event name="onLoad" paragraph="TESTFORM--ONLOAD">
    </Event>
    <Event name="onClose" paragraph="TESTFORM--ONCLOSE">
    </Event>
  </form-events>
  <Control id="SUBJ" type="Label" x="20" y="20" w="120" h="20" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">SUBJ</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">10</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="Dock">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Padding">0</Property>
    <Property name="Opacity">100</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">20</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowDirection">South</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="WordWrap">false</Property>
    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onClick" paragraph="SUBJ--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.
           DISPLAY "onClick working".
]]></Event>
    <Event name="onDblClick" paragraph="SUBJ--ONDBLCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.
           DISPLAY "onDblClick working".
]]></Event>
    <Event name="onMouseEnter" paragraph="SUBJ--ONMOUSEENTER"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.
           DISPLAY "onMouseEnter working".
]]></Event>
    <Event name="onMouseLeave" paragraph="SUBJ--ONMOUSELEAVE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.
