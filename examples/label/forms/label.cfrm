<?xml version="1.0" encoding="UTF-8"?>
<Form name="TESTFORM" title="Label — control test" width="640" height="1080" background="00000000" transparency="0" grid-size="8" snap-to-grid="true" target="Custom">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
