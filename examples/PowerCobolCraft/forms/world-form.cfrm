  <Control id="DG-LOG" type="DataGrid" x="748" y="152" w="496" h="408" tab-order="1" z-order="3" visible="true" enabled="true" parent="PNL-CONSOLE">
    <Property name="Definition">Every line the server printed, newest first: the time and the message.</Property>
    <Property name="Anchor">Top,Bottom,Left,Right</Property>
    <Property name="Columns">Col-Time:string
Col-Message:string</Property>
    <Property name="AdvancedGrid">{&quot;schema_version&quot;:1,&quot;columns&quot;:[{&quot;id&quot;:&quot;Col-Time&quot;,&quot;title&quot;:&quot;Time&quot;,&quot;source_name&quot;:&quot;Col-Time&quot;,&quot;value_type&quot;:&quot;string&quot;,&quot;cobol_mask&quot;:&quot;&quot;,&quot;edit_control&quot;:&quot;Textbox&quot;,&quot;control_kind&quot;:&quot;&quot;,&quot;width&quot;:84.0,&quot;width_unit&quot;:&quot;Points&quot;,&quot;visible&quot;:true,&quot;frozen&quot;:false,&quot;filter_enabled&quot;:false,&quot;sort_enabled&quot;:false,&quot;header_font_size&quot;:13,&quot;text_alignment&quot;:&quot;Left&quot;,&quot;foreground_color&quot;:&quot;#8FA3BF&quot;,&quot;background_color&quot;:&quot;#00000000&quot;,&quot;background_pattern&quot;:&quot;&quot;,&quot;background_image&quot;:&quot;&quot;,&quot;image_corner_radius&quot;:0.0,&quot;image_shadow&quot;:false,&quot;font_name&quot;:&quot;&quot;,&quot;font_size&quot;:0,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;underline&quot;:false,&quot;frame&quot;:null,&quot;gauge&quot;:null,&quot;value_style_rules&quot;:[]},{&quot;id&quot;:&quot;Col-Message&quot;,&quot;title&quot;:&quot;Message&quot;,&quot;source_name&quot;:&quot;Col-Message&quot;,&quot;value_type&quot;:&quot;string&quot;,&quot;cobol_mask&quot;:&quot;&quot;,&quot;edit_control&quot;:&quot;Textbox&quot;,&quot;control_kind&quot;:&quot;&quot;,&quot;width&quot;:410.0,&quot;width_unit&quot;:&quot;Points&quot;,&quot;visible&quot;:true,&quot;frozen&quot;:false,&quot;filter_enabled&quot;:false,&quot;sort_enabled&quot;:false,&quot;header_font_size&quot;:13,&quot;text_alignment&quot;:&quot;Left&quot;,&quot;foreground_color&quot;:&quot;#F0F2F6&quot;,&quot;background_color&quot;:&quot;#00000000&quot;,&quot;background_pattern&quot;:&quot;&quot;,&quot;background_image&quot;:&quot;&quot;,&quot;image_corner_radius&quot;:0.0,&quot;image_shadow&quot;:false,&quot;font_name&quot;:&quot;&quot;,&quot;font_size&quot;:0,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;underline&quot;:false,&quot;frame&quot;:null,&quot;gauge&quot;:null,&quot;value_style_rules&quot;:[]}],&quot;frozen_columns&quot;:0,&quot;frozen_rows&quot;:0,&quot;row_height&quot;:22,&quot;row_overrides&quot;:[],&quot;filters&quot;:[],&quot;csv_export_mode&quot;:&quot;Filtered&quot;,&quot;csv_delimiter&quot;:&quot;,&quot;,&quot;grid_line_style&quot;:&quot;Solid&quot;,&quot;selectable_text&quot;:true}</Property>
    <Property name="Rows"></Property>
    <Property name="FontSize">13</Property>
    <Property name="RowHeight">22</Property>
    <Property name="BackgroundColor">#0E0F15FF</Property>
    <Property name="ForegroundColor">#F0F2F6FF</Property>
    <Property name="HeaderBackgroundColor">#232633FF</Property>
    <Property name="HeaderForegroundColor">#8FD3FFFF</Property>
    <Property name="GridLineColor">#FFFFFF1A</Property>
    <Property name="AlternatingRowColor">#FFFFFF</Property>
    <Property name="AlternatingRowOpacity">4</Property>
    <Property name="AllowSorting">false</Property>
    <Property name="AllowCellEditing">false</Property>
    <Property name="AutoFitColumns">true</Property>
    <Property name="AllowColumnReorder">false</Property>
    <Property name="ShowCSVExportButton">false</Property>
    <Property name="ExportCSV">false</Property>
    <Property name="CornerRadius">12</Property>
  </Control>
  <Control id="TXT-COMMAND" type="TextBox" x="748" y="580" w="380" h="44" tab-order="2" z-order="3" visible="true" enabled="true" parent="PNL-CONSOLE">
    <Property name="Definition">Where a command (help, gamemode, kill, save, say, stop, time, whitelist) or a chat message is typed.</Property>
    <Property name="Anchor">Bottom,Left,Right</Property>
    <Property name="HintText">A command (try help) or a chat message, then Enter</Property>
    <Property name="FontSize">14</Property>
    <Property name="CornerRadius">12</Property>
    <Property name="BackgroundColor">#12131CFF</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="BorderColor">#FFFFFF33</Property>
    <Property name="EnterAsTab">false</Property>
    <Event name="onEnterPressed" paragraph="TXT-COMMAND--ONENTERPRESSED"><![CDATA[       PROCEDURE DIVISION.
           *> Runs what was typed: a command, or a chat message.
           *> Uses: TXT-COMMAND::Text, WS-SERVER.
           *> Result: the answer in the console and over the world; the command done.
           CALL "CRAFT-RUN-COMMAND"
]]></Event>
  </Control>
  <Control id="BTN-SEND" type="Button" x="1136" y="580" w="108" h="44" tab-order="3" z-order="3" visible="true" enabled="true" parent="PNL-CONSOLE">
    <Property name="Definition">Runs the command or sends the chat message typed in the box.</Property>
    <Property name="Anchor">Bottom,Right</Property>
    <Property name="Caption">Send</Property>
    <Property name="FontSize">15</Property>
    <Property name="CornerRadius">22</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#0A84FFFF</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Event name="onClick" paragraph="BTN-SEND--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           *> Runs what was typed: a command, or a chat message.
           *> Uses: TXT-COMMAND::Text, WS-SERVER.
           *> Result: the answer in the console and over the world; the command done.
           CALL "CRAFT-RUN-COMMAND"
           TXT-COMMAND::SetFocus()
]]></Event>
  </Control>
</Form>
