  <Control id="BTN-RESPAWN" type="Button" x="444" y="348" w="392" h="48" tab-order="2" z-order="3" visible="true" enabled="true" parent="PNL-DEATH">
    <Property name="Definition">Brings the player back on the spawn with full health.</Property>
    <Property name="Caption">Respawn</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">24</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#0A84FFFF</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Event name="onClick" paragraph="BTN-RESPAWN--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           *> Back on the spawn with full health.
           *> Uses: WS-WORLD (the middle column).
           *> Result: WS-PLAYER-X/Y/Z on the spawn, the speeds at rest.
           CALL "CRAFT-SPAWN"
           SET     WS-HEALTH                     TO    20
           SET     WS-DEAD                       TO    0
           SET     WS-HUD-DIRTY                  TO    1
           SET     WS-LOOK-READY                 TO    0
           PNL-DEATH::Hide()
           CNV-3D::SetFocus()
]]></Event>
  </Control>
  <Control id="BTN-DEATH-QUIT" type="Button" x="444" y="408" w="392" h="48" tab-order="3" z-order="3" visible="true" enabled="true" parent="PNL-DEATH">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="Definition">Saves the world and goes back to the title screen from the death screen.</Property>
    <Property name="Caption">Save and quit to title</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">24</Property>
    <Event name="onClick" paragraph="BTN-DEATH-QUIT--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           *> Saves the world before going back to the title.
           *> Uses: the world, the player and the server state.
           *> Result: data/world.dat holds them.
           CALL "CRAFT-SAVE"
           INVOKE    super::SetProperty("WorldResult", "QUIT")
           INVOKE    ME::Close()
]]></Event>
  </Control>
