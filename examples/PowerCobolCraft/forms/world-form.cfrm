  <Control id="BTN-RESUME" type="Button" x="494" y="272" w="292" h="48" tab-order="1" z-order="3" visible="true" enabled="true" parent="PNL-PAUSE">
    <Property name="Definition">Closes the game menu and goes back to playing.</Property>
    <Property name="Caption">Back to game</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">24</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#0A84FFFF</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Event name="onClick" paragraph="BTN-RESUME--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           SET     WS-PAUSED                     TO    0
           SET     WS-LOOK-READY                 TO    0
           PNL-PAUSE::Hide()
           CNV-3D::SetFocus()
]]></Event>
  </Control>
  <Control id="BTN-SAVE" type="Button" x="494" y="332" w="292" h="48" tab-order="2" z-order="3" visible="true" enabled="true" parent="PNL-PAUSE">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="Definition">Saves the world now, as the /save command does.</Property>
    <Property name="Caption">Save world</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">24</Property>
    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           SET     WS-LOG-MESSAGE                TO    "Saving world"
           *> Writes the line into the console.
           *> Uses: WS-LOG-MESSAGE.
           *> Result: DG-LOG shows it first.
           CALL "CRAFT-LOG"
           *> Saves the world.
           *> Uses: the world, the player and the server state.
           *> Result: data/world.dat holds them.
           CALL "CRAFT-SAVE"
           SET     WS-LOG-MESSAGE                TO    "World saved"
           SET     WS-LOG-CHAT                   TO    1
           *> Tells that the world was saved.
           *> Uses: WS-LOG-MESSAGE, WS-LOG-CHAT 1.
           *> Result: DG-LOG and LBL-CHAT show it.
           CALL "CRAFT-LOG"
]]></Event>
  </Control>
  <Control id="BTN-CONSOLE" type="Button" x="494" y="392" w="292" h="48" tab-order="3" z-order="3" visible="true" enabled="true" parent="PNL-PAUSE">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="Definition">Opens the server console beside the world.</Property>
    <Property name="Caption">Server console</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">24</Property>
    <Event name="onClick" paragraph="BTN-CONSOLE--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           SET     WS-PAUSED                     TO    0
           PNL-PAUSE::Hide()
           *> Opens the server console beside the world.
           *> Uses: PNL-CONSOLE, TXT-COMMAND.
           *> Result: WS-CONSOLE-OPEN 1; the command box has the keyboard.
           CALL "CRAFT-OPEN-CONSOLE"
]]></Event>
  </Control>
  <Control id="BTN-QUIT" type="Button" x="494" y="452" w="292" h="48" tab-order="4" z-order="3" visible="true" enabled="true" parent="PNL-PAUSE">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="Definition">Saves the world and goes back to the title screen.</Property>
    <Property name="Caption">Save and quit to title</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">24</Property>
    <Event name="onClick" paragraph="BTN-QUIT--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           *> Saves the world before going back to the title (onClose saves again, harmlessly).
           *> Uses: the world, the player and the server state.
           *> Result: data/world.dat holds them.
           CALL "CRAFT-SAVE"
           INVOKE    super::SetProperty("WorldResult", "QUIT")
           INVOKE    ME::Close()
]]></Event>
  </Control>
