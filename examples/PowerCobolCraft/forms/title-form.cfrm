  </Control>
  <Control id="CMB-MODE" type="ComboBox" x="92" y="318" w="344" h="44" tab-order="3" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BackgroundColor">#1C2030FF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#FFFFFF40</Property>
    <Property name="ActiveItemColor">#0A84FFFF</Property>
    <Property name="Definition">The game mode: Survival, Creative, Adventure or Spectator, as CobolCraft's /gamemode command names them.</Property>
    <Property name="Items">Survival
Creative
Adventure
Spectator</Property>
    <Property name="SelectedIndex">1</Property>
    <Property name="DropDownStyle">DropDownList</Property>
    <Property name="FontSize">15</Property>
    <Property name="CornerRadius">12</Property>
  </Control>
  <Control id="LBL-LANGUAGE" type="Label" x="92" y="376" w="344" h="22" tab-order="4" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="Definition">Names the list below: the language of the screens.</Property>
    <Property name="Caption">Language</Property>
    <Property name="FontSize">13</Property>
    <Property name="ForegroundColor">#DDE3EEFF</Property>
  </Control>
  <Control id="CMB-LANGUAGE" type="ComboBox" x="92" y="402" w="344" h="44" tab-order="5" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="BackgroundColor">#1C2030FF</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderColor">#FFFFFF40</Property>
    <Property name="ActiveItemColor">#0A84FFFF</Property>
    <Property name="Definition">The language of the title screen and of the world's menus, each written in its own language.</Property>
    <Property name="Items">English
Português (Brasil)
Español
Français
日本語
中文</Property>
    <Property name="SelectedIndex">1</Property>
    <Property name="DropDownStyle">DropDownList</Property>
    <Property name="FontSize">15</Property>
    <Property name="CornerRadius">12</Property>
    <Event name="onSelectedIndexChanged" paragraph="CMB-LANGUAGE--ONSELECTEDINDEXCHANGED"><![CDATA[       PROCEDURE DIVISION.
           IF    WS-READY = 0 OR CMB-LANGUAGE::SelectedIndex < 1
               EXIT PROGRAM
           END-IF
           SET     WS-LANGUAGE                   TO    CMB-LANGUAGE::SelectedIndex
           SET     WS-GAME-MODE                  TO    CMB-MODE::SelectedIndex
           SET     WS-SETTING-ACTION             TO    "PUT"
           SET     WS-SETTING-NAME               TO    "language"
           SET     WS-SETTING-VALUE              TO    WS-LANGUAGE
           *> Keeps the language for next time.
           *> Uses: WS-SETTING-ACTION "PUT", WS-SETTING-NAME "language", WS-SETTING-VALUE "1" to "6".
           *> Result: data/settings.idx holds it.
           CALL "CRAFT-SETTINGS" USING WS-SETTING-ACTION WS-SETTING-NAME WS-SETTING-VALUE
           *> Puts every caption in the language just chosen.
           *> Uses: WS-LANGUAGE, WS-GAME-MODE (kept selected).
           *> Result: the labels, buttons, the game modes and the credits in that language.
           CALL "CRAFT-TITLE-TEXTS"
           *> Writes the saved world's line again, its "Day" in the new language.
           *> Uses: data/world.dat, WS-LANGUAGE.
           *> Result: LBL-SAVED and BTN-CONTINUE up to date.
           CALL "CRAFT-SAVED-INFO"
]]></Event>
  </Control>
  <Control id="BTN-PLAY" type="Button" x="92" y="472" w="344" h="50" tab-order="6" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="Definition">Starts a new flat world, as CobolCraft generates one, and opens it.</Property>
    <Property name="Caption">Play a new world</Property>
    <Property name="FontSize">16</Property>
    <Property name="Bold">true</Property>
    <Property name="CornerRadius">25</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BackgroundColor">#0A84FFFF</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Event name="onClick" paragraph="BTN-PLAY--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           SET     WS-WORLD-MODE                 TO    "NEW"
           *> Keeps the choices and opens a new world.
           *> Uses: TXT-PLAYER, CMB-MODE, WS-LANGUAGE, WS-WORLD-MODE "NEW".
           *> Result: WORLD-FORM played until it closes; the application ends on /stop.
           CALL "CRAFT-START-WORLD"
]]></Event>
  </Control>
  <Control id="BTN-CONTINUE" type="Button" x="92" y="532" w="344" h="50" tab-order="7" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="Definition">Opens the saved world where it was left; disabled when there is none.</Property>
    <Property name="Caption">Continue the saved world</Property>
    <Property name="FontSize">16</Property>
    <Property name="CornerRadius">25</Property>
    <Event name="onClick" paragraph="BTN-CONTINUE--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           SET     WS-WORLD-MODE                 TO    "LOAD"
           *> Keeps the choices and opens the saved world.
           *> Uses: TXT-PLAYER, CMB-MODE, WS-LANGUAGE, WS-WORLD-MODE "LOAD".
           *> Result: WORLD-FORM played until it closes; the application ends on /stop.
           CALL "CRAFT-START-WORLD"
]]></Event>
  </Control>
  <Control id="LBL-SAVED" type="Label" x="92" y="586" w="344" h="22" tab-order="8" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="Definition">Whose world is saved, which day it has reached and when it was saved.</Property>
    <Property name="Caption"> </Property>
    <Property name="FontSize">12</Property>
    <Property name="ForegroundColor">#DDE3EEFF</Property>
    <Property name="TextAlignment">Center</Property>
  </Control>
  <Control id="BTN-QUIT" type="Button" x="92" y="618" w="344" h="44" tab-order="9" z-order="3" visible="true" enabled="true" parent="PNL-PLAY">
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="Definition">Closes PowerCobolCraft.</Property>
    <Property name="Caption">Quit</Property>
    <Property name="FontSize">15</Property>
    <Property name="CornerRadius">22</Property>
    <Event name="onClick" paragraph="BTN-QUIT--ONCLICK"><![CDATA[       PROCEDURE DIVISION.
           INVOKE    ME::Close()
]]></Event>
  </Control>
