<?xml version="1.0" encoding="UTF-8"?>
<Form name="MAIN-FORM" title="PowerWebHello" width="960" height="640" background="40404008" transparency="50" grid-size="8" snap-to-grid="true" target="Custom" main-form="true" index-base="1" responsive="true">
