  <Control id="SUBJ" type="DataGrid" x="20" y="20" w="300" h="200" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">10</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="Dock">None</Property>
    <Property name="Anchor">Top,Left</Property>
    <Property name="Padding">0</Property>
    <Property name="Opacity">100</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">20</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowDirection">South</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="LabelFor"></Property>
    <Property name="DataItem"></Property>
    <Property name="DataFormat"></Property>
    <Property name="Columns"></Property>
    <Property name="Rows"></Property>
    <Property name="ReadOnly">false</Property>
    <Property name="AlternatingRowColor">#F0F8FF</Property>
    <Property name="HeaderBackgroundColor">#E0E0E0</Property>
    <Property name="HeaderForegroundColor">#000000</Property>
    <Property name="GridLineColor">#CCCCCC</Property>
    <Property name="SelectionMode">Row</Property>
    <Property name="RowHeight">22</Property>
    <Property name="AllowSorting">true</Property>
    <Property name="AllowColumnResize">true</Property>
    <Property name="ShowRowNumbers">false</Property>
    <Property name="ExportCSV">true</Property>
    <Property name="CSVDelimiter">,</Property>
    <Property name="CSVParagraph"></Property>
    <Event name="onCellClick" paragraph="SUBJ--ONCELLCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
