  <Control id="Lbl-Sub" type="Label" x="32" y="54" w="936" h="38" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">One control, three back ends: the ConnectionString&apos;s scheme picks SQLite, PostgreSQL or MySQL. Open, Execute, Query, Fetch and Close are its methods. NOTE that COBOL&apos;s own COMMIT / ROLLBACK verbs are INDEXED-file transactions - SQL transactions are executed as statements through this control.</Property>
