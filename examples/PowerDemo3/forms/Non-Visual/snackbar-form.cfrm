  <Control id="Label-FOOT" type="Label" x="24" y="552" w="952" h="40" tab-order="0" z-order="17" visible="true" enabled="true">
    <Property name="Caption">Notifications anchor to THIS form&apos;s own surface. The entrance grows from one pixel over 600 ms - 200 ms for Critical; movement and fade-out take 300 ms.</Property>
    <Property name="BackgroundColor">#00000000</Property>
