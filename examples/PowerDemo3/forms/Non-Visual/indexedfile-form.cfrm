  <Control id="Lbl-Sub" type="Label" x="32" y="54" w="936" h="38" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">The IndexedFile control is the designer-side FACE of a keyed file. The record and its keys are described once in a .cidx definition, which the SELECT and FD are generated from; the file itself is then driven with ordinary COBOL verbs - OPEN, READ, START, WRITE, REWRITE, DELETE, COMMIT, CLOSE - against that FD.</Property>
