    <Event name="onClick" paragraph="BUTTON-CHART-SMOOTH--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-FLAG                                PIC    X(8).
       01 WS-MSG                                 PIC    X(32).
       01 WS-OUT                                 PIC    X(64).

       LINKAGE SECTION.

       PROCEDURE DIVISION.

           *> Smooth, ShowPoints and PointRadius belong to the LINE and AREA
           *> charts. Off, the line is drawn as straight segments between points.

           SET     WS-FLAG                       TO    LineChart-1::Smooth
           IF    FUNCTION TRIM(WS-FLAG) = "true"
               SET     WS-FLAG                   TO    "false"
           ELSE
               SET     WS-FLAG                   TO    "true"
           END-IF

           SET     LineChart-1::Smooth           TO    FUNCTION TRIM(WS-FLAG)
           SET     AreaChart-1::Smooth           TO    FUNCTION TRIM(WS-FLAG)

           SET     WS-MSG                        TO    "Smooth = "
           STRING    FUNCTION TRIM(WS-MSG) FUNCTION TRIM(WS-FLAG) INTO WS-OUT
           SET     Label-STATUS::Caption         TO    FUNCTION TRIM(WS-OUT)
           DISPLAY    FUNCTION TRIM(WS-OUT).
]]></Event>
  </Control>
  <Control id="Button-CHART-SLICES" type="Button" x="1032" y="632" w="236" h="40" tab-order="0" z-order="16" visible="true" enabled="true">
    <Property name="Caption">Pie / Donut: labels and hole</Property>
    <Property name="BackgroundColor">#36383EFF</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#4E4E4EFF</Property>
    <Property name="BackgroundGradientEndColor">#000000FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">13</Property>
    <Property name="Transparency">63</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000FF</Property>
    <Property name="ShadowLightColor">#4E4E4EFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="CornerRadius">10</Property>
    <Event name="onClick" paragraph="BUTTON-CHART-SLICES--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-FMT                                 PIC    X(12).
       01 WS-HOLE                                PIC    9(3).
       01 WS-HOLE-TEXT                           PIC    ZZ9.
       01 WS-MSG                                 PIC    X(32).
       01 WS-OUT                                 PIC    X(80).

       LINKAGE SECTION.

       PROCEDURE DIVISION.

           *> LabelFormat is percent | value | label, and InnerRadius is the
           *> donut's hole as a percentage of the outer radius. Each press moves
           *> both on one step.

           SET     WS-FMT                        TO    PieChart-1::LabelFormat
           EVALUATE    FUNCTION TRIM(WS-FMT)
               WHEN "percent" MOVE "value" TO WS-FMT
               WHEN "value" MOVE "label" TO WS-FMT
               WHEN OTHER MOVE "percent" TO WS-FMT
           END-EVALUATE

           SET     PieChart-1::LabelFormat       TO    FUNCTION TRIM(WS-FMT)
           SET     DonutChart-1::LabelFormat     TO    FUNCTION TRIM(WS-FMT)

           SET     WS-HOLE                       TO    DonutChart-1::InnerRadius
           EVALUATE    WS-HOLE
               WHEN 40 MOVE 60 TO WS-HOLE
               WHEN 60 MOVE 20 TO WS-HOLE
               WHEN OTHER MOVE 40 TO WS-HOLE
           END-EVALUATE
           SET     DonutChart-1::InnerRadius     TO    WS-HOLE

           SET     WS-HOLE-TEXT                  TO    WS-HOLE
           SET     WS-MSG                        TO    "LabelFormat "

           STRING    FUNCTION TRIM(WS-MSG)
               FUNCTION TRIM(WS-FMT)
               ", InnerRadius "
               FUNCTION TRIM(WS-HOLE-TEXT)
               INTO WS-OUT
           SET     Label-STATUS::Caption         TO    FUNCTION TRIM(WS-OUT)
           DISPLAY    FUNCTION TRIM(WS-OUT).
]]></Event>
  </Control>
  <Control id="Button-CHART-ANIMMS" type="Button" x="24" y="680" w="952" h="40" tab-order="0" z-order="17" visible="true" enabled="true">
