<?xml version="1.0" encoding="UTF-8"?>
<Form name="CHARTS-FORM" title="Charts - the six types" width="1296" height="816" background="36383EFF" background-gradient-enabled="true" background-gradient-start="#010101FF" background-gradient-end="#310B0BFF" background-gradient-direction="South" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" glass-style="Neumorphic Dark" background-image="assets/images/bg18.png" bg-image-mode="Stretch" form-format="Both" index-base="1">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
