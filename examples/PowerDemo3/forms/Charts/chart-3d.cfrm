    <Property name="BorderGradientEndColor">#8FB4FF</Property>
    <Property name="BorderGradientDirection">South</Property>
    <Property name="BorderBlur">0</Property>
    <Property name="BorderTransparency">0</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="RotateX">0</Property>
    <Property name="RotateY">-5</Property>
    <Property name="PerspectiveDistance">50</Property>
    <Property name="PerspectiveStrength">100</Property>
    <Property name="PinTopLeftX">3</Property>
    <Property name="PinTopLeftY">-9</Property>
    <Property name="PinTopRightX">19</Property>
    <Property name="PinTopRightY">-2</Property>
    <Property name="PinBottomRightX">0</Property>
    <Property name="PinBottomRightY">0</Property>
    <Property name="PinBottomLeftX">-13</Property>
    <Property name="PinBottomLeftY">-27</Property>
  </Control>
  <Control id="Timer-1" type="Timer" x="1136" y="16" w="48" h="48" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="Interval">2100</Property>
    <Property name="Enabled">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onTick" paragraph="TIMER-1--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-I                                   PIC    9(3).
       01 WS-C                                   PIC    9(3).
       01 WS-K                                   PIC    9(3).
       01 WS-STEP                                PIC    S9(4).
       01 WS-NEW                                 PIC    S9(4).
       01 WS-SEED                                PIC    9(8).
       01 WS-MS-TAB.
           05 WS-MS                              PIC    9(5)    OCCURS 4.

       LINKAGE SECTION.

       PROCEDURE DIVISION.

           *> One tick every 2.1 seconds is one cycle. Every cycle gives each chart a new series,
           *> and every 3rd cycle gives all four charts new colours.
           *>
           *> The values live in WS-VAL (form-level, so they last from tick to tick) and drift: each
           *> one starts from where it was and moves a little, which reads as data changing rather
           *> than as dice. Where each chart's values sit in WS-VAL:
           *>    1 ..  8  BarChart-1    4 quarters x 2 series (quarter q: 2q - 1 and 2q)
           *>    9 .. 13  PieChart-1    5 slices
           *>   14 .. 25  RadarChart-1  6 axes x 2 series (axis a: 2a + 12 and 2a + 13)
           *>   26 .. 37  LineChart-1   12 months
           *> WS-LABEL holds their names in the same order: 1 .. 4, 5 .. 9, 10 .. 15 and 16 .. 27.

           ADD    1 TO WS-CYCLE

           IF    WS-CYCLE = 1

               *> First tick. An unseeded RANDOM gives the same numbers on every run, so seed it
               *> from the clock (the first number it returns is thrown away), then start every
               *> value somewhere between 30 and 79.

               ACCEPT    WS-SEED FROM TIME
               COMPUTE    WS-STEP = FUNCTION RANDOM(WS-SEED)

               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 37
                   COMPUTE    WS-VAL(WS-I) = FUNCTION RANDOM * 50 + 30
               END-PERFORM

               PERFORM    VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 4
                   SET     WS-OWED(WS-C)         TO    0
               END-PERFORM
           ELSE

               *> Every other tick: each value moves by -18 to +18, with a pull of one sixth of the
               *> way back towards the middle (52) - without it the values wander into 8 or 96 and
               *> stay there - and stays between 8 and 96.

               PERFORM    VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 37
                   COMPUTE    WS-STEP = FUNCTION RANDOM * 37
                   COMPUTE    WS-NEW = WS-VAL(WS-I) + WS-STEP - 18 + (52 - WS-VAL(WS-I)) / 6

                   IF    WS-NEW < 8
                       SET     WS-NEW            TO    8
                   END-IF

                   IF    WS-NEW > 96
                       SET     WS-NEW            TO    96
                   END-IF

                   SET     WS-VAL(WS-I)          TO    WS-NEW
               END-PERFORM
           END-IF

           *> How each chart arrives this cycle, chosen chart by chart. Most travel to their new
           *> values over 0.8 to 1.9 seconds, a different length each time and always shorter than
           *> the 2.1 second tick, so a move has ended before the next one starts. About one in
           *> three is cut instead: it shows its new values at once (250 ms is the shortest move a
           *> chart makes, the nearest AnimateValues gets to a cut) and WS-OWED(chart) = 1 makes
           *> sure that chart travels on the next cycle.

           PERFORM    VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 4
               IF    WS-OWED(WS-C) = 1 OR FUNCTION RANDOM >= 0.35
                   COMPUTE    WS-MS(WS-C) = FUNCTION RANDOM * 1100 + 800

                   SET     WS-OWED(WS-C)         TO    0
               ELSE
                   SET     WS-MS(WS-C)           TO    250
                   SET     WS-OWED(WS-C)         TO    1
               END-IF
           END-PERFORM

           *> Every 3rd cycle: new colours. The step is 1 to 5, so the palette is never the one it
           *> was. The bar chart colours its series from SeriesColors; the pie, the radar and the
           *> line are Monochrome, so they take one colour each - the 1st, 2nd and 3rd of the
           *> palette.

           IF    FUNCTION MOD(WS-CYCLE, 3) = 0
               COMPUTE    WS-STEP = FUNCTION RANDOM * 5 + 1
               COMPUTE    WS-PAL = FUNCTION MOD(WS-PAL - 1 + WS-STEP, 6) + 1

               SET     BarChart-1::SeriesColors  TO    WS-PALETTE(WS-PAL)

               SET     PieChart-1::MonochromeColor
                                                 TO    WS-PALETTE(WS-PAL)(1:7)

               SET     RadarChart-1::MonochromeColor
                                                 TO    WS-PALETTE(WS-PAL)(9:7)

               SET     LineChart-1::MonochromeColor
                                                 TO    WS-PALETTE(WS-PAL)(17:7)
           END-IF

           *> BarChart-1: four quarters, two series.

           SET     BarChart-1::AnimationDuration TO    WS-MS(1)
           BarChart-1::Clear()

           PERFORM    VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 4
               COMPUTE    WS-K = WS-C * 2 - 1
               BarChart-1::AddPoint(WS-LABEL(WS-C)::Trim(), WS-VAL(WS-K), WS-VAL(WS-K + 1))
           END-PERFORM

           *> PieChart-1: five slices.

           SET     PieChart-1::AnimationDuration TO    WS-MS(2)
           PieChart-1::Clear()

           PERFORM    VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 5
               PieChart-1::AddPoint(WS-LABEL(WS-C + 4)::Trim(), WS-VAL(WS-C + 8))
           END-PERFORM

           *> RadarChart-1: six axes, two series.

           SET     RadarChart-1::AnimationDuration
                                                 TO    WS-MS(3)

           RadarChart-1::Clear()

           PERFORM    VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 6
               COMPUTE    WS-K = WS-C * 2 + 12
               RadarChart-1::AddPoint(WS-LABEL(WS-C + 9)::Trim(), WS-VAL(WS-K), WS-VAL(WS-K + 1))
           END-PERFORM

           *> LineChart-1: twelve months.

           SET     LineChart-1::AnimationDuration
                                                 TO    WS-MS(4)

           LineChart-1::Clear()

           PERFORM    VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 12
               LineChart-1::AddPoint(WS-LABEL(WS-C + 15)::Trim(), WS-VAL(WS-C + 25))
           END-PERFORM.
]]></Event>
  </Control>
</Form>