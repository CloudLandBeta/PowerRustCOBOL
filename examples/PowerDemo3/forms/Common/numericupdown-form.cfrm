  <Control id="Lbl-Total-Cap" type="Label" x="552" y="134" w="240" h="20" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Order total  (read-only)</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
