    <Event name="onCheckedChanged" paragraph="CHK-PUSH--ONCHECKEDCHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-LINE PIC X(160).
