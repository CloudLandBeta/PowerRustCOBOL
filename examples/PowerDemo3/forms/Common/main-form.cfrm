<?xml version="1.0" encoding="UTF-8"?>
<Form name="MAIN-FORM" title="VIEWER-FORM" width="1024" height="768" background="EAEBEFFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="neumorphic" glass-style="Neumorphic Light">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
