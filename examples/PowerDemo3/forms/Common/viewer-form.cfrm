    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Event name="onClick" paragraph="BTN-SAVE--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-NL PIC X.
       PROCEDURE DIVISION.
           MOVE FUNCTION CHAR(11) TO WS-NL.
      *> R18: Save As writes the ORIGINAL bytes, untouched. What is
      *> on screen is a derived reading of the stored form, never a
      *> replacement for it, so the copy is byte-identical.
           VWR-1::SaveAs().
           Txt-Log::AppendText("Save As requested").
           Txt-Log::AppendText(WS-NL).
]]></Event>
  </Control>
