    <Event name="onClosed" paragraph="SNACKBAR-1--ONCLOSED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.

      *> The reason arrives as the event value: Timeout / User / Action /
      *> Programmatic / Overflow.
           DISPLAY "onClosed".
]]></Event>
    <Event name="onButtonClick" paragraph="SNACKBAR-1--ONBUTTONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.

           EVALUATE SNACKBAR-1::LastButtonId
               WHEN "retry"
                   DISPLAY "button: retry (this one dismisses)"
               WHEN "later"
                   DISPLAY "button: later (this one stays up)"
               WHEN OTHER
                   DISPLAY "button: " SNACKBAR-1::LastButtonId
           END-EVALUATE.
]]></Event>
  </Control>
