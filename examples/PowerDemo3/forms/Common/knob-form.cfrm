    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">10</Property>
  </Control>
  <Control id="Lbl-Sub" type="Label" x="32" y="54" w="936" h="38" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">A Knob is a rotary value: drag it round and Value follows, between Minimum and Maximum. Bipolar draws the travel out from the centre rather than from the left, which is what a trim or a pan control wants. DefaultValue is where a reset puts it.</Property>
