    <Event name="onLoad" paragraph="LABELS-FORM--ONLOAD">
    </Event>
    <Event name="onClose" paragraph="LABELS-FORM--ONCLOSE">
    </Event>
  </form-events>
  <Control id="LBL-01" type="Label" x="52" y="112" w="144" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Lorem</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#7A1F1F</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">43</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Center</Property>
    <Property name="WordWrap">false</Property>
    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">10</Property>
    <Event name="onMouseEnter" paragraph="LBL-01--ONMOUSEENTER"><![CDATA[
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.

       PROCEDURE DIVISION.
           SET LBL-01::ShadowEnabled TO 0.
]]></Event>
    <Event name="onMouseLeave" paragraph="LBL-01--ONMOUSELEAVE"><![CDATA[
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.

       PROCEDURE DIVISION.
           SET LBL-01::ShadowEnabled TO 1.
]]></Event>
  </Control>
