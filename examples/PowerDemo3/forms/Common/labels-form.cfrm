<?xml version="1.0" encoding="UTF-8"?>
<Form name="LABELS-FORM" title="Labels Demo" width="920" height="624" background="DFDFDFFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" glass-style="Neumorphic Light" form-format="Both">
