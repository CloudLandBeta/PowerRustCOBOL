  <Control id="BTN-ROUTE" type="Button" x="944" y="204" w="320" h="32" tab-order="4" z-order="4" visible="true" enabled="true">
    <Property name="Caption">3 — Planned corridor (no key)</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#FFFFFFFF</Property>
    <Property name="BackgroundGradientEndColor">#FBFBFBFF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="FontSize">16</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onClick" paragraph="BTN-ROUTE--CLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.

       LINKAGE SECTION.

       PROCEDURE DIVISION.

           *> AddRoute(id, colour, width, geometry).
           *>
           *> A PLANNED CORRIDOR, not a traced road — and the difference is the
           *> lesson. The geometry below is EIGHT waypoints written by hand down the
           *> A-4/A-44, so this button needs no credential and works offline; the map
           *> draws every point given to it and invents none, which is why eight
           *> points cut every curve between them. Zoom in and the blue line leaves
           *> the tarmac. That is not a fault to fix here: no setting turns a sparse
           *> waypoint list into a road.
           *>
           *> Press button 4 next. It asks Google and draws the ROAD over this, in
           *> green, following it turn by turn — the two lines side by side are what
           *> "geometry you wrote" versus "geometry a routing service returned"
           *> actually looks like.

           MAP-1::AddRoute( "PLANNED" "#1E6EDC" "5"
               "40.4168,-3.7038;40.0300,-3.6000;39.4600,-3.5300;38.9900,-3.3700;38.7600,-3.3800;38.1000,-3.7700;37.7700,-3.7900;37.1773,-3.5986" )

           MAP-1::AddMarker( "ORIGEN" "40.4168" "-3.7038" "Madrid" "Origin" )
           MAP-1::AddMarker( "DESTINO" "37.1773" "-3.5986" "Granada" "Destination" )

           SET     MAP-1::CenterLat              TO    "37.9000"
           SET     MAP-1::CenterLng              TO    "-3.6500"
           SET     MAP-1::Zoom                   TO    7
           SET     LBL-STATUS::Caption           TO    "Planned corridor: 8 hand-written waypoints, no key. It cuts the curves - button 4 draws the real road over it."
]]></Event>
  </Control>
  <Control id="BTN-DRIVE" type="Button" x="944" y="262" w="320" h="32" tab-order="5" z-order="5" visible="true" enabled="true">
    <Property name="Caption">4 — Real road + drive time (needs key)</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#FFFFFFFF</Property>
    <Property name="BackgroundGradientEndColor">#FBFBFBFF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="FontSize">16</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onClick" paragraph="BTN-DRIVE--CLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.

       LINKAGE SECTION.

       PROCEDURE DIVISION.

           *> ASYNCHRONOUS. This returns immediately with an empty string and sets
           *> Busy to 1; the answer arrives on onComplete, above. Needs the Google
           *> Maps API key in Settings -> Integrations; without one it fails on
           *> onError instead of attempting a call.

           SET     WS-PROVIDER                   TO    "G"
           SET     LBL-STATUS::Caption           TO    "Asking Google for the drive time..."

           MAP-1::Directions( "Madrid, Spain" "Granada, Spain" )
]]></Event>
  </Control>
  <Control id="BTN-CLEAR" type="Button" x="944" y="320" w="320" h="32" tab-order="6" z-order="6" visible="true" enabled="true">
    <Property name="Caption">5 — Clear everything</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#FFFFFFFF</Property>
    <Property name="BackgroundGradientEndColor">#FBFBFBFF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="BackgroundColor">#E1E6F8FF</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="FontSize">16</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onClick" paragraph="BTN-CLEAR--CLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.

       LINKAGE SECTION.

       PROCEDURE DIVISION.

           *> Routes and regions have Clear methods; markers do not, so the pins
           *> go by blanking the Markers property. Centre and zoom return to the
           *> view that onLoad set.

           MAP-1::ClearRoutes()
           MAP-1::ClearRegions()

           SET     MAP-1::Markers                TO    SPACES
           SET     MAP-1::CenterLat              TO    "40.0000"
           SET     MAP-1::CenterLng              TO    "-3.7000"
           SET     MAP-1::Zoom                   TO    6
           SET     LBL-KM::Caption               TO    SPACES
           SET     LBL-MIN::Caption              TO    SPACES
           SET     LBL-COST::Caption             TO    SPACES
           SET     LBL-STATUS::Caption           TO    "Cleared."
]]></Event>
  </Control>
