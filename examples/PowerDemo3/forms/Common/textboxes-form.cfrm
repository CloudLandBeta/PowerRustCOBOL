    <DeletedControl id="txt9" deleted-at="designer-delete-1785505913-8">
      <Event name="onChange" paragraph="TXT9--ONCHANGE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-CHAR                                PIC    X.
       01 WS-IDX                                 PIC    9(4)    COMP-5.
       01 WS-RES                                 PIC    X(255).

       PROCEDURE DIVISION.
           INITIALIZE    WS-RES
           SET     WS-IDX                        TO    1
           PERFORM    UNTIL WS-IDX > FUNCTION LENGTH(txt9::Text)
               SET     WS-CHAR                   TO    FUNCTION SUBSTRING(txt9::Text, WS-IDX, 1)
               IF    FUNCTION UPPER-CASE(WS-CHAR) = WS-CHAR
                   SET     WS-CHAR               TO    FUNCTION LOWER-CASE(WS-CHAR)
               ELSE
                   SET     WS-CHAR               TO    FUNCTION UPPER-CASE(WS-CHAR)
               END-IF
               STRING    WS-CHAR DELIMITED BY SIZE INTO WS-RES
               ADD    1 TO WS-IDX
           END-PERFORM
           SET     txt9::Text                    TO    WS-RES
           PERFORM    UPDATE-CONCATENATION
           CONTINUE.
]]></Event>
    </DeletedControl>
