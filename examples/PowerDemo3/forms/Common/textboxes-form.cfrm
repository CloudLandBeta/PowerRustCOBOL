    <DeletedControl id="txt9" deleted-at="designer-delete-1785505913-8">
      <Event name="onChange" paragraph="TXT9--ONCHANGE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CHAR PIC X.
       01  WS-IDX  PIC 9(4) COMP-5.
       01  WS-RES  PIC X(255).
       
       PROCEDURE DIVISION.
           INITIALIZE WS-RES.
           MOVE 1 TO WS-IDX.
           PERFORM UNTIL WS-IDX > FUNCTION LENGTH(txt9::Text)
               MOVE FUNCTION SUBSTRING(txt9::Text, WS-IDX, 1) TO WS-CHAR
               IF FUNCTION UPPER-CASE(WS-CHAR) = WS-CHAR
                   MOVE FUNCTION LOWER-CASE(WS-CHAR) TO WS-CHAR
               ELSE
                   MOVE FUNCTION UPPER-CASE(WS-CHAR) TO WS-CHAR
               END-IF
               STRING WS-CHAR DELIMITED BY SIZE INTO WS-RES
               ADD 1 TO WS-IDX
           END-PERFORM.
           MOVE WS-RES TO txt9::Text.
           PERFORM UPDATE-CONCATENATION.
           CONTINUE.]]></Event>
    </DeletedControl>
