    <Event name="onTextChanged" paragraph="TXT15--ONTEXTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-FULL-TEXT                           PIC    X(2000).

       PROCEDURE DIVISION.
           INITIALIZE    WS-FULL-TEXT
           STRING    txt1::Text " "

           txt2::Text " "
