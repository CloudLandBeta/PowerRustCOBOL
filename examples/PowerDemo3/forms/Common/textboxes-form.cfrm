    <Event name="onTextChanged" paragraph="TXT6--ONTEXTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-TEXT  PIC X(255).

       PROCEDURE DIVISION.
           MOVE txt6::Text TO WS-TEXT
           IF WS-TEXT NOT = SPACES
               MOVE "#FFFF00" TO txt6::ForegroundColor
           END-IF
           MOVE "Altera a cor da fonte para amarelo se não estiver vazio" TO Label-1::Caption.]]></Event>
  </Control>
