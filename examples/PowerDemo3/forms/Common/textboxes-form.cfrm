           txt15::Text
               INTO WS-FULL-TEXT

           SET     lblSummary::Caption           TO    WS-FULL-TEXT
           SET     Label-1::Caption              TO    "Concatena todos os campos no lblSummary".
]]></Event>
  </Control>
