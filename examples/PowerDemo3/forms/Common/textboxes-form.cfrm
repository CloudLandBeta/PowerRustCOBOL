<?xml version="1.0" encoding="UTF-8"?>
<Form name="TEXTBOXES-FORM" title="Textbox Demo" width="802" height="573" background="36383EFF" background-gradient-enabled="true" background-gradient-start="#4E4E4EFF" background-gradient-end="#000000FF" background-gradient-direction="South" transparency="0" grid-size="8" snap-to-grid="false" target="Custom" glass-style="Neumorphic Dark" form-format="Embedded" x="107" y="127" start-position="Center">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
           CLASS RUST-I64 IS "Rust.i64"
