    <Event name="onClick" paragraph="BUTTON-1--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-SUMMARY                             PIC    X(2000).
       01 WS-TEMP-VAL                            PIC    X(255).

       PROCEDURE DIVISION.
           INITIALIZE    WS-SUMMARY

           *> Collect and concatenate txt1 through txt15

           STRING    "txt1=" txt1::Text " "
               "txt2=" txt2::Text " "
               "txt3=" txt3::Text " "
               "txt4=" txt4::Text " "
               "txt5=" txt5::Text " "
               "txt6=" txt6::Text " "
               "txt7=" txt7::Text " "
               "txt8=" txt8::Text " "
               "txt9=" txt9::Text " "
               "txt10=" txt10::Text " "
               "txt11=" txt11::Text " "
               "txt12=" txt12::Text " "
               "txt13=" txt13::Text " "
               "txt14=" txt14::Text " "
               "txt15=" txt15::Text
               INTO WS-SUMMARY

           SET     lblSummary::Caption           TO    WS-SUMMARY
           SET     Label-1::Caption              TO    "Summary generated successfully".
]]></Event>
  </Control>
