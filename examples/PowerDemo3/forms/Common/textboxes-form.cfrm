  <Control id="txt3" type="TextBox" x="543" y="63" w="200" h="30" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="BackgroundColor">#555555</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#4E4E4EFF</Property>
    <Property name="BackgroundGradientEndColor">#000000FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">16</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000FF</Property>
    <Property name="ShadowLightColor">#4E4E4EFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="Text">Field 3</Property>
    <Property name="TextAlignment">Right</Property>
    <Property name="VerticalAlignment">Middle</Property>
    <Property name="InnerPadding">3</Property>
    <Property name="MaximumLength">0</Property>
    <Property name="Multiline">false</Property>
    <Property name="ReadOnly">false</Property>
    <Property name="ScrollBars">None</Property>
    <Property name="WordWrap">true</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#6C6C6CFF</Property>
    <Property name="CornerRadius">10</Property>
    <Event name="onClick" paragraph="TXT3--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-SIZE                                PIC    S9(4)    COMP-5.

       PROCEDURE DIVISION.
           SET     WS-SIZE                       TO    txt3::FontSize
           SUBTRACT    2 FROM WS-SIZE

           SET     txt3::FontSize                TO    WS-SIZE
           SET     Label-1::Caption              TO    "Diminui o tamanho da fonte em 2 unidades".
]]></Event>
  </Control>
