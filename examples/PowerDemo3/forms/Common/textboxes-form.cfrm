    <Event name="onTextChanged" paragraph="TXT10--ONTEXTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.
       01 WS-LEN                                 PIC    S9(4)    COMP-5.

       PROCEDURE DIVISION.
           COMPUTE    WS-LEN = FUNCTION LENGTH(txt10::Text)
           IF    WS-LEN > 10
               SET     txt10::Bold               TO    1
           ELSE
               SET     txt10::Bold               TO    0
           END-IF
           SET     Label-1::Caption              TO    "Ativa o negrito se o texto tiver mais de 10 caracteres".
]]></Event>
  </Control>
