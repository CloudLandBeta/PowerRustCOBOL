    <DeletedControl id="txt8" deleted-at="designer-delete-1785461358-7">
      <Event name="onChange" paragraph="TXT8--ONCHANGE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-TEMP-TEXT  PIC X(100).
       
       PROCEDURE DIVISION.
           IF FUNCTION TRIM(txt8::Text) NOT ALike "ID: %*"
               MOVE FUNCTION CONCATENATE("ID: ", txt8::Text) TO WS-TEMP-TEXT
               MOVE WS-TEMP-TEXT TO txt8::Text
           END-IF.
           CALL "UPDATE-CONCATENATION".
           CONTINUE.]]></Event>
    </DeletedControl>
