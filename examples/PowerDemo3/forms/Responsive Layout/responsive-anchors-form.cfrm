<?xml version="1.0" encoding="UTF-8"?>
<Form name="RESPONSIVE-ANCHORS-FORM" title="Responsive - anchors and size limits" width="1000" height="700" background="#F4F6F9FF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" form-format="Both" responsive="true" control-style="modern" index-base="1">
  <working-storage><![CDATA[       01 WS-NUM                                 GLOBAL    PIC 9(5).
       01 WS-WIN-W                               GLOBAL    PIC Z(4)9.
       01 WS-WIN-H                               GLOBAL    PIC Z(4)9.
       01 WS-BP                                  GLOBAL    PIC X(20).
       01 WS-FSC                                 GLOBAL    PIC X(12).
       01 WS-LINE                                GLOBAL    PIC X(200).
       01 WS-ANCHOR                              GLOBAL    PIC X(40).
       01 WS-PTR                                 GLOBAL    PIC 99.
]]></working-storage>
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
