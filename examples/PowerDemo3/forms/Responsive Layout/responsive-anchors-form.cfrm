  <Control id="CHK-TOP" type="CheckBox" x="656" y="146" w="140" h="28" tab-order="1" z-order="16" visible="true" enabled="true" parent="PNL-LIVE">
    <Property name="Caption">Top</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#1F2933FF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">13</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Tooltip"></Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">100</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="EnterAsTab">true</Property>
    <Property name="Checked">true</Property>
    <Property name="CheckAlignment">Left</Property>
    <Property name="CheckColor">#0078D7</Property>
    <Property name="CheckSize">70</Property>
    <Property name="CheckSpacing">6</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderColor">#8C8CA0</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="CheckBoxColor"></Property>
    <Property name="CheckBoxBorderStyle">None</Property>
    <Property name="CheckBoxBorderColor">#8C8CA0</Property>
    <Property name="CheckBoxBorderWidth">1</Property>
    <Property name="CornerRadius">0</Property>
    <Event name="onCheckedChanged" paragraph="CHK-TOP--ONCHECKEDCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> ANC-APPLY-LIVE: applies the four anchor check boxes to the live label A-LIVE.
           *> Uses:   CHK-TOP, CHK-BOTTOM, CHK-LEFT and CHK-RIGHT::Checked (1 = ticked); CHK-TOP is
           *>         the box whose onCheckedChanged fired (the operator's click, or the Reset
           *>         button writing it).
           *> Result: WS-ANCHOR = the ticked names in the order Top, Bottom, Left, Right, each
           *>         followed by a comma (Top and Left give "Top,Left,"). A-LIVE::Anchor =
           *>         WS-ANCHOR. A-LIVE::Caption = "Live: (none)" when nothing is ticked, otherwise
           *>         "Live: " + WS-ANCHOR. WS-PTR (and WS-LINE when something is ticked) are left
           *>         as work values.

           CALL    "ANC-APPLY-LIVE"
]]></Event>
  </Control>
