]]></repository>
  <user-procedures>
    <Event name="ANC-SHOW-INFO" paragraph="ANC-SHOW-INFO"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Window size, active breakpoint and font scale, as the
           *> layout engine reports them after laying the form out.

           SET     WS-LINE                       TO    SPACES
           STRING    "Window " WS-WIN-W::Trim()
               " x " WS-WIN-H::Trim()
               "   |   breakpoint " WS-BP::Trim()
               "   |   font scale " WS-FSC::Trim()
               INTO WS-LINE
           SET     SB-INFO::Items                TO    WS-LINE
]]></Event>
    <Event name="ANC-APPLY-LIVE" paragraph="ANC-APPLY-LIVE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           *> Build the anchor text from the four check boxes and give it
           *> to the live block. An empty text means no edge on either axis.

           SET     WS-ANCHOR                     TO    SPACES
           SET     WS-PTR                        TO    1

           *> WITH POINTER makes each name append after the previous one; without
           *> it every STRING would restart at column 1 and overwrite the text.

           IF    CHK-TOP::Checked = 1
               STRING    "Top," INTO WS-ANCHOR
                   WITH POINTER WS-PTR
           END-IF
           IF    CHK-BOTTOM::Checked = 1
               STRING    "Bottom," INTO WS-ANCHOR
                   WITH POINTER WS-PTR
           END-IF
           IF    CHK-LEFT::Checked = 1
               STRING    "Left," INTO WS-ANCHOR
                   WITH POINTER WS-PTR
           END-IF
           IF    CHK-RIGHT::Checked = 1
               STRING    "Right," INTO WS-ANCHOR
                   WITH POINTER WS-PTR
           END-IF
           SET     A-LIVE::Anchor                TO    WS-ANCHOR
           IF    WS-ANCHOR = SPACES
               SET     A-LIVE::Caption           TO    "Live: (none)"
           ELSE
               SET     WS-LINE                   TO    SPACES
               STRING    "Live: " WS-ANCHOR DELIMITED BY SIZE INTO WS-LINE
               SET     A-LIVE::Caption           TO    WS-LINE
           END-IF
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="RESPONSIVE-ANCHORS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-NUM                        TO    me::Width
           SET     WS-WIN-W                      TO    WS-NUM
           SET     WS-NUM                        TO    me::Height
           SET     WS-WIN-H                      TO    WS-NUM
           SET     WS-BP                         TO    me::Breakpoint
           SET     WS-FSC                        TO    me::FontScale

           *> ANC-SHOW-INFO: shows the window size, breakpoint and font scale in the status bar.
           *> Uses:   WS-WIN-W and WS-WIN-H (me::Width and me::Height, shown through Z(4)9), WS-BP
           *>         (me::Breakpoint) and WS-FSC (me::FontScale), copied just above as the form
           *>         loads.
           *> Result: WS-LINE = "Window <W> x <H>   |   breakpoint <BP>   |   font scale <FSC>"
           *>         (parts trimmed); SB-INFO::Items = WS-LINE. No other data item changes.

           CALL    "ANC-SHOW-INFO"
]]></Event>
    <Event name="onClose" paragraph="RESPONSIVE-ANCHORS-FORM--ONCLOSE">
    </Event>
    <Event name="onResize" paragraph="RESPONSIVE-ANCHORS-FORM--ONRESIZE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-NUM                        TO    me::Width
           SET     WS-WIN-W                      TO    WS-NUM
           SET     WS-NUM                        TO    me::Height
           SET     WS-WIN-H                      TO    WS-NUM
           SET     WS-BP                         TO    me::Breakpoint
           SET     WS-FSC                        TO    me::FontScale

           *> ANC-SHOW-INFO: shows the window size, breakpoint and font scale in the status bar.
           *> Uses:   WS-WIN-W and WS-WIN-H (me::Width and me::Height, shown through Z(4)9), WS-BP
           *>         (me::Breakpoint) and WS-FSC (me::FontScale), copied just above after the
           *>         resize settled.
           *> Result: WS-LINE = "Window <W> x <H>   |   breakpoint <BP>   |   font scale <FSC>"
           *>         (parts trimmed); SB-INFO::Items = WS-LINE. No other data item changes.

           CALL    "ANC-SHOW-INFO"
]]></Event>
    <Event name="onBreakpointChanged" paragraph="RESPONSIVE-ANCHORS-FORM--ONBREAKPOINTCHANGED"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.
           SET     WS-NUM                        TO    me::Width
           SET     WS-WIN-W                      TO    WS-NUM
           SET     WS-NUM                        TO    me::Height
           SET     WS-WIN-H                      TO    WS-NUM
           SET     WS-BP                         TO    me::Breakpoint
           SET     WS-FSC                        TO    me::FontScale

           *> ANC-SHOW-INFO: shows the window size, breakpoint and font scale in the status bar.
           *> Uses:   WS-WIN-W and WS-WIN-H (me::Width and me::Height, shown through Z(4)9), WS-BP
           *>         (me::Breakpoint) and WS-FSC (me::FontScale), copied just above after the
           *>         window crossed into another breakpoint (WS-BP is the new one).
           *> Result: WS-LINE = "Window <W> x <H>   |   breakpoint <BP>   |   font scale <FSC>"
           *>         (parts trimmed); SB-INFO::Items = WS-LINE. No other data item changes.

           CALL    "ANC-SHOW-INFO"
]]></Event>
  </form-events>
