    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="Minimum">0</Property>
    <Property name="Maximum">100</Property>
    <Property name="Value">55</Property>
    <Property name="Step">1</Property>
    <Property name="LargeChange">10</Property>
    <Property name="Orientation">Horizontal</Property>
    <Property name="TickFrequency">10</Property>
    <Property name="TickStyle">Bottom</Property>
    <Property name="TrackColor">#AAAAAA</Property>
    <Property name="ThumbColor">#0078D7</Property>
    <Property name="FillColor">#2C7BE5</Property>
    <Property name="ShowValue">false</Property>
    <Property name="CornerRadius">10</Property>
    <Event name="onChange" paragraph="SLD-DIM--ONCHANGE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> A layer has properties like a control. Transparency 0 with a fully opaque colour makes
           *> the layer opaque: it then shields everything below it. Anything above 0 does not.

           MOVE    SLD-DIM::Value                TO    HELP-LAYER::Transparency
           MOVE    SPACES                        TO    LBL-DIM::Caption
           STRING    "HELP-LAYER::Transparency = " SLD-DIM::Value
               DELIMITED BY SIZE INTO LBL-DIM::Caption
]]></Event>
  </Control>
  <Control id="BTN-HELP-CLOSE" type="Button" x="894" y="558" w="140" h="40" tab-order="5" z-order="5" visible="true" enabled="true" parent="PNL-HELP">
    <Property name="Caption">Close</Property>
    <Property name="BackgroundColor">#36383EFF</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
