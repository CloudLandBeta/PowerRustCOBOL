<?xml version="1.0" encoding="UTF-8"?>
<Form name="LAYERS-FORM" title="Layers" width="1100" height="660" background="36383EFF" background-gradient-enabled="true" background-gradient-start="#4E4E4EFF" background-gradient-end="#000000FF" background-gradient-direction="South" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" theme="cobalt-steel" glass-style="Neumorphic Dark" modal-overlay-style="Greyed" form-format="Both" index-base="1">
  <Layer name="HELP-LAYER" color="#16264DFF" transparency="55"/>
  <Layer name="BUSY-LAYER" color="#0B1220FF"/>
  <Layer name="ERROR-LAYER" color="#00000000"/>
  <FormLayout FontScaling="Fluid" MinFontScale="1" MaxFontScale="1.6"/>
  <user-procedures>
    <Event name="LAYERS-SHOW-STATE" paragraph="LAYERS-SHOW-STATE"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> A layer is read by name like a control: Visible reads "true" or "false".
           *> The caption is cleared first, because STRING writes only the characters it
           *> has: a shorter text would otherwise keep the tail of the longer one before it.

           MOVE    SPACES                        TO    LBL-STATE::Caption
           STRING    "HELP-LAYER " HELP-LAYER::Visible "   BUSY-LAYER " BUSY-LAYER::Visible
                     "   ERROR-LAYER " ERROR-LAYER::Visible
               DELIMITED BY SIZE INTO LBL-STATE::Caption
]]></Event>
  </user-procedures>
  <form-events>
    <Event name="onLoad" paragraph="LAYERS-FORM--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.

       DATA DIVISION.

       PROCEDURE DIVISION.

           *> LAYERS-SHOW-STATE: writes into LBL-STATE which of the three layers is shown.
           *> Uses:   HELP-LAYER::Visible, BUSY-LAYER::Visible and ERROR-LAYER::Visible. Every layer
           *>         starts hidden when the program runs, so all three read false here.
           *> Result: LBL-STATE::Caption = "HELP-LAYER false   BUSY-LAYER false   ERROR-LAYER
           *>         false". No data item changes.

           CALL    "LAYERS-SHOW-STATE"
]]></Event>
  </form-events>
