<?xml version="1.0" encoding="UTF-8"?>
<Form name="CALL-FORM-DEMO" title="Call Form Demo" width="1000" height="600" background="EAEBEFFF" transparency="0" grid-size="8" snap-to-grid="true" target="Custom" glass-style="Neumorphic Light" form-format="Both">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
           CLASS RUST-I64 IS "Rust.i64"
           CLASS RUST-I128 IS "Rust.i128"
           CLASS RUST-ISIZE IS "Rust.isize"
           CLASS RUST-U8 IS "Rust.u8"
           CLASS RUST-U16 IS "Rust.u16"
           CLASS RUST-U32 IS "Rust.u32"
           CLASS RUST-U64 IS "Rust.u64"
           CLASS RUST-U128 IS "Rust.u128"
           CLASS RUST-USIZE IS "Rust.usize"
           CLASS RUST-F32 IS "Rust.f32"
           CLASS RUST-F64 IS "Rust.f64"
           CLASS RUST-STR IS "Rust.str"
           CLASS RUST-UNIT IS "Rust.unit"
           CLASS RUST-STRING IS "Rust.String"
           CLASS RUST-OSSTRING IS "Rust.OsString"
           CLASS RUST-OSSTR IS "Rust.OsStr"
           CLASS RUST-CSTRING IS "Rust.CString"
           CLASS RUST-CSTR IS "Rust.CStr"
           CLASS RUST-PATH IS "Rust.Path"
           CLASS RUST-PATHBUF IS "Rust.PathBuf"
           CLASS RUST-VEC IS "Rust.Vec"
           CLASS RUST-VECDEQUE IS "Rust.VecDeque"
           CLASS RUST-LINKEDLIST IS "Rust.LinkedList"
           CLASS RUST-HASHMAP IS "Rust.HashMap"
           CLASS RUST-BTREEMAP IS "Rust.BTreeMap"
           CLASS RUST-HASHSET IS "Rust.HashSet"
           CLASS RUST-BTREESET IS "Rust.BTreeSet"
           CLASS RUST-BINARYHEAP IS "Rust.BinaryHeap"
           CLASS RUST-OPTION IS "Rust.Option"
           CLASS RUST-RESULT IS "Rust.Result"
           CLASS RUST-BOX IS "Rust.Box"
           CLASS RUST-RC IS "Rust.Rc"
           CLASS RUST-ARC IS "Rust.Arc"
           CLASS RUST-WEAK IS "Rust.Weak"
           CLASS RUST-CELL IS "Rust.Cell"
           CLASS RUST-REFCELL IS "Rust.RefCell"
           CLASS RUST-MUTEX IS "Rust.Mutex"
           CLASS RUST-RWLOCK IS "Rust.RwLock"
           CLASS RUST-COW IS "Rust.Cow"
           CLASS RUST-DURATION IS "Rust.Duration"
           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"]]></repository>
  <form-events>
    <Event name="onLoad" paragraph="CALL-FORM-DEMO--ONLOAD">
    </Event>
    <Event name="onClose" paragraph="CALL-FORM-DEMO--ONCLOSE">
    </Event>
  </form-events>
  <Control id="Label-1" type="Label" x="40" y="32" w="600" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Call Form Demo</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="FontName">Arial Black</Property>
    <Property name="FontSize">32</Property>
    <Property name="Bold">true</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="VerticalAlignment">Middle</Property>
    <Property name="WordWrap">false</Property>
    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">10</Property>
  </Control>
  <Control id="Label-2" type="Label" x="40" y="104" w="900" h="72" tab-order="0" z-order="1" visible="true" enabled="true">
    <Property name="Caption">Click the button to open CALLED-FORM-DEMO as a modal window. Pick OK or Cancel there — the called form closes itself and sends back the text it chose; this form picks it up and shows it below.</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="VerticalAlignment">Top</Property>
    <Property name="WordWrap">true</Property>
    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">10</Property>
  </Control>
  <Control id="Button-1" type="Button" x="40" y="200" w="320" h="64" tab-order="0" z-order="2" visible="true" enabled="true">
    <Property name="Caption">Open Called Form</Property>
    <Property name="BackgroundColor">#36383EFF</Property>
    <Property name="BackgroundGradientEnabled">true</Property>
    <Property name="BackgroundGradientStartColor">#4E4E4EFF</Property>
    <Property name="BackgroundGradientEndColor">#000000FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">16</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">30</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000FF</Property>
    <Property name="ShadowLightColor">#747474FF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="IsDefault">false</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="IconAlignment">Left</Property>
    <Property name="IconPadding">10</Property>
    <Property name="IconSize">32</Property>
    <Property name="TextAlignment">MiddleCenter</Property>
    <Property name="CornerRadius">10</Property>
    <Event name="onClick" paragraph="BUTTON-1--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-H PIC X(8).
       PROCEDURE DIVISION.
      *> Sync is implicitly modal (developers-guide-en.md, "Opening forms
      *> from COBOL"): the whole face waits here until the called form
      *> closes. RETURNING is NULL by the time this resumes — the answer
      *> travels through super::"SetProperty" instead (see CALLED-FORM-DEMO's
      *> OK/Cancel handlers) and Tmr-Refresh picks it up right after.
           INVOKE ME::"OpenFormSync"("CALLED-FORM-DEMO") RETURNING WS-H.]]></Event>
  </Control>
  <Control id="Label-3" type="Label" x="40" y="304" w="500" h="32" tab-order="0" z-order="3" visible="true" enabled="true">
    <Property name="Caption">Result from the called form:</Property>
    <Property name="BackgroundColor">#00000000</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#000000</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">16</Property>
    <Property name="Bold">true</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="VerticalAlignment">Middle</Property>
    <Property name="WordWrap">false</Property>
    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">None</Property>
    <Property name="CornerRadius">10</Property>
  </Control>
  <Control id="Lbl-Result" type="Label" x="40" y="344" w="900" h="56" tab-order="0" z-order="4" visible="true" enabled="true">
    <Property name="Caption">(not called yet)</Property>
    <Property name="BackgroundColor">#FFFFFFFF</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F8F8F8FF</Property>
    <Property name="BackgroundGradientEndColor">#DFE0E1FF</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#1A1A1AFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">20</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">true</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">12</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">false</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="TextAlignment">Left</Property>
    <Property name="VerticalAlignment">Middle</Property>
    <Property name="WordWrap">false</Property>
    <Property name="AutoSize">false</Property>
    <Property name="BorderStyle">Solid</Property>
    <Property name="CornerRadius">10</Property>
  </Control>
  <Control id="Tmr-Refresh" type="Timer" x="40" y="424" w="48" h="48" tab-order="0" z-order="5" visible="true" enabled="true">
    <Property name="BackgroundColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEnabled">false</Property>
    <Property name="BackgroundGradientStartColor">#F0F0F0</Property>
    <Property name="BackgroundGradientEndColor">#C8D0DC</Property>
    <Property name="BackgroundGradientDirection">South</Property>
    <Property name="ForegroundColor">#FFFFFF</Property>
    <Property name="FontName">Arial</Property>
    <Property name="FontSize">14</Property>
    <Property name="Bold">false</Property>
    <Property name="Italic">false</Property>
    <Property name="Underline">false</Property>
    <Property name="Strikethrough">false</Property>
    <Property name="Cursor">Default</Property>
    <Property name="HoverDelayMs">200</Property>
    <Property name="Anchor">false</Property>
    <Property name="Padding">0</Property>
    <Property name="Transparency">0</Property>
    <Property name="ShadowEnabled">true</Property>
    <Property name="ShadowOpacity">6</Property>
    <Property name="ShadowColor">#000000</Property>
    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="Interval">200</Property>
    <Property name="Enabled">true</Property>
    <Property name="CornerRadius">10</Property>
    <Property name="BorderStyle">None</Property>
    <Event name="onTick" paragraph="TMR-REFRESH--ONTICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-RESULT PIC X(60).
       PROCEDURE DIVISION.
      *> The called form publishes its answer with
      *> INVOKE super::"SetProperty"("ResultText", ...) — a write-through to
      *> this form's own property surface (developers-guide-en.md, "super —
      *> the form that loaded me"; SetProperty/GetProperty are the generic,
      *> any-name accessor pair — a BARE me::ResultText/super::ResultText
      *> would fail to build, since a bare property is checked against the
      *> fixed universal form surface only: Name, Title, Width, Height, ...).
      *> That write is only folded into this form's own property store on
      *> the next COBOL-WAIT-EVENT, so a plain onClick handler reading it
      *> right after OpenFormSync returns would still see the old value;
      *> this timer's onTick is itself a COBOL-WAIT-EVENT dispatch, so it
      *> always sees the current one.
           INVOKE ME::"GetProperty"("ResultText") RETURNING WS-RESULT.
           IF WS-RESULT NOT = SPACES
               MOVE WS-RESULT TO Lbl-Result::Caption
           END-IF.]]></Event>
  </Control>
</Form>
