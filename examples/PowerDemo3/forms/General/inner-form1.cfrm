           CLASS RUST-INSTANT IS "Rust.Instant"
           CLASS RUST-SYSTEMTIME IS "Rust.SystemTime"
           CLASS RUST-RANGE IS "Rust.Range"]]></repository>
  <form-events>
    <Event name="onLoad" paragraph="INNER-FORM1--ONLOAD"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE "-23.5614" TO MAPS-1::CenterLat
           MOVE "-46.6558" TO MAPS-1::CenterLng

           MOVE 8 TO MAPS-1::Zoom

           INVOKE MAPS-1 "AddMarker" USING "M1" "-23.5614" "-46.6558" "Av. Paulista" "1578"

           CONTINUE.
]]></Event>
    <Event name="onClose" paragraph="INNER-FORM1--ONCLOSE">
    </Event>
  </form-events>
