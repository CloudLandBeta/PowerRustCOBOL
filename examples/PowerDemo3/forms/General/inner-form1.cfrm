<?xml version="1.0" encoding="UTF-8"?>
<Form name="INNER-FORM1" title="Customers" width="1280" height="848" background="00000000" transparency="0" grid-size="16" snap-to-grid="true" target="Custom" theme="elegance" form-format="Embedded">
  <repository><![CDATA[           CLASS RUST-BOOL IS "Rust.bool"
           CLASS RUST-CHAR IS "Rust.char"
           CLASS RUST-I8 IS "Rust.i8"
           CLASS RUST-I16 IS "Rust.i16"
           CLASS RUST-I32 IS "Rust.i32"
