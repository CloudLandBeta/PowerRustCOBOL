    <Event name="onValueChanged" paragraph="KNOB-1--ONVALUECHANGED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       LINKAGE SECTION.

       PROCEDURE DIVISION.
           IF Knob-1::Value > 100
               SET Knob-1::Value  TO 0
           END-IF

           MOVE Knob-1::Value TO ProgressBar-1::Value
                                 Gauge-1::Value
                                 Slider-2::Value

           CONTINUE.
]]></Event>
