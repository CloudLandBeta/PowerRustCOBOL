  <Control id="CL-FOOTER" type="Label" x="24" y="480" w="600" h="24" tab-order="0" z-order="10" visible="true" enabled="true">
    <Property name="Caption">Top,Left - the notes stop 1 px before this line</Property>
    <Property name="BackgroundColor">#00000000</Property>
