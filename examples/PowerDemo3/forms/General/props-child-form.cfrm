  <Control id="Btn-Ok" type="Button" x="32" y="476" w="270" h="48" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">OK - send back</Property>
    <Property name="BackgroundColor">#F0F0F0</Property>
