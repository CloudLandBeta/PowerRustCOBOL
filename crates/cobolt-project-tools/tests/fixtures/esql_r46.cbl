IDENTIFICATION DIVISION.
PROGRAM-ID. CHECKME.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F ASSIGN TO 'f.dat'.
DATA DIVISION.
FILE SECTION.
FD F.
01 F-REC PIC X(10).
EXEC SQL DECLARE T TABLE (A INT) END-EXEC. *> E:placement
WORKING-STORAGE SECTION.
EXEC SQL INCLUDE NOSUCHBOOK END-EXEC. *> E:include
01 GRP-A.
   05 DUP PIC X(5).
01 GRP-B.
   05 DUP PIC X(5).
01 ID-1 PIC 9(5).
01 BAD-IND PIC X(4).
01 GOOD-IND PIC S9(4) COMP-5.
01 TBL PIC X OCCURS 3.
01 STMT-TEXT PIC X(80).
EXEC SQL DECLARE C2 CURSOR FOR SELECT A FROM T END-EXEC.
EXEC SQL DECLARE C2 CURSOR FOR SELECT B FROM T END-EXEC. *> E:twice
EXEC SQL DECLARE CP CURSOR FOR S9 END-EXEC.
PROCEDURE DIVISION.
MAIN-PARA.
    EXEC SQL WHENEVER SQLERROR GO TO NO-SUCH-PARA END-EXEC *> E:whenever
    EXEC SQL SELECT A INTO :NOPE FROM T END-EXEC *> E:undeclared
    EXEC SQL SELECT A INTO :DUP FROM T END-EXEC *> E:ambiguous
    EXEC SQL SELECT A INTO :DUP OF GRP-A FROM T END-EXEC
    EXEC SQL SELECT A INTO :ID-1:BAD-IND FROM T END-EXEC *> E:indicator
    EXEC SQL SELECT A INTO :ID-1:GOOD-IND FROM T END-EXEC
    EXEC SQL SELECT A INTO :TBL(1) FROM T END-EXEC *> E:subscript
    EXEC SQL DELETE FROM T WHERE A = ZERO END-EXEC *> E:figurative
    EXEC SQL OPEN C9 END-EXEC *> E:cursor-before
    EXEC SQL EXECUTE S1 END-EXEC *> E:prepare-before
    EXEC SQL PREPARE S1 FROM :STMT-TEXT END-EXEC
    EXEC SQL EXECUTE S1 END-EXEC
    EXEC SQL DECLARE C9 CURSOR FOR SELECT A FROM T END-EXEC
    EXEC SQL OPEN C9 END-EXEC
    STOP RUN.
LAST-PARA.
    EXEC SQL SELECT A *> E:unterminated
      INTO :ID-1 FROM T
