<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  Copyright (c) 2026 Emerson Lopes and PowerRustCOBOL contributors

  The Windows installer's source (WiX 3). It lived inside the release workflow until spec 112 (task T13), when the
  setup gained a page, five custom actions and a sequence of their own, and a source of that size is better read,
  guarded by a test (crates/cobolt-setup/src/installer.rs) and built by more than one workflow (the release build and
  installer-check.yml) as a file than as a heredoc.

  Built with:
    candle -arch x64 -ext WixUIExtension -ext WixUtilExtension
           -dVer=<x.y.z> -dRustVersion=<pinned Rust> -dPrcDll=<cobolt_setup.dll> -dSourceDir=<staged tree>
           product.wxs appfiles.wxs
    light  -sval -ext WixUIExtension -ext WixUtilExtension -cultures:en-us -loc prc-strings.wxl ...

  EVERY STRING in this file that reaches the installer's database is ASCII: an MSI's summary information is written
  in a legacy code page (1252 unless the Product declares otherwise) and `light` refuses anything it cannot
  represent there (LGHT0311, run of 1.65.107, one em dash in the Package description). Prose belongs in comments.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- The product's identity. UpgradeCode is FIXED for the product's whole
       life: it is what makes an install an UPGRADE of the last one rather
       than a second copy beside it, while ProductId changes per version. -->
  <Product Id="*" Name="PowerRustCOBOL" Language="1033" Version="$(var.Ver)"
           Manufacturer="Emerson Lopes" UpgradeCode="6F3B1E4A-9C2D-4B77-8E51-2A6D0C9F41B3">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Platform="x64"
             Description="PowerRustCOBOL AI - the next generation COBOL RAD IDE" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of PowerRustCOBOL is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="PowerRustCOBOL" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="PowerRustCOBOL" />
      </Directory>
    </Directory>
    <DirectoryRef Id="AppMenuFolder">
      <Component Id="AppShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut" Name="PowerRustCOBOL"
                  Description="The next generation COBOL RAD IDE"
                  Target="[INSTALLFOLDER]PowerRustCOBOL.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PowerRustCOBOL"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Complete" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <!-- The finish page. Installing PowerRustCOBOL does not make a
         machine able to BUILD with it, and the place to say so is
         here rather than at the end of the developer's first build.
         Windows wording only: a Mac or a Linux instruction shown to a
         Windows user is noise they have to work out is not for them.

         The button opens Microsoft's page and installs nothing, and
         this package never installs the Build Tools either. That was
         the standing decision: a multi-gigabyte privileged install is
         the user's call, on Microsoft's page. Spec 112 reversed the
         half of it that concerned Rust and the platform: the page
         before Install now offers to install Rust and compile the
         platform, on the developer's explicit choice. The Build Tools
         stay out of this package for a reason of Windows, not of
         policy: Microsoft's bootstrapper fails with 1618 when it is
         started from inside an install, because a Windows Installer
         package runs one installation at a time (measured on a hosted
         runner, spec 112 section 9, decision D12). A separate
         bootstrapper bundle installs them before this package (task
         T19); until it ships, this page and the preparation page name
         them.

         The target is the Build Tools LANDING page, deliberately
         without a fragment. It used to be
         downloads/#build-tools-for-visual-studio-2022; an anchor is
         the half of a URL that rots when a vendor reorganises a page,
         and it takes the whole link with it. The IDE offers the same
         page from `cobolt_compiler::linker_download`, and the two are
         meant to agree. -->
    <Property Id="WixShellExecTarget"
              Value="https://visualstudio.microsoft.com/visual-cpp-build-tools/" />
    <CustomAction Id="OpenPrereqPage" BinaryKey="WixCA" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />

    <!-- A model provider for the AI (operator, 2026-09-27): without
         one, Grace and the agents have nothing to run on. The button
         runs OLLAMA'S OWN installer - downloaded from ollama.com and
         started as the user, who then goes through its window - the
         same thing the IDE's first-run question offers on every
         platform. asyncNoWait: this setup finishes without waiting
         for the download. Kept ASCII like everything in this file. -->
    <CustomAction Id="InstallOllama" Directory="TARGETDIR" Impersonate="yes"
                  Return="asyncNoWait"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command &quot;$f = Join-Path $env:TEMP 'OllamaSetup.exe'; Invoke-WebRequest -UseBasicParsing 'https://ollama.com/download/OllamaSetup.exe' -OutFile $f; Start-Process -FilePath $f&quot;" />

    <!-- Put the example project somewhere the developer can build it.
         A build WRITES INTO the project folder - the compiler's first
         step after compiling is create_dir(project_dir/bin), and
         generated COBOL, staged theme art and the Knowledge Base land
         there too - so the copy under Program Files can never be
         built. That is the "Acesso negado. (os error 5)" an operator
         hit on 2026-09-12.

         It runs the IDE's own seed-examples switch (see the Value
         below) rather than an xcopy written here, so the destination,
         the build-output exclusions and
         the read-only clearing are decided in Rust, where they are
         tested; restated in WiX they could not be, and would rot.

         DEFERRED, because an *immediate* action scheduled after
         InstallFiles runs while the install script is still being
         BUILT - before any file it copies from exists on disk. That is
         MSI's oldest trap and it would silently copy nothing.

         IMPERSONATE="yes", because a per-machine .msi executes
         elevated: without it the action runs as SYSTEM and seeds
         SYSTEM's profile, which no human will ever open.

         A deferred action cannot read properties, only its
         CustomActionData - hence the immediate SetSeedExamples, whose
         property name MATCHES this action's id, which is how WiX
         hands the value over.

         Return="ignore": a machine where this fails still has Help ->
         Examples, which seeds on first use. Never fail an install
         over a sample. -->
    <CustomAction Id="SetSeedExamples" Property="SeedExamples"
                  Value="&quot;[INSTALLFOLDER]PowerRustCOBOL.exe&quot; --seed-examples" />
    <CustomAction Id="SeedExamples" BinaryKey="WixCA" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- The preparation (spec 112, task T13)
         Before Install, a page offers to make the machine ready to BUILD:
         install Rust (the release's pinned one) and compile the platform
         into the installing user's compiled-crate cache, so the first
         Debug or EXEC RUST Build compiles only the developer's program.
         Choosing Skip, or installing silently without PREPARE_PLATFORM=1,
         installs exactly the files this package always installed and
         starts none of what follows.

         WHO DOES WHAT. cobolt_setup.dll (crates/cobolt-setup) is the only
         code here that talks to Windows Installer: it decides what the page
         says (PrcFacts), makes room on the progress bar (PrcTicks), runs a
         step and hears Cancel (PrcRun), removes what this setup made when
         the install is cancelled (PrcRollback) and writes the finish page's
         text (PrcReadResult). The work itself is the IDE's own headless
         mode (the executable's prepare-platform switch, with a step of rust
         or compile), so it is the same tested Rust the IDE uses.

         NO ACTION FAILS THE INSTALL. A step that cannot finish writes why
         into a result file, the supervisor returns success, and the finish
         page says what was not done. The one answer that is not success is
         ERROR_INSTALL_USEREXIT, and only because the developer pressed
         Cancel (which then rolls the whole install back).

         CustomActionData of a step, eight fields separated by a bar:
           who | seconds without a line before it is given up | kill on
           Cancel | the part it is about | the bar's share (ticks) | result
           file | cancel file | the command line
         A property that is not set expands to nothing, and every empty
         field means off. See crates/cobolt-setup/src/data.rs. -->
    <Binary Id="PrcCA" SourceFile="$(var.PrcDll)" />

    <!-- Public so a command line can set them, and secure so they reach the
         elevated server of a per-machine install: the choice and the places
         the steps share are set on the client (PrcFacts, the page) and read
         where the actions run. PREPARE_PLATFORM=1 is the silent opt-in. -->
    <Property Id="PRC_PINNED_RUST" Value="$(var.RustVersion)" Secure="yes" />
    <Property Id="PREPARE_PLATFORM" Secure="yes" />
    <Property Id="PRC_PREPARE" Secure="yes" />
    <Property Id="PRC_LINKER" Secure="yes" />
    <Property Id="PRC_BUILD_FOLDER" Secure="yes" />
    <Property Id="PRC_RESULT_FILE" Secure="yes" />
    <Property Id="PRC_CANCEL_FILE" Secure="yes" />

    <!-- Immediate, as the user: the facts and the page text. Never fails. -->
    <CustomAction Id="PrcFacts" BinaryKey="PrcCA" DllEntry="PrcFacts" Return="ignore" />
    <!-- Immediate: room on the bar, and the stale files of an interrupted run
         removed. Return="check" because this one hears Cancel too. -->
    <CustomAction Id="PrcTicks" BinaryKey="PrcCA" DllEntry="PrcTicks" Return="check" />

    <!-- Rust, then the compile, both as the installing user (Impersonate):
         the cache is theirs, and so is the Rust. Fifteen minutes without a
         line is a hung step (the steps print one at least every five
         seconds). Cancel asks the step to stop and, after five seconds,
         ends it and everything it started. -->
    <CustomAction Id="SetPrcRust" Property="PrcRust"
                  Value="asuser|900|1|rust|[PRC_TICKS_RUST]|[PRC_RESULT_FILE]|[PRC_CANCEL_FILE]|&quot;[INSTALLFOLDER]PowerRustCOBOL.exe&quot; --prepare-platform --step rust --result &quot;[PRC_RESULT_FILE]&quot; --cancel-file &quot;[PRC_CANCEL_FILE]&quot;" />
    <CustomAction Id="PrcRust" BinaryKey="PrcCA" DllEntry="PrcRun"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="SetPrcCompile" Property="PrcCompile"
                  Value="asuser|900|1|release|[PRC_TICKS_COMPILE]|[PRC_RESULT_FILE]|[PRC_CANCEL_FILE]|&quot;[INSTALLFOLDER]PowerRustCOBOL.exe&quot; --prepare-platform --step compile --result &quot;[PRC_RESULT_FILE]&quot; --cancel-file &quot;[PRC_CANCEL_FILE]&quot; --build-root &quot;[PRC_BUILD_FOLDER]&quot;" />
    <CustomAction Id="PrcCompile" BinaryKey="PrcCA" DllEntry="PrcRun"
                  Execute="deferred" Impersonate="yes" Return="check" />

    <!-- If the install is cancelled after the compile began, the cache this
         setup created is removed (and only that one: the DLL looks for the
         marker the compile writes when it created the folder). Scheduled
         BEFORE the two steps, which is what makes a Cancel in either one run
         it; SYSTEM can remove a folder of any user's profile. -->
    <CustomAction Id="SetPrcRollback" Property="PrcRollback" Value="[PRC_BUILD_FOLDER]" />
    <CustomAction Id="PrcRollback" BinaryKey="PrcCA" DllEntry="PrcRollback"
                  Execute="rollback" Impersonate="no" Return="ignore" />

    <!-- Immediate, after the work and before the finish page: PRC_RESULT is
         what the steps wrote, in words. -->
    <CustomAction Id="PrcReadResult" BinaryKey="PrcCA" DllEntry="PrcReadResult" Return="ignore" />

    <!-- What the progress page says while a step runs: the action's name, and
         under it the step's own line (the supervisor's ActionData, [1]). -->
    <UI>
      <ProgressText Action="PrcRust" Template="[1]">Installing Rust</ProgressText>
      <ProgressText Action="PrcCompile" Template="[1]">Compiling PowerRustCOBOL AI for Debug and EXEC RUST</ProgressText>
    </UI>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="dist/art/wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dist/art/wix-dialog.bmp" />

    <!-- The wizard
         WixUI's own welcome and finish dialogs draw their text in
         BLACK at x >= 180 px, which pins the artwork to a light panel
         on the right and the mascot to the left. The look this
         product wants is the other way round: dark edge to edge,
         wordmark and copy in white on the LEFT, mascot on the right.
         No property moves a stock control or recolours it, so the two
         screens that carry the big bitmap are authored here. Every
         other screen - licence, folder, ready, progress, the error
         and maintenance dialogs - is WixUI's, unchanged, and reached
         through the same sequence WixUI_InstallDir uses.

         The text styles are new ids, not redefinitions: overriding
         WixUI_Font_Normal would collide with the copy WixUI_Common
         already defines. -->
    <UI Id="PrcUI">
      <TextStyle Id="PrcMark"  FaceName="Segoe UI" Size="17" Bold="yes" Red="255" Green="255" Blue="255" />
      <TextStyle Id="PrcSub"   FaceName="Consolas" Size="8"             Red="232" Green="130" Blue="46" />
      <TextStyle Id="PrcTitle" FaceName="Segoe UI" Size="12" Bold="yes" Red="255" Green="255" Blue="255" />
      <TextStyle Id="PrcBody"  FaceName="Segoe UI" Size="8"             Red="206" Green="194" Blue="184" />
      <TextStyle Id="PrcVer"   FaceName="Consolas" Size="8"             Red="132" Green="110" Blue="96" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- Welcome. The bitmap is the whole 370x234 DU area; every
           text control below sits on it with Transparent="yes" so the
           artwork shows through, and each one names its own white
           style inline with {\Style}. -->
      <Dialog Id="PrcWelcomeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234"
                 TabSkip="no" Text="!(loc.WelcomeDlgBitmap)" />
        <Control Id="Mark" Type="Text" X="18" Y="24" Width="180" Height="26"
                 Transparent="yes" NoPrefix="yes" Text="{\PrcMark}PowerRustCOBOL AI" />
        <Control Id="Sub" Type="Text" X="18" Y="50" Width="180" Height="12"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\PrcSub}THE NEXT GENERATION COBOL RAD IDE" />
        <Control Id="Title" Type="Text" X="18" Y="96" Width="150" Height="42"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\PrcTitle}Welcome to the [ProductName] Setup Wizard" />
        <Control Id="Description" Type="Text" X="18" Y="146" Width="150" Height="50"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\PrcBody}The Setup Wizard will install [ProductName] on your computer. Click Next to continue, or Cancel to exit." />
        <Control Id="Ver" Type="Text" X="18" Y="208" Width="150" Height="12"
                 Transparent="yes" NoPrefix="yes" Text="{\PrcVer}[ProductVersion]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- Finish. Same artwork, and the place the build prerequisites
           are named - the one moment a developer is certain to read
           something before their first build. -->
      <Dialog Id="PrcExitDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234"
                 TabSkip="no" Text="!(loc.WelcomeDlgBitmap)" />
        <Control Id="Mark" Type="Text" X="18" Y="24" Width="180" Height="26"
                 Transparent="yes" NoPrefix="yes" Text="{\PrcMark}PowerRustCOBOL AI" />
        <Control Id="Sub" Type="Text" X="18" Y="50" Width="180" Height="12"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\PrcSub}THE NEXT GENERATION COBOL RAD IDE" />
        <Control Id="Title" Type="Text" X="18" Y="88" Width="150" Height="26"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\PrcTitle}Installation complete" />
        <!-- Two texts in one place. When the developer chose Prepare now,
             PrcReadResult has set PRC_RESULT (what was prepared, or what was
             not and why, and where the Build Tools are when they are
             missing) and it replaces the standing prerequisites text; when
             nothing was prepared the standing text is shown, as it always
             was. -->
        <Control Id="Description" Type="Text" X="18" Y="116" Width="152" Height="114"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\PrcBody}BUILD also needs the Visual Studio Build Tools (&quot;Desktop development with C++&quot;) and Rust $(var.RustVersion) from https://rustup.rs.  The AI needs a model provider: Ollama is the simplest, any other will do.  Suggested: gemma4:e2b locally for Grace and the Judge, gemma4:31b in the Ollama cloud for the other agents.">
          <Condition Action="hide">PRC_RESULT</Condition>
        </Control>
        <Control Id="Result" Type="Text" X="18" Y="112" Width="152" Height="120"
                 Transparent="yes" NoPrefix="yes" Text="{\PrcBody}[PRC_RESULT]">
          <Condition Action="hide">NOT PRC_RESULT</Condition>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <!-- No Back: it was always disabled on this last screen, and its
             place on the strip now holds Install Ollama. -->
        <!-- A button, not a checkbox. A CheckBox control cannot carry
             `Transparent`/`NoPrefix` - those are Text-only attributes,
             and candle rejects them outright (CNDL0004, run 19) - so on
             this dark artwork a checkbox would paint an opaque system
             box around its own label. A button belongs on the button
             strip, below the bitmap, where an opaque control is what
             the eye expects; it also acts when it is pressed rather
             than only if the user later presses Finish. -->
        <!-- The publish is UNCONDITIONAL, and that is the fix. It
             carried `NOT Installed`, copied from WixUI's exit-dialog
             checkbox idiom, where the condition exists to stop a
             repair run relaunching an application. Opening a web page
             has no such hazard, and on any maintenance run - install
             once, then start setup again, which is exactly how a
             developer goes back to read this screen - `Installed` is
             set, the condition is false, and the button does nothing
             at all when pressed. 1.65.113 said it had removed this
             along with the checkbox; it removed the checkbox.
             A fixed-size MSI button cannot grow to fit its own text,
             so each width here is its label's (~6 units a character):
             100 for "Build Tools page", 104 for "Install Ollama". -->
        <Control Id="Prereq" Type="PushButton" X="18" Y="243" Width="100" Height="17"
                 Text="Build Tools page">
          <Publish Event="DoAction" Value="OpenPrereqPage">1</Publish>
        </Control>
        <Control Id="Ollama" Type="PushButton" X="124" Y="243" Width="104" Height="17"
                 Text="Install Ollama">
          <Publish Event="DoAction" Value="InstallOllama">1</Publish>
        </Control>
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Disabled="yes" Text="!(loc.WixUICancel)" />
      </Dialog>

      <!-- The preparation page (spec 112), between the install folder and
           "ready to install". Banner style, like the licence and folder
           pages around it: stock controls on a white body, because a
           RadioButtonGroup paints an opaque system background that the
           dark artwork of the two big screens cannot carry.

           The text is PRC_TEXT, set by PrcFacts, in an Edit control, the one
           control a property's value can scroll in: a ScrollableText cannot
           expand a property, and the text (what will be done, how long, how
           much disk, what Skip costs) is longer than the body holds. An Edit
           can be typed into, which changes nothing: no action reads
           PRC_TEXT. It comes AFTER the choice in the dialog so the choice,
           not the text, has the keyboard focus when the page opens.

           PRC_PREPARE is the choice: "1" prepares, anything else does not.
           PrcFacts sets "1" where Prepare now is offered and "0" where it is
           not, so the group is never shown with nothing selected; where it
           is not offered (the disk is too small, or only Rust and the
           missing Build Tools are left to say) the group is disabled and the
           text says why. -->
      <Dialog Id="PrcPrepareDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Choice" Type="RadioButtonGroup" Property="PRC_PREPARE"
                 X="20" Y="188" Width="330" Height="40">
          <RadioButtonGroup Property="PRC_PREPARE">
            <RadioButton Value="1" X="0" Y="0" Width="330" Height="18"
                         Text="Prepare now (recommended)" />
            <RadioButton Value="0" X="0" Y="20" Width="330" Height="18"
                         Text="Skip: the first Debug or EXEC RUST Build asks first, then does the same work" />
          </RadioButtonGroup>
          <Condition Action="disable">NOT PRC_DISK_OK</Condition>
        </Control>
        <Control Id="Details" Type="Edit" Property="PRC_TEXT" Multiline="yes" Sunken="yes"
                 X="20" Y="52" Width="330" Height="130" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Install Rust and compile PowerRustCOBOL AI's parts now, so Debug and EXEC RUST start at full speed." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Get the platform ready" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <!-- What the Cancel button says from here on (the stock
               confirmation, with prc-strings.wxl appending this): set when
               Prepare now is chosen, cleared when it is not. -->
          <Publish Property="PRC_CANCEL_NOTE" Value="[PRC_CANCEL_TEXT]" Order="1">PRC_PREPARE = "1"</Publish>
          <Publish Property="PRC_CANCEL_NOTE" Value="{}" Order="2"><![CDATA[PRC_PREPARE <> "1"]]></Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- The sequence, as WixUI_InstallDir runs it, with our two
           dialogs standing in for WelcomeDlg and ExitDialog, and the
           preparation page between the install folder and "ready". It is
           reached only when PrcFacts found something to prepare
           (PRC_NEED), and only on a first install (this whole table is
           reached on NOT Installed; a repair or a removal shows the
           maintenance pages). -->
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

      <Publish Dialog="PrcWelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="PrcWelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="PrcWelcomeDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1"</Publish>

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="PrcPrepareDlg" Order="4"><![CDATA[(WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1") AND PRC_NEED]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="5"><![CDATA[(WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1") AND NOT PRC_NEED]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>

      <Publish Dialog="PrcPrepareDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1">NOT Installed AND NOT PRC_NEED</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PrcPrepareDlg" Order="1">NOT Installed AND PRC_NEED</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PrcWelcomeDlg" Order="2">Installed AND PATCH</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>

      <!-- Ours replaces WixUI_Common's, which declares its own Show
           as overridable for exactly this. -->
      <InstallUISequence>
        <!-- The facts are gathered once costing is done (the older product
             a major upgrade replaces is known by then) and before the first
             page, so the preparation page can be shown or skipped. -->
        <Custom Action="PrcFacts" After="CostFinalize">NOT Installed</Custom>
        <Show Dialog="PrcWelcomeDlg" Before="ProgressDlg">NOT Installed</Show>
        <!-- After the install and before the finish page, and only when the
             install went through: a failed or cancelled ExecuteAction ends
             the sequence at its own exit dialog. -->
        <Custom Action="PrcReadResult" After="ExecuteAction">PRC_PREPARE = "1"</Custom>
        <Show Dialog="PrcExitDlg" OnExit="success" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />

    <!-- The order of the install script, which is the whole of the design:

           InstallInitialize
             PrcTicks            room on the bar (immediate)
           InstallFiles          the program is on disk
             PrcRollback         scheduled BEFORE the two steps, so a Cancel in either removes the cache
             PrcRust             as the user; installs the pinned Rust where it is not there
             PrcCompile          as the user; release and debug, three variants, into the shared cache
             SeedExamples        the developer's example copy, AFTER the long work: a Cancel then leaves no
                                 copied project behind, which is user code and is never rolled back

         Each Set* action is immediate and hands its deferred partner the
         CustomActionData (the property of the same name as the partner).

         The silent path. With no wizard there is no page: PrcFacts runs here,
         in the execute sequence, and sets PRC_PREPARE from PREPARE_PLATFORM
         (an administrator opts in with /qn PREPARE_PLATFORM=1; without it
         nothing below runs). A wizard install ran PrcFacts in the
         InstallUISequence above, so it is conditioned on UILevel here.

         Every preparation action is conditioned on PRC_PREPARE = "1": a
         developer who chose Skip, and every silent install that did not opt
         in, installs exactly the files this package always installed.
         PrcCompile also needs the C++ linker (PRC_LINKER): without it there
         is nothing to compile with, the page and the finish page say so, and
         the first Build asks first.

         NOT REMOVE on SeedExamples: on uninstall the developer's copy is left
         exactly where it is. It is their project by then, whatever they have
         built in it, and an uninstaller that deleted it would be deleting
         their work. -->
    <InstallExecuteSequence>
      <Custom Action="PrcFacts" After="CostFinalize"><![CDATA[NOT Installed AND NOT REMOVE AND UILevel < 5]]></Custom>
      <Custom Action="PrcTicks" After="InstallInitialize"><![CDATA[PRC_PREPARE = "1" AND NOT REMOVE]]></Custom>
      <Custom Action="SetPrcRollback" After="InstallFiles"><![CDATA[PRC_PREPARE = "1" AND NOT REMOVE]]></Custom>
      <Custom Action="PrcRollback" After="SetPrcRollback"><![CDATA[PRC_PREPARE = "1" AND NOT REMOVE]]></Custom>
      <Custom Action="SetPrcRust" After="PrcRollback"><![CDATA[PRC_PREPARE = "1" AND NOT REMOVE]]></Custom>
      <Custom Action="PrcRust" After="SetPrcRust"><![CDATA[PRC_PREPARE = "1" AND NOT REMOVE]]></Custom>
      <Custom Action="SetPrcCompile" After="PrcRust"><![CDATA[PRC_PREPARE = "1" AND PRC_LINKER AND NOT REMOVE]]></Custom>
      <Custom Action="PrcCompile" After="SetPrcCompile"><![CDATA[PRC_PREPARE = "1" AND PRC_LINKER AND NOT REMOVE]]></Custom>
      <Custom Action="SetSeedExamples" After="PrcCompile">NOT REMOVE</Custom>
      <Custom Action="SeedExamples" After="SetSeedExamples">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
