    <Property name="ShadowLightColor">#FFFFFFFF</Property>
    <Property name="ShadowDirection">SouthEast</Property>
    <Property name="ShadowDistance">7</Property>
    <Property name="ShadowBlur">true</Property>
    <Property name="ShadowBlurStrength">8</Property>
    <Property name="ZOrder">0</Property>
    <Property name="Items">Node 1
  Child 1
  Child 2
Node 2</Property>
    <Property name="AllowEdit">false</Property>
    <Property name="AllowDrag">false</Property>
    <Property name="CheckBoxes">false</Property>
    <Property name="ShowLines">true</Property>
    <Property name="ShowRootLines">true</Property>
    <Property name="Sorted">false</Property>
    <Property name="HotTracking">false</Property>
    <Property name="LineColor">#AAAAAA</Property>
    <Property name="BorderColor">#888888</Property>
    <Property name="BorderStyle">Single</Property>
    <Property name="BorderWidth">1</Property>
    <Property name="CheckedNodes"></Property>
    <Property name="CollapsedNodes"></Property>
    <Property name="ShowIcons">true</Property>
    <Property name="ParentIcon">folder</Property>
    <Property name="ParentIconOpen">folder-open</Property>
    <Property name="LeafIcon">doc-text</Property>
    <Property name="IconSize">14</Property>
    <Property name="IconColor"></Property>
    <Property name="HighContrastText">true</Property>
    <Property name="RowHeight">18</Property>
