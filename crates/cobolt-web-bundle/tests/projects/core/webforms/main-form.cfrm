    <Property name="CheckBoxBorderColor"></Property>
    <Property name="CheckBoxBorderWidth">1</Property>
    <Property name="CheckColor"></Property>
    <Property name="CheckSize">70</Property>
    <Property name="SelectionColor"></Property>
    <Property name="HotTrackColor"></Property>
    <Property name="CornerRadius">0</Property>
    <Property name="AccessibleLabel"></Property>
    <Event name="onNodeClick" paragraph="TRV-ECHO--ONNODECLICK"><![CDATA[       DATA DIVISION.
       LINKAGE SECTION.
       01 CONTROL-NODE-DATA.
           05 CONTROL-NODE PIC X(64).
           05 CONTROL-NODE-INDEX PIC S9(4) COMP-5.
           05 CONTROL-NODE-LEVEL PIC S9(4) COMP-5.
           05 CONTROL-NODE-CHECKED PIC 9.
       PROCEDURE DIVISION USING CONTROL-NODE-DATA.
           MOVE CONTROL-NODE TO LBL-OUT::Caption.
]]></Event>
  </Control>
  <Control id="BTN-GO" type="Button" x="10" y="112" w="80" h="28" tab-order="0" z-order="0" visible="true" enabled="true">
