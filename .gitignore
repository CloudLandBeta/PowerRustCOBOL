# Rust build artifacts (large — ~1.5 GB)
target/

# macOS
.DS_Store

# Local agent / editor settings — ignore everything under .claude/ EXCEPT the
# project's shared spec-kit skills.
.claude/*
!.claude/skills/

# Agent project-context file — kept local only (lives in
# ~/Documents/PowerRustCOBOL-local-settings/CLAUDE.md), never committed.
CLAUDE.md

# Editor/OS cruft
*.swp
*~

# Per-control example build outputs (binaries)
examples/*/bin/

# Session handoff notes — working documents, kept on disk, never in the repo.
# (operator, 2026-08-24)
HANDOFF*.md
HANDOFF*.txt
handoff*.md
handoff*.txt
SESSION-HANDOFF*
