<?xml version="1.0" encoding="UTF-8"?>
<Form name="AWS-COGNITO-DEMO" title="AwsCognito demo" width="480" height="240" form-format="Both" index-base="1">
  <working-storage><![CDATA[       01 WS-PASS     PIC 999 VALUE 0 GLOBAL.
       01 WS-FAIL     PIC 999 VALUE 0 GLOBAL.
       01 WS-CALLS    PIC 999 VALUE 0 GLOBAL.
       01 WS-A        PIC X(200) GLOBAL.
       01 WS-B        PIC X(200) GLOBAL.
       01 WS-C        PIC X(200) GLOBAL.
       01 WS-D        PIC X(200) GLOBAL.
       01 WS-OUT      PIC X(2000) GLOBAL.
       01 WS-RC       PIC X(10) GLOBAL.
       01 WS-I        PIC 9 GLOBAL.
       01 WS-F        PIC X(20) GLOBAL.
       01 WS-FIELD    PIC X(200) GLOBAL.
       01 WS-ERR      PIC X(300) GLOBAL.
       01 WS-K        PIC 99 GLOBAL.
       01 WS-ORDER    PIC X(100) VALUE SPACES GLOBAL.
       01 WS-OP       PIC 999 VALUE 1 GLOBAL.
       01 WS-T0       PIC X(21) GLOBAL.
       01 WS-T1       PIC X(21) GLOBAL.
       01 WS-MS       PIC 9(9) GLOBAL.
       01 WS-RESULT   PIC X(40) GLOBAL.
]]></working-storage>
  <Control id="AWS-USERS" type="AwsCognito" x="16" y="16" w="56" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="ClientId">app-client-1</Property>
    <Property name="AllowWrite">true</Property>
    <Property name="Mode">Sync</Property>
    <Event name="onSignedIn" paragraph="AWS-USERS--ONSIGNEDIN"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           STRING "onSignedIn " DELIMITED BY SIZE INTO WS-ORDER WITH POINTER WS-OP
           MOVE AWS-USERS::SignedIn TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "1"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL async SignedIn: " FUNCTION TRIM(WS-FIELD)
           END-IF
           .
]]></Event>
    <Event name="onComplete" paragraph="AWS-USERS--ONCOMPLETE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           STRING "onComplete " DELIMITED BY SIZE INTO WS-ORDER WITH POINTER WS-OP
           .
]]></Event>
  </Control>
  <Control id="AWS-RO" type="AwsCognito" x="88" y="16" w="56" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="ClientId">app-client-1</Property>
    <Property name="Mode">Sync</Property>
    <Property name="AllowWrite">false</Property>
  </Control>
  <Control id="BTN-RUN" type="Button" x="16" y="96" w="120" h="28" tab-order="1" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Run</Property>
    <Event name="onClick" paragraph="BTN-RUN--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE FUNCTION CURRENT-DATE TO WS-T0
      *> 1. Sign a user in: COBOL sees SignedIn and UserName, never a token.
           MOVE 'ana' TO WS-A
           MOVE 'S3cret!pass' TO WS-B
           INVOKE AWS-USERS "SignIn" USING WS-A WS-B RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE AWS-USERS::SignedIn TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "1"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL SignedIn: " FUNCTION TRIM(WS-FIELD)
           END-IF
           MOVE AWS-USERS::UserName TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "ana"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL UserName: " FUNCTION TRIM(WS-FIELD)
           END-IF
      *> 2. One of the user's attributes, through the kept token.
           MOVE 'email' TO WS-A
           INVOKE AWS-USERS "GetAttribute" USING WS-A RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE WS-OUT TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "ana@example.com"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL GetAttribute: " FUNCTION TRIM(WS-FIELD)
           END-IF
      *> 3. AllowWrite off: SignUp refused before anything is sent.
           MOVE 'bo' TO WS-A
           MOVE 'pw' TO WS-B
           MOVE 'bo@example.com' TO WS-C
           INVOKE AWS-RO "SignUp" USING WS-A WS-B WS-C RETURNING WS-OUT
           MOVE AWS-RO::LastError TO WS-ERR
           MOVE 0 TO WS-K
           INSPECT WS-ERR TALLYING WS-K FOR ALL "AllowWrite is off"
           IF WS-K > 0
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL AllowWrite refusal: " FUNCTION TRIM(WS-ERR)
           END-IF
      *> 4. Sign out, then nothing more can be asked.
           INVOKE AWS-USERS "SignOut" RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE AWS-USERS::SignedIn TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "0"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL SignedIn after SignOut: " FUNCTION TRIM(WS-FIELD)
           END-IF
           MOVE 'email' TO WS-A
           INVOKE AWS-USERS "GetAttribute" USING WS-A RETURNING WS-OUT
           MOVE AWS-USERS::LastError TO WS-ERR
           MOVE 0 TO WS-K
           INSPECT WS-ERR TALLYING WS-K FOR ALL "not signed in"
           IF WS-K > 0
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL refused after SignOut: " FUNCTION TRIM(WS-ERR)
           END-IF
           MOVE FUNCTION CURRENT-DATE TO WS-T1
           COMPUTE WS-MS =
               ((FUNCTION NUMVAL(WS-T1(9:2)) * 3600
                 + FUNCTION NUMVAL(WS-T1(11:2)) * 60
                 + FUNCTION NUMVAL(WS-T1(13:2))) * 100
                 + FUNCTION NUMVAL(WS-T1(15:2))) * 10
             - ((FUNCTION NUMVAL(WS-T0(9:2)) * 3600
                 + FUNCTION NUMVAL(WS-T0(11:2)) * 60
                 + FUNCTION NUMVAL(WS-T0(13:2))) * 100
                 + FUNCTION NUMVAL(WS-T0(15:2))) * 10
      *> The asynchronous call: its own event, then onComplete.
           MOVE "Async" TO AWS-USERS::Mode
           MOVE 'ana' TO WS-A
           MOVE 'S3cret!pass' TO WS-B
           INVOKE AWS-USERS "SignIn" USING WS-A WS-B RETURNING WS-RC
           ADD 1 TO WS-CALLS
           MOVE WS-RC TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "1"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL async start: " FUNCTION TRIM(WS-FIELD)
           END-IF
           .
]]></Event>
  </Control>
  <Control id="BTN-SUMMARY" type="Button" x="152" y="96" w="120" h="28" tab-order="2" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Summary</Property>
    <Event name="onClick" paragraph="BTN-SUMMARY--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-ORDER(1:22) = "onSignedIn onComplete "
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL event order: " FUNCTION TRIM(WS-ORDER)
           END-IF
           DISPLAY "==== AwsCognito demo (spec 078) ===="
           DISPLAY "Operations: SignIn, GetAttribute, SignOut, SignIn (Async)"
           DISPLAY "Refusals:   AllowWrite off, signed out (nothing sent)"
           DISPLAY "Calls made: " WS-CALLS
           DISPLAY "Sync part:  " WS-MS " ms"
           DISPLAY "Events:     " FUNCTION TRIM(WS-ORDER)
           MOVE SPACES TO WS-RESULT
           STRING "PASS " WS-PASS " FAIL " WS-FAIL
               DELIMITED BY SIZE INTO WS-RESULT
           DISPLAY FUNCTION TRIM(WS-RESULT)
           MOVE WS-RESULT TO LBL-RESULT::Caption
           .
]]></Event>
  </Control>
  <Control id="LBL-RESULT" type="Label" x="16" y="140" w="300" h="24" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">-</Property>
  </Control>
</Form>
