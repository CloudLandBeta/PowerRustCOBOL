<?xml version="1.0" encoding="UTF-8"?>
<Form name="AWS-TEXTRACT-DEMO" title="AwsTextract demo" width="480" height="240" form-format="Both" index-base="1">
  <working-storage><![CDATA[       01 WS-PASS     PIC 999 VALUE 0 GLOBAL.
       01 WS-FAIL     PIC 999 VALUE 0 GLOBAL.
       01 WS-CALLS    PIC 999 VALUE 0 GLOBAL.
       01 WS-A        PIC X(200) GLOBAL.
       01 WS-B        PIC X(200) GLOBAL.
       01 WS-C        PIC X(200) GLOBAL.
       01 WS-D        PIC X(200) GLOBAL.
       01 WS-OUT      PIC X(2000) GLOBAL.
       01 WS-RC       PIC X(10) GLOBAL.
       01 WS-I        PIC 9 GLOBAL.
       01 WS-F        PIC X(20) GLOBAL.
       01 WS-FIELD    PIC X(200) GLOBAL.
       01 WS-ERR      PIC X(300) GLOBAL.
       01 WS-K        PIC 99 GLOBAL.
       01 WS-ORDER    PIC X(100) VALUE SPACES GLOBAL.
       01 WS-OP       PIC 999 VALUE 1 GLOBAL.
       01 WS-T0       PIC X(21) GLOBAL.
       01 WS-T1       PIC X(21) GLOBAL.
       01 WS-MS       PIC 9(9) GLOBAL.
       01 WS-RESULT   PIC X(40) GLOBAL.
]]></working-storage>
  <Control id="AWS-DOC" type="AwsTextract" x="16" y="16" w="56" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Mode">Sync</Property>
    <Event name="onTextDetected" paragraph="AWS-DOC--ONTEXTDETECTED"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           STRING "onTextDetected " DELIMITED BY SIZE INTO WS-ORDER WITH POINTER WS-OP
           MOVE AWS-DOC::RowCount TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "2"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL async DetectText RowCount: " FUNCTION TRIM(WS-FIELD)
           END-IF
           .
]]></Event>
    <Event name="onComplete" paragraph="AWS-DOC--ONCOMPLETE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           STRING "onComplete " DELIMITED BY SIZE INTO WS-ORDER WITH POINTER WS-OP
           .
]]></Event>
  </Control>
  <Control id="BTN-RUN" type="Button" x="16" y="96" w="120" h="28" tab-order="1" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Run</Property>
    <Event name="onClick" paragraph="BTN-RUN--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE FUNCTION CURRENT-DATE TO WS-T0
      *> 1. The lines of a document in S3.
           MOVE 's3://inbox/form.pdf' TO WS-A
           INVOKE AWS-DOC "DetectText" USING WS-A RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE AWS-DOC::RowCount TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "2"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL DetectText RowCount: " FUNCTION TRIM(WS-FIELD)
           END-IF
           MOVE 2 TO WS-I
           MOVE "Text" TO WS-F
           INVOKE AWS-DOC "GetField" USING WS-I WS-F RETURNING WS-OUT
           MOVE WS-OUT TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "Total: 42"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL GetField(2, Text): " FUNCTION TRIM(WS-FIELD)
           END-IF
      *> 2. Its form fields and table cells.
           MOVE 's3://inbox/form.pdf' TO WS-A
           INVOKE AWS-DOC "AnalyzeDocument" USING WS-A RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE 1 TO WS-I
           MOVE "Value" TO WS-F
           INVOKE AWS-DOC "GetField" USING WS-I WS-F RETURNING WS-OUT
           MOVE WS-OUT TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "Ana"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL GetField(1, Value): " FUNCTION TRIM(WS-FIELD)
           END-IF
           MOVE 2 TO WS-I
           MOVE "Kind" TO WS-F
           INVOKE AWS-DOC "GetField" USING WS-I WS-F RETURNING WS-OUT
           MOVE WS-OUT TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "CELL"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL GetField(2, Kind): " FUNCTION TRIM(WS-FIELD)
           END-IF
           MOVE FUNCTION CURRENT-DATE TO WS-T1
           COMPUTE WS-MS =
               ((FUNCTION NUMVAL(WS-T1(9:2)) * 3600
                 + FUNCTION NUMVAL(WS-T1(11:2)) * 60
                 + FUNCTION NUMVAL(WS-T1(13:2))) * 100
                 + FUNCTION NUMVAL(WS-T1(15:2))) * 10
             - ((FUNCTION NUMVAL(WS-T0(9:2)) * 3600
                 + FUNCTION NUMVAL(WS-T0(11:2)) * 60
                 + FUNCTION NUMVAL(WS-T0(13:2))) * 100
                 + FUNCTION NUMVAL(WS-T0(15:2))) * 10
      *> The asynchronous call: its own event, then onComplete.
           MOVE "Async" TO AWS-DOC::Mode
           MOVE 's3://inbox/form.pdf' TO WS-A
           INVOKE AWS-DOC "DetectText" USING WS-A RETURNING WS-RC
           ADD 1 TO WS-CALLS
           MOVE WS-RC TO WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "1"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL async start: " FUNCTION TRIM(WS-FIELD)
           END-IF
           .
]]></Event>
  </Control>
  <Control id="BTN-SUMMARY" type="Button" x="152" y="96" w="120" h="28" tab-order="2" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Summary</Property>
    <Event name="onClick" paragraph="BTN-SUMMARY--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-ORDER(1:26) = "onTextDetected onComplete "
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL event order: " FUNCTION TRIM(WS-ORDER)
           END-IF
           DISPLAY "==== AwsTextract demo (spec 078) ===="
           DISPLAY "Operations: DetectText (Sync), DetectText (Async), AnalyzeDocument, GetField"
           DISPLAY "Refusals:   none (Textract only reads)"
           DISPLAY "Calls made: " WS-CALLS
           DISPLAY "Sync part:  " WS-MS " ms"
           DISPLAY "Events:     " FUNCTION TRIM(WS-ORDER)
           MOVE SPACES TO WS-RESULT
           STRING "PASS " WS-PASS " FAIL " WS-FAIL
               DELIMITED BY SIZE INTO WS-RESULT
           DISPLAY FUNCTION TRIM(WS-RESULT)
           MOVE WS-RESULT TO LBL-RESULT::Caption
           .
]]></Event>
  </Control>
  <Control id="LBL-RESULT" type="Label" x="16" y="140" w="300" h="24" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">-</Property>
  </Control>
</Form>
