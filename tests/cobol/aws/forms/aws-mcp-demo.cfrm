<?xml version="1.0" encoding="UTF-8"?>
<Form name="AWS-MCP-DEMO" title="AwsMcp demo" width="480" height="240" form-format="Both" index-base="1">
  <working-storage><![CDATA[       01 WS-PASS     PIC 999 VALUE 0 GLOBAL.
       01 WS-FAIL     PIC 999 VALUE 0 GLOBAL.
       01 WS-CALLS    PIC 999 VALUE 0 GLOBAL.
       01 WS-NAME     PIC X(40) GLOBAL.
       01 WS-PAY      PIC X(200) GLOBAL.
       01 WS-OUT      PIC X(2000) GLOBAL.
       01 WS-RC       PIC X(10) GLOBAL.
       01 WS-N        PIC X(10) GLOBAL.
       01 WS-I        PIC 9 GLOBAL.
       01 WS-F        PIC X(10) GLOBAL.
       01 WS-FIELD    PIC X(80) GLOBAL.
       01 WS-ERR      PIC X(300) GLOBAL.
       01 WS-K        PIC 99 GLOBAL.
       01 WS-ORDER    PIC X(100) VALUE SPACES GLOBAL.
       01 WS-OP       PIC 999 VALUE 1 GLOBAL.
       01 WS-T0       PIC X(21) GLOBAL.
       01 WS-T1       PIC X(21) GLOBAL.
       01 WS-MS       PIC 9(9) GLOBAL.
       01 WS-RESULT   PIC X(40) GLOBAL.
]]></working-storage>
  <Control id="AWS-FN" type="AwsMcp" x="16" y="16" w="56" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="ServerId">fake</Property>
    <Property name="ToolName">read_thing</Property>
    <Property name="AllowWrite">true</Property>
    <Property name="Mode">Sync</Property>
    <Event name="onToolResult" paragraph="AWS-FN--ONTOOLRESULT"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           STRING "onToolResult " DELIMITED BY SIZE INTO WS-ORDER WITH POINTER WS-OP
           MOVE AWS-FN::ResponseBody TO WS-OUT
           MOVE 0 TO WS-K
           INSPECT WS-OUT TALLYING WS-K FOR ALL '"k"'
           IF WS-K > 0
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL async Call body: " FUNCTION TRIM(WS-OUT)
           END-IF
           .
]]></Event>
    <Event name="onComplete" paragraph="AWS-FN--ONCOMPLETE"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           STRING "onComplete " DELIMITED BY SIZE INTO WS-ORDER WITH POINTER WS-OP
           .
]]></Event>
  </Control>
  <Control id="AWS-RO" type="AwsMcp" x="88" y="16" w="56" h="56" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="ServerId">fake</Property>
    <Property name="ToolName">read_thing</Property>
    <Property name="AllowWrite">false</Property>
    <Property name="Mode">Sync</Property>
  </Control>
  <Control id="BTN-RUN" type="Button" x="16" y="96" w="120" h="28" tab-order="1" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Run</Property>
    <Event name="onClick" paragraph="BTN-RUN--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           MOVE FUNCTION CURRENT-DATE TO WS-T0
      *>   1. Call, synchronous: a read-only tool's answer, and the tools.
           MOVE "read_thing" TO WS-NAME
           MOVE '{"k": 1}' TO WS-PAY
           INVOKE AWS-FN "Call" USING WS-NAME WS-PAY RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE 0 TO WS-K
           INSPECT WS-OUT TALLYING WS-K FOR ALL '"k"'
           IF WS-K > 0
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL sync Call: " FUNCTION TRIM(WS-OUT)
           END-IF
           MOVE AWS-FN::ResultJson TO WS-OUT
           IF WS-OUT(1:1) = "{"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL ResultJson: " FUNCTION TRIM(WS-OUT)
           END-IF
           INVOKE AWS-FN "ListTools" RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE 1 TO WS-I
           MOVE "Name" TO WS-F
           INVOKE AWS-FN "GetField" USING WS-I WS-F RETURNING WS-FIELD
           IF FUNCTION TRIM(WS-FIELD) = "app_f"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL GetField(1, Name): " WS-FIELD
           END-IF
      *>   2. A tool the server does not mark read-only, AllowWrite off:
      *>      refused before it is called.
           MOVE "write_thing" TO WS-NAME
           INVOKE AWS-RO "Call" USING WS-NAME WS-PAY RETURNING WS-OUT
           MOVE AWS-RO::LastError TO WS-ERR
           MOVE 0 TO WS-K
           INSPECT WS-ERR TALLYING WS-K FOR ALL "not marked read-only"
           IF WS-K > 0
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL read-only refusal: " FUNCTION TRIM(WS-ERR)
           END-IF
      *>   3. Arguments that are not JSON: refused, naming the argument.
           MOVE "read_thing" TO WS-NAME
           MOVE "{nope" TO WS-PAY
           INVOKE AWS-FN "Call" USING WS-NAME WS-PAY RETURNING WS-OUT
           MOVE AWS-FN::LastError TO WS-ERR
           MOVE 0 TO WS-K
           INSPECT WS-ERR TALLYING WS-K FOR ALL "argument 2"
           IF WS-K > 0
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL invalid JSON refusal: " FUNCTION TRIM(WS-ERR)
           END-IF
      *>   4. The tools the server offers.
           INVOKE AWS-FN "ListTools" RETURNING WS-OUT
           ADD 1 TO WS-CALLS
           MOVE AWS-FN::RowCount TO WS-N
           IF FUNCTION TRIM(WS-N) = "3"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL ListTools rows: " WS-N
           END-IF
           MOVE FUNCTION CURRENT-DATE TO WS-T1
           COMPUTE WS-MS =
               ((FUNCTION NUMVAL(WS-T1(9:2)) * 3600
                 + FUNCTION NUMVAL(WS-T1(11:2)) * 60
                 + FUNCTION NUMVAL(WS-T1(13:2))) * 100
                 + FUNCTION NUMVAL(WS-T1(15:2))) * 10
             - ((FUNCTION NUMVAL(WS-T0(9:2)) * 3600
                 + FUNCTION NUMVAL(WS-T0(11:2)) * 60
                 + FUNCTION NUMVAL(WS-T0(13:2))) * 100
                 + FUNCTION NUMVAL(WS-T0(15:2))) * 10
      *>   5. Call, asynchronous: it answers with onToolResult, then onComplete.
           MOVE "Async" TO AWS-FN::Mode
           MOVE '{"k": 1}' TO WS-PAY
           INVOKE AWS-FN "Call" USING WS-NAME WS-PAY RETURNING WS-RC
           ADD 1 TO WS-CALLS
           IF FUNCTION TRIM(WS-RC) = "1"
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL async Call start: " WS-RC
           END-IF
           .
]]></Event>
  </Control>
  <Control id="BTN-SUMMARY" type="Button" x="152" y="96" w="120" h="28" tab-order="2" z-order="0" visible="true" enabled="true">
    <Property name="Caption">Summary</Property>
    <Event name="onClick" paragraph="BTN-SUMMARY--ONCLICK"><![CDATA[       ENVIRONMENT DIVISION.
       DATA DIVISION.
       PROCEDURE DIVISION.
           IF WS-ORDER(1:24) = "onToolResult onComplete "
               ADD 1 TO WS-PASS
           ELSE
               ADD 1 TO WS-FAIL
               DISPLAY "FAIL event order: " FUNCTION TRIM(WS-ORDER)
           END-IF
           DISPLAY "==== AwsMcp demo (spec 078) ===="
           DISPLAY "Operations: Call (Sync), Call (Async), ListTools, GetField, ResultJson"
           DISPLAY "Refusals:   a tool not marked read-only, arguments not JSON (nothing sent)"
           DISPLAY "Calls made: " WS-CALLS
           DISPLAY "Sync part:  " WS-MS " ms"
           DISPLAY "Events:     " FUNCTION TRIM(WS-ORDER)
           MOVE SPACES TO WS-RESULT
           STRING "PASS " WS-PASS " FAIL " WS-FAIL
               DELIMITED BY SIZE INTO WS-RESULT
           DISPLAY FUNCTION TRIM(WS-RESULT)
           MOVE WS-RESULT TO LBL-RESULT::Caption
           .
]]></Event>
  </Control>
  <Control id="LBL-RESULT" type="Label" x="16" y="140" w="300" h="24" tab-order="0" z-order="0" visible="true" enabled="true">
    <Property name="Caption">-</Property>
  </Control>
</Form>
