//! The generated authentication programs (WASM-009 R7, WASM-003 R22).
//!
//! A backend that signs people in carries eleven **public** programs, one per
//! operation, each taking the same request group and returning the same result
//! group, and each doing one thing: handing both to `COBOL::"AUTH-OP"`, which
//! lands in the identity service. Because they are ordinary exported programs,
//! the mapping, the payload validation, the limits, the log and the frontend's
//! Check treat them like any other; and because the two groups are written once
//! to a copybook (`COPYBOOKS/AUTH-GROUPS.cpy`) the frontend `COPY`s the very
//! layouts the backend serves.
//!
//! **The files are generated and never hand-edited**: each begins with a banner,
//! and a file that exists without it is not overwritten (the developer's own
//! code is sacred). `exports.toml` is the developer's; the generator only
//! *appends* the entries it finds missing.

use std::path::{Path, PathBuf};

pub const BANNER: &str = "*> Generated by PowerRustCOBOL AI from the backend's identity settings. Do not edit: it is rewritten by `rcrun backend auth`.";

/// `(program, operation)`.
pub const OPERATIONS: [(&str, &str); 11] = [
    ("AUTH-SIGN-IN", "SIGN-IN"),
    ("AUTH-SIGN-UP", "SIGN-UP"),
    ("AUTH-CONFIRM", "CONFIRM"),
    ("AUTH-RESEND", "RESEND"),
    ("AUTH-FORGOT", "FORGOT"),
    ("AUTH-RESET", "RESET"),
    ("AUTH-MFA", "MFA"),
    ("AUTH-REFRESH", "REFRESH"),
    ("AUTH-SIGN-OUT", "SIGN-OUT"),
    ("AUTH-START-HOSTED", "START-HOSTED"),
    ("AUTH-FINISH-HOSTED", "FINISH-HOSTED"),
];

/// The two groups, as the copybook holds them.
pub fn groups() -> String {
    "01 AUTH-REQUEST.
    05 USERNAME       PIC X(254).
    05 PASSWORD       PIC X(256).
    05 EMAIL          PIC X(254).
    05 PHONE          PIC X(32).
    05 GIVEN-NAME     PIC X(100).
    05 FAMILY-NAME    PIC X(100).
    05 ONE-TIME-CODE  PIC X(64).
    05 CHALLENGE      PIC X(32).
    05 SESSION        PIC X(4096).
    05 SESSION-HANDLE PIC X(64).
    05 CLIENT-KIND    PIC X(8).
    05 CAPTCHA-TOKEN  PIC X(2048).
    05 REDIRECT-URI   PIC X(512).
    05 STATE          PIC X(64).
    05 ACCESS-TOKEN   PIC X(8192).
    05 REFRESH-TOKEN  PIC X(2048).
01 AUTH-RESULT.
    05 OUTCOME        PIC X(24).
    05 OUTCOME-TEXT   PIC X(200).
    05 ACCESS-TOKEN   PIC X(8192).
    05 ID-TOKEN       PIC X(8192).
    05 REFRESH-TOKEN  PIC X(2048).
    05 EXPIRES-IN     PIC 9(7).
    05 CHALLENGE      PIC X(32).
    05 SESSION        PIC X(4096).
    05 HINT           PIC X(64).
    05 SESSION-HANDLE PIC X(64).
    05 URL            PIC X(2048).
    05 STATE          PIC X(64).
"
    .to_string()
}

pub fn copybook() -> String {
    format!(
        "{BANNER}\n*> The request and the result of every AUTH-... program of the backend. COPY it in the\n*> frontend's WORKING-STORAGE to call them.\n{}",
        groups()
    )
}

pub fn program(name: &str, op: &str) -> String {
    format!(
        "{BANNER}\nIDENTIFICATION DIVISION.\nPROGRAM-ID. {name}.\nDATA DIVISION.\nLINKAGE SECTION.\n{}PROCEDURE DIVISION USING AUTH-REQUEST RETURNING AUTH-RESULT.\nMAIN.\n    *> {name}: hands the request to the identity service ({op}) and returns its result; it changes no other data item.\n    COBOL::\"AUTH-OP\" ( \"{op}\" AUTH-REQUEST AUTH-RESULT )\n    GOBACK.\n",
        groups()
    )
}

/// The `[[export]]` entries, for a backend that has none of them.
pub fn exports() -> String {
    let mut s = String::from("\n# The authentication programs (generated by `rcrun backend auth`): public, because a person\n# who is signing in has no token yet.\n");
    for (name, _) in OPERATIONS {
        s.push_str(&format!("\n[[export]]\nprogram = \"{name}\"\npublic = true\n"));
    }
    s
}

/// Write the programs and the copybook into `backend_dir`, and append the exports that are missing.
/// Returns the paths written.
pub fn generate(backend_dir: &Path) -> Result<Vec<PathBuf>, String> {
    let mut written = Vec::new();
    let mut put = |path: PathBuf, text: String| -> Result<(), String> {
        if let Ok(existing) = std::fs::read_to_string(&path) {
            if !existing.starts_with(BANNER) {
                return Err(format!("{} exists and is not generated (it has no banner): rename or remove it, then run this again", path.display()));
            }
            if existing == text {
                return Ok(());
            }
        }
        if let Some(dir) = path.parent() {
            std::fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
        }
        std::fs::write(&path, text).map_err(|e| format!("{}: {e}", path.display()))?;
        written.push(path);
        Ok(())
    };
    put(backend_dir.join("COPYBOOKS").join("AUTH-GROUPS.cpy"), copybook())?;
    for (name, op) in OPERATIONS {
        put(backend_dir.join("src").join(format!("{}.cbl", name.to_ascii_lowercase())), program(name, op))?;
    }
    let exports_path = backend_dir.join("exports.toml");
    let current = std::fs::read_to_string(&exports_path).map_err(|e| format!("{}: {e}", exports_path.display()))?;
    if !current.contains("AUTH-SIGN-IN") {
        let mut text = current;
        if !text.ends_with('\n') {
            text.push('\n');
        }
        text.push_str(&exports());
        std::fs::write(&exports_path, text).map_err(|e| format!("{}: {e}", exports_path.display()))?;
        written.push(exports_path);
    }
    Ok(written)
}
